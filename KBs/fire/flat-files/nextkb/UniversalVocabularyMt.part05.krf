(comment CoffeeGrinder "The collection of all coffee grinders")
(disjointWith Conveying-Generic EnteringAComputerPassword)
(comment arg1NotIsa "(#$arg1NotIsa REL COL) means that nothing given as the first argument to the #$Relation REL may be known to be an element of the #$Collection COL.")
(comment MedicalCareOrganization "#$MedicalCareOrganization is a specialization of #$HealthcareOrganization, #$MedicalCareProvider and #$ServiceOrganization.  Each instance of #$MedicalCareOrganization is an organization that provides some kind of medical care (note that an instance of #$MedicalCareOrganization may be a sub-organization of a larger organization).  Notable specializations of #$MedicalCareOrganization include #$MedicalCareInstitution, #$Hospital, and #$VeterinaryHospital.")
