(comment CSQLConstructPointFromBinaryAndSRIDFn "#$CSQLConstructPointFromBinaryAndSRIDFn is the #$CSQLFunction
corresponding to #$ConstructPointFromBinaryAndSRIDFn")
(comment CSQLConstructGeometryCompositeFromBinaryAndSRIDFn "#$CSQLConstructGeometryCompositeFromBinaryAndSRIDFn is the #$CSQLFunction
