(in-microtheory UniversalVocabularyMt)
(comment umlInitialValue "The #$BinaryPredicate umlInitialValue links an instance of #$UMLAttribute with an instance of #$UMLExpression which when evaluated provides the initial value for the attribute.")
(comment greaterUnit "An #$OrderingPredicate and a specialization of #$interconvertibleUnits (q.v.). <code>(#$greaterUnit BIGUNIT SMALLUNIT)</code> means that the #$UnitOfMeasures <code>BIGUNIT</code> and <code>SMALLUNIT</code> are interconvertible units such that <code>BIGUNIT</code> is a larger unit that <code>SMALLUNIT</code>.  In other words, <code>BIGUNIT</code> and <code>SMALLUNIT</code> both measure the same sort of #$Quantity[ies], but <code>BIGUNIT</code> measures them in larger increments.  This implies that there is some real number <code>N</code> such that <code>(#$unitMultiplicationFactor SMALLUNIT BIGUNIT N)</code> holds.
<p>
For example, (#$greaterUnit #$Meter #$Inch) holds, and so does (#$unitMultiplicationFactor #$Inch #$Meter 39.3696).
<p>
For a similar predicate that compares the sizes of measurable quantities directly, see #$greaterThan.")
(comment TestStateMachineContext "The #$UMLClass instance which contains the state context for the #$TestStateMachine.")
(comment HydrogenSelenideIon "The collection of hydrogen selenide ions (HSe-). See (#$ChemicalSubstanceFn #$HydrogenSelenideIon).")
(comment BitartrateIon "The collection of bitartrate ions (HSe-). See (ChemicalSubstanceFn BitartrateIon).")
(comment SilverAcetate "An organic chemical compound. Each instance of #$SilverAcetate is a
sample of the compound AgC2H3O2.")
(comment predTrivialForJustificationParaphrase "(#$predTrivialForJustificationParaphrase PRED) means that when
PRED is the arg0 in a support for a proof, a paraphrase of that proof need
not explicitly mention that support, as a human can be expected to consider that
rule obvious.")
(comment UMLBinding "The collection of #$UnifiedModelingLanguage (extension)  binding objects which contain a #$UMLPin and the associated bound #$UMLStateMachineStateVariable.")
(comment UMLInputBinding "The collection of #$UnifiedModelingLanguage (extension)  binding objects which contain a #$UMLInputPin and the associated bound input #$UMLStateMachineStateVariable.")
(comment UMLOutputBinding "The collection of #$UnifiedModelingLanguage (extension)  binding objects which contain a #$UMLOutputPin and the associated bound output #$UMLStateMachineStateVariable.")
(comment UMLElementType "The collection of #$UnifiedModelingLanguage element collections.")
(comment umlEffectInputPinBinding "The #$BinaryPredicate umlEffectInputPinBinding links an instance #$UMLTransition with an instance of #$UMLInputBinding which contains the procedure argument binding for a #$UMLInputPin.")
(comment umlEntryInputPinBinding "The #$BinaryPredicate umlEntryInputPinBinding links an instance #$UMLState with an instance of #$UMLInputBinding which contains the entry procedure argument binding for a #$UMLInputPin.")
(comment umlExitInputPinBinding "The #$BinaryPredicate umlExitInputPinBinding links an instance #$UMLState with an instance of #$UMLInputBinding which contains the exit procedure argument binding for a #$UMLInputPin.")
(comment umlDoActivityInputPinBinding "The #$BinaryPredicate umlDoActivitytInputPinBinding links an instance #$UMLState with an instance of #$UMLInputBinding which contains the doActivity procedure argument binding for a #$UMLInputPin.")
(comment umlEffectOutputPinBinding "The #$BinaryPredicate umlEffectOutputPinBinding links an instance #$UMLTransition with an instance of #$UMLOutputBinding which contains the procedure argument binding for a #$UMLOutputPin.")
(comment umlEntryOutputPinBinding "The #$BinaryPredicate umlEntryOutputPinBinding links an instance #$UMLState with an instance of #$UMLOutputBinding which contains the entry procedure argument binding for a #$UMLOutputPin.")
(comment umlExitOutputPinBinding "The #$BinaryPredicate umlExitOutputPinBinding links an instance #$UMLState with an instance of #$UMLOutputBinding which contains the exit procedure argument binding for a #$UMLOutputPin.")
(comment umlDoActivityOutputPinBinding "The #$BinaryPredicate umlDoActivityOutputPinBinding links an instance #$UMLState with an instance of #$UMLOutputBinding which contains the doActivity procedure argument binding for a #$UMLOutputPin.")
(comment UMLEffectInputBindingFn "A binary function that returns a #$UMLInputBinding and which is composed of the #$UMLTransition and an effect procedure #$UMLInputPin.")
(comment UMLEffectOutputBindingFn "A binary function that returns a #$UMLOutputBinding and which is composed of the #$UMLTransition and an effect procedure #$UMLOutputPin.")
(comment UMLEntryInputBindingFn "A binary function that returns a #$UMLInputBinding and which is composed of the #$UMLState and an entry procedure #$UMLInputPin.")
(comment UMLExitInputBindingFn "A binary function that returns a #$UMLInputBinding and which is composed of the #$UMLState and an exit procedure #$UMLInputPin.")
(comment UMLExitDoActivityBindingFn "A binary function that returns a #$UMLInputBinding and which is composed of the #$UMLState and a doActivity procedure #$UMLInputPin.")
(comment UMLEntryOutputBindingFn "A binary function that returns a #$UMLOutputBinding and which is composed of the #$UMLState and an entry procedure #$UMLOutputPin.")
(comment UMLExitOutputBindingFn "A binary function that returns a #$UMLOutputBinding and which is composed of the #$UMLState and an exit procedure #$UMLOutputPin.")
(comment UMLDoActivityOutputBindingFn "A binary function that returns a #$UMLOutputBinding and which is composed of the #$UMLState and a doActivity procedure #$UMLOutputPin.")
(comment umlBoundInputPin "The #$BinaryPredicate umlBoundInputPin links an instance #$UMLInputBinding with the bound #$UMLInputPin.")
(comment umlBoundOutputPin "The #$BinaryPredicate umlBoundOutputPin links an instance #$UMLOutputBinding with the bound #$UMLOutputPin.")
(comment umlBoundInputValueExpression "The #$BinaryPredicate umlBoundInputValueExpression links an instance #$UMLInputBinding with the bound value expression which could be a literal, state variable or expression.")
(comment umlBoundOutputStateVariable "The #$BinaryPredicate umlBoundOutputStateVariable links an instance #$UMLOutputBinding with the bound ouput state variable.")
(comment CobaltIII-Ion "A specialization of #$VariableChargeCation and (#$AtomFn
#$Cobalt).  Each instance of #$ColbaltIIIIon is a single atom of
#$Cobalt with a charge of +3, having lost three electrons.")
(comment Gold-III-Ion "A specialization of both #$VariableChargeCation and
(#$AtomFn #$Gold).  Each instance of #$Gold-III-Ion has lost three
electrons, and thus has a +3 charge.")
(comment Gold-I-Ion "A specialization of both #$VariableChargeCation and
(#$AtomFn #$Gold).  Each instance of #$Gold(I)Ion is a gold atom that
has lost 1 electron, and thus has a +1 charge.")
(comment Br2Molecule "A specializaiton of #$Molecule.  Each instance of
#$Br2Molecule is a binary Bromide molecule.")
(comment ThalliumIIon "A specialization (#$Atom #$Thallium) and
#$VariableChargeCation. Each instance of #$ThalliumIIon is an atom of
#$Thallium that has lost an electron and now has a +1 charge.")
(comment ChromiumIIIon "A specialization of #$VariableChargeCation and (#$AtomFn
#$Chromium). Each instance of #$ChromiumIIIon is a chromium atom that
has lost 2 electrons and has a +2 charge.")
(comment BerylliumIon "A specialization of #$MonoatomicCation and (#$AtomFn
#$Beryllium).  Each instance of #$BerylliumIon is an atom of beryllium
that has lost 2 electrons and thus has a charge of +2.")
(comment UMLInputStream "The collection of #$UnifiedModelingLanguage input stream type objects.")
(comment UMLOutputStream "The collection of #$UnifiedModelingLanguage output stream type objects.")
(comment ScenarioContext "A specialization of #$ConjecturalContext. Each instance of #$ScenarioContext denotes a \"possible world\" -- each instance is a context in which possibly true assertions are made to describe a state of affairs that might or might not obtain. With the exception of \"seed contexts\" (about which more later), instances of #$ScenarioContext are constructed automatically by the scenario generation abduction harness via the application of #$abductiveExpansion rules (see #$abductiveExpansion). Assertions directly made in a non-seed scenario context are possibly true. They are assertions which, if actually true, would serve to explain assertions in more general scenario contexts. Scenario contexts that are not automatically generated are seed contexts that contain assertions for which one desires explanatory scenarios to be generated.")
(comment henderson-HasselbalchResult "(#$henderson-HasselbalchResult SAMPLE H-H-NUM) is the result of applying the Henderson-Hasselbalch equation to a sample.  This equation is used to ascertain the pH of instances of #$AqueousBufferSolution.")
(comment instanceListMinLength "(#$instanceListMinLength LIST-TYPE N) states that every list which is an instance of LIST-TYPE will contain at least N elements.  For example, (#$instanceListMinLength (#$ListOfMinimumLengthFn 2) 2).")
(comment instanceListMaxLength "(#$instanceListMaxLength LIST-TYPE N) states that every list which is an instance of LIST-TYPE will contain at most N elements.  For example, (#$instanceListMaxLength (#$ListOfMaximumLengthFn 2) 2).")
(comment StringToSubstanceTypeFn "An #$EvaluatableFunction that maps #$SubLString representations of chemical formulas to #$ChemicalCompoundTypeByChemicalSpecies.  E.g. (#$StringToSubstanceTypeFn ``H2O'') => #$Water")
(comment CompoundTypeByCompositionFn "(#$CompoundTypeByCompositionFn (#$TheList ELEMENT-1 ... ELEMENT-N) (#$TheList SUBSCRIPT-1 ... SUBSCRIPT-N)) denotes the #$ChemicalCompoundTypeByChemicalSpecies whose complete atomic composition is SUBSCRIPT-1 atoms of ELEMENT-1, ... , and SUBSCRIPT-N atoms of ELEMENT-N")
(comment applyingOfStuff "A predicate which relates a type of thing typically  applied to a surface to the collection of #$ApplyingStuffToSurface events in which that type of thing is applied. (#$applyingOfStuff STUFF-TYPE EVENT-COL) means that all events in EVENT-COL involve the application of stuff of type STUFF-TYPE (such as #$Shampoo, #$Makeup, etc). See also #$ApplyingStuffFn.")
(comment atomicWeight "(#$atomicWeight ELEMENT (#$AtomicMassUnit NUM)) means that the average atom of ELEMENT has NUM times the mass of a proton.  Atomic weights are calculated for isotopes as well as elements.  For elements the average given is that weighted by the relative abundance of the various isotopes on Earth.")
(comment molarMass "(#$molarMass CHEMICAL MOLAR-MASS) means that the mass of a quantity of CHEMICAL is considered as MOLAR-MASS (denoted in grams/mole) times the number of moles of CHEMICAL.  The term \"molar mass\" is sometimes expressed merely in grams, with the \"per mole\" understood.  The term \"molecular mass\" is expressed either in terms of #$AtomicMassUnits or in terms of grams/mole, in which case its value is the same as the #$molarMass.")
(comment soluteTypesInAqueousSolution "(#$soluteTypesInAqueousSolution SOLUTION CHEMICAL) means that SOLUTION has some amount of CHEMICAL dissolved in solution.")
(comment HTMLURLEncodeFn "Return a URL encoded form of STRING.  Spaces are converted to '+' characters, and characters besides letters, numbers, hyphen, underscore, period, and equals are encoded in %XX form.")
(comment ScientificNumberToSubLRealNumberFn "(#$ScientificNumberToSubLRealNumberFn SCINUM) returns the #$SubLRealNumber that represents SCINUM, which must be of the form (#$ScientificNumberFn SIGNIFICAND EXPONENT).  E.g., (#$ScientificNumberToStringFn (#$ScientificNumberFn 314159 0)) is 3.14159.")
(comment Number-Scientific "#$Number-Scientific is the collection of numbers in scientific notation (see #$ScientificNumberFn).")
(comment ScientificNumberToStringFn "(#$ScientificNumberToStringFn SCINUM) returns the #$NumberString that represents SCINUM, which must be of the form (#$ScientificNumberFn SIGNIFICAND EXPONENT).  E.g., (#$ScientificNumberToStringFn (#$ScientificNumberFn 314159 0)) is \"3.14159\". There is an optional second argument which is a string denoting the exponent marker, e.g., \"d\", \"e\", \"f\", with \"e\" as the default.")
(comment NumericString "A specialization of #$SubLString.  This is the collection of all SubL strings that either denote numbers (see #$NumberString) or are used to represent something in a mostly numerical way.  As a minimal requirement, a numeric string should contain at least one #$Numeral. #$NumericString is more general than #$NumberString in that it also includes strings that contain characters such as slashes ('/'), parentheses, and non-initial hyphens ('-').  Examples of numeric strings include \"3.14159\", \"-56\", \"6.02e23\", \"78731-1234\", \"9/11/01\", and \"(212) 555-0011\".  (The first three of these examples are also #$NumberStrings.)  Another specialization of #$NumericString is #$ZipCode.")
(comment ScientificNumberFromSubLRealNumberFn "(#$ScientificNumberFromSubLRealNumberFn REAL) returns the #$Number-Scientific denoted by the #$SubLRealNumber REAL.  So, e.g., (#$ScientificNumberFromSubLRealNumberFn 3.14159) returns (#$ScientificNumberFn 314159 0).")
(comment ScientificNumberFromStringFn "(#$ScientificNumberFromStringFn STRING) returns the #$Number-Scientific denoted by the #$NumberString STRING.  So, e.g., (#$ScientificNumberFromStringFn \"5784.435e92\") returns (#$ScientificNumberFn 5784435 95).  Acceptable exponent markers include \"e\", \"E\", \"d\", and \"D\" (although \"d\" and \"D\" are deprecated).")
(comment ScientificNumberFn "(#$ScientificNumberFn SIGNIFICAND EXPONENT) denotes a number in scientific notation which has SIGNIFICAND with an implicit decimal point after its first digit as its significand and EXPONENT as its exponent.  So, e.g., (#$ScientificNumberFn 314159 0) denotes 3.14159.  Likewise, (#$ScientificNumberFn 23648762469238472354 32) denotes 2.3648762469238472354e32 or 2.3648762469238472354 * 10^32.")
(comment ScientificNumberSignificantDigitCountFn "(#$ScientificNumberSignificantDigitCountFn SCINUM) returns the number of significant digits in SCINUM.")
(comment SilverBromide "A specialization of #$SilverBromide.  Each instance of
#$SilverBromide is a sample of AgBr.")
(comment numberOfSolutes "(#$numberOfSolutes SOLUTION NUM) means that there are NUM types of chemical dissolved in SOLUTION.")
(comment RedoxReaction "A specialization of #$ChemicalReaction.  Each instance of #$RedoxReaction is a reaction in which one chemical substance loses electrons and another, called the oxidizing agent, gains those electrons.  The substance that has lost the electrons is oxidized.")
(comment Number-Extended "#$Number-Extended is the collection of all \"extended numbers\".  An \"extended number\" is either a #$SubLRealNumber or a #$Number-Scientific.")
(comment BismuthIII-Ion "A specialization of #$VariableChargeCation.  Instances of
#$BismuthIII-Ion are single #$Bismuth atoms with an #$ElectronicCharge of +3,
which means it has lost 3 electrons.")
(comment relationOnlyAll "A ternary #$RuleMacroPredicate that can be used to state that a #$BinaryPredicate stands in a certain relation to two collections.  <code>(#$relationOnlyAll BINPRED COL1 COL2)</code> means for any instance <code>Y</code> of <code>COL2</code>, <code>(BINPRED X Y)</code> holds only if <code>X</code> is an instance of <code>COL1</code>.  It is equivalent to (and can thus be used as shorthand for) the more complex form
<pre>
(#$implies
  (#$and
    (BINPRED ?X ?Y)
    (#$isa ?Y COL2))
  (#$isa ?X COL1)).
</pre>
For example, <code>(#$relationOnlyAll #$wearsClothing #$HumanChild #$ChildrensClothing)</code> means that only children wear children's clothing.  This assertion is shorthand for the following rule:
<pre>
(#$implies
  (#$and
    (#$wearsClothing ?PERSON ?CLOTHING)
    (#$isa ?CLOTHING #$ChildrensClothing))
  (#$isa ?PERSON #$HumanChild)).
</pre>
See also #$relationAllOnly and #$NoteAboutUseOfRuleMacroPredicates.")
(comment relationInstanceOnly "A ternary #$RuleMacroPredicate (q.v.) that can be used to state that a given binary predicate holds between a specified thing and some instance of a given collection.  (#$relationInstanceOnly PRED THING COL) means that only instances of COL, say INST, are such that (PRED THING INST) holds.  It is equivalent to (and can thus be used in effect as shorthand for) the more complex form:
<p>
(#$implies
(PRED THING ?INST)
(#$isa ?INST COL)).
<p>
For example, `(#$relationInstanceOnly #$presidentOfCountry #$UnitedStatesOfAmerica #$UnitedStatesPresident)' means that only U.S. presidents are president of the U.S.A..  Cf. #$relationOnlyInstance, and see the shared #$NoteAboutUseOfRuleMacroPredicates.")
(comment queryPracticeRules "(#$queryPracticeRules QUERY RULE) means that RULE is a useful rule for the system to use when practicing how to answer QUERY.")
(comment collectionIsaBackchainEncouraged "<p>
(#$collectionIsaBackchainEncouraged COLLECTION)
<p>
means that rules that conclude
<p>
(#$isa <anything> COLLECTION)
<p>
are most likely going to have to be used in order to prove literals of the form
<p>
(#$isa <anything> COLLECTION).
<p>
This directs the inference engine to use such rules even if HL predicate transformation is disabled.  Note that it will not necessarily use rules of the form
<p>
(#$isa <anything> <variable>)
<p>
where <variable> might bind to COLLECTION, and it will not necessarily use rules of the form
<p>
(#$isa <anything> SPEC),
<p>
where (#$genls SPEC COLLECTION).
<p>
See also #$backchainEncouraged for the analogue of this predicate applicable to predicates rather than collections.")
(comment collectionGenlsBackchainEncouraged "<p>
(#$collectionGenlsBackchainEncouraged COLLECTION)
<p>
means that rules that conclude
<p>
(#$genls <anything> COLLECTION)
<p>
are most likely going to have to be used in order to prove literals of the form
<p>
(#$genls <anything> COLLECTION).
<p>
This directs the inference engine to use such rules even if HL predicate transformation is disabled.  Note that it will not necessarily use rules of the form
<p>
(#$genls <anything> <variable>)
<p>
where <variable> might bind to COLLECTION, and it will not necessarily use rules of the form
<p>
(#$genls <anything> SPEC),
<p>
where (#$genls SPEC COLLECTION).
<p>
See also #$backchainEncouraged for the analogue of this predicate applicable to predicates rather than collections.")
(comment HTMLOrderedListType "The collection of types of lists that are generally supported by HTML browsers.")
(comment NumberedList-UpperCaseLatin "The collection of all instances of #$List-Information whose component list items (see #$itemInList-Information) are numerically and sequentially ordered, beginning with the uppercase letter A.")
(comment htmlListTypeIdentifierString "(#$htmlListTypeIdentifierString LIST-TYPE STRING) means that STRING is the HTML code used to identify LIST-TYPE inside an HTML tag.")
(comment SetOrList-Extensional "The union of #$List-Extensional and #$Set-Extensional.")
(comment ArsenateIon "The collection of arsenate ions. Their chemical formula is AsO4(3-).")
(comment SelenateIon "The collection of selenate ions. Their chemical formula is SeO4(2-).")
(comment SilicateIon "The collection of silicate ions. Their chemical formula is SiO3(2-).")
(comment TartrateIon "The collection of tartrate ions. Their chemical formula is C4H4O6(2-).")
(comment PhosphiteIon "The collection of phosphite ions. Their chemical formula is PO3(3-).")
(comment HypobromiteIon "The collection of hypobromite ions. Their chemical formula is BrO(-).")
(comment BorateIon "The collection of borate ions. Their chemical formula is BO3(3-).")
(comment TetraborateIon "The collection of tetraborate ions. Their chemical formula is B4O7(2-).")
(comment HexafluorosilicateIon "The collection of hexafluorosilicate ions. Their chemical formula is SiF6(2-).")
(comment PeriodateIon "The collection of periodate ions. Their chemical formula is IO4(-).")
(comment IodateIon "The collection of iodate ions. Their chemical formula is IO3(-).")
(comment HypoioditeIon "The collection of hypoiodite ions. Their chemical formula is IO(-).")
(comment highlyRelevantTerm "A #$CycInferenceHeuristicRelevancePredicate. (#$highlyRelevantTerm TERM) states that the #$CycLClosedDenotationalTerm TERM should be heuristically considered highly relevant to inferences made in the current #$Microtheory.  See also other instances of #$CycInferenceHeuristicRelevancePredicate.")
(comment CycInferenceHeuristicRelevancePredicate "A collection of predicates.  The subcollection of #$CycInferenceHeuristicPredicate containing those predicates which describe the mechanisms available to determine heuristic relevance in the internal inference mechanisms of Cyc's theorem prover.")
(comment irrelevantTerm "A #$CycInferenceHeuristicRelevancePredicate. (#$irrelevantTerm TERM) states that the #$CycLClosedDenotationalTerm TERM should be heuristically considered less relevant to inferences made in the current #$Microtheory.  See also other instances of #$CycInferenceHeuristicRelevancePredicate.")
(comment precipitateCompoundType "<p>
(#$precipitateCompoundType REACTION-TYPE PRECIPITATE-TYPE) says that REACTION-TYPE, an instance of #$ChemicalReactionTypeByEquationFormula and a specialization of #$PrecipitationReaction, is such that it forms PRECIPITATE-TYPE, an instance of #$ChemicalCompoundTypeByChemicalSpecies, as a precipitate.")
(comment hypotheticalTerm "(#$hypotheticalTerm TERM) states that TERM is a term that was hypothesized.  The most common reason a term is hypothesized is to pose a hypothetical query to Cyc.")
(comment ionicEquation-Complete-Unbalanced "This predicate represents the complete unbalanced ionic equation listing the reactants and products of a type of chemical reaction in which ions occur. (#$ionicEquation-Net-Unbalanced TYPE I-REACTANTS I-PRODUCTS)expresses the equation of a reaction in which each member of I-REACTANTS or I-PRODUCTS is an instance of #$ChemicalSubstanceType.")
(comment ReferenceWorkEntryFn "(#$ReferenceWorkEntryFn WORK STRING) denotes the entry headed by STRING in the #$ReferenceWork WORK.  See #$referenceWorkHasEntry.")
(comment referenceWorkHasEntry "<code>(#$referenceWorkHasEntry WORK ENTRY)</code> says that the #$ReferenceWorkEntry <code>ENTRY</code> is an entry in the #$ReferenceWork <code>WORK</code>.  For example, the entry for \"sublime\" in the <code>OED</code> stands in the relation denoted by #$referenceWorkHasEntry to the <code>OED</code>.")
(comment DisplacementReaction "A specialization of ChemicalReaction. Each instance of
#$DisplacementReaction is a reaction between two substances in which
one or more of the substances replace other substances. When this type
of reaction occurs between an element and a compound, the reactant
element replaces one of the elements in the compound and follows the
form A + BX --> AX + B. When this reaction occurs between two
compounds, the elements of the reacting compounds switch, see
#$MetathesisReaction.")
(comment LithiumSulfate "A specialization of #$IonicCompound.  Each instance of #$LithiumSulfate is a sample of the compound Li2SO4.")
(comment DiironTrisulfate "A specialization of #$InorganicCompound.  Instances of #$DiironTrisulfate are composed of two atoms of #$Iron, three atoms of #$Sulfur, and twelve atoms of #$Oxygen.")
(comment halfReaction "(#$halfReaction SUBST1 SUBST2 VOLTAGE) means that the half reaction representing the reduction of SUBST1 into SUBST2 has standard reduction potential VOLTAGE.  SUBST1 and SUBST2 must be composed entirely of the same #$ElementStuffTypeByNumberOfProtons.  SUBST1 must have a more positive electronic charge than SUBST2.  Note that this is a significant but useful restriction of the general concept of half reactions.")
(comment halfReactionCoefficients "(#$halfReactionCoefficients SUBST1 SUBST2 COEFFICIENT1 COEFFICIENT2 CHARGE) means that the half reaction representing the reduction of SUBST1 into SUBST2 can be represented as a balanced half reaction as \"COEFFICIENT1 SUBST1 + CHARGE e- -> COEFFICIENT2 SUBST2\".  See #$halfReaction for more details.")
(comment CeriumIIIIon "A specialization of VariableChargeCation and (AtomFn Cerium). Each instance of CeriumIIIIon is a cerium atom that has lost 3 electrons and has a +3 charge.")
(comment CeriumIVIon "A specialization of VariableChargeCation and (AtomFn Cerium). Each instance of CeriumIVIon is a cerium atom that has lost 4 electrons and has a +4 charge.")
(comment PotassiumChloride "A specialization of #$InorganicCompound.  Instances are composed of one atom of #$Potassium and one atom of #Chlorine (KCl).")
(comment quantityOfChemicalObjectInSample "A ternary predicate intended to express the quantity of chemical species (see #$ChemicalObjectTypeByChemicalSpecies) in a sample of something, (possibly a sample of the same substance) when the quantity is measured in terms of number of basic parts or units.  A standard unit used in chemistry is #$Mole-ChemicalCountUnit. Thus, for instance, (#$quantityOfChemicalObjectInSample SAMPLE #$HydroniumIon (#$Mole-ChemicalCountUnit 0.5)) says that SAMPLE is a partially tangible thing containing 0.5 moles of hydronium ions.  Cf. #$quantityOfSubstanceInSample.")
(comment BariumAcetate "The collection of samples of barium acetate; a salt whose chemical formula is Ba(C2H3O2)2.")
(comment CobaltSulfate "CoSO4. The collection of all samples of cobalt sulfate.")
(comment NitrogenDioxide "#$NitrogenDioxide is the collection of all macroscopic portions of the organic compound NO2.")
(comment FerrousChloride "A specialization of #$IonicCompound.  Each instance of #$FerrousChloride is a sample of the compound FeCl2.  See #$FerrousChloride (FeCl3).")
(comment PotassiumBromide "A specialization of #$InorganicCompound.  Instances are composed of one atom of #$Potassium and one atom of #$Bromine (KBr).")
(comment CalciumChloride "A specialization of #$IonicCompound.  Each instance of #$CalciumChloride is a sample of the compound CaCl2.")
(disjointWith Volume Molarity)
(disjointWith Pressure Molarity)
(disjointWith ElectricalResistance Molarity)
(disjointWith Elasticity Molarity)
(disjointWith Density Molarity)
(disjointWith Mass Molarity)
(disjointWith Temperature Molarity)
(disjointWith ElectricalCharge Molarity)
(disjointWith AngularDistance Molarity)
(disjointWith Distance Molarity)
(disjointWith Voltage Molarity)
(disjointWith Volatility-Physical Molarity)
(comment AluminumSulfide "A chemical compound. Each instance of #$AluminumSulfide is a
sample of the compound Al2S3.")
(comment AmmoniumPhosphate "A chemical compound. Each instance of #$AmmoniumPhosphate is a
sample of the compound NH4H2PO4.")
(comment Non-Ion "A collection of microscopic-scale objects; a subset of #$ChemicalObject.  An instance of #$Non-Ion is an atom or radical with zero electrical charge.")
(disjointWith Ion Non-Ion)
(comment PotassiumNitrite "A chemical compound. Each instance of #$PotassiumNitrite is a
sample of the compound KNO2.")
(comment LeadSulfide "A specialization of #$InorganicCompound.  Instances of
#$LeadSulfide are composed of one atom of #$Lead and one atom of
#$Sulfur.")
(comment NameToIonicCompoundFn "An #$EvaluatableFunction that maps ionic compound names to #$IonicCompoundTypes.  E.g. (#$NameToIonicCompoundFn ``Cesium hydroxide'') => #$CesiumHydroxide")
(comment GreatestCommonDivisorFn "A variable-arity #$MathematicalFunctionOnScalars that returns the greatest common (integer) divisor of its (\"co-integral\" scalar) arguments.
<p>
Where <code>INT1</code>, ..., <code>INTn</code> are #$ScalarIntegralValues (q.v.) such that for any <code>i</code> and <code>j</code> (1 <code><= i,j <= n) (#$coIntegralScalars INTi INTj)</code> holds, <code>(#$GreatestCommonDivisorFn INT1 ... INTn)</code> is the #$Integer that is the greatest common divisor of <code>INT1</code>, ..., <code>INTn</code>.
<p>
For example, (#$GreatestCommonDivisorFn  (#$Mile 6) (#$Mile 12) (#$Mile 15)) is equal to 3.
<p>
See the comment on #$coIntegralScalars for more detail about the inter-argument constraints on this function.  Also see #$LeastCommonMultipleFn.")
(comment useCaseAssertions "A binary documentation predicate relating a #$CycLAssertion that is associated with, or in some way relevant to, some represented thing that denotes a Use Case.
This is a documentation predicate, and is not intended to facilitate inference on said use case.")
(comment Ballot-IBO "The collection of all IBOs which instantiate #$Ballot-CWs.")
(comment PhosphorousAcid "The collection of samples of phosphorous acid.  Its instances are moderately strong acids.  The formula for this type is H3PO3.")
(comment SituationTypeRoleConstraintPredicate "This is the collection of #$Predicates which are used to put constraints on the role players in scripts.  In a predicate of this type, the first argument is always a specialization of #$Situation and the second is a #$BinaryRolePredicate.  Further argument places, if any, alternate between situation-types and roles.")
(comment roleToRoleDiff "'(#$roleToRoleDiff EVENT-TYPE ROLE1 ROLE2)' means that whatever plays the role ROLE1 in an instance of EVENT-TYPE is different from whatever plays the role ROLE2 in that same instance.")
(comment differentRolePlayers-SitTypeToSubSitType "'(#$differentRolePlayers-SitTypeToSubSitType SITTYPE ROLE1 SUBSITTYPE ROLE2)' means that whatever plays the role ROLE1 in any instance of SITTYPE is different from whatever plays the role ROLE2 in the sub-situation of that instantance which is an instance of SUBSITTYPE.")
(comment differentRolePlayers-SubSitTypeToSubSitType "'(#$differentRolePlayers-SubSitTypeToSubSitType  SUBSITTYPE ROLE1 SUBSITTYPE1 ROLE2 SUBSITTYPE2)' means that, in any instantiation of SITTYPE, whatever plays the role ROLE1 in the sub-situation of that instantiation which is an instance of SUBSITTYPE1 is different from whatever plays the role ROLE2 in the sub-situation of that instantiation which is an instance of SUBSITTYPE2.")
(comment inheritRolePlayers-SubSitTypeToSubSitType "'(#$inheritRolePlayers-SubSitTypeToSubSitType SIT-TYPE ROLE1 SUBSIT-TYPE1 ROLE2 SUBSIT-TYPE2)' means that in any instance SIT of SIT-TYPE whatever things play ROLE1 in the sub-situation SUB1 (an instance of SUBSIT-TYPE1) will also play ROLE2 in sub-situation SUB2 (an instance of SUBSIT-TYPE2).  Note that this predicate does not require that there be a unique player of ROLE1 and ROLE2 in SUB1 and SUB2.  There could be multiple such role players.  For a similar predicate that does have a uniqueness presupposition, see #$inheritRolePlayers-SubSitTypeToSubSitType-Unique.")
(comment equivalentRolePlayers-SubSitTypeToSubSitType "'(#$equivalentRolePlayers-SubSitTypeToSubSitType SITTYPE ROLE1 SUBSITTYPE1 ROLE2 SUBSITTYPE2)' means that in any instance SIT of SITTYPE, where SUB1 and SUB2 are sub-situations of SIT and instances of SUBSITTYPE1 and SUBSITTYPE2, respectively, whatever things play ROLE1 in SUB1 also play ROLE2 in SUB2, and vice versa.")
(comment partsPartition "(#$partsPartition WHOLE SET-OF-PARTS) says that the #$Individual WHOLE can be decomposed entirely into the members of the set, SET-OF-PARTS.")
(comment BromiteIon "The collection of bromite ions. Their chemical formula is BrO2(-).")
(comment IoditeIon "The collection of iodite ions. Their chemical formula is IO2(-).")
(comment PerbromateIon "A specialization of #$PolyatomicAnion.  Instances of #$PerbromateIon are composed of one #$Bromine and four #$Oxygen atoms with an #$ElectronicCharge of -1.")
(comment PhosphideIon "A specialization of #$MonoatomicAnion.  Instances of
#$PhosphideIon are single #$Phosphorous atoms with an #$ElectronicCharge of -2.")
(comment equivalentRolePlayers-SitTypeToSubSitType-Unique " (#$equivalentRolePlayers-SitTypeToSubSitType-Unique  SITTYPE SITTYPE-ROLE SUBSITTYPE SUBSITTYPE-ROLE) means that in an instance of SITTYPE, the individual who plays the role SITTYPE-ROLE is the same as the individual who plays the role SUBSITTYPE-ROLE in the sub-situation that is an instance of SUBSITTYPE.  The predicate assumes existence and uniqueness of role-players.")
(comment equivalentRolePlayers-SubSitTypeToSubSitType-Unique "(#$equivalentRolePlayers-SubSitTypeToSubSitType-Unique SIT-TYPE ROLE1 SUBSIT-TYPE1 ROLE2 SUBSIT-TYPE2) means that in an instantiation of SIT-TYPE, the individual that plays the role ROLE1 in the sub-situation that instantiates SUBSIT-TYPE1 is the same as the individual that plays the role ROLE2 in the sub-situation that instantiates SUBSIT-TYPE2.")
(comment roleToRoleID "(#$roleToRoleID EVENT-TYPE ROLE1 ROLE2) means that in
instances of EVENT-TYPE, anything that plays the role ROLE1 is the
same as anything that plays the role ROLE2.  This predicate does not
presuppose existence or uniqueness of role-players.")
(comment typePlaysRoleInEventType "(#$typePlaysRoleInEventType EVENT-TYPE SOMETHINGEXISTING-TYPE ROLE) means that in instances of EVENT-TYPE, anything that plays the role ROLE must be an instance of SOMETHINGEXISTING-TYPE.")
(comment someAndOnlyTypePlaysRoleInSubSituationType "<code>(#$someAndOnlyTypePlaysRoleInSubSituationType SIT-TYPE TYPE SUBSIT-TYPE ROLE)</code> means that for any instance of <code>SIT-TYPE</code>, there exists an instance of <code>TYPE</code> that plays the role <code>ROLE</code> in the sub-situation that instantiates <code>SUBSIT-TYPE</code>, and that only an instance of <code>TYPE</code> plays that role. Cf. the more general predicate #$onlyTypePlaysRoleInSubSituationType, which does not require an instance of <code>TYPE</code> to play <code>ROLE</code> in instances of <code>SUBSIT-TYPE</code>, but rather requires that whatever plays <code>ROLE</code> in <code>SUBSIT-TYPE</code> be of <code>TYPE</code>.")
(comment BarricadeAndHoldHostage "The collection of all complex actions in which a car is stopped in its progress by physically barricading the thoroughfare, and its occupants are removed and taken hostage by whomever is doing the barricading.")
(comment JDBCConnectionSpecification "The collection of #$CommunicationWithServiceSpecifications suitable for communicating with Open Data Base Connectivity data sources.")
(comment JDBCConnectionSpecification "The collection of #$SKSConnectionSpecifications for connecting with data sources via JDBC.")
(comment BritishNationalCorpus "The #$BritishNationalCorpus (BNC) is a 100 million word collection of samples of written and spoken language from a wide range of sources, designed to represent a wide cross-section of current British English, both spoken and written.")
(disjointWith TemporalThing AtemporalThing)
(comment AtemporalThing "A specialization of #$Intangible (q.v.); the collection of all things that are \"timeless\" in the sense of having no \"location\" in time.  It makes no sense to ask of an atemporal thing (e.g.) \"<i>When</i> did it begin (or cease) to exist?\"  Examples of atemporal things include sets, collections, numbers, vectors, and certain \"abstract structures\" (such as the structure of a partial ordering); see #$SetOrCollection, #$Number-General, and #$VectorInterval.  Note that while all atemporals are intangible, the converse is not true.  Novels (see #$Novel-CW), languages, and geographical borders, for instance, are all intangible (i.e. they are not composed of or encoded in matter) but <i>not</i> atemporal, as they have a beginning and (in many cases) an end, and thus a temporal extent.  See also the specialization #$AbstractThing; and cf. #$TemporalThing.")
(disjointWith SpatialThing AspatialThing)
(comment AspatialThing "A specialization of #$Intangible (q.v.); the collection of all things with no spatial extent or location, either in some embedding space or relative to some #$SpatialThing (q.v.).  Examples include numbers, sets, collections, novels, languages, and time intervals (see #$Number-General, #$SetOrCollection, #$Novel-CW, #$NaturalLanguage, and #$TimeInterval).  Note that although anything aspatial is intangible, the converse is not true.  Geographical borders, latitude lines, and the trajectories of particles, for instance, are intangible (i.e. not composed of or encoded in matter), but <i>not</i> aspatial, as they have spatial location and extent.  See also the specialization #$AbstractThing.")
(comment ipPortForSKS "An afterslot relating a #$SKSConnectionSpecification to the port on which we will connect to its server.")
(comment serverForSKS "An afterslot relating a #$SKSConnectionSpecification to the address at which it can be found.")
(comment IP4MachineAddress "The collection of IP4 machine addresses (as opposed to addresses of networks).")
(disjointWith IP4NetworkOnlyAddress IP4MachineAddress)
(comment connectionProtocolForSKS "An afterslot relating a #$SKSConnectionSpecification to the connection protocol by which we will connect to its server.")
(comment databaseNameForSKS "An afterslot relating a #$SKSConnectionSpecification to the name of the database within it that we wish to connect, and to a specific sub-KS.")
(comment ProgramSpecificProtocolFn "The idiosyncratic protocol accepted by a program. Example: (#$ProgramSpecificProtocolFn #$PostgreSQL) refers to the protocol a #$PostgreSQL program accepts. A database driver for #$PostgreSQL translates the neutral database layer into this idiosyncratic protocol.")
(comment PrivateProperty "The collection of all things that are owned by private
citizens, and not owned by any government or government agency.")
(comment sksConnSpecKS "A binary predicate after-slot relating a connection specification to the Knowledge Source for which it specifies a connection.")
(comment sksConnSpecProcess "A binary predicate after-slot relating a connection specification to the #$ComputerProcessRunning for which it specifies a connection.")
(comment ScalarIntegralValue "A specialization of #$ScalarPointValue (q.v.).  Each instance of #$ScalarIntegralValue is either an #$Integer or a #$MeasurableQuantity  (q.v.) that is the value returned when some #$UnitOfMeasure (q.v.) function is applied to an #$Integer.  In the latter case, the quantity is said to be \"integral with respect to\" that unit-of-measure (see #$integralWRTUnit).
<p>
For example, both 6 and (#$Inch 6) are scalar integral values.  The latter is integral with respect to #$Inch.
<p>
#$ScalarIntegralValues are the admitted arguments for, and the values returned by, #$GreatestCommonDivisorFn and #$LeastCommonMultipleFn (qq.v.).
<p>
Note that, despite appearances to the contrary, (#$Foot-UnitOfMeasure 0.5) is a scalar integral value that is integral with respect to #$Inch, as it is equal to the scalar integral (#$Inch 6).  It might even be argued that, in principle, <i>every</i> #$MeasurableQuantity is integral with respect to some (reified or not) unit-of-measure or other.  But that is a contentious issue on which we need not take sides.")
(comment NonNegativeScalarIntegralValue "#$NonNegativeScalarIntegralValue is the sub-collection of #$ScalarIntegralValue that excludes the negative values.  It is the scalar analog of #$NonNegativeInteger.  E.g. (#$DegreeFahrenheit 5) is an instance of #$NonNegativeScalarIntegralValue, but (#$DegreeCelsius -15) is not.")
(comment sksConnSpecSubKS "A binary predicate after-slot relating a connection specification to a sub-KS for which it specifies a connection.")
(comment CyclicalIntervalGroupType "A collection of collections of collections of #$TimeIntervals. Each instance CIGTYPE of #$CyclicalIntervalGroupType is a specialization #$ConventionallyClassifiedTimeIntervalSeries, and is a collection of interval-types whose instances recur throughout all of calendar history.  Unlike instances of #$CyclicalSuccessiveIntervalGroupType, CIGTYPE may or may not partition all of time.  For example, CIGTYPE could be the collection of the seven calendar days of the week (see #$DayOfWeekType) or the collection of the twelve calendar months (see #$MonthOfYearType) or simply the collection of various times of the year (see #$TimeOfYearType).")
(comment TimeOfYearType "A specialization of #$ConventionallyClassifiedTimeIntervalSeries-Disjoint (q.v.), containing every collection TYPE of time intervals such that each calendar year intersects, indeed subsumes, exactly one member of TYPE; that is to say, the relation #$temporallySubsumes, when restricted to #$CalendarYear times TYPE, is a one-one function from #$CalendarYear to TYPE. Specializations of this collection include #$MonthOfYearType and #$DayOfYearType.")
(comment TimeOfMonthType "A specialization of #$ConventionallyClassifiedTimeIntervalSeries-Disjoint (q.v.), containing every collection TYPE of time intervals such that each calendar month intersects, indeed subsumes, exactly one member of TYPE; that is to say, the relation #$temporallySubsumes, when restricted to #$CalendarMonth times TYPE, is a one-one function from #$CalendarMonth to TYPE. A specialization of this collection is #$DayOfMonthType.")
(comment TimeOfWeekType "A specialization of #$ConventionallyClassifiedTimeIntervalSeries-Disjoint, containing every collection TYPE of time intervals such that each calendar week intersects, indeed subsumes, exactly one member of TYPE; that is to say, the relation #$temporallySubsumes, when restricted to #$CalendarWeek times TYPE, is a one-one function from #$CalendarWeek to TYPE. A specialization of this collection is #$DayOfWeekType.")
(comment TimeOfHourType "A specification of #$ConventionallyClassifiedTimeIntervalSeries-Disjoint (q.v.), containing every collection TYPE of time intervals such that each calendar hour intersects, indeed subsumes, exactly one member of TYPE; that is to say, the relation #$temporallySubsumes, when restricted to #$CalendarHour times such a TYPE, is a one-one function from #$CalendarHour to TYPE.")
(comment MinuteOfHourType "A specification of #$TimeOfHourType (q.v.), with each member to contain, for a fixed integer k with 0 < k <= 60, every k_th minute of an hour.")
(comment TimeOfMinuteType "A specialization of #$ConventionallyClassifiedTimeIntervalSeries-Disjoint (q.v.), containing every collection TYPE of time intervals such that each calendar minute intersects, indeed subsumes, exactly one member of TYPE; that is to say, the relation #$temporallySubsumes, when restricted to the Cartesian product (#$CalendarMinute times TYPE), is a one-one function from #$CalendarMinute to TYPE.")
(comment SecondOfMinuteType "A specialization of #$TimeOfMinuteType (q.v.), with each member to contain, for a fixed integer k with 0 < k <= 60, every k_th second of a minute.")
(comment SuicideAttack "A specialization of #$AttackOnTangible in which a perpetrator intentionally kills himself as a means of executing the attack. #$SuicideAttack includes both attacks that take place in military operations - such as Kamikaze attacks - as well as the more familiar terrorist tactic.")
(comment eventPlannedBy "(#$eventPlannedBy EVNT AGNT) means that AGNT intentionally carried out at least some significant portion of the planning required for EVNT to occur. AGNT might be an individual person or a group of people (e.g. an organization).")
(comment animalWoundedIn "(#$animalWoundedIn EVENT ANIMAL) means that ANIMAL was wounded during EVENT. #$animalWoundedIn is a specialization of #$animalInjuredIn where EVENT is an #$ActionOnObject.")
(comment citizens-Birth "(#$citizens-Birth COUNTRY PERSON) means that PERSON is a
citizen of COUNTRY, and became so at the time of (and by the
circumstances of) her birth.  The birth circumstances that are legally
sufficient for citizenship vary across countries.  In most countries,
citizenship is granted at birth if at least one of the birth parents
is a citizen.  In some countries, it also sufficient for citizenship at birth
if one is born within COUNTRY's territory (sometimes only if at least one parent is either a citizen or legal alien).")
(comment citizens-Naturalized "(#$citizens-Naturalized COUNTRY PERSON) means that PERSON is
a naturalized citizen of COUNTRY, i.e., a citizen of COUNTRY who
became so after (and through circumstances other than) birth.  The
requirements for becoming a naturalized citizen vary from country to
country.")
(comment disjunctiveProperSubSituationTypes "Where (#$properSubSituationTypes SITTYPE SUBSITTYPE), (#$disjunctiveProperSubSituationTypes SITTYPE SUBSITTYPE-TYPE LIST) means that in an instance SIT of SITTYPE with a sub-situation that is an instance SUBSIT of SUBSITTYPE, SUBSIT is also required to be an instance of at least one of the collections listed in LIST. For instance, one might specify that in a bank robbery, the getaway scene is an instance either of #$Running or of (#$TransportViaFn #$RoadVehicle).")
(comment localTo "(#$localTo OBJECT SPATIAL-THING) means that in the current context OBJECT is considered to be local to SPATIAL-THING, which may be a place, a person, or even an event.  Something is ``local'' if it can affect an agent (of the appropriate type) located in/at SPATIAL-THING whereas more distant things of the same type could not affect the agent in the same way, or that if an agent located in/at SPATIAL-THING wants to go to a place similar to OBJECT, OBJECT itself would be close enough to be considered as the destination.  Whether something is considered local is dependent upon the object type, the agent type, and the distance between them.  Even political considerations may ensue.  A local airport is likely to be further away than a local restaurant or post office.  If the closest library or elementary is in another country, it is unlikely to be considered as local.")
(comment animalInjuredIn "(#$animalInjuredIn EVENT ANIMAL) means that, during the course of EVENT, ANIMAL suffers damage to some part(s) of its body sufficient to qualify as an 'injury'.  The injury may be due to the actions of an outside actor on ANIMAL, such as when a person is struck by a falling rock, or not, as when a person strains a calf muscle while jogging.  For the special case of injuries suffered during hostile actions, see #$animalWoundedIn")
(comment animalBLOInjuredIn "(#$animalBLOInjuredIn EVENT ANIMAL-BLO) means that, during
the course of EVENT, ANIMAL-BLO -- which may be either an #$Animal or
an #$AnimalBodyPart -- suffers damage sufficient to qualify as an
'injury'.  The injury may be due to the actions of an outside actor, as when a person is struck by a falling rock, or not, as when a person strains a calf muscle while jogging.  When
ANIMAL-BLO is an #$AnimalBodyPart, the animal of which it is a part is
also injured.")
(comment ElementOfSign-TheSymbol "A sign which looks like a small, rounded uppercase E.")
(comment symbolDenotes "(#$symbolDenotes SYMBOL THING) means that SYMBOL denotes THING.")
(comment CountryWesternMusicPerformer "The collection of bands and solo artists that perform country and western music.")
(comment GangstaRapMusicPerformer "The collection of bands and solo artists that perform \"gangsta\" rap.")
(comment SalsaMusicPerformer "The collection of bands and solo artists that perform salsa music.")
(comment DiscoMusicPerformer "The collection of bands and solo artists that perform disco music.")
(comment KlezmerMusicPerformer "The collection of bands and solo artists that perform klezmer music.")
(comment CelticMusicPerformer "The collection of bands and solo artists that perform celtic music.")
(comment CountryMusicPerformer "The collection of bands and solo artists that perform country music.")
(comment FolkMusicPerformer "The collection of bands and solo artists that perform folk music.")
(comment BaroqueMusicPerformer "The collection of organizations and solo artists that perform baroque music.")
(comment OperaMusicPerformer "The collection of organizations and solo artists that perform opera music.")
(comment HipHopMusicPerformer "The collection of bands and solo artists that perform hip hop music.")
(comment 1980sPopMusicPerformer "The collection of bands and solo artists that perform 1980s pop music.")
(comment ClassicalMusicPerformer "The collection of organizations and solo artists that perform classical music.")
(comment SecondOfMinuteFn "(#$SecondOfMinuteFn k) with 0 <= k <= 59 is the collection of every (k+1)-th second of a minute.  For example, (#$TimeOfDayFn #$TimeOfDay-10AM (#$TimeOfHourFn (#$MinuteOfHourFn 30) (#$SecondOfMinuteFn 0))) is the collection of all `10:30:00am-10:30:01am' time intervals.")
(comment MinuteOfHourFn "(#$MinuteOfHourFn k) with 0 <= k <= 59 is the collection of every (k+1)-th minute of an hour.  For example, (#$TimeOfDayFn #$TimeOfDay-10AM (#$TimeOfHourFn (#$MinuteOfHourFn 30) (#$SecondOfMinuteFn 0))) is the collection of all `10:30:00am-10:30:01am' time intervals.")
(comment TimeOfCyclicalIntervalGroupFunction "A collection of functions that return instances of #$CyclicalIntervalGroupType.  Examples include #$TimeOfTypeFn, #$TimeOfYearFn, #$DayOfMonthFn and #$DayOfWeekInMonthFn etc.")
(comment HourOfDayFn "This constant is to facilitate inference with hours of days. (#$HourOfDayFn 0) is the same as #$TimeOfDay-MidnightHour, ..., (#$HourOfDayFn 23) is the same as #$TimeOfDay-11PM.")
(comment TimeOfYearFn "(#$TimeOfYearFn X Y) is the subset of Y (a #$TimeOfMonthType or a #$TimeOfDayType) containing every member of Y that intersects, in fact is subsumed by, a member of X (a #$MonthOfYearType or a #$DayOfYearType), i.e., (#$TimeOfYearFn X Y) = {y: y is a member of Y, and (#$temporallySubsumes x y) for some member x of X}.  Here are some examples: (1) (#$TimeOfYearFn #$May (#$DayOfMonthFn 7)) is the collection of all `May 7th' time intervals, (2) both (#$TimeOfYearFn #$May (#$TimeOfMonthFn (#$DayOfMonthFn 7) #$TimeOfDay-10AM)) and (#$TimeOfYearFn (#$DayOfYearFn May 7) #$TimeOfDay-10AM) are the collection of all `May 7th 10:00am-11:00am' time intervals, and (3) (#$TimeOfYearFn #$May (#$TimeOfMonthFn (#$DayOfMonthFn 7) (#$TimeOfDayFn #$TimeOfDay-10AM (#$TimeOfHourFn (#$MinuteOfHourFn 0) (#$SecondOfMinuteFn 0))))) is the collection of all `May 7th 10:00:00am-10:00:01am' time intervals.")
(comment TimeOfWeekFn "(#$TimeOfWeekFn X Y) is the subset of Y (a #$TimeOfDayType) containing all and only those members of Y which intersect, and in fact are subsumed by, some member of X (a #$DayOfWeekType), i.e., (#$TimeOfWeekFn X Y) = {y: y is a member of Y, and (#$temporallySubsumes x y) for some member x of X}.  For example, (#$TimeOfWeekFn #$Monday #$TimeOfDay-10AM) is the collection of all `Monday 10:00am-11:00am' time intervals, and (#$TimeOfWeekFn #$Monday (#$TimeOfDayFn #$TimeOfDay-10AM (#$TimeOfHourFn (#$MinuteOfHourFn 0) (#$SecondOfMinuteFn 0)))) is the collection of all `Monday 10:00:00am-10:00:01am' time intervals.")
(comment TimeOfMonthFn "(#$TimeOfMonthFn X Y) is the subset of Y (a #$TimeOfDayType) containing all and only those members of Y which intersect, in fact are subsumed by, some member of X (a #$DayOfMonthType), i.e., (#$TimeOfMonthFn X Y) = {y: y is a member of Y, and (#$temporallySubsumes x y) for some member x of X}.  For example, (#$TimeOfMonthFn (#$DayOfMonthFn 7) #$TimeOfDay-10AM) is the collection of all `the 7th day of the month 10:00am-11:00am' time intervals, and (#$TimeOfMonthFn (#$DayOfMonthFn 7) (#$TimeOfDayFn #$TimeOfDay-10AM (#$TimeOfHourFn (#$MinuteOfHourFn 0) (#$SecondOfMinuteFn 0)))) is the collection of all `the 7th day of the month 10:00:00am-10:00:01am' time intervals.")
(comment TimeOfHourFn "(#$TimeOfHourFn X Y) is the subset of Y (a #$TimeOfMinuteType) containing all and only those members of Y which intersect, in fact are subsumed by, some member of X (a #$MinuteOfHourType), i.e., (#$TimeOfHourFn X Y) = {y: y is a member of Y, and (#$temporallySubsumes x y) for some member x of X}.  For example, (#$TimeOfDayFn #$TimeOfDay-10AM (#$MinuteOfHourFn 30)) is the collection of all `10:30am-10:31am' time intervals, and (#$TimeOfDayFn #$TimeOfDay-10AM (#$TimeOfHourFn (#$MinuteOfHourFn 30) (#$SecondOfMinuteFn 0))) is the collection of all `10:30:00am-10:30:01am' time intervals.")
(comment TimeOfDayFn "(#$TimeOfDayFn X Y) is the subcollection of Y (a #$TimeOfHourType) containing all and only those members of Y which intersect, in fact are subsumed by, some member of X (a #$HourOfDayType), i.e., (#$TimeOfDayFn X Y) = {y: y is a member of Y, and (#$temporallySubsumes x y) for some member x of X}.  For example, (#$TimeOfDayFn #$TimeOfDay-10AM (#$MinuteOfHourFn 30)) is the collection of all `10:30am-10:31am' time intervals, and (#$TimeOfDayFn #$TimeOfDay-10AM (#$TimeOfHourFn (#$MinuteOfHourFn 30) (#$SecondOfMinuteFn 0))) is the collection of all `10:30:00am-10:30:01am' time intervals.")
(comment GospelMusicPerformer "The collection of bands and solo artists that perform gospel music.")
(comment ReggaeMusicPerformer "The collection of bands and solo artists that perform reggae music.")
(comment ProgressiveMusicPerformer "The collection of bands and solo artists that perform progressive music.")
(comment TimeOfTypeFn "(#$TimeOfTypeFn X Y) is the subset of Y containing all and only those members of Y which intersect, in fact are subsumed by, some member of X, i.e., (#$TimeOfMonthFn X Y) = {y: y is a member of Y, and (#$temporallySubsumes x y) for some member x of X}.  Here are some examples: (1) (#$TimeOfTypeFn #$May (#$DayOfMonthFn 7)) is the collection of all `May 7th' time intervals, (2) (#$TimeOfTypeFn (#$DayOfMonthFn 7) #$TimeOfDay-10AM) is the collection of all `the 7th day of the month 10:00am-11:00am' time intervals, and (3) (#$TimeOfTypeFn (#$DayOfMonthFn 7) (#$TimeOfTypeFn #$TimeOfDay-10AM (#$TimeOfTypeFn (#$MinuteOfHourFn 0) (#$SecondOfMinuteFn 0)))) is the collection of all `the 7th day of the month 10:00:00am-10:00:01am' time intervals.")
(comment ACappellaMusicPerformers "The collection of individuals or groups that perform a cappella music.")
(comment SwingMusicPerformer "The collection of individuals or groups that perform swing music.")
(comment HouseMusicPerformer "The collection of individuals or groups that perform house music.")
(comment AmbientMusicPerformer "The collection of individuals or groups that perform ambient music.")
(comment BloodTypeByABO "The collection of blood types by presence of A or B antigen.  There are four such types - A, B, O, AB.")
(disjointWith BloodTypeByABO BloodTypeByRhFactor)
(comment BloodTypeByRhFactor "The collection of blood types by presence or absence of Rh Factor.  Its two instances are #$RhPositive & #$RhNegative.")
(comment BloodTypeByABOAndRhFactor "The collection of blood types by presence of A or B antigen and presence or absence of Rh Factor.")
(disjointWith BloodTypeByABO BloodTypeByABOAndRhFactor)
(disjointWith BloodTypeByRhFactor BloodTypeByABOAndRhFactor)
(comment WorldFusionMusicPerformer "The collection of individuals or groups that perform world fusion music.")
(comment interArgInsIsa "A quintary instance of #$InterArgConstraintPredicate (q.v.).  (#$interArgInsIsa RELN k INDEP-INS n DEP-COL) means that, in order for any atomic sentence formed by RELN to be true, if INDEP-INS appears as the k-th argument to RELN, the n-th argument must be a member of DEP-COL. For example, (#$interArgInsIsa #$willBe-Metric-CalendarTime 1 #$CalendarYear 3 #$TimeOfYearType) means that in order for (#$willBe-Metric-CalendarTime X k Y PROP) to be true, X is (identical to) #$CalendarYear only if Y is a member of the collection #$TimeOfYearType.  For a more general explanation of independent and dependent arguments in the present sense, see #$InterArgConstraintPredicate.")
(comment RapMusicPerformer "The collection of individuals or groups that perform rap music.")
(comment RhythmAndBluesMusicPerformer "The collection of individuals or groups that perform rhythm and blues music.")
(comment SkaMusicPerformer "The collection of individuals or groups that perform ska music.")
(comment ScenGenStepSpecification "A specialization of #$ProgramStepSpecification.  Each instance of #$ScenGenStepSpecification describes how a particular rule should be handled by the scenario generator.")
(comment UnderstandingEnrichmentRelation "#$UnderstandingEnrichmentRelation is a specialization of #$BinaryRelation.  Each instance of #$UnderstandingEnrichmentRelation is a relation between two types of facts which have the following property: the belief that an instance of the first type of fact obtains would likely enrich one's understanding of an instance of the other type of fact.  Two of the most significant instances of #$UnderstandingEnrichmentRelation are #$implies and #$abductiveExpansion.")
(comment ChoralMusicPerformer "The collection of individuals or groups that perform choral music.")
(comment RockMusicPerformer "The collection of individuals or groups that perform rock music.")
(comment BluesMusicPerformer "The collection of individuals or groups that perform blues music.")
(comment softwareAssertionParameterValueInSpecification "(#$softwareAssertionParameterValueInSpecification PARAM RULE SPEC) states that, according to the #$ProgramSpecification SPEC, the #$SoftwareParameter PARAM has the value RULE. This predicate is useful to use instead of the more general #$softwareParameterValueInSpecification when the value of the parameter is a CycL rule -- this narrower predicate allows us to reference the rule itself.")
(comment RomanticMusicPerformer "The collection of individuals or groups that perform music from the Romantic era.")
(comment FunkMusicPerformer "The collection of individuals or groups that perform funk music.")
(comment ElectronicMusicPerformer "The collection of individuals or groups that perform electronic music.")
(comment LoungeMusicPerformer "The collection of individuals or groups that perform lounge music.")
(comment TraditionalPopMusicPerformer "The collection of individuals or groups that perform traditional pop music.")
(comment 1990sPopMusicPerformer "The collection of individuals or groups that perform 1990s pop music.")
(comment TechnoMusicPerformer "The collection of individuals or groups that perform techno music.")
(comment NewAgeMusicPerformer "The collection of individuals or groups that perform new age music.")
(comment BluegrassMusicPerformer "The collection of individuals or groups that perform bluegrass music.")
(comment AlternativeCountryMusicPerformer "The collection of individuals or groups that perform alternative country music.")
(comment ScenGenExpansionSpecification "A specialization of #$ScenGenStepSpecification.  Each instance of #$ScenGenExpansionSpecification describes how a particular rule should be handled by the scenario generator to expand a scenario. (See also #$ScenGenRefinementSpecification.)")
(comment ScenGenRefinementSpecification "A specialization of #$ScenGenStepSpecification.  Each instance of #$ScenGenRefinementSpecification describes how a particular rule should be handled by the scenario generator to refine a scenario. See also #$ScenGenExpansionSpecification.")
(comment ExperimentalMusicPerformer "The collection of individuals or groups that perform experimental music.")
(comment JazzMusicPerformer "The collection of individuals or groups that perform jazz music.")
(comment SoulMusicPerformer "The collection of individuals or groups that perform soul music.")
(comment FusionMusicPerformer "The collection of individuals or groups that perform jazz fusion music.")
(comment ChristianMusicPerformer "The collection of individuals or groups that perform Christian music.")
(comment CyberpunkMusicPerformer "The collection of individuals or groups that perform cyberpunk music.")
(comment UnderEvaluation "The collection of all objects that are undergoing some evaluation process.  After the evaluation is complete, the object is no longer  #$UnderEvaluation, but is #$Evaluated.  An object may have undergone a previous evaluation and so may be both #$UnderEvaluation and #$Evaluated  at the same time.")
(comment GothicMusicPerformer "The collection of individuals or groups that perform gothic (rock) music.")
(comment PsychedelicMusicPerformer "The collection of individuals or groups that perform psychedelic music.")
(comment SouthernRockMusicPerformer "The collection of individuals or groups that perform southern rock music.")
(comment PunkMusicPerformer "The collection of individuals or groups that perform punk rock.")
(comment SurfMusicPerformer "The collection of individuals or groups that perform surf music.")
(comment GlamRockPerformer "The collection of individuals or groups that perform glam rock.")
(comment ProgressiveRockMusicPerformer "The collection of individuals or groups that perform progressive rock music.")
(comment RockabillyMusicPerformer "The collection of individuals or groups that perform rockabilly music.")
(comment GrungeMusicPerformer "The collection of individuals or groups that perform grunge music.")
(comment CountryRockMusicPerformer "The collection of individuals or groups that perform country rock music.")
(comment IndustrialMusicPerformer "The collection of individuals or groups that perform industrial music.")
(comment BritishFolkRockMusicPerformer "The collection of individuals or groups that perform British folk rock music.")
(comment AlternativeRockMusicPerformer "The collection of individuals or groups that perform alternative rock music.")
(comment HeavyMetalMusicPerformer "The collection of individuals or groups that perform heavy metal music.")
(comment BluesRockMusicPerformer "The collection of individuals or groups that perform blues rock music.")
(comment PopRockMusicPerformer "The collection of individuals or groups that perform pop rock music.")
(comment FolkRockMusicPerformer "The collection of individuals or groups that perform folk rock music.")
(comment HardRockMusicPerformer "The collection of individuals or groups that perform hard rock music.")
(comment PostPunkMusicPerformer "The collection of individuals or groups that perform post punk music.")
(comment ChristmasCard "The collection of #$HolidayCards exchanged at Christmas to wish those who celebrate it a happy holiday.")
(comment SeasonallyUsedItemType "The attribute things have when they are intended for use during a 

particular time of year. This attribute mostly applies to products

which are sold around Christmas, Halloween, etc.")
(comment SeasonallyUsedItemType "The collection of all types of things that are used during certain parts of the year, but not others.  This includes winter clothing,
Christmas carols, snow shovels, swimming pools, seasonal food and drink, etc.")
(comment SeasonallyUsedItemType "The collection of all types of things that are used during certain parts of the year, but not others.  This includes winter clothing, Christmas carols, snow shovels, swimming pools, seasonal food and drink, etc.")
(comment NewWaveMusicPerformer "The collection of individuals or groups that perform new wave music.")
(disjointWith CommunicationAct-Single SortingSomethingMentally)
(disjointWith MakingSomething SortingSomethingMentally)
(disjointWith IntrinsicStateChangeEvent SortingSomethingMentally)
(disjointWith MedicalCareEvent SortingSomethingMentally)
(disjointWith RemovablePart IndependentThing)
(comment IndependentThing "The collection of all autonomous, largely self-sufficient, existing things that are considered separated (in some significant way) from other similar things.")
(disjointWith Subsidiary IndependentThing)
(disjointWith ControlledLand IndependentThing)
(disjointWith ProgramStep IndependentThing)
(disjointWith ServiceProgram IndependentThing)
(disjointWith ExternalAnatomicalPart IndependentThing)
(disjointWith InternalAnatomicalPart IndependentThing)
(disjointWith CornerOnObject IndependentThing)
(comment MusicalPerformanceAgentTypeByGenre "The collection of collections of performers and bands who play a certain type of music.  Each instance of this collection is a collection of musical performers or bands that 
play a certain genre of music.  Specifically,  for every instance, PERFORMER, of an instance of this collection (#$styleOfArtist PERFORMER GENRE) holds for some GENRE that is an instance of #$MusicalGenreType.  And for each instance, PERFORMER-TYPE, of this 
collection every instance of PERFORMER-TYPE is related via #$styleOfArtist 
assertions to the same GENRE")
(comment groupOfMiscellaneousItems "An attribute used to describe heterogenous groups of things whose members can't be easily classified under more cohesive, informative headings.")
(comment groupOfMiscellaneousItems "(#$groupOfMiscellaneousItems GROUP COLLECTION) means that GROUP is a group of instances of COLLECTION -- a rather heterogeneous collection that has several more homogeneous specializations -- but there is no regular specialization of COLLECTION that all the members of GROUP are also a member of.  GROUP must have at least 4 members.")
(comment unchangedWRTIsa "(#$unchangedWRTIsa THING COLLECTION EVENT) means that THING is an instance of COLLECTION before, during, and after EVENT.  This predicate is used for collections in which which membership may change over time [#$TimeDependentCollection] and for things which are involved (or plausibly may be involved) in EVENT in some way (see #$actors).")
(comment Parallelepiped "A #$ThreeDimensionalShapeType and a specialization of #$Polyhedron.  Each instance of #$Parallelepiped is a three-dimensional object each of whose six faces is a #$Parallelogram.  Examples include spatially-localized as well as abstract parallelipipeds.  An important specialization of this collection is #$RectangularParallelepiped.")
(comment Drill "A tool used for boring holes in objects by means of a rotating sharp-edged cylindrical bit.")
(comment StringTrimWhiteSpaceFn "#$StringTrimWhiteSpaceFn is an evaluatable function that takes a string as
          its argument and returns a version of the string where any leading and trailing whitespace characters are removed.")
(disjointWith Water DietSoftDrink)
(comment ProjectileLaunching "This is the collection of all events in which a projectile launcher launches a projectile.")
(comment PullingATrigger "This is the collection of all actions of pulling the trigger on a gun or similar object.")
(comment causes-SubSitTypeSubSitType-Unique "'(#$causes-SubSitTypeSubSitType SCRIPT SCENE1 SCENE2)' means that in any instantiation of SCRIPT, the subsituation which instantiates SCENE1 is the cause of the subsituation which instantiates SCENE2.")
(comment LoadedWeapon "This is the collection of #$ProjectileLaunchers which are loaded with an appropriate #$ProjectileWeapon, and therefore have the resource needed to fire.")
(comment GunFiring "This is the collection of all events in which a gun fires a bullet.")
(comment UnloadingAProjectileWeapon "This is the collection of events in which a projectile-firing weapon is completely unloaded so that it is no longer capable of firing.")
(comment AimingAGun "This is the collection of all actions in which a person aims a gun.")
(comment animateActors "An #$ActorSlot and thus a specialization of #$actors (q.v.).  (#$animateActors EVENT ACTOR) means that (#$actors EVENT ACTOR) and that ACTOR is alive (see #$BiologicalLivingObject) during EVENT.  Specializations of #$animateActors include the predicates #$animateDoers, #$animateActedOn, #$lifeOf, and #$actorPartsInvolved.  See also #$AnimateActivity.")
(disjointWith Aurora-Ionospheric AnimateActivity)
(disjointWith WeatherEvent AnimateActivity)
(comment AnimateActivity "A specialization of both #$Action (q.v.) and #$Event-Localized.  Every instance of #$AnimateActivity is a spatially-localized action, each of whose \"doers\" (see #$doneBy and #$animateDoers) is either a #$BiologicalLivingObject or a group of BLOs (i.e. a #$Group all of whose members are BLOs).  Specializations of this collection include #$AnimalActivity, #$BiologicalEvent, and #$PhysiologicalProcess.")
(disjointWith ComputerProcessRunning AnimateActivity)
(disjointWith InformingProgramUser AnimateActivity)
(disjointWith NuclearEvent AnimateActivity)
(disjointWith SyntheticSound AnimateActivity)
(disjointWith CelestialEvent AnimateActivity)
(comment animateActedOn "An #$ActorSlot and a specialization of both #$animateActors and #$objectActedOn (qq.v.).  This predicate relates an event to any living things (see #$BiologicalLivingObject) that are significantly affected in that event.  (#$animateActedOn EVENT BLO) means that (#$objectActedOn EVENT BLO) and BLO is alive during EVENT.  An important specialization of this predicate is #$bodilyActedOn.  See also #$AnimateActivity and #$animateDoer.")
(comment animateDoer "An #$ActorSlot and a specialization of both #$animateActors and #$doneBy (qq.v.).  (#$animateDoer ACT DOER) means that ACT is an instance of #$Action that is \"done by\" DOER, and DOER is alive during ACT.  An important specialization of #$animateDoer is #$bodilyDoer.  See also #$AnimateActivity and #$animateActedOn.")
(comment DamWithHighDownstreamHazardPotential "The collection of all #$Dams that are considered to have a high risk of downstream hazards.")
(comment DamTypeByDownstreamHazardPotential "A collection of the collections of dams as assessed by their downstream hazard potential.")
(comment NavigationDam "The collection of all #$Dams that are used for navigation.")
(comment DamTypeByUse "A collection of the collections of dams as assessed by their uses.")
(comment IrrigationDam "The collection of all #$Dams that are used for irrigation.")
(comment DebrisControlDam "The collection of all #$Dams that are used for debris control.")
(comment FloodControlDam "The collection of all #$Dams that are used for flood control.")
(comment DamWithUnspecifiedUses "The collection of all #$Dams with unspecified uses not covered by instances of #$DamTypeByUse.")
(comment StockDam "The collection of all #$Dams that are used for fish farm stocks including small farm ponds.")
(comment RecreationDam "The collection of all #$Dams that are used for recreation.")
(comment WaterSupplyDam "The collection of all #$Dams that are used for water supply.")
(comment DamWithSignificantDownstreamHazardPotential "The collection of all #$Dams that are considered to have a significant risk of downstream hazards.")
(comment DamWithLowDownstreamHazardPotential "The collection of all #$Dams that are considered to have a low risk of downstream hazards.")
(comment DamWithUnspecifiedStructure "The collection of all #$Dams constructed with unspecified structures.")
(comment DamTypeByStructure "A collection of the collections of dams as assessed by their structures.")
(comment DamTypeBySpillage "A collection of the collections of dams as assessed by their spillage control.")
(comment DamWithNoSpillage "The collection of all #$Dams with no spillage.")
(comment Non-FederallyOwnedDam "The collection of all #$Dams not owned by the (#$GovernmentFn #$UnitedStatesOfAmerica).")
(comment DamTypeByOwnership "A collection of the collections of dams as assessed by ownership.")
(comment ArchDam "The collection of all #$Dams constructed with arch structures.")
(comment DamWithUncontrolledSpillage "The collection of all #$Dams with uncontrolled spillage.")
(comment FederallyOwnedDam "The collection of all #$Dams owned by the (#$GovernmentFn #$UnitedStatesOfAmerica).")
(comment EarthDam "The collection of all #$Dams constructed with earth stuctures.")
(comment DamWithControlledSpillage "The collection of all #$Dams with controlled spillage.")
(comment CorpsOfEngineersOwnedDam "The collection of all #$Dams owned by the Corps of Engineers")
(comment distanceToNearestDownstreamTown "(distanceToNearestDownstreamTown DAM DIST) relates a dam DAM to the distance DIST between DAM and the nearest town downstream from the dam.")
(comment GravityDam "The collection of all #$Dams constructed with gravity stuctures.")
(comment populationAtRisk "(#$populationAtRisk OBJ NUM) relates a #$PartiallyTangible OBJECT to the number of people NUM that it potentially puts at risk.")
(comment Multi-ArchDam "The collection of all #$Dams constructed with multi-arch stuctures.")
(comment DamTypeByFederalRegulation "A collection of the collections of dams as assessed by whether or not they are federally regulated.")
(comment FederallyRegulatedDam "The collection of all #$Dams regulated by (#$GovernmentFn #$UnitedStatesOfAmerica).")
(comment Non-FederallyRegulatedDam "The collection of all #$Dams not regulated by (#$GovernmentFn #$UnitedStatesOfAmerica).")
(comment normalStorageOfDam "(#$normalStorageOfDam DAM VOLUME) relates a #$Dam DAM to the volume of liquid VOLUME that it contains under normal conditions.  Typically, VOLUME will be less than the maximum amount that the dam can hold.")
(comment RockfillDam "The collection of all #$Dams constructed with rockfill stuctures.")
(comment Acre-Foot "A function which returns an element of #$Volume. One acre-foot (#$Acre-Foot 1) equals about 43,560 cubic feet or 1233.5 cubic meters.")
(comment ButtressDam "The collection of all #$Dams constructed with buttress stuctures.")
(comment languagePromptForUIA "(#$languagePromptForUIA LANGUAGE PROMPT) means that PROMPT is to be displayed to ask the user if they want to interact in LANGUAGE.")
(disjointWith KosherFood (MeatFn BirdOfPrey))
(disjointWith KosherFood (MeatFn Ray-Fish))
(disjointWith KosherFood (MeatFn Eel))
(disjointWith KosherFood (MeatFn Snail))
(comment KosherFood "The collection of all food that may be eaten according to the #$KosherCodeOfConduct.")
(disjointWith Pork KosherFood)
(disjointWith KosherFood (MeatFn Shellfish))
(disjointWith KosherFood (MeatFn CarnivoreOrder))
(disjointWith KosherFood (MeatFn Horse))
(disjointWith KosherFood (MeatFn Rodent))
(comment KosherFoodPreparationEvent "The collection of all food preparation events that conform to the #$KosherCodeOfConduct.")
(comment KosherUtensil "The collection of all food utensils that have not been in contact with both meat and a food containing milk products.  Three types of kosher utensils are considered: meat dishes, milk dishes, and neutral (pareve) dishes.")
(comment KosherUtensil-Meat "The collection of all food utensils that have been in contact with meat but have not been in contact with milk-derivative products.")
(comment KosherUtensil-Pareve "The collection of all food utensils that have been in contact with neither meat nor milk-derivative products.")
(comment KosherMeal "The collection of all dining events in which #$KosherFood is eaten using #$KosherUtensils, and is not in violation of restrictions on the timing limitations between eating meat and milk products.")
(comment inactiveWRT "(#$inactiveWRT AGENT INDIVIDUAL) means that the specified agent is not performing any deliberate action with respect to the specified individual.  INDIVIDUAL may be an event, organization, person, or something more abstract such as Civil Rights.")
(comment NotAll-NLAttr "The attribute value carried by utterances of the form \"not all XXX\" or \"not every XXX\".")
(comment PurposefulAction-ResourceDrivenWithTransfer "A specialization of #$PurposefulAction-ResourceDriven.  Each instance of #$PurposefulAction-ResourceDrivenWithTransfer is a complex event in which an agent emplaces controlled resources and then uses them to accomplish a goal.  In other words, #$PurposefulAction-ResourceDrivenWithTransfer is a script with two scenes: #$GeneralizedTransfer and #$PurposefulAction (qq.v).  An illustrative example specialization of #$PurposefulAction-ResourceDrivenWithTransfer is #$BrushingTeeth.  Each instance of #$BrushingTeeth is an event in which a person brushes his/her teeth.  In such an event the resources controlled are a toothpaste tube and a tooth brush.  The toothpaste is emplaced appropriately on the toothbrush and the toothbrush is emplaced in the tooth-brusher's hand.  Finally, the tooth-brusher uses the toothbrush with toothpaste on it to clean his/her teeth.  Note that the resources that \"drive\" an instance of #$PurposefulAction-ResourceDrivenWithTransfer need not be consumed -- they may merely be used.  For example, in a tooth-brushing event, some toothpaste is consumed, but a toothbrush is only used.")
(comment HiringSomeoneToDoSomething "A specialization of #$PurposefulPhysicalAction and #$SocialOccurrence and an instance of #$LearnedActivityType.  Each instance of #$HiringSomeoneToDoSomething is  an event in which one agent hires another agent to perform a service, and in which that service is performed.  Do not confuse this collection with either #$ContractingAService or #$ServiceEvent, instances of each of which are always sub-events of instances of #$HiringSomeoneToDoSomething: in an instance of #$HiringSomeoneToDoSomething, the hirer contracts a service and pays for it, and the person hired performs the service and gets paid.")
(comment specialWRT "An attribute used to indicate the quality of being unique or specific to a person or thing or category.")
(comment specialWRT "(#$specialWRT THING PRED N) means that if the predicate PRED is true for a sentence with THING as its Nth argument, then for any immed
iate \"sibling\" of THING (i.e. any other instance of any #$nearestIsa of THING), the same sentence would not be true if THING were replaced by 
the sibling.")
(comment Backreference-ClassA-NLAttr "#$Backreference-ClassA-NLAttr covers items which are used when referring back to an object that is proximal to the backreferencing item, typically within the sentence itself. For example, Japanse 'kono'.")
(comment Demonstrative-ClassC-NLAttr "#$Demonstrative-ClassC-NLAttr covers demonstrative items which are used when referring to something that is relatively far from the 'speaker' but relatively close to the 'listener'. Examples include Japanese 'sono' and Spanish 'ese'.")
(comment Demonstrative-ClassB-NLAttr "#$Demonstrative-ClassB-NLAttr covers demonstrative items which are used when referring to something which is notably far from both the 'speaker' and the 'listener'. Examples include Japanese 'ano', the various forms of French 'ce-la', and English 'that' (and, perhaps, 'yonder' in some dialects).")
(comment Demonstrative-ClassA-NLAttr "#$Demonstrative-ClassA-NLAttr covers demonstrative items which are used when referring to something that is relatively close to the 'speaker'. Examples include English 'this', Japaense 'kono', and the various forms of French 'ce-ci'.")
(comment Backreference-ClassC-NLAttr "#$Backreference-ClassC-NLAttr covers items which are used when referring back to an object which is pragmatically distant from the backreferencing item, but is (in some language-specific way) considered 'close' or 'relevant' to the 'listener'. For example, Japanse would use 'sore' (ClassC) when referring to commonplace collections such as peasants, but 'are' (ClassB) when referring to a faraway individual such as Mt. Fuji.")
(comment pathogenSoleCauseOfInfectionType "(#$pathogenSoleCauseOfInfectionType ORGANISMTYPE INFECTIONTYPE) means that every instance of INFECTIONTYPE is caused by instances of ORGANISMTYPE playing the role of #$infectionCausedByOrganism in the infection.")
(comment WildAction "The collection of all actions in which those taking the action [see #$performedBy] repeatedly violate normal codes of conduct [see #$CodeOfConduct] in a non-organized manner.")
(comment StandingUp "This is the collection of actions in which an animal rises into a standing posture.")
(comment ChangingPosture "This is the collection of actions in which an animal moves its body in such a way as to change its posture.")
(disjointWith LocomotionEvent ChangingPosture)
(disjointWith PhysiologicalProcess ChangingPosture)
(disjointWith MakingSomething ChangingPosture)
(disjointWith PhysicalTransformationEvent ChangingPosture)
(comment RollingOver-Animal "This is the collection of actions in which an animal changes its posture while remaining in a reclining position.")
(comment Kneeling "This is the collection of actions in which an animal moves its body into a kneeling posture.")
(comment ConventionallyClassifiedTimeIntervalSeries-DisjointWithGaps "A specialization of #$ConventionallyClassifiedTimeIntervalSeries-Disjoint (q.v.).  Each instance TYPE of #$ConventionallyClassifiedTimeIntervalSeries-DisjointWithGaps is a collection of `solid' intervals, which is conventionally named, such that members of TYPE are not only temporally disjoint with each other but also have gaps between them.  Examples of members of this collection are #$Friday, #$TimeOfDay-10AM etc.")
(disjointWith ClimateCycleType ConventionallyClassifiedTimeIntervalSeries-DisjointWithGaps)
(disjointWith SpatialThingTypeByShape ConventionallyClassifiedTimeIntervalSeries-DisjointWithGaps)
(comment ConventionallyClassifiedTimeIntervalSeries-Disjoint "A specialization of #$ConventionallyClassifiedTimeIntervalSeries (q.v.) and #$TemporallyDisjointTemporalObjectType.  Each instance TYPE of #$ConventionallyClassifiedTimeIntervalSeries-Disjoint is a `series' of `solid' intervals, which is conventionally named, such that members of TYPE are temporally disjoint with each other but may or may not have gaps between them.  Examples of members of this collection are #$Friday (with `gaps'), #$TimeOfDay-10AM (with `gaps'), #$CalendarYear (without `gaps') etc.  A useful specialization of this collection is #$ConventionallyClassifiedTimeIntervalSeries-DisjointWithGaps.")
(disjointWith ConventionallyClassifiedTimeIntervalSeries-Covering ConventionallyClassifiedTimeIntervalSeries-DisjointWithGaps)
(comment ConventionallyClassifiedTimeIntervalSeries-Covering "A specialization of #$ConventionallyClassifiedTimeIntervalSeries (q.v.).  Each instance TYPE of #$ConventionallyClassifiedTimeIntervalSeries-Covering is a `series' of `solid' intervals, which is conventionally named, such that members of TYPE jointly cover the time line in the sense that each time point (relative to the notion of time in the context) is subsumed by some member of TYPE.  Note that members of an instance TYPE of this collection do not have to be temporally disjoint, unlike members of the specialization #$ConventionallyClassifiedTimeIntervalSeries-CoveringAndDisjoint of this collection.")
(comment ConventionallyClassifiedTimeIntervalSeries-CoveringAndDisjoint "A specialization, in fact the intersection, of #$ConventionallyClassifiedTimeIntervalSeries-Disjoint and #$ConventionallyClassifiedTimeIntervalSeries-Covering (q.v.v.).  This collection sounds very much like #$CalendarCoveringType, but here are the differences. (I) Not all instances of #$CalendarCoveringType are instances of #$ConventionallyClassifiedTimeIntervalSeries-CoveringAndDisjoint. The judgment on whether an instance INS of the former is an instance of the latter depends on whether it makes sense in ordinary English to say `the next INS'. For example, `the next year', `the next month', `the next week', `the next day' (tomorrow) etc. make perfect sense in English, perhaps `the next hour' or even `the next minutes' are still okay. It is hard to say whether `the next second' is a member of this collection, but `the next Planck second' or `the next 10^-24 second' should not belong to this collection. (II) Certain interval types not included in #$CalendarCoveringType may belong to #$ConventionallyClassifiedTimeIntervalSeries-CoveringAndDisjoint. For example, if we want to talk about `stages' in an long event or a scenerio, or `stages' in a plan, we can have these types of intervals included in #$ConventionallyClassifiedTimeIntervalSeries-CoveringAndDisjoint. (III) Each instance of #$CalendarCoveringType must contain intervals that are enough to literally cover the entire time line, while an instance of #$ConventionallyClassifiedTimeIntervalSeries-CoveringAndDisjoint does not have to have that property. For example, when we talk about `stages' in a scenerio, we don't have to consider the time after the scenerio, and therefore the `stages' do not have be extended to cover the end of time.")
(comment additionalConsequent "A #$MetaKnowledgePredicate that is used to add additional consequents to asserted rules (see #$CycLRuleAssertion). (#$additionalConsequent SENTENCE RULE) means that SENTENCE is an additional consequent for RULE.")
(comment DeployingABiologicalAgent "A specialization of #$DeployingAChemicalOrBiologicalAgent. Instances are such that the #$agentDeployed-BCW is some #$BiologicalAgentStuff.")
(comment DeployingABiologicalToxin "A specialization of #$DeployingAChemicalOrBiologicalAgent. Instances are such that the #$agentDeployed-BCW is some #$BiologicalToxin.")
(comment ConventionallyClassifiedTemporalObjectSeries "A specialization of #$ConventionalClassificationType (q.v.) and #$TemporalObjectType.  Each instance of #$ConventionallyClassifiedTemporalObjectSeries is a series of temporal objects (of the same kind) such that for each E in the series one can meaningfully speak of `the one before E' or `the one after E' in the series (or speak of `the last one' or `the next one' etc. in the series if we are to temporally locate ourselves in E). Examples of instances of this collection include #$CalendarYear, #$Friday and #$ChristmasHoliday etc.  Two important specializations of this collection are #$ConventionallyClassifiedTimeIntervalSeries and #$AnnualHolidayType (q.v.).")
(comment AnnualHolidayType "A specialization of #$ConventionallyClassifiedTemporalObjectSeries.  An instance X-DAY of #$AnnualHolidayType is itself a specialization of #$Holiday (q.v.) such that each member of X-DAY is subsumed by one and only one calendar year.")
(comment DayOfWeekInMonthFn "A function of type #$TimeOfCyclicalIntervalGroupFunction. (#$DayOfWeekInMonthFn DAY-OF-WEEK k) is a #$DayOfMonthType containing all the calendar days each of which is the k-th DAY-OF-WEEK of a month.  For example, (#$DayOfWeekInMonthFn #$Sunday 1) is the collection of all `the 1st Sunday of the month' time intervals, and (#$DayOfWeekInMonthFn #$Monday 2) is the collection of all `the 2nd Monday of the month' time intervals.")
(comment CyclicalIntervalTypeOnCalendarScale "A specialization of #$ConventionallyClassifiedTimeIntervalSeries, and a specialization of the union of all members of #$CyclicalIntervalGroupType.  Each instance of #$CyclicalIntervalTypeOnCalendarScale is a type TYPE of time intervals that recur throughout all of calendar history based on a calendar scale CS (year, month, week, day, hour etc.), i.e., TYPE intersects CS with a unique member.  Examples of specializations of this collection are #$TimeOfYearType, #$DayOfWeekType, #$TimeOfDayType etc.")
(comment resultGenlArgArgIsa "(#$resultGenlArgArgIsa FUNCTION ARG-NUM ARGISA-NUM) says that any #$CycLNonAtomicTerm NAT built from the #$CollectionDenotingFunction FUNCTION will be a specialization of TYPE, where (#$argIsa RELN ARGISA-NUM TYPE) and (#$argN RELN ARG-NUM NAT).  So, for example, (#$resultGenlArgArgIsa #$SubcollectionOfWithRelationToFn 2 1) entails that (#$genls (#$SubcollectionOfWithRelationToFn #$Thing #$likesAsFriend FRED) #$PerceptualAgent), since (#$argIsa #$likesAsFriend 1 #$PerceptualAgent) and #$likesAsFriend appears as the 2nd argument to the NART.")
(comment PhysicalDestructionFn "#$PhysicalDestructionFn is a function that returns a collection of physical destruction events when given an instance of #$PartiallyTangible as an argument.  <code>(#$PhysicalDestructionFn TANG-TYPE)</code> denotes the specialization of #$PhysicalDestructionEvent in which instances of <code>TANG-TYPE</code> are destroyed.  Cf. #$DestructionFn.")
(comment compositionScoredForInstrumentTypes "(#$compositionScoredForInstrumentTypes COMPOSITION INSTRUMENT) says INSTRUMENT, a type of musical instrument, is among the instrument-types for which the musical composition COMPOSITION was scored.")
(comment musicTypeIsOfGenre "(#$musicTypeIsOfGenre MUSIC-TYPE  MUSIC-GENRE) holds just in case for each
instance, INS, of MUSIC-TYPE there is a corresponding instance of MUSIC-GENRE,
INS-MC, such that (#$instantiationOfWork INS-MC INS) holds.  This predicate relates a type of
music with a type or genre of musical composition.")
(comment G-SeriesNerveAgentType "The collection of all nerve agent types in the G-Series. Instances include #$Sarin (GB), #$Soman (GD), #$Tabun (GA), and #$Cyclosarin (GF).")
(comment RoomTemperature "Room temperature, 20-25 degrees celsius.")
(comment stateOfMatterAtTemperature "A #$RuleMacroPredicate, useful for stating tersely what the state of matter (see #$stateOfMatter) of all instances of a given type is, at a certain temperature.  (#$stateOfMatterAtTemperature TYPE STATE TEMPERATURE) says that for every instance INS of TYPE such that (#$temperatureOfObject INS TEMPERATURE), (#$stateOfMatter INS STATE) is true.")
(comment Gel "#$Gel is the collection of gels. #$Gels are semi-solid, sticky,
tangible stuff.  #$Gels cannot be poured. #$Gels are thicker
than creams and are the same thickness as pastes.")
(comment OrganophosphateCompoundType "A collection of instances of #$ChemicalSubstanceType, used both in chemical warfare and for agricultural and industrial purposes, exposure to which can cause severe nervous-system damage in humans.")
(comment Acetylcholinesterase "A kind of #$ChemicalSubstanceType, which serves to break down #$Acetylcholine, thereby preventing continuous, uncontrolled stimulation of muscarinic and nicotinic receptors.")
(comment Acetylcholine "A kind of #$Neurotransmitter, which serves to relay signals to muscarinic and nicotinic receptors.")
(comment AcetylcholineHydrolysis "A specialization of #$ChemicalReaction.  This type of reaction is necessary in the human body to prevent acetylcholine poisoning.")
(comment Choline "A member of the #$VitaminBComplex.")
(comment ComputerNetworkContactAddress "The collection of unique ID strings that are used as addresses on a computer network. This includes e-mail addresses, URLs, ICQ addresses, and so on.")
(comment AcetylcholinePoisoning "A specialization of #$AilmentCondition.  #$AcetylcholinePoisoning occurs when too much #$Acetylcholine builds up in the nervous system, leading to overstimulation of the muscles.")
(comment V-SeriesNerveAgentType "The collection of all instances of nerve agents in the V-Series (e.g. Instances of #$VX-NerveAgent, #$VS-NerveAgent, #$VM-NerveAgent, #$VK-NerveAgent, etc). The 'V' stands for 'venom' or 'venomous'.")
(comment ConceptualWork-CyberpunkGenre "The Collection of instances of 
#$ConceptualWork  that are in the cyberpunk style or genre.")
(comment poisonedWithSubstanceType "(#$poisonedWithSubstanceType POISONING STUFF) says that in the #$Poisoning event POISONING, the #$bodilyDoer has been poisoned with some STUFF.  Note that STUFF need not be a specialization of #$Poison, as in sufficient dosages (e.g., water), almost any substance could be toxic.")
(comment GUIDString "#$GUIDString is the collection of #$SubLStrings which denote Globally Uniquie IDentifiers (aka GUIDs).")
(comment IncurringDamage "A specialization of #$Event-Localized. Each instance of this collection is an event in which some sort of damage is incurred to an instance of #$SomethingExisting. Damage may be understood in functional terms as injury to organisms or impairment of usefulness or value of things owned or used in any way by them. (Note that for this reason not all instances of #$PhysicalDestructionEvent are instances of #$IncurringDamage).
<p>
Examples include denting a car, the breaking of someone's leg, the defacing of a website and slander which negatively impacts someone's reputation. For cases where the thing damaged is a material thing (i.e. an instance of #$PartiallyTangible), or an agent, see the more specialized constants #$IncurringPhysicalDamage and #$HarmingAnAgent respectively.")
(comment SocialInsuranceNumber-Canada "A specialization of #$UniqueID and #$IDNumber. Each instance of #$SocialInsuranceNumber-Canada is a nine-digit unique identification number used to register Canadian citizens or residents with Canada's employment insurance and pension plans.")
(comment INSEENumber-France "A specialization of #$UniqueID and #$IDNumber. Each instance of #$INSEENumber-France is a unique identification number used by the French organization INSEE for statistical and census purposes.")
(comment MilligramMinute "An obscure #$UnitOfMeasure, defined as minutes multiplied by milligrams.  In medical contexts, it is used in conjunction with a measure of volume (e.g., #$Liter) to calculate time of exposure to a concentration (in milligrams per unit of volume) of some substance.")
(comment NounCompoundPhrase "The collection of N-bar or NP phrases consisting of a string of nouns. Examples include 'banana peel', 'school board', and 'company cars'.")
(comment LevelOfExposure "The collection of degrees to which something is exposed to some substance.")
(comment UnitOfMassByTime "An obscure specialization of #$UnitOfMeasure, each instance of which is derivable by multiplying (via #$UnitProductFn) a #$UnitOfMass by a #$UnitOfTime.  Instances of #$UnitOfMassByTime are typically used in medical contexts with units of volume (see #$UnitOfVolume) to calculate levels of exposure to harmful substances.  Examples include #$MilligramMinute.")
(comment levelOfExposureToSubstanceType "(#$levelOfExposureToSubstanceType EVENT TANGIBLE STUFF LEVEL) says that the #$PartiallyTangible object TANGIBLE has been exposed to LEVEL degree of STUFF.  For example (#$levelOfExposureToSubstanceType #$WorldWarII CityBlock005 #$RadioactiveStuff (#$HighAmountFn #$LevelOfExposure)) says that during WWII, city block 005 underwent a high level of exposure to some radioactive material.")
(comment NerveAgentType "The collection of #$ChemicalSubstanceTypes designed to act on the human #$NervousSystem.")
(comment performedBy-Partially "(#$performedBy-Partially ACTION ACTOR) means that more than one actors perform ACTION and ACTOR is one of those actors.")
(comment performedBy-Uniquely "(#$performedBy-Uniquely ACTION ACTOR) means that ACTOR is the only performer of ACTION.")
(comment MicrotheoryDimension "The collection of #$MicrotheoryDimensions denotes the set of different slices of 
context space.")
(comment MtTimeDimension "The slice of context space which factors out temporal relevance.")
(comment MtMonadDimension "This specifies the slice of context space that is unfactored.  It is an extensional
slice insofar as it represents the chunk of context space which is currently not factorable.")
(comment TimeDimensionMicrotheory "Instances of #$TimeDimensionMicrotheory are those #$SingleFixedDimensionMicrotheorys
that carve out the time dimension of context space, i.e. #$MtTimeDimension. Microtheories that 
are nauts with functor of #$MtTimeDimFn or #$MtTimeWithGranularityDimFn are instances of
#$TimeDimensionMicrotheory.")
(comment mtDimension "#$mtDimension relates instances of #$SingleFixedDimensionMicrotheory to the dimension
of context space for which they carve out a value. (#$mtDimension SFD-MT DIM) means that the
only dimension of context space for which SFD-MT specifies a value is DIM.  
E.g. (#$mtDimension (#$MtTimeDimFn (#$YearFn 2000)) #$MtTimeDimension) ")
(comment mtDimensionValue "(#$mtDimensionValue MT DIM SFD-MT) means that the #$SingleFixedDimensionMicrotheory,
SFD-MT, is the DIM slice of MT.  #$Microtheorys can be factored into their different dimensions
with #$mtDimensionValue relations.  cf #$mtDimensionComplementValue.")
(comment mtDimensionComplementValue "(#$mtDimensionComplementValue MT DIM POLY-MT) means that the #$PolyadicMicrotheory,
POLY-MT, is the part of MT left once the DIM dimension has been factored out.  
cf #$mtDimensionValue.")
(comment amountOfStuffInRole "A #$QuaternaryPredicate used to represent the total amount of some instance of #$ExistingStuffType that plays a given #$Role in an event.  (#$amountOfStuffInRole EVENT STUFF AMOUNT ROLE) says that the amount of STUFF such that (ROLE EVENT STUFF) is AMOUNT.  For example, (#$amountOfStuffInRole BobTouchesPeanutButter001 #$PeanutButter (#$Gram 5) #$objectActedOn) says that in the event where Bob touched peanut butter, the total amount of peanut butter touched by Bob is 5 grams.")
(comment Table-PCW "The collection of abstract works whose propositional content is expressed in the form of a table.")
(comment previousIteratedCyclicInterval "(#$previousIteratedCyclicInterval TIME-INTERVAL-TYPE TIME-INTERVAL) means that TIME-INTERVAL is the previous instance of TIME-INTERVAL
-TYPE before #$Now.  See #$PreviousIteratedCyclicIntervalFn, #$currentIteratedCyclicInterval, and #$nextIteratedCyclicInterval.")
(comment PreviousIteratedCyclicIntervalFn "(#$PreviousIteratedCyclicIntervalFn TIME-INTERVAL-TYPE) indicates the TIME-INTERVAL that is the previous instance of TIME-INTERVAL-TYP
E before #$Now.  See #$previousIteratedCyclicInterval.")
(comment nextIteratedCyclicInterval "(#$nextIteratedCyclicInterval TIME-INTERVAL-TYPE TIME-INTERVAL) means that TIME-INTERVAL is the next instance of TIME-INTERVAL-TYPE after #$Now.  See #$NextIteratedCyclicIntervalFn, #$currentIteratedCyclicInterval, and #$previousIteratedCyclicInterval.")
(comment NextIteratedCyclicIntervalFn "(#$NextIteratedCyclicIntervalFn TIME-INTERVAL-TYPE) indicates the TIME-INTERVAL that is the next instance of TIME-INTERVAL-TYPE after #$Now.  See #$nextIteratedCyclicInterval.")
(comment currentIteratedCyclicInterval "(#$currentIteratedCyclicInterval TIME-INTERVAL-TYPE TIME-INTERVAL) means that TIME-INTERVAL is the instance of TIME-INTERVAL-TYPE that includes #$Now.  If #$Now is not included in an interval of that type, there is no arg2 for which this predicate holds.  See #$CurrentIteratedCyclicIntervalFn, #$nextIteratedCyclicInterval, and #$previousIteratedCyclicInterval.")
(comment CurrentIteratedCyclicIntervalFn "(#$CurrentIteratedCyclicIntervalFn TIME-INTERVAL-TYPE) indicates the TIME-INTERVAL that is the current instance of TIME-INTERVAL-TYPE, i.e. it includes #$Now. If there is no instance of TIME-INTERVAL-TYPE that includes #$Now, the function is undefined.  See #$currentIteratedCyclicInterval.")
(comment vaporPressureOfTypeAtTemperature "An instance of #$TernaryPredicate used to represent a dispositional property of substance-types. (#$vaporPressureOfTypeAtTemperature STUFF PRESSURE TEMPERATURE) says that at the #$Temperature TEMPERATURE,the pressure of a sample of (#$GaseousFn STUFF) that is in equilibrium with a liquid or solid sample of STUFF will be PRESSURE. (To represent the actual pressure of a particular sample of gas, see #$barometricPressure).")
(comment MakeFormulaFn "#$MakeFormulaFn is a #$BinaryFunction that combines its arguments to make a #$CycLFormula.  (#$MakeFormulaFn OPERATOR (#$TheList . ARGS)) yields the formula (OPERATOR . ARGS)).  For example, (#$MakeFormulaFn #$JuvenileFn (#$TheList #$Dog)) yields (#$JuvenileFn #$Dog).  #$MakeFormulaFn can be thought of as a CycL analog of the common lisp function 'APPLY'.  It's useful when OPERATOR and (#$TheList . ARGS) are constructed independently.")
(disjointWith NumericInterval ScalarQuantity)
(comment DramaticMovieShowings "The collection of instances of #$MovieShowingAtATheater that are showings of films of the drama genre.")
(comment HorrorMovieShowings "The collection of instances of #$MovieShowingAtATheater that are showings of films of the horror genre.")
(comment SituationalComedyShowing "The collection of instances of #$MediaTransmitting that are showings of 
situational comedies.")
(comment ComedyMovieShowing "the collection of instances of #$MovieShowingAtATheater that are showings of films
in the comedy genre.")
(comment TVLoveStoryShowing "The collection of instances of #$MediaTransmitting that are showings of 
TV love stories.")
(comment CarbamateCompoundType "A kind of #$AnticholinesteraseCompoundType, instances of which are commonly marketed as types of pesticides.")
(comment AnticholinesteraseCompoundType "The collection of all instances of #$ChemicalSubstanceType that can be used to disable #$Acetylcholinesterase in animals.  Such compounds are frequently used as #$Pesticides, but some are also #$NerveAgentTypes.")
(comment AChEInactivation-Reversible "A specialization of #$AChEInactivation.  Instances are #$ChemicalReactions between some chemical and  #$Acetylcholinesterase, in which a binding forms that can be undone.")
(comment Propoxur "A kind of #$Pesticide.")
(comment precursors-Chemical "<code>(#$precursors-Chemical SUBSTANCE PRECURSOR)</code> means that <code>PRECURSOR</code> is a precursor for <code>SUBSTANCE</code>. This means that <code>PRECURSOR</code> is a reactant in some reaction-type that either directly yields <code>SUBSTANCE</code>, or yields another precursor for <code>SUBSTANCE</code>.")
(comment immediatePrecursors-Chemical "(#$immediatePrecursors-Chemical SUBSTANCE PRECURSOR) means that PRECURSOR is an immediate precursor for SUBSTANCE. An immediate precursor typically requires only one chemical reaction to create substance.")
(comment nonImmediatePrecursors-Chemical "(#$nonImmediatePrecursors-Chemical SUBSTANCE PRECURSOR) means that PRECURSOR is a precursor for SUBSTANCE, by virtue of being a precursor to some other substance that is a precursor for SUBSTANCE. This means that PRECUSOR is a reactant in a chemical reaction-type for which this  other substance is an output.  This other substance is either an immediate precursor to SUBSTANCE or a precursor to yet another precursor to SUBSTANCE.")
(comment MethylphosphonicDifluoride "An instance of #$ChemicalCompoundTypeByChemicalSpecies.  Methylphosphonic Difluoride is notable for being a precursor for many #$NerveAgentTypes.")
(comment NitroMethane "A #$NitroparaffinCompoundType.")
(comment Dye "The collection of all dye stuff that is used to color materials during a #$Dyeing event.")
(comment nearestProperSubSituationTypes "(#$nearestProperSubSituationTypes SIT-TYPE SUB-SIT-TYPE) means that SIT-TYPE is a subsituation type SUB-SIT-TYPE, and there is no more specific subsituation type SIT-TYPE.")
(comment PastUSPresident-WhitehouseWP "A webpage with a short biography on U.S. Presidents
maintained by the Whitehouse.")
(comment rateOfActionForChemicalType "(#$rateOfActionForChemicalType CHEMICAL-TYPE ORG-TYPE TIME-QUANTITY) means that the rate of action for CHEMICAL-TYPE in the body of ORG-TYPE is TIME-QUANTITY. The rate of action for a chemical substance is the time it takes to affect an organism.")
(comment Polytetrafluoroethylene "The chemical with formula (C2F4)n. It is a polymer of #$Tetrafluoroethylene.")
(comment Tetrafluoroethylene "#$Tetrafluoroethylene, also known as TFE or perfluoroethylene, is a flammable chemical that is the monomer for #$Polytetrafluoroethylene.")
(comment Perfluoropropylene "#$Perfluoropropylene, also known as hexafluoroproylene, is a nonflammable gas with formula C3F6.")
(comment DiisopropylMethylphosphonate "The chemical with formula C7H17O3P. It can be used as a chemical simulant for the chemical agent #$Sarin.")
(comment Perfluoroisobutylene "#$Perfluoroisobutylene (PFIB) is a highly toxic choking agent.")
(comment chemicalSimulantTypes "(#$chemicalSimulantTypes STUFF-TYPE SIMULANT-TYPE) means that instances of SIMULANT-TYPE are potential chemical simulants for instances of STUFF-TYPE.  A chemical simulant is a chemical with sufficiently similar properties to another chemical that it can be used in tests and experiments designed to draw conclusions about that chemical.  Chemical simulants are often used in chemical warfare training exercises.")
(comment PolyethyleneGlycol-200 "#$PolyethyleneGlycol-200, or PEG200, is one of many condensation polymers of ethylene glycol with a range of average molecular weights from 200 to 6000. This particular polymer has a molecular weight of 200, and can be used as a chemical simulant for many chemical agents. (See #$chemicalSimulantTypes and #$ChemicalAgentType.)")
(comment Methyldichloroarsine "#$Methyldichloroarsine, also known as MD, is a #$BlisterAgentType containing #$Arsenic.")
(comment Diphenylchloroarsine "The chemical (C6H5)2AsCl, often used as a vomiting agent.")
(comment Diphenylcyanoarsine "#$Diphenylcyanoarsine, also known as DC, is a solid #$EmeticAgentType.")
(comment reportsTo "(reportsTo AGT1 AGT2) means that AGT2 is either directly or indirectly a directingAgent in any work-related action in which AGT1 is a deliberateParticipant. One common override for this default relationship is when the action is a project or subevent of a project. In that case the projectLeader will be the directing agent in the event.")
(comment MethylphosphonicDichloride "The chemical with formula CH3Cl2OP. It is a precursor to chemical agents #$Sarin, #$Soman, and #$Cyclosarin.")
(comment MethylphosphonicAcid "The chemical with formula CH5O3P. It is a precursor for the chemical agent #$Sarin.")
(comment DimethylMethylphosphonate "The chemical with formula C3H9O3P. It is a precursor for chemical agents #$Sarin, #$Soman, and #$Cyclosarin.")
(comment PhosphorusTrichloride "The chemical with formula Cl3P. It is a precursor to many nerve agents, such as #$Sarin and #$VX-NerveAgent.")
(comment MethylSalicylate "The chemical with formula C8H803. It can be used as a simulant for #$Soman, #$Tabun, and emetic agents.")
(comment Ethyldiethanolamine "The chemical with formula C6H15NO2. It is a precursor for one type of #$NitrogenMustard, namely #$NitrogenMustard-1.")
(comment ThionylChloride "The chemical with formula Cl2OS. It is a precursor for #$NitrogenMustard-1, #$NitrogenMustard-2 and #$NitrogenMustard-3.")
(comment SulfurDichloride "The chemical with formula Cl2S. It is a precursor for #$SulfurMustard.")
(comment CalciumFluoride "The chemical with formula CaF2, which is a precursor to #$HydrogenFluoride.")
(comment TrimethylPhosphite "The chemical with formula C3H9O3P. It is a precursor for #$Soman and #$Cyclosarin.")
(comment ArsenicTrichloride "The chemical with formula AsCl3. It is a precursor for #$Lewisite and #$Adamsite.")
(comment Chlorobenzene "A slightly soluble chemical with formula C6H5Cl.")
(comment Triphenylarsine "The chemical with formula C18H15As.")
(comment PotassiumSulfide "The chemical with formula K2S. It is a precursor for #$SulfurMustard.")
(comment Triethanolamine "The chemical with formula C6H15NO3")
(comment QL-Chemical "#$QL-Chemical, or O-(2-diisopropylaminoethyl) O'-ethyl methylphosphonite, is an immediate precursor to #$VX-NerveAgent.")
(comment KB-Chemical "#$KB-Chemical, or 2-(diisopropylamino)ethanol, is a precursor to #$VX-NerveAgent.")
(comment Methyldichlorophosphine "The chemical with formula CH3Cl2P. Also known as SW, #$Methyldichlorophosphine is a precursor to #$VX-NerveAgent.")
(comment SodiumSulfide "The chemical with formula Na2S. #$SodiumSulfide is a precursor for #$SulfurMustard.")
(comment Methyldiethanolamine "A very soluble chemical with formula C5H13NO2.")
(comment EthylChlorohydrin "The chemical with formula C2H5ClO. It is a precursor for #$SulfurMustard, and is also known as Ethylenechlorohydrin or Chloroethanol.")
(comment SulfurMonochloride "#$SulfurMonochloride, also known as disulfur dichloride, is the chemical with formula Cl2S2. It is a precursor to the chemical agent #$SulfurMustard.")
(comment CyclohexylAlcohol "The chemical with formula C6H12O. Also known as Cyclohexanol, #$CyclohexylAlcohol is a precursor to chemical agent #$Cyclosarin.")
(comment DimethylSulfate "A soluble chemical with formula C2H6O4S.")
(comment Acetylene "The chemical with formula C2H2. It is a precursor for #$Lewisite.")
(comment SodiumCyanide "The chemical with formula CNNa. It is a precursor to chemical agent #$Tabun.")
(comment Chloroethane "An instance of #$ChemicalCompoundTypeByChemicalSpecies.  Each instance of #$Chloroethane is a sample of the substance C2H5Cl.")
(comment PhosphorusOxychloride "The chemical with formula C13OP. It is a precursor to chemical agent #$Tabun.")
(comment SodiumArsenite "A very soluble chemical with the formula AsNaO2.")
(comment PinacolylAlcohol "The chemical with formula C6H14O. It is a precursor to chemical agent #$Soman.")
(comment Diphenylamine "The chemical with formula C12H11N. It is a precursor for the emetic agent #$Adamsite.")
(comment DiphenylarsineOxide "A chemical precursor for the emetic agent #$Diphenylcyanoarsine.")
(comment hairColor "(#$hairColor ANIMAL BODYPARTTYPE COLOR) means that the hair that 
ANIMAL has on its BODYPARTTYPE has the Color COLOR. For example, (#$hairColor
#$SantaClaus #$Chin #$WhiteColor) holds. ANIMAL is normally a #$Mammal, but certain 
#$Invertebrates also have hair.")
(comment VicePresidentOfOrganization "A collection of people.  An instance of #$VicePresidentOfOrganization is a person who is among the highest leaders of some #$Organization. An organization may have several vice-presidents, in which case such individuals will normally have different responsibilities.")
(comment ChemicalPlant-Facility "A specialization of #$Building, #$Workplace, and #$ModernShelterConstruction.  Each instance of
#$ChemicalPlant-Facility is one or more buildings and grounds in an
area devoted to the manufacture or processing of chemical
substances.  This collection is intended to represent the complex of
buildings comprising the plant, if there is more that one, not the
individual buildings.")
(comment Methyldiethoxyphosphine "#$Methyldiethoxyphosphine, also known as TR, is a highly flammable chemical.")
(comment NoOnsiteManufacturingBusinessType "A specialization of #$OnsiteManufacturingBusinessType.  Each
instance of #$NoOnsiteManufacturingBusinessType is a collection of
#$Businesses that do not manufacture products on-site.")
(comment OnsiteManufacturingBusinessType "A specialization of #$OnsiteManufacturingBusinessType.
Instances of #$OnsiteManufacturingBusinessType are collections of
#$ManufacturingCompany engaging in on-site manufacturing of
products.")
(comment RatioQuantity "A specialization of #$MultiDimensionalQuantity (q.v.).  Each instance of #$RatioQuantity is a quantity that is derivable (via #$QuotientFn) as a ratio of other quantities.  For example, (#$MilesPerHour 65) is a ratio quantity obtainable by dividing (#$Mile 65) by (#$HoursDuration 1); and  (#$PoundsPerSquareInch 50) is equal to
<p>
<pre>
  (#$QuotientFn
    (#$Pound-UnitOfForce 50)
    (#$SquaredFn (#$Inch 1))) .
</pre>
<p>
Ratio quantities are used for measuring a difference or change in one quantity against a (usually incremental) difference or change in another quantity.  When the later quantity is a #$Time-Quantity (as in the first example above), the ratio quantity is an instance of the specialization #$Rate.
<p>
See also #$PerFn.")
(comment conditionalMeaningSentenceOfSchema "This predicate is used to state sksi 'conditional meaning
sentences', i.e. meaning sentences which include an additional query
(either a boolean check or with unbound variables) that is asked to
check the applicability of a meaning sentence, or to limit its scope.
(#$conditionalMeaningSentenceOfSchema LS1 SENTENCE1 LS2 SENTENCE2)
means that SENTENCE2 is a meaning sentence for LS2 only if SENTENCE1
is true in the context of LS1. For example, if we have asserted
(#$conditionalMeaningSentenceOfSchema #$OFAC-main-LS (#$isa (#$TheFn
#$PartiallyTangible) #$Watercraft) #$OFAC-main-LS (#$massOfObject
(#$TheFn #$PartiallyTangible) (#$TheFn #$Mass))) in the (#$MappingMtFn
#$OFAC-KS), then any query in (#$ContentMtFn #$OFAC-main-KS) that
includes a #$massOfObject clause will result in bindings from the
database that also satisfy the condition (#$isa ?FOO #$Watercraft).
However note that this additional restriction only applies to the database
query. It does not affect the answers which may return from other tactics.")
(comment NitrogenMustard-1 "#$NitrogenMustard-1 is the first kind of #$NitrogenMustard, with chemical name bis(2-chloroethyl)ethylamine.")
(comment Phenyldichloroarsine "#$Phenyldichloroarsine, also known as PD, is a #$BlisterAgentType that can cause vomiting in small doses.")
(comment NitrogenMustard-3 "#$NitrogenMustard-3 is the third kind of #$NitrogenMustard, with chemical name tris(2-chloroethyl)amine. Of the three kinds of #$NitrogenMustard, #$NitrogenMustard-3 poses the most serious threat as a chemical weapon. It is also the most stable in storage.")
(comment NitrogenMustard-2 "#$NitrogenMustard-2 is the second kind of #$NitrogenMustard, with chemical name bis(2-chloroethyl)methylamine.")
(comment Thiodiglycol "The chemical with formula C4H10O2S. #$Thiodiglycol is a precursor to the chemical agent #$SulfurMustard.")
(comment Detonation "A specialization of #$Explosion, #$CombustionReaction, and #$WavePropagation.  Each instance of #$Detonation is  fast high-pressure combustion reaction. A detonation event is a reaction which happens so quickly that the reaction speed exceeds the speed of sound in the reacting material.  A detonation reaction is propagated by a supersonic shock wave travelling through the reacting medium.  After initiation, the shock wave accelerates quickly until it reaches a maximum speed -- the \"detonation velocity\" (see #$explosiveVelocityOfType) of the explosive.  Cf. #$Deflagration.")
(disjointWith Detonation Deflagration)
(comment Deflagration "A specialization of #$Explosion and #$CombustionReaction.  Each instance of #$Deflagration is a slow low-pressure combustion reaction.  The reaction speed for an instance of #$Deflagration is slower than the sound speed in the reacting medium. Cf. #$Detonation.")
(comment ViralBioAgentType "#$ViralBioAgentType is a specialization of #$BiologicalAgentType and #$VirusType. Instances of #$ViralBioAgentType are types of viruses that could potentially be used as biological agents in biological warfare.")
(comment BacterialBioAgentType "#$BacterialBioAgentType is a specialization of #$BiologicalAgentType. Instances of #$BacterialBioAgentType are types of bacterium that could potentially be used as biological agents in biological warfare.")
(comment FungalBioAgentType "#$FungalBioAgentType is a specialization of #$BiologicalAgentType. Instances of #$FungalBioAgentType are types of funguses that could potentially be used as biological agents in biological warfare.")
(comment ToxinBioAgentType "#$ToxinBioAgentType is a specialization of #$BiologicalAgentType. Instances of #$ToxinBioAgentType are types of biological toxins that could potentially be used as biological agents in biological warfare.")
(comment ChemicalAgentType "A collection of collections. Each instance is a collection of #$HarmfulChemicalSubstance instances of a common type. (e.g. #$Sarin or #$Lewisite)")
(comment IncapacitatingAgentType "A specialization of #$ChemicalAgentType. Instances of #$IncapacitatingAgentType are types of chemical agents that are designed to cause temporary disability in the target. (e.g. #$TearGas).")
(comment BlisterAgentType "A specialization of #$ChemicalAgentType. Instances of #$BlisterAgentType are types of chemical agents that are designed to destroy skin and other tissue in the target.")
(comment ChokingAgentType "A specialization of #$ChemicalAgentType. Instances of #$ChokingAgentType are types of chemical agents that are designed to cause hemorrhaging of blood vessels in the lungs.")
(comment BloodAgentType "A specialization of #$ChemicalAgentType. Instances of #$BloodAgentType are types of chemical agents that are designed to interfere with oxygen use at the cellular level.")
(comment PicricAcid "A chemical that is very reactive with metals. Instances are toxic when absorbed through the skin, pose a threat of explosion when heated, and can be used with #$CalciumHypochlorite to create #$Chloropicrin. Picric acid is both a useful explosive compound and a precursor to other explosives.")
(comment attendanceStatus "#$attendanceStatus relates a person to an instance of #$PersonTypeByAttendanceStatus. For example (#$attendanceStatus WORKER TIME-INTERVAL #$OutOfOffice-AttendanceStatus) means that WORKER is out of the office during all of TIME-INTERVAL.")
(disjointWith RoadVehicleType PersonTypeByAttendanceStatus)
(disjointWith GeopoliticalEntityTypeByBasicCategory PersonTypeByAttendanceStatus)
(disjointWith FamilyTypeByIncome PersonTypeByAttendanceStatus)
(disjointWith OrganismPartType PersonTypeByAttendanceStatus)
(disjointWith BeliefSystemType PersonTypeByAttendanceStatus)
(disjointWith MicrotheoryType PersonTypeByAttendanceStatus)
(disjointWith ContactLocationType PersonTypeByAttendanceStatus)
(disjointWith LanguageGroupingType PersonTypeByAttendanceStatus)
(disjointWith MolecularComponentType PersonTypeByAttendanceStatus)
(disjointWith MoleculeTypeByChemicalCompoundType PersonTypeByAttendanceStatus)
(disjointWith RegionType PersonTypeByAttendanceStatus)
(disjointWith PharmacyProductType PersonTypeByAttendanceStatus)
(comment OutOfOffice-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and specialization of #$Person. Each instance of #$OutOfOffice-AttendanceStatus is a person who is not currently present at their normal place of work.")
(comment AtLunch-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and specialization of #$Person. Each instance of #$AtLunch-AttendanceStatus is a person who is currently at lunch.")
(comment OutAllDay-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and specialization of #$Person. Each instance of #$OutAllDay-AttendanceStatus is a person who will not be at the office at all during the current day.")
(comment OutRestOfDay-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and specialization of #$Person. Each instance of #$OutRestOfDay-AttendanceStatus is person who was at work, but they left and will not be returning on that same day.")
(comment OutSick-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and a specialization of #$Person. Each instance of #$OutSick-AttendanceStatus is a person who is sick and is not (at a time specified via some temporal qualification) present at their normal place of work.")
(comment OutSickAllDay-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and specialization of #$Person. Each instance of #$OutSickAllDay-AttendanceStatus is person who is sick and will not be at work at all on the date specified via some temporal qualification.")
(comment OutSickRestOfDay-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and specialization of #$Person. Each instance of #$OutSickRestOfDay-AttendanceStatus is person who was at work but went home sick and will not be back on that day.")
(comment OutWithCustomer-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and specialization of #$Person. Each instance of #$OutWithCustomer-AttendanceStatus is a person who is not (at some specified time) present at their normal place of work but who doing company work that involves interacting in person with a client of their employer.")
(comment OnVacation-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and specialization of #$Person. Each instance of #$OnVacation-AttendanceStatus is a person who is currently using scheduled vacation time and is not at work.")
(comment In-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and specialization of #$Person. Each instance of #$In-AttendanceStatus is a person who is currently present at their normal place of work. The person is not, however, necessarily available for new work interactions. For example, they might be in a meeting or they might have asked not to be disturbed.")
(comment InMeeting-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and specialization of #$Person. Each instance of #$InMeeting-AttendanceStatus is a person who is currently attending a work-related meeting.")
(comment InButUnavailable-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and specialization of #$Person. Each instance of #$InButUnavailable-AttendanceStatus is a person who is not currently available for new work interactions for any of a number of reasons, including being in a meeting, being on the phone, or working on something from which they do not wish to be disturbed.")
(comment DoNotDisturb-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and specialization of #$Person. Each instance of #$DoNotDisturb-AttendanceStatus is a person who is (at some specified time) working but reporting himself as being unavailable for new work interactions, presumably because he is working on something from which he does not want to be interrupted. Reporting oneself in a 'do not disturb' status is not a guarantee against being interrupted.")
(comment EmeticAgentType "A specialization of #$ChemicalAgentType. Instances of #$EmeticAgentType are types of chemical agents that are designed to induce vomiting.")
(comment chemicalCASRegistry "(#$chemicalCASRegistry CHEMICAL CAS) means that CAS is the unique Chemical Abstract Services (CAS) Registry number for CHEMICAL. For example, the CAS Registry number for #$Sarin is 107-44-8.")
(comment interArgResultIsaReln "A quintary #$MetaRelation predicate for stating that a certain kind of complex, partly #$isa based relationship holds between a given argument to a given function and the corresponding value that is returned. (#$interArgResultIsaReln FUNC N RELATION RELATION-NAT-TERM-ARG RELATION-COLLECTION-ARG) means that, if there is a sentence asserted in the KB relating NAT-TERM and COLLECTION via RELATION and NAT-TERM is the RELATION-NAT-TERM-ARGth argument in the sentence and COLLECTION is the RELATION-COLLECTION-ARGth argument, then when NAT-TERM appears as the Nth argument to FUNC, then (regardless of what the other arguments to FUNC might be) the value (if any) of that function for those arguments is an instance of COLLECTION.  That is: if (RELATION ... NAT_TERM ... COLLECTION ...) or (RELATION ... COLLECTION ... NAT_TERM  ...) is an asserted sentence, and (FUNC ARG(1) ... ARG(N-1) NAT_TERM ...) = VALUE, then VALUE is an instance of COLLECTION. Obviously, COLLECTION must be a collection; so RELATION's RELATION-COLLECTION-ARGth argument-place is likely to be isa constrained (see #$argIsa) to #$Collection or some specialization thereof.")
(comment interArgResultGenlReln "A quintary #$MetaRelation predicate for stating that a certain  kind of complex, partly #$genls based relationship holds between a given  argument to a given function and the corresponding value that is returned.  (#$interArgResultGenlReln FUNC N RELATION RELATION-NAT-TERM-ARG RELATION-COLLECTION-ARG) means that, if there is a sentence asserted in the KB relating NAT-TERM and COLLECTION via RELATION and NAT-TERM is the RELATION-NAT-TERM-ARGth argument in the sentence and COLLECTION is the RELATION-COLLECTION-ARGth argument, then when NAT-TERM appears as the Nth argument to FUNC, then (regardless of what the other arguments to FUNC might be) the value (if any) of that function for those arguments is a subcollection of COLLECTION. That is: if (RELATION ... NAT_TERM ... COLLECTION ...) or  (RELATION ... COLLECTION ... NAT_TERM  ...) is an asserted sentence, and (FUNC ARG(1) ... ARG(N-1) NAT_TERM ...) = VALUE, then VALUE is a subcollection of COLLECTION. Obviously, COLLECTION must be a collection; so RELATION's RELATION-COLLECTION-ARGth argument-place is likely to be isa  constrained (see #$argIsa) to #$Collection or some specialization thereof.")
(comment followingValueOnScale "A specialization of #$followingOrEqualValueOnScale (q.v.) that is used to compare the positions or \"ranks\" of two quantities/attributes/properties that are on the same scale.  More precisely, <code>(#$followingValueOnScale VALUE1 VALUE2 SCALE)</code> means that <code>VALUE1</code> and <code>VALUE2</code> are both instances of the #$CollectionWithAnEventLikeOrder <code>SCALE</code>, and that <code>VALUE2</code> is \"greater than\" (i.e. comes later than) <code>VALUE1</code> in the ordering scheme conventionally associated with <code>SCALE</code>.
<p>
Typically, <code>VALUE1</code> and <code>VALUE2</code> will either (i) both be instances of #$Quantity (q.v.) or (ii) both be instances of #$FirstOrderCollection (q.v.) such that they correspond to properties of individuals.  In case (i), <code>SCALE</code> will be a #$TotallyOrderedQuantityType, and <code>(#$followingValue VALUE1 VALUE2)</code> will hold.
<p>
For example, both of these hold:
<p>
<pre>
  (#$followingValueOnScale #$MildlyToxic #$Toxic #$Toxicity)
</pre>
<p>
<pre>
  (#$followingValueOnScale #$Corporal-Rank #$Sergeant-Rank #$USArmyRank) .
</pre>
<p>
See also the specialization of #$followingValueOnScale, #$succeedingValueOnScale.")
(comment EventLikeOrdering "The collection of instances of #$PartialOrdering-Strict whose ordering relations order their base sets in the manner in which events are ordered in linear time.  A #$PartialOrdering-Strict <code>ORDER</code>, with #$orderingRelation <code>R</code>, is an instance of #$EventLikeOrdering just in case for any <code>W</code>, <code>X</code>, <code>Y</code>, and <code>Z</code> in the #$baseSet <code>S</code> of <code>ORDER</code>, <code>(R(W X) & R(Y Z))</code> implies <code>(R(W Z) v R(Y X))</code>.
<p>
For example, consider the set of time intervals and the relation \"entirely later than\".  For any two pairs of times in which one time is entirely later than the other, the later of one of the pairs is entirely later than the earlier of the other pair.  So the order whose #$baseSet is the set of all #$TimeIntervals, and whose ordering relation is #$startsAfterEndingOf, is an #$EventLikeOrdering.
<p>
See also #$CollectionWithAnEventLikeOrder.")
(comment subQueries "A transitive, irreflexive predicate.  (#$subQueries LARGER-QUERY SUB-QUERY) says that
SUB-QUERY is a query that can or should be run to get a result useful in answering LARGER-QUERY.")
(comment SodiumPicrate "2,4,6-Trinitrophenol, sodium salt.")
(comment ReleaseOfBiochemicallyHarmfulSubstance "The subcollection of #$EmittingAnObjects in which a #$BiochemicallyHarmfulSubstance is released.")
(comment partsPartitionedByTypeAndVolume "(#$partsPartitionedByTypeAndVolume ?WHOLE ?PARTS ?TYPE ?PCT holds iff ?PARTS is the (possibly singleton) #$Group of #$parts of ?WHOLE that #$isa ?TYPE, and said group comprises ?PCT of ?WHOLE (expressed as a #$Real0-1) _by #$volumeOfObject_.")
(comment Slurry "A subcollection of #$Mixture in which the #$mainConstituent is (#$LiquidFn #$Water).")
(comment instrument-UsedAsWeapon "(#$instrument-UsedAsWeapon ATTACK THING) holds if the #$PartiallyTangible THING was the #$instrument-Generic used during an #$AttackOnTangible. This is not a specialization of #$deviceUsed since #$Weapons such as #$TreeBranches aren't #$PhysicalDevices.")
(comment WeaponsGradeSprayer "The collection of #$SprayingDevices intended for the #$Spraying of #$Weapon grade #$FluidTangibleThings, such as #$BiologicalWeapons. Examples range from cans of mace to military-grade sprayers mounted in #$TransportationDevice-Vehicles.")
(comment containerPayload-Max "(#$containerPayload-Max ?CONTAINER ?MASS) means that the #$Container can only hold #$Mass amount of stuff before being at risk of breaking down.")
(comment performsActsOfType "(#$performsActsOfType AGENT ACTION-TYPE) holds just in case AGENT tends to
perform acts of ACTION-TYPE.  Performing only one action of ACTION-TYPE is probably 
not sufficient for this relation to hold of AGENT and the ACTION-TYPE.  Requiring that the
agent perform the acts on a regular basis is probably too strong a requirement.  The happy 
middle most likely depends on the context and the ACTION-TYPE.  A positive example 
would be (#$performsActsOfType FredFlintstone BowlingActivity).")
(comment PromotionOfActionTypeFn "A unary function that takes a collection of actions and returns the subcollection
of #$AdvocatingACause whose instances are acts of advocation of the acts in arg1.  
For example, '(#$PromotionOfActionTypeFn #$TerroristAct)' denotes the collection of acts 
that promote terrorism.  Note that the collection so denoted is most often not a direct 
specialization of the collection in arg1.")
(comment promotionOfActionTypeType "A binary predicate that relates A type of action to the subcollection of 
#$AdvocatingACause that consists of those acts which advocate acts that are instances of 
arg1.  For example, (#$promotionOfActionTypeType #$TerroristAct ADVOCACY) holds just in case 
ADVOCACY is the collection of instances of #$AdvocatingACause that are acts of advocating 
some terrorist act or other.")
(comment isCommittedTo "(#$isCommittedTo AGENT SIT) holds just in case AGENT is committed to SIT.  See the
comment on #$Commitment for an explanation of commitments.")
(comment agentHasCommitment "(#$agentHasCommitment AGENT COMMITMENT) holds just in case COMMITMENT is an
instance of #$Commitment and there exists some SIT such that 
(#$objectOfMentalSituation COMMITMENT SIT) and (#$isCommittedTo AGENT SIT).")
(comment Commitment "The collection of commitments.  Each instance of this collection is an agent's commitment to some instance of #$Situation.  For example, if I am commited to \"world peace\" then I am in a particular mental state -- a state that, in some sense, guides my future actions.  If so committed, then I will try to avoid actions that are inconsistent with there being world peace.  It is likely, as well, that I will attempt to perform some  actions which are directed at helping to bring about that state of affairs.  There is,  perhaps, a fine line between genuine commitments and mere \"lip service\" and in some cases, the agent may not even be able to tell whether their commitment is genuine.  Where we draw the line likely depends on the type of commitment it is.  A minimal commitment to world peace presumably requires less (that is, your having the commitment has less of an effect on your day to day behavior) than a minimal commitment towards a marriage.")
(comment desirabilityOfTargetForTerroristAttack "(#$desirabilityOfTargetForTerroristAttack OBJ QUANT) relates an object OBJ to the degree QUANT to which it is a desirable target for a terrorist attack.")
(comment ContaminatingFoodOrDrink "The collection of contamintation events where #$FoodOrDrink becomes contaminated.")
(comment Campylobacter "Campylobacter is a bacteria that is often found in the intestinal tracts of animals. It is responsible for diarrheal disease and is a leading cause of bacterial gastroenteritus.")
(comment zoonoticHostTypeForAgentType "(#$zoonoticHostTypeForAgentType AGENT HOST) means that instances of HOST are potential #$NonPersonAnimal hosts for #$ZoonoticAgentType AGENT.")
(comment Tetanus-Bacterium "#$Tetanus-Bacterium is a bacteria that causes #$Tetanus.")
(comment ZoonoticAgentType "Each instance of #$ZoonoticAgentType is a type of microorganism that is likely to cause a #$Zoonosis-DiseaseType, or a disease that affects humans that is transmitted through contact with non-person animals. For example, #$Anthrax-Bacterium is an instance of #$ZoonoticAgentType since it can be transmitted from sheep and cattle to people, causing #$InhalationalAnthrax-Natural.")
(comment DeployingABioAgentByInfectingAZoonoticHost "A specialization of #$DeployingABiologicalAgent. Instances are such that the #$agentDeployed-BCW is an instance of some #$ZoonoticAgentType that is deployed by infecting and releasing a #$zoonoticHostTypeForAgentType for that type of agent.")
(comment PotentialFoodOrWaterContaminantType "A collection of collections. Instances could potentially contaminate food or water.")
(comment CyberTerrorism "A specialization of #$AttackByComputerOperation and #$TerroristAttackOnObject (qq.v.).  Each instance of #$CyberTerrorism is an event in which a terrorist perpetrates a cyber attack in order to achieve a political objective.  Using a computer network to take down a power grid or gain control of a dam are exemplars. Cf. #$CyberTerrorist.")
(comment TerroristAttackOnObject "A specialization of #$TerroristAct and #$AttackOnObject (qq.v.).  Each instance of #$TerroristAttack is an act perpetrated by a terrorist with the intent of destroying or damaging a person or object in order to further a political objective.  Important specializations are #$TerroristAttack and #$CyberTerrorism.")
(comment fatalityRateAtLocation "A specialization of #$casualtyRateAtLocation. (#$fatalityRateAtLocation EVENT WHERE PCT) holds if PCT% of the #$Persons at WHERE are killed as a result of the #$Event EVENT.")
(comment casualtyRateAtLocation "(#$casualtyRateAtLocation EVENT WHERE PCT) holds if PCT% of the #$Persons at WHERE are killed, injured, or lost as a result of the #$Event EVENT.")
(comment todo "A #$DocumentationPredicate (q.v.) that is used to relate a #$CycLIndexedTerm to a #$SubLString containing information regarding work that is to be done on the term in the near future. These notes should be of a more transient nature than #$cyclistNotes in general; often they amount to noting that the term is a hack, and ought to be cleaned up sooner rather than later.  This is also slightly different than #$futureAssertions, which is appropriate more for cases where an intended term or rule can't be handled at all, even badly.")
(comment TaskSchedulerPatternPropertyIntervalFn "This function is used in #$TaskSchedulerTimePatternExpressions and #$TaskSchedulerDatePatternExpressions
in order to specify interval values for certain properties (e.g., :HOUR, :MONTH).")
(comment GoingSomewhereByMeansOfFn "'(#$GoingSomewhereByMeansOfFn VEHICLE-TYPE)' refers to the #$ScriptedEventType spec-script of #$GoingSomewhereByTransportationDevice in which a vehicle of type VEHICLE-TYPE is used as the #$transporter.")
(comment DisembarkingFromATransportationDevice "This is the collection of actions in which an #$Animal -- usually a #$Person -- disembarks from a #$TransportationDevice.  'Disembarking' covers a wide range of actions, including dismounting from a bicycle, exiting an automobile, climbing off a boat, and walking out of an elevator.")
(comment aboardTransporter "(#$aboardTransporter THING TRANSPORT) says that the #$PartiallyTangible object THING is aboard the #$TransportationDevice TRANSPORT, which means that THING will move wherever TRANSPORT moves.  This predicate covers a wide range of physical relations to transporters, such as a pilot in an airplane, a dog in the bed of a pickup truck, and a torpedo in a submarine.")
(comment BoardingATransportationDevice "This is the collection of actions in which an #$Animal -- usually a #$Person -- boards a #$TransportationDevice.  'Boarding' covers a wide range of actions, including mounting a bicycle, entering an automobile, climbing aboard a boat, and walking into an elevator.")
(comment minimumDurationForSubSituationType "<code>(#$minimumDurationForSubSituationType SIT-TYPE SUB-SIT-TYPE MIN)</code> means that if a situation <code>SUB-SIT</code> is an instance of <code>SUB-SIT-TYPE</code> and is a proper subsituation of <code>SIT</code>, an instance of <code>SIT-TYPE</code>, then <code>SUB-SIT</code> will not last less than <code>MIN</code>.")
(comment maximumDurationForSubSituationType "<code>(#$maximumDurationForSubSituationType SIT-TYPE SUB-SIT-TYPE MAX)</code> means that if a situation <code>SUB-SIT</code> is an instance of <code>SUB-SIT-TYPE</code> and is a proper subsituation of <code>SIT</code>, an instance of <code>SIT-TYPE</code>, then <code>SUB-SIT</code> will not last longer than <code>MAX</code>.")
(comment durationForSubSituationType "(#$durationForSubSituationType SIT-TYPE SUB-SIT-TYPE DURATION) means that SUB-SIT-TYPE is a sub-situation type of SIT-TYPE, and that the duration of sub-situations of an instance of  SIT-TYPE which are instances of SUB-SIT-TYPE is DURATION.")
(comment durationRangeForSubSituationType "(#$durationRangeForSubSituationType SIT-TYPE SUB-SIT-TYPE MIN-DUR MAX-DUR) means that SUB-SIT-TYPE is a sub-situation type of SIT-TYPE, and that the duration of sub-situations of an instance of  SIT-TYPE which are instances of SUB-SIT-TYPE is between MIN-DUR and MAX-DUR.")
(comment averageDurationForSubSituationType-Mean "'(#$averageDurationForSubSituationType-Mean SIT-TYPE SUB-SIT-TYPE DURATION)' means that SUB-SIT-TYPE is a subsituation type of SIT-TYPE, and that the mean average duration of subsituations of an instance of SIT-TYPE which are instances of SUB-SIT-TYPE is DURATION.")
(comment Heartbeat-Human "This is the collection of single beats of a human heart.")
(comment Heartbeating-Human "This is the collection of processes of a human heart beating.  Instances range from a single heartbeat to all of the beats of a heart's lifespan considered as a single event.")
(comment QuasiQuote "A quotation device for making general statements about CycL expressions.  #$QuasiQuote allows for any free variables occurring inside an expression to which it is applied to \"escape\" (i.e. remain free with respect to) the quotation.  It is thus similar in function to, though less flexible than, the combination of #$Quote and #$EscapeQuote (qq.v.).
<p>
To be more precise: the syncategorematic symbol <code>#$QuasiQuote</code> is a device for allowing genuinely free variables to occur inside quoted expressions, in order that one may meaningfully \"quantify into\" such expressions and thereby <i>generalize</i> over them.  It can thus be instructively compared to the symbol <code>#$Quote</code> (q.v.), which is used to make statements about <i>particular</i> CycL expressions.  Let <code>EXPR</code> be a well-formed CycL expression.  The expression <code>(#$Quote EXPR)</code> -- consisting of the symbols <code>#$Quote</code>, <code>EXPR</code>, and a surrounding pair of parentheses -- is a term that denotes <code>EXPR</code>.  The expression <code>(#$QuasiQuote EXPR)</code> is a term whose meaning is similar to <code>(#$Quote EXPR)</code>, except that any free occurrence of a variable in <code>EXPR</code> remains free with respect to <code>(#$QuasiQuote EXPR)</code> as a whole.  If <code>EXPR</code> contains no free variables, then <code>(#$QuasiQuote EXPR)</code> is a closed term (see #$CycLClosedDenotationalTerm) that denotes <code>EXPR</code>, and is equivalent to <code>(#$Quote EXPR)</code>.  If <code>EXPR</code> contains any free occurrences of variables, then <code>(#$QuasiQuote EXPR)</code> is an open term (see #$CycLOpenDenotationalTerm) in which exactly the same variables occur free; and any closed instantiation of <code>(#$QuasiQuote EXPR)</code> denotes the corresponding instantiation of <code>EXPR</code>.  (A <i>closed instantiation</i> of <code>EXPR</code> is any closed expression that results from replacing each free occurrence of a variable in <code>EXPR</code> with some closed term, and replacing any two occurrences of the same variable by the same closed term.)
<p>
For an example, the variable <code>?X</code> occurs free in the term
<pre>
  (#$QuasiQuote (#$MotherFn ?X)) ;
</pre>
and one instantiation of this is the closed term
<pre>
  (#$QuasiQuote (#$MotherFn #$Plato)) ,
</pre>
which denotes the non-atomic term <code>(#$MotherFn #$Plato)</code>.  And the (implicitly quantified) rule
<pre>
  (#$isa (#$QuasiQuote (#$MotherFn ?X)) #$CycLNonAtomicTerm)
</pre>
means, in effect, that any closed instantiation of the open term <code>(#$MotherFn ?X)</code> -- e.g. <code>(#$MotherFn #$Plato)</code> -- is a non-atomic term of CycL.
<p>
See also #$denotes, #$quotedIsa, #$quotedArgument, #$NoteAboutQuotingInCycL, and #$NoteAboutSyncategorematicSymbols.")
(comment Amatol "A specialization of #$HighExplosive. Each instance of #$Trinitrotoluene is a mechanical mixture of #$AmmoniumNitrate and #$Trinitrotoluene.")
(comment NaturalFiberType "A specialization of #$ExistingStuffType.  Each instance of
#$NaturalFiberType is a collection of #$Fiber produced in nature.
Important instances include #$WoolStuff and #$CottonStuff.")
(comment SemisyntheticFiberType "A specialization of #$ExistingStuffType.  Each instance of
#$SemisyntheticFiberType are inorganic substances produced in fiberous
form, like #$Rayon or #$Glass.")
(comment ManufacturedFiberType "A specialization of #$ExistingStuffType.  Each instance of
#$ManufacturedFiberType is fiber made from synthetic materials.  They
are mainly used in textile fabrics.")
(comment explosivePowerEquivalent "(#$explosivePowerEquivalent DEV DEV-TYPE NUM) means that a single instance of #$ExplosiveDevice DEV has the same explosive force as NUM amount of DEV-TYPE.  This predicate is useful for rating the explosive power of individual #$Bombs, etc., in terms of some common measure, such as pounds of TNT or numbers of #$Bomblet-M77s.  Cf. #$explosivePowerEquivalent-Type.")
(comment tNTEquivalent "(#$tNTEquivalent EXPL-DEV INT) means that #$ExplosiveDevice EXPL-DEV has the same explosive force as the amount of #$Trinitrotoluene (\"TNT\") specified by INT.  For example, (#$tNTEquivalent #$LittleBoy ((#$Kilo #$ShortTon) 20)) means that #$LittleBoy has the explosive equivalent of 20 kilotons of TNT.  Cf. #$tNTEquivalent-Type.")
(comment Out-AfterWorkHours-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and specialization of #$Person. Each instance of #$Out-AfterWorkHours-AttendanceStatus is a person who is gone from the office for the day, having completed their normal working hours.")
(comment Out-BeforeWorkHours-AttendanceStatus "An instance of #$PersonTypeByAttendanceStatus and specialization of #$Person. Each instance of #$Out-BeforeWorkHours-AttendanceStatus is a person who has not yet begun working for the day.")
(comment sourceClaims "This predicate relates a structured knowledge source with a CycL sentence that expresses something the knowledge source claims, in some sense, to be true.  This is distinguished from #$rowInSourceClaims in that the sentence claimed to be true need not express \"one or more of the physical field values which appear in some row of the knowledge source.\"  The CycL sentence could, for example, be (#$greaterThan 2380000 2000000).  In this case, the claim would not be in a row of the knowledge source but rather in how the knowledge source evaluates #$greaterThan.")
(comment AerialBombing "A specialization of #$Bombing.  Each instance of #$AerialBombing is an event in which an airplane drops at least one bomb while in flight.  Typically, each instance of #$AerialBombing is a subevent of an instance of a successful #$BombingMission-Aerial.")
(disjointWith AerialBombing Bombing-RoadVehicleDelivered)
(comment Bombing-RoadVehicleDelivered "A specialization of #$Bombing.  Each instance of #$Bombing-RoadVehicleDelivered is an event in which an instance of  road vehicle (e.g., a car or a truck -- see #$RoadVehicle) is used to deliver a bomb to its intended detonation location.  See #$Bomb-RoadVehicleDelivered.")
(comment SKSIContentTest "Each instance of #$SKSIContentTest is a specification for a CycL query which tests SKSI  inference functionality.")
(comment testCollectionForKnowledgeSource "(#$testCollectionForKnowledgeSource TEST_COLLECTION KNOWLEDGE_SOURCE) means the #$SKSITestType TEST_COLLECTION is a collection of query specifications which are intended to test the inference functionality of the #$StructuredKnowledgeSource KNOWLEDGE_SOURCE.")
(comment typesDifferInValue "(#$typesDifferInValue COLL1 COLL2 COLL-TYPE) holds just in case instances
of COLL1 will differ from instances of COLL2 with respect to COLL-TYPE.  For instance,
(#$typesDifferInValue #$Emerald-Gem #$Ruby-Gem #$Color) holds because instances of
#$Emerald-Gem are a different color than instances of #$Ruby-Gem.  So, if Ruby-1 and Emerald-1
are instances of #$Ruby-Gem and #$Emerald-Gem, respectively, then (#$differentInValue 
Ruby-1 Emerald-1 #$Color) holds.")
(comment typesResembleInValue "This is a type level version of the predicate #$resemblesInValue. (#$typesResembleInValue TYPE1 TYPE2 COLL-TYPE) means that where INST1 and INST2 are any instances drawn, respectively, from TYPE1 and TYPE2, it will be the case that (#$resemblesInValue INST1 INST2 COLL-TYPE).")
(comment resemblesInValue "(#$resemblesInValue THING1 THING2 COLL) means that the two things THING1 and THING2 resemble each other in their values of the collection type COLL. Here 'resembles' means has a \"close\" or similar value in that property -- what this means, and what the standard of closeness or similarity is, depends on the context.  At the very least, THING1 and THING2 will both be instances of some instance of COLL.  If COLL is an instance of #$CollectionWithAnEventLikeOrder, then it is likely the resemblance consists in each being an instance of some instance of COLL and the collections they belong to are \"close\" to each other in the ordering on COLL.  See also #$identicalInValue and #$differentInValue.  For similar predicates that utilize specializations of #$Quantity in the third argument place see #$resemblesInQuantity, #$identicalInQuantity, and #$differentInQuantity.")
(comment identicalInValue "(#$identicalInValue THING1 THING2 TYPE) holds just in case
THING1 and THING2 are the same with respect to some instance of TYPE.  In many cases, this means
that they are both instances of the same instance of TYPE.  For instance, 
(#$identicalInValue RedBall-01  #$JonsEscort #$Color) holds because both RedBall-01 
and #$JonsEscort are instances of #$RedColor which is an instance of #$Color.  In other words, it means RedBall-01 and #$JonsEscort are the same color.  Use this predicate to state that two things share a property but can't specify the exact value they share. 
#$identicalInValue and #$differentInValue cannot both be correctly asserted of 
the same two things. See also #$resemblesInValue.")
(comment differentInValue "(#$differentInValue THING1 THING2 COLL) holds just in case THING1
and THING2 are different with respect to COLL.  For instance, 
(#$differentInValue ARedThing ABlueThing #$Color) holds because ARedThing and
ABlueThing differ with respect to color.  That is, there is no one color that they both can
be said to have.  Statements like these hold, in most cases, 
because there is no instance of COLL such that THING1 and THING2 are both instances
of it, yet they are each an instance of some instance of COLL.  #$identicalInValue
and #$differentInValue cannot both be correctly asserted of the same two things. 
See also #$resemblesInValue.")
(comment differentInRelation "This predicate compares two things in terms of some #$BinaryPredicate that relates them to different instances of a given collection (provided by the argument constraints on the predicate).  (#$differentInRelation THING1 THING2 BIN-PRED) holds just in case there exists REL-1 and REL-2 such that (BIN-PRED THING1 REL-1),(BIN-PRED THING2 REL-2), and REL-1 is different than REL-2.  ")
(comment typesGreaterInValue "(#$typesGreaterInValue COL1 COL2 COLL-TYPE) means that instances of COL1 are instances of instances of COLL-TYPE that are higher in the standard ordering of COLL-TYPE than the instance of COLL-TYPE of which COL2's instances are instances.  In other words, every instance of COL1 is related to a higher value of COLL-TYPE that every instance of COL2.   Example: (#$typesGreaterInValue #$Lawyer #$Janitor #$PersonTypeByEducationLevel) means that the education level of lawyers is greater than that of janitors (default true).")
(comment typesNeedToBeSimilarInScalar "(#$typesNeedToBeSimilarInScalar COL1 COL2 ATTR-TYPE) means that instances of COL1 need the same degree of an instance of ATTR-TYPE as instances of COL2. Typically, assertions using this predicate will be made in a context in which there is a presupposed goal. COL1 needs to have the same degree of ATTR-TYPE as COL2 in order to help achieve some goal or purpose.")
(comment RegionalInstallationOfATF "The collection of all regional installations of the
#$BureauOfAlcoholTobaccoAndFirearms.")
(comment PurposefulAction-ResourceDriven "A specialization of #$PurposefulAction.  Each instance of #$PurposefulAction-ResourceDriven is an event in which an agent gains access to resources and uses control over them purposefully to accomplish a goal. For a slightly more complex sort of event, in instances of which the controlled resources are moved before they are used, see #$PurposefulAction-ResourceDrivenWithTransfer.")
(comment IMDBContentTestSpecification "")
(comment typesHaveRelationInSituationType "(#$typesHaveRelationInSituationType SIT-TYPE TYPE1 TYPE2 BINREL) means that if instances of TYPE1 and TYPE2 play roles in any instance SIT of SIT-TYPE, then it will hold throughout SIT (see #$holdsIn) that the instance of TYPE1 will have the relation BINREL to the instance of TYPE2.")
(comment genlsWRTSubSituations "(#$genlsWRTSubSituations SPEC-TYPE SPEC-SUBTYPE1 GENL-TYPE GENL-SUBTYPE1) means that (#$genls SPEC-TYPE GENL-TYPE), SPEC-SUBTYPE1 is a scene of SPEC-TYPE, GENL-SUBTYPE1 is a scene of GENL-TYPE, and for any other SPEC-SUBTYPE and GENL-SUBTYPE where (#$genlsWRTSubSituations SPEC-TYPE SPEC-SUBTYPE GENL-TYPE GENL-SUBTYPE) holds, the quasi-temporal partial ordering in SPEC-TYPE of SPEC-SUBTYPE1 relative to SPEC-SUBTYPE is the partial ordering in GENL-TYPE of GENL-SUBTYPE1 relative to GENL-SUBTYPE, and the role-player identity constraints across GENL-SUBTYPE and GENL-SUBTYPE1 for GENL-TYPE apply to SPEC-SUBTYPE and SPEC-SUBTYPE for SPEC-TYPE.")
(comment NationalGovernmentalOffice "A specialization of #$JobPosition within a national #$GovernmentalOrganization. These offices are the office a person is appointed, elected, or occupies by other means.")
(comment NationalGovernmentalOfficeType "#$NationalGovernmentalOfficeType is a collection of collections. Each instance is a collection of #$JobPositions in  #$GovernmentalOrganizations, and *not* the people filling those offices. Positive examples include senate offices, presidential offices, and even congressional aides' offices.")
(comment NationalGovernmentalOfficeTypeByBranch "A collection of collections. Each instance is a collection
of #$NationalGovernmentalOffices divided by associated branch. For
example, #$ExecutiveBranchOffice is the collection of all offices in
the #$ExecutiveBranch of a government. This allows for inferences on
the different powers portioned out to the different branches of any
given government not only within that government, but across governments
as well. So, for example, the #$USExecutiveBranch has the power to
make treaties, but the executive branch of another country may
not have this power.")
(comment ExecutiveBranchOffice "The collection of all #$NationalGovernmentalOffices in
#$ExecutiveBranches of #$GovernmentOrganizations. In the both the
#$USExecutiveBranch and #$RussianExecutiveBranch, examples of
instances of this collection would include the presidential office.
Note #$President-HeadOfGovernmentOrHeadOfState would *not* be a spec of
this collection, as it is a spec of #$Person.")
(comment ExecutiveBranchOfficeType "A collection of collections. Each instance is a collection
of #$NationalGovernmentalOffices in the #$ExecutiveBranch of a
government.A positive example would be the collection of Cabinet
offices.")
(comment LegislativeBranchOfficeType "A collection of collections. Each instance of
#$LegislativeBranchOfficeType is a type of
#$NationalGovernmentalOffice in the #$LegislativeBranch in a
government. A positive example of this collection is the collection of
all U.S. Congressional seats.")
(comment LegislativeBranchOffice "The collection of all #$GovernmentOffices in the
#$LegislativeBranch of a government. This collection include
#$USSenateSeat-Federal, as well as the #$JobPositions of congressional
aides.")
(comment JudicalBranch "The collection of all judical branches in
#$GovernmentalOrganizations. Typically, the judical branches of
governments are the interpretors and administrators of the
#$GovernmentCOC.")
(comment JudicalBranchOfficeType "A collection of collections. Each instance of #$JudicalBranchOfficeType is a collection of #$NationalGovernmentalOffices in the #$JudicalBranch of some government. A positive example of this collection includes collections like the Supreme Court offices and the lower courts.")
(comment JudicalBranchOffice "The collection of all #$NationalGovernmentalOffices in the #$JudicalBranch of a government. This collection includes the offices of the Supreme Court, as well as other federal court seats.")
(disjointWith StorageShed MultiLevelBuilding)
(comment MultiLevelBuilding "This is the collection of all #$Buildings which have more than one #$LevelOfAConstruction.")
(disjointWith Shack MultiLevelBuilding)
(comment exceptionalSpecWRTSlot "A predicate used to identify subcollections that are important exception-classes to default truths about a more general collection.  (#$exceptionalSpecWRTSlot SPEC GENL SLOT) says that SPEC is an exception to (#$relationAllInstance SLOT GENL VALUE), whatever the value is of VALUE.  So for example, as a default, we might assert (#$relationAllInstance numberOfInningsPlayed BaseballGame 9).  But we might also wish to assert (#$relationAllInstance numberOfInningsPlayed LittleLeagueBaseballGame 6), where (genls LittleLeagueBaseballGame BaseballGame).  Cyc's behavior will be to use the assertion on LittleLeagueBaseballGame to override the assertion on BaseballGame, treating LittleLeagueBaseballGame as an exception-sub-class of BaseballGame with respect to numberOfInningsPlayed: (#$exceptionalSpecWRTSlot LittleLeagueBaseballGame BaseballGame numberOfInningsPlayed).")
(comment USGovtInstallationTypeByAgency "An instance of #$SecondOrderCollection.  Each instance of
#$USGovtInstallationTypeByAgency is a collection of
#$USFederalGovernmentAgency classified by the federal department or
bureau to which it belongs.")
(comment RegionalInstallationOfDepartmentOfJustice "A specialization of #$USFederalGovernmentAgency.  Each
instance of #$RegionalInstallationOfDepartmentOfJustice is a regional
base from which the #$USDepartmentOfJustice operates in that region.")
(comment RegionalInstallationOfINS "A specialization of #$USFederalGovernmentAgency.  Each
instance of #$RegionalInstallationOfINS is a regional organization
from which the #$USImmigrationAndNaturalizationService operates
locally.")
(comment RegionalInstallationOfFBI "A specialization of #$USFederalGovernmentAgency.  Each
instance of #$RegionalInstallationOfFBI is the regional installation
for the #$FederalBureauOfInvestigation operating at teh local level.")
(comment RegionalInstallationOfBureauOfPrisons "A specialization of #$USFederalGovernmentAgency.  Each
instance of #$RegionalInstallationOfBureauOfPrisons is a regional
installation for the Bureau of Prisons to operate at a local level.")
(comment RegionalInstallationOfUSMarshalsOffice "A specialization of #$USFederalGovernmentAgency.  Each
instance of #$RegionalInstallationOfUSMarshalsOffice is a regional
installation for the local operations of the U.S. Marshals Service.")
(comment RegionalInstallationOfDEA "A specialization of #$USFederalGovernmentAgency.  Each
instance of #$RegionalInstallationOfDEA is a regional installation of
offices for the #$DrugEnforcementAdministration to operate at the
local level.")
(comment RegionalInstallationOfUSAttorneysOffice "A specialization of #$USFederalGovernmentAgency.  Each
instance of #$RegionalInstallationOfUSAttorneysOffice is a regional
office for the Office of U.S. Attorneys.")
(comment RegionalInstallationOfUSCustomsService "A specialization of #$USFederalGovernmentAgency.  Each
instance of #$RegionalInstallationOfUSCustomsService is a regional
office for the #$USCustomsService.")
(comment RegionalInstallationOfUSSecretService "A specialization of #$USFederalGovernmentAgency.  Each
instance of #$RegionalInstallationOfUSSecretService is a regional
installation for the #$USSecretService-LegalGovernmentOrganization.")
(comment RegionalInstallationOfUSCoastGuard "A specialization of #$USFederalGovernmentAgency.  Each
instance of #$RegionalInstallationOfUSCoastGuard is an installation
for the #$UnitedStatesCoastGuard to operate on a local level.")
(comment BBNSyntacticCategoryMarker "Instances of this collection are #$Attributes which provide syntactic information about arguments to relations which have been hypothesized by the BBN software.")
(comment GrammaticalRoleMarker "Instances of this collection are #$Attributes which provide grammatical role (function) information for arguments to relations which have been hypothesized by the BBN software.")
(disjointWith MechanicalDevice DeviceWithNoMovingParts)
(comment KEInteractionResource "Instances of this collection are resources which can be used by various tools (e.g. the #$CycSalientDescriptor) to organize an generate pages of content which facilitate user interactions. Notable specializations of this collection include #$KEInteractionFolder and #$KEInteractionPage.")
(comment KEFacilitationPrompting "A specialization of #$RequestingInformationFromComputerUser.  Instances of thjs collection are events in which a user is propted to provide information which will facilitate some ongoing KE task. ")
(comment QueryFacilitationPrompting "A specialization of $#RequestingInformationFromComputerUser. Instances of this collection are envents in which a user is prompted to provide information which will facilitate a query specificaiton task")
(comment DialogueClarificationPrompting "A specialization of $#RequestingInformationFromComputerUser. Instances of this collection are envents in which a user is prompted to provide information which will further clarify some ongoing dialogue.")
(comment sizeOfBedding "(#$sizeOfBedding BEDCOVERING BEDSIZE) holds just in case
BEDCOVERING is designed to fit beds that are instances of BEDSIZE.")
(comment QueenSizedBed "The collection of all instances of #$Bed-PieceOfFurniture that are 
conventionally designated \"Queen Size\".")
(comment KingSizedBed "The collection of all instances of #$Bed-PieceOfFurniture that are 
conventionally designated \"King Size\".")
(comment sizeOfBed "(#$sizeOfBed BED BEDSIZE) holds just in case BED is an instance
of BEDSIZE.")
(comment Graduate "The collection of people who have graduated from some educational institution.")
(comment schooling "(#$schooling PERSON SCHOOL STATUS) states that person has the student status 

STATUS at SCHOOL.  For instance, if Bob graduated from Stanford University but was previously

enrolled at University Of Texas At Austin, then (and (#$schooling Bob 

#$StanfordUniversity #$Graduate) (#$schooling Bob #$UniversityOfTexasAtAustin 

#$PreviouslyEnrolled)) holds.")
(comment Enrolled "The collection of perople who are enrolled in some educational institution.  Membership in this collection is relative to the microtheory in which the assertion is made.  In temporal microtheories one should use #$TimeIntervalInclusiveFn to state a \"from\" and \"to\" date.  This would mean that the individual was enrolled from the stated date till the stated date.  Once a person leaves the school they are #$PreviouslyEnrolled until such a time as they die or return to that school.")
(comment TwinSizedBed "The collection of all instances of #$Bed-PieceOfFurniture that are  conventionally designated \"Twin Size\".")
(comment FullSizedBed "The collection of all instances of #$Bed-PieceOfFurniture that are 
conventionally designated \"Full Size\".")
(disjointWith Enrolled PreviouslyEnrolled)
(comment PreviouslyEnrolled "The collection of perople who were previously enrolled in some educational institution.  A person is previously enrolled from the time they leave the school until they die or enroll in that school once again.  See the comment on #$Enrolled.")
(comment NeverEnrolled "The collection of perople who were never enrolled in any educational 
institution.")
(disjointWith Enrolled NeverEnrolled)
(disjointWith Graduate NeverEnrolled)
(comment CourseTypeByLevel "the collection of specializations of Course-Academic that includes all and only those collections that represent the academic level of a course.  This collection includes:
#$FreshmanCourseLevel, #$EleventhGradeCourseLevel, #$FirstGradeCourseLevel, etc..")
(comment SecondGradeCourseLevel "The collection of courses designed for students in the second grade.")
(comment ElementaryCourseLevel "The collection of courses designed for students in elementary school .")
(comment NinthGradeCourseLevel "The collection of courses designed for students in the ninth grade.")
(comment HighSchoolCourseLevel "The collection of academic courses designed for high school students .")
(comment ThirdGradeCourseLevel "The collection of courses designed for students in the third grade .")
(comment TenthGradeCourseLevel "The collection of courses designed for students in the tenth grade .")
(comment UndergraduateCourseLevel "The collection of college courses designed for undergraduates.")
(comment FourthGradeCourseLevel "The collection of courses designed for students in the fourth grade .")
(comment EleventhGradeCourseLevel "The collection of courses designed for students in eleventh grade .")
(disjointWith GameEvent Course-Academic)
(comment Course-Academic "A specialization of #$Education.  This is the collection of academic courses.  Each instance is a temporally discontinuous event consisting of the events that constitute an academic course of study.  Going to the football game on some school night doesn't count as a subevent of an instance of this collection, but doing one's homework probably does.  Important specializations include: #$Course-Collegiate, #$HighSchoolCourseLevel, and #$ElementaryCourseLevel as well as  their specializations.")
(comment FifthGradeCourseLevel "The collection of courses designed for students in the fifth grade.")
(comment TwelfthGradeCourseLevel "The collection of courses designed for students in the twelfth grade .")
(comment SixthGradeCourseLevel "The collection of courses designed for students in the sixth grade.")
(comment FreshmanCourseLevel "The collection of college courses designed for college freshmen .")
(comment GraduateCourseLevel "The collection of courses designed for graduate students .")
(comment SeventhGradeCourseLevel "The collection of courses designed for students in seventh grade.")
(comment JuniorHighCourseLevel "The collection of courses designed for junior high students .")
(comment SophomoreCourseLevel "The collection of college courses designed for college sophomores .")
(comment KindergartenCourseLevel "The collection of courses designed for kindergarten children.")
(comment EighthGradeCourseLevel "The collection of courses designed for students in the eighth grade .")
(comment JuniorCourseLevel "The collection of college courses designed for juniors in college.")
(comment FirstGradeCourseLevel "The collection of courses designed for students in the first grade .")
(comment SeniorCourseLevel "The collection of college courses designed for seniors in college.")
(comment CycTransformationProof "The subclass of #$CycProof each of whose instances uses a #$CycLRuleAssertion to prove a query.")
(comment cycTransformationProofRule "(#$cycTransformationProofRule PROOF RULE) means that RULE is the rule used by PROOF to prove its proven query.")
(comment cycTransformationProofBindings "(#$cycTransformationProofBindings TRANSFORMATION-PROOF BINDING) means that BINDING is an #$InferenceBinding (using the appropriate variable from the transformation rule for TRANSFORMATION-PROOF) proven by TRANSFORMATION-PROOF.")
(comment inferenceBindingVar "(#$inferenceBindingVar BINDING VAR) means that BINDING specifies a binding for VAR.")
(comment inferenceBindingValue "(#$inferenceBindingVar BINDING VALUE) means that BINDING specifies a binding of some variable to VALUE.")
(comment ArseniteIon "A specialization of #$PolyatomicAnion.  Each instance of
#$ArseniteIon is a sample of the ion AsO2(1-).")
(comment PassingThroughAClosedDoor "This is the collection of actions in which a #$Person approaches a closed door, opens it, and passes through.  This event-type excludes those cases where the door is opened either automatically, or by a doorman.")
(comment PassingThroughALockedDoor "This is the collection of actions in which a #$Person approaches a closed, locked door, unlocks the door lock, opens the door, and passes through.")
(comment AcrylicFiber "An instance of #$ManufacturedFiberType.  Each instance of
#$AcrylicFiber is a sample of which the fiber-forming substance is at
least 85% by weight of acrylonitrile units, see also
#$Acrylonitrile.")
(comment AgarCultureMedium "A specialization of #$CultureMedium.  Each instance of #$AgarCultureMedium is a sample of culture medium made primarily of agar.")
(comment AmylAlcohol "A instance of #$ChemicalCompoundTypeByChemicalSpecies.  Each
instance of #$AmylAlcohol is a sample of C5H11OH.  There are eight
possible isomers of amyl alcohol, excluding optic isomers.")
(comment Carbide "A specialization of #$OrganicCompound.  Instance of
#$Carbide are binary solid compounds of #$Carbon with another
element.")
(comment CalciumCarbide "A specialization of #$Carbide.  Instances of
#$CalciumCarbide are samples of the substance CaC2.")
(comment USSenateSeat-Federal "The collection of all United States federal Senate seats.
These offices are the #$JobPositions of #$USSenators. There are a
total of 100 Senate seats, and each state elects two Senators for a
six-year term.")
(comment USHouseSeat-Federal "The collection of all United States federal House of
Representatives seats. These offices are the #$JobPositions of
#$USRepresentatives. Currently (02/02) there are 435, but this total
changes according to the US population as taken by the #$USCensus.
Members are elected for two-year terms.")
(comment StringToRealNumberFn "(#$StringToRealNumberFn NUMSTRING) denotes the real number (if any) that is represented by NUMSTRING in the Arabic numeral system. That is: if NUMSTRING is a #$NumericString, then the above non-atomic term (or \"NAT\") denotes whichever real number NUMSTRING represents in the Arabic system; otherwise the NAT is #$undefined (q.v.).")
(comment RealNumberToStringFn "(#$RealNumberToStringFn REAL) returns the real number REAL as a string, i.e., wrapped in double quotes.")
(comment PartiallyMentalAnimalActivity "This is the collection of events which have at least one mental sub-event #$doneBy an #$Animal, as opposed to a computer, disembodied mind, or non-animal organism--such as the intelligent plants or alien creatures which populate science fiction.")
(comment Thermoplastic "A specialization of #$Plastic and #$HeteroPolymer.  Each
instance of #$Thermoplastic is a plastic substance that softens when
heated but returns to its original condition when cooled to room
temperature.")
(comment CarcinogenType "A collection of collections.  Each instance of
#$CarcinogenType is a instance of
#$ChemicalCompoundTypeByChemicalSpecies whose instances cause the
develpoment of cancerous growths in living tissue.  This collection is
partitioned into those substances known to cause cancer in humans or
animals through industrial operation exposure (for example asbestos),
and those substances that have been shown to cause cancer in
experimental conditions (for example dimethyl sulfate).")
(comment Acrylonitrile "A specialization of #$Monomer.  Each instance of
#$Acrylonitrile is a sample of H2C:CHCN.")
(comment Butadiene "A specialization of #$Monomer.  Each instance of #$Butadiene
is a sample of H2C:CHHC:CH2.")
(comment StyreneMonomer " A specialization of #$Monomer.  Each instance of
#$StyreneMonomer is a sample of C6H5CH:CH2.")
(comment ABSResin "A specialization of #$Thermoplastic.  Each instance of #$ABSResin is piece of material made of some ratio of #$Acrylonitrile, #$Butadiene and #$Styrene.  This compound is typically used for plastic parts of consumer goods: telephones, bottles, luggage, shower stalls, etc.")
(comment PartiallyMentalHumanActivity "This is the collection of events which have at least one mental sub-event #$doneBy a #$Person.")
(comment RadioactiveThallium "Radioactive #$Thallium, used, among other things, on Russian submarines.")
(comment Zoonosis-DiseaseType "The collection of instances of #$DiseaseType that are commonly transmitted to humans through contact with non-human animals.")
(disjointWith PersonTypeByActivity HumanTypeByClothingSize)
(comment chestSizeType "(#$chestSizeType DIST COLLECTION) holds just in case COLLECTION is the 
collection of people whose chests are DIST in circumference.")
(comment HumanTypeByChestSize "A collection of collections.  Each instance of #$HumanTypeByChestSize is a collection of people with the same chest size.  Instances of this collection will usually be  functionally denoted with #$ChestSizeFn.  For instance, (#$ChestSizeFn DIST) denotes the  collection of people whose chests measure DIST in circumference.")
(comment ChestSizeFn "(#$ChestSizeFn DISTANCE) denotes the collection of people whose chest size is DISTANCE.")
(comment waistSizeType "(#$waistSizeType DIST COLLECTION) holds just in case COLLECTION is the 
collection of people whose waists are DIST in circumference.")
(comment HumanTypeByWaistSize "A collection of collections.  Each instance of  #$HumanTypeByWaistSize is a collection of people with the same waist size.  Instances of this collection will usually be  functionally denoted with #$WaistSizeFn.  For instance, (#$WaistSizeFn (Inch 36)) denotes the collection of people whose waists measure 36 inches in circumference.")
(comment WaistSizeFn "(#$WaistSizeFn DISTANCE) denotes the collection of people whose waist size is
DISTANCE.")
(comment HumanTypeByNeckSize "A collection of collections.  Each instance of #$HumanTypeByNeckSize is a collection of people with the same neck size.  Instances of this collection will usually be  functionally denoted with #$NeckSizeFn.  For instance, (#$NeckSizeFn DIST) denotes the  collection of people whose necks measure DIST in circumference.")
(comment HumanTypeByBustSize "A collection of collections.  Each instance of #$HumanTypeByBustSize is a collection of people with the same size bust.  Instances of this collection will usually be  functionally denoted with #$BustSizeFn.  For instance, (#$BustSizeFn DIST) denotes the  collection of people whose bust measurement is DIST.")
(comment HumanTypeByInseamLength "A collection of collections.  Each instance of #$HumanTypeByInseamLength is a collection of persons with a particular inseam length.  Instances of this collection will usually be functionally denoted with #$InseamLengthFn.  For instance, (#$InseamLengthFn (Inch 30))  denotes the subcollection of #$Person such that each instance of that subcollection has  an inseam length of 30 inches.")
(comment HumanTypeByHipSize "A collection of collections.  Each instance of #$HumanTypeByHipSize is a collection of people with the same size hips.  Instances of this collection will usually be  functionally denoted with #$HipSizeFn.  For instance, (#$HipSizeFn DIST) denotes the  collection of people whose hips measure DIST in circumference.")
(comment bustSizeType "(#$bustSizeType DIST COLLECTION) holds just in case COLLECTION is the 
collection of people whose busts are DIST in circumference.")
(comment BustSizeFn "(#$BustSizeFn DISTANCE) denotes the collection of people whose bust size is DISTANCE.")
(comment neckSizeType "(#$neckSizeType DIST COLLECTION) holds just in case COLLECTION is the  collection of people whose necks are DIST in circumference.")
(comment NeckSizeFn "(#$NeckSizeFn DISTANCE) denotes the collection of people whose neck size is
DISTANCE.")
(comment inseamLengthType "(#$inseamLengthType DISTANCE COLLECTION) holds just in case COLLECTION is
the collection of people with inseam length DISTANCE.")
(comment InseamLengthFn "(#$InseamLengthFn DIST) denotes the collection of people whose
inseam measures DIST.")
(comment sleeveLengthType "(#$sleeveLengthType DIST COLLECTION) holds just in case COLLECTION is the 
collection of people whose sleeves are DIST in length (from shoulder to wrist).")
(comment hipSizeType "(#$hipSizeType DIST COLLECTION) holds just in case COLLECTION is the 
collection of people whose hips are DIST in circumference.")
(comment HipSizeFn "(#$HipSizeFn DISTANCE) denotes the collection of people whose hip size is
DISTANCE.")
(comment SleeveLengthFn "(#$SleeveLengthFn DISTANCE) denotes the collection of people whose sleeve length is
DISTANCE.")
(comment HumanTypeByShoeWidth "A collection of collections.  Each instance of  #$HumanTypeByShoeWidth is a collection of people that wear the same shoe width size.  For instance, ShoeWidthB is the collection  of people that wear a width size B in shoes.")
(comment HumanTypeByMensGenericShirtSize "A collection of collections.  Each instance of #$HumanTypeByMensGenericShirtSize is a collection of people who have the same shirt size.")
(comment ShoeWidthC "The collection of people with shoe width size C.")
(comment MensSize10ShoeSize "The collection of people who wear men's size 10 shoes.")
(comment DressSize-Girls "A collection of collections. Each instance of #$DressSize-Girls is a 
collection of people who have a certain dress size.")
(comment DressSize "A collection of collections.  Each instance of #$DressSize is a collection
of people who have a certain dress size.")
(comment ShoeWidthE "The collection of people with shoe width size E.")
(comment DressSize-Misses "A collection of collections. Each instance of #$DressSize-Misses is a  collection of people who have a certain dress size.")
(comment ShoeWidthAAA "The collection of people with shoe width size AAA.")
(comment DressSize-Juniors "A collection of collections. Each instance of #$DressSize-Juniors is a 
collection of people who have a certain dress size.")
(comment ShoeWidthEEE "The collection of people with shoe width size EEE.")
(comment ShoeWidthAA "The collection of people with shoe width size AA.")
(comment UnderwearSize-Women "A collection of collections.  Each instance of #$UnderwearSize-Women
is a collection of people who have the same women's underwear size.")
(comment ShoeWidthEE "The collection of people with shoe width size EE.")
(comment ShoeWidthA "The collection of people with shoe width size A.")
(comment ClothingSize-Toddlers "A collection of collections.  Each instance of #$ClothingSize-Toddlers is 
a collection of people who wear the same toddlers' clothing size.")
(comment ShoeWidthB "The collection of people with shoe width size B.")
(comment ShoeWidthD "The collection of people with shoe width size D.")
(comment humanMeasurements "(#$humanMeasurements PERSON SIZE-TYPE SIZE) holds just in case
PERSON is SIZE with respect to the dimension given by SIZE-TYPE.  Since SIZE is the
collection of people who wear that size, it follows that (#$isa PERSON SIZE).")
(comment Cyanide "An instance of #$TangibleStuffCompositionType.Instances of #$Cyanide are harmful substances where each molecule consists of a #$CyanideIon with one or more atoms of another element. Specializations of #$Cyanide include #$CyanogenChloride, #$SodiumCyanide, and #$HydrogenCyanide.")
(disjointWith ReversibleProcess AChEInactivation-Irreversible)
(comment AChEInactivation-Irreversible "A specialization of #$AChEInactivation.  Instances are #$ChemicalReactions between some chemical and  #$Acetylcholinesterase, in which a binding forms that can't be undone, thus causing fatal cases of #$AcetylcholinePoisoning.")
(comment TermLimitedTemporalOrganization "The collection of all organizations that form with the intent to exist for only a limited period of time.  The time limit may be explicit, or may expire upon the completion of some event.  One topic of a #$TermLimitedTemporalOrganization is always a temporal thing that has not ended at the time the organization is founded.  Examples include juries, transition teams, publicity committees set up for a single event, and today's recess kickball team.")
(comment GainingControlOfFn "A unary #$ReifiableFunction used to denote the collection of events in which an agent gains control of some specific type of object. <code>(#$GainingControlOfFn OBJ-TYPE)</code> denotes all instances of #$GainingControl in which some instance(s) of <code>OBJ-TYPE</code> are controlled (where <code>OBJ-TYPE</code> is an  instance of #$ExistingObjectType and a specialization of #$PartiallyTangible).  Cf. #$gainingControlOfType.")
(comment TerminalFn "(#$TerminalFn COND) denotes the intersection of COND (a spec of #$LifeThreateningCondition) and #$TerminalPhysiologicalCondition.  For example, (#$TerminalFn #$Cancer) is the collection of those #$Cancer conditions which are terminal -- they end with the death of the afflicted organism.")
(comment ApplyOperatorFn "A syntactic function on CycL expressions.  #$ApplyOperatorFn takes as its arguments a #$CycLOperator (q.v.) and one or more other #$CycLTerms, and returns the #$CycLFormula that is the syntactic result of applying that operator to those terms.  (#$ApplyOperatorFn OP TERM1...TERMn) is the CycL formula (OP TERM1...TERMn) constructed by writing OP followed by TERM1...TERMn (in that order) and enclosing the result in a pair of parentheses.  For example, #$ApplyOperatorFn maps the sequence of expressions <`#$loves', `#$Socrates', `#$Plato'> to the sentence `(#$loves #$Socrates #$Plato)'; or to put the point in pure CycL:
<p>
(#$equals
(#$ApplyOperatorFn (#$Quote #$loves) (#$Quote #$Socrates) (#$Quote #$Plato))
(#$Quote (#$loves #$Socrates #$Plato))) .
<p>
Similarly, (#$ApplyOperatorFn (#$Quote #$MotherFn) (#$Quote #$Plato)) is the non-atomic term (#$Quote (#$MotherFn #$Plato)).
<p>
#$ApplyOperatorFn is similar to a concatenation function on sequences of CycL terms (where the first term is an operator).  More precisely, (#$ApplyOperatorFn OP TERM1...TERMn) is the concatenation of the left-parenthesis, OP, TERM1, ..., TERMn, and the right-parenthesis (in that order).
<p>
As the above examples show, #$ApplyOperatorFn in effect enables us to \"distribute\" `#$Quote' (q.v.) over the component terms within a formula (and to do the reverse).  By the same token, it enables us to \"quantify into\" quoted formulae.  Thus, the sentence
<p>
(#$thereExists ?TERM
(#$and
(#$denotes ?TERM ?THING)
(#$isa ?THING #$Philosopher)
(#$isa
(#$ApplyOperatorFn (#$Quote #$loves) ?TERM (#$Quote #$Plato))
#$CycLAssertion)))
<p>
means that there is some sentence of the form
<p>
(#$loves TERM #$Plato)
<p>
asserted in the Cyc Knowledge Base such that the term TERM used in that sentence denotes a philosopher; i.e. there is some philosopher such that it is asserted in the KB that s/he loves Plato.
<p>
But note that the terms used in an `#$ApplyOperatorFn'-based formula are _not_required_ to be #$CycLQuotedTerms (q.v.): any CycL expression that denotes a CycL term (or operator, in the case of the formula's first argument) can be used in such a formula.
<p>
Note also that the formula (OP TERM1...TERMn) returned by #$ApplyOperatorFn, while syntactically well-formed, is not guaranted to be \"semantically well-formed\".  Thus, the #$arity of the #$Relation RELN denoted by OP might not be n; and the denotatum of a given TERMi might not satisfy the argument-type constraints (see #$ArgTypePredicate) on RELN's ith argument.")
(comment InformationStorageDevice "The collection of all physically complex instances of #$InformationStorageMedia in which a change of state in necessary in order to store information.  Common specs include film, magnetic tape or discs, computer memory, mechanical odometers, and Etch-a-sketches.  Pieces of paper or chalk boards are not included in this collection.")
(comment HomeComposting "A specialization of #$CompostingProcess.  Each instance of
#$HomeComposting is an event in which a person or persons composts
organic matter for household use.  This means the #$OrganicStuff used
is probably #$VegetableMatter and leaves and yard clippings.")
(comment computerHardwareFeature "(#$computerHardwareFeature COMP FEATURE) holds just in case COMPUTER is an instance
of #$Computer and FEATURE is an instance of #$ComputerTypeByHardware and COMPUTER has 
FEATURE.  For example, (#$computerHardwareFeature IBMComp01 #$IBMCompatibleComputer)
holds because IBMComp01 is an instance of the collection of #$IBMCompatibleComputer.  That is,
IBMComp01 is an IBM compatible computer.")
(comment Embedded "The collection of instances of #$Computer designed to be embedded in another system.")
(comment ScientificComputingUse "The collection of instances of #$Computer designed to be used for scientific
computing. (e.g. a Cray-SMP)")
(comment InformationManagementUse "The collection of instances of #$Computer designed for information 
management uses.")
(comment CabinetLevelDepartment "The collection of all top-level divisions of the executive branch of a government, headed in a cabinet minister or other appointed cabinet member.  This collection does not include organizations directly out of the office of the president or prime minister.")
(comment CabinetOffice "The collection of all public offices whose holders are heads of #$CabinetLevelDepartments of government and members of the governmental cabinet.  For example, USStateSecretaryOfState.")
(comment CabinetOfficer "The collection of all heads of #$CabinetLevelDepartments.  Such people are members of a governmental cabinet.")
(comment Tobacconist "A store that sells products pertaining to recreational tobacco use. This may be the actual tobacco products (#$SnuffTobacco, #$Cigarettes, #$Cigars) or tools that enable tobacco use such as #$Pipe-SmokingDevice, #$CigaretteLighters, and so on.  See also #$Smoking, #$SmokingDevice.")
(comment TobaccoSuppliesMarketCategory "A product category of items pertaining to recreational tobacco use - #$SnuffTobacco, #$CigaretteLighters, filters, things that are smoked such as #$Cigarettes and #$Cigars, etc.")
(comment AttorneyGeneral "The collection of all heads of law-enforcement departments who also officially represent the executive of the government in court cases, although such representation may normally handled through underlings.")
(comment Infected-ComputerVirus "The collection of things that are infected with a computer virus.  This collection
can include instances of #$ComputerFileCopy, #$ComputationalSystem, and 
#$ComputerStorageDevice.  To say that X is #$Infected-ComputerVirus is to assert that there 
is some #$ComputerVirusCopy which is one of X's parts.")
(comment CustomModification "The collection of pieces of computer hardware that were not original
components of the computers they now modify.")
(disjointWith LawEnforcementOrganization RegulatoryAgency)
(comment RegulatoryAgency "The collection of all government agencies whose purpose is regulating some facet of business or life.  It does not include law enforcement organizations, although an instance of #$RegulatoryAgency may have one or more law enforcement organizations as #$subOrganizations.")
(disjointWith EducationalSystem SchoolInstitution)
(disjointWith SchoolDistrict SchoolInstitution)
(disjointWith AcademicDepartment SchoolInstitution)
(comment SchoolInstitution "The collection of all schools.  Some are single site organizations, while others have branches.  Some are academic, while others teach skills.  Some are private institutions while others are public.  Rarely would any individual school be asserted to be an instance of #$SchoolInstitution since so many specializations of the concept exist.")
(disjointWith SchoolInUniversity-DegreeGranting SchoolInstitution)
(disjointWith CollegeInUniversity-NonDegreeGranting SchoolInstitution)
(comment killingTypeThroughEventType "(#$killingTypeThroughEventType EVENT-TYPE KILLING-TYPE) means that instances of KILLING-TYPE are the #$KillingByOrganisms that come about as a result of occurances of EVENT-TYPE, and which have instances of EVENT-TYPE as sub-events.")
(comment DyingFromEventTypeFn "(#$DyingFromEventTypeFn EVENT-TYPE) denotes the collection of dying events that come about as a result of occurences of EVENT-TYPE.")
(comment dyingTypeFromEventType "(#$dyingTypeFromEventType EVENT-TYPE DYING-TYPE) means that instances of DYING-TYPE are the instances of dying that come about as a result of occurrences of EVENT-TYPE.")
(comment killingTypeByMeansOfType "(#$killingTypeByMeansOfType DEVICE-TYPE KILLING-TYPE) means that instances of KILLING-TYPE are the #$KillingByOrganisms that comes about as a result of occurances of uses of DEVICE-TYPE, and which have those uses as sub-events.")
(comment CNS-Corpus "A #$Corpus containing instances of #$NewspaperArticle and other textual documents assembled by the Center for Nonproliferation Studies (CNS) of the Monterey Institute of International Studies. The corpus contains abstracts relevant to various aspects of intelligence concerning #$WeaponOfMassDestruction and has been made available to #$Cycorp by #$AdvancedResearchAndDevelopmentActivity for the purpose of testing and evaluating question-answering systems in the context of the #$CycorpIBMAQUAINTProject.")
(comment GovernmentProgram "The collection of all government projects [#$Project] that either the public directly interacts with or that spend enough money that they are significant to some of the public (other than as vendor/subcontractor).")
(comment ploidy-Organism "(#$ploidy-Organism ORG PLOIDY-LEVEL) holds just in case ORG has 
ploidy level PLOIDY-LEVEL.  Since #$ploidy-Organism is a specialization of #$isa,
this will hold just in case ORG is an instance of PLOIDY-LEVEL.  ORG will be an instance of
PLOIDY-LEVEL just in case all its cells (with the exception of #$Gametes) have the number of
copies of chromosome sets characterized by PLOIDY-LEVEL.")
(comment InformalEvent "The collection of instances of #$SociabilityBasedAction that are informal in nature.  For instance, all instances of #$Rave-DanceParty are instances of #$Informal-Action.")
(comment EventTypeByFormality "A collection of collections.  Each instance of ActionFormalityAttribute is a 
collection of instances of SociabilityBasedAction with a certain formality.  Instances 
include #$SemiFormal-Action, Casual-Action, etc..")
(comment EventWithCasualFormality "the collection of instances of #$SociabilityBasedAction that are \"casual\" 
in nature.  For instance, every joke telling is a casual action and hence in this collection.")
(comment VeryFormalClothing "The collection of clothing traditionally worn on formal occasions.  This collection
includes such things as tuxedos, bridal gowns, patent leather pumps, etc..")
(comment Ragged "The collection of items of clothing that are ragged, torn, or are otherwise in
poor condition.  This collection represents the lowest degree of formality -- clothes in 
this collection one might wear to mow the lawn or clean the garage.")
(disjointWith Ragged VeryFormalClothing)
(disjointWith Ragged Informal)
(comment Informal "Miss Manners says: no ties.")
(comment Informal "The collection of informal wear.  This collection includes items such as
sports jackets, slacks, etc.  Basically, it consists of clothing that is more formal
than your typical casual clothing, yet not as formal as business suits and ties.")
(disjointWith Informal VeryFormalClothing)
(disjointWith Ragged Casual)
(comment Casual "Miss Manners says:  turtlenecks.")
(comment Casual "The collection of items of clothing that are casual in nature; jeans, sweatshirts
tanktops, etc..   This collection represents the \"casual\" degree of formality.")
(disjointWith Casual VeryFormalClothing)
(disjointWith Ragged SemiFormal)
(disjointWith Informal SemiFormal)
(disjointWith Casual SemiFormal)
(comment SemiFormal "Miss Manners says: coats and ties required.")
(comment SemiFormal "The collection of semi-formal wear.  This collection includes standard
business attire -- suits, ties, dress shoes, etc..")
(disjointWith SemiFormal VeryFormalClothing)
(comment clothingTypeFormality "(#$clothingTypeFormality CLOTHING-TYPE FORMALITY) holds just in case
every instance of CLOTHING-TYPE is of formality FORMALITY.  This will hold just in case
CLOTHING-TYPE is a subcollection of FORMALITY.")
(comment clothingFormality "(#$clothingFormality ITEM FORMALITY) holds just in case ITEM is an article of
clothing with the formality level FORMALITY.  Since this predicate is a specialization of
#$isa, this entails (#$isa ITEM FORMALITY).")
(comment VeryFormalEvent "The collection of instances of #$SociabilityBasedAction that are very formal in 
nature.  Instances include weddings, funerals, etc..")
(comment SemiFormalEvent "The collection of instances of #$SociabilityBasedAction that are semi-formal in
nature.  A good example of actions of this nature are instances of #$ShakingHands.")
(comment BlankForm-StandardizedIBO "The collection of instances of #$Form-StandardizedIBO which have yet
to be filled out.")
(comment LineAgreedTo "The collection of proposals in which the line was agreed to.")
(comment LineNegotiationFailed "The collection of proposals in which the line negotiation failed.")
(disjointWith BlankForm-StandardizedIBO CompletedForm-StandardizedIBO)
(comment CompletedForm-StandardizedIBO "The collection of instances of #$Form-StandardizedIBO which have been 
completed.")
(disjointWith BlankForm-StandardizedIBO PartiallyCompletedForm-StandardizedIBO)
(comment PartiallyCompletedForm-StandardizedIBO "The collection of instances of #$Form-StandardizedIBO which have
been partially filled out.")
(disjointWith PartiallyCompletedForm-StandardizedIBO CompletedForm-StandardizedIBO)
(disjointWith ConstructionProject MassTransitSystem)
(disjointWith ResearchProject MassTransitSystem)
(comment IncapacitatingDosageFn "An individual denoting function.  (#$IncapacitatingDosageFn PERCENTAGE MASS) denotes a #$Toxicity.  Specifically it denotes the toxicity of any substance sufficient to incapacitate PERCENTAGE percent of any population exposed to a dosage of #$Mass MASS.  The method of exposure, the type of population, and the substance are specified using toxicity predicates, such as #$ingestingToxicityOfTypeFor.")
(comment TerroristSuicideBombing-Nuclear "A specialization of #$TerroristSuicideBombing in which the #$deviceUsed is
a #$Mini-NuclearBomb, or so-called 'suitcase nuke.'")
(comment densityOfTypeAtTemperature "(#$densityOfTypeAtTemperature STUFF-TYPE DENSITY TEMPERATURE) says that for any instance INS of STUFF-TYPE such that (#$temperatureOfObject INS TEMPERATURE), (#$densityOfObject INS DENSITY) holds.")
(comment GroupEventOfTypeFn "(#$GroupEventOfTypeFn EVTTYPE) is the collection of instances of EVTTYPE, the main #$subEvents and #$groupMembers of which are all also instances of EVTTYPE.  For example, (#$GroupEventOfTypeFn #$KillingByOrganism) is the collection of group killing events, that is, events, the main #$subEvents and #$groupMembers of which are individual #$KillingByOrganism.")
(comment Jury-Petit "The collection of all juries constituted by governments to try legal cases as opposed to accepting indictments.  In legalese, \"petit\" jury.  See also #$GrandJury.")
(disjointWith ElectionForOffice PrimaryElection)
(comment PrimaryElection "The collection of all elections managed by a #$GeopoliticalEntity in which people vote for who a specific #$PoliticalParty's candidate should be in an upcoming general election.")
(comment DyingFromEventType "This #$SiblingDisjointCollectionType is a faceting of #$Dying.  Each instance is a specialization of #$Dying whose instances are characterized by coming about through (and as part of) an action of a certain type.")
(comment Trip-CommercialAirline-Mass "The collection of all instances of (#$TransportViaFn AirTransportationDevice) in which a group of passengers is transported from one place to another on a #$PassengerAirplane under the auspices of a commercial airline (see #$AirlineCompany).  Each instance includes subevents which are instances of #$FlightViaAirTransportationDevice, as well as loading luggage, loading and offloading passengers, and taxiing to and from the terminals.")
(comment FederalCongressionalDistrict "The collection of all US congressional districts.  An election for the #$USHouseOfRepresentatives is open to registered residents of a congressional district, and not to those resident outside its borders.  A congressperon from a district represents all the residents of that district.")
(comment Trip-CommercialAirline-Individual "The collection of all events in which an individual #$Person takes a trip via a commercial airline, inclusive of purchasing the ticket, packing, taking transport to the airport, boarding the plane, disembarking, and taking transport to their destination, as well as the actual airplane flight itself--i.e., the #$Trip-CommercialAirline-Mass.  Every #$Trip-CommercialAirline-Individual includes a Trip-CommercialAirline-Mass as a #$subEvents.")
(comment colorOfType "(#$colorOfType TYPE COLOR) holds just in case every instance
of TYPE, INS,  is such that (#$mainColorOfObject INS COLOR).  That is, just in case
each instance is an instance of COLOR.  Given that #$mainColorOfObject is a specialization
of #$isa, it then follows that (#$genls TYPE COLOR).")
(comment AluminumColor "The collection of things that are mainly the color of aluminum.")
(comment StringTokenizeFn "(#$StringTokenizeFn ?IN-STRING ?BREAK-LIST) breaks IN-STRING on any string sequence in BREAK-LIST which is a #$List, and returns a #$List of strings. The priority of the breaks is specified in ?BREAK-LIST (ie. initial entries will be broken first).")
(comment Motorcyclist-Professional "The collection of people who are professional #$Motorcycle riders. These people could be motorcycle racers, or could drive motorcycles as part of some other job.")
(disjointWith City Borough)
(comment Borough "The collection of all administrative units of a city.  These are called \"boroughs\" in New York City, but may have other names in other places.")
(comment subScenarios "A transitive, irreflexive predicate.  (#$subScenarios GENERAL-CONTEXT SPECIFIC-CONTEXT) says that SPECIFIC-CONTEXT is an instance of #$ScenarioContext that contains only information that would (under ideal circumstances) be generated were SPECIFIC-CONTEXT generated as an expansion of #$ScenarioContext GENERAL-CONTEXT by the scenario generation engine.  It is expected that such specific contexts will be reified for testing purposes.")
(comment GovernmentalAdministration "The collection of all central leaderships of the executive branch of a government (whether city, state, or national).  The administration is lead by the #$HeadOfGovernment and includes all executive branch officials which s/he appointed to a policy-making position.")
(comment FieldIndexical-LogicalOrPhysical "The collection of all indexicals that are used to denote the
values associated with the logical or physical fields of logical or
physical schemata.")
(comment LogicalFieldIndexical "A specialization of #$FieldIndexical-LogicalOrPhysical, this is the collection of all indexicals that 
are used to denote the values associated with the logical fields of logical
schemata. Each #$LogicalFieldIndexical is related to a unique #$LogicalSchema via 
#$logicalFieldIndexicals and is related to a unique #$LogicalField via 
#$indexicalForLogicalField. In the latter case, the relation establishes a one to 
one correspondence between #$LogicalFields and #$LogicalFieldIndexicals.")
(comment fieldTranslation "This predicate is the most general relation that is used to
describe the logical or physical schema field value translations that
determine the structural mapping between a knowledge source's physical
and logical schemata. The argument constraints on this relation admit
physical to physical, logical to physical, physical to logical, and
logical to logical schema field value transformations. Each of these
admitted translation types is specialized as its own predicate
and the totality of these spec preds partition the graph of
#$fieldTranslation.")
(comment physicalFieldTranslation "This predicate is the typed specialization of
#$fieldTranslation which transforms physical schema field values into
physical schema field values. It may be used, for instance, to
describe how to create new physical fields from existing physical fields by defining how their values are related.")
(comment logicalFieldTranslation "This predicate is the typed specialization of
#$fieldTranslation which transforms logical schema field values into
logical schema field values. It may be used, for instance, to
construct new logical field values by applying denotational functions
to other logical field values.")
(comment UtilityWireProject-Fire "An instance of #$TemporalObjectType and a specialization of
#$NaturalGasFire. Instances of #$UtilityWireProject-Fire result from
ignition of #$NaturalGas vented from a gas line that was severed
during an attempt to repair an underground #$UtilityWire.")
(comment UtilityWireProject-RequestLocate "An instance of #$TemporalObjectType and a specialization of
#$RequestingAction. Each instance of #$UtilityWireProject-RequestLocate
is an event in which someone issues a request to a utility company to
mark the location of underground utility lines at the site of planned
construction. The marking is typically requested for projects
involving digging that might accidently damage utility lines.")
(comment UtilityWireProject-MarkLocation "An instance of #$TemporalObjectType and a specialization of
#$MarkingOnASurface. Each instance of #$UtilityWireProject-MarkLocation
is an event in which someine marks the location of underground utility
lines in preparation for construction involving digging that might
accidently damage the utility lines. Typically, the marking is
effected with spray paint or small orange falgs.")
(comment UtilityWireProject-Dig "An instance of #$TemporalObjectType and a specialization of
#$DiggingAHole. Each instance of #$UtilityWireProject-Dig is an event
in which one or more construction workers dig in order to provide
access to an underground #$UtilityWire for purposes of repairing it.")
(comment UtilityWireProject-Fix "An instance of #$TemporalObjectType and a specialization of
(#$RepairingFn #$UtilityWire). Each instance of #$UtilityWireProject-Fix
is an event in which one or more construction workers repair an
exposed underground #$UtilityWire.")
(comment UtilityWireProject-Bury "An instance of #$TemporalObjectType and a specialization of #$BuryingSomething. Each instance of #$UtilityWireProject-Bury is an event in which one or more construction workers bury an underground #$UtilityWire that has been exposed for purposes of repairing it.")
(comment UtilityWireProject-Vent "An instance of #$TemporalStuffType and a specialization of
#$EmittingStuff. Each instance of #$UtilityWireProject-Vent is an event
in which an underground #$NaturalGas line vents gas as a result of
being severed during an attempt to repair an underground
#$UtilityWire.")
(comment UtilityWireProject-Construction "An instance of #$ScriptedEventType and a specialization of
#$ConstructionProject. Each instance of
#$UtilityWireProject-Construction is the construction phase of a
project to repair an underground #$UtilityWire. One prior phase of
such a project is an instance of #$UtilityWireProject-Location.")
(comment UtilityWireConstructionMishap-Fire "An instance of #$ScriptedEventType and a specialization of
#$UtilityWireProject-Construction. Each instance of
#$UtilityWireConstructionMishap-Fire is a common construction mishap
in which digging damages a gas line, causing it to vent gas that is
subsequently ignited.")
(comment UtilityWireProject-Location "An instance of #$ScriptedEventType and a specialization of
#$CollectingInformation. Each instance of
#$UtilityWireProject-Location is the location phase of a project to
repair an underground #$UtilityWire. In this phase, one or more
workers request, and one or more workers provide, information about
the location of underground utility lines in the vicinity of
construction that is planned for a later phase of the project.")
(comment UtilityWireRepairProject-Underground "An instance of #$ScriptedEventType and a specialization of
#$ConstructionProject. Each instance of
#$UtilityWireRepairProject-Underground is a project to repair an
underground #$UtilityWire.")
(comment objectHasColorTinge "(objectHasColorTinge OBJ COLOR-TINGE) holds just in case some visible part
of object is colored COLOR-TINGE.  This is the most general of the color tinge predicates.
See #$mainColorTingeOfObject, and #$uniformColorTingeOfObject.  Unlike the other two 
color tinge predicates, this predicate is not a specialization of #$isa.  This is because
it doesn't follow from the fact that an object's part is color COLOR-TINGE that that object
is an instance of the collection COLOR-TINGE that characterizes that color tinge.")
(comment mainColorTingeOfObject "(#$mainColorTingeOfObject OBJ COLOR-TINGE) holds just in case the main color tinge
of object is COLOR-TINGE.  To express that OBJ is a particular color and not a tinge use
#$mainColorOfObject.  This is the broadest predicate in the tinge predicate suite that
is a specialization of #$isa.  For a more general or specific predicate, respectively, see 
#$objectHasColorTinge and #$uniformColorTingeOfObject.")
(comment uniformColorTingeOfObject "(#$uniformColorTingeOfObject OBJ COLOR-TINGE) holds just in case OBJ 
is uniformly the color COLOR-TINGE.  This is the strongest of of the color tinge predicates 
and should be used only when OBJ is entirely one color.  To assert that an object is uniformly
some particular color instead of a color tinge use #$uniformColorOfObject.  If weaker relations 
to color tinges are needed use #$mainColorTingeOfObject, or #$objectHasColorTinge.")
(comment FIPSState-CountyCode "A #$FIPSState-CountyCode is a five digit code provided by NIST in the Federal Information Processing Standards Publications (FIPS PUBS) that combines a two digit state code with a three digit county code to provide a unique code for every county in the US.")
(comment fiveDigitFIPSCode "(#$fiveDigitFIPSCode LOC FIPS) relates a location LOC to the five digit code FIPS that represents the state and county of LOC.  The first two numbers of FIPS correspond to a state code and the last three numbers of FIPS correspond to the county code.  Note that county codes on their own are not necessarily unique for every county in the US.  They are unique for every county within a particular state and the combination of the state and county codes creates a unique identifier for each county in the US.")
(comment Asymptomatic "The collection of instances of #$Animal in which the organism has some condition asymptomatically. This means the organisms exhibits no symptoms of an #$AilmentCondition; however, this does not mean that the organism is without an #$AilmentCondition. In many cases organisms infected with certain diseases do not show signs of having it at all.")
(comment AtRisk "The collection of instances of #$Animal that are at risk of 
contracting some type of ailment.")
(comment Immune "The collection of instances of #$Animal that are immune to some type of ailment.")
(comment InRemission "The state of having some type of ailment in a state of remission.")
(comment Recovered " The state of having recovered from some type of ailment.")
(disjointWith NationalGovernmentEmployee StateOfficial)
(comment StateOfficial "The collection of all #$PublicOfficials who work for a #$State-Geopolitical as opposed to a country or a city.")
(disjointWith NationalGovernmentEmployee CityOfficial)
(comment CityOfficial "The collection of all #$PublicOfficials who work for a #$City as opposed to a state or country")
(disjointWith StateOfficial CityOfficial)
(comment MayorsOffice "The collection of all mayors' offices, consisting of a mayor and his or her personal assistants and advisiors on the city payroll along with other city employees whose job it is to work directly for the mayor.")
(comment FreightTrain "The collection of all freight trains.  These are trains whose #$primaryFunction is to transport goods, not paying #$passengers.")
(comment PassengerTrain "The collection of all passenger trains.  These are trains whose #$primaryFunction is to transport #$passengers, not freight.")
(disjointWith FreightTrain PassengerTrain)
(comment Tedium "A specialization of #$Quantity-ScriptUse.  This is the collection of

all the instances of #$Quantity-ScriptUse that represent various levels of tedium with

respect to events.  Instances of this collection are usually formed by using the #$GenericValueFunctions.")
(comment Convenience "A specialization of #$Quantity-ScriptUse.  This is the collection of

all the instances of #$Quantity-ScriptUse that represent various levels of convenience with

respect to events.  Instances of this collection are usually formed with the #$GenericValueFunctions")
(comment groupTypeMemberType "#$groupTypeMemberType is the function that corresponds to the function #$GroupFn (q.v.).  <code>(#$groupTypeMemberType GRP-TYPE MEMBER-TYPE)</code> means that #$Collection <code>GRP-TYPE</code> is the collection of all and only groups comprised only of members of #$Collection <code>MEMBER-TYPE</code>. Thus, for example, (#$groupTypeMemberType (#$GroupFn #$PartiallyTangible) #$PartiallyTangible) means that (#$GroupFn #$PartiallyTangible) is the collection of all groups of partially tangibles. ")
(comment ComfortLevel "A specialization of #$Quantity-ScriptUse.  This is the collection of

all the instances of #$Quantity-ScriptUse that represent various levels of comfort with

respect to events.  Instances are usually formed by use of the #$GenericValueFunctions.")
(disjointWith StateCapitolBuilding CityHall-Building)
(comment CityHall-Building "The collection of all buildings which house the executive offices of a #$CityGovernment.  A city hall is often a detached building with monumental architecture, but in a small town it may be attached to adjacent buildings.  A portion of a larger building that is designated as being a city hall does not fall under this definintion.")
(comment FIPSCountyCode "A #$FIPSCountyCode is a three digit code provided by NIST in the Federal Information Processing Standards Publications (FIPS PUBS) that represents a county.  Each county in a given state has a unique code, but counties from different states often have the same codes.  This code is paired with a #$FIPSStateCode to produce a unique #$FIPSState-CountyCode.")
(comment threeDigitFIPSCountyCode "(#$threeDigitFIPSCountyCode LOC FIPS) relates a location LOC to the three digit code FIPS that represents the county of LOC.  Note that county codes on their own are not necessarily unique for every county in the US.  They are unique for every county within a particular state and the combination of the state and county codes creates a unique identifier for each county in the US.")
(comment FIPSStateCode "A #$FIPSStateCode is a unique two digit code provided by NIST in the Federal Information Processing Standards Publications (FIPS PUBS) for every #$State-UnitedStates.  This code is paired with a #$FIPSCountyCode to produce unique #$FIPSState-CountyCodes.")
(comment twoDigitFIPSStateCode "(#$twoDigitFIPSStateCode LOC FIPS) relates a location LOC to the unique two digit code FIPS that represents the state of LOC.")
(comment sksiSentence "A #$KBDependentRelation (q.v.) and specialization of #$knownSentence (q.v.) that is used to state that a given #$CycLSentence-Assertible is virtually asserted in some #$StructuredKnowledgeSource currently available via SKSI in some accessible #$Microtheory.
<p>
This predicate enables Cyc to select a subset of information when answering queries, filtering out the assertions which only exist in the KB proper.")
(comment CashSale "A specialization of #$BuyingAnObject. Each instance of #$CashSale is a sale in which the buyer pays cash for the items purchased.")
(comment SaleTypeByTenderType "A collection of specializations of #$BuyingAnObject. Each instance of #$SaleTypeByTenderType is a type of buying, or selling, in which the same type of tender is used. For example, #$CreditSale and #$SaleByCheck are instances of #$SaleTypeByTenderType.")
(comment dangerousParts "(#$dangerousParts WHOLE PART) is a specialization of #$physicalParts which specifically relates #$PartiallyTangible wholes to the #$DangerousTangibleThings which are #$physicalParts of them, if any. Examples include tank guns, #$Stingers, and acidic blood.")
(comment agentHasRelationshipTo "(#$agentHasRelationshipTo AGENT1 AGENT2 STATUS) holds just in case AGENT1 has
STATUS with respect to AGENT2.  This relationship is not, in general, symmetric.  Though,
depending on the arg3, AGENT2 may have STATUS with respect to AGENT1.  An example of a case where symmetry does hold  is: (#$agentHasRelationshipTo Spouse1 Spouse2 #$Married).")
(disjointWith SportsPoundingDrivingImplement Racket-SportsEquipment)
(comment SportsPoundingDrivingImplement "The subcollection of long and thin #$PoundingDrivingImplements which are used in #$SportsGames to manipulate a #$Ball or other critical object. Canonical examples include #$BaseballBat, #$GolfClub, and #$HockeyStick.")
(comment Jury "The collection of all groups of people formed to judge and give a decision on some matter, often a civil or criminal case, indictment, or impeachment.  A jury is normally sworn to render a fair judgement.  A #$GrandJury judges an indictment, while a #$Jury-Petit judges a civil or criminal case.")
(comment GrandJury "The collection of all groups of people formed and assembled to judge whether an indictment should be handed down against a party accused of a crime.")
(disjointWith GrandJury Jury-Petit)
(comment CourtCase "The collection of all legal conflicts [#$LegalConflict] that come before a court.  This includes civil and criminal cases, but excludes uncontested traffic citations and official duties by justices of the peace such as marriages that do not involve judicial rulings.  Legal cases that are worked out between attorneys without involving courts, cases arbitrated outside the court system (unless under court order), and impeachment cases are not included in this collection.")
(comment NoContestPlea "A #$NoContestPlea is an acceptance of a charge  that an person has committed a crime.  It is not an admission that that the person actually committed the crime, but an assertion that the person will not legally contest the accusation.  Such a plea normally leads to a guilty conviction.  A person may choose such a plea for a number of different reasons, including lack of resources to carry on a defense, a plea bargain resulting in the dropping of stronger or additional charges, a proffered lighter sentence than the proscecutor would seek if the defendant were convicted, to prevent the person from being held indefinitely without charges, or similar reasons.")
(disjointWith GuiltyPlea NoContestPlea)
(disjointWith NotGuiltyPlea NoContestPlea)
(comment LegalAppeal "The collection of all appeals of decisions handed down by judicial bodies by the party that was maleficiary of the decision.  Such appeals are made to appellate courts [#$AppealsCourt], which may reject or hear the appeal.  A decision of an appeals court can be appealed to a \"higher\" appeals court.  A legal appeal is normally part of the case that started in the court of initial jurisdiction.")
(comment IntentionallyFn "An instance of #$EventQualifyingFunction that takes a specialization of #$Action and returns the subcollection of #$PurposefulActions that are intentionally carried out by the \"performer\" (see #$performedBy). For example, (#$IntentionallyFn #$DroppingAnObject) describes the collection of #$DroppingAnObject where the performer intentionally drops an object.")
(comment objectContaminated "An #$ActorSlot used to identify the object(s) contamined in an instance of #$ContaminationEvent. (#$objectContaminated CONTAMINATION THING) says that in the #$ContaminationEvent, THING has been contaminated.")
(comment Campylobacteriosis "The infection caused by #$Campylobacter.")
(comment typeDecompositionTemperature "(#$typeDecompositionTemperature COMPOUND TEMPERATURE) means that
any instance SAMPLE of #$ChemicalCompoundTypeByChemicalSpecies COMPOUND will
decompose at the #$Temperature TEMPERATURE -- that is, SAMPLE will undergo (play the role of #$chemicalReactants-Macroscopic in) an instance of #$ChemicalDecomposition.")
(comment mainRegionOfOperation "(#$mainRegionOfOperation AGENT REGION) means that AGENT performs his/her/its central task in and throughout REGION.  There could be some outlying regions that are also covered and some spots within REGION that are not, but such exceptions are minimal.  See also #$operatesThroughoutRegion and #$operatesOnlyWithinRegion")
(comment operatesThroughoutRegion "(#$operatesThroughoutRegion AGENT REGION) means that AGENT performs his/her/its central task in all parts of REGION.  There may or may not be additional regions outside REGION that are also covered.  See also #$mainRegionOfOperation and #$operatesOnlyWithinRegion")
(comment operatesOnlyWithinRegion "(#$operatesOnlyWithinRegion AGENT REGION) means that AGENT performs his/her/its central task only within REGION.  There could be subregions of REGION in which AGENT does not operate.  Thus, an agent that operates only in a single city also #$operatesOnlyWithinRegion the #$PlanetEarth.  See also #$operatesThroughoutRegion and #$mainRegionOfOperation")
(comment candidateProperSubSituationTypes "<code>(#$candidateProperSubSituationTypes SIT-TYPE SUB-SIT-TYPE)</code> means that instances of <code>SIT-TYPE</code> (a specialization of #$Situation) may have instances of <code>SUB-SIT-TYPE</code> as proper sub-situations. (Instantiations of the script might not have a sub-situation of type <code>SUB-SIT-TYPE</code>, but the possibility that any given instantiation does have such a scene is sufficiently large or salient enough to be worth asserting.) For instance, (#$candidateProperSubSituationTypes #$DailyMorningRoutine (#$ApplyingStuffFn #$Makeup)).")
(comment HomoSapiens "A specialization of #$HomoGenus and an instance of #$BiologicalSpecies: this is the species to which modern humans belong, though strictly speaking (and not entirely uncontroversially amongst paleontologists) they comprise only a subset of it (namely \"homo sapiens sapiens\"). The species also contains Neanderthal and Cro-Magnon sub-species (both now extinct). Given the evidence of sophisticated tool-use, burial practices etc. even amongst the latter two sub-species, this collection is a specialization of #$Person. See also #$HumanBody.")
(disjointWith HomoSapiens (CollectionDifferenceFn Mammal HomoSapiens))
(disjointWith HomoSapiens (CollectionDifferenceFn Animal HomoSapiens))
(disjointWith Agent-Generic (FoodOrDrinkForFn HomoSapiens))
(comment (KillingFn HomoSapiens) "A specialization of #$KillingByOrganism (q.v.).  Each instance of (#$KillingFn #$HomoSapiens) is an event in which a human being is killed.  Important specializations of this collection include #$Murder and #$Execution-Judicial.")
(disjointWith PetFood (FoodOrDrinkForFn HomoSapiens))
(comment MultiPersonAgent "The subcollection of #$MultiIndividualAgent-Intelligent whose instances are all groups of persons, i.e., instances of (#$GroupFn #$Person).")
(comment successorInPosition "(#$successorInPosition SUCCESSOR PREDECESSOR POSITION POLITY) means that SUCCESSOR is the person who holds POSITION in the #$GeopoliticalEntity, POLITY, immediately after PREDECESSOR ceased holding that same position.  Since a person can hold a position intermittently, with someone else holding it in between, none of the arguments are #$SingleEntry.")
(comment successorPositionTo "(#$successorPositionTo HI-POSITION LOWER-POSITION ORGANIZATION) means that HI-POSITION is a position in ORGANIZATION which, if it becomes vacant, is filled by the person formerely holding LOWER-POSITION.")
(comment objectGiven "(#$objectGiven EVENT OBJECT) holds if the #$SomethingExisting OBJECT is given by the #$giver to the #$givee during a #$GivingSomething.")
(comment regulatesActivityType "(#$regulatesActivityType REGULATOR ACTIVITY-TYPE) means that REGULATOR (usually an organization, but could be an individual) regulates the performance of instances of ACTIVITY-TYPE within the area of its jurisdiction [see #$jurisdictionRegion].   Also see #$regulatesObjectType.")
(comment regulatesObjectType "(#$regulatesObjectType REGULATOR TYPE) means that REGULATOR (usually an organization, but could be an individual) regulates the production, sale, use, and/or disposal of instances of TYPE within the area of its jurisdiction [see #$jurisdictionRegion].  Also see #$regulatesActivityType.")
(comment logicalFieldDecoding "This predicate is a specialization of
#$logicalFieldTranslation which translates logical field values into
more complex logical field values. It is used in cases where
additional logical fields, or more complex expressions can be created
by composing other existing logical field values. See also the dual
relation #$logicalFieldEncoding.")
(comment logicalFieldEncoding "This predicate is a specialization of
#$logicalFieldTranslation which translates logical field values into
simpler logical field values. It is used in cases where additional
logical fields, or more complex expressions can be decomposed into
other existing logical field values. See also the dual relation
#$logicalFieldEncoding.")
(comment physicalFieldDecoding "This predicate is a specialization of
#$physicalFieldTranslation which translates 'literal' or 'virtual'
physicalfield values into 'virtual' physical field
values. Here, a 'literal' physical field is one that is actually
present in the underlying knowledge source, whereas a 'virtual'
physical field is constructed in the mapping process. See also the
dual relation #$physicalFieldEncoding.")
(comment physicalFieldEncoding "This predicate is a specialization of
#$physicalFieldTranslation which translates 'virtual' physical field
values into 'literal' or 'virtual' physical field values.  Here, a
'literal' physical field is one that is actually present in the
underlying knowledge source, whereas a 'virtual' physical field is
constructed in the mapping process. See also the dual relation
#$physicalFieldDecoding.")
(comment SpatiallyContinuousThing "A specialization of #$SpatialThing.  For every instance REGION of #$SpatiallyContinuousThing, any two points it subsumes are connected by some path it also subsumes.  Positive exemplars include a drinking glass, a haystack, a spiderweb, or a region of space in the shape of any of these things.  If the glass is broken and its pieces no longer touch each other, it is not a #$SpatiallyContinuousThing.  Some borderline exemplars depend on granularity.  At a macroscopic level of granularity, a dense cloud of smoke is effectively continuous.  On the microscopic level, it is composed of independent particles that do not touch each other.")
(comment preservesDisjointness-Unary "#$preservesDisjointness-Unary is a unary instance of #$MetaRelation.  <code>(#$preservesDisjointness-Unary FUNCTION)</code> means that <code>FUNCTION</code> (an instance of #$CollectionDenotingFunction and #$UnaryRelation) has the following property: if <code>COL1</code> and <code>COL2</code> are specializations of #$Collection that can both serve as the 1st argument of <code>FUNCTION</code>, and <code>COL2</code> is disjoint with <code>COL1</code> (so that <code>(#$disjointWith COL2 COL1)</code> holds), then the result of <code>FUNCTION</code> taking <code>COL2</code> as its argument will be disjoint with the result of <code>FUNCTION</code> taking <code>COL1</code> as its argument. For example, (#$preservesDisjointness-Unary #$GroupFn) holds because <code>(#$disjointWith COL-2 COL-1)</code> implies <code>(#$disjointWith (#$GroupFn COL-2) (#$GroupFn COL-1))</code>, for all collections <code>COL-1</code> and <code>COL-2</code> that satisfy the argument constraints for #$GroupFn.")
(disjointWith Cyc-BasedProject RetirementSystem)
(disjointWith ConstructionProject RetirementSystem)
(disjointWith ResearchProject RetirementSystem)
(disjointWith MassTransitSystem RetirementSystem)
(comment RetirementSystem "The collection of all programs that provide for income for system enrollees after their retirement.  Such programs may be run by private corporations, cooperatives, or as #$GovernmentPrograms.")
(comment EditingOfCW "The collection of all cases in which a conceptual work is edited to create a modified work.  The resulting work is generally the same, although certain concepts have been added, removed, or refined.  Information structures for the complete work are different between the former and modified forms.")
(comment argumentCountType "(#$argumentCountType PRED ARG-NUM TYPE) means that the type of the
entities being counted in the ARG-NUM position of a CycL sentence headed
by PRED is TYPE. For example, (#$argumentCountType #$numberOfInhabitants 2 #$Person)
means that the number 2800000 in (#$numberOfInhabitants #$CityOfRomeItaly
2800000) is used as a count of 2800000 instances of #$Person and not, say, of 2800000 instances of #$Dog. This intention that could not be directly expressed as an argument constraint on the second argument of #$numberOfInhabitants, which is bound to be a #$NonNegativeInteger, i.e #$disjointWith #$Person.")
(disjointWith BloodDrive NewsConference)
(disjointWith TeleconferenceSiteMeeting NewsConference)
(disjointWith Teleconference NewsConference)
(disjointWith ClassMeeting NewsConference)
(disjointWith BusinessMeeting NewsConference)
(disjointWith Convention-Meeting NewsConference)
(disjointWith StaffMeeting NewsConference)
(comment NewsConference "The collection of all meetings in which members of the press are called in order to publicly provide them with information which the organizers of the press conference wish disseminated to the public.  A statement is initally given to the press, after which the press is given the opportunity to ask questions.")
(comment ConcessionsCompany "The collection of #$FoodServiceOrganizations that provide food and drink to
businesses or institutions on an ongoing basis.")
(comment denies "The opposite of #$claims. This predicate relates an agent to a proposition 
that s/he has denied or otherwise publicly repudiated. (#$denies AGENT SENT) means that 
AGENT claims that the proposition PROP expressed by SENT is false. Typically, AGENT 
wants others to believe PROP is false and will take action to convince others that it 
is false. Note that AGENT need not know or believe PROP to be false. For example, a 
person might knowingly deny involvement in a crime they committed.")
(comment FinancialGroup "A group of #$FinancialOrganizations (banks, S&Ls, insurance providers, accounting 
firms, etc.) that operate as a single managerial unit. Each member company usually retains
some degree of autonomy, but general strategy and marketing are carried out as a 
collective. The purpose of a FinancialGroup is to consolidate a client base.")
(comment ComputerConsultingFirm "The collection of all #$ConsultingFirms that are primarily or 
significantly engaged in providing consulting services specifically relating to
computers, computer networks, and other information technology.")
(comment ConsultingFirm "The collection of all #$CommercialServiceOrganizations that are primarily or 
significantly engaged in providing consulting services. All ConsultingFirms employ
#$Consultants, but usually employ people in other capacities as well.")
(comment Advising-Professional "A specialization of #$ServiceEvent in which a professional advisor gives
counsel to a client. This type of service is most often performed by a #$Consultant,
though lawyers and medical practitioners often give advice outside the strict context
of #$LegalCounsellingService or #$MedicalCareEvent.")
(comment TelecommunicationsCompany "The collection of all #$CommercialOrganizations that are primarily or 
significantly engaged in a #$TelecommunicationsIndustry or whose activities focus 
on that industry.")
(comment mtTimeParameter "(#$mtTimeParameter MT PARA) means that the instance MT of #$TemporalMicrotheory has PARA as its value of `time parameter'.  See also #$mtTimeIndex and #$mtTimeIndexWithParameter.")
(comment plannerOfEvent "(#$plannerOfEvent EVT AGT) means that AGT planned (or helped
plan) EVT, i.e., that AGT helped construct the plan whose execution
was EVT.  #$plannerOfEvent directly links an event to the agent(s) who
planned it.  To separate out the planning and execution steps, see
#$planningAgent, #$executionOfPlan, #$PlanSpecificationMicrotheory,
and related vocabulary.")
(comment weaponTypeTransportedInType "(#$weaponTypeTransportedInType DELIVERY-TYPE WEAPON-TYPE) means that the specialization of #$Weapon WEAPON-TYPE is the type of weapon transported in the type of #$TransportationOfWeaponToTarget DELIVERY-TYPE.")
(comment makingTypeOfType "(#$makingTypeOfType MAKING-TYPE OBJ-TYPE) means that the specialization of #$MakingSomething MAKING-TYPE is the type of event in which instances of the specialization of #$PartiallyTangible OBJ-TYPE are made.")
(comment instructionsTypeForMakingType "(#$instructionsTypeForMakingType INSTRUCTIONS-TYPE TEMPORAL-STUFF-TYPE) means that the specialization of #$Instructions INSTRUCTIONS-TYPE is the type of instructions for making instances of the specialization of #$TemporalStuffType TEMPORAL-STUFF-TYPE are made.")
(comment actionTypeIsUseOfType "(#$actionTypeIsUseOfType ACT-TYPE DEVICE-TYPE) means that the specialization of #$PurposefulAction ACT-TYPE is the type of action in which instances of the specialization of #$PhysicalDevice DEV-TYPE is used.")
(comment ToxicityOfTypeForFn "An instance of #$UnaryFunction.  (#$ToxicityOfTypeForFn SLOT) returns an instance PRED of #$TernaryPredicate, used to state the toxicity level (the arg3) of some type of substance (the arg1) for some organism-type (the arg2).  ((#$ToxicityOfTypeForFn SLOT) SUBSTANCE ORGANISM-TYPE TOXICITY) says that for instances ORG of the #$OrganismClassificationType ORGANISM-TYPE, the toxicity level with respect to SLOT -- an instance of #$ToxicitySlot -- for an instance SAMPLE of SUBSTANCE is TOXICITY.  In other words, (SLOT SAMPLE TOXICITY) holds for ORG.")
(comment gainingControlOfType "<code>(#$gainingControlOfType CONTROL-TYPE OBJ-TYPE)</code> means that the specialization of #$GainingControl <code>CONTROL-TYPE</code> is the type of event in which control is gained over instances of the specialization of #$PartiallyTangible <code>OBJ-TYPE</code>.")
(comment iDLHConcentration "(#$iDLHConcentration SUBSTANCE QUANTITY) relates an instance
of #$ChemicalSubstanceType SUBSTANCE to the airborne
concentrations that are dangerous, imposing immediate or delayed
permanent adverse health effects from environmental exposure as
determined by National Institute for Occupational Safety and Health (NIOSH).")
(comment GeneralizedTransferOfFn "A unary #$ReifiableFunction used to denote the collection of events in which an a certain type of object is the tranferred.  (#$GeneralizedTransferOfFn OBJ-TYPE) denotes the specialization of #$GeneralizedTransfer in which some instance of OBJ-TYPE plays the role #$objectTransferred.")
(comment generalizedTransferOfType "(#$generalizedTransferOfType TRANSFER-TYPE OBJ-TYPE) means that the specialization of #$GeneralizedTransfer TRANSFER-TYPE is the type of event in which instances of the specialization of #$SomethingExisting OBJ-TYPE are trasnferred.")
(comment ControllingTransferringAndUsingAForFn "(#$ControllingTransferringAndUsingAForFn OBJ-TYPE ROLE) denotes the specialization of #$PurposefulAction-ResourceDrivenWithTransfer in which at least these three subsituations occur in sequence: (#$GainingControlOfFn OBJ-TYPE); (#$GeneralizedTransferOfFn OBJ-TYPE); (#$UsingAForFn OBJ-TYPE ROLE).")
(comment controlTransferAndUseOfFor "(#$controlTransferAndUseOfFor ACT-TYPE OBJ-TYPE ROLE) means that the specialization of #$PurposefulAction-ResourceDrivenWithTransfer ACT-TYPE is the type of event in which instances of the specialization of #$SomethingExisting OBJ-TYPE are controlled and transferred to play ROLE in a further event.")
(comment SinglePassengerTransportationVehicle "The collection of vehicles (self-powered #$TransportationDevices) which are designed to carry a single passenger.  Some #$SinglePassengerTransportationDevices, such as #$SkateBoards and #$MountainBikes, are not specs of this class because they are not self-powered.")
(comment LandTransportationVehicle "A specialization of #$LandTransportationDevice and #$TransportationDevice-Vehicle.  Each instance of #$LandTransportationVehicle is a device which is both self-powered and controlled in some fashion by a user, and is used for transportation across land. Specializations of #$LandTransportationVehicle include the collections #$Automobile, #$Snowmobile, #$Truck, and #$Bus-RoadVehicle, but not collections of non-#$SelfPoweredDevices such as #$Bicycle or #$Skateboard.")
(comment VehicleTypeByIntendedUse "Instances of #$VehicleTypeByIntendedUse are collections of vehicles (#$TransportationDevice-Vehicle), each of which group together vehicle instances which share a common intended use.  For example, #$EarthMovingVehicle and #$EmergencyVehicle are members of this collection.")
(comment VehicleTypeByPathway "Instances of #$VehicleTypeByPathway are collections of vehicles (#$TransportationDevice-Vehicle), each of which group together vehicle instances which are designed to traverse particular types of pathways.  For example, #$LandTransportationVehicle and #$AirTransportationVehicle are members of this collection.")
(comment KEInteractionFolder "Instances of this collection are (abstract) folders which organize pages of content (cf. #$PageTemplate) which should be used to facilitate interactions with a user.")
(comment KEInteractionForm "A specialization of #$Form-AIS, Instances of this collection are abstract forms which organize as series of prompts (c.f. #$FormulaTemplate) for which the user is expected to supply values.")
(comment KEInteractionPage "Instances of this collection are (abstract) pages which organize the content which is to be displayed to a user. Also see #$KEInteractionForm and #$KEInteractionFolder.")
(comment AirTransportationVehicle "A specialization of #$AirTransportationDevice and #$TransportationDevice-Vehicle.  Each instance of #$AirTransportationVehicle is a device which is both self-powered and controlled in some fashion by a user, and is used for transportation through air.  Specializations of #$AirTransportationVehicle include the collections #$Airplane and #$Ultralight, but not collections of non-#$SelfPoweredDevices such as #$Glider.")
(comment DeviceTypeByPowerSource "Instances of #$DeviceTypeByPowerSource are collections of devices (#$PhysicalDevice), each of which group together device instances which operate using the same type of power source.  For example, #$Device-UserPowered, #$NonPoweredDevice, and #$InternalCombustionPoweredDevice are all members of this collection.")
(comment WaterTransportationVehicle "A specialization of #$WaterTransportationDevice and #$TransportationDevice-Vehicle.  Each instance of #$WaterTransportationVehicle is a device which is both self-powered and controlled in some fashion by a user, and is used for transportation on or below the surface of water. Specializations of #$WaterTransportationVehicle include the collections #$CruiseShip and #$Submarine, but not collections of non-#$SelfPoweredDevices such as #$Sailboat or #$Rowboat.")
(comment audienceSizeOfPerformance "(#$audienceSizeOfPerformance EVENT NUM) means that NUM is the number of audience members physically in attendance at the #$EntertainmentEvent EVENT.")
(comment Situation-Localized "A specialization of #$Situation.  Each instance of #$Situation-Localized is a situation whose temporal extent occurs at a specific location in space. Notable specializations of #$Situation-Localized include #$PhysiologicalCondition and #$Event-Localized.")
(comment PhysicalSituation "A specialization of #$Situation-Localized.  Each instance of #$PhysicalSituation is a spatially localized situation involving one or more physical objects or stuffs (see #$situationConstituents).  Important specializations include #$PhysicalEvent and #$AilmentCondition.")
(comment situationLocation "The predicate #$situationLocation relates a particular instance of #$Situation-Localized to the instance of #$EnduringThing-Localized at which it obtains.  <code>(#$situationLocation SITUATION LOCATION)</code> means that the spatial extent of <code>SITUATION</code> is within <code>LOCATION</code>.")
(comment BurntFn "A #$UnaryIntersectionFunction (q.v.) that maps a given type of tangible thing to the collection all burnt things of that type.  (#$BurntFn TYPE) is the specialization of TYPE consisting of all burnt instances of TYPE.  For example, (#$BurntFn #$Toast) is the collection of slices of burnt toast and (#$BurntFn #$Skin) is the collection of regions burnt skin.  Note that if a given instance of TYPE becomes so completely burned that it is no longer an instance of TYPE (but is, say, a portion of ash), then it will _not_ be an instance of (#$BurntFn TYPE).")
(comment ContainerContainingFn "(#$ContainerContainingFn CONTAINER-TYPE CONTAINEE-TYPE) denotes the specialization of #$PartiallyTangible CONTAINER-TYPE, each instance of which contains some instance of CONTAINEE-TYPE (a specialization of #$PartiallyTangible).  For example (#$ContainerContainingFn #$RoadVehicle #$Bomb-RoadVehicleDelivered) denotes the collection of road vehicles that contain bombs. Note that a particular road vehicle is an instance of (#$ContainerContainingFn #$RoadVehicle #$Bomb-RoadVehicleDelivered) if and only if it actually contains a bomb.")
(comment containerTypeIsTypeContainingType "(#$containerTypeIsTypeContainingType TYPE CONTAINER-TYPE CONTAINEE-TYPE) means that TYPE is a specialization of #$PartiallyTangible CONTAINER-TYPE, each instance of which contains some instance of CONTAINEE-TYPE (a specialization of #$PartiallyTangible).")
(comment RoadVehicleArmedWithBomb "#$RoadVehicleArmedWithBomb is a specialization of #$WeaponSystem and #$RoadVehicle.  Each instance of #$RoadVehicleArmedWithBomb is a road vehicle that contains (see #$containerTypeIsTypeContainingType) a bomb designed to detonate within that very road vehicle (see #$Bomb-RoadVehicleDelivered).")
(comment Ozzfest "An annual #$HeavyMetalMusic extravaganza, founded by #$OzzyOsbourne, which takes place across the USA from June to August, drawing huge crowds.")
(comment countyInState "(#$countyInState COUNTY STATE) means that #$County COUNTY is located in the #$State-Geopolitical STATE.")
(comment facetBasedOnTypePredicateArg "A #$TernaryPredicate that is used to state that a special relation holds between a #$FacetingCollectionType and a #$Predicate -- that the former is \"based on\" the latter in a specific way.
<p>
Where <code>(#$facets-Generic COL FACET-COL)</code> and <code>PRED</code> is an n-place predicate, <code>(#$facetBasedOnTypePredicateArg FACET-COL PRED ARG)</code> means that for all <code>X</code> in <code>FACET-COL</code>, there is an ordered n-tuple <<code>Y<sub>1</sub></code>,...,<code>Y<sub>n</sub></code>> such that, by the definition of <code>X</code>, for any specialization <code>Z</code> of <code>COL</code>, the result of replacing <code>Y<sub>ARG</sub></code> with <code>Z</code> in <code>(PRED Y<sub>1</sub>...Y<sub>n</sub>)</code> holds iff <code>Z</code> = <code>X</code>.
<p>
For example, <code>(#$facetBasedOnTypePredicateArg #$OrganizationTypeByActivityType #$characteristicActivityTypeOfOrganizationType 1)</code> means that for all <code>ORG-TYPE</code> in #$OrganizationTypeByActivityType there is an ordered pair <code><DUMMY, ACT-TYPE></code> such that, by the definition of <code>ORG-TYPE</code>, for any specialization <code>SPEC</code> of #$Organization, <code>(#$characteristicActivityTypeOfOrganizationType SPEC ACT-TYPE)</code> holds iff <code>SPEC = ORG-TYPE</code>.
<p>
Note that it is also true that <code>(#$facetBasedOnTypePredicateArg #$OrganizationTypeByActivityType #$equals 1)</code> and <code>(#$facetBasedOnTypePredicateArg #$OrganizationTypeByActivityType #$equals 2)</code>.  Indeed, <code>(#$facetBasedOnTypePredicateArg FACET-COL #$equals 1)</code> and <code>(#$facetBasedOnTypePredicateArg FACET-COL #$equals 2)</code> are trivially true for any <code>FACET-COL</code>, since the following is a logical truth:
<pre>
(#$forAll ?X
  (#$thereExists ?Y
    (#$forAll ?Z
      (#$equiv
        (#$equals ?Z ?Y)
        (#$equals ?Z ?X))))).
</pre>
For precisely this reason, there is no point in asserting that a facet is based on #$equals.
<p>
For the very common special case in which <code>PRED</code> is a #$BinaryPredicate, see #$facetBasedOnTypeBinaryPred and #$facetBasedOnTypeBinaryPredInverse.  See also #$facetBasedOnPredicateArg and #$SharedNoteOnFacetBasisPredicates.")
(comment GroupingOfFn "A #$ReifiableFunction used to denote collections of events in which objects of a certain type are gathered together. (#$GroupingOfFn OBJ-TYPE) is the specialization of #$GroupingObjects where the objects grouped are all of type OBJ-TYPE. The result of such an event taking place will be a group of type (#$GroupFn OBJ-TYPE).")
(comment groupingOfPred "The corresponding predicate of #$GroupingOfFn, which relates an #$ExistingObjectType to the collection of events in which objects of that type are gathered together.")
(comment UnitOfKinematicViscosity "Units of measure used for measuring kinematic viscosity of a substance (the ratio of absolute viscosity to density).  See also #$UnitOfAbsoluteViscosity.")
(comment kinematicViscosityOfTypeAtTemperature "(#$kinematicViscosityOfTypeAtTemperature STUFF-TYPE VISCOSITY TEMPERATURE) says that for any instance INS of STUFF-TYPE such that (#$temperatureOfObject INS TEMPERATURE), (#$kinematicViscosityOfSubstance INS VISCOSITY) holds.  See also #$UnitOfKinematicViscosity.")
(comment absoluteViscosityOfTypeAtTemperature "(#$absoluteViscosityOfTypeAtTemperature STUFF-TYPE VISCOSITY TEMPERATURE) says that for any instance INS of STUFF-TYPE such that (#$temperatureOfObject INS TEMPERATURE), (#$viscosityOfSubstance INS VISCOSITY) holds.  See also #$UnitOfAbsoluteViscosity.")
(comment RoadVehicleArmedWithBombFn "(#$RoadVehicleArmedWithBombFn VEHICLE-TYPE) denotes the specialization of #$RoadVehicleArmedWithBomb that is also a specialization of the subcollection of #$RoadVehicle, VEHICLE-TYPE.  For example, (#$RoadVehicleArmedWithBombFn #$FireTruck) denotes the collection of fire trucks armed with bombs.")
(comment JoiningOrganizationTypeFn "A #$ReifiableFunction used to denote collections of events in which someone joins a certain type of organization. (#$JoiningOrganizationTypeFn ORG-TYPE) is the specialization of #$OrganizationalTransferIn where someone joins an #$Organization of type ORG-TYPE. For denoting the collection of events where someone joins a particular individual organization, see #$JoiningFn.")
(comment airportHasIATACode "(#$airportHasIATACode AIRPORT STRING) means that the instance
of #$Airport-Physical is designated by the IATA with the three letter #$CharacterString STRING.")
(comment joiningOrgTypePred "The corresponding predicate of #$JoiningOrganizationTypeFn, which relates an #$OrganizationType to the collection of events in which organizations of that type are joined by someone.")
(comment brokersProductType "(#$brokersProductType AGT PROD-TYPE) means that AGENT brokers PRODTYPE. For example, EBay brokers many types of object, including electronics. The implication is AGENT typically and often brokers products of PRODTYPE.")
(comment Gluing "A specialization of #$ConnectingTogether.  Each instance of #$Gluing is an event in which two (or more) solid objects are connected together with some portion of #$Glue.")
(comment TypeAvailableFromExpansion "#$TypeAvailableFromExpansion is an instance of #$ScenGenExpansionSpecification.  It licenses hypothesizing
<p>
(#$thereExists TRANSFER
(#$and
(#$isa TRANSFER #$GeneralizedTransfer)
(#$from-Generic TRANSFER SOURCE)
((#$BinaryRoleTypePredFn #$transferredThing) TRANSFER OBJ-TYPE)))
<p>
whenever (1) EVENT is an instance of ACT-TYPE, (2) ACT-TYPE is the sort of act in which control of instances of OBJ-TYPE is obtained, and (3) instances of OBJ-TYPE are available from SOURCE.")
(comment JoiningFn "A #$ReifiableFunction used to denote collections of events in which someone joins a certain particular organization. (#$JoiningFn ORG) is the specialization of #$OrganizationalTransferIn where someone joins the #$Organization ORG. For denoting collections of events in which someone joins an organization of a certain type, see #$JoiningOrganizationTypeFn.")
(comment joiningOrgPred "The corresponding predicate of #$JoiningFn, which relates a particular #$Organization to the collection of events in which it is joined by someone.")
(comment Calling911 "Instances of #$Calling911 are events in which a person reports an emergency and makes a request for the presence of emergency response personnel by calling a local #$EmergencyDispatchService.")
(comment FostersSitTypeSitTypeDoubleExpansion "<p>")
(comment FostersSitTypeSitTypeExpansion "<p>")
(comment PotentialBiologicalThreat-BBNEntityType "A collection which subsumes both BiologicallyHarmfulSubstance and #$BiologicalWeapon.")
(comment PotentialExplosiveThreat-BBNEntityType "A collection which subsumes both #$ExplosiveMaterial and #$ExplosiveDevice.")
(comment AttackTypeByWeaponSystemType "#$AttackTypeByWeaponSystemType is a specialization of #$AttackType.  Each instance of  #$AttackTypeByWeaponSystemType is a collection of attacks, each instance of which is executed with a weapon system of a certain type (e.g., one instance of #$AttackTypeByWeaponSystemType is the collection of attacks executed with battleships, another is the collection of attacks executed with tanks, etc.).")
(comment AttackTypeByWeaponSystemTypeFn "A function used to return collections that are facets of #$AttackOnTangible, where the faceting is by weapon system used in the attack.  I.e., (#$AttackTypeByWeaponSystemTypeFn WEAPON-SYSTEM-TYPE) returns the collection of all instances of #$AttackOnTangible wherein the #$deviceUsed is an instance of WEAPON-SYSTEM-TYPE.  Thus (#$AttackTypeByWeaponSystemTypeFn #$Battleship) denotes the specialization of #$AttackOnTangible instances of which involve attacks using battleships.")
(comment EmergencyDispatcher "Each instance of #$EmergencyDispatcher is a person who, while on duty, answers calls for emergency assistance (such as those that come in on a 911 line), tries to get the important information from the person who is reporting the emergency, and then notifies the appropriate #$EmergencyServicesOrganization(s), who will then go to the location of the emergency to provide aid.")
(comment EmergencyServicesOrganization "Each instance of #$EmergencyServicesOrganization is an organization whose main function is to respond to instances of #$Emergency.  Some more specialized types of #$EmergencyServicesOrganization include #$FireDepartment, #$EmergencyMedicalServicesOrganization, and #$PoliceOrganization.")
(comment FireDepartment "Each instance of #$FireDepartment is an organization that is usually part of and funded by a local city or county government. A #$FireDepartment employs many #$Firefighters, resides in a #$FireStation, owns or leases and uses a few #$FireTrucks, and has the responsibility of responding to instances of #$FireEmergency to attempt to extinguish the fire and rescue and/or aid people who might be hurt.")
(comment EmergencyMedicalServicesOrganization "Each instance of #$EmergencyMedicalServicesOrganization is an organization that is usually part of and funded by a local city or county government. An #$EmergencyMedicalServicesOrganization employs many #$EmergencyMedicalTechnicians, owns or leases and operates a few #$Ambulances, and has the responsibility of responding to instances of #$MedicalEmergency.")
(comment EmergencyDispatchService "Each instance of #$EmergencyDispatchService is an organization whose role is to accept calls for emergency assistance and to route the request to the #$EmergencyServicesOrganization(s) best suited to provide aid for the particular emergency.  An #$EmergencyDispatchService's phone number is usually 911, and they employ many #$EmergencyDispatchers.")
(comment FireEmergency "Instances of #$FireEmergency involve a fire which is threatening human life or property.")
(comment EmergencyResponse "Each instance of #$EmergencyResponse involves an #$EmergencyServicesOrganization going to the location of an #$Emergency and rendering aid.  This might involve putting out a fire, giving medical care, rescuing someone, or neutralizing a threat such as a bomb or a person who is threatening to hurt people.")
(comment EmergencyFireResponse "Each instance of #$EmergencyFireResponse involves a #$FireDepartment sending a #$FireTruck to the location of a #$FireEmergency and rendering aid.  This might involve putting out a fire, giving medical care, or rescuing someone.")
(comment Miosis "A specialization of #$AilmentCondition.  Instances are conditions in which the pupil is excessively contracted.")
(comment MioticSubstance "A specialization of #$BiochemicallyHarmfulSubstance.  Instances are samples of substances, exposure to which can cause #$Miosis.")
(comment EmergencyCall-Script "Each instance of #$EmergencyCall-Script is a complex script in which a report of an #$Emergency is made to an #$EmergencyDispatchService, and the appropriate emergency response team goes to the location of the emergency to assess the situation and provide aid.")
(comment EmergencyCallTypeForEmergencyTypeFn "(#$EmergencyCallTypeForEmergencyTypeFn EMERG-TYPE) denotes the collection of events in which a person calls an #$EmergencyDispatchService to report, and ask for assistance with, an #$Emergency of type EMERG-TYPE, and the appropriate emergency team is sent to the location of the emergency to give aid.")
(comment PersuadingToPerformTerroristAct "A specialization of #$PersuadingToAct. Each instance of this collection is a #$CommunicationAct-Single in which the performer successfully induces the recipient to perform some terrorist activity.")
(comment emergencyCallTypeForEmergencyType "(#$emergencyCallTypeForEmergencyType CALL-TYPE EMERG-TYPE) states that emergency calls of type CALL-TYPE are events in which a person reports, and ask for assistance with, an emergency of type EMERG-TYPE.")
(comment Vapor "A specialization of #$Gaseous-StateOfMatter. Each instance of #$Vapor is a tangible thing in a gaseous state, and is an instance of a type of substance whose instances are in either a solid or liquid form under ordinary conditions.")
(comment worksAtFacility "A #$CoexistingObjectsPredicate and specialization of #$usualLocationOfObject. <code>(#$worksAtFacility PERSON FAC)</code> means that <code>PERSON</code> normally works at <code>FAC</code>, some instance of #$Facility-Generic.")
(comment EmergencyAssessment "The collection of actions performed by emergency response personnel when arriving at the location of an #$Emergency.  Steps include becoming aware of any hazards, such as fire or fumes or dangerous people, noting the number and status of victims, and determining whether other skills may be needed on site.")
(comment vaporDensityOfTypeAtTemperatureToType "(#$vaporDensityOfTypeAtTemperatureToType SUBSTANCE1 RATIO
TEMPERATURE SUBSTANCE2) is a relation that expresses the ratio of
vapor density RATIO for the substance SUBSTANCE1 when compared to an
equal volume of SUBSTANCE2 (typically either #$Air or
(#$ChemicalSubstanceFn #$H2Molecule)), where SUBSTANCE2 = 1.  Thus, if
the RATIO is greater than 1, SUBSTANCE1 is heavier than SUBSTANCE2,
and if RATIO is less than 1, then SUBSTANCE1 is lighter than
SUBSTANCE2.  This predicate assumes standard pressure.  WHen the
temperature is not explicitly stated in the source, it is assumed to
be standard temperature, which is (#$DegreeCelsius 0).")
(comment ViralGastroenteritis "A kind of #$ViralInfection that causes inflamation of the stomach and intestines.")
(comment Rotavirus "A wheel-shaped #$VirusType that can cause #$ViralGastroenteritis.")
(comment ScriptCursive "a cursive style of writing languages using Roman or Cyrillic letters")
(comment Tsao-ShuCursive "a cursive style of writing Chinese characters")
(comment MajusculeCursive "a cursive style of ancient Roman writing")
(comment MinisculeCursive "a cursive style of ancient Roman writing")
(comment MahajaniCursive "a cursive style of writing #$DevanagariCharacters")
(comment HieraticCursive "a cursive style of writing Ancient Egyptian hieroglyphics ")
(comment DemoticCursive "The collection of instances of TextualMaterial which exhibit the 
cursive writing style Demotic Cursive")
(comment interSubSituationTypeRelation "(#$interSubSituationTypeRelation SITTYPE RELATION SUBSITTYPE1 SUBSITTYPE2) means that in any instance of SITTYPE the sub-situation of type SUBSITTYPE1 will be related to the sub-situation of type SUBSITTYPE2 by RELATION.")
(comment releasesBCWAgent "This is a #$ComplexActionPredicate which relates actors in a #$ReleaseOfBiochemicallyHarmfulSubstance event. In particular, it relates the #$objectEmitted to the thing (#$Agent-Generic) which released it at the time of release.")
(comment ControllingACrowdOfPeople "The collection of all instances of #$ControllingSomething where ther #$objectControlled is a #$CrowdOfPeople.  I.e., 'crowd control.'")
(comment ComputerNetworkTypeByVulnerability "A collection of collections.  Each instance of #$ComputerNetworkTypeByVulnerability is a collection of computer networks that have a certain vulnerability.")
(comment ComputerTypeByVulnerability "A collection of collections.  Each instance of #$ComputerTypeByVulnerability is a collection of computer programs that have a certain vulnerability.")
(disjointWith ComputerTypeByBrand ComputerTypeByVulnerability)
(comment SoftwareObjectTypeByFault "A collection of collections.  Each instance of #$SoftwareObjectTypeByFault is a collection of software objects that have a certain fault.")
(comment ComputerTypeByVulnerability-Local "A collection of collections.  Each instance of #$ComputerTypeByVulnerability is a collection of computer programs that have a certain vulnerability.")
(comment ComputerTypeByVulnerability-Remote "A collection of collections.  Each instance of #$ComputerTypeByVulnerability is a collection of computer programs that have a certain vulnerability.")
(comment ComputerTypeByVulnerability-Systemwide "A collection of collections.  Each instance of #$ComputerTypeByVulnerability is a collection of computer programs that have a certain vulnerability.")
(comment SubLQuoteFn "<code>(#$SubLQuoteFn SUBL-EXPRESSION)</code> is one of exactly two escapes to SubL from CycL, the other being #$ExpandSubLFn.  These are the only two ways to represent arbitrary SubL in CycL.  #$SubLQuoteFn encapsulates <code>SUBL-EXPRESSION</code> such that it will not be rejected by the CycL wff-checker as ill-formed CycL.  For example, <code>(#$SubLQuoteFn (+ 1 2))</code>, which <i>is</i> a #$CycLExpression, denotes the #$SubLSExpression (+ 1 2), which itself is <i>not</i> a #$CycLExpression.")
(comment ANFO "A specialization of #$HighExplosive.  ANFO was used in the Oklahoma City bombing.")
(comment Vaporization "A specialization of #$StateOfMatterChangeEvent.  Each
instance of #$Vaporization is an event in which a liquid or solid
transforms into its gaseous state.  Important specializations include
#$Aerosolizing, #$Evaporating, and #$Boiling.  The latter two rely on heat
to catalyze the reaction, and the former uses pressure.")
(comment heatOfVaporization "(#$heatOfVaporization SUBSTANCE AMOUNT) expresses a relation
that holds between an instance of
#$ChemicalSubstanceType and an amount of heat,
typically expressed in (PerFn GramCalorie Gram). This is the AMOUNT of
heat required to convert instances of SUBSTANCE from the liquid or
solid state to its gaseous state, with no change in temperature, after
its #$boilingPoint is reached.  For example, (heatOfVaporization
AceticAcid ((PerFn GramCalorie Gram) 96.7)) means that *after* a sample of
#$AceticAcid has reached its boiling point of (DegreeCelsius 117), ((PerFn GramCalorie Gram) 96.7) are required to convert the sample from
the liquid to gaseous state and this energy is absorbed by the
conversion process, and additional heat would increase
the temperature of the sample.")
(comment BinarySituationPredicate "This is the collection of #$BinaryPredicates that relate a #$Situation, as their first arguments, to an instance of #$Thing, as their second arguments.  Note that this means that any #$BinaryPredicate relating a temporal situation to anything at all, whether involved in the situation or not, is an instance of this collection. Thus, this is the broadest #$PredicateType for binary predicates whose first arguments are temporal situations.")
(comment DysfunctionalCondition "This is the collection of #$SystemConditions which are dysfunctional for the system they affect.  An dysfunctional condition is one which impairs the functioning of the system.  For example, the function of an artery is to allow blood to flow to a part of the body, so that a blockage of the artery will constitute an abnormal condition of the artery to the extent that it reduces the flow of blood to that part of the body.")
(comment ExclusiveUserRights "A collection of instances of #$Situation-.  Each instance of this collection is a situation that consists of an agent having an exclusive right to some object.  Consider the exclusive user rights I enjoy with respect to my car.  This is a particular instance of #$Situation.  It started when I bought the car and ends when I sell it or otherwise transfer ownership.  That situation is an instance of this collection and this collection represents the kind of user right an agent has to an object when they have the sole right to use that object. There can be only one such #$Agent-Generic at a given time; that agent may be an #$Organization or an individual person. When you rent a car, you expect #$ExclusiveUserRights of it for the duration of your rental, even though you don't own the car.")
(comment VulnerableObjectType "A collection of collections.  Each instance of #$VulnerableObjectType is a collection of objects that are vulnerable to threats.")
(comment wffViolation "(#$wffViolation ILL-FORMED-CYCL CYCL-REASON) states that the SubL expression ILL-FORMED-CYCL is not well formed in CycL because of the reason(s) expressed by CYCL-REASON.")
(comment wffRepair "(#$wffRepair ILL-FORMED-CYCL SUGGESTED-CYCL-REPAIR) states that the SubL expression ILL-FORMED-CYCL will become well-formed CycL if SUGGESTED-CYCL-REPAIR becomes true, e.g. is caused to become true by the user.")
(comment FunctionTypeByRangeType "A collection of collections that is a specialization of #$FunctionType.  Each instance of #$FunctionTypeByRangeType is a collection of #$Function-Denotationals such that each of its instances always returns as value (see #$resultIsa) something of the same (typically very general) type.  For example, #$IndividualDenotingFunction is an instance of #$FunctionTypeByRangeType; each instance of the former is a function that maps any (sequence of) argument(s) for which it is defined to some #$Individual.  Other instances of #$FunctionTypeByRangeType are #$CollectionDenotingFunction, #$FunctionDenotingFunction, and #$PredicateDenotingFunction.")
(comment DangerousThing "A specialization of #$Individual. Each instance of #$DangerousThing poses danger to either just humans or organisms in general. Important specializations include #$DangerousTangibleThing and #$DangerousSituation.")
(comment HazardousThingType "A specialization of #$Collection. Instances of #$HazardousThingType are collections whose instances pose some danger to just humans or organisms in general.  How \"hazard\" is defined is context dependent, of course, and this collection has many potential facets including driving hazards, #$HazardousChemicalSubstanceType, occupational hazards, etc.")
(comment HazardousChemicalSubstanceType "A specialization of #$HazardousThingType and #$HazardousChemicalType.  Each instance of #$HazardousChemicalSubstanceType is a collection of chemical substances whose instances are hazardous to humans.  These materials require certain precautions when being handled to lower the risk of exposure or in the case of explosive materials, lower the risk of combustion.  Note: each instance of this collection must be an instance of #$ChemicalSubstanceType.")
(comment PercutaneousToxinType "A specialization of #$HazardousChemicalSubstanceType. Each instance of #$PercutaneousToxinType is a collection whose instances have #$contactToxicityFor #$Persons.")
(comment InhalationalToxinType "A specialization of #$HazardousThingType.  Each instance of
#$InhalationalToxinType is a collection whose instances are toxic when
inhaled by #$Persons.")
(comment precautionTypeAgainstType "(#$precautionTypeAgainstType PRECAUTION COLLECTION) relates on
instance of #$FirstOrderCollection COLLECTION to an #$Event PRECAUTION
that is a precaution against the possible harmful effects of
COLLECTION.")
(comment N-ButylAcetate "An instance of #$ChemicalCompoundTypeByChemicalSpecies.
Each instance of #$N-ButylAcetate is a sample of the compound
CH3COOCH2CH2CH2CH2.")
(comment transporterHijacked "An instance of #$ActorSlot and a specialization of
#$objectActedOn. Each #$Hijacking has exactly one associated
#$SolidTangibleThing that plays the role of #$transporterHijacked in
the #$Hijacking. ")
(comment tripHijacked "An instance of #$ActorSlot and a specialization of
temporallyIntersects.  (tripHijacked HIJACKING TRANSPORTATION-EVENT)
means that HIJACKING is an event in which, during
TRANSPORTATION-EVENT, hijackers wrest control of and subsequently
control the #$SolidTangibleThing that plays the role of #$transporter
in TRANSPORTATION-EVENT.")
(comment WrestingControlOfAPlane "An instance of #$TemporalObjectType and a specialization of #$WrestingControlOfATransporter. Each instance of #$WrestingControlOfAPlane is an instance of #$WrestingControlOfATransporter in which the #$objectOfControlTransfer is an instance of #$Airplane.")
(comment HijackerControllingAPlane "An instance of #$TemporalObjectType and a specialization of
#$HijackerControllingATransporter. Each instance of
#$HijackerControllingAPlane is an instance of
#$HijackerControllingATransporter in which the #$objectControlled
is an instance of #$Airplane.")
(comment AirplaneHijacking "A specialization #$Hijacking. Each instance of #$AirplaneHijacking is an instance of #$Hijacking in which the #$transporterHijacked is an #$Airplane.")
(comment airplaneTripHijacked "An instance of #$ActorSlot and a specialization of
#$tripHijacked.  (AirplaneTripHijacked HIJACKING TRIP)
means that HIJACKING is an event in which, during
TRIP, hijackers wrest control of and subsequently
control the #$Airplane that plays the role of #$transporter
in TRIP.")
(comment PreparingForUnauthorizedEntryToCockpit "An instance of #$TemporalObjectType and a specialization of
#$PurposefulAction.  Each instance of
#$PreparingForUnauthorizedEntryToCockpit is an event in which agents
perform actions that they believe will enable them to gain
unauthorized entry to an #$AirplaneCockpit.")
(comment PreparingForUnauthorizedEntryToCockpit-Deception "An instance of #$TemporalObjectType and a specialization of
#$PreparingForUnauthorizedEntryToCockpit. Each instance of
#$PreparingForUnauthorizedEntryToCockpit-Deception is an event in
which agents use deception in order to enable them to gain entry to an
#$AirplaneCockpit (for example by luring a cockpit occupant out of the
cockpit by feining some kind of emergency).")
(comment PreparingForUnauthorizedEntryToCockpit-Coercion "An instance of #$TemporalObjectType and a specialization of
#$PreparingForUnauthorizedEntryToCockpit. Each instance of
#$PreparingForUnauthorizedEntryToCockpit-Coercion is an event in which
agents use coercion in order to enable them to gain entry to an
#$AirplaneCockpit.")
(comment PreparingForUnauthorizedEntryToCockpit-Destruction "An instance of #$TemporalObjectType and a specialization of
#$PreparingForUnauthorizedEntryToCockpit. Each instance of
#$PreparingForUnauthorizedEntryToCockpit-Destruction is an event in
which agents destroy some part of a door in order to enable them to
gain entry to an #$AirplaneCockpit.")
(comment FixingAndIsolatingAgents "An instance of #$TemporalObjectType and a specialization of
#$Interfering.  Each instance of #$FixingAndIsolatingAgents is an
event in which one or more intelligent agents interferes with all
attempts by one or more other intelligent agents to either communicate
or go somewhere, and the interference prevents the success of at least
some of the attempts.")
(comment FixingAndIsolatingOccupants "An instance of #$TemporalObjectType and a specialization of
#$FixingAndIsolatingAgents. Each instance of
#$FixingAndIsolatingOccupants has as #$malficiaries one or more
occupants of a #$HumanOccupationConstruct, which plays the role of
#$locationOfMaleficiaries in the event.")
(comment locationOfMaleficiaries "An instance of #$ActorSlot and a specialization of
#$eventPartiallyOccursAt. (#$locationOfMaleficiaries EVENT PLACE)
means that one or more of the #$SentientAnimals spatially contained by
(see #$spatiallyContains) PLACE are the #$maleficiaries of EVENT.")
(comment FixingAndIsolatingCockpitOccupants "An instance of #$TemporalObjectType and a specialization of
#$FixingAndIsolatingAgents. Each instance of
#$FixingAndIsolatingCockpitOccupants is an event in which the
#$locationOfMaleficiaries is an #$AirplaneCockpit.")
(comment FixingAndIsolatingCabinOccupants "An instance of TemporalObjectType and a specialization of
#$FixingAndIsolatingAgents. Each instance of
FixingAndIsolatingCabinOccupants is an event in which the
#$locationOfMaleficiaries is an #$AirplaneCabin.")
(comment EnteringCockpit "An instance of TemporalObjectType and a specialization of
EnteringAContainer. Instances of #$EnteringCockpit are events in which 
one or more agents enter an #$AirplaneCockpit.")
(comment DisablingATransponder "An instance of #$TemporalObjectType and a specialization
of #$DisablingACommunicationDevice.")
(comment WrestingControlOfAPlaneThroughCockpitEntry "An instance of #$ScriptedEventType and a specialization of
#$WrestingControlOfAPlane.  Each instance of
#$WrestingControlOfAPlaneThroughCockpitEntry is an event in which one or more agents
take control of an #$Airplane by entering the #$AirplaneCockpit.")
(comment NonSkolemIndeterminateTerm "A specialization of #$IndeterminateTerm (the collection of all CycL symbols used to denote some \"indeterminate object\" in the universe of discourse which is known or assumed to exist, although its precise identity is unknown). Each instance of this collection is an #$IndeterminateTerm which is not a #$SkolemTerm.")
(disjointWith SkolemTerm NonSkolemIndeterminateTerm)
(comment SpringVibration "A specialization of #$Vibration-Translational characterized
by a relatively massive object moving back and forth on the end of
a relatively massless spring. This vibrating motion is usually initiated
by influence of some externally applied force on the massive object.")
(comment WrestingControlOfATransporter "An instance of #$TemporalObjectType and a specialization of #$TransferOfControl.  Each instance of #$WrestingControlOfATransporter is an event in which one or more agents take control, without the free consent of the heretofore controlling agent, of a #$SolidTangibleThing that is playing the role of #$transporter in some #$TransportationEvent. This #$SolidTangibleThing plays the role of #$objectOfControlTransfer in the #$WrestingControlOfATransporter event.")
(comment hijackerPerpetrator "An instance of #$AgentiveRole and a specialzation of
#$perpetrator. (hijackerPerpetrator HIJACKING HIJACKER) means
that HIJACKER is a perpetrator of HIJACKING.")
(disjointWith HighAmountOfBioDeteriorationResistance LowAmountOfBioDeteriorationResistance)
(disjointWith HighAmountOfBioDeteriorationResistance VeryHighAmountOfBioDeteriorationResistance)
(disjointWith LowAmountOfBioDeteriorationResistance VeryHighAmountOfBioDeteriorationResistance)
(disjointWith VeryHighAmountOfBioDeteriorationResistance MediumAmountOfBioDeteriorationResistance)
(disjointWith HighAmountOfBioDeteriorationResistance MediumAmountOfBioDeteriorationResistance)
(disjointWith LowAmountOfBioDeteriorationResistance MediumAmountOfBioDeteriorationResistance)
(comment Poisoning-Script "A #$ScriptedEventType.  #$Poisoning-Script is the
collection of #$PhysicalEvents in which some
#$Organism-Whole is poisoned.  This event type 
must not be confused with #$Poisoning.  
#$Poisoning is a specification of #$AilmentCondition
and is a _scene_ in #$Poisoning-Script.  See the 
#$comment on #$Poisoning.")
(comment Tritonal "A specialization of #$HighExplosive.   Tritinol contains 80% #$Trinitrotoluene and 20% #$Aluminum.")
(comment ExplosiveDesensitizerMaterialType "A collection of collections and a specialization of #$TangibleStuffCompositionType.  Each instance of #$ExplosiveDesensitizerMaterialType is a specialization of #$PartiallyTangible instances of which are used as desensitizing constituents of explosive compounds.")
(comment CompositionC "A specialization of #$HighExplosive.  Composition C is a plastic demolition explosive consisting of #$RDXExplosive, other explosives, and #$Plasticizers. It can be molded by hand for use in demolition work and packed by hand into shaped charge devices. Although #$CompositionC3 and #$CompositionC4 are the only formulations presently being used, C-1 and C-2 may still be encountered.")
(comment CompositionC3 "A specialization of #$HighExplosive.  Each instance of #$CompositionC3 is a high quality, very high velocity military plastic explosive.")
(comment PETN "#$PETN is a specialization of #$HighExplosive. PETN (Pentaerythritol Tetranitrate) is one of the strongest known high explosives. It is relatively sensitive to shock or friction and it is never used alone as a booster. It is primarily used in booster and bursting charges of small caliber ammunition, in upper charges of detonators in some land mines and shells, and as the explosive core of primacord.")
(comment HNSExplosive "A specialization of #$HighExplosive.  HNS (hexanitrostilbene) is a powerful explosive.")
(comment TATB "#$TATB is a specialization of #$HighExplosive. TATB (triaminotrinitrobenzene) is a very insensitive high explosive.  Its high degree of insensitivity makes it suitable for use in modern nuclear warheads.")
(comment TATP "#$TATP is a specialization of #$HighExplosive. TATP (triacetonetriperoxide) is a very unstable explosive that can be made in a basic lab by someone with a college degree in chemistry.  It is the explosive that was contained in the shoe of the \"shoe bomber\", Richard Reid.  In the literature is is commonly referred to as \"acetone peroxide\" because it is typically a mixture of isomers. Other literature refers to it as \"tricycloacetoneperoxide,\" \"triacetonetriperoxide\", \"TATP\", \"AP\", \"TCAP\", and \"3,3,6,6,9,9-hexamethyl-1,2,4,5,7,8-hexoxonane\".")
(comment explosiveVelocityOfType "A #$QuantitySlot for indicating the velocity that a given #$ExplosiveMaterial's detonation wave has, relative to the standard density of the substance when used as an explosive.")
(comment ShockWave "A specialization of #$WavePropagation. Each instance of #$ShockWave is a thin front through which there exists a sudden change in all flow properties (including pressure, temperature, density, and velocity).  Shock waves are created by (among other things) detonating explosives (see #$Detonation and #$DetonationWave), lightning, and supersonic jets.")
(comment DetonationWave "A specialization of #$ShockWave. Each instance of #$DetonationWave is a shock wave in a reacting (explosive) material where the chemical reaction is carried out in the shock front.")
(comment velocityOfWave "(#$velocityOfWave WAVE RATE) means the speed of WAVE is RATE.")
(comment propagationMediumType "(#$propagationMediumType WAVE MEDIUM) means that #$WavePropagation WAVE is propagated through the instance of #$ExistingStuffType, MEDIUM.")
(comment AmmoniumPicrate "A specialization of #$HighExplosive.  Ammonium picrate was patented by Alfred Nobel in 1888 for dynamites.  It is relatively stable and has seen broad military use.")
(comment EthylEther "#$EthylEther is an instance of #$ChemicalCompoundTypeByChemicalSpecies.  Each instance of #$EthylEther is a chemical substance with the formula C2H5OC2H5.  Also known as \"anhydrous ether\", \"diethyl oxide\" and \"anesthetic ether\".")
(comment GuanidineNitrate "A specialization of #$HighExplosive. Guanidine nitrate is an explosive compound in its own right, as well as a precursor to other explosives such as #$Nitroguanidine.")
(comment Paraformaldehyde "#$Paraformaldehyde is an instance of #$ChemicalCompoundTypeByChemicalSpecies.  Paraformaldehyde is (under normal physical conditions) a white, crystalline powder with the odor of formaldehyde.  It has a history of being use as a fumigant for more to decontaminate laboratory facilities and to disinfect sickrooms, clothing, linen, and sickroom utensils. When heated, paraformaldehyde releases formaldehyde gas, which may be used as a decontaminant. Paraformaldehyde is also used in dentistry and in the manufacture of synthetic resins and artificial ivory.")
(comment Formaldehyde "#$Formaldehyde is colorless gas at normal conditions, and has a pungent, irritating odor. Formaldehyde is a very common industrial and commercial chemical.")
(comment AceticAnhydride "#$AceticAnhydride is an instance of #$ChemicalCompoundTypeByChemicalSpecies.   It is a clear, colorless liquid with a very pungent, penetrating, vinegar-like odor that combines with water to form acetic acid (see #$AceticAcid). Acetic anhydride is used in the manufacture of cellulose acetate having the application as a base for magnetic tape and in the manufacture of textile fibers. Also, it is heated with salicylic acid to produce acetylsalicylic acid (aspirin). It is also used in the manufacture of pigments, dyes, cellulose and pesticides etc.")
(comment Pentaerythritol "#$Pentaerythritol is an instance of #$ChemicalCompoundTypeByChemicalSpecies.  #$Pentaerythritol is a chemical precursor of #$PETN.")
(comment Methenamine "#$Methenamine is an instance of #$ChemicalCompoundTypeByChemicalSpecies.  It is is a chemical precursor of #$RDXExplosive.")
(comment LeadAzide "A specialization of #$InorganicCompound and #$HighExplosive.")
(comment Tetryl "A specialization of #$HighExplosive that is typically used as a primary detonator.")
(comment BiologicalSex "The collection of all sexes a plant or animal might have. This is 
entirely determined by physiological characteristics, whether by 
the presence of particular reproductive organs or playing a certain role
in sexual reproduction.")
(comment Hermaphrodite "Any plant or animal possessing both male and female reproductive organs,
as well as secondary sexual characteristics and functions.")
(comment Female "BLOs having or being female sex organs or secondary female sexual characteristics and performing female sexual functions, such as receiving pollen or bearing young.")
(comment Male "#$BiologicalLivingObjects having male sex organs and performing male sexual 
functions, such as fertilizing ova.")
(comment hasBiologicalSex "(#$hasBiologicalSex LIVING-THING SEX) means that the plant or animal 
LIVING-THING has a particular biological sex, SEX.  This is entirely 
determined by physiological characteristics, whether by the presence
of particular reproductive organs or playing a certain role in sexual 
reproduction.")
(comment ObjectTypeByGender "Characteristics of objects based on stereotypical appeal or often
attributed to them based on what sex they best befit.")
(comment MasculineObject "Having characteristics stereotypically appealing to, attributed to,
or befitting men.  This concept is culture-relative, since what
things are considered masculine and feminine vary somewhat from culture
to culture.")
(comment FeminineObject "Having characteristics stereotypically appealing to, attributed to,
or befitting women.  This concept is culture-relative, since what things
are considered masculine and feminine vary somewhat from culture to 
culture.")
(comment genderOfObject "(#$genderOfObject OBJ GENDER) means that OBJ has characteristics stereotypically appealing to, attributed to, or befitting a particular gender, GENDER.  This concept is culture-relative, since what things are considered masculine, feminine, and neuter vary somewhat from culture to culture.  For this reason, be sure to make #$genderOfObject assertions in a culture-specific microtheory.")
(comment NeuterObject "Neither having characteristics stereotypically appealing to, attributed to,
or befitting women, nor men.  This concept is culture-relative, since what
things are considered masculine and feminine vary somewhat from culture
to culture.")
(comment genderOfPerson "(#$genderOfPerson PERSON GENDER) means that PERSON has characteristics stereotypically attributed to, or befitting a particular gender, GENDER.  This concept is culture-relative, since what things are considered masculine, feminine, and neuter vary somewhat from culture to culture.  For this reason, be sure to make #$genderOfObject assertions in a culture-specific microtheory.")
(comment MercuryFulminate "#$MercuryFulminate is a specialization of #$HighExplosive. It is typically used as a primary detonator.")
(comment LeadStyphnate "#$LeadStyphnate is a specialization of #$HighExplosive. It is typically used as a primary detonator.")
(comment MannitolHexanitrate "#$MannitolHexanitrate is a specialization of #$HighExplosive. It is typically used as a primary detonator.")
(comment PrimaryDetonatorExplosiveType "A specialization of #$ExplosiveMaterialTypeByChemicalSubstance. Each instance of #$PrimaryDetonatorExplosiveType is a kind of explosive substance whose instances are typically used as the primary detonators in #$ExplosiveDevices.  These explosives are very sensitive and require a relatively small quantity of energy to initiate their explosive decomposition.  Primary detonators are typically used in to initiate the detonation of secondary explosives (see #$SecondaryDetonatorExplosiveType). Some of the most widely used primary explosives include #$Tetryl, #$LeadAzide, #$MercuryFulminate, #$LeadStyphnate, and  #$MannitolHexanitrate.")
(comment Tetracene "A specialization of #$HighExplosive that is typically used as a primary detonator.")
(comment SecondaryDetonatorExplosiveType "A specialization of #$ExplosiveMaterialTypeByChemicalSubstance. Each instance of #$SecondaryDetonatorExplosiveType is a kind of explosive substance whose instances are typically used as the secondary detonator in #$ExplosiveDevices.  These explosives are very insensitive.  For these substances, a relatively large quantity of energy is required in order to initiate the explosive reaction.  They have much more power than primary explosives (see #$PrimaryDetonatorExplosiveType).  They require a detonator to explode. Explosives typically used as secondary detonators include #$Dynamite, #$Trinitrotoluene, #$RDXExplosive, #$PETN, #$HMXExplosive, and #$PicricAcid.")
(comment evaporationRate "(#$evaporationRate SUBSTANCE RATE) relates an instance of
#$ChemicalSubstanceType to the rate at which instances of SUBSTANCE
undergo instances of #$Evaporating.  More specifically, how much mass
of SUBSTANCE evaporates from a surface per unit of time, measured in
quantities like (PerFn Gram (PerFn SquareMeter HoursDuration)).")
(comment BlowingSomethingUp "A specialization of both #$PhysicalDestructionEvent and #$ActionOnObject. In each instance of #$BlowingSomethingUp, some instance of #$PartiallyTangible is damaged by an instance of #$Explosion.  This collection includes the notable specialization #$Bombing, as well as instances of blowing up a mountain to make room for a road, or blowing up a piece of land in order to make a mine shaft.  Also included in this collection are naturally occuring instances of #$BlowingSomethingUp.  Lightning hitting an object may cause the object to explode under the right circumstances.")
(comment explosiveCompoundTypeUsed "(#$explosiveCompoundTypeUsed ACTION SUBSTANCE) means that in
the instance of #$HostileSocialAction ACTION, some instance of the type
SUBSTANCE, itself an instance of #$ChemicalSubstanceType, played the
role of #$stuffUsed.")
(comment ANFOBomb "A specialization of #$Bomb.  Each instance of #$ANFOBomb
uses an instance of #$Detonator to set off a sample of #$ANFO.")
(comment LethalInjection-Execution "A specialization of #$Execution-Judicial.  Each instance of
#$LethalInjection-Execution is an execution of an agent in punishment
for some crime in which drugs are administered to the agent to induce
death.  First the agent is hooked up to #$IntravenousEquipment and
started on a saline solution.  The agent is anesthesized, typically
with the barbituate sodium thiopental.  A saline solution will flush
the IV again, and the the agent usually receives a paralyzing agent
like pancuronium bromide to stop the breathing.  After another IV
flush, some states also include a final toxic agent to induce cardiac
arrest with something like potassium chloride.")
(comment UpperRespiratoryDistress "This is an ailment condition characterized by the impairment of the upper respiratory system.")
(comment LowerRespiratoryDistress "This is an ailment condition characterized by the impairment of the lower respiratory system.")
(comment TerroristGroup-Sikh "A specialization of #$TerroristGroup.  Each instance of #$TerroristGroup-Sikh is a terrorist group that is motivated largely by #$Sikhism.")
(comment SikhPerson "The collection of all persons who believe in the basic fundamental tenets of Sikhism or who practice Sikh religious rituals.")
(disjointWith BlastingCap Bomb)
(comment BlastingCap "A specialization of #$ExplosiveDevice.  Each instance of #$BlastingCap is a device containing an ignition explosive mixture, a primary initiating charge, and a high-explosive base charge, typically encapsulated in an aluminum or copper shell.")
(comment EyeAbsorption "Each instance of #$EyeAbsorption is a bodily event in which an animal absorbs something into its bloodstream via an eye.")
(comment stuffAbsorbedThroughEye "(#$stuffAbsorbedThroughEye ABSORB STUFF) means that during ABSORB, an instance of #$EyeAbsorption, STUFF, an instance of #$PartiallyTangible, is what is absorbed through an eye.")
(comment EyeAbsorptionFn "A collection-forming function that takes a type of thing and returns the class of events in which instances of that thing are absorbed through eyes.")
(comment LungDisease "A specialization of #$RespiratoryAilment.  Each instance of #$LungDisease is a state of sickness that impacts the lungs (see #$Lung) more than any other part of the body.  Important specializations include (#$CancerFn #$Lung), #$Emphysema, and #$LowerRespiratoryInfection.")
(disjointWith LungDisease UpperRespiratoryDistress)
(comment HeadCold "A specialization of #$CommonCold and #$UpperRespiratoryInfection. Each instance of #$ChestCold is a cold whose symptoms manifest mainly in the lower respiratory system.")
(comment ChestCold "A specialization of #$CommonCold and #$LowerRespiratoryInfection. Each instance of #$ChestCold is a cold whose symptoms manifest mainly in the lower respiratory system.")
(comment BlackLungDisease "A specialization of #$Pneumoconiosis.  Black lung disease (also known as \"coal miner's pneumoconiosis\") is caused by the inhalation of coal dust. It is an occupational hazard of miners.")
(comment Asbestosis "A specialization of #$Pneumoconiosis.  Asbestosis is a scarring of the lungs that leads to breathing problems and heart failure.   It is caused by exposure to asbestos.")
(comment Silicosis "A specialization of #$Pneumoconiosis.  Silicosis is a lung diseases that develops following the inhalation of crystalline silica dust (usually quartz).  Silicosis is an occupational hazard for miners.")
(comment Pneumoconiosis "A specialization of #$LungDisease.  Pneumoconiosis is the desease condidtion caused by the inhalation of dust particles, such as the dust of coal, silica and asbestos.")
(comment DustParticleFn "(#$DustParticleFn OBJ-TYPE) denotes the collection of dust particles (see #$DustParticle) that are dust of the type OBJ-TYPE.  Thus (#$DustParticleFn #$Quartz) denotes the collection of quartz dust particles.")
(comment SiliconDioxide "#$SiliconDioxide is the collection of macroscopic portions of the organic compound SiO2. Each instance, under normal conditions, is a white or colorless crystalline compound, occurring commonly as #$Quartz.  It is used to manufacture a wide variety of materials such as glass and concrete.")
(comment Siderosis "A specialization of #$Pneumoconiosis. Siderosis  is a lung disease caused by inhalation of iron dust.")
(comment PneumoconiosisTypeByParticleType "A collection of collections.  Each instance of #$PneumoconiosisTypeByParticleType is a specialization of  #$Pneumoconiosis (q.v.), and thus a type of lung disease.  Each instance of #$PhysiologicalConditionType is a kind of pneumoconiosis that is cased by the inhalation of a certain kind of particle.")
(comment Bronchitis-Chronic "A specialization of #$LungDisease. Chronic bronchitis is defined by the presence of a mucus-producing cough most days of the month, three months of a year for two successive years without other underlying disease to explain the cough. It may precede or accompany pulmonary emphysema.")
(comment ModernWomensPentathlon "A specialization of #$SportsEvent.  Each instance of #$ModernWomensPentathlon is a modern athletic contest in which each participant competes in five track and field events, usually the 200-meter and 1,500-meter runs, the long jump, and the discus and javelin throws.")
(comment RunningSportsEventTypeByDistance "A collection of collections. Each instance of #$RunningSportsEventTypeByDistance is a specialization of #$RunningSportsEvent, instances of which are such that particular distances must be traversed by the competing individuals or teams.")
(comment RacingSportsEventTypeByDistance "A collection of collections. Each instance of #$RacingSportsEventTypeByDistance is a specialization of #$RacingSportsEvent, instances of which are such that particular distances must be traversed by the competing individuals or teams.")
(comment SpeedSkatingSportsEventTypeByDistance "A collection of collections. Each instance of #$SpeedSkatingSportsEventTypeByDistance is a specialization of #$SpeedSkatingSportsEvent, instances of which are such that particular distances must be traversed by the competing individuals or teams.")
(comment CyclingSportsEventTypeByDistance "A collection of collections. Each instance of #$CyclingSportsEventTypeByDistance is a specialization of #$CyclingSportsEvent, instances of which are such that particular distances must be traversed by the competing individuals or teams.")
(comment raceDistance "(#$raceDistance RACE DISTANCE) means that in order to complete participation in the #$RacingSportsEvent RACE, a competitor (or team of competitors) must traverse the #$Distance DISTANCE.  Thus (#$relationAllInstance #$raceDistance #$Run-400Meter (#$Meter 400)) is true, as is (relationAllInstance #$raceDistance #$Relay-4By100Meter (#$Meter 400)).")
(comment Seat-Drivers "(Provisional #$comment and definition) The seat in
a #$LandTransportationVehicle from which a user
controls the vehicle.")
(comment lockedSituation "(#$lockedSituation LOCK) means that the #$Lock LOCK is locked.")
(comment ChangingLockState "The collection of events in which a lock's internal state changes from #$lockedSituation to #$unlockedSituation, or vice versa.")
(comment unlockedSituation "(#$unlockedSituation LOCK) means that the #$Lock LOCK is unlocked.")
(comment userRightsRelation "This predicate relates an agent to the use rights which that agent has over an object. (#$userRightsRelation AGENT OBJECT URA) means that AGENT enjoys the #$SituationTypeByUserRights URA over OBJECT. URA is a collection of situations in which someone has a particular user right over an object.  If the #$userRightsRelation holds, there is a user rights situation whose constituents include AGENT and OBJECT and in which OBJECT is the object of the user rights.  Furthermore, this situation must be an instance of URA.  For example, if AGENT owns OBJECT, then there exists a situation which consists of AGENT possessing certain \"full use\" rights to use OBJECT and this situation is an instance of #$FullUseRights.")
(comment CasualUseRights "A specialization of #$Situation. #$CasualUseRights is the instance of #$SituationTypeByUserRights that represents a user's right to temporary use of an object or facility, such as a parking space, a toll road, or admission to a museum, fair, or theme park. Such a user doesn't have exclusive or full use of the facility.")
(disjointWith CasualUseRights NonExclusiveUserRights)
(comment NonExclusiveUserRights "A specialization of #$Situation. Each instance of this collection is a situation that consists of someone having non exclusive user rights to an object. See the comments on #$ExclusiveUserRights and #$SituationTypeByUserRights for a fuller explanation of how this is cashed out.  This collection represents a user right that obtains when an agent has a non-exclusive right to use something.  All #$Agent-Generic can claim this use-right to an object if any #$Agent-Generic can. This right is not the same as any instance of #$SituationTypeByGroupUserRight, as there is no specific group to which agents must belong in order to claim this right. This is typically used for things so fundamental we hardly consider them `rights.' E.g., the right to breathe air, use public parking lots, walk the streets as a free person, drive on public roads, etc.")
(comment PrimaryUserRights "A collection of instances of #$Situation. Each instance of this collection is a situation that consists of someone having primary use rights to an object. See the comments on #$ExclusiveUserRights and #$SituationTypeByUserRights for a fuller explanation of how this is cashed out. A situation of this type holds when there is an object that an agent has priority to use over other agents who can also claim a right to use it. E.g., parents have #$PrimaryUserRights to the family car.")
(disjointWith CasualUseRights PrimaryUserRights)
(disjointWith NonExclusiveUserRights PrimaryUserRights)
(comment EatingABowlOfSoup "An instance of #$IterativeSituationType and a specialization of #$EatingEvent.  Each instance of #$EatingABowlOfSoup is an event in which an individual animal consumes a substantial portion of the soup in a bowl.")
(comment MarkingOnASurfaceWithAPen-Uninterrupted "An instance of #$TemporalStuffType and a specialization of
#$FluidFlow-Translation. Each instance of
#$MarkingOnASurfaceWithAPen-Uninterrupted is an event in which some
#$Ink flows from inside of a #$WritingPen onto part of the surface of
one instance of #$Partially-Tangible. In each such instance, the flow
occurs as a result of the use of the pen in an event of type
#$MarkingOnASurfaceWithAPen. The flow does not occur in a way that is
atypical for writing or drawing; it does not occur, for example, as a
result of a leak in the pen that causes the ink to drip onto the
surface.")
(comment (CarryingFn Drink) "A specialization of #$CarryingWhileLocomoting, the collection of events in which someone bodily transports some drink.")
(comment CarryingFn "An instance of #$CollectionDenotingFunction.  When applied to a specialization MATERIAL of #$PartiallyTangible, #$CarryingFn returns the collection of all events in which an instance of MATERIAL is conveyed bodily from one location to another by a locomoting #$Animal (the function is thus more specific than #$ConveyFn, which returns all events in which an instance of MATERIAL is moved by any means whatsoever).  For example, (#$CarryingFn #$Beer) is the collection of all events in which beer is carried from one location to another (usually by some instance of #$HomoSapiens).")
(comment carryingOfMaterialType "A predicate which relates a type of material to the collection of #$CarryingWhileLocomoting events in which that type of thing is conveyed. (#$carryingOfMaterialType MATERIAL-TYPE EVENT-COL) means that all events in EVENT-COL involve the bodily conveyance of materials of type MATERIAL-TYPE. See also #$CarryingFn.")
(comment Travel-RoundTripEvent "A specialization of #$Travel-TripEvent and #$Translation-RoundTrip (qq.v.).  Each instance of #$Travel-TripEvent is an event in which a person or a group of people prepares for a trip, boards a conveyance, travels on the conveyance, disembarks the conveyance, remains at their destination for a period of time, and then returns to the starting point in an inbound leg that is structurally similar to their outbound leg.")
(comment skinContactWithTypes "(#$skinContactWithTypes CONTACT-TYPE OBJECT-TYPE) means that CONTACT-TYPE is the collection of #$TouchingEvents in which contact is made with some instances of OBJECT-TYPE.")
(comment objectsInContact "(#$objectsInContact CONTACT OBJECT) means that OBJECT is one of the #$PartiallyTangibles in contact in the #$PhysicalContactSituation CONTACT.")
(comment TouchingSituation "This is the collection of static situations in which two distinct objects are in continuous physical contact.")
(comment DayTrip "A specialization of #$PurposefulAction and #$Movement-TranslationEvent.  Each instance of #$Travel-TripEvent is an event in which a person or a group of people prepares for a trip, board a conveyance, travel on the conveyance, and disembark the conveyance.  For somewhat more complex events that involve repeating that procedure on a return leg, see the specialization #$Travel-RoundTripEvent.")
(comment SandyBeach-Recreational "A specification of #$SandyBeach (q.v.).  Instances
are beaches intended as a location for recreational
activities as sunbathing, swimming and surfing.")
(comment ExistenceDependentNonInitialIntermittentCollection "A specialization of both #$ExistenceDependentIntermittentCollection and #$NonInitialCollection (qq.v.).  Each instance EDNIIC of #$ExistenceDependentNonInitialIntermittentCollection is a collection such that: (i) a thing can be an instance of EDNIIC only while the thing exists, (ii) nothing can be an instance of EDNIIC at the start of the thing's existence, and (iii) a thing can be an instance of EDNIIC during several non-overlapping periods of the thing's existence.  For example, #$USSenator is such a collection.")
(comment HistoricalCollection "A specialization of #$NonInitialCollection (q.v).  Each instance HC of #$HistoricalCollection is a collection such that (i) nothing can start its existence as an instance of HC and (ii) once a thing becomes an instance of HC it necessarily remains so for the rest of time.  An example of a historical collection is #$Deceased.")
(disjointWith HistoricalCollection IntermittentCollection)
(disjointWith TerminalNonInitialCollection IntermittentCollection)
(disjointWith InitialCollection NonInitialCollection)
(disjointWith IntermittentCollection InitialCollection)
(comment definitionalDisplayAssertion "(#$definitionalDisplayAssertion TERM ASSERTION) means that ASSERTION has been deemed one of the assertions that should be displayed when Cyc offers a concise definition of TERM. #$definitionalDisplayAssertion can be used by Cyc to generate #$comments automatically, or in response to user's requests for a summary of a concept.")
(comment ELRelation "A specialization of #$MacroRelation (q.v.) instances of which appear only at the \"epistemological level\" (or EL) of the Cyc system.  Each instance of #$ELRelation is associated, via the #$expansion or #$expansionDefn relation, to a sentence template to which the former is essentially equivalent and for which the former serves as a convenient alternative.  Some assertions using instances of #$ELRelation are irretrievable after being input to the Cyc System (#$ELRelation-OneWay), and others' EL forms are reconstructed dynamically by the system (#$ELRelation-Reversible).")
(disjointWith ELRelation-Reversible ELRelation-OneWay)
(comment ELRelation-Reversible "A specialization of #$ELRelation (q.v.) instances of which appear only at the \"epistemological level\" (or EL) of the Cyc system, but whose original forms, or logically equivalent variants thereof, are retrievable via the #$CycUncanonicalizer.  Each instance of #$ELRelation-Reversible is associated, via the #$expansion (q.v.) or #$expansionDefn relation, to a sentence template to which the former is essentially equivalent and for which the former serves as a convenient alternative.  Furthermore, each instance of #$ELRelation-Reversible is also associated with a piece of code which can perform the inverse transformation.  Since each instance of #$ELRelation-Reversible requires special code support, this is a #$notAssertibleCollection.  More precisely:  A GAF (see #$CycLClosedAtomicSentence) whose main functor (or \"0th argument\") is a term that denotes a reversible EL relation can occur only at the EL, and not at the underlying HL (\"heuristic level\") of the system.  Thus, although one can use an EL-relation-based GAF to make an assertion to the system, the GAF that actually gets stored as an assertion in the Cyc Knowledge Base is a different (though logically equivalent) one that is related to the first via the #$expansion or #$expansionDefn assertion on the EL relation.  Upon assertion, the first GAF is transformed into the second GAF by the #$CycCanonicalizer.  Upon presentation to the user, the second GAF is transformed back into the first GAF, or a GAF which is logically equivalent, by the #$CycUncanonicalizer.  For example, #$willAlwaysBe is a reversible EL relation whose #$expansionDefn and associated piece of uncanonicalization code perform the following transformation:
<p>
(#$ist (#$MtSpace (#$MtTimeDimFn TIME) OTHER-DIMS) (#$willAlwaysBe P)
<->
(#$ist (#$MtSpace (#$MtTimeDimFn (#$IntervalStartedByFn TIME)) OTHER-DIMS) P)
<p>
So if one makes an assertion into an MT with time index T using the sentence `(#$willAlwaysBe P)', the assertion that actually shows up in the KB is `P' in an MT with time index (#$IntervalStartedByFn T).")
(comment Artifact-HumanCreated "A collection of individual #$Artifacts. Each instance of #$Artifact-HumanCreated is a tangible thing made by an instance of #$HomoSapiens, or by a (#$GroupFn #$HomoSapiens). Examples include instances of #$Clothing-Generic, #$Automobile, #$DrainageCanal, and #$HydroelectricDam.")
(comment GoingOnAFirstDate "A specialization of #$GoingOnADate: each instance of this collection is a first date between two people.")
(comment ChildLaborLaw "The collection of all laws (codes, regulations, etc.) relating to child labor.")
(comment SevereAcuteRespiratorySyndrome "A disease, first described in 2003, called the \"severe acute respiratory syndrome.\"")
(comment SARSEpidemic "The collection of all epidemics of the SARS virus [#$SARSVirus].")
(comment SARSVirus "The #$Virus that causes SARS [#$SevereAcuteRespiratorySyndrome].")
(comment Rhinovirus "The collection of all rhinoviruses.  A type of #$Picornavirus.")
(disjointWith Picornavirus Coronavirus)
(comment PositiveSenseRNA "The collection of all positive-sense RNA molecules")
(comment SingleStrandedPositiveSenseRNAPicornavirus "The collection of all #$Picornaviruses whose genome consists of a single strand of #$PositiveSenseRNA.")
(comment DESC-BBNSyntacticCategoryMarker "An instance of #$BBNSyntacticCategoryMarker.")
(comment NAME-BBNSyntacticCategoryMarker "An instance of #$BBNSyntacticCategoryMarker.")
(comment PRON-BBNSyntacticCategoryMarker "An instance of #$BBNSyntacticCategoryMarker.")
(comment EarthToMoonTransportationEvent "A specialization of #$SpaceTransportationEvent.  Each instance of #$EarthToMoonTransportationEvent is an event in which a transporter travels from #$PlanetEarth to the #$MoonOfEarth.")
(comment MoonToEarthTransportationEvent "A specialization of #$SpaceTransportationEvent.  Each instance of #$MoonToEarthTransportationEvent is an event in which a transporter travels from the #$MoonOfEarth to #$PlanetEarth.")
(comment LunarRoundTrip "A specialization of #$SpaceTransportationEvent and #$Translation-RoundTrip.  Each instance of #$LunarRoundTrip is an event in which a transporter travels from #$PlanetEarth to the #$MoonOfEarth and back.")
(comment AbnormalSystemCondition "This is the collection of #$SystemConditions which are abnormal for the system they affect -- for instance, a computer during reboot, or a human body when 'puffed out' from exceptionally vigorous exercise.   For conditions which are abnormal and also impair the functioning of the system, see the more specialized #$DysfunctionalCondition.")
(comment EyeContact "A specialization of #$WatchingSomething. Each instance of this collection is an event in which someone looks into the eyes of someone who is looking at them.")
(comment Portal-Visible "An instance of #$ExistingObjectType and a specialization of
#$Portal. Each instance of #$Portal-Visible is a portal that is
#$BarelyVisibleSized or larger.")
(comment SkinLaceration-VisiblePortal "An instance of #$ExistingObjectType and a specialization of
#$Injury-Object and #$Portal-Visible. Each instance of
#$SkinLaceration-VisiblePortal is an injury, including #$Wounds and
#$SurgicalIncisions, consisting of a portal that is
#$BarelyVisibleSized or larger.")
(comment queryPracticeGAFs "(#$queryPracticeGAFs QUERY GAF) means that the #$CycLClosedAtomicSentence GAF is intended to be used in answering QUERY. #$queryPracticeGAFs can be used in conjunction with #$queryPracticeRules to identify the complete intended inference path for a query.")
(comment ConstructionMaterialType "The collection of all types of material which are normally used for construction.  Instances of this collection are context dependent with ice being an instance along the Arctic coast of North America and palm leaves being an instance throughout most of the tropics.  #$Wood and stone [#$StoneStuff] are instances in most human societies in which they are available.")
(disjointWith ConstructionMaterialType ToxinBioAgentType)
(disjointWith ForestTypeByDensity ConstructionMaterialType)
(disjointWith TacticalTerrainType ConstructionMaterialType)
(disjointWith TerrainTypeByTrafficabilityLevel ConstructionMaterialType)
(disjointWith DrugSubstanceTypeByMechanismOfAction ConstructionMaterialType)
(disjointWith DegreeOfCloudiness ConstructionMaterialType)
(disjointWith OverTheCounterDrugType ConstructionMaterialType)
(disjointWith RegionTypeBySurfaceGrowth ConstructionMaterialType)
(disjointWith OutdoorLocationTypeByWeather ConstructionMaterialType)
(disjointWith PPTByAdministrationRouteType ConstructionMaterialType)
(disjointWith FoodGroup ConstructionMaterialType)
(disjointWith Cuisine ConstructionMaterialType)
(disjointWith CumulativeStuffType ConstructionMaterialType)
(disjointWith PrescriptionDrugType ConstructionMaterialType)
(disjointWith TherapeuticClassType ConstructionMaterialType)
(comment molecularWeight "(#$molecularWeight SUBSTANCE WEIGHT) relates an instance of #$ChemicalCompoundTypeByChemicalSpecies SUBSTANCE to its molecular weight WEIGHT.  More precisly, WEIGHT is the sum of the atomic weights of the atoms for one molecule of SUBSTANCE.  See also #$molarMass for a similar measurement, but for one mole of SUBSTANCE.")
(comment ProjectileMotion-Thrown "The collection of all instances of #$ProjectileMotion which are caused by an instance of #$ThrowingAnObject.")
(comment objectThrown "(objectThrown THROW OBJ) means that OBJ, was one of the objects thrown in THROW, an instance of #$ThrowingAnObject.")
(comment repeatableRoleInEventType "[Brief #$comment] (#$repeatableRoleInEventType
EVENT-TYPE ROLE) means that whenever something
ACTOR plays the role ROLE in an event of type
EVENT-TYPE, ACTOR can (by default) play ROLE
in a distinct event of type EVENT-TYPE.
For example, (#$repeatableRoleInEventType #$BirthEvent
#$birthParent) holds whereas
(#$repeatableRoleInEventType #$BirthEvent
#$birthChild) does not.")
(comment WoodenStake "A specialization of #$Stake. Each instance of this collection is a stake made of wood.")
(comment FrozenDessertMarketCategory "Generic market category for frozen desserts, dairy or otherwise, that are eaten in their frozen or semi-frozen state. Includes ice cream, milkshakes, sodas, popsicles, as well as ice cream cakes and frozen yogourt.  Does not include frozen, ready-to-bake pies, cakes, or cookies.")
(comment organismTypeNotFoundInClimateOfType "(#$organismTypeNotFoundInClimateOfType ORG-TYPE CLIMATE) means that instances of ORG-TYPE do not ordinarily live (see #$indigenousTo, #$organismTypeHasHabitat) in a region with the #$ClimateCycleType CLIMATE. See also #$organismTypeFoundInClimateOfType.")
(comment ToolSet "The collection of hardware tool sets.")
(comment isa-FeatureType "This typed spec pred of #$isa relates a #$Place to a #$GeographicalFeatureType.")
(comment sksModifiable "(#$sksModifiable SKS) means that the contents of the structured knowledge source SKS is modifiable through Cyc. The extent of this predicate is used in SKSI HL storage module generation, to decide whether HL storage modules should be generated for a given external knowledge source.")
(comment CapableWRTFn "#$CapableWRTFn is a predicate-forming function that takes an instance-level capability predicate and returns a restricted capability predicate, that is, one which predicates that type of capability with respect to a particular thing in a certain role.")
(comment sksProxyHost "(#$sksProxyHost ?SKS ?HOSTNAME) means that to access knowledge source ?SKS a program can use a proxy server running on ?HOST.")
(comment TheCORBAInitialObject "The indexical corresponding to the initial object returned by a CORBA server.  This object may be used to obtain other CORBA objects after connecting to a CORBA source.")
(comment sksProxyPort "(#$sksProxyPort ?SKS ?PORT) means that to access knowledge source ?SKS a program can use a proxy server running on a host specified by #$sksProxyHost and listening on port ?PORT.")
(comment NAERGGuideBook-CW "An instance of both #$InstructionalWork and #$Book-CW. The
North American Emergency Response Guidebook.  This guidebook was
developed jointly by Transport Canada, the U.S Department of
Transportation,, and the Secretariat of Transport and Communications
of Mexico (SCT) originally to give first responders (those #$EmergencyWorkers
first on the scene of an incident) a guide on protecting themselves
and the public from hazardous materials.  Each instantiation of
#$NAERGGuideBook-CW has three sections: yellow-bordered pages that
list hazardous chemicals by an ID number, blue-bordered pages that
list the chemicals in alphabetical order by material name, and
finially the orange-bordered pages that contains the safety
recommendations for the chemicals.")
(comment InitialResponseToHazardousMaterialEmergency "A specialization of #$EmergencyResponse.  Each instance of
this collection is an event in which #$EmergencyWorkers respond to the
initial incident involving instances of
#$HazardousChemicalSubstanceType.  The inital phases, as defined by
#$NAERGGuideBook-CW is the period of time 'following arrival at the
scene of an incident during which the presence and/or identification
of dangerous goods is confirmed, protective actions and area
securement are initiated, and assistance of qualified personnel is
requested.'")
(comment HazardousMaterialEmergency "A specialization of #$Emergency and #$PhysicalEvent.  Each
instance of this collection is a situation in which samples of
instances of #$HazardousChemicalSubstanceType pose some threat to
people or property.  This is intended to be a very broad collection of
situations which would include traffic accidents involving vehicles
transporting dangerous chemicals, chemical spills inside buildings,
etc.")
(comment NAERGGuide-CW "An instance of #$InstructionalWork. The individual
#$NAERGGuide-CW comprises the orange-bordered pages of the
#$NAERGGuideBook-CW. Each #$NAERGGuide-CW covers a particular group of
materials that have similar chemical and/or toxicological
properties.  See also #$NAERGGuideNumberFn for a method to reify the
specific guides.")
(comment substanceTypeNAERGGuide "(#$substanceTypeNAERGGuide SUBSTANCE NAERG) relates in instence of
#$ChemicalSubstanceType to its #$NAERGGuide-CW. The #$NAERGGuide-CW is
an instance of #$InstructionalWork that describes the safety
procedures in instances of
#$InitialResponseToHazardousMaterialEmergency that include
SUBSTANCE.")
(comment directsTransportationOf "An instance of #$ComplexActionPredicate.  This is the relation that holds definitionally between the #$directingAgent and #$transportees of #$TransportationEvents.")
(comment directsTransportationOf "An instance of #$EventPredicate.  This is the relation that holds definitionally between objects which fill the #$transportees and #$toLocation roles of #$TransportationEvents.")
(comment somehood "The function-corresponding predicate for #$SomeFn. (#$somehood COL SOME-INSTANCE-OF-COL) relates a collection to an arbitrary and wholly underspecified instance of that collection, of which all that can be said (at least without further assertions) is that it is \"some\" member of COL.")
(comment directsSeizureOf "An instance of #$ComplexActionPredicate.  This is the relation that holds definitionally between the fillers of the #$performedBy and #$objectTaken slots in an instance of #$TakingSomething.")
(comment directsSeizureOf "An instance of #$ComplexActionPredicate.  This is the relation that holds definitionally between fillers of the #$directingAgent and #$objectTaken slots in instances of #$TakingSomething.")
(comment DAMLRestriction "The collection of all DAML Restriction objects.  Each DAML restriction has the same effect as a inter-argument constraint.")
(comment meaningSentencePredicateForSource "This predicate relates a structured knowledge source to the
relations which appear in the arg0 of the meaning sentences associated
with the source. Each sks is associated with one or more physical
schemas via #$physicalSchemaSourceMap. Each physical schema is associated with
one or more logical schemas via #$logicalPhysicalSchemaMap. Each
logical schema is associated with one or more meaning sentences via
#$meaningSentenceOfSchema. So for each sks, there are one or more
meaning sentences which can be found by tracing through the (KS --->
PS ---> LS ---> MS) path. Finally, the arg0 of the meaning sentence is
associated with the KS. The functionality of this predicate is
implemented by a forward rule. See the #$salientAssertions for this
predicate.")
(comment communicatesWithViaEmail "An instance of #$ActionPredicate.  This is the relation that holds definitionally between the #$senderOfInfo and #$recipientOfInfo in #$EMailCommunication events.")
(comment communicatesWithViaTelephone "An instance of #$ActionPredicate.  This is the relation that holds definitionally between the #$senderOfInfo and #$recipientOfInfo in (#$CommunicatingByMeansOfFn #$Telephone) events.")
(comment GeologicalTimePeriod "The collection of significant continuous periods of geological time on earth.  The largest divisions are #$GeologicalEras (the #$Precambrian-GeologicalEra, #$Palaeozoic-GeologicalEra, #$Mesozoic-GeologicalEra, and #$Cenozoic-GeologicalEra); these are subdivided into #$GeologicalPeriods and the #$Tertiary-GeologicalPeriod and #$Quaternary-GeologicalPeriod (the two periods of the #$Cenozoic-GeologicalEra) are further subdivided into #$GeologicalEpochs, which consist of several #$GeologicalAges.  The divisions are not uniform time intervals but are based mainly on major evolutionary changes. For example, at the beginning of the #$Cambrian-GeologicalPeriod, about 590 million years ago, marine organisms suddenly became abundant and varied.")
(comment GeologicalEra "A specialization of #$GeologicalTimePeriod.  Instances of #$GeologicalEra are the longest divisions of geological time.  There are four such divisions: the #$Precambrian-GeologicalEra, the #$Palaeozoic-GeologicalEra, #$Mesozoic-GeologicalEra, and the #$Cenozoic-GeologicalEra.")
(comment GeologicalPeriod "A specialization of #$GeologicalTimePeriod. Instances of #$GeologicalPeriod are divisions of #$GeologicalEras (q.v.). For example, the #$Jurassic-GeologicalPeriod is a sub-interval of the #$Mesozoic-GeologicalEra.")
(comment arrests "An instance of #$ActionPredicate.  This is the relation that holds definitionally between the objects which fill #$performedBy and #$arrestee slots in an instance of #$ArrestingSomeone.")
(comment logicalFieldTypeForSource "This predicate relates the type of a logical field to a knowledge source which is associated with the logical field via some logical/physical schema mapping. See the #$salientAssertions index on this predicate for the forward rule that defines its action.  Assertions using this predicate are inferred from forward rules.")
(comment VisitingASite-TravelInclusive "A specialization of #$Travel-RoundTripEvent.  Each instance of #$VisitingASite-TravelInclusive is an event in which a visitor travels to a site, visits it (see #$VisitingASite), and departs from it.")
(comment VisitingSiteOfTypeFn "(#$VisitingSiteOfTypeFn ATTR-TYPE) denotes the specialization of #$VisitingASite whose instances are visits to tourist attractions of type ATTR-TYPE.")
(comment ArtMuseum-Organization "A specialization of #$Museum-Organization (q.v.).  Each instance of #$ArtMuseum-Organization is an organization dedicated to presenting art displays in instances of #$ArtMuseum-Structure.")
(comment ScienceMuseum-Organization "A specialization of #$Museum-Organization #$Museum-Organization.  Each instance of #$ScienceMuseum-Organization is an organization dedicated to putting scientifically informative displays in instances of #$ScienceMuseum-Structure.")
(comment NaturalHistoryMuseum-Organization "A specialization of #$ScienceMuseum-Organization (q.v.).  Each instance of #$NaturalHistoryMuseum-Organization is an organization dedicated to displaying holdings that reveal information mainly about natural history (see #$NaturalHistory) in instances of #$NaturalHistoryMuseum-Structure.")
(comment NaturalHistoryMuseum-Structure "A specialization of #$ScienceMuseum-Structure.  Each instance of #$NaturalHistoryMuseum-Structure is a construct that is used to store and display natural history exhibits such as fossils and minerals (see #$NaturalHistoryMuseum-Organization, and #$MuseumHoldings).")
(comment HistoryMuseum-Organization "A specialization of #$Museum-Organization (q.v.).  Each instance of #$HistoryMuseum-Organization is an organization dedicated to displaying holdings that reveal information mainly about  history (see #$History-FieldOfStudy) in instances of #$HistoryMuseum-Structure.")
(comment foreignKeyMap-Restrict "This specialization of #$foreignKeyMap entails an additional
constraint on deleting or modifying the rows of the
referenced schema. That is (#$foreignKeyMap-Restrict REFERENCED_SCHEMA
REFERENCED_KEY REFERENCING_SCHEMA REFERENCING_FIELD_LIST) means in
addition to the constraints inherited from #$foreignKeyMap, deleting a
row of REFERENCED_SCHEMA is not permitted if there is any row of
REFERENCING_SCHEMA which references it. Contrast this behavior with
#$foreignKeyMap-Cascade, #$foreignKeyMap-SetNull, and #$foreignKeyMap-SetDefault.")
(comment foreignKeyMap-Cascade "This specialization of #$foreignKeyMap entails an additional
constraint on deleting or modifying the rows of the
referenced schema. That is (#$foreignKeyMap-Cascade REFERENCED_SCHEMA
REFERENCED_KEY REFERENCING_SCHEMA REFERENCING_FIELD_LIST) means in
addition to the constraints inherited from #$foreignKeyMap, deleting a
row of REFERENCED_SCHEMA also deletes any rows of REFERENCING_SCHEMA
which reference it. Contrast this behavior with
#$foreignKeyMap-Restrict, #$foreignKeyMap-SetNull, and #$foreignKeyMap-SetDefault.")
(comment nonNullFieldList "(#$nonNullFieldList PS LIST) entails i) each member of LIST
is a physical field of PS, and ii) no such physical field is ever
null. The restriction of non-nullity is definitional to the schema and
enforces a hard constraint on updates to the knowledge source. See
also the relation #$nonNullFields which relates a never null physical
field directly to its schema.")
(comment Horseradish-Condiment "A specialization of both #$Condiment and #$EdibleStuffComposite.  Each instance of this collection is some amount of the spicy condiment made from (#$RootFn #$Horseradish-Plant).")
(comment Horseradish-Plant "A specialization of #$HerbPlant and #$FloweringPlant. Each
instance of this collection is a white-flowered herb from the mustard
family. Its root is ground up to make #$Horseradish-Condiment.")
(comment CollectionRelatingFunction "A specialization of #$CollectionDenotingFunction.  Each instance of #$CollectionRelatingFunction is a function that takes a collection as (one of) its argument(s), and always returns a collection as value.  If the latter (returned) collection is always a subcollection of the former (argument) collection, then the function is an instance of the more specialized function-type #$SubcollectionDenotingFunction.  Another notable specialization of #$CollectionRelatingFunction is #$GenlsPreservingFunction.")
(comment GenlsPreservingFunction "A specialization of #$CollectionRelatingFunction (q.v.).  Each instance <code>FUNC</code> of #$GenlsPreservingFunction is a collection-relating function such that whenever #$genls holds between successive arguments (in some particular argument-place) to <code>FUNC</code>, it holds between the corresponding successive values as well.  That is, <code>(#$preservesGenlsInArg FUNC N)</code> holds for some <code>N</code>.
<p>
More precisely, a function <code>FUNC</code> is a #$GenlsPreservingFunction if and only if it has an argument-place (say the <code>N</code>th) such that the following hold:
<p>
(i) <code>(#$resultIsa FUNC #$Collection)</code>
<p>
(ii) <code>(#$argIsa FUNC N #$Collection)</code>
<p>
(iii) if <code>(#$genls SPEC GENL)</code> holds and <code>FUNC</code> is defined for both <code><... SPEC ...> </code>and<code> <... GENL ...></code> (where <code>SPEC</code> and <code>GENL</code> are the respective <code>N</code>th items in these otherwise identical sequences), then <code>(#$genls (FUNC ... SPEC ...) (FUNC ... GENL ...))</code> holds.
<p>
For example, #$AdultFn is a genls-preserving function.  Just as a dog is a type of mammal (e.g.), so is an adult dog a type of adult mammal.")
(comment Ether "A specialization of #$OrganicCompound.  Each instance of
#$Ether is a chemical compound whose molecular composition consists of an
oxygen atom interposed between two carbon atoms.")
(comment RecapitalizeSmartFn "(#$RecapitalizeSmartFn STRING) capitalizes all but
non-initial, closed-lexical-class words in STRING. Additionally it
ensures that any capitalized characters which appear in the middle or
end of a word are properly uncapitalized. For instance, (#$equals
(#$RecapitalizeSmartFn 'the TAMINg oF tHe sHrew') 'The Taming of the
Shrew'). Compare this function with #$CapitalizeSmartFn which has
similar behavior but leaves capitalized characters in the middle or
end of a word alone.")
(comment CapitalizeSmartFn "(#$CapitalizeSmartFn STRING) capitalizes all but
non-initial, closed-lexical-class words in STRING. If STRING contains
words with capitalized characters in the middle or end, this function
leaves them alone. For instance, (#$equals (#$RecapitalizeSmartFn 'the
TAMINg oF tHe sHrew') 'The TAMINg oF tHe SHrew'). See also
#$RecapitalizeSmartFn, which will uncapitalize characters which appear
in the middle or the end of a word.")
(comment typicalOdorOfType "(#$typicalOdorOfType COLLECTION ODOR) means that instances of
COLLECTION, a specialization of #$PartiallyTangible, typically emit
the #$Odor ODOR.")
(comment querySentence "#$querySentence is an HL level predicate that allows for special handling of a sentence (especially nested sentences) as a top level query during the process of canonicalization.  #$querySentence is not-assertible.  It should not be used in any assertions.")
(comment SKSISchemaTranslationMicrotheory "A specialization of #$SKSIMappingMicrotheory.  This is the
collection of all microtheories that contain the #$CycL
representations of the translation (encodings and decodings) between
logical and physical schemata.")
(comment SKSILogicalSchemaDescriptionMicrotheory "A specialization of #$SKSISchemaDescriptionMicrotheory.
This is the collection of all microtheories that contain the #$CycL
representations of logical schemata.")
(comment SKSIPhysicalSchemaDescriptionMicrotheory "A specialization of #$SKSISchemaDescriptionMicrotheory.
This is the collection of all microtheories that contain the #$CycL
representations of physical schemata.")
(comment SKSISchemaDescriptionMicrotheory "A specialization of #$SKSIMappingMicrotheory.  This is the
collection of all microtheories that contain the #$CycL
representations of logical or physical schemata.  Such microtheories
should not contain any knowledge source specific data.  These data go
in instances of #$SKSISourceDescriptionMicrotheory.")
(comment SKSISourceDescriptionMicrotheory "A specialization of #$SKSIMappingMicrotheory.  This is the
collection of all microtheories that contain the definitional
information of a #$StructuredKnowledgeSource.")
(comment ContainerMadeOfFn "#$ContainerMadeOfFn takes any instance of #$TangibleStuffCompositionType and returns the collection of all container products made from stuff of that type. For example (#$ContainerMadeOfFn #$Steel) returns the collection of all container products made out of #$Steel.")
(comment chemicalNATODesignation "(#$chemicalNATODesignation CHEMICAL STRING) means that STRING is the unique North Atlantic Treaty Organization (#$NATO) military designation for CHEMICAL. For example, the NATO military designation for #$SesquiMustard is 'HQ'.")
(comment PulmonaryEdema "A specialization of #$Edema-Condition, where edema afflicts the #$Lung.")
(comment Mercaptoethanol "The chemical with formula C2H6OS.")
(comment EthyleneDibromide "The chemical with formula C2H4Br2.")
(comment Hyperalgesia "The condition of hypersensitivity to pain, where a stimulus that typically yields little to no pain produces extreme pain. It usually follows certain injuries or diseases.")
(comment BioregulatorType "Bioregulators are '[b]iochemicals normally present in humans in small amounts that regulate the release of hormones that control normal body functions. Bioengineered bioregulators could be weaponized and function similar to toxins. They would cause disruption in normal body function and homeostasis. These agents would have the advantage that their effects would be immediate, they could escape detection and they could be more potent than traditional chemical agents and toxins.' (definition courtesy of the Vermont Health Alert Network, http://www.vdh.state.vt.us/common/define.htm)")
(comment SesquiMustard "#$SesquiMustard, also known as HQ, is a #$MustardGas with a molecular struction similar to #$MustardGas (HD) and produces symptoms similar to #$Phosgene (CG).")
(comment Hypotension "The condition of having dangerously low blood pressure, often leading to fainting.")
(comment Hypersalivation "The condition of over-production of saliva.")
(comment MustardLewisite "#$MustardLewisite, also known as HL, is a #$BlisterAgentType made of #$Lewisite (typically 63-percent) and (distilled) #$MustardGas (typically 37-percent). Mixing #$Lewisite and #$MustardGas lowers the substance's vapor pressure, which lowers the freezing point of the substance.")
(comment SubstanceP "#$SubstanceP is a #$BioregulatorType. It is a peptide that is naturally located in a person's brain, synovium, spinal cord and gastrointestinal tract. There is still little known about it or its capability to be used as a weapon, but it is aerosolizable and may be effective in extremely small doses.")
(comment OdorTypeByPhysiologicalEffect "A collection of types of #$Odor.  Each instance of
#$OdorTypeByPhysiologicalEffect is a collection of odors whose
instances have some physiological effect upon people when inhaled.
Notable instances of this collection include #$IrritatingOdor and
#$NauseatingOdor.")
(comment IrritatingOdor "An instance of #$Odor.  Instances of this collection are
those that irritate the nasal passages upon inhalation.")
(comment SourOdor "An instance of #$Odor.  Instances of this collection are the
olfactory equivalent to #$SourTaste.")
(comment SaltyOdor "An instance of #$Odor.  Instances of this collection are the
olfactory equivalent to #$SaltyTaste.")
(comment SweetOdor "An instance of #$Odor.  Instances of this collection are the
olfactory equivalent to #$SweetTaste.")
(comment BitterOdor "An instance of #$Odor.  Instances of this collection are the
olfactory equivalent to #$BitterTaste.")
(comment NauseatingOdor "An instance of #$Odor.  Instances of this collection are
those that cause a physiological response of #$Nauseated.")
(comment SuffocatingOdor "An instance of #$Odor.  Instances of this collection are
those that cause a physiological response of suffocating or choking
when inhaled.")
(comment CenturyFn "An instance of #$DateDenotingFunction.  When applied to an instance of #$Integer, #$CenturyFn returns an instance of #$CalendarCentury.  (#$CenturyFn NUMBER) denotes the instance of #$CalendarCentury consisting of (#$YearFn (#$PlusFn (#$TimesFn NUMBER 100) -99), (#$YearFn (#$PlusFn (#$TimesFn NUMBER 100) 98)) , ... , and (#$YearFn (#$TimesFn NUMBER 100)).  For example, (#$CenturyFn 20) refers to #$TheTwentiethCenturyCE.")
(comment PartsPerBillion "A #$UnitOfMeasure for expressing concentrations as the number of units of solute per billion units of solution, (Here, \"solute\" and \"solution\" are used non-technically. For details, see #$PartsPerMillion.)")
(comment NaturalismMt "The microtheory in which all supernatural things are fictional.")
(comment incarnationPhysical "(#$incarnationPhysical SPIRIT OBJECT) means that the #$SupernaturalBeing, SPIRIT, is currently incarnated in OBJECT, a sentient being.  In many microtheories OBJECT will almost always be an instance of #$SentientAnimal. ")
(comment dateOfConception "(#$dateOfConception ORGANISM DATE) means that gametes joined to form the zygote from which ORGANISM developed on the specified date.")
(comment properSubSituations "An #$AsymmetricBinaryPredicate and a specialization of #$subSituations. This predicate relates situations to further situations which are their proper parts.
<p>  
<code>(#$properSubSituations SIT SUBSIT)</code> means that:<br>
(1) the #$Situation <code>SUBSIT</code> is a part of the #$Situation <code>SIT</code> such that a complete description of <code>SIT</code> would have to involve a description of <code>SUBSIT</code>, and<br> 
(2)<code>SUBSIT</code> is not identical to <code>SIT</code> itself.  
<p>
For example, a situation in which a car engine is non-functioning might have as a proper subsituation the situation of a carburetor being misconfigured.")
(comment shortTermExposureLimit "A binary predicate relating specs of #$PartiallyTangible to their short term exposure limits, as determined by the Occupational Safety and Health Administration (OSHA) and/or the National Institute for Occupational Safety and Health (NIOSH). (#$shortTermExposureLimit SUBSTANCE LIMIT) means just that the short term exposure limit (\"STEL\") of SUBSTANCE is LIMIT. A substance's STEL is the maximum average concentration of the substance to which a normal, healthy human adult should be exposed in a 15-minute work period.  No more than four 15-minute exposures at the STEL level should exist in an 8-hour workday, and a period of at least 60 minutes of non-exposure should intervene between any two such 15-minute exposures. Compare #$iDLHConcentration, #$ceiling-ExposureLimit, #$permissibleExposureLimit, and #$recommendedExposureLimit.")
(comment permissibleExposureLimit "A binary predicate relating specs of #$PartiallyTangible to their permissible exposure limits, as determined by the Occupational Safety and Health Administration (OSHA). (#$permissibleExposureLimit SUBSTANCE LIMIT) means just that the permissible exposure limit (\"PEL\") of SUBSTANCE is LIMIT. A substance's PEL is the maximum average concentration of the substance to which a normal, healthy human adult, who works 40 hours per week, should be exposed in an 8-hour work day. PEL's have been codified as legal limits under Title 29 of the Code of Federal Regulations, Part 1910, Section 1000, meaning that employers who permit employees to exceed PEL's may be cited and fined. Compare #$recommendedExposureLimit, #$shortTermExposureLimit, #$ceiling-ExposureLimit, and #$iDLHConcentration.")
(comment recommendedExposureLimit "A binary predicate relating specs of #$PartiallyTangible to their recommended exposure limits, as determined by the National Institute of Occupational Safety and Health (NIOSH). (#$recommendedExposureLimit SUBSTANCE LIMIT) means just that the recommended exposure limit of SUBSTANCE is LIMIT. A substance's recommended exposure limit (\"REL\") is the maximum average concentration of the substance to which a normal, healthy human adult, who works 40 hours per week, should be exposed in a work day lasting up to 10 hours. REL's have not been codified as legal limits under U.S. law. Compare #$permissibleExposureLimit, #$shortTermExposureLimit, #$ceiling-ExposureLimit, and #$iDLHConcentration. ")
(comment ceiling-ExposureLimit "A binary predicate relating specs of #$PartiallyTangible to their ceilings, as determined by the Occupational Safety and Health Administration (OSHA) and/or the National Institute for Occupational Safety and Health (NIOSH), (#$ceiling-ExposureLimit SUBSTANCE LIMIT) means just that the ceiling for SUBSTANCE is LIMIT. A substance's ceiling is the maximum concentration of the substance to which a normal, healthy human adult should be exposed to at any moment in time. In other words, a person should never be exposed to a concentration of a substance that exceeds the substance's ceiling. Compare #$shortTermExposureLimit, #$iDLHConcentration, #$permissibleExposureLimit, and #$recommendedExposureLimit.")
(comment PartsPerMillion "A #$UnitOfMeasure for expressing concentrations in terms of the number of units of solute per million units of solution, i.e. per million units of solvent, approximately, since parts per million is used for very low concentrations. (Here, \"solute,\" \"solvent,\" \"solution,\" and \"dissolved\" are used non-technically.) For gases dissolved in gases, #$PartsPerMillion reflects a ratio of volumes; for solutes dissolved in liquids, #$PartsPerMillion reflects a ratio of masses (or weights). Note that #$PartsPerMillion is equivalent to (#$PerFn #$MilliGram #$Liter) only for water-based solutions. By definition, one liter of water has a mass of one kilogram at standard temperature and pressure, so one milligram of solute in one liter of a water-based solution is approximately equivalent to one milligram of solute per one kilogram of solvent, i.e. one milligram per one million grams (1 kg = 1,000 g = 1,000,000 mg), i.e. 1 part per million. But other solvents have different densities, i.e have masses different from 1 kg per liter at standard temperature and pressure, and so (#$PerFn #$MilliGram #$Liter) is equivalent to #$PartsPerMillion only for water-based solutions.")
(comment PrivilegeLevelType "The PrivilegeLevelType of a program or account on a computational system corresponds to the range of files the program is able to create, modify, or delete when it executes. For example, if a program or account has RootPrivilege, then it is able to modify, create, or delete any file on the (Unix) system. ")
(comment CMLCompoundDatabase "An instance of #$Database-Physical containing technical information on a number of chemical substances.")
(comment ServiceProduct "The collection of all #$ServiceEvents for which payment is made.")
(comment portsOfCall "The predicate #$portsOfCall indicates the places at which a ship or watercraft can be located.  (#$portsOfCall WATERCRAFT LOC) means that the #$Watercraft WATERCRAFT can be contacted at the #$ContactLocation LOC.")
(comment airportHasICAOCode "(#$airportHasIATACode AIRPORT STRING) means that the instance of #$Airport-Physical AIRPORT has been designated with the ICAO code STRING.")
(comment SlightlyToxic-HodgeAndSternerScale "An instance of #$Toxicity. A type of substance is #$SlightlyToxic-HodgeAndSternerScale if it has a toxicity rating of 4 on the Hodge and Sterner scale of toxicity classes.")
(comment RelativelyHarmless-HodgeAndSternerScale "An instance of #$Toxicity. A type of substance is #$RelativelyHarmless-HodgeAndSternerScale if it has a toxicity rating of 6 on the Hodge and Sterner scale of toxicity classes.")
(comment AllPeopleAreHumanMt "The microtheory in which the only people are human.")
(comment MinimalTimeIntervalCoveringDatesFn "(#$MinimalTimeIntervalCoveringDatesFn DATE-1 DATE-2 DATE-N) returns the minimal time
interval that subsuming all the dates DATE-1,...,DATE-N. For example, 
(#$MinimalTimeIntervalCoveringDatesFn (#$DayFn 29 (#$MonthFn #$June (#$YearFn 1968)))
(#$DayFn 28 (#$MonthFn #$June (#$YearFn 1968))) (#$DayFn 30 (#$MonthFn #$June (#$YearFn 1968))))
returns (#$TimeIntervalInclusiveFn (#$DayFn 28 (#$MonthFn #$June (#$YearFn 1968))) (#$DayFn 30 (#$MonthFn #$June (#$YearFn 1968)))).")
(comment transportOfTypeWithin "The #$functionCorrespondingPredicate-Canonical of #$TransportOfTypeWithinFn.")
(comment TransportViaInRegionFn "(#$TransportViaInRegionFn TRANSPORTER-TYPE REGION) denotes the collection of all instances of #$TransportationEvent in which the #$transporter is an instance of TRANSPORTER-TYPE, and such that the #$toLocation and #$fromLocation are both within REGION.")
(comment transportViaInRegion "The #$functionCorrespondingPredicate-Canonical for #$TransportViaInRegionFn.")
(comment Screenwriter "The collection of people who write screenplays for a living.")
(comment ArtifactTypeByFunction "A collection of collections; a subcollection of #$ArtifactTypeByGenericCategory. Instances of #$ArtifactTypeByFunction are mutually unique with respect to the full set of the primary intended uses of their instances. Examples include #$DessertFood and #$Sofa-PieceOfFurniture. Counter-examples include #$FountainPen (which has the same primary function as its genls, #$WritingPen) and #$FurniturePiece (specs of which have different primary uses). There may be cases where two instances of #$ArtifactTypeByFunction (PROD1 and PROD2) are related by (#$genls PROD1 PROD2); but this will only happen in cases where instances of PROD1 have some additional primary function(s) to those of PROD2. For example, the collections #$Sofa-PieceOfFurniture and #$SofaBed are both instances of #$ArtifactTypeByFunction, and (#$genls #$SofaBed #$Sofa-PieceOfFurniture) is true.")
(comment assistedUsageType "(#$assistedUsageType TOOL COLLECTION) holds just in case COLLECTION is the collection of people who need assistance while using TOOL.  See also the corresponding function #$AssistedUsageFn.")
(disjointWith AttackOnObject HidingAnObject)
(comment objectHidden "(#$objectHidden HIDING OBJECT) means that OBJECT is the object hidden in the #$HidingAnObject event HIDING.  When HIDING involves moving OBJECT -- see #$HidingAnObjectByMovingIt -- OBJECT is also the #$primaryObjectMoving.  When HIDING is an instance of #$HidingOneself, OBJECT is also the performer.")
(comment hidesFrom "(#$hidesFrom HIDING SEEKER) means that the purpose of HIDING is to hide OBJECT (the #$objectHidden) from SEEKER.  SEEKER may be a specific agent or a group of agents (e.g., 'the authorities'). ")
(comment HidingOneself "The collection of #$HidingAnObject events in which the performer is also the #$objectHidden; i.e., the collection of events in  which one agent hides herself from others. #$HidingOneself events are unusual in one other respect.  Instances of #$HidingAnObject, which involve taking steps to obscure an object's location, are typically followed by a static situation during which the object remains hidden.  However, instances of #$HidingOneself often persist over the full length of the 'hiding' period, as the agent continues to take or refrain from certain actions in an attempt to remain hidden.")
(comment zodiacSignDateRange "(#$zodiacSignDateRange SIGN BEGIN-DAY END-DAY) state that the range of dates for the #$ZodiacSign SIGN ranges from BEGIN-DAY to END-DAY.  See also #$hasZodiacSign.")
(comment ChemicalAttack-Terrorist "A specialization of both #$ChemicalAttack and #$PurposefulAction-ResourceDrivenWithTransfer.  Each instance involves three sub-event types. First, there is a #$GainingControl of a #$ChemicalWeapon.  Second, there is a #$DirectedTranslation.  Third, there is a #$DeployingAChemicalAgent.")
(comment DisasterFn "<code>(#$DisasterFn SIT-TYPE)</code> is a subcollection denoting function which takes as its argument a subcollection of #$DangerousSituation, <code>SIT-TYPE</code>, and returns a collection of events that is both a subcollection of #$DisasterEvent and of the collection <code>SIT-TYPE</code>.  The collection which is returned contains those instances of the <code>SIT-TYPE</code> where large numbers of persons have been harmed or large quantities of property have been damaged.  For example, (#$DisasterFn #$Earthquake) would pick out the subcollection of #$Earthquake in which significant harm or damage occurs.")
(comment ParseTreeRepresentationVocabularyMt "A #$Microtheory for defining vocabulary for representing parse trees in CycL.")
(comment ChemicalReaction-IntentionalFn "#$ChemicalReaction-IntentionalFn is a collection denoting function.  It takes as its argument an instance of #$ChemicalSubstanceType and returns a subcollection of the script #$ChemicalReaction-Intentional for which the #$outputsCreated are instances of that #$ChemicalSubstanceType.  It should be noted that the #$ChemicalSubstanceType that bear the relation #$precursors-Chemical to the #$outputsCreated  will be #$inputs for the resultant collection of scripts.")
(comment facetBasedOnPredicateArg "A #$TernaryPredicate that is used to assert that a special relation holds between a #$FacetingCollectionType and a #$Predicate -- that the former is \"based on\" the latter in a specific sense.
<p>
Where <code>(#$facets-Generic COL FACET-COL)</code> and <code>PRED</code> is an n-place predicate, <code>(#$facetBasedOnPredicateArg FACET-COL PRED ARG)</code> means that for all <code>X</code> in <code>FACET-COL</code>, there is an ordered n-tuple <<code>Y<sub>1</sub>,...,Y<sub>n</sub></code>> such that, by the definition of <code>X</code>, for any <code>Z</code> in <code>COL</code>, <code>Z</code> is in <code>X</code> iff the result of replacing <code>Y<sub>ARG</sub></code> with <code>Z</code> in <code>(PRED Y<sub>1</sub>...Y<sub>n</sub>))</code> holds.
<p>
For example, <code>(#$facetBasedOnPredicateArg #$WineTypeByColor #$uniformColorOfObject 1)</code> means that for all <code>WINE-TYPE</code> in #$WineTypeByColor, there is an ordered pair <<code>DUMMY, COLOR</code>> such that, by the definition of <code>WINE-TYPE</code>, for any <code>WINE</code> in #$Wine, <code>WINE</code> is in <code>WINE-TYPE</code> iff the result of replacing <code>DUMMY</code> with <code>WINE</code> in <code>(#$uniformColorOfObject DUMMY COLOR)</code>, i.e. <code>(#$uniformColorOfObject WINE COLOR)</code>, holds.
<p>
Note that it is also true that <code>(#$facetBasedOnPredicateArg #$PersonTypeByOccupation #$isa 1)</code>.  Indeed, <code>(#$facetBasedOnPredicateArg FACET-COL #$isa 1)</code> is trivially true for any <code>FACET-COL</code>, since the following is a logical truth:
<pre>
(#$forAll ?X 
  (#$thereExists ?Y 
    (#$forAll ?Z 
      (#$equiv (#$isa ?Z ?X) (#$isa ?Z ?Y)))))
</pre>
For precisely this reason, there is no point in asserting that a facet is based on #$isa.
<p>
For the very common special case in which <code>PRED</code> is a #$BinaryPredicate, see #$facetBasedOnBinaryPred and #$facetBasedOnBinaryPredInverse.  (Note that the meanings of these latter two predicates are much easier to understand.)  See also #$facetBasedOnTypePredicateArg.")
(comment DeliveryOfWeaponToTarget "#$DeliveryOfWeaponToTarget is the collection of events in which a weapon is delivered to a location prior to use. For example, the delivery phase of an missile involves a launch and rocket propulsion before detonation. Delivery of an AerialBomb on the other hand involves being flown to a place above the target and then dropping. In some cases the weapon is transported to the target, in other cases it undergoes projectile motion or propels itself to the target.")
(comment HypothesizedInstance "#$HypothesizedInstance is the collection of entities explicitly posited by Cyc in the process of hypothetical reasoning, which may or may not be \"unified\" with known entities as that reasoning progresses. (They are recognisable by names such as \"HYP-Toothbrush-11867\".)")
(comment properParts "An #$AsymmetricBinaryPredicate and a specialization of #$parts. This predicate relates individuals to other individuals which are their proper parts (i.e., parts that are different from the whole). 
<p>
<code>(#$properParts WHOLE PART)</code> means that:<br>
(1) <code>PART</code> is a part of <code>WHOLE</code> (in the very broad sense in which #$parts is defined, meaning basically that a complete description of <code>WHOLE</code> would have to involve a description of <code>PART</code>), and<br> 
(2)<code>PART</code> is not identical to <code>WHOLE</code> itself.
<p>
There is a range of useful specializations of this predicate.  For example, for individuals that are instances of #$Situation, see the more specific #$properSubSituations.")
(comment SocialStatusCollectionType "This is a collection of collections.  Each #$SocialStatusCollectionType is itself a coherent collection of collections that pertain to human behavior.  This definition is very broad, and embraces attributes of behavior (personal and social) one might read about in a sociology, psychology, cultural anthropology, economics, political science, or social philosophy course -- in short, in the (human) `behavioral' sciences.")
(comment hotelInRegion "(#$hotelInRegion BLDG REGION) means that the #$HotelBuilding BLDG is found in the #$GeographicalRegion REGION.")
(comment succeedingValueOnScale "A specialization of #$followingValueOnScale (q.v.) that is used to compare the positions or \"ranks\" of adjacent quantities/attributes/properties on the same scale.  More precisely,
<code>(#$succeedingValueOnScale VALUE1 VALUE2 SCALE)</code> means that <code>VALUE1</code> and <code>VALUE2</code> are both instances of the #$CollectionWithAnEventLikeOrder <code>SCALE</code>, and that <code>VALUE2</code> is the successor of (i.e. comes immediately after) <code>VALUE1</code> in the ordering scheme conventionally associated with <code>SCALE</code>.
<p>
Typically, <code>VALUE1</code> and <code>VALUE2</code> will either (i) both be instances of #$Quantity (q.v.) or (ii) both be instances of #$FirstOrderCollection (q.v.) such that they correspond to properties of individuals.  In case (i), <code>SCALE</code> will be a #$TotallyOrderedQuantityType, and <code>(#$followingValue VALUE1 VALUE2)</code> will hold.
<p>
For example, this holds:
<p>
<pre>
  (#$succeedingValueOnScale
    (#$MilitaryUnitTypeOfSizeFn #$Platoon-MilitaryEchelon)
    (#$MilitaryUnitTypeOfSizeFn #$Squad-MilitaryEchelon)
    #$MilitaryUnitTypeByEchelonSize) .
</pre>")
(comment brightnessInRange "(#$brightnessInRange BRIGHT VALUE-1 VALUE-2) means that
BRIGHT is a #$MunsellBrightness with a value somewhere between
VALUE-1 and VALUE-2 on the Munsell scale of brightness. Munsell
brightnesses are represented using #$MunsellBrightnessFn. For
further information, please see #$MunsellBrightness and the
#$SharedNoteOnMunsellSystemOfColorClassification.")
(comment chromaInRange "(#$chromaInRange BRIGHT VALUE-1 VALUE-2) means that CHROMA
is a #$MunsellChroma with a value somewhere between VALUE-1 and
VALUE-2 on the Munsell scale of saturation. Munsell chromas are
represented using #$MunsellChromaFn. For further information,
please see #$MunsellChroma and the
#$SharedNoteOnMunsellSystemOfColorClassification.")
(comment hueInRange "(#$hueInRange BETWEEN-HUE HUE-1 HUE-2) means that
BETWEEN-HUE is a #$MunsellHue with a value somewhere between
HUE-1 and HUE-2 on the Munsell scale of hue. Munsell hues are
represented using group of functions that return instances of
instances of #$MunsellHue.  For further information, please see
#$MunsellHue, and the
#$SharedNoteOnMunsellSystemOfColorClassification.")
(comment colorRangeOfType "(#$colorRangeOfType TYPE COLOR-1 COLOR-2) means that all
instances of TYPE have some color between COLOR-1 and COLOR-2. For
example, (#$colorRangeOfType #$Granite #$DarkGrayishOlive-Color
#$GrayishPink-Color) means that individual pieces of granite will have a
color somewhere between dark grayish olive and grayish pink. The
meaning of 'between' here is determined by the Munsell system of color
classification. Each color in this system has distinct values for
brightness, chroma, and hue. The range specified by #$colorRangeOfType
is described by three intervals: its brightness extends from the
brightness of the darker color to the brighter one, and its chroma
extends from the less saturated color to the richer one. The matter of
hue is a bit more complex, because hue has a cyclic rather than linear
order. The rules governing #$colorRangeOfType will assume the range of
hue will extend from arg2 to arg3. So (#$colorRangeOfType TYPE
#$PurpleColor #$RedColor) specifies a range of hues from purple
through magenta all the way to red, but (#$colorRangeOfType TYPE
#$RedColor #$PurpleColor) specifies a range that goes 'all the way
around the color wheel' from red to orange, yellow, green, blue, and
purple again - excluding only magenta.  Therefore, exercise caution in
ordering COLOR-1 and COLOR-2. Please see #$MunsellHue for
information on how the hues are ordered. For further information about
color values, see #$MunsellBrightness, #$MunsellChroma, and
#$SharedNoteOnMunsellSystemOfColorClassification.")
(comment Translucent "#$Translucent is an #$ObjectTypeByTransparency
representing the all the degrees of transparency between
#$Opaque and #$Transparent. Translucent objects can transmit
light, but not enough to see clear images. When possible, avoid making
assertions directly on #$Translucent - use its five specs
instead. See #$ObjectTypeByTransparency and #$transparencyOfObject for more
information.")
(comment VerySlightlyTranslucent "A specialization of #$Translucent representing a
specific degree of transparency.  Objects that are
#$VerySlightlyTranslucent will block all but the brightest light
and transmit no images.  Poster board that can be penetrated by a
flash bulb would be considered #$VerySlightlyTranslucent.  Please
see #$ObjectTypeByTransparency and #$transparencyOfObject for more information.")
(comment SlightlyTranslucent "A specialization of #$Translucent representing a
specific degree of transparency.  Objects that are
#$SlightlyTranslucent block most light and can transmit only
silhouettes. Heavy plastics and paper stock would be considered
SlightlyTranslucent.  Please see #$ObjectTypeByTransparency and
#$transparencyOfObject for more information.")
(comment ModeratelyTranslucent "A specialization of #$Translucent representing a
specific degree of transparency.  Objects that are
ModeratelyTranslucent transmit enough light to see indistinct
images with some color but no detail. Standard white paper and the
leaves of trees would be considered ModeratelyTranslucent.
Please see #$ObjectTypeByTransparency and #$transparencyOfObject for more
information.")
(comment HighlyTranslucent "A specialization of #$Translucent representing a
specific degree of transparency.  Objects that are
HighlyTranslucent transmit enough light to see hazy or blurry
images. Showerd door and plastic food containers would be considered
HighlyTranslucent.  Please see #$ObjectTypeByTransparency and
#$transparencyOfObject for more information.")
(comment VeryHighlyTranslucent "A specialization of #$Translucent representing a
specific degree of transparency.  Objects that are
VeryHighlyTranslucent transmit enough light to see images, but
color or distort the images in some some way. Wine bottles and fresnel
lenses would be considered VeryHighlyTranslucent. Please see
#$ObjectTypeByTransparency and #$transparencyOfObject for more information.")
(comment transparencyOfType "(#$transparencyOfType TYPE TRANS) holds just in case every
instance of TYPE INS, is such that (#$transparencyOfObject INS TRANS).
That is, just in case each instance is an instance of ?TRANS. Given
that #$transparencyOfObject is a specialization of #$genls, it then
follows that (#$genls TYPE TRANS).")
(comment transparencyRangeOfType "(#$transparencyRangeOfType TYPE TRANS-1 TRANS-2) means that all instances of TYPE have some transparency between TRANS-1 and TRANS-2. For example, (#$transparencyRangeOfType #$Glass #$ModeratelyTranslucent #$Transparent) means that individual pieces of glass will have a transparency somewhere between moderately translucent and completely transparent. Note that 'between' here means 'equal to or more than the lower limit and less than or equal to the upper limit.")
(comment CycInterlocutorUtterance "The collection of all utterances contributed in Interlocutor sessions: each instance is a speech act -- assertion, question, etc. -- entered by a user as part of a more or less coherent discourse. ")
(comment tokenizationInputString "(#$tokenizationInputString TOKENIZATION STRING) means that the

input to TOKENIZATION is STRING.")
(comment PoisoningFromSubstanceTypeViaExposureTypeFn "A binary collection-denoting function that creates specs of #$Poisoning from specs of #$PartiallyTangible and specs of #$ExposureToSubstance. (#$PoisoningFromSubstanceTypeViaExposureTypeFn SUBSTANCE EXPOSURE) denotes the collection of all events in which someone is poisoned by virtue of being exposed to SUBSTANCE in the way designated by EXPOSURE. For example, (#$PoisoningFromSubstanceTypeViaExposureTypeFn #$Ammonia #$Inhaling) denotes the collection of all events in which someone is poisoned by ammonia inhalation.")
(comment tokenEndCharNum "(#$tokenEndCharNum TOKEN N) means that TOKEN ends with the Nth
character of its tokenization's input string, where the first character
is character 0.")
(comment tokenString "(#$tokenString TOKEN STRING) means that STRING is the string that has been
assigned to TOKEN in the tokenization process.")
(comment CycParsingTokenFn "(#$CycParsingTokenFn N TOKENIZATION) denotes the (n+1)-th token of TOKENIZATION (so for the first token, N = 0).")
(comment CycParsingTokenContiguousSetFn "(#$CycParsingTokenContiguousSetFn START END TOKENIZATION) denotes the
set of contiguous parsing tokens from START to END - inclusive - of TOKENIZATION.")
(comment numberOfTokensInTokenization "(#$numberOfTokensInTokenization TOKENIZATION N) denotes the cardinality
of the tokens in a particular tokenization.")
(comment nthTokenInTokenization "(#$nthTokenInTokenization TOKENIZATION I TOKEN) denotes that within the
context of the particular TOKENIZATION, the TOKEN has the position I, where I is
an integer between 0 and the value N denoted by (#$numberOfTokensInTokenization TOKENIZATION N).")
(comment Tokenizer "#$Tokenizer is the collection of all agents which decompose input
into discrete units of output, i.e. tokens. In some disciplines of computer science, 
such agents can be called lexical analyzers.")
(comment tokenTokenizer "(#$tokenTokenizer PARSING-TOKEN TOKENIZER) denots that the parsing token
expression PARSING-TOKEN was created by the software agent TOKENIZER.")
(comment ParseTree "#$ParseTree denotes the collection of all parse trees that
are constructed for any language, whether natural or artificial,
by whichever method.")
(comment NaturalLanguageParseTree "#$NaturalLanguageParseTree is the collection of all parse
trees that are constructed for natural language analysis and
processing, regardless of theory assumed, method employed or
implementation.")
(comment CycParseTree "#$CycParseTree denotes those natural language parse trees that are constructed according to the parsing theory expressed by
the NL research at Cycorp.")
(comment CycParseTreeFn "(#$CycParseTreeFn N TOKENIZATION) denots one CYC parse tree that can be
derived from the tokens of TOKENIZATION.")
(comment ActorInScriptExpansion "ActorInScriptExpansion is an instance of ScenGenExpansionSpecification. Given a known OBJ whose nearest TYPE plays ROLE in a SCRIPT and a known instance of SCRIPT, EVENT, we will hypothesize that OBJ plays ROLE in EVENT.")
(comment DNAVirus "A specialization of #$Virus.  Each instance of this 
collection contains DNA which it uses as its primary genetic material.")
(comment Herpes-Virus "A specialization of #$DNAVirus and a collection of #$VirusTypes including those that cause #$Herpes, coldsores and chickenpox.")
(comment RNAVirus "The specialization of #$Virus and a collection of #$VirusTypes that contain RNA as their basic genetic material.  #$Retrovirus is one of the best known specializations of this group, but not all members of this group use reverse transcriptase.")
(disjointWith DNAVirus RNAVirus)
(comment ArenaVirus "A collection of types within #$RNAVirus.   #$SabiaHemorrhagicFeverInfection, #$Machupo and #$LassaFever are examples of diseases caused by this group.")
(comment Hantavirus "A #$BiologicalGenus within the #$BunyaviridaeVirus family.  It includes the #$SinNombre-Virus.")
(comment CycSyntacticNodeFn "(#$CycSyntacticNodeFn N TOKENIZATION) denotes a syntactic node derived
from TOKENIZATION that has the unique identification number N within the overall
syntactic analysis of the TOKENIZATION.")
(comment syntacticRootOfParseTree "(#$syntacticRootOfParseTree PARSETREE NODE) denotes the syntactic node
which grounds PARSETREE. This node should not be a descendant node (c.f. #$syntacticDescendants) of any other node.")
(comment syntacticNodeCategory "(#$syntacticNodeCategory NODE CATEGORY) denotes the syntactic
CATEGORY that the syntactic NODE has.")
(comment syntacticNodeCoversTokenSet "(#$syntacticNodeCoversTokenSet NODE TOKENS) means that TOKENS is the set of parsing tokens covered by NODE.")
(comment syntacticNodeCoversToken "(#$syntacticNodeCoversToken NODE TOKEN) means that the syntactic NODE
accounts for the TOKEN in its interpretation.")
(comment syntacticDaughters "(#$syntacticDaughters MOTHER DAUGHTER) means that the syntactic node MOTHER has the syntactic node DAUGHTER as one of its direct syntactic children.")
(comment Giardia "A specialization of #$Protozoan that includes the organism 
that causes #$Giardiasis in humans and animals.")
(comment GiardiaIntestinalis "A specialization of #$Giardia that can cause #$Giardiasis in 
humans and animals if ingested.")
(comment Doxycycline "A specialization of #$TetracyclineAntibiotic that is relatively inexpensive.")
(comment SyntacticInterpretationAgent "#$SyntacticInterpretationAgent denotes the collection of all software agents that produce syntactic interpretations.")
(comment CycSyntacticInterpretationAgent "#$CycSyntacticInterpretationAgent denotes the collection of
all syntactic interpretation software agents that make use of the CYC
project.")
(comment syntacticNodeSupporter "(#$syntacticNodeSupporter AGENT NODE) means that AGENT supports the syntactic analysis expressed in the adding of NODE to the graph.")
(comment IntravenousHydrationEvent "Similar to #$BloodTransfusionEvent except that the 
#$primaryObjectMoving is #$Water.  This would include transfusions of saline solutions.")
(comment LymeDisease "A disease spread by #$Ticks in the #$Ixodes-Genus.")
(comment Ixodes-Genus "A #$BiologicalGenus specializing the #$BiologicalFamily #$IxodidTick, containing #$Ticks.  Species in this genus are best known as vectors of #$LymeDisease.")
(comment PeromyscusGenus "A collection of species of #$Mouse-Rodent, common in North 
America.")
(comment DeerMouse "A kind of #$Mouse-Rodent that is common in North America.  Believed to be the primary natural reservoir for #$SinNombre-Virus.")
(comment Bordetella-Genus "A collection of #$GramNegativeBacterium.  One specialization, #$BordetellaPertussis-Species, causes #$WhoopingCough in #$HomoSapiens.  Other specializations have caused similar coughing illnesses.")
(comment interArgEqualsIsa "A quintary instance of #$InterArgEqualsIsaPredicate (q.v.). (#$interArgEqualsIsa RELN INDEP-ARGNUM INDEPENDENT-ARG DEP-ARGNUM DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the INDEP-ARGNUMth argument to RELN, a necessary condition for semantic well-formedness is that the DEP-ARGNUMth argument must be an instance of DEPENDENT-ARG-COL. That is, (RELN ... INDEPENDENT-ARG ...), where INDEPENDENT-ARG is the INDEP-ARGNUMth argument to RELN, is semantically well-formed only if the DEP-ARGNUMth argument is an instance of DEPENDENT-ARG-COL.
<p>
For example, (#$interArgIsa #$softwareParameterValueInSpecification 1 #$InferenceSentenceParameter 2 #$ELSentence-Assertible) means that (#$softwareParameterValueInSpecification #$InferenceSentenceParameter VALUE SPEC) is semantically well-formed only if VALUE is an instance of #$ELSentence-Assertible.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. For similar to but less flexible predicates than #$interArgEqualsIsa, which have already-fixed positions for the independent and dependent arguments, see the ternary #$interArgEqualsIsa1-2 et al.  Cf. #$interArgIsa.")
(comment interArgEqualsIsa1-3 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa1-3 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the first argument to RELN, a necessary condition for semantic well-formedness is that the third argument must be an instance of DEPENDENT-ARG-COL.  That is, (RELN INDEPENDENT-ARG ARG2 ARG3 ...) is semantically well-formed only if ARG3 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa1-4 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa1-4 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the first argument to RELN, a necessary condition for semantic well-formedness is that the fourth argument must be an instance of DEPENDENT-ARG-COL. That is, (RELN INDEPENDENT-ARG ARG2 ARG3 ARG4 ... ) is semantically well-formed only if ARG4 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa1-5 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa1-5 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the first argument to RELN, a necessary condition for semantic well-formedness is that the fifth argument must be an instance of DEPENDENT-ARG-COL. That is, (RELN INDEPENDENT-ARG ARG2 ARG3 ARG4 ARG5 ... ) is semantically well-formed only if ARG5 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa2-1 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa2-1 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the second argument to RELN, a necessary condition for semantic well-formedness is that the first argument must be an instance of DEPENDENT-ARG-COL.  That is, (RELN ARG1 INDEPENDENT-ARG ...) is semantically well-formed only if ARG1 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa2-3 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa2-3 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the second argument to RELN, a necessary condition for semantic well-formedness is that the third argument must be an instance of DEPENDENT-ARG-COL. That is, (RELN ARG1 INDEPENDENT-ARG ARG3 ...) is semantically well-formed only if ARG3 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa2-4 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa2-4 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the second argument to RELN, a necessary condition for semantic well-formedness is that the fourth argument must be an instance of DEPENDENT-ARG-COL. That is, (RELN ARG1 INDEPENDENT-ARG ARG3 ARG4 ...) is semantically well-formed only if ARG4 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa2-5 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa2-5 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the second argument to RELN, a necessary condition for semantic well-formedness is that the fifth argument must be an instance of DEPENDENT-ARG-COL.  That is, (RELN ARG1 INDEPENDENT-ARG ARG3 ARG4 ARG5 ...) is semantically well-formed only if ARG5 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa3-1 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa3-1 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the third argument to RELN, a necessary condition for semantic well-formedness is that the first argument must be an instance of DEPENDENT-ARG-COL. That is, (RELN ARG1 ARG2 INDEPENDENT-ARG ...) is semantically well-formed only if ARG1 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa3-2 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa3-2 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the third argument to RELN, a necessary condition for semantic well-formedness is that the second argument must be an instance of DEPENDENT-ARG-COL. That is, (RELN ARG1 ARG2 INDEPENDENT-ARG ...) is semantically well-formed only if ARG2 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa3-4 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa3-4 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when the term INDEPENDENT-ARG appears as the third argument to RELN, a necessary condition for semantic well-formedness is that the fourth argument must be an instance of DEPENDENT-ARG-COL. That is, (RELN ARG1 ARG2 INDEPENDENT-ARG ARG4 ...) is semantically well-formed only if ARG4 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa3-5 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa3-5 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the third argument to RELN, a necessary condition for semantic well-formedness is that the fifth argument must be an instance of DEPENDENT-ARG-COL. That is, (RELN ARG1 ARG2 INDEPENDENT-ARG ARG4 ARG5...) is semantically well-formed only if ARG5 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa4-1 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa4-1 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the fourth argument to RELN, a necessary condition for semantic well-formedness is that the first argument must be an instance of DEPENDENT-ARG-COL.  That is, (RELN ARG1 ARG2 ARG3 INDEPENDENT-ARG ...) is semantically well-formed only if ARG1 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa4-2 "A ternary instance of #$InterArgIsaPredicate (q.v.).  (#$interArgEqualsIsa4-2 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that when INDEPENDENT-ARG appears as the fourth argument to RELN, a necessary condition for semantic well-formedness is that the second argument must be an instance of DEPENDENT-ARG-COL.  That is, (RELN ARG1 ARG2 ARG3 INDEPENDENT-ARG ...) is semantically well-formed only if ARG2 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa4-3 "A ternary instance of #$InterArgIsaPredicate (q.v.).  (#$interArgEqualsIsa4-3 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the fourth argument to RELN, a necessary condition for semantic well-formedness is that the third argument must be an instance of DEPENDENT-ARG-COL. That is, (RELN ARG1 ARG2 ARG3 INDEPENDENT-ARG ...) is semantically well-formed only if ARG3 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa4-5 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa4-5 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the fourth argument to RELN, a necessary condition for semantic well-formedness is that the fifth argument must be an instance of DEPENDENT-ARG-COL.  That is, (RELN ARG1 ARG2 ARG3 INDEPENDENT-ARG ARG5 ...) is semantically well-formed only if ARG5 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa5-1 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa5-1 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the fifth argument to RELN, a necessary condition for semantic well-formedness is that the first argument must be an instance of DEPENDENT-ARG-COL.  That is, (RELN ARG1 ARG2 ARG3 ARG4 INDEPENDENT-ARG ...) is semantically well-formed only if ARG1 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations. See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa5-2 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa5-2 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the fifth argument to RELN, a necessary condition for semantic well-formedness is that the second argument must be an instance of DEPENDENT-ARG-COL.  That is, (RELN ARG1 ARG2 ARG3 ARG4 INDEPENDENT-ARG ...) is semantically well-formed only if ARG2 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations.  See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa5-3 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa5-3 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the fifth argument to RELN, a necessary condition for semantic well-formedness is that the third argument must be an instance of DEPENDENT-ARG-COL.  That is, (RELN ARG1 ARG2 ARG3 ARG4 INDEPENDENT-ARG ...) is semantically well-formed only if ARG3 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations.  See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment interArgEqualsIsa5-4 "A ternary instance of #$InterArgIsaPredicate (q.v.). (#$interArgEqualsIsa5-4 RELN INDEPENDENT-ARG DEPENDENT-ARG-COL) means that, when INDEPENDENT-ARG appears as the fifth argument to RELN, a necessary condition for semantic well-formedness is that the fourth argument must be an instance of DEPENDENT-ARG-COL. That is, (RELN ARG1 ARG2 ARG3 ARG4 INDEPENDENT-ARG ...) is semantically well-formed only if ARG4 is an instance of DEPENDENT-ARG-COL.
<p>
For an explanation of semantic well-formedness, see #$CycLExpression-Assertible and its direct specializations.  See #$interArgEqualsIsa for a similar but more general predicate that is quintary, allowing the user to specify the positions of the independent and dependent arguments.")
(comment assertedMoreSpecifically "<code>(#$assertedMoreSpecifically GENL-SENTENCE)</code> states that there exists a <code>SPEC-SENTENCE</code> which is an asserted sentence that is more specific than <code>GENL-SENTENCE</code>, but implies <code>GENL-SENTENCE</code>.  For example, were
<p>
(#$isa #$and #$LogicalConnective)
<p>
to be asserted, we would have
<p>
(#$assertedMoreSpecifically (#$isa #$and #$Relation))
<p>
since (#$genls #$LogicalConnective #$Relation).")
(comment RecreationalFn "A function used to denote the collection of all instances of a given spec of #$AtLeastPartiallyMentalEvent that are done for recreational purposes, i.e., that are considered instances of #$RecreationalActivity.")
(comment recreationalInstancesOf "The corresponding predicate of #$RecreationalFn.")
(disjointWith CommercialAircraft PrivatePlane)
(comment PrivatePlane "The class of all privately owned airplanes that are not used for purposes of commercial air transport.")
(comment FlightTrainingType "A type-level collection of all collections constituting recognized types of #$FlightTraining.")
(comment FlightTraining-Private "A type of #$FlightTraining, wherein the trainee is trained to fly a #$PrivatePlane.")
(comment FlightTraining-Student "A type of flight training in which the person being instructed has never previously flown an aircraft.")
(comment syntacticNodeCreator "(syntacticNodeCreator AGENT NODE) 
means that the SyntacticInterpretationAgent AGENT was the one who introduced the
SyntacticNode NODE into the intepretation graph.")
(comment LexicalNode "LexicalNode is the collection of all syntactic nodes that
model the mapping from a token set to a semantic, either denotational
or propositional, ground or templated.")
(comment CycLexicalNodeFn "(CycLexicalNodeFn N TOKENIZATION) denotes the Nth lexical
node in the syntactic parse of TOKENIZATION.")
(comment lexicalNodeInterpretation "(lexicalNodeInterpretation NODE THING) denots that the
term THING is a valid lexical interpretation for NODE.")
(comment lexicalNodeCategory "(lexicalNodeCategory NODE SPEECHTYPE) denots the lexical
node category of NODE, associating with the word form SPEECHTYPE.")
(comment lexicalNodeCoversToken "(lexicalNodeCoversToken NODE TOKEN) means that TOKEN is among the
parsing tokens covered by the lexical interpretation NODE.")
(comment lexicalNodeCoversTokenSet "(#$lexicalNodeCoversTokenSet NODE TOKENS) means that TOKENS is the
set of parsing tokens covered by the lexical interpretation of NODE.")
(comment LexicalInterpretationAgent "The collection of all software agents that engage in lexical
interpretation. This could range from simple word lookup schemes to
sophisticated morphological parsers.")
(comment lexicalNodeCreator "(lexicalNodeCreator AGENT NODE) means that the
LexicalInterpretationAgent AGENT was the one who introduced the
lexical node NODE into the intepretation graph.")
(comment lexicalNodeSupporter "(lexicalNodeSupporter AGENT NODE) means that the
LexicalInterpretationAgent AGENT supports the lexical analysis
expressed in the adding of LexicalNode NODE to the graph.")
(comment penetrativeToxicityFor "A predicate for indicating the level of toxicity a substance
has (under normal circumstances) when it penetrates (e.g. by an
arrow or insect stinger) the external surface of some instance
of some type of #$BiologicalLivingObject.
(#$penetrativeToxicityFor SUBSTANCE BLO-TYPE TOX) means that
under normal circumstances SUBSTANCE will have a toxicity
level of TOX when it penetrates the surface layer
of a #$BiologicalLivingObject BLO via,
e.g., a sharp object or body part,
where BLO is a typical instance of BLO-TYPE.
See also #$PenetrativeToxinType.")
(comment PenetrativeToxinType "A specialization of #$HazardousChemicalSubstanceType (q.v.).
Each instance of #$PenetrativeToxinType is a collection
each of whose instances is by default toxic when it
penetrates the skin of some instance of #$HomoSapiens (say via an arrow, knife
or insect stinger).  See #$penetrativeToxicityFor.")
(comment PenetratingOuterLayerOfBLO "A specialization of #$PhysicalContactMakingEvent (q.v.).
This collection includes all #$PhysicalEvents in which
a \"sharp\" object (say a bullet, stinger, tooth or knife)
penetrates the _outer_layer_ of a #$BiologicalLivingObject
(in the case of an organism, this will often be its skin).
Since this collection includes only the _penetration_
of the outer layer, instances will usually be #$subEvents
of, for example, stabbing or puncturing events.
Common examples include an animal being scraped by a
knife or thorn, a woodpecker penetrating the bark of a tree or
a cell wall being penetrated.  See #$PenetratingOuterLayerOfBLOWithFn
          and #$PenetratingOuterLayerOfBLOFn.")
(comment PenetratingOuterLayerOfBLOWithFn "An instance of #$CollectionDenotingFunction (q.v.).
(#$PenetratingOuterLayerOfBLOWithFn SUB-TYPE)
denotes the collection of #$PhysicalEvents in which
an instance of SUB-TYPE penetrates the outer layer
of some #$BiologicalLivingObject.  Something
can penetrate a #$BiologicalLivingObject BLO
by (at least) two means: (1) an object itself penetrates the
BLO, as when a knife penetrates the skin of an
animal, or (2) an \"instrument\", such as a knife
or insect stinger, is used to push or inject a
substance through the outer layer of the BLO, as
when a knife edge or point is coated with some
substance.  In the latter case, both the
\"instrument\" and the substance penetrate 
the outer layer of the BLO.")
(comment penetratingOuterLayerOfBLOWithType "The corresponding predicate to #$PenetratingOuterLayerOfBLOWithFn.
(#$penetratingOuterLayerOfBLOWithType PENE-EVT SUB-TYPE) means that
PENE-EVT is the collection of events in which an instance of
SUB-TYPE penetrates the surface layer of some #$BiologicalLivingObject
via a \"sharp\" object, like a bullet, knife, thorn or tooth.")
(comment penetratingOuterLayerOfBLOTypes "The corresponding predicate to #$PenetratingOuterLayerOfBLOFn.
(#$penetratingOuterLayerOfBLOTypes PENE-EVT BLO-TYPE) means that
PENE-EVT is the collection of events in which a \"sharp\"
object, like a bullet, knife or thorn, penetrates the outer
surface of an instance of BLO-TYPE.")
(disjointWith ProductTypeByBrand ArtifactTypeByGenericCategory)
(comment ArtifactTypeByGenericCategory "An instance of #$SecondOrderCollection and a specialization of #$ArtifactType.  Each instance of #$ArtifactTypeByGenericCategory is a collection of #$Artifacts grouped together according to some feature(s) other than brand or model.")
(disjointWith RoadVehicleTypeByModel ArtifactTypeByGenericCategory)
(comment recipientOfPost-Intended "This predicate relates a #$SendingTangibleMail event to the agent receiving
the mail, or at least the agent intended to receive it by the agent sending the mail.
More precisely, (#$recipientOfPost-Intended MAILING RECIPIENT) means that an agent playing 
either the #$performedBy or #$directingAgent role in the #$SendingTangibleMail MAILING 
intends that some #$MailableObject playing the #$objectOfPossessionTransfer role in 
MAILING be possessed by RECIPEINT upon the completion of MAILING. Obviously, this does 
not entail that the #$MailableObject actually end up in RECIPIENT's possession, but the
agent in the #$performedBy or #$directingAgent role can have a reasonable expectation
that the event conclude in that manner.")
(comment PostalHandlingAndTransport "A subevent of #$SendingTangibleMail. #$PostalHandlingAndTransport
is the collection of all events of a #$ShippingOrganization sorting, routing, 
and carrying a #$MailableObject to its intended destination.")
(comment Posting "A subevent of #$SendingTangibleMail. #$Posting is the collection 
of all events of an agent placing a #$MailableObject in the control of some 
#$ShippingOrganization, with the intention of sending said object to a particular 
recipient.")
(comment imitationOf-CollColl "An instance of #$BinaryPredicate and
#$StrictlyFunctionalPredicate.  (imitationOf-CollColl COPY-COLL
ORIGINAL-COLL) says that COPY-COLL is the collection of all and only
things that have been created or (in the case of imitation of
situations) performed with the intention that they seem like instances of
ORIGINAL-COLL to someone. For example, (imitationOf-CollColl
ImitationFruit #$EdibleFruit) says that ImitationFruit is the
collection of all and only things that were designed to seem like
edible fruit. See #$seemsLikeTo. See also #$ImitationOfCollection,
#$ImitationOfCollectionFn, #$ImitationOfIndividual,
#$ImitationOfIndividualFn, #$imitationOf-IndColl,
#$imitationOf-IndInd, and #$imitationOf-CollInd")
(comment imitationOf-IndColl "An instance of #$BinaryPredicate, (imitationOf-IndColl COPY
ORIGINAL-COLL) says that COPY has been created or (in the case of
imitation of situations) performed with the intention that it seem like
instances of ORIGINAL-COLL to someone. For example,
(imitationOf-IndColl WaxApple-001 #$EdibleFruit) says that
WaxApple-001 was designed to seem like edible fruit. See
#$seemsLikeTo. See also #$ImitationOfCollection,
#$ImitationOfCollectionFn, #$ImitationOfIndividual,
#$ImitationOfIndividualFn, #$imitationOf-CollColl,
#$imitationOf-IndInd, and #$imitationOf-CollInd")
(comment imitationOf-CollInd "An instance of #$BinaryPredicate, (imitationOf-CollInd
COPY-COLL ORIGINAL) says that COPY-COLL is the collection of all and
only individuals that have been created or (in the case of imitation of
an event) performed with the intention that they
seem like ORIGINAL to someone. For example, (imitationOf-IndColl
ImitationsOfApple-001 Apple-001) says that all and only instances of
ImitationsApple-001 were designed to seem like Apple-001.  See
#$seemsLikeTo. See also #$ImitationOfCollection,
#$ImitationOfCollectionFn, #$ImitationOfIndividual,
#$ImitationOfIndividualFn, #$imitationOf-CollColl,
#$imitationOf-IndInd, and #$imitationOf-CollInd")
(comment imitationOf-IndInd "An instance of #$BinaryPredicate, (imitationOf-IndInd
COPY-COLL ORIGINAL) says that COPY has been created or (in the case of imitation of
an event) performed with the intention that it
seem like ORIGINAL to someone. For example, (imitationOf-IndInd
WaxApple-001 Apple-001) says that 
WaxApple-001 was designed to seem like Apple-001.  See
#$seemsLikeTo. See also #$ImitationOfCollection,
#$ImitationOfCollectionFn, #$ImitationOfIndividual,
#$ImitationOfIndividualFn, #$imitationOf-CollColl,
#$imitationOf-IndInd, and #$imitationOf-CollInd")
(comment imitationDeception-IndColl "An instance of #$BinaryPredicate and a specialization of
imitationOf-IndColl, (imitationDeception-IndColl COPY ORIGINAL) says
that COPY has been created or (in the case of imitation of situations)
with the intention that it seem to be an instance of ORIGINAL-COLL to
someone. Unlike #$imitationOf-IndColl, imitationDeception-IndColl
requires that the imitator intends to deceive someone into believing
that the imitation *is* an instance of the collection.")
(comment imitationDeception-IndInd "An instance of #$BinaryPredicate, and a specialization of
#$imitationOf-IndInd, (imitationDeception-IndInd COPY-COLL ORIGINAL) says that
COPY has been created or (in the case of imitation of a situation)
performed with the intention that it seem to be ORIGINAL to
someone. Unlike #$imitationOf-IndInd, imitationDeception-IndInd
requires that the imitator intends to deceive someone into believing
that the imitation *is* the original. ")
(comment FostersActionTypeSitTypeExpansion "<p>")
(comment airlineICAOCarrierCode "(#$airlineICAOCarrierCode AIRLINE STRING) means that the
instance of #$AirlineCompany AIRLINE is denoted by the International
Civil Aviation Organization (ICAO) code STRING.")
(comment airlineIATACarrierCode "(#$airlineIATACarrierCode AIRLINE STRING) means that the instance of #$AirlineCompany AIRLINE is denoted by the International Air Transport Association (IATA) code STRING.")
(comment flightNumber "(#$flightNumber FLIGHT INTEGER) relates an instance of #$AirplaneTrip FLIGHT to an instance of
#$PositiveInteger INTEGER that is used by the airline company to denote FLIGHT.")
(comment translationStartTime "(#$translationStartTime TRANSLATION TIME) means that TRANSLATION, an instance of #$Movement-TranslationEvent starts (or started) at the instance of #$Date TIME.  This predicate is intended to be broad and flexible.  Thus, it is possible to use this predicate to say Family'sSleighRideToGrandma'sHouse begins at 11:37 am on December 24, 2008, as well as MovingBuildingOneFootToLeft occurred at 2:12 pm on September 21, 2001.")
(comment scheduledDepartingTime "(#$scheduledDepartingTime MOVEMENT TIME) relates an instance of
#$TransportationEvent MOVEMENT to the intended departure time, TIME,
an instance of #$Date. This predicate is intended to correspond
to the notion of scheduled departures of instances of
#$TransportationEvent. Positive examples include the scheduled
departure of Northwestern Flight 668 at 9:25 on January 7th, 2004 or
Greyhound bus departure to Los Angeles from Austin at 3:23 pm on April
19th, 1997. This predicate also assumes local time. For example, if (scheduledDepartingTime Flight001 Time001) is true in #$CentralUSATimeZone,
then the departing time is one hour earlier in the #$EasternUSATimeZone.")
(comment translationEndTime "(#$translationEndTime TRANSLATION TIME) means that
TRANSLATION, an instance of #$Movement-TranslationEvent ends (or ended) at the
instance of #$Date TIME.  This predicate is intended to broad and
flexible.")
(comment scheduledArrivingTime "(#$scheduledArrivingTime MOVEMENT TIME) relates an instance of #$Movement-TranslationEvent MOVEMENT to the intended arrival time, TIME, an instance of #$Date. This predicate assumes local time.
For example, if (scheduledArrivingTime Flight001 Time001) is true in
#$CentralUSATimeZone, then the arrival time is one hour earlier in the
#$EasternUSATimeZone.")
(comment departingCity "(#$departingCity MOVEMENT CITY) means that CITY, an instance
of #$City, is the #$fromLocation of MOVEMENT, an instance of
#$TransportationEvent.")
(comment arrivingCity "(#$arrivingCity  MOVEMENT CITY) means that CITY, an instance
of #$City, is the #$toLocation of MOVEMENT, an instance of
#$TransportationEvent.")
(comment hasInterest "(#$hasInterest AGT INTERESTGROUP) means that the instance of #$IntelligentAgent AGT belongs to the #$AgentTypeByInterest INTERESTGROUP.  For example, (#$hasInterest #$BillClinton (#$HobbyInterestFn #$Golf)) means that #$BillClinton is interested in #$Golf as a hobby.")
(comment Cryptosporidium "A collection of #$Protozoan, that are eukaryotic cells.  Members 
of this genus cause the water-borne disease #$Cryptosporidiosis.")
(comment AfricanSleepingSickness "A specialization of ProtozoanInfection.  It is caused by 
instances of one of two subspecies of #$TrypanosomaBrucei.")
(comment Trypanosoma "A #$BiologicalGenus contained in #$Protozoan.  Instances of at least one specialization of this group cause #$AfricanSleepingSickness, a fatal disease.")
(comment TrypanosomaBrucei "A #$BiologicalSpecies contained in #$Trypanosoma.  Instances of this species cause #$AfricanSleepingSickness in #$HomoSapiens.")
(comment LarvalFn "An instance of #$CollectionDenotingFunction.  (#$LarvalFn ORGTYPE) returns the subcollection of the animal taxonomic collection ORGTYPE which includes all and only the members currently in a #$BiologicalStageOfDevelopment that is considered a #$Larva for the ORGTYPE.")
(disjointWith Macroparasite Microorganism)
(comment Macroparasite "A collection of specializations of #$Organism-Whole that spend part of their life obtaining nourishment from the body of an organism of a different species.")
(comment ParasiticAilment "A specialization of #$AilmentCondition.  Each instance of #$ParasiticAilment is an ailment condition in which the whole or part of the body of one or more #$Macroparasites are present within the body of an animal or a plant.  #$Hookworm and #$Mistletoe growing on an #$OakTree are examples.  This differs from #$ParasiticInfection by excluding ailments caused by #$Microorganisms.")
(comment WateryDiarrhea "This is a specialization of #$Diarrhea, consisting of events where the material is mostly water.")
(comment parasiteCausesAilmentCondition "This predicate relates a particular instance of #$ParasiticAilment to a 
specialization of $Macroparasite that causes the ailment. (<;#$parasiteCausesAilmentCondition AIL ORG) means that the macroparasitic organism ORG is one of the causes of the ailment AIL.")
(comment WormInfestation "A specialization of #$ParasiticAilment.  Each specialization of #$WormInfestation is an instance of a host organism containing a non-empty collection of individuals of a subcollection of #$Worm.")
(comment Platyhelminthes "An instance of #$BiologicalPhylum, containing several taxa, commonly called flatworms.  These are aceolomate triplobastic #$Animals.  Many are #$ParasiticOrganisms.  Planeria is a well known example of a non-parasitic genus within Platyhelminthes.")
(comment Filariasis "The collection of infestations of the #$LymphVessels of #$HomoSapiens by individuals of the species #$WuchereriaBancrofti.")
(comment WuchereriaBancrofti "A collection of individuals of the species Wuchereria bancrofti, which cause #$Filariasis in #$HomoSapiens.")
(comment StatelessPerson "The collection of people who are citizens of no country and have no nationality.")
(disjointWith Underwater Afloat-Generic)
(disjointWith InOuterSpace Afloat-Generic)
(disjointWith Airborne Afloat-Generic)
(comment NecatorAmericanus "A #$BiologicalSpecies specialization of #$Worm.  Individuals 
of the species Necator americanus, which cause #$Hookworm in #$HomoSapiens.")
(comment Hookworm "The collection of infestations of the #$SmallIntestine by individuals of either #$AncylostomaDuodenale or #$NecatorAmericanus in #$HomoSapiens.  A rash and itching at the site of skin contact is the initial symptom.  Moderate to heavy infestions cause anemia and
abdominal distress as adults suck blood from the intestinal wall.")
(comment AncylostomaDuodenale "A #$BiologicalSpecies specialization of #$Worm.  Individuals 
of the species Ancylostoma duodenale, which cause #$Hookworm in #$HomoSapiens.")
(comment EnterobiusVermicularis "A collection of individuals of the species Enterobius vermicularis, which cause #$Pinworm in #$HomoSapiens.")
(comment Pinworm "The collection of infestations of the #$LargeIntestine of #$HomoSapiens by individuals of #$EnterobiusVermicularis.")
(comment RiverBlindness "The collection of infestations of the #$Skin or #$Eye caused 
by individuals of #$OnchocercaVolvulus in #$HomoSapiens.")
(comment OnchocercaVolvulus "A collection of individuals of the species Onchocerca volvulus, which cause #$RiverBlindness in #$HomoSapiens.")
(comment SyntacticChoiceNodeFn "(#$SyntacticChoiceNodeFn N NODE) denotes choice node N for NODE.")
(comment SyntacticChoiceNode "A #$SyntacticChoiceNode is a syntactic node with more than one possible interpretation, represented as its daughters, specifically as #$optionNodes.")
(comment DeviceTypeByFunction "A collection of collections; a subcollection of #$ArtifactTypeByFunction. Instances of #$DeviceTypeByFunction are mutually unique with respect to the full set of primary functions that their instances perform. Examples include #$CookingRange and #$Freezer. Counter-examples include #$ElectricCookingRange and #$Freezer-Upright. There may be cases where two instances of #$DeviceTypeByFunction (PROD1 and PROD2) are related by (#$genls PROD1 PROD2); but this will only happen in cases where instances of PROD1 have some additional primary function(s) to those of PROD2. For example, the collections #$Radio and #$ClockRadio are both instances of #$DeviceTypeByFunction, and (#$genls #$ClockRadio #$Radio) is true.")
(comment EvaluativeQuantity "A specialization of #$Quantity The collection of evaluatory qualities that measure some evaluatable dimension of something.  A specialization of this collection is #$LevelOfQuality which is the collection of the different quantities of quality artifacts can have by virtue of how well they perform their intended function.")
(comment NationalInstituteForOccupationalSafetyAndHealth "A research agency within the U.S. Department of Health and Human Services, and a part of the Centers for Disease Control, whose mission is to make recommendations for the prevention of work-related disease and injury.")
(comment agentSources-Term "(#$agentSources-Term ASSERTION AUTHOR) means that TERM was reified as a #$CycLIndexedTerm partly to represent the propositional content of a #$ConceptualWork 'source' of which AUTHOR is the #$creatorOfCW.")
(comment reportSources-Term "(#$reportSources-Term TERM CW) means that TERM was reified as a #$CycLIndexedTerm partly in order to be able to represent the propositional content of the #$ConceptualWork CW.")
(comment candidateNthSubSituationTypeDuringType "(#$candidateNthSubSituationTypeDuringType SCRIPT SIT SCENE SUBSIT N) means that 1) it is #$possible in the context of the assertion that (#$and (#$isa SUBSIT (#$NthSubSituationTypeFn SCRIPT SCENE N)) (#$isa SIT SCRIPT) (#$subSituations SIT SUBSIT)), 2) some evidence for the conjunction exists, and 3) at least one of the three conjuncts is an #$unknownSentence in the context of the assertion.  It also presupposes that (#$iteratedProperSubSituationTypes SCRIPT SCENE).")
(comment candidateSubSituationType "(#$candidateSubSituationType SITTYPE SIT SUBSITTYPE SUBSIT) means that 1) it is #$possible that (#$and (#$isa SIT SITTYPE) (#$isa SUBSIT SUBSITTYPE) (#$subSituations SIT SUBSIT)), 2) some evidence for the conjunction exists, and 3) at least one of the conjuncts is still an #$unknownSentence in the context of the assertion.  It also presupposes (#$properSubSituationTypes SITTYPE SUBSITTYPE).")
(comment HypothesisManagementConstant "Instances of this collection are technical terms used in
generating and recording hypotheses for scenario generation and
constraint checking.")
(comment candidateIsa "(#$candidateIsa CANDIDATE-INST CANDIDATE-COL), when asserted in an hypothesis management context or #$ScenarioContext, means that it is #$possible that (#$isa CANDIDATE-INST CANDIDATE-COL) in the reasoning context where the assertion is made, and that some evidence exists that provides at least a prima facia argument for believing (#$isa CANDIDATE-INST CANDIDATE-COL), while presupposing that (#$isa CANDIDATE-INST CANDIDATE-COL) is not already known.")
(comment candidateBinaryPred "(#$candidateBinaryPred ARG1 ARG2 RELN) means that in the context of the assertion it is #$possible that (RELN ARG1 ARG2), and that some evidence exists to support the claim that it is true, although (RELN ARG1 ARG2) is not already known.")
(comment agentSources-Prop "(#$agentSources-Prop ASSERTION AUTHOR) means that ASSERTION derives from a #$ConceptualWork 'source' of which AUTHOR is the #$creatorOfCW.")
(comment reportSources-Prop "(#$reportSources-Prop ASSERTION CW) means that the #$ConceptualWork CW is a source from which ASSERTION was drawn in knowledge entry.")
(comment evidenceForPlayingRole "Where FORMULA is a CycL formula with a single open variable, (#$evidenceForPlayingRole CANDIDATE-AGENT CANDIDATE-SIT CANDIDATE ROLE FORMULA) means that the fact that CANDIDATE-AGENT is returned as (possibly one of several) bindings for the open variable in FORMULA constitutes weak or prima facia evidence for the claim that (ROLE CANDIDATE-SIT CANDIDATE-AGENT).")
(comment candidateRolePlayer "A typed spec-pred of #$candidateBinaryPred.  (#$candidateRole-Player SIT AGENT ROLE) means that it is #$possible in the context of the assertion that the #$SomethingExisting AGENT plays the role ROLE in the situation SIT, and, moreover, that some evidence exists for believing that this is true, although the assertion is not known in the context.")
(comment evidenceForIsa "Where FORMULA is a CycL formula with a single open variable, (#$evidenceForIsa CANDIDATE-ISA CANDIDATE-COL FORMULA) means that the fact that CANDIDATE-ISA is returned as (possibly one of several) bindings for the open variable in FORMULA constitutes weak or prima facia evidence for the claim that (#$isa CANDIDATE-ISA CANDIDATE-COL).")
(comment wouldBeEvidenceForIsa "Where FORMULA is a #$CycLFormula with a single open variable, (#$wouldBeEvidenceForIsa CAND-INST CAND-COL FORMULA) means that if the sentence that results from substituting CAND-INST for the variable in FORMULA were known to be true, it would constitute at least weak, prima facia evidence for believing (#$isa CAND-INST CAND-COL).")
(comment nthHypothesizedInstanceForProject "The #$functionCorrespondingPredicate-Canonical of #$NthHypothesizedInstanceForProjectFn.")
(comment NthHypothesizedInstanceForProjectFn "This function was created primarily to serve the hypothesis management needs of various current (June, 2003) Cycorp projects for hypothesizing instances of collections 'on-the-fly'.  Simply put, (#$NthHypothesizedInstanceForProjectFn COL PROJECT N) denotes the Nth instance of the #$Collection COL reified in support of the #$CycorpProject PROJECT for hypothesis management and generation purposes.")
(comment HomeTelephone "The collection of telephones connected to and primarily used in some #$HumanResidence.")
(comment PersonalDevice "The collection of devices that are controlled and primarily used by one person, and which are often carried by the person rather than permanently situated in a particular #$HumanOccupationConstruct. Not included are household devices, which are often shared by more than one dweller in a #$HumanResidence. Also not included are instances of #$BusinessMachine, as these are often shared by multiple coworkers. Specializations include #$Pager, #$Wallet and #$CellularTelephone. #$PersonalDevice differs from #$Device-SingleUser in that an instance of the latter can typically be shared among more than one user, as long as it is not used by both users simultaneously. Neither #$PersonalComputer nor #$LaptopComputer are specializations of #$PersonalDevice (both are often shared by multiple people, though not simultaneously), but certain instances of LaptopComputer might also be instances of #$PersonalDevice.")
(comment AmericanConferenceOfGovernmentalIndustrialHygienists "A nonprofit corporation whose mission is to advance worker health and safety through education and the development and dissemination of scientific and technical knowledge.")
(comment ExtremelyToxic "An instance of #$Toxicity. A substance that is #$ExtremelyToxic to a kind of organism (see the collection #$OrganismClassificationType) will, when taken into their bodies, make organisms of that kind sick, and may kill them if enough of the substance is taken in.")
(comment Toxic "An instance of #$Toxicity. A substance that is #$Toxic to a kind of organism (see the collection #$OrganismClassificationType) will, when taken into their bodies, damage organisms of that kind.")
(comment AmericanIndustrialHygieneAssociation "A nonprofit organization whose mission is to promote, protect, and enhance industrial hygienists and other occupational health, safety and environmental professionals in their efforts to improve the health and well being of workers, the community, and the environment.")
(comment SchistosomaHaematobium "A collection of individuals of the species Schistosoma haematobium, which cause #$BladderFlukeInfestations in #$HomoSapiens.  A specialization of the #$BiologicalPhylum #$Platyhelminthes.")
(comment BladderFlukeInfestation "The collection of #$Infections of the wall of the #$Bladder-Urinary by individuals of the species Schistosoma haematobium.  Aquatic larva burrow through skin exposed to infested water and mature in the bladder, causing inflamation.  Eggs are shed back into water, where the organism completes its life cycle in the secondary host, a snail.")
(comment AscarisLumbricoides "A collection of individuals of the species Enterobius vermicularis, which cause #$Ascariasis in #$HomoSapiens.")
(comment Ascariasis "A collection of infestations of the #$SmallIntestine of #$HomoSapiens by individuals of #$AscarisLumbricoides.")
(comment SchistosomaJaponica "A collection of individuals of the species Schistosoma japonica, which cause #$Schistosomiasis in #$HomoSapiens.")
(comment Schistosomiasis "The collection of #$Infections of the #$Veins caused by 
individuals of either #$SchistosomaMansoni or #$SchistosomaJaponica in #$HomoSapiens.")
(comment SchistosomaMansoni "A collection of individuals of the species Schistosoma mansoni, which cause #$Schistosomiasis in #$HomoSapiens.")
(comment TrichinellaSpiralis "A collection of individuals of the species Trichinella spiralis, which cause #$Trichinosis in #$HomoSapiens.")
(comment Trichinosis "The collection of infestations of the #$SmallIntestine and 
#$Muscles of #$HomoSapiens by individuals of #$TrichinellaSpiralis in #$HomoSapiens.  The Larval form burrows into muscles, which respond by forming #$Cysts, which are frequently painful.")
(comment TrichurisTrichiuria "A collection of individuals of the species Trichuris trichiuri, which cause #$Whipworm in #$HomoSapiens.")
(comment Whipworm "The collection of infestations of the #$Cecum by individuals of #$TrichurisTrichiuria in #$HomoSapiens.")
(comment ArthropodInfestation "A specialization of #$ParasiticAilment.  Each specialization of #$WormInfestation is an instance of a host organism containing instances of the intersection of #$Arthropod and #$Macroparasite.  See the specializations #$ExternalArthropodInfestation and #$InternalArthropodInfestation.")
(comment InternalArthropodInfestation "A specialization of #$ArthropodInfestation.  The best known examples of this are probably #$BotFlyInfestations.")
(comment ExternalArthropodInfestation "A specialization of #$ArthropodInfestation.  This is the most common type, including infestations by #$Ticks and #$Fleas.  Cases of #$InternalArthropodInfestation may start with an external infestation.")
(comment HumanBotFly "A #$BiologicalSpecies that is a specialization of #$Fly-Insect.  
Instances of this species regularly parasitize humans (though  infestation by other species is not unknown).")
(comment BotFlyInfestation "The collection of infestation by instances of (#$LarvalFn #$HumanBotFly).  These organisms burrow under the skin and after 5-10 weeks, exit the way they came and drop off.  The female actually captures another insect, such as a mosquito, and attaches her eggs to the other insect.  When the other insecttakes a blood meal, body head causes the the eggs to drop off, on the skin of the future host.")
(comment NonToxic "Does no damage at all")
(comment vaccineEffectiveness "This predicate relates a #$Vaccine and a #$Microorganism to a probablity of effectiveness of the #$Vaccine in preventing infection by a members of that 
#$Microorganism.  (<;#$vaccineEffectiveness> VACCINE MICROORGANISM PROBABILITY) means that vaccine VACCINE has a probability PROBABILITY of preventing infection by microorganism MICROORGANISM.")
(comment MeaslesVirus "The specialization of #$Virus that causes #$Measles in #$HomoSapiens.")
(comment Rubella-Virus "The specification of #$Virus that causes #$Rubella in #$HomoSapiens.")
(comment objectTypesInContact "(#$objectTypesInContact SIT OBJECT-TYPE) means that some instance of OBJECT-TYPE is one of the objects in contact (see the predicate #$objectsInContact) in the #$PhysicalContactSituation SIT. For example, if SIT is an instance of (#$SkinContactWithFn #$Flea), then (#$objectTypesInContact SIT #$Flea) holds.")
(comment uniqueFirstProperSubSituationTypes "(#$uniqueFirstProperSubSituationTypes SIT-TYPE SUB-SIT-TYPE) means that SUB-SIT-TYPE is the unique first subsituation type in SIT-TYPE.  This predicate differs from #$firstProperSubSituationTypes in that it is possible for more than one subsituation type to be first in the sense of the latter predicate, but there can only be one first subsituation type in the sense of the former.")
(comment nthSubSituationTypeInSituationType "(#$nthSubSituationTypeInSituationType SIT-TYPE NUM SUBSIT-TYPE) means that SUBSIT-TYPE is the NUMth sub-situation type of type SUBSIT-TYPE in SIT-TYPE.")
(comment Ribavirin "A specialization of #$Antiviral, frequently effective against 
members of the collection #$ArenaVirus.")
(comment InterArgEqualsIsaPredicate "The subcollection of both #$InterArgTypePredicate and #$ArgIsaPredicate (qq.v.) whose instances are used to put conditional #$isa based argument-type constraints on polyadic relations in regards to one of their argument-places, when another argument-place is filled by a particular value.  Each instance of #$InterArgEqualsIsaPredicate specifies, with respect to a given #$Relation, that one of its arguments (the \"dependent\" one) must be an instance of (#$isa) a certain collection, contingent upon another of its argument's (the \"independent\" one's) being a particular specified thing.
<p>
An inter-argument-exact-isa predicate PRED has at least three argument-places, for designating, respectively: the relation RELN being constrained, the collection serving as the (conditional) argument-type constraint for RELN's dependent argument, and the thing that must serve as RELN's independent argument for the constraint to be in effect.  The (numerically-specified) positions of RELN's independent and dependent arguments is in most cases fixed (as in the ternary #$interArgEqualsIsa1-2), but in the case of the quintary #$interArgEqualsIsa it is variable and specified via two additional argument-places.")
(comment White-FootedMouse "A species of #$Mouse-Rodent within #$PeromyscusGenus that is common in North America.   Believed to be the natural reservoir for #$BorreliaBurgdorferi-Species, the spirochete that causes #$LymeDisease.")
(comment KSETemplate "A specialization of #$SKSITemplate, #$KSETemplate is the
collection of formula templates which are automatically generated for
modifiable structured knowledge sources. 'Knowledge Source Editor'
templates are used within the fact entry tool to permit editing modifiable
knowledge sources.")
(comment SKSITemplate "A specialization of #$FormulaTemplate, #$SKSITemplate is the
collection of formula templates for the #$SKSIProject.")
(comment ExposureOfOrganismToSubstance "The collection of events in which some organism is exposed to some object.  The exposed organism is close enough to possibly be affected in some measurable way by the thing to which it was exposed.")
(comment ExposureToHarmfulSubstanceThroughSkinContact "The collection of all #$ExposureOfOrganismToHarmfulSubstance events in which the organism that is exposed and the harmful stuff to which it is exposed are in direct external physical contact.")
(comment ExposureThroughSkinContact "The collection of all #$ExposureToSubstance events in which the organism that is exposed and the stuff to which it is exposed are in direct external physical contact")
(comment organismGroupExposed "(#$organismGroupExposed EXPOSURE GROUP) means that every #$groupMember MEMBER of GROUP such that MEMBER is an #$Organism-Whole plays the role of organismExposed in the #$ExposureToSubstance EXPOSURE.")
(comment organismExposed "(#$organismExposed EXPOSURE ORG) means that ORG is an organism exposed to some substance that is the #$stuffInExposureEvent in EXPOSURE.")
(comment objectExposedToHarmfulSubstance "(#$objectExposedToHarmfulSubstance EXPOSURE OBJECT) means that during the #$ExposureToHarmfulSubstance EXPOSURE, the object that is exposed is OBJECT.")
(comment ExposureToHarmfulSubstance "The collection of events in which some object is exposed to some harmful substance.  The exposed object is close enough to possibly be harmed in some measurable way by the substance to which it was exposed.")
(comment WorkLocationKey "A key that, when functioning properly, lets its user unlock a door to his/her place of employment. Some electronic versions of #$WorkLocationKey can be disabled by whomever has control of the #$DoorLock (typically the employer) even if they do not have physical control of the key.")
(comment AerosolizedFn "A #$CollectionDenotingFunction and spec function of #$GaseousFn. (#$GaseousFn COL) is the collection of elements of COL that are in aerosolized form (i.e., are instances of #$AerosolStuff).")
(comment VaporFn "An instance of #$CollectionDenotingFunction,
#$ReifiableFunction and #$UnaryIntersectionFunction.  When applied to
a specialization collection COLLECTION of either #$LiquidTangibleThing
or #$SolidTangibleThing, (#$VaporFn COLLECTION) returns as its value
all of the instances of COLLECTION in vapor form.  Thus, (#$VaporFn (LiquidFn AceticAcid)) is the collection of all instances of acetic acid vapor.")
(comment surfaceTensionAtTemperature "(#$surfaceTensionAtTemperature SUBSTANCE TENSION
TEMPERATURE) means that the specialization of LiquidTangibleThing,
SUBSTANCE, has a surface tension of TENSION, usually measured in (PerFn Dyne (Centi Meter)), at the temperature specified by
TEMPERATURE.  Surface tension is a force found in
#$LiquidTangibleThings, exherted by the high concentration of molecules
of the liquid upon the lower concentration of molecules at the
surface/air interface.  These conditions create an internal pressure
that restrains the liquid.  The higher the surface tension, the less
the liquid will flow.")
(comment SituationTypeJoinerMeta-Expansion "#$SituationTypeJoinerMeta-Expansion is a #$ScenGenMeta-ExpansionSpecification.  Its goal is to examine hypotheses that were previously produced by the expansion and refinement modules.  This particular module is looking for two scripts that might connect together to form a single, larger narrative.  Specifically, it looks for a specialization of #$Situation whose final scene could be the first scene of a instance of some other specialization of #$Situation. If it finds two such script instances, it will assert that the two scripts share a common #$subSituations.")
(comment optionNodes "(#$optionNodes CHOICE-NODE OPTION-NODE) means that the syntactic choice node CHOICE-NODE has the syntactic node OPTION-NODE as one of its options.")
(comment chosenOptionNode "(#$chosenOptionNode CHOICE-NODE OPTION-NODE) means that OPTION-NODE has been chosen as the preferred option among those available for the syntactic choice node CHOICE-NODE.")
(comment excludedOptionNodes "(#$excludedOptionNodes CHOICE-NODE OPTION-NODE) means that OPTION-NODE has been exlcuded from those available for the syntactic choice node CHOICE-NODE.")
(comment HostedComputerFile "Instances of #$HostedComputerFile are instances of #$ComputerFile-Abstract that have at least one #$ComputerFileCopy on at least one #$ComputerServer. They are often accessible via an application that 'serves' the files to users, such as a web server application or a document management application.")
(comment HostedFileNamedFn "A function which takes #$ComputerServer HOST and string STR as its arguments and returns an instance of #$HostedComputerFile that has an associated ComputerFileCopy on HOST and that has STR as its remainder path. The remainder path is appended to the HOST system's file system base path and/or URL base path to determine the full pathname to the file on HOST. For example, the HOST #$Doc-Cyc-Com has a url base path of 'http://doc.cyc.com/' and a httpd base path of '/cyc/httpd/htdocs/', so (HostFileNamedFn Doc-Cyc-Com 'project-files/project1.txt') denotes a file which can be accessed at 'http://doc.cyc.com/project-files/project1.txt' or through the file system (with the proper privileges) at '/cyc/httpd/htdocs/project-files/project1.txt'.")
(comment syntacticNodeString "(#$syntacticNodeString NODE STRING) means that the syntactic NODE is an interpretation of the string STRING.")
(comment VirtualHost "A computer system that is accessed by a user working at a remote location. The specific machine pointed to by the unique host IP address may change, but the expectation is that this will not alter the files and services that the host makes available.")
(comment canonicalHost "#$canonicalHost relates a #$VirtualHost to an actual #$ComputerServer. (#$equivalentHosts HOST SERVER) means that requests that are made of HOST will actually be handled by SERVER. Usually virtual hosts are configured by a system administrator.")
(comment desirabilityOfForAgent-RoleInType "(#$desirabilityOfForAgent-RoleInType AGENT THING EVENT-TYPE ROLE QUANTITY) means the desirability for AGENT to have THING play the role ROLE in an event of EVENT-TYPE is QUANTITY.")
(comment utilityServesLocation "(#$utilityServesLocation UTILITY LOCATION) relates some UTILITY to the LOCATION for which it provides some form of service.")
(comment urlBasePath "(urlBasePath SERVER PATH) means that PATH is the URL (#$UniformResourceLocator) for the gateway page -- the main introductory page -- of the #$WorldWideWebSite that is running on SERVER. PATH is also the beginning part of every URL that refers to a file on SERVER.")
(comment ComputerFileTypeByApplicationFormat "A collection of collections of computer files [ComputerFile-AIS]. Each instance of ComputerFileTypeByApplicationFormat (e.g. the collection of MS Word files) is a collection of all ComputerFile-AISs that conform to a single preestablished layout for electronic data that is native to some particular application. Programs accept data as input in a certain format, process it, and provide it as output in the same or another format. This constant refers to the format of the data. For every instance of ComputerFileCopy, one can assert a fileFormat for it.")
(comment ApplicationFileTypeFn "#$ApplicationFileTypeFn takes an instance of #$ApplicationProgram (APP) and returns the collection of files (instances of #$ComputerFile-Abstract) that are stored in APP's primary file format.")
(comment DiscourseModellingVocabularyMt "This microtheory contains definitions for the vocabulary representing the #$CycInterlocutor dialogue modelling components in Cyc.")
(comment WebApplicationProgram "Each instance of #$WebApplicationProgram is both a #$ServerProgram and an #$ApplicationProgram. A WebApplicationProgram relies on the functionality of some WorldWideWebServerProgram to process requests that come in across a ComputerNetwork.")
(comment applicationBasePath "(applicationBasePath APP COMPUTER BASEPATH) means that an instantiation of APP is installed on COMPUTER, and that BASEPATH is the default base pathname of all APP-related program (not data) files on COMPUTER. The absolute pathname of a file can be determined by appending its full relative pathname to its base pathname. The full relative pathname for a file 'FILE' can be determined by combining the relative directory pathname for files of which 'FILE' is a type with the relative file pathname of 'FILE'.")
(comment documentRelativeBasePath "(documentRelativeBasePath APP COMPUTER PATH) means that the default directory location for storing files managed by APP, when APP is running on COMPUTER, can be determined by appending PATH to BASEPATH, where (#$applicationBasePath APP COMPUTER BASEPATH).")
(comment documentBasePath "(documentBasePath APP COMPUTER PATH) means that the fully qualified directory PATH is the default location for storing document files managed by APP, when APP is running on COMPUTER.")
(comment ProducerPriceIndex "A specialization of #$ConceptualWorkSeries. Each instance of
this collection is a group of indexes that measure the average change
over time in selling prices received by domestic producers of goods
and services. PPIs measure this change from the perspective of the
seller, as opposed to the Consumer Price Index, which would measure
price changes from the purchaser's perspective.")
(comment healthCareServiceNameString "(#$healthCareServiceNameString HOSPITAL STRING) relates a HOSPITAL to the name string STRING of the health care service to which it belongs.")
(comment scenarioCollectorMt "A specialization of #$genlMt. (#$scenarioCollectorMt COLLECTOR CONTEXT) means that COLLECTOR is a specialized context of every context that is abduced from CONTEXT. Thus every assertion abduced or derived from an abduced assertion from CONTEXT is true in COLLECTOR.")
(comment ScenarioCollectorMicrotheory "A specialization of #$CollectorMicrotheory. Every instance of #$ScenarioCollectorMicrotheory is the unique context in which every assertion abduced from some #$ScenarioContext is true.")
(comment PipeBomb "A #$PipeBomb is an improvised munition built with a length of #$Pipe-Plumbing for casing. Upon detonation, the #$Pipe-Plumbing becomes shrapnel. This type of weapon is not typically employed by regular modern militaries, and is usually used by civilians in  #$CriminalActs, and most notably #$TerroristAttacks.")
(comment NuclearRelatedMaterialProduct "An instance of #$ProductType.  This collection comprises all #$NuclearRelatedMaterials that are actually for sale (i.e. are instances of #$Product).")
(comment NuclearRelatedThing "An instance of #$ProductType. This is the collection of all things related to the use of nuclear energy or nuclear radiation, including things related to nuclear weapons, nuclear power
generators, and nuclear medical devices. The collection includes, for
example, all #$NuclearServiceEvents, #$Artifacts that are components
in nuclear reactors, and all kinds of #$NuclearFuel, as well as
nonfissionable #$RadioactiveStuff.")
(comment USPersonByMedicalBenefitProvider "A collection of collections.  Each instance of this collection is a collection of #$UnitedStatesPerson all of whom share a particular type of medical services provision (e.g. #$MedicaidPatient). See also #$HealthCarePayerType.")
(comment NuclearScientist "An instance of #$PersonTypeByOccupation and a specialization of #$Scientist.  Each instance of #$NuclearScientist is an expert in the field of nuclear science.")
(comment NonlethalWeapon "This is the subcollection of #$Weapons that are explicitly designed and primarily employed so as to incapacitate personnel or materiel, while minimizing fatalities, permanent injury to personnel, and undesired damage to property and the environment. Unlike conventional lethal weapons that destroy their targets principally through blast, penetration and fragmentation, non-lethal weapons employ means other than gross physical destruction to prevent the target from functioning.")
(comment IsotopeTypeByEmissionType "A collection of specializations of #$Isotope. Each instance of #$IsotopeTypeByEmissionType is a collection of isotopes characterized by the fact that all of its instances emit the same type of particle or electromagnetic radiation.")
(comment PersonTypeByMilitaryStatus "A collection of collections.  Each instance of this collection is a collection of #$Persons all of whom share a particular status vis a vis their respective national or territorial  #$MilitaryOrganization(s). Notable instances include  #$PersonLegallyCapableOfMilitaryService and #$Civilian.")
(comment WithArgInRoleFn "When PRED is an instance of #$EventPredicate-FrameTemplate of arity
N and SLOT is a binary predicate and an instance of ActorSlot,
(#$WithArgInRoleFn PRED SLOT) denotes the (unique) instance of
#$EventPredicate-FrameTemplate of arity N+1 such that: (1) for every K
greater than 1 and less than N, it is the case that (#$coordinateSlot PRED
(#$WithArgInRoleFn PRED SLOT) K), and (2) (#$associateSlotInArg
(#$WithArgInRoleFn PRED SLOT) SLOT N+1). For instance:
(#$WithArgInRoleFn #$does #$objectActedOn) is semantically equivalent to
#$doesTo.")
(comment ScenGenMeta-ExpansionSpecification "ScenGenMeta-ExpansionSpecification is used to pick out a special subclass of abductiveExpansion modules, which should be labelled 'meta-expansion modules.'  The 'meta' label refers to the fact that these expansion modules are not intended to work not only on seed events, but on hypotheses about seed events as well.  So, they deliver hypotheses about hypotheses.  The functionality of meta-expansion modules differs from that of standard expansion modules in two significant ways.  First, the QueryMt is a collector or 'sink' microtheory that is associated with a seed event Scenario Context.  Second, the assertions which the meta-expansion modules add will bear the genlMt relation to multiple ScenarioContexts, specifically those ScenarioContexts about which the module is making a new hypothesis.")
(comment ActorToSceneMeta-Expansion "ActorToSceneMeta-ExpansionModule is a ScenGenMeta-ExpansionSpecification.  Its goal is to supplement the TypeBehaviorCapableExpansionModule and ChemicalConversionExpansionModule by taking the hypothetical entities that are the results of those modules and joining them with appropriate scripts.")
(comment EEGReadout "An image produced by an #$ElectroEncephalographMachine. This may appear on a computer screen, or it may be printed out on paper. EEG readouts basically consist of a number of parallel lines, each of which forms multiple peaks and valleys.")
(comment RejectedScenarioContext "A specialization of #$ScenarioContext. Each instance of #$RejectedScenarioContext denotes a context describing a scenario which has been determined not to be worth further investigation. This might be because a contradiction is provable from its assertions, or for other reasons.")
(comment Dimercaprol "An instance of #$ChemicalCompoundTypeByChemicalSpecies. Each instance of #$Dimercaprol is a sample of the compound C3H8OS2. #$Dimercaprol is used as an antidote to poisoning caused by lewisite (see #$Lewisite), organic arsenic compounds, and heavy metals.")
(comment EdibleStuffTypeContaminatedWithSubstanceTypeFn "A binary collection-denoting function that creates specializations of PartiallyTangible from specializations of #$EdibleStuff and specializations of #$BiochemicallyHarmfulSubstance. (#$EdibleStuffTypeContaminatedWithSubstanceTypeFn EDIBLE-STUFF-TYPE SUBSTANCE-TYPE) denotes the collection of all instances of EDIBLE-STUFF-TYPE which are contaminated with SUBSTANCE-TYPE. For example, (ContaminatedWithFn #$Meat #$Anthrax-Bacterium) denotes the collection of all instances of #$Meat contaminated with #$Anthrax-Bacterium.")
(comment edibleStuffContaminatedWithSubstanceType "A binary predicate relating instances of #$EdibleStuff to specializations of #$PartiallyTangible. (#$edibleStuffContaminatedWithSubstanceType EDIBLE-STUFF SUBSTANCE-TYPE) means just that EDIBLE-STUFF is contaminated with SUBSTANCE-TYPE.")
(comment durationBetweenSubSituationTypes "(#$durationBetweenSubSituationTypes SITTYPE SUBSITTYPE1 SUBSITTYPE2 DUR) means that if INST is an instance of SITTYPE where SIT1 and SIT2 are any two #$properSubSituations of INST such that (#$startsAfterEndingOf SIT2 SIT1) and (#$isa SIT1 SUBSITTYPE1) and (#$isa SIT2 SUBSITTYPE2), there exists a time interval INT of #$duration DUR such that (#$timeIntervalBetween INT SIT1 SIT2).")
(comment durationBetweenSubSituationTypes-Existential "(#$durationBetweenSubSituationTypes-Existential SITTYPE SUBSITTYPE1 SUBSITTYPE2
DUR) means that for any instantiation INST of SITTYPE there exists an
instance, SIT1, of SUBSITTYPE1 that is a #$properSubSituations of INST, and an
instance, SIT2, of SUBSITTYPE2 that is a #$properSubSituations of INST and such that (#$startsAfterEndingOf SIT2 SIT1), and such that there is a time
interval INT of #$duration DUR such that(#$timeIntervalBetween INT
SIT1 SIT2).")
(comment SocialDinner "The intersection of #$HavingDinner and #$SocialDining. The collection of 
 events in which several people have dinner together, either at a restaurant or in a private residence.")
(comment presentsCWWhen "(#$presentsCWWhen AGENT CW WHEN) means that AGENT (an organization, person, or other #$Agent-Generic) presents instantiations of the CW (a #$DevisedPracticeOrWork) at its venue at the time WHEN (an instance of #$Date).")
(comment cwPerformanceDuration "(#$cwPerformanceDuration WORK DURATION) means that when an instantiation of WORK (a conceptual work such as a #$Movie-CW, #$TVShow-CW, or #$Album-CW) is played in its entirety, the performance takes DURATION -- a length of time.")
(comment subSituationOfType "(#$subSituationOfType SIT-INSTANCE SUBSIT SUBSIT-TYPE) is true iff (#$subSituations SIT-INSTANCE SUBSIT) and (#$isa SIT SUBSIT-TYPE) where, for some SITTYPE, both (#$isa SIT-INSTANCE SITTYPE) and (#$properSubSituationTypes SITTYPE SUBSIT-TYPE) are true. That is, this relation holds between the instance of a situation type and the sub-situation uniquely instantiating a given sub-situation type in it")
(comment IntestinalAnthrax "Instances of #$IntestinalAnthrax are infections [see #$Infection] caused by a colony of B. Anthracis [see #$Anthrax-Bacterium], the original population of which entered the body of the host via the gastrointestinal tract.")
(comment DietProgram "A specialization of #$DevisedStructuredActivity.  The  collection of all \"programs\" that constrain the types or amounts of things one eats or drinks.  A given diet program might be designed for losing weight (see #$WeightLossProgram), gaining weight, lowering cholesteral, lowering blood pressure, increasing strength, or some other purpose.  Some diet programs are commonly followed for at least partly ethical or religious reasons (e.g. a vegan diet or a kosher diet).  When following a diet program, one is #$Dieting (q.v.).")
(comment dietRestricts "A #$FirstOrderCollectionPredicate that relates a given  #$DietProgram (q.v.) to the types of food, drink, or ingredient whose consumption the diet restricts in some way.  (#$dietRestricts DIET STUFFTYPE) means that DIET limits the amount of STUFFTYPE (some specialization of #$EdibleStuff) that the dieter may consume.  For example, a low-cholesteral diet might restrict the amount of red meat one may eat.  If DIET prohibits STUFFTYPE completely, the more specialized predicate #$dietProscribes applies.  See also #$dietPrescribes and its specialization #$dietPrescribesExclusively.")
(comment dietProscribes "A #$FirstOrderCollectionPredicate and a specialization of #$dietRestricts (q.v.) that relates a given #$DietProgram (q.v.) to the types of food, drink, or ingredient whose consumption the diet prohibits.  (#$dietProscribes DIET STUFFTYPE) means that DIET prohibits the dieter from consuming any amount of STUFFTYPE (some specialization of #$EdibleStuff).  For example, a vegetarian diet proscribes meat.  Cf. #$dietPrescribes and its specialization #$dietPrescribesExclusively.")
(comment likesCuisine "A #$LikesPredicate and a specialization of #$likesType (q.v.). (#$likesCuisine AGENT CUISINE) means that AGENT generally likes to partake of CUISINE.  Thus, there are at least several dishes within CUISINE that AGENT typically enjoys.  Cf. #$dislikesCuisine.")
(comment dietPrescribes "A #$FirstOrderCollectionPredicate that relates a given  #$DietProgram (q.v.) to the types of food, drink, or ingredient whose consumption the diet prescribes or recommends.  (#$dietPrescribes DIET STUFFTYPE) means that DIET instructs the dieter to consume some (possibly a large) amount of STUFFTYPE (some specialization of #$EdibleStuff).  For example, a low-cholesteral diet might prescribe a large amount high-fiber vegetables.  If DIET limits the dieter to _only_ STUFFTYPE, the more specialized predicate #$dietPrescribesExclusively applies.  See also #$dietRestricts and its specialization #$dietProscribes.")
(comment dislikesCuisine "A #$LikesPredicate and a specialization of #$dislikesType (q.v.). (#$dislikesCuisine AGENT CUISINE) means that AGENT generally dislikes to partake of CUISINE.  Thus, there are few if any dishes within CUISINE that AGENT enjoys, and at least several that s/he actively dislikes.  Cf. #$likesCuisine.")
(comment dietPrescribesExclusively "A #$FirstOrderCollectionPredicate and a specialization of #$dietPrescribes that relates a given #$DietProgram (q.v.) to a type of food or drink whose consumption the diet prescribes or recommends exclusively.  (#$dietPrescribesExclusively DIET STUFFTYPE) means that DIET instructs the dieter to consume only STUFFTYPE (some specialization of #$EdibleStuff).  For example, a fasting diet might prescribe clear liquids exclusively.  See also #$dietRestricts and its specialization #$dietProscribes.")
(comment commonFoodTypeOfCuisine "(#$commonFoodTypeOfCuisine FOOD CUISINE) means that food or drink of type FOOD is frequently served as an instance of the #$Cuisine CUISINE.")
(comment assertViaUIA "(#$assertViaUIA SENTENCE MT) causes SENTENCE to be asserted in MT via the #$CycAssertionConstructor.")
(comment SendingAnInvitation-AutomaticallyGenerated "The collection of events in which an invitation to attend a social event is automatically generated -- e.g., from a list of invitees in someone's computer.")
(comment SendingAnInvitation-ManuallyProduced "The collection of events in which an invitation to attend a social event is produced directly by a human agent -- e.g., by writing a note or making a phone call.")
(disjointWith SendingAnInvitation-AutomaticallyGenerated SendingAnInvitation-ManuallyProduced)
(disjointWith PhysicalDevice MetropolitanArea)
(comment RiceNoodle "The collection of all noodles made out of #$RiceFlour.")
(comment likesSensoriallyObjectsOfType "(#$likesSensoriallyObjectsOfType AGT OB-TYPE) means that the #$PerceptualAgent AGT derives some physical pleasure from the sensory experience of OB-TYPE (an object characterized by taste, odor, or some other sensible feature).")
(comment isomorphicSentences "<code>(#$isomorphicSentences (#$TheList TERM-1 TERM-2 ... TERM-N) (#$TheList SENTENCE-1 SENTENCE-2 ... SENTENCE-N))</code> means that <code>TERM-1</code> occurs as an argument in <code>SENTENCE-1</code>, and that otherwise <code>SENTENCE-2</code> through <code>SENTENCE-N</code> have identical arguments to <code>SENTENCE-1</code>; that <code>TERM-2</code> occurs as an argument to <code>SENTENCE-2</code>, and that otherwise <code>SENTENCE-1</code> and <code>SENTENCE-3</code> through <code>SENTENCE-N</code> have identical arguments to <code>SENTENCE-2</code>; and so on.  For example,
<pre>
  (#$isomorphicSentences 
     (#$TheList 
        #$Muffet #$Snoopy) 
     (#$TheList 
        (#$isa #$Muffet #$Dog) (#$isa #$Snoopy #$Dog)))
</pre>
is true since '#$Muffet' occurs as an argument in '(#$isa #$Muffet #$Dog)', and otherwise '(#$isa #$Snoopy #$Dog)' has arguments identical to '(#$isa #$Muffet #$Dog)', and '#$Snoopy' occurs as an argument to '(#$isa #$Snoopy #$Dog)' and otherwise '(#$isa #$Muffet #$Dog)' has arguments identical to '(#$isa #$Snoopy #$Dog)'.")
(comment interestingIsomorphicSentences "(#$interestingIsomorphicSentences (#$TheList TERM-1 TERM-2 ... TERM-N) (#$TheList SENTENCE-1 SENTENCE-2 ... SENTENCE-N)) means that (1) (#$interestingSentence TERM-1 SENTENCE-1), (#$interestingSentence TERM-2 SENTENCE-2), and so on; and (2) (#$isomorphicSentences (#$TheList TERM-1 TERM-2 ... TERM-N) (#$TheList SENTENCE-1 SENTENCE-2 ... SENTENCE-N)) is true (thus TERM-1 occurs as an argument in SENTENCE-1, and otherwise SENTENCE-2 through SENTENCE-N have identical arguments to SENTENCE-1; TERM-2 occurs as an argument to SENTENCE-2, and otherwise SENTENCE-1 and SENTENCE-3 through SENTENCE-N have identical arguments to SENTENCE-2; and so on).")
(comment dislikesSensoriallyObjectsOfType "(#$dislikesSensorially AGT SENSUM) means that the #$PerceptualAgent AGT derives some displeasure from the sensory experience of SENSUM (a taste, odor, or other #$SensoryAttribute).")
(comment dislikesSensoriallyObjectsOfType "(#$dislikesSensoriallyObjectsOfType AGT OB-TYPE) means that the #$PerceptualAgent AGT feels some physical discomfort from the sensory experiences associated with objects of type OB-TYPE).  For instance, if OB-TYPE is the collection of salty things then the statement says that I dislike the taste of salty things.
Note: this is a stronger statement than (#$not (#$likesSensoriallyObjectsOfType AGT OB-TYPE)), as there may be many #$ObjectTypeBySensibleFeature which one neither particularly likes nor dislikes.")
(comment Smoothie "The collection of all drinks made by blending fruits with milk, water, or other fruits in a blender.  Spices such as #$Cinnamon-Spice, ground ginger [(#$RootFn #$GingerPlant)], #$Nutmeg, etc. may be added.")
(comment onDietProgram "A binary predicate that relates a tangible agent to a diet plan (see #$DietProgram) s/he is on.  (#$onDietProgram AGENT DIET) means that AGENT practices DIET, and follows the prescriptions and restrictions therein (see #$dietPrescribes and #$dietRestricts).")
(comment practicesStructuredActivity "A binary predicate that relates an agent to a structured activity (see #$DevisedStructuredActivity) s/he practices or engages in. (#$practicesStructuredActivity AGENT ACTIVITY) means that AGENT practices ACTIVITY.  Specializations of this predicate include #$onDietProgram.")
(comment hasFlawType "This predicate relates things to the instance of #$IndividualTypeByFlaw that it has.  Since things are often deemed to be flawed only with respect to some plan, purpose or agent, this predicate may have to be contextualized.  This is a very general relation and it may be preferable to utilize #$flawAccordingToAgent, #$flawedWRTRoleInSitType, or #$complianceStatus.")
(comment Tapas "Small and varied appetizers and finger food typically served at wine bars; traditional snack in the Andalusian region of #$Spain.")
(comment SubSitTypeOfTypeFn "Whenever SIT is an instance of SITTYPE and (#$properSubSituationTypes SITTYPE SUBSITTYPE), (#$SubSitTypeOfTypeFn SIT SITTYPE SUBSITTYPE) denotes the (unique) sub-situation SUB in SIT such that (#$subSituationOfType SIT SUB SUBSITTYPE).")
(comment ContentLexicalMtFn "(#$IPDALexicalMicrotheoryForFn IPDAMT) denotes the instance of #$LexicalMicrotheory that contains lexical data intended for use by the intelligent personal assistant program for the agent whose #$IPDAMicrotheory is IPDAMT.")
(comment scheduledNumberOfStops "(#$scheduledNumberOfStops TRANSPORTING NUMBER) is used to
relate an instance of #$TransportationEvent to the number of stops
NUMBER made during the journey. Stops are those subevents of any
instance of #$TransportationEvent in which the #$driverActor is
scheduled or intends to halt for a period of time. This predicate maybe used to
relate the number of stops a person intends to make while running
errands aa well as the number of scheduled stops on a train or bus trip.
During the course of the actual trip, more or fewer stops may
occur.")
(comment CommercialFreightFlight "A specialization of #$CommercialAirplaneTransportation.
Each instance of this collection is an #$AirplaneTrip in which only
cargo is transported.")
(comment FlightTypeByScheduledStopNumber "A specialization of #$FirstOrderCollection.  Each instance
of this collection is a collection of airline flights classified
according to the number, if any, stops the flight is scheduled to make.
See also #$DirectFlight, #$ConnectionFlight, and #$FlightConnectionFn
for additional vocabulary.")
(comment DirectFlight "A specialization of #$CommercialAirpassengerTransportation
in which no stops are scheduled. Thus the flight will proceed from its
#$toLocation without any intentional stops.")
(comment CommercialFlightWithScheduledStop "A specialization of CommercialAirplaneTransportation.  Each
instance of this collection is an airline flight that has at least one
scheduled stop.")
(comment CommercialFlightStopFn "An instance of #$ReifiableFunction used to denote the
collection of flights with a particular connection number.  If there
are no connections made during a flight, the flight is an instance of
#$DirectFlight and its value for this function is 0.  This function is intended to allow for collections of
#$CommercialFlightWithScheduledStop to be created on the fly.")
(comment InvitingType "The collection of types of #$Inviting-CommunicationAct.")
(comment dietUnsuitedTo "A #$FirstOrderCollectionPredicate and a specialization of #$dietRestricts (q.v.) that relates a given #$DietProgram (q.v.) to the types of food, drink, or ingredient whose consumption the diet is largely incompatible with.  (#$dietUnsuitedTo DIET TYPE) means that DIET severely restricts or prohibits (see #$dietProscribes) the consumption of many items of TYPE (some specialization of #$EdibleStuff) so that TYPE is by-and-large unsuitable for someone on DIET.  For example, while the #$BasicVegetarianDiet does not strictly prohibit #$BBQCuisine as such, (#$dietUnsuitedTo #$BasicVegetarianDiet #$BBQCuisine) certainly holds.")
(comment DayOfDateFn "(#$DayOfDateFn DATE) returns the instance of #$CalendarDay that contains DATE.")
(comment refineInUIA "(#$refineInUIA TERM MT) causes a new #$CycSalientDescriptor to be launched in MT for TERM.")
(comment keSceneInScriptRequiresUserInput "Must get the user input for scene of this type in script.")
(comment SoftwareDemonstration "The collection of presentations in which a piece of software is demo'ed.")
(comment DrugTrafficker "The collection of all #$IntelligentAgents that do, or have, regularly engaged in the activity of #$DrugTrafficking.")
(comment BiochemicallyHarmfulSubstanceReleaseSituationFn "(#$BiochemicallyHarmfulSubstanceReleaseSituationFn TYPE) refers to the collection of #$DangerousSituations in which TYPE is at least one of the kinds of #$BiochemicallyHarmfulSubstances released into the environment.")
(comment ExposureThroughEyeContact "The collection of all #$ExposureToSubstance events in which the eye of the organism that is exposed and the stuff to which it is exposed are in direct external physical contact")
(comment EyeContactWithFn "(#$EyeContactWithFn TYPE) denotes the collection of situations in which an animal's eye touches an instance of TYPE.")
(comment eyeContactWithTypes "(#$eyeContactWithTypes CONTACT-TYPE OBJECT-TYPE) means that CONTACT-TYPE is the collection of #$TouchingEvents in which there is direct contact between an instance of OBJECT-TYPE and an animal's eye.")
(comment flawAccordingToAgent "This predicate relates things to the flaw attribute that they are deemed to have according to some agent.  (#$flawAccordingToAgent THING FLAWATT AGENT) means that AGENT believes THING to be flawed at flaw level FLAWATT or with a flaw kind, FLAWATT.  This allows us to take into account the fact that within the same context things can be deemed flawed according to one agent and not another or that the degree or kind of flaw may depend upon one's perspective. Compare with #$hasFlawAttributes, #$flawedWRTRoleInSitType, #$complianceStatus.")
(comment CardiacArrest "An instance of #$PhysiologicalConditionType and a specialization of #$HeartCondition. #$CardiacArrest denotes the collection of all physiological conditions in which the heart has stopped beating or is otherwise unable to pump a quantity of blood sufficient to sustain vital organs. Note that #$CardiacArrest is different from #$HeartAttack, which denotes the physiological condition in which some region of the heart muscle is (merely) damaged due to an inadequate supply of oxygen.")
(comment RespiratoryArrest "An instance of #$PhysiologicalConditionType and a specialization of #$RespiratoryAilment. #$RespiratoryArrest denotes the collection of all physiological conditions in which breathing has (involuntarily) ceased.")
(comment CardiopulmonaryArrest "An instance of #$PhysiologicalConditionType and a specialization of both #$HeartCondition and #$RespiratoryAilment. #$CardiopulmonaryArrest denotes the collection of all physiological conditions in which both breathing and effective heart function have suddenly ceased. Compare #$HeartAttack and #$CardiacArrest.")
(comment exposureLimitOverTime "(#$exposureLimitOverTime SUBSTANCE LIMIT EXP-DURATION
EXP-PARAMETER OVER-DURATION OVER-PARAMETER) means that LIMIT is the
limit of SUBSTANCE a normal, healthy adult may be exposed to in the
duration of EXP-DURATION for the parameter EXP-PARAMETER over the
period of OVER-DURATION for OVER-PARAMETER.  Essentially, (exposureLimitOverTime ?SUBSTANCE (PartsPerMillion 400) (HoursDuration 8) Weekday (HoursDuration 40) CalendarWorkWeek) means that a healthy human adult should not be exposed to more than 400 ppm of SUBSTANCE during an 8 hour work day for any given 40 hour work week.  Substances may have more than one exposure limit.")
(comment IntermittentlyFlawed "The collection of all things that have a flaw  that does not always make itself apparent.  Instances of this collection are often functionally denoted using #$IntermittentlyFlawedFn.  In software, an intermittent bug is a bug that does not affect every execution of the software program, but which seems to occur 'every now and then'. Such bugs make related instances of #$DebuggingAComputerProgram harder rather than easier. Sometimes programmers just live with such bugs, rather than fixing them, if they strike infrequently.  See also the situation type, #$Flaw-Intermittent.")
(comment USAirForceMedicalCenter "The collection of all medical centers operated by or under the direction of the United States Air Force.")
(comment NonCivilianMedicalCareOrganization "The collection of all #$MedicalCareOrganizations that serve non-civilians, especially military personnel and veterans, as well as their families.")
(comment CivilianMedicalCareOrganization "The collection of all #$MedicalCareOrganizations that serve civilian families.")
(disjointWith CivilianMedicalCareOrganization NonCivilianMedicalCareOrganization)
(comment objectHarmed "An #$ActorSlot and a specialization of both #$objectActedOn and #$thingHarmed (qq.v.).  <code>(#$objectHarmed EVENT OBJECT)</code> means that <code>OBJECT</code> has been harmed in <code>EVENT</code>.  The harm to <code>OBJECT</code> might be in the form of damage (see the specialization #$damages) or, if <code>OBJECT</code> is an #$Agent-Generic, the harm might consist in the interests or well-being of <code>OBJECT</code> being thwarted or blocked (see the specialization #$maleficiary).")
(comment medicalRecommendationForRoleInType "An instance of #$QuaternaryPredicate. (#$medicalRecommendationForRoleInType SIT-TYPE ROLE-IN-SIT-TYPE RECOMMENDATION PRESCRIBED-ROLE) means that it is medically recommended that a biological living object playing ROLE-IN-SIT-TYPE in SIT-TYPE play the role PRESCRIBED-ROLE in RECOMMENDATION. For instance, (#$medicalRecommendationForRoleInType #$PoisonIvyPoisoning #$actorPartsInvolved (#$DrugTherapyUseFn #$Calamine) #$bodilyActedOn).")
(comment AnticommunistIdeology "A
belief that #$Communism is a pernicious belief system, and one that must
be resisted.")
(comment thingHarmed "A binary predicate that relates a given event to any of the temporal things harmed in the course of that event.  <code>(#$thingHarmed EVENT THING)</code> means that <code>THING</code> has been harmed in <code>EVENT</code>.  If <code>THING</code> is a #$SomethingExisting (e.g. a #$PartiallyTangible object or an #$Agent-Generic), see the more specialized predicate #$objectHarmed (and its specializations).  If <code>THING</code> is a #$Situation, then <code>EVENT</code> has resulted in <code>THING</code>'s somehow becoming less desirable or less valuable, or has made <code>THING</code>'s continuing to obtain less likely.")
(comment InducingVomiting "A specialization of both #$PurposefulPhysicalAction and #$CausingAnotherObjectsTranslationalMotion. Each instance of #$InducingVomiting is an action whose purpose is to cause some person (or sometimes some other type of animal) to vomit, and which does in fact cause that person (or animal) to vomit. Instances of #$InducingVomiting are often done for a medical purpose.")
(comment TypePlaysRoleInScriptRefinementModule "This refinement module adds actors to ScriptEventTypes, based on known typePlaysRoleInScript assertions.")
(comment TypePlaysRoleInSceneRefinementModule "This refinement module adds actors to scenes of ScriptedEventTypes, based on known typePlaysRoleInScene assertions.")
(comment ColorlessThing "The collection of all things that have no #$ChromaticColor.
This may mean either that the thing in question is transparent, or
that it is completely reflective, or that it has brightness but no hue
or saturation.")
(comment ColorPerceptionCategoryType "A collection of collections.  Each instance of
#$ColorPerceptionCategoryType is a specialization of #$SpatialThing-Localized
that is a category of color perception.  This collection includes all
the specializations of #$Color, as well as #$ColorlessThing.  In
addition, this collection includes ranges of colors (See #$colorPerceptionCategoryRangeOfType).")
(comment MtUnionFn "(#$MtUnionFn . MTS) denotes the #$ProblemSolvingCntxt where each of MTS and all of their #$genlMts are relevant.  This microtheory effectively contains all of the assertions from all of MTS, regardless of any contradictions.")
(comment ColorPerceptionCategoryRangeFn "A commutative #$BinaryFunction.  #$ColorPerceptionCategoryRangeFn takes two instances of #$ColorPerceptionCategoryType and returns a new instance of #$ColorPerceptionCategoryType that is the range of color perception categories that lie between the two arguments.  For example, (#$ColorPerceptionCategoryRangeFn #$YellowColor #$RedColor) denotes the range of colors between (and including) yellow and red.  See also #$colorPerceptionCategoryRangeOfType.")
(comment InjuryConditionToPartTypeFn "A #$UnaryIntersectionFunction.  #$InjuryConditionToTypeFn
takes as its argument a specialization of #$OrganismPart COLL and
returns as its value all instances of #$InjuryCondition to COLL.
Thus, (#$InjuryConditionToTypeFn Brain) returns the collection of
injuries to the brain.  See also the corresponding predicate
#$injuryConditionToPartType.")
(comment injuryConditionToPartType "A #$FunctionalPredicate that relates a type of
#$InjuryCondition to the type of #$OrganismPart injured. (#$injuryConditionToPartType CONDITION ORG-PART) means that every
instance of CONDITION is an injury to an instance of ORG-PART.  Thus, (#$injuryConditionToPartType BrainInjury Brain) means that every instance of #$BrainInjury is an injury affecting some organism's #$Brain.")
(comment colorPerceptionCategoryRangeOfType "(#$colorPerceptionCategoryRangeOfType TYPE CATEGORY-1 CATEGORY-2) means that all
instances of TYPE, a specialization of #$SpatialThing-Localized, are instances of some collection COL, where COL is such that: 1) it is an instance of #$ColorPerceptionCategoryType, and 2) COL falls along a spectrum of color-relevant perceptual properties between CATEGORY-1 and CATEGORY-2.  For
example, (#$colorPerceptionCategoryRangeOfType #$Adamsite #$LightGreen-Color 
#$YellowColor) says that individual samples of adamsite be a
color somewhere on the spectrum between light green and yellow.  Similarly,  (#$colorPerceptionCategoryRangeOfType #$NitrogenMustard-1 #$ColorlessThing #$PaleYellow-Color) says that samples of HN-1 will be somewhere along the spectrum of having no color to being pale yellow.  \"The spectrum\" here refers to an intuitive range directly between and including the two types; one can think of mixing two substances with those color-perception properties in various proportions to imagine what sorts of types would belong in the spectrum.  See also #$colorRangeOfType, which is restricted to #$Colors, and is tied to a particular direction around the color wheel, and thus for which argument order matters significantly.")
(disjointWith StatelessPerson PersonWithNationality)
(comment colorPerceptionCategoryBelongsInRange "An instance of #$TransitiveBinaryPredicate. (#$colorPerceptionCategoryBelongsInRange CATEGORY RANGE) says that the #$ColorPerceptionCategoryType CATEGORY falls within the range of #$ColorPerceptionCategoryTypes that define RANGE.  For example, (#$colorPerceptionCategoryBelongsInRange #$RedColor  (#$ColorPerceptionCategoryRangeFn #$RedColor #$DarkOrangeYellow-Color)) says that #$RedColor falls within the range of colors from red to dark orange-yellow.")
(comment colorPerceptionRangeDefinedBy "The #$functionCorrespondingPredicate-Canonical for #$ColorPerceptionCategoryRangeFn.  (#$colorPerceptionRangeDefinedBy RANGE CATEGORY-1 CATEGORY-2) identifies RANGE as the unique #$ColorPerceptionCategoryType that is a range of color-perception categories that fall between CATEGORY-1 and CATEGORY-2.")
(disjointWith HomoSapiens NonHumanAnimal)
(comment NonHumanAnimal "The collection of all instances of #$Animal that are not instances of #$HomoSapiens. See also #$NonPersonAnimal.")
(comment ExtraterrestrialPerson "Each instance of this collection is a #$Person belonging to a species which did not arise on #$PlanetEarth (e.g. the fictional character E.T.).")
(comment PoliteSpeech "a quality of lexical senses or terms that are considered polite.")
(comment ImposingEconomicSanctions "#$ImposingSanctions #$Events in which a political body imposes economic sanctions, i.e., sanctions whose primary intended effect is to apply financial pressure or punishment to some organization, country, or individual.  Note that diplomatic sanctions can be imposed whose primary role is not economic; for example, #$SanctionsOnLibya-March1992 were specifically sanctions against air travel to and from #$Libya.  Also note that #$ImposingSanctions events have an even broader meaning.")
(comment LevelOfSubstanceInSystem "A specialization of #$PhysicalQuantity, each instance of #$LevelOfSubstanceInSystem is a qualitative or quantitative \"measure\" of the level of some substance in a system, for example, the amount or level of water in an #$Organism-Whole. See also #$LevelOfStandardSubstanceFoundInSystem.")
(comment LevelOfStandardSubstanceFoundInSystem "A specialization of #$PhysicalQuantity, each instance of #$LevelOfSubstanceInSystem is a qualitative or quantitative \"measure\" of the level of some substance in a system where the substance is of a type _standardly_ found in the relevant system type.  For example, water is standardly found in mammals but caffeine is not.  So instances of this collection could be used to indicate the level of water in a mammal, but not the level of caffeine. To indicate the level of caffeine use #$LevelOfSubstanceInSystem together with a #$GenericValueFunction (and #$LevelOfSubstanceTypeInSysTypeFn).")
(comment LowLevelOfStandardSubstanceInSystem "An instance of #$LevelOfStandardSubstanceFoundInSystem for indicating the level of a substance standardly found in an system is lower than normal.")
(comment NormalLevelOfStandardSubstanceInSystem "An instance of #$LevelOfStandardSubstanceFoundInSystem for indicating the level of a substance standardly found in an system is normal.")
(comment ElevatedLevelOfStandardSubstanceInSystem "An instance of #$LevelOfStandardSubstanceFoundInSystem for indicating the level of a substance standardly found in an system is higher than normal.")
(comment LevelOfSubstanceTypeInSysTypeFn "A ternary function used for denoting specializations of #$SystemCondition based on the level of some type of substance in some type of system. (#$LevelOfSubstanceTypeInSysTypeFn SUB-TYPE SYS-TYPE LEVEL) denotes the specialization of #$SystemCondition for instances SYS of SYS-TYPE in which levels of SUB-TYPE are at LEVEL.  For example, (#$LevelOfSubstanceTypeInSysTypeFn #$Iron #$HomoSapiens #$LowLevelOfStandardSubstanceInSystem) denotes the collection of conditions in which a #$HomoSapiens has a lower than normal level of #$Iron for typical #$HomoSapiens.")
(comment conditionWithLevelOfSubstanceTypeInSysType "The corresponding predicate to #$LevelOfSubstanceTypeInSysTypeFn. (#$conditionWithLevelOfSubstanceTypeInSysType SYS-COND SUB-TYPE SYS-TYPE LEVEL) means the SYS-COND is the condition of an instance of SYS-TYPE with a level LEVEL of SUB-TYPE in it.")
(comment LicensePlate-Information "A license to operate a particular vehicle.")
(comment LicensePlate "An instance of #$OfficialDocumentType, and a specialization of #$License-IBO. Each instance of #$LicensePlate is a license issued by some governmental agency to a person that permits the person to operate a particular vehicle.  It is usually required that the #$LicensePlate be mounted on the rear of the car and often an identical #$LicensePlate must go on the front.  It is considered illegal in most places to drive a car that does not have a #$LicensePlate on it.")
(comment licensePlateNumberAndLocation "(#$licensePlateNumberAndLocation LICENSE-PLATE STRING STATE) relates a LICENSE-PLATE to its number STRING and the STATE in which it was issued.")
(comment TimeElapsedDecodeStringFn "An #$IndividualDenotingFunction. (#$TimeElapsedDecodeStringFn
TEMPLATE TIME-STRING) takes two instances of #$CharacterString,
TEMPLATE and TIME-STRING, and returns as its value an instance of
#$Time-Quantity that is decoded equivalent, in #$SecondsDuration, of
TIME-STRING according to the format of TEMPLATE.  For example, (#$TimeElapsedDecodeStringFn 'HHMM' '0101') returns (#$SecondsDuration 3660).  See also #$TimeElapsedEncodeStringFn.")
(comment TimeElapsedEncodeStringFn "An #$IndividualDenotingFunction. (#$TimeElapsedEncodeStringFn TEMPLATE TIME-QUANTITY) takes an instance
of #$CharacterString TEMPLATE and an instance of #$Time-Quantity
TIME-QUANTITY and returns a string encoding of TIME-QUANTITY in the
format of TEMPLATE.  Thus, (#$TimeElapsedEncodeStringFn 'HHMM' (MinutesDuration 65) returns '0105', where '01' is equivalent to one
hour and '05' is five minutes.")
(comment hasEvaluativeQuantity "A #$NonAspectualQuantitySlot (q.v.) that relates #$Individuals to their #$EvaluativeQuantity[ies] (q.v.).  <code>(#$hasEvaluativeQuantity OBJ EVALQUANT)</code> holds just in case <code>EVALQUANT</code> characterizes <code>OBJ</code>.
<p>
Important specializations of this predicate include #$moralCharacter and #$moralityOfAct.")
(comment Goodness-Functional "A linear-ordered specialization of #$Goodness-Generic whose instances reflect assessments of the relative functional (utility) worth of a particular thing.  Such assessments are usually made in relation to some (often implicit) standard held by the assessor.    Particular instances of this collection can be obtained via the various #$GenericValueFunctions.")
(comment Goodness-Generic "A linear-ordered specialization of #$EvaluativeQuantity whose instances reflect assessments of the relative worth of a particular thing.  Such assessments are usually made in relation to some (often implicit) standard held by the assessor; this standard might purport to measure a thing's usefulness, or its value, or its moral worth, or its beauty, or something else.  #$Goodness-Generic is thus \"generic\" with respect to these various categories of worth.  Particular instances of this collection can be obtained via the various #$GenericValueFunctions.  Note: If a particular dimension of goodness is sought you should use one of the specializations of this collection; e.g. #$Goodness-Moral, #$Goodness-Functional. ")
(comment IsotopeStuffType "A collection of collections and a specialization of #$ElementStuffType. Each instance of 
IsotopeStuffType is a specialization of #$IsotopeStuff.")
(comment IsotopeStuffType "A collection of collections and a specialization of #$ElementStuffType. The instances of 
IsotopeStuffType are all and only specializations of #$Isotope.")
(comment IsotopeStuffTypeByAtomicMass "A collection of collections and a specialization of #$IsotopeStuffType. 
Each instance of IsotopeStuffTypeByAtomicMass is a specialization of #$Isotope which is defined 
_only_ by the isotopic composition of its instances -- neither the physical state of the substances
nor any other additional feature determines membership in an instance of 
IsotopeStuffTypeByAtomicMass. All that matters is that the instances of that collection are entirely 
composed of atoms having a particular number of protons and neutrons in each atomic nucleus. 
The collection #$IsotopeCarbon14, for example, is an instance of IsotopeStuffTypeByAtomicMass.")
(comment kbSentence "A #$KBDependentRelation (q.v.) and specialization of #$knownSentence (q.v.) that is used to state that a given #$CycLSentence-Assertible is provable by Cyc directly from the KB without appealing to any SKSI removal
module.
<p>
This predicate enables Cyc to select a subset of information when answering queries, filtering out the virtual assertions which reside in an external knowledge source only accessible through SKSI.")
(comment locatedInBoundingBoxWithCoordinates "If PLACE has #$latitude LAT and #$longitude LON, then
(#$locatedInBoundingBoxWithCoordinates PLACE LAT-MAX LON-MIN LAT-MIN
LON-MAX) is true precisely if (LAT-MAX > LAT > LAT-MIN) and (LON-MAX >
LON > LON-MIN).")
(disjointWith Artifact-Generic Agent-NonArtifactual)
(comment Agent-NonArtifactual "A specialization of #$Agent-Generic. An instance AGENT of #$Agent-Generic is also an instance of #$Agent-NonArtifactual just in case AGENT is _not_ an instance of #$Artifact-Generic. Consequently, #$Agent-Generic includes all \"natural\" agents (such as instances of #$Animal), as well as any \"supernatural\" agents _not_ created by other agents.")
(comment treatmentSummaryForBiochemicalAgentType "An instance of #$BinaryPredicate. (#$treatmentSummaryForBiochemicalAgentType AGENT SENTENCE) means that SENTENCE presents information relevant to the treatment of people exposed in some way to AGENT.")
(comment ArticleTitledFn "(#$ArticleTitledFn ISSUE TITLE) returns the periodical
article with the title or headline TITLE that appears in the #$PeriodicalIssue
ISSUE.")
(comment UrgeToEat "The type of internal sensation or urge to eat.")
(comment FormulaTemplateMicrotheory-QL "A collection of microtheories that contain information about instances of #$FormulaTemplate which are intended to be used in the Query Library.")
(comment FormulaTemplateMicrotheory "A collection of microtheories that contain instances of #$FormulaTemplate.")
(comment FormulaTemplateMicrotheory-FET "A collection of microtheories that contain information about instances of #$FormulaTemplate which are intended to be used in the Fact Entry Tool.")
(comment whAdverbSemTrans "This predicate expresses the relationship between a wh adverb, a word sense, a subcategorization frame, and a CycL expression used to denote the adverb.")
(comment ProfilePerspective "The instances of #$VisualImage that depict some agent in profile.")
(comment CloseUpPerspective "The collection of instances of #$VisualImage for which the perspective is `close-up', tightly focused on a few or even one object, which seems to fill (usually the foreground of) the image space.")
(comment PortraitPerspective "The collection of instance of #$VisualImage that are portraits of an agent.  This implies more than just a camera angle, it also includes the intent of the image.")
(comment PanoramicPerspective "The collection of instances of #$VisualImage with a wide, 'complete' perspective, as ususally for landscapes.")
(comment AnimalSensoryQuantity "A specialization of #$SensoryQuantity.  Each instance of #$AnimalSensoryQuantity is a sensory quality detectable by some form of animal, including levels of urges and pain, as well as the various feelings represented by its specialization #$InternalSensoryQuantity.")
(comment GraspingHandPosition "The collection of instances of #$Hand that are in the position that hands typically are when grasping something in a fist-like manner, with fingers curled around the object being held.  Instances of #$GraspingHandPosition do not have to be holding anything, but typically are.")
(disjointWith ThumbsUpHandPosition ThumbsDownHandPosition)
(disjointWith Grasping HoldingBetweenTheSidesOfSomeFingers)
(disjointWith HoldingBetweenTheSidesOfSomeFingers HoldingUsingAFingerPad)
(comment PointingThumbsDown "The collection of instances of #$MakingAGesture in which a performer points his/her thumb downward to signify #$Disapproval.")
(disjointWith HoldingWithOnlyOneHand HoldingWithBothHands)
(comment featureOfTypeLocatedInBoundingBoxWithCoordinates "If PLACE #$isa TYPE, has #$latitude LAT and #$longitude LON,
then (#$featureOfTypeLocatedInBoundingBoxWithCoordinates PLACE LAT-MAX
LON-MIN LAT-MIN LON-MAX) is true precisely if (LAT-MAX > LAT >
LAT-MIN) and (LON-MAX > LON > LON-MIN).")
(comment DetectingSomethingPhysical "An instance of FirstOrderCollection and a specialization of
PhysicalEvent. An instance of DetectingSomething is an event in which
some tangible thing is determined to be an instance of a particular
collection. Consider, for example, an event in which some stuff is
determined to be smoke. Such an event is an instance of
DetectingSomething in which some #$SmokeAlarm would probably play the
role of #$detector and so would stand in the #$detects relation to the
relevant instance of #$Smoke. See also #$typeDetected.")
(comment typeDetected "(typeDetected EVENT TYPE) says that in EVENT, the #$detector
is used to determine that the #$objectActedOn is an instance of TYPE.")
(comment detectsType-Genl "(#$detectsType-Genl DEVICE-TYPE THING-TYPE) means that an
instance of DEVICE-TYPE can be used to detect instances of
THING-TYPE. More precisely, it means that an instance of DEVICE-TYPE
can be used to decide whether or not something is an instance of some
collection that is (i) a generalization of THING-TYPE and (ii) a
specialization of some type that is interesting in the current context
with respect to detection. In other words, it means that there are
some types GEN-TYPE and INTERMEDIATE-TYPE such that
(#$interestingForRoleInType GEN-TYPE #$typeDetected #$DetectingSomething)
and (#$genls THING-TYPE INTERMEDIATE-TYPE) and (#$genls INTERMEDIATE-TYPE
GEN-TYPE) and (#$detectsType-Exact DEVICE-TYPE INTERMEDIATE-TYPE).")
(comment interestingForRoleInType "An instance of TernaryPredicate. (interstingForRoleInType
THING ACTOR-SLOT SIT-TYPE) means that, in the current context, an
intersting class of situation consists of those instances of SIT-TYPE
for which the role ACTOR-SLOT is filled by THING.")
(comment detectsType-Exact "(#$detectsType-Exact DEVICE-TYPE THING-TYPE) means that
instances of DEVICE-TYPE can be used to decide whether or not
something is an instance of THING-TYPE. That is, it means that for
any instance, DEVICE, of DEVICE-TYPE, (i) for and any instance,
THING, of THING-TYPE, DEVICE can be used to determine that THING is
an instance of THING-TYPE, and (ii) for anything, THING, that is not
an instance of THING-TYPE, DEVICE can be used to determine that THING
is not an instance of THING-TYPE.")
(comment aliasList "(#$aliasList AGENT LIST) means that LIST contains various aliases for AGENT.  For every MEMBER of LIST, (#$alias AGENT MEMBER).")
(comment CycQueryRunning "A collection of individual events. Each instance of #$CycQueryRunning is an event in which some query, possibly derived from some #$CycLQuerySpecification, runs on an instance of #$CycTheCollection.")
(comment ConferenceSession "The collection of all conference sessions, events in which one or more people give presentations to an audience i
n a formal setting.  Between conference sessions, participants are apt to leave the room in which the session is held.  Many #$Conferences have multiple sessions occuring simultaneously.  Often breaks are scheduled between sessions, to give the participants a chance to rest, interact informally, take refreshments, and/or move to another session in a different room.")
(comment Glove-ChemicalAndBiological "The collection of gloves that are meant to reduce the likelihood of exposure and spreading of harmful chemicals and biological infections.")
(comment editorOfPublication "(#$editorOfPublication EDITOR PUBLICATION) means that EDITOR is an editor of PUBLICATION.")
(comment citationTo "(#$citationTo WORK STRING) means that #$StructurallySpecificWork WORK can be refered to by the #$CharacterString STRING, which is a reference to WORK.  See #$referenceInWorkTo.")
(comment citationTo "(#$citationTo WORK STRING) means that #$StructurallySpecificWork WORK can be refered to by the #$CharacterString STRING, which is a reference to WORK.  See also #$referenceInWorkTo.")
(comment presentedCWInEvent "(#$presentedCWInEvent WORK EVENT) means that an instantiation of the #$ConceptualWork, WORK, is presented for others to hear or view as a #$subEvents of the larger #$Event, EVENT.")
(comment testTypeFolder "An instance of #$BinaryPredicate.  (#$testTypeFolder TEST-TYPE FOLDER) says that FOLDER is a #$KEInteractionFolder designed to hold only templates based on instances of the #$KBContentTestSpecificationType TEST-TYPE.")
(comment Corrugation-Topographical "The collection of topographical features characterized by alternating ridges and grooves.  The width of each crevice in a corrugation is significantly less than its length.")
(comment criminalWantedByOrganization "(#$criminalWantedByOrganization CRIMINAL ORGANIZATION) means that CRIMINAL is listed by ORGANIZATION as having committed some crime and ORGANIZATION is actively trying to catch and arrest CRIMINAL.")
(comment ScalarOrVectorInterval "A specialization of #$TupleOfIntervals (q.v.).  #$ScalarOrVectorInterval is the collection of all measurable intervals, whether scalar or vector.  It thus includes all numbers, quantities, and vectors.
<p>
For more information, see the specializations #$ScalarInterval and #$VectorInterval.")
(comment BiochemicalWarhead "The collection of #$Warheads that contain a #$BiochemicallyHarmfulSubstance instead of conventional #$ExplosiveDevices.")
(comment PublishedConceptualWork "The collection of all #$ConceptualWorks with instantiations which have been produced for distribution. Note that \"published\" here does not mean \"printed and physically distributed\", since intangible information-bearing things can be published using the #$WorldWideWeb-Concrete, or broadcast on the airwaves.")
(comment projectSourceTypeCollection "(#$projectSourceTypeCollection PROJECT SOURCE-COL)
means that domain-specific facts entered for PROJECT are expected to
be drawn primarily from the types of sources contained in
SOURCE-COL.  The guided fact-entry process for PROJECT will present users 
with the instances of SOURCE-COL when they are asked to categorize (and further identify) 
their source.")
(comment PublishedIBT "The collection of all #$InformationBearingThings which have been produced for distribution. Note that \"published\" here does not mean \"printed and physically distributed\", since intangible information-bearing things can be published using the WorldWideWeb-Concrete, or broadcast on the airwaves.")
(comment House-Country "A #$House-Country is a large house, mansion, or chateau, on a large estate.")
(disjointWith BodyOfWater LakeBed)
(comment UIInputComponent "Instances of #$UIInputComponent are components of user interfaces that allow the user to add or edit input. These components are not programs themselves, but rather are relatively small amounts of code that can be incorporated into programs. In some programming languages, these are known as 'widgets'. Oftentimes these components will be specific to the type of input that is expected from the user. For example, a calendar component (see #$UICalendarInput) might be used when the user is expected to enter a date, and a simple button might be used when the user is expected to acknowledge a message.")
(comment UICalendarInput "Instances of #$UICalendarInput are calendars within a user interface that allow the user to specify, edit, or view a date. #$UICalendarInput and #$CalendarProgram are different because #$UICalendarInput is not a stand-alone program itself, but merely a componenet or 'widget' within a user interface. #$UICalendarInput does not have additional functionality beyond selecting/editing/viewing a date.")
(comment objectPhotographedAtLocation "(#$objectPhotographedAtLocation AIS PLACE) relates some information AIS to the location PLACE at which it is recorded.")
(comment licensePlateInformation "(#$licensePlateInformation LICENSE-PLATE INFORMATION) means that INFORMATION is found on LICENSE-PLATE.")
(comment interfaceEditorForCollection "(#$interfaceEditorForCollection COL EDITOR) means that EDITOR is an appropriate type of #$UIInputComponent to use to acquire user input about instances of COL. For example, #$UICalendarInput is an appropriate type of #$UIInputComponent to use to acquire user input about instances of #$Date.")
(comment DegreeType "DegreeType is a collection of collections. Each element of DegreeType is a collection of EducationalDegrees granted to persons having attained a specific level of education.  #$DegreeType is partitioned into #$DegreeTypeByLevel (ignores #$FieldOfStudy) and #$DegreeTypeByField (specifies #$FieldOfStudy).")
(comment DegreeTypeByLevelOrName "DegreeTypeByLevel is a collection of collections. Each element of DegreeType is a collection of EducationalDegrees granted to persons having attained a specific level of education irrespective of the #$FieldOfStudy.  Also see #$DegreeTypeByField.")
(comment licenseIssuedForLocation "(#$licenseIssuedForLocation LICENSE PLACE) means that LICENSE was issued specifically for PLACE.  This does not mean, however, that LICENSE is not valid outside of PLACE, only that it is definitely valid in PLACE for a certain time period.  For example, a drivers license may be issued in Texas.  Up to the point of its expiration, it is definitely valid in Texas.  It is probably valid in most of the US as well.  It may not be valid everywhere outside of the US.")
(comment hasPositionInOrgDuring "(#$hasPositionInOrgDuring PERS ORG POS-TYPE INTERVAL) means that during the #$TimeInterval, INTERVAL, PERS holds the position POS-TYPE in the organization ORG.")
(comment DegreeTypeByLevel "DegreeTypeByLevel is a collection of collections. Each element of DegreeType is a collection of EducationalDegrees granted to persons having attained a specific level of education irrespective of the #$FieldOfStudy.  Also see #$DegreeTypeByField.")
(comment NamedDegreeType "#$NamedDegreeType. is a collection of collections. Each element of #$NamedDegreeType is a collection of #$EducationalDegrees that is granted its own set of initials.  For example, J.D., R.N, B.F.A., M.S., D.O.")
(comment PurposefulAction-ResourceAcquisition "A specialization of #$PurposefulAction. Each instance of #$PurposefulAction-ResourceAcquisition is an event in which an agent performs a #$PurposefulAction toward the end of #$GainingControl over a resource. An important, more specific subtype is #$PurposefulAction-ResourceTransformation.")
(disjointWith PurposefulAction-ResourceAcquisition DeliveryOfWeaponToTarget)
(comment PurposefulAction-ResourceTransformation "An instance of #$FirstOrderCollection that is a specialization of #$PurposefulAction. Each instance of #$PurposefulAction-ResourceTransformation begins with a #$GainingControl of some resource that leads to a #$PurposefulAction that results in #$GainingControl over a another type of resource. It is a subtype for both  #$PurposefulAction-ResourceDriven  and #$PurposefulAction-ResourceAcquisition.")
(comment keIrrelevantTypeGenls "(#$keIrrelevantTypeGenls TERM) should be used for all terms whose instances should not be suggested even though a #$typeGenls assertion may suggest it.")
(comment objectCrossesBorderCheckpoint "(#$objectCrossesBorderCheckpoint OBJECT CHECKPONT) means that OBJECT crosses a border at the #$BorderCheckpointFacility CHECKPOINT.  This does not preclude OBJECT from crossing at any other CHECKPOINT as well.")
(comment symptomAssociatedWithExposureToAgentType "A predicate for relating physiological conditions with
chemical or biological agents associated with them.
(#$symptomAssociatedWithExposureToAgentType SYM AGT-TYPE)
means that the #$PhysiologicalCondition is a symptom
associated with exposure to the chemical or biological
agent type AGT-TYPE.  See #$symptomOfAilment.")
(comment TemporallyExistingThingTypeFrequentlyForSale "The collection of all types of things that are usually/frequently/always for sale.  This is context dependent.")
(disjointWith SpatialThingTypeByShape TemporallyExistingThingTypeFrequentlyForSale)
(disjointWith QuantityType TemporallyExistingThingTypeFrequentlyForSale)
(disjointWith ClimateCycleType TemporallyExistingThingTypeFrequentlyForSale)
(comment ServiceTypeFrequentlyForSale "The collection of all types of #$ServiceEvents that are usually/frequently/always for sale.  Ones always for sale are specs of #$ServiceProduct.  This collection is context dependent.")
(disjointWith PersonTypeByCulture ServiceTypeFrequentlyForSale)
(comment SpiderHarmfulToHumans "The collection of spiders whose venom can be harmful to humans (e.g. #$BlackWidowSpider).")
(comment WidowSpider "The collection of spiders in the Latrodectus genus (Theridiidae family). The most well-known of these is the Latrodectus mactans, commonly known as the #$BlackWidowSpider.")
(comment RecluseSpider "The collection of spiders in the Loxosceles genus (Sicariidae family). The most well-known of these is the Loxosceles reclusa, commonly known as the #$BrownRecluseSpider.")
(comment FunnelWebSpider "The collection of funnel web spiders. They are found throughout the world and are known for their funnel-shaped webs. They are large spiders that are dark brown to black in color. The venom of funnel web spiders is highly toxic, especially to primates. Atrax and Hadronyche are the two kinds of funnel web spiders.")
(comment VenomousSnake "The collection of venomous snakes (e.g. #$Cobra).")
(comment HTMLForTextContainingStringsFn "Given a string of a document TEXT and a set of strings contained in that document STRING-CYC-SET, (#$HTMLForTextContainingStringsFn TEXT STRING-CYC-SET) will evaluate to an HTML string highlighting the strings in the sentences in which they appear, i.e. sentences in which the strings do not appear will me removed.")
(comment CDEQuerySpecification "A specialization of #$CycLQuerySpecification.  Instances of this collection specify queries designed to be run against the Central Data Exchange (CDE).")
(comment propertiesOfSubstanceAtTemperature "An instance of #$TernaryPredicate.   (#$propertiesOfSubstanceAtTemperature SUBSTANCE PROPERTY TEMPERATURE) says that when an instance of SUBSTANCE is at the temperature TEMPERATURE, it will have the property (will be an instance of) PROPERTY.")
(comment Fusarium "A higher fungi causing root, stem, and corm rot under field conditions and pink and yellow molds of fruits during postharvest storage.  When growing on corn and other grains, some species of #$Fusarium produce #$Mycotoxins.")
(comment Trichothecene "A specialization of #$Mycotoxin.  Trichothecene mycotoxins are the type of #$Mycotoxin most suitable for use as a weapon in biological warfare.")
(comment Fusarium-sporotrichioides "A species of #$Fusarium.")
(comment Fusarium-graminearum "A species of #$Fusarium.")
(comment SaffronQuerySpecification "A specialization of #$CDEQuerySpecification.  Instances of this collection specify queries designed to be run against the portion of the  Central Data Exchange (CDE) derived from Saffron's SAMS tool.")
(comment ExploraniumMiniSpecGR130DataSheet "Describes the ExploraniumMiniSpecGR130")
(comment fullAddressText "(#$fullAddressText PLACE ADDRESS) associates the #$CharacterString ADDRESS with PLACE as the full address text string for PLACE.")
(comment decontaminationSummaryForBCWAgentType "#$decontaminationSummaryForBCWAgentType is an instance of #$TernaryPredicate, used to allow Cyc to retrieve knowledge about the decontamination of things from types of substances. (#$decontaminationSummaryForBCWAgentType SUBSTANCE SENTENCE) says that SENTENCE is one of the sentences describing decontamination information for SUBSTANCE. Generally, decontamination rates depend havily on environmental factors, such as the medium of decontamination, air pressure, wind and temperature.")
(comment chemicalHalfLifeInMediumAtTemperature "(#$chemicalHalfLifeInMediumAtTemperature  CHEMICAL DURATION MEDIUM TEMP) means that an instance of #$ChemicalSubstanceType CHEMICAL has a half-life of #$Time-Quantity DURATION in instances of #$TangibleStuffStateType MEDIUM that are at the #$Temperature TEMP.  A chemical's half-life is the amount of time it takes that chemical to break down to one half of its original concentration.")
(comment DecontaminationProcedureFn "(#$DecontaminationProcedureFn SUBSTANCE) denotes the procedure recommended for decontaminating something contaminated with #$ChemicalSubstanceType SUBSTANCE.")
(comment decontaminationProcedureFor "(#$DecontaminationProcedureFn SUBSTANCE PROC) means that #$DecontaminationProcedure PROC is the procedure that should be followed decontaminate something contaminated with #$ChemicalSubstanceType SUBSTANCE.")
(comment recommendedDecontaminant "(#$recommendedDecontaminant CONTAM DECONTAM) means that a standard use of #$ChemicalSubstanceType DECONTAM is to decontaminate substances contaminated with #$ChemicalSubstanceType CONTAM.")
(comment OdorTypeByStrength "A collection of types of tangible things. 
Each instance of #$OdorTypeByStrength is a collection of things whose
odor has a given strength. That is, for any instance, ODFIEROUS-THING-TYPE, of #$OdorTypeByStrength, any instance of ODFIEROUS-THING-TYPE has an odor of the 
same strength as does any other instance of ODFIEROUS-THING-TYPE.")
(comment SubCollectionNamedFn "(#$SubCollectionNamedFn \"durian\" #$Fruit) denotes the subcollection of all fruits called \"durian\". This is useful for creating at run-time subcollections of known collections based on our understanding of the likely meaning of out of vocabulary items.")
(comment SharpOdor "An instance of #$Odor and a specialization of 
#$StrongOdor. Instances of this collection are things with a sharp odor.
Sharp odors are strong and acrid, and have a momentary period of
extra intensity when first perceived.")
(comment StrongOdor "An instance of #$OdorTypeByStrength. Instances of this 
collection are things with a strong odor.")
(comment WeakOdor "An instance of #$OdorTypeByStrength. Instances of this 
collection are things with a weak odor.")
(comment TrinityRiverOfTexas "A #$River in #$Texas-State.")
(comment arg1Isa-Inferred "(#$arg1Isa-Inferred PRED COL) means that whenever (PRED ARG1 . ARGS) is true the ARG1 is an instance of the #$Collection, COL.")
(comment LicensedProductType "The collection of all types of goods and services [#$TemporalThingTypeFrequentlyForSale] that are licensed for sale or distribution.  Membership in this collection is highly context dependent.")
(comment participantStatus "(#$participantStatus AGENT EVENT PARTICIPATION-FORM) means that the #$Agent-Generic, AGENT, participates in #$Event, EVENT, in the manner of PARTICIPATION-FORM, an instance of #$SocialGatheringParticipationPredicate.  I.e. (PARTICIPATION-FORM AGENT EVENT).  Examples of such particpation forms are #$confirmedParticipantIn, #$declinedParticipationIn, #$noShowFor, etc. The status of the participant can change over time; e.g., when a passenger with an airline reservervation shows up and gets a boarding pass, or when s/he actually surrender the boarding pass and boards the plane.")
(comment ReactionToSituationTypeFn "#$ReactionToSituationTypeFn returns a collection of actions when given a type of situation as an argument.  (#$ReactionToSituationTypeFn SIT-TYPE) denotes the specialization of #$Action whose instances are all and only the actions deliberately performed in reaction to a type of #$Situation SIT-TYPE.")
(comment jurisdictionOverIndividual "(#$jurisdictionOverIndividual AGENT THING) means that the
LegalAgent AGENT has jurisdiction over the PartiallyTangible
THING. This is a high level and vague notion of jurisdiction that will
fill a gap in the KB until the notion of jurisdiction can properly be
dissected into its more specific meanings.  Proper use of this
constant, for example, would be to express that a government AGENT has
jurisdiction over a citizen of that government, THING.  Even though the
arg constraints are very loose, however, this constant is not to be
used to say that a person has jurisdiction over their hand.")
(comment interestingLinksSummary "An instance of #$SummaryPredicate that relates the elements of an instance of #$Set-Mathematical to interesting sentences that describe connections among them.  (#$interestingLinksSummary SET SENTENCE) holds if and only if 1) for every element E of (see #$elementOf) SET, SENTENCE mentions E, and 2) SENTENCE is of interest in the current context.  Interestingness is highly context sensitive, and for #$interestingLinksSummary, is handled through microtheories.")
(comment CSISReport-RadiologicalAndNuclearWeapons "Center for Strategic and International Studies Report entitled \"Asymetric and Terrorist Attacks with
Radiological and Nuclear Weapons\", dated September 23, 2001, by Anthony H. Cordesman and Arleigh A. Burke, Chair in Startegy.")
(comment BritishColonialSubject "The collection of people who are subjects of a British colony, protectorate, or other part of the British Empire.  Such people are not considered to be #$BritishPersons.")
(comment sporeTypeOfBacteriaType "(#$sporeTypeOfBacteriaType BACTERIA-TYPE SPORE-TYPE) means that SPORE-TYPE is the collection of BACTERIA-TYPE in their spore form.")
(comment colocatedEvents "(#$colocatedEvents EVENT1 EVENT2) means that EVENT1 and
EVENT2 both occur in the same city on the same date.")
(disjointWith Facility-Generic NaturalTangibleStuff)
(comment CBRNE-FactTemplate "A collection of formula templates used for CBRNE fact entry.")
(comment CBRNE-ChemicalAgentTemplate "A collection of formula templates used for CBRNE fact entry about instances of #$ChemicalAgentType.")
(comment CBRNE-ChemicalAgentTemplate-Name "A collection of formula templates used for CBRNE fact entry that concern the names and identification of instances of #$ChemicalAgentType.")
(comment CBRNE-ChemicalAgentTemplate-Chemistry "A collection of formula templates used for CBRNE fact that concern chemical information about instances of #$ChemicalAgentType.")
(comment CBRNE-ChemicalAgentTemplate-Toxicity "A collection of formula templates used for CBRNE fact that concern the toxic properties of instances of #$ChemicalAgentType.")
(comment CBRNE-ChemicalAgentTemplate-Use "A collection of formula templates used for CBRNE fact that concern the toxic properties of instances of #$ChemicalAgentType.")
(comment numberRange "(#$numberRange NUMBER-TYPE INTERVAL) means that INTERVAL
represents the range of the collection of #$Number-General
NUMBER-TYPE.  For example, (#$numberRange (NumberFromFn 1 10) (Unity 1
10)).")
(comment SuicideBomber "A specialization of #$Terrorist. Suicide bombers are those who train for and carry out (usually just single) suicide bomb attacks.")
(comment Gastroenteritis "Irritation and inflammation of the digestive tract.  #$BacterialGastroenteritis and #$ViralGastroenteritis are two major sub-types.")
(comment BacterialGastroenteritis "A kind of #$BacterialInfection that causes inflamation of the stomach and intestines.")
(comment StringInDocumentFn "(#$StringInDocumentFn PCW STRING) denotes the (contextually salient) subwork of PCW whose text corresponds to STRING.")
(comment QAndAAboutAnthraxPreventionAndTreatment "A Question and Answer webpage for the prevention and treatmen of#$AnthraxInfections.")
(comment FootballPlayer-AmericanTypeByPosition "The collection of all types of #$FootballPlayer-American faceted by position.")
(comment HealthProfessionalTypeBySpecialty "The collection of all types of #$HealthProfessional faceted by specialty.")
(comment testify-Court "(testify AGENT SENTENCE) means that AGENT bore witness,
based on personal knowledge or belief,in a court of law that PROP was
true.  This is does not mean that in fact PROP is true, consider the
case of mistake identifications, or that AGENT did not in fact lie to
the court, only that AGENT testified in court that PROP was true.")
(comment treasurer "An #$OrganizationalPositionSlot that is a specialization of #$seniorExecutives (q.v.).  <code>(#$treasurer ORGANIZATION AGENT)</code> means that <code>AGENT</code> is entrusted with the care, receipt, and disbursement of funds for <code>ORGANIZATION</code>.")
(comment monthOfDate "(#$monthOfDate MONTH DATE) means that month MONTH is the month of DATE.  For example, (#$monthOfDate #$June (#$DayFn 14 (#$MonthFn #$June (#$YearFn 1972)))) means that #$June is the month of the date (#$DayFn 14 (#$MonthFn #$June (#$YearFn 1972))).")
(comment calendarMonthIndex "(#$calendarMonthIndex MONTH-TYPE MONTH INDEX) means that in the calendar system MONTH-TYPE, #$PositiveInteger INDEX indicates  absolute rank-order of MONTH with respect to the other months ion the system.  Thus  (#$calendarMonthIndex #$GregorianMonthType #$March 3) means that March is the third month in the Gregorian calendar system.")
(comment yearOfDate "(#$yearOfDate YEAR DATE) means that #$Integer YEAR is the year of DATE.  For example, (#$yearOfDate 1972 (#$DayFn 14 (#$MonthFn #$June (#$YearFn 1972)))) means that 1972 is the year of the date (#$DayFn 14 (#$MonthFn #$June (#$YearFn 1972))).")
(comment dayNumberOfDate "(#$dayNumberOfDate DAY-NUMBER DATE) means that #$Integer DAY-NUMBER is the day number of DATE.  For example, (#$dayNumberOfDate 14 (#$DayFn 14 (#$MonthFn #$June (#$YearFn 1972)))) means that 14 is the day number of the date (#$DayFn 14 (#$MonthFn #$June (#$YearFn 1972))).")
(comment NLTrieSemTransPredicate "The collection of all instances of #$SemTransPred whose predicate extents are indexed in the standard NL trie.")
(comment Mill-ManufacturingFacility "A plant consisting of buildings with facilities for manufacturing, i.e. grinding, transforming, shaping, finishing, or extracting products.  For example, specs of #$Mill-ManufacturingFacility include #$OliveOilMill-ManufacturingFacility, #$SugarMill-ManufacturingFacility and #$Sawmill-ManufacturingFacility.")
(comment JewishMonth "A specialization of #$CalendarMonth.  #$JewishMonth is the collection of time intervals that are Jewish months.")
(comment JewishYear "The collection of all calendar years in the Jewish calendar system.  There are 12 months in the calendar on non-leap years.  On leap years, there are 13 months.  The month #$Adar-JewishMonth occurs only on leap years.  On non-leap years, the month #$Adar-II-JewishMonth is called \"Adar\".")
(comment SugarMill-ManufacturingFacility "A facility where sugar cane is processed into raw sugar.")
(comment SugarManufacturing "The process by which raw sugar is extracted from sugar cane.")
(comment LumberManufacturing "The process that transforms logs into lumber, i.e., sawing the logs into boards, grading the boards according to defects and intended use, drying, and finishing the rough boards into smoother products.")
(comment UINotepadInput "Instances of #$UINotepadInput are 'notepads' within a user interface that allow the user to enter, view, and edit strings. These input components are especially useful when the user is entering a long string that takes up multiple lines.")
(comment SituationTypeRelation-Conditional "#$SituationTypeRelation-Conditional is a sub-collection of #$SituationTypeRelation.  Assertions using these relations entail conditional relations among a specializations of #$Situation and their sub-situation types, actor types, and roles. For example, (#$inheritRolePlayers-SubSitTypeToSubSitType SITTYPE ROLE1 SUBSITTYPE1 ROLE2 SUBSITTYPE2) states that in any instance of SITTYPE, any actor playing ROLE1 in an instance of SUBSITTYPE1 will also play role ROLE2 in the instance of SUBSITTYPE2. Such a statement makes no assertion regarding the existence of such an actor. Contrast this collection with #$SituationTypeRelation-Existential and #$SituationTypeRelation-NonEssential.")
(comment SituationTypeRelation-NonEssential "#$SituationTypeRelation-NonEssential is a sub-collection of #$SituationTypeRelation.  Assertions using these relations represent features of a specialization of #$Situation that are not entailed by a situation properly instantiating it, but which are sufficiently common or important to be worth representing.  For instance, an assertion of the form (#$candidateProperSubSituationTypes SITTYPE SUBSITTYPE) states that instances of SITTYPE typically have a sub-situation of type SUBSITTYPE, though possession of this property is not essential to their membership in the collection SITTYPE. Contrast this collection with #$SituationTypeRelation-Existential.")
(comment SituationTypeFunction "#$SituationTypeFunction is a sub-collection of #$SituationTypeRelation.  Its instances are functions that are used to describe the structure of complex situation types.  #$SituationTypeFunction's most notable sub-collection is #$SubSituationTypeDenotingFunction.")
(comment SituationTypeRelation-SubSitTypes-Dependencies "#$SituationTypeRelation-SubSitTypes-Dependencies is the sub-collection of #$SituationTypeRelation-SubSitTypes-QuasiTemporal whose instances represent dependencies among sub-situation types.  These include causal dependencies, as well as other relations that might not deserve the label \"causal\" but which affect the temporal ordering of subsituations within instances of specializations of #$Situation. Its instances include, #$necConditionFor-Ternary and #$causes-SubSitTypeSubSitType.")
(comment SituationTypeRelation-SubSitTypes-Type "#$SituationTypeRelation-SubSitTypes-Type is the sub-collection of #$SituationTypeRelation whose instances represent the types of #$Situation which are sub-situation types os situationtypoes and what type of scenes they are.  Its instances include #$properSubSituationTypes and #$candidateProperSubSituationTypes.")
(comment SituationTypeRelation-Actors-TypeAndRoles "#$SituationTypeRelation-Actors-TypeAndRoles is the sub-collection of #$SituationTypeRelation whose instances represent which types of actors play roles in specializations of #$Situation. Its instances include #$onlyTypePlaysRoleInSubSituationType and #$someTypePlaysRoleInSubSituationType.")
(comment SituationTypeRelation-Actors-Relations "#$SituationTypeRelation-Actors-Relations is the specialization of #$SituationTypeRelation whose instances represent relationships between actors in specializations of #$Situation. Its instances include #$inheritRolePlayers-SubSitTypeToSubSitType and #$typesHaveRelationInSubSituationTypes.")
(comment SituationTypeRelation-ScriptLevel "#$SituationTypeRelation-ScriptLevel is the sub-collection of #$SituationTypeRelation whose instances represent relations involving specializations of #$Situation, rather than the internal structure of a single specialization of #$Situation.  Its instances include #$genlsWRTSubSituations.")
(comment ScriptQueryDedicatedPredicate "#$ScriptQueryDedicatedPredicate is a sub-collection of both #$SituationTypeRelation-Predicate and #$QueryDedicatedPredicate.")
(comment SituationTypeRelationTypeByLogicalForce "#$SituationTypeRelationTypeByLogicalForce is a second-order collection.  Its instances are all subcollections of #$SituationTypeRelation-Predicate whose memberships are based on whether (for any given script-instance to which they apply) they posit the existence of entities (such as scenes, actors), represent conditional relationships amongst such entities as do exist, or describe entities and relationships which might (but do not necessarily) obtain..  Instances of #$SituationTypeRelationTypeByLogicalForce include #$SituationTypeRelation-Existential, #$SituationTypeRelation-Conditional, and #$SituationTypeRelation-NonEssential.")
(comment SituationTypeRelation-Existential "#$SituationTypeRelation-Existential is a sub-collection of #$SituationTypeRelation.  Assertions using these relations entail the existence of sub-situation types or actors in all instances of the relevant specialization of #$Situation. For example, an assertion of the form (#$someTypePlaysRoleInSituationType SITTYPE TYPE SUBSITTYPE ROLE) states that for any instance SIT of SITTYPE, there exists an instance of the #$Collection TYPE that plays ROLE in the sub-situation of SIT SUBSIT (an instance of SUBSITTYPE). Contrast this collection with #$SituationTypeRelation-Conditional and #$SituationTypeRelation-NonEssential.")
(comment SituationTypeRelationTypeByComponentsRelated " #$SituationTypeRelationTypeByComponentsRelated is a second-order collection.  Its instances are all subcollections of #$SituationTypeRelation-Predicate, the subcollections are differentiated, first, in terms of the type of entity that enters into the #$SituationTypeRelation-Predicate and, second, by those entities' relationships to each other or the larger specialization of #$Situation.")
(disjointWith WindupDevice WaterPoweredDevice)
(disjointWith MusclePoweredDevice WaterPoweredDevice)
(comment WaterEnergy "hydrolic energy that can be harnessed by water mills, turbines...")
(comment Professional "The collection of all people who work at a job for which a skill that most adults do not have.  This skill is normally achieved through training, however people who use a \"native\" skill such as an artistic skill, in their work are also considered Professionals.  A person with a #$HighSchoolDiploma, but no additional training, is not expected to be able to be hired to a professional position and perform the job requirements.  The training need not be academic in nature.  One can be a professional child actress, chess player, boxer, or shaman, as well as a professional lawyer, architect, secretary, or politician.  Although factory workers, farm workers, construction workers, etc. develop a level of skill that makes them able to do their jobs far better than a person off the street (professional or not) these positions are not considered professional positions because the skill is developed experientially on the job.")
(comment ScientistTypeByField "A collection of collections. Each instance is a spec of #$Scientist whose instances are all of the same field.")
(comment EngineerTypeByField "A collection of collections. Each instance is a spec of #$Engineer whose instances are all of the same field.")
(comment SingerTypeByVoicePitch "A collection of collections. Each instance is a spec of #$Singer whose instances are all of the same voice pitch.")
(comment Artist-PerformerTypeByPerformanceType "A collection of collections. Each instance is a spec of #$Artist-Performer whose instances are all of the same performance type.")
(comment Artist-PerformerTypeByPerformanceLocale "A collection of collections. Each instance is a spec of #$Artist-Performer whose instances are all of the same performance locale.")
(comment CriminalTypeByCrimeType "A collection of collections. Each instance is a spec of #$Criminal whose instances are all of the same crime type.")
(comment CarEnthusiastTypeByBrand "A collection of collections. Each instance is a spec of #$CarEnthusiast whose instances are all of the same brand.")
(comment HobbyistTypeByHobby "A collection of collections. Each instance is a spec of #$Hobbyist whose instances are all of the same hobby.")
(comment ClericTypeByPosition "A collection of collections. Each instance is a spec of #$Cleric whose instances are all of the same position.")
(comment ClericTypeByReligionAndPosition "A collection of collections. Each instance is a spec of #$Cleric whose instances are all of the same religion and position.")
(comment AristocratTypeByTitle "A collection of collections. Each instance is a spec of #$Aristocrat whose instances are all of the same title.")
(comment PublicSectorEmployeeTypeByPosition "A collection of collections. Each instance is a spec of #$PublicSectorEmployee whose instances are all of the same position.")
(comment HeadOfStateTypeByTitle "A collection of collections. Each instance is a spec of #$HeadOfState whose instances are all of the same title.")
(comment MilitaryPersonTypeByService "A collection of collections. Each instance is a spec of #$MilitaryPerson whose instances are all of the same service.")
(comment HeadOfGovernmentTypeByTitle "A collection of collections. Each instance is a spec of #$HeadOfGovernment whose instances are all of the same title.")
(comment LeapYear-Jewish "The collection of Jewish #$CalendarYears which are leap years.  Jewish leap years have an additional month, #$Adar-JewishMonth.")
(comment followingIntervalTypes "A binary #$TemporalPredicate that relates types of #$TimeIntervals.  (#$followingIntervalTypes EARLIER-TYPE LATER-TYPE) means that every instance of EARLIER-TYPE is followed by (see #$startsAfterEndingOf) some instance of LATER-TYPE, and every instance of LATER-TYPE is preceded by some instance of EARLIER-TYPE.
<p>
Note that instances of EARLIER-TYPE need _not_ immediately precede (see #$contiguousAfter) instances of LATER-TYPE.  For example,  (#$followingIntervalTypes #$Saturday #$Sunday) holds, and so does (#$followingIntervalTypes #$Saturday #$Tuesday).   For a similar predicate that does entail immediate temporal succession, see the specialization #$succeedingIntervalType.")
(comment unitNumber-Military "(#$unitNumber-Military UNIT NUMERICSTRING) relates an
instance of #$ModernMilitaryUnit-Deployable to its assigned
#$NumericString.")
(disjointWith SmokingFood CanningFood)
(disjointWith SaltingFood CanningFood)
(comment CanningFood "A specialization of #$PreservingFood: each instance of this collection is an event 'in which prepared food is put in glass jars or metal cans that are hermetically sealed to keep out air and then heated to a specific temperature for a specified time to destroy disease-causing microorganisms and prevent spoilage' (www.encyclopedia.com).")
(comment AuthorTypeByFormat "A collection of collections. Each instance is a spec of #$Author whose instances are all of the same format.")
(comment AuthorTypeBySubject "A collection of collections. Each instance is a spec of #$Author whose instances are all of the same subject.")
(comment ArtistTypeByArtForm "A collection of collections. Each instance is a spec of #$Artist whose instances are all of the same art form.")
(comment SituationTypeIdentityMeta-Expansion "SituationTypeIdentityMeta-Expansion is a meta-expansion module that looks for two instances of two instances of ScriptedEventType. The two ScriptedEventsTypes must bear a genlScripts relation to one another.  It then hypothesizes that the two instances are equal.")
(comment CrossContextualIdentityMeta-Expansion "CrossContextualIdentityMeta-Expansion is a meta-expansion module that supports other meta-expansion modules (particularly, ScriptIdentityMeta-Expansion) by looking for equals assertions in different ScenarioContexts that involve the same entity.")
(comment locatedAtPoint-SurfGeog-FromGIS "(#$locatedAtPoint-SurfGeog-FromGIS OBJECT GEO-POINT) means
that according to some #$GeographicInformationSystem from which #$Cyc
is gathering information: OBJECT, an instance of
SpatialThing-Localized, is geographically located at GEO-POINT on the
geographical surface of reference. This relation is used to indicate
that extended spatial things located in a geography have their
geographical location including some precise point. This relation is
used only for location information gathered from a GIS. For non-GIS use, see the more general #$locatedAtPoint-SurfaceGeographical.")
(comment PersonTypeByBeliefSystem "A collection of collections and a specialization of #$PersonTypeByCulture.  Each instance of #$PersonTypeByBeliefSystem is a collection of people, each of which shares a common belief system (see #$BeliefSystem).  More formally, for each instance PERSON-TYPE of #$PersonTypeByBeliefSystem, there is an instance BELIEFS of #$BeliefSystem such that (#$relationAllInstance #$hasBeliefSystems PERSON-TYPE BELIEFS) holds true.")
(disjointWith HumanTypeByClothingSize PersonTypeByBeliefSystem)
(comment ThingByNormalityInContext "The collection of types of things by their normality in some (normally) highly restrained context.  The context need not be reified, but merely implied by the predicate (#$normalityOfThing or #$normalityForAgent) used for attributing such a normality to the thing.  Normality is (at least currently) a squishily-defined concept, and it is certainly dependent on the observer and context about which the assertion is made.  Normality is different from but related to frequency (e.g. #$frequencyOfActionType, #$Frequency). For example, I might see my pet exotic fish every day, but the fish still is #$Exotic-Unusual in Austin, although it may not be on a Belizian reef.  To make assertions involving normality, use #$normalityOfThing or #$normalityForAgent.")
(comment above-Indirectly " When this attribute is used with two other arguments, the first is over the second. This type of over means above but not directly above.  E.g., the sun is indirectly over a place at 3:00 p.m.")
(comment above-Indirectly "(#$above-Indirectly UPPER LOWER) means that upper is generally above [#$above-Generally] LOWER, but not directly above [#$above-Directly] it.")
(comment SituationTypeRelation-Predicate "A specialization of #$SituationTypeRelation.  #$SituationTypeRelation-Predicate is the collection of all predicates which are primarily used for representing the structure of complex situation types. This collection is mainly useful as a way of bundling together such vocabulary.  Cf. #$SituationTypeFunction.")
(comment satisfiesNeed "This predicate is used for stating satisfaction conditions with respect to agents' needs. #$satisfiesNeed relates an agent, something the agent needs (in a very broad sense of 'need'), and a sufficent condition under which the agent's need for that thing would be satisfied.  Thus it implies that the agent does have the need, and that it has not (or not yet) been satisfied. For a fuller account of the intended sense of 'need', see the comment on #$needs-Generic.  (#$satisfiesNeed AGENT WHATEVER COND) means that AGENT's need with respect to WHATEVER would be satisfied (all else being equal) if COND were to become true. There are various sentential forms that COND will tend to take, depending on the type of thing WHATEVER is (and this also determines which specialization of needs-Generic is relevant to a given case). (a) If WHATEVER is a #$SomethingExisting, then it is something AGENT needs to obtain or possess (see needs), and COND might have the form (possesses AGENT WHATEVER). (b) If WHATEVER is a _collection_ of #$SomethingExistings, then WHATEVER is such that AGENT needs to obtain some arbitrary instance of it (see #$needs-Type), and (assuming for simplicity that AGENT currently possesses _no_ WHATEVERs) COND might have the form (relationInstanceExists possesses AGENT WHATEVER).  (c) If WHATEVER is a collection of Events, then AGENT needs to be a \"doer\" (see #$doneBy) in some arbitrary (future) instance of that event-type (see #$needsToDo), and (assuming for simplicity that AGENT has never yet done a WHATEVER act) COND might have the form (#$relationInstanceExists doneBy AGENT WHATEVER). (d) If WHATEVER is an #$AttributeValue, then AGENT needs to have that attribute (see #$needsToHaveAttribute), and COND might have the form (#$hasAttributes AGENT WHATEVER). (e) Finally, if WHATEVER is a sentence (i.e. an #$ELSentence-Assertible), then AGENT needs the proposition expressed by COND to be true (see #$needs-Prop), and COND might simply be the sentence WHATEVER itself. For other ways that COND might usefully be formulated (e.g. when the simplifying assumptions used above do not apply) see the asserted rules on #$satisfiesNeed.")
(comment AlignmentPredicate "The collection of all predicates that specify the manner in which two spatial objects are aligned relative to each other.")
(comment CoveragePredicate "The collection of all predicates that specify the degreee and manner in which one spatial object covers a second.")
(comment inheritRolePlayers-SubSitTypeToSubSitType-Unique "<code>(#$inheritRolePlayers-SubSitTypeToSubSitType-Unique SITTYPE ROLE1 SUBSITTYPE1 ROLE2 SUBSITTYPE2)</code> means that in any instance of <code>SITTYPE</code> whatever single entity plays <code>ROLE1</code> in the instantiation of <code>SUBSITTYPE1</code> is identical to the entity that plays <code>ROLE2</code> in the instantiation of <code>SUBSITTYPE2</code>.  For a similar predicate without the uniqueness presupposition, see the more general #$inheritRolePlayers-SubSitTypeToSubSitType.")
(comment InternationalUnitOfMeasure "An instance of #$UnitOfMeasureTypeBySystem and a specialization of #$UnitOfMeasure.  Each instance of #$InternationalUnitOfMeasure is a #$UnitOfMeasure that is or was standardly (though not necessarily commonly--see #$InternationalUnitOfMeasure-Common) used in \"metric\" countries (i.e. countries that use the metric system, i.e. most countries in the world).  Note that some units of measure, e.g. #$SecondsDuration, #$Barrel-UnitOfVolume, #$Watt, and #$Byte, are instances of both #$InternationalUnitOfMeasure and #$USUnitOfMeasure.  (See #$UniversalUnitOfMeasure.)  Two important specializations of #$InternationalUnitOfMeasure are #$MetricUnitOfMeasure and #$SIUnitOfMeasure (qq.v.).")
(comment MilitaryEvent-TemplateType "A specialization of #$RKFTemplate used to describe military
events.")
(comment PersonTypeByRegionalAffiliation "A collection of collections, and a specialization of #$PersonTypeByCulture.  Each instance of #$PersonTypeByRegionalAffiliation is a subcollection of #$Person whose members share a mutual affiliation with some region, where, intentionally, 'region' is defined loosely to include both instances of #$GeopoliticalEntity as well as #$GeographicalRegions.  Instances include #$Texan and #$KoreanPerson.  Notable specializations include #$PersonTypeByGeoPoliticalAffiliation and  #$PersonTypeByGeographicResidence.")
(disjointWith PersonTypeByEducationLevel PersonTypeByRegionalAffiliation)
(disjointWith PersonTypeByActivity PersonTypeByRegionalAffiliation)
(comment HumanPathogen "The collection of all substances with the ability to cause a disease in a human due to contact or being taken into the body.")
(comment substanceTypePathogenicToOrganismType "(#$substanceTypePathogenicToOrganismType STUFF ORG-TYPE) means that taking into the body and/or contact with instances of STUFF-TYPE causes some disease in instances of ORG-TYPE).")
(comment substanceTypeNonpathogenicToOrganismType "(#$substanceTypeNonpathogenicToOrganismType STUFF ORG-TYPE) means that neither taking into the body nor contact with instances of STUFF-TYPE does not cause disease in instances of ORG-TYPE).")
(comment isPathogenicTo "(#$isPathogenicTo PATH ORGTYPE) means that if a
sufficient concentration of organisms of the same type as PATH are present in an
instance of ORGTYPE those organism will normally be the
cause of an infectious disease.")
(comment inheritRolePlayers-SitTypeToSubSitType-Unique "(#$inheritRolePlayers-SitTypeToSubSitType-Unique SIT-TYPE SIT-TYPE-ROLE  SUBSIT-TYPE SUBSIT-TYPE-ROLE) means that in any instance of SIT-TYPE whatever single entity plays SIT-TYPE-ROLE is identical to the entity that plays SUBSIT-TYPE-ROLE in the instance of SUBSIT-TYPE.")
(comment bestStringOfNLPhrase "(#$bestStringOfNLPhrase PHRASE STRING) means that Cyc considers STRING to be the best string form of PHRASE, in the current context.")
(comment typeRequiredForEventType "#$typeRequiredForEventType is an instance of #$ResourcePredicate. (#$typeRequiredForEventType EXISTING-THING-TYPE EVENT-TYPE) means that, in the context of the assertion, any #$Event EVENT-TYPE requires a #$SomethingExisting of type EXISTING-THING-TYPE as resource.  For example, baking a chocolate cake is type of event that requires chocolate (and, indeed, any making of a thing requires the ingredients for the type of thing made).  Also, baking a cake requires a source of heat.  And eating a cake requires cake.")
(comment GenericValuePredicate "A event-like-ordered collection of #$StrictlyFunctionalSlots each instance of which corresponds to a particular instance of #$GenericValueFunction (q.v.).  Each instance <code>PRED</code> of #$GenericValuePredicate relates a given #$TotallyOrderedQuantityType <code>QUANTTYPE</code> to the particular generic instance (see #$GenericQuantity) <code>QUANT</code> of <code>QUANTTYPE</code> that is the \"amount\" that <code>PRED</code> (by definition) represents -- viz. the value that <code>PRED</code>'s corresponding generic-value function returns when given <code>QUANTTYPE</code> as its argument.
<p>
For example, #$highAmountOf is the generic-value predicate that corresponds to the function #$HighAmountFn.  <code>(#$highAmountOf #$Happiness (#$HighAmountFn #$Happiness))</code> holds because (#$HighAmountFn #$Happiness) is the generic-quantity of happiness that is <i>a high amount of happiness</i>.  Other generic-value predicates include #$noAmountOf and #$mediumToVeryHighAmountOf.
<p>
A more substantive use of #$GenericValuePredicates is as arguments to certain other predicates, whose meanings they thereby serve to modify.  For example, the sentence <code>(#$levelOfCompatibility OLDSYSTEM NEWSYSTEM #$noAmountOf)</code> means that <code>OLDSYSTEM</code> and <code>NEWSYSTEM</code> are not at all compatible.
<p>
Note that this latter use of generic-value predicates allows us to avoid having either (a) to reify an entire array of (e.g.) compatibility-level predicates such as \"<code>noLevelOfCompatibility</code>\", \"<code>lowLevelOfCompatibility</code>\", and so on, or (b) to reify special-case quantity-types like \"<code>LevelOfCompatibility</code>\" (which would need to have a generic-value function applied to it and then be used as an argument to a predicate like #$levelOfCompatibility anyway).
<p>
See also #$RelativeGenericValueFn.")
(comment MapFunctionWithArgsOverLists "This function applies an #$EvaluatableFunction to a (partially) varying set of arguments.  (#$MapFunctionWithArgsOverLists FUNC CONST-INDICES CONST-ARGS VAR-INDICES VAR-ARG-LISTS) is interpreted as follows.  FUNC is an #$EvaluatableFunction which will be mapped over arguments constructed from CONST-ARGS and VAR-ARG-LISTS.  CONST-INDICES is a #$List of non-negative integers which are the argument indices of the corresponding elements of CONST-ARGS.  CONST-ARGS is a #$List of arguments for FUNC which will remain constant.  VAR-INDICES is a #$List of non-negative integers which are the indices of the corresponding elements of VAR-ARG-LISTS.  NB: VAR-INDICES must be disjoint with CONST-INDICES.  VAR-ARG-LISTS is a #$List each element of which is a #$List of arguments over which FUNC is mapped.  NB: all elements of VAR-ARG-LISTS must be of the same length.  So, for example, (#$evaluate ?VAR (#$MapFunctionWithArgsOverLists #$LogarithmFn (#$TheList 1) (#$TheList 2) (#$TheList 0) (#$TheList (#$TheList 2 4 8 16 32)))) will evaluate the base 2 logarithms of 2, 4, 8, 16, and 32, returning (#$TheList 1.0d0 2.0d0 3.0d0 4.0d0 5.0d0).  Also, (#$evaluate ?VAR (#$MapFunctionWithArgsOverLists #$LogarithmFn #$TheEmptyList #$TheEmptyList (#$TheList 0 1) (#$TheList (#$TheList 2 4 8 16 32) (#$TheList 2 4 8 16 32))) will evaluate the base 2, 4, 8, 16, and 32 logarithms of 2, 4, 8, 16, and 32, respectively, returning (#$TheList 1.0d0 1.0d0 1.0d0 1.0d0 1.0d0).  See also #$MapFunctionOverList.")
(comment unitTypeMaxSpeedOnRoad-IdealConditions "(#$unitTypeMaxSpeedOnRoad-IdealConditions UNIT-TYPE SPEED)
means that under ideal conditions, any instance INSTANCE of UNIT-TYPE
may be expected to travel at the maximum #$Speed of SPEED on a road.")
(comment unitTypeMaxSpeedOffRoad-IdealConditions "(#$unitTypeMaxSpeedOffRoad-IdealConditions UNIT-TYPE SPEED) means that for any instance INSTANCE of UNIT-TYPE travelling offroad under ideal conditions will have the #$Speed SPEED.")
(comment CognitiveAttitudePredicate "A specialization of both #$CognitivePredicate and #$PropositionPredicate (qq.v.).  Each instance of #$CognitiveAttitudePredicate is a (binary or higher-arity) relation that holds among (at least) an #$IntelligentAgent and a sentence expressing a proposition in connection with which the agent bears a certain (\"de dicto\" or \"de re\") propositional attitude (e.g. belief, doubt, or knowledge).  Two important specializations of #$CognitiveAttitudePredicate are #$PropositionalAttitudeSlot and #$DeReAttitudePredicate (qq.v.).")
(comment vehicleTypeMaxSpeedOffRoad-IdealConditions "(#$vehicleTypeMaxSpeedOffRoad-IdealConditions VEHICLE-TYPE SPEED) means that for any instance INSTANCE of VEHICLE-TYPE travelling offroad under ideal conditions will have a maximum #$Speed SPEED.")
(comment vehicleTypeMaxSpeedOnRoad-IdealConditions "(#$vehicleTypeMaxSpeedOffRoad-IdealConditions VEHICLE-TYPE SPEED) means that for any instance INSTANCE of VEHICLE-TYPE travelling on road under ideal conditions will have a maximum #$Speed SPEED.")
(comment offRoadSpeed "The maximum speed of a vehicle when travelling off road.")
(comment DeReVersionFn "A #$PredicateDenotingFunction used to convert \"de dicto\" cognitive attitude predicates (see #$PropositionalAttitudeSlot) into their \"de re\" counterparts (see #$DeReAttitudePredicate).  (#$DeReVersionFn PROP-ATT-SLOT) is the cognitive attitude predicate DE-RE-PRED that is the ternary \"de re version\" of the binary PROP-ATT-SLOT.  The extensions (see #$relationExtension) of PROP-ATT-SLOT and DE-RE-PRED are correlated roughly as follows.  (i) If (PROP-ATT-SLOT AGENT SENT) holds, and the Nth-place term within SENT denotes something, then (DE-RE-PRED AGENT SENT N) holds.  (ii) If (DE-RE-PRED AGENT SENT N) holds, then there must be some term NEWTERM that is codenoting (and possibly identical) with the Nth-place term OLDTERM within SENT such that (PROP-ATT-SLOT AGENT SENT-PRIME) holds, where SENT-PRIME is the result of replacing OLDTERM with NEWTERM in the Nth-place of SENT.  For example, (#$DeReVersionFn #$beliefs) is #$believesOfArg.  An agent's having a de dicto belief with respect to a given sentence entails her having analogous de re beliefs regarding each thing denoted by some constituent of that sentence; and an agent's having a de re belief regarding a given thing entails her having some analogous de dicto belief with respect to a sentence having an immediate constituent that denotes that thing.")
(comment politiesBorderEachOther "(#$politiesBorderEachOther POL1 POL2) mean that POL1 and POL2 are two instances of #$GeopoliticalEntity whose territories border on each other.")
(comment DiplomaticallyRecognizedByFn "DiplomaticRecognition is a reciprocal relationship between two governments 
of countries, in which each accords the other at least some of the 
privileges of diplomatic recognition. Thus, (hasStatusWithAgent-Coll COUNTRY1
DiplomaticallyRecognizedByFn COUNTRY2) means that COUNTRY1 and
COUNTRY2 have some diplomatic relations.")
(comment FullyRecognizedDiplomaticallyByFn "Full diplomatic recognition is a reciprocal relationship between two 
governments of countries, in which each accords the other all the 
privileges of diplomatic recognition.")
(comment hasFullDiplomaticRelationsWith "(hasFullDiplomaticRelationsWith COUNTRY1 COUNTRY2) means that COUNTRY1 and 
Country2 share full and reciprocal diplomatic relations.")
(comment SharesTradeRelationsWithFn "(SharesTradeRelationsWithFn COUNTRY) means that the country that is 
a member of that collection shares a minimal level of recognition
or cooperation with COUNTRY wherein the two countries engage in trade.")
(comment hasTradeRelationsWith "(hastradeRelationsWith COUNTRY1 COUNTRY2) means that COUNTRY1 and 
Country2 share a minimal level of recognition or cooperation between
two nations wherein the two countries engage in trade.")
(disjointWith BladedWeapon-NonProjectile ProjectileWeaponOrLauncher)
(comment ProjectileWeaponOrLauncher "A specialization of #$Weapon. Instances of this collection are either instances of #$ProjectileWeapon or #$ProjectileLauncher.")
(disjointWith TextualMaterial ProjectileWeaponOrLauncher)
(disjointWith ComputerHardwareItem ProjectileWeaponOrLauncher)
(comment AgentTypeByOrganizationStatus "A collection of collections.  Each instance of #$AgentTypeByOrganizationStatus is a collection of agents that share a particular relation to an organization.  For example, (#$SuspendedMemberFn #$LeagueOfArabStates) is the collection of all suspended members of the #$LeagueOfArabStates during some stated time interval.")
(comment weaponEffectiveRange-PointTarget "(#$weaponEffectiveRange-PointTarget WEAPON RANGE) means that RANGE
is the maximum range at which the projectile weapon WEAPON can effectively be used against a point target. In general, this range will be shorter than that for which the weapon is effective against area targets.")
(comment weaponEffectiveRange-AreaTarget "(#$weaponEffectiveRange-AreaTarget WEAPON RANGE) means that RANGE
is the maximum range at which the projectile weapon WEAPON can effectively be used against an area target. In general, this range may be longer than that for which the weapon is effective against point targets.")
(comment SKSMereologyType "#$SKSMereologyType is a specialization of
#$StructuredKnowledgeSourceType which facets
#$StructuredKnowledgeSource according to three exhaustive conditions
on the extent of #$subKS-Direct. Please see the #$salientAssertions
for the exhaustive cases.")
(comment StructuredKnowledgeSource-TopLevel "An instance of #$SKSMereologyType. If TOP is a
#$StructuredKnowledgeSource and it is unknown that there exists some
OTHER such that (#$subKS-Direct OTHER TOP), then TOP is an instance of
#$StructuredKnowledgeSource-TopLevel.")
(comment PurposePredicate "#$PurposePredicate is an instance of #$PredicateType.  It is the collection of predicates that state of some individual or collection THING how it relates to some purpose or goal.")
(disjointWith BinaryPredicateTypeByLogicalFeature PredicateTypeByTopic)
(comment PredicateTypeByTopic "#$PredicateTypeByTopic is a specialization of #$PredicateType.  Each instance of #$PredicateTypeByTopic is a collection of predicates each instance of which, when used in an arg0 slot to form a sentence, forms a sentence that is \"about\" some particular sort of thing.  For example, #$PurposePredicate is an instance of #$PredicateTypeByTopic because instances of #$PurposePredicate are used to form sentences about purposes or goals.  Similarly, #$ComparisonPredicates are predicates that are \"about\" how one thing or type of thing compares to another, and so #$ComparisonPredicate is an instance of #$PredicateTypeByTopic.")
(comment PredicateTypeByArgumentType "#$PredicateTypeByArgumentType is a specialization of #$PredicateType.  It is the collection of collections of predicates which are defined solely in terms of the kinds of things they relate.  For example, #$FirstOrderCollectionPredicate is an instance of #$PredicateTypeByArgumentType because it is defined as the collection of predicates that are used to make statements about first-order collections.")
(comment hasAccessory "A specialization of #$possessiveRelation. (#$hasAccessory OBJECT ACCESSORY) means that the the OBJECT has ACCESSORY as an accessory (cf. #$accessoryFor).  E.g., this predicate can be used to describe the relation between a particular #$CellularTelephone and the #$PowerCord with which it was packaged. In constrast with #$instanceAccessoryFor (its #$genlInverse) this predicate relates only specific pairs of the objects of appropriate types.")
(disjointWith ZipCode-NineDigit ZipCode-FiveDigit)
(disjointWith DateDenotingFunction ScalarDenotingFunction)
(disjointWith FunctionDenotingFunction ScalarDenotingFunction)
(disjointWith PredicateDenotingFunction ScalarDenotingFunction)
(comment ScalarDenotingFunction "A specialization of #$IndividualDenotingFunction.  Each instance of #$ScalarDenotingFunction is a function that returns some instance of #$ScalarInterval as its value, for any (sequence of) thing(s) in its domain (see #$relationDomain) taken as argument(s). Thus (e.g.) any function that always returns a real number is a scalar-denoting function.  There are no restrictions on what types of things a scalar-returning function can have in its domain. Notable specializations of this function-type are #$MathematicalFunctionOnScalars and #$UnitOfMeasure.")
(comment transferredThing "The predicate #$transferredThing is used to identify the thing whose external relationships change in some event considered generically as a \"transfer\".  (#$transferredThing TRANSFER IND) means that #$Individual IND is being moved, transferred, or exchanged in the #$GeneralizedTransfer event TRANSFER.  Note that in general, and if possible, it is preferable to use a more specialized predicate than #$transferredThing (e.g., #$transferredObject or #$objectMoving for physical transfer of an object, or #$infoTransferred for the the transfer of information).")
(comment formsBorderBetweenPolities "A #$SpatialPredicate that relates a pair of #$GeopoliticalEntitys whose territories share a border to parts of the border that separates them.  (#$formsBorderBetweenPolities BORDER POLITY1 POLITY2) means that BORDER constitutes at least part of the border between the territories of POLITY1 and POLITY2.  BORDER is an instance of #$SpatialThing; it might be a #$GeopoliticalBorder, a #$MountainRange, a #$River, or something else.  Note that BORDER need not constitute the entire border between the territories of POLITY1 and POLITY2.  See the corresponding function #$BorderBetweenPolitiesFn for specifying the border between two #$GeopoliticalEntitys and #$formsBorderBetween for specifying the border between two #$GeopoliticalRegions (or other #$SpatialThings.")
(comment roleCardinalityForSituationType "(roleCardinalityForSituationType SIT-TYPE ROLE EXTENT) means
that for any instance, SIT, of SIT-TYPE, if anything plays ROLE in
SIT, then the number of things that play ROLE in SIT is within the
range EXTENT (that is, the number of things that play ROLE in SIT is
between the minimum and the maximum of EXTENT, inclusive--see
#$minQuantValue and #$maxQuantValue)")
(comment roleCardinalityForSubsituationType "(#$roleCardinalityForSubsituationType SITTYPE SUBSITTYPE ROLE EXTENT) means that for any situation, SIT, that is an instance of SUBSITTYPE and a subsituation of an instance of SITTYPE, if anything plays ROLE in SIT, then the number of things that play ROLE in SIT is within the range EXTENT (that is, the number of things that play ROLE in SIT is between the minimum and the maximum of EXTENT, inclusive--see #$minQuantValue and #$maxQuantValue)")
(comment DevelopingAilment "The collection of events in which some 
#$Organism-Whole ORG develops an
#$AilmentCondition AIL-COND.  Note that the ORG does
not have AIL-COND while developing it but only
(immediately) after the development has occurred.  See
#$AilmentCondition for more information.
See also #$RecoveringFromAilment.")
(disjointWith RecoveringFromAilment DevelopingAilment)
(comment developsAilment "An #$ActorSlot (q.v.) for indicating when an
#$Organism-Whole is developing an
#$AilmentCondition (q.v.).
(#$developsAilment DEV_AIL ORG) means that
in the instance DEV_AIL of #$DevelopingAilment
the instance ORG of #$Organism-Whole is
developing some ailment.  For example, suppose we
had a specification of #$DevelopingAilment,
DevelopingTheCommonCold.  One could then assert
that, say, person PERSON01 is coming down with
a cold by reifying an instance COMING-DOWN-WITH-COLD01
of DevelopingTheCommonCold
and asserting (#$developsAilment
COMING-DOWN-WITH-COLD01 PERSON01).  See also
#$developsAilmentCondition, #$ailmentConditionAffects
and #$stateOfAilment.")
(comment poisonedWith "An #$ActorSlot for indicating the poison in a
#$Poisoning event.  (#$poisonedWith ?POISONING ?STUFF)
means that in the instance ?POISONING of #$Poisoning,
?STUFF is the instance of #$PartiallyTangible
(at least in part) causing ?POISONING and present
in the living organism being poisoned.")
(comment genlSituationTypesWRTRolePlayersOfType-SitType "An assertion of the form (#$genlSituationTypesWRTRolePlayersOfType-SitType SITTYPE1 TYPE1 SITTYPE2 TYPE2 ROLE) means that SITTYPE1 is a more specific version of SITTYPE2 in terms of the type of #$actors which will play ROLE in instances of SITTYPE1.  Specifically, it means that in instances of SITTYPE1, the actors of TYPE2 which play ROLE in the instance of SITTYPE1  will be instances of the more specific type TYPE1.")
(comment genlSituationTypesWRTRolePlayersOfType-SubSitTypes "An assertion of the form (#$genlSituationTypesWRTRolePlayersOfType-SubSitTypes SITTYPE1 TYPE1 SITTYPE2 TYPE2 SUBSITTYPE ROLE) means that SITTYPE1 is a more specific version of  SITTYPE2 in terms of the type of #$actors which play ROLE in instances of SUBSITTYPE that are #$subSituations of instances of SITTYPE1.  Specifically, it means that in instances of SITTYPE1, the actors of TYPE2 which play ROLE in the #$subSituations which are instances of  SUBSITTYPE will be instances of the more specific type TYPE1.")
(comment SensoryEnhancementDevice-Visual "The specialization of #$SensoryEnhancementDevice.  Instances of this collection are devices which are used to enhance a user's #$VisualPerception (cf. #$Perceiving) in some way. Positive examples include instances of #$Binoculars and #$MagnifyingGlass.")
(comment HijackingAFn "The #$CollectionDenotingFunction #$HijackingAFn is used to represent subcollections of #$Hijacking based on the specific type of #$TransportationDevice which is the #$transporterHijacked in the event. For example, (#$HijackingAFn #$CruiseShip) would represented the set of complex events in which instances of #$CruiseShip play the role  #$transporterHijacked.")
(comment SensoryEnhancementDevice-Aural "The specialization of #$SensoryEnhancementDevice.  Instances of this collection are devices which are used to enhance a user's #$Hearing (cf. #$Perceiving) in some way. Positive examples include #$HearingAids and #$Stethoscopes.")
(comment SensoryEnhancementDevice "The specialization of #$PhysicalDevice.  Instances of this collection are devices which are used to enhance a user's perception (cf. #$Perceiving) in some way. Positive examples include instances of #$Binoculars and #$HearingAid.  Borderline cases might include #$ElectronMicroscopes and #$RadioTelescopes.")
(comment Sight-Device "A specialization of #$OpticalDevice.  Instances of this collection are devices which help a user to aim a #$ProjectileLauncher (cf. #$AimingAProjectileLauncher).")
(comment TerminatedEmployeeFn "(#$TerminatedEmployeeFn ORG) is the collection of terminated employees of ORG.  (#$employmentStatus AGENT (#$TerminatedEmployeeFn ORG)) means that AGENT was once an employee of ORG. but has resigned, been fired or otherwise terminated from his/her job working for ORG.")
(comment InactiveEmployeeFn "(#$InactiveEmployeeFn ORG) is the collection of inactive employees of ORG.  (#$employmentStatus AGENT (#$InactiveEmployeeFn ORG)) means that AGENT is a current employee of ORG, but is at present on leave. ")
(comment CycHistoricalPossibilityTheoryMt "This microtheory is Cyc's historical possibility theory,
i.e., all Cyc's `knowledge' concerning code-supported inference
involving historical possibility/necessity (usually with temporal
inference).")
(comment PossibleHistory "A collection of `alternative histories' used in the metalanguage for the reasoning with multi future.  An instance HIST of
#$PossibleHistory is used to form a microtheory such as (#$MtSpace
MONAD (#$MtTimeWithGranularityDimFn TIME PARA) (#$MtPosHistDimFn HIST
0)) or (#$MtSpace MONAD (MtTimeWithGranularityDimFn TIME PARA)
(#$MtPosHistDimFn HIST 1)).")
(disjointWith OutdoorLocationTypeByAmbientCondition ConstructionMaterialType)
(disjointWith TangibleStuffStateType OutdoorLocationTypeByAmbientCondition)
(disjointWith ElementStuffType OutdoorLocationTypeByAmbientCondition)
(comment AreaIlluminatedByStarlight "A specialization of #$OutdoorLocation which subsumes areas illuminated by starlight.")
(comment hasDissidentStatusIn "(#$hasDissidentStatusIn DISS-AGT AGT) holds just in case AGT considers DISS-AGT a dissident -- AGT believes them opposed to its beliefs, policies, or practices. For example, (#$hasDissidentStatusIn #$WeiJingsheng #$China-PeoplesRepublic).")
(comment hasDiplomaticImmunityIn "(#$hasDiplomaticImmunityIn PERSON COUNTRY) means that PERSON has diplomatic immunity in COUNTRY. Persons who have diplomatic immunity are, by virtue of their positions in the diplomatic corps of a country, not subject to arrest by authorities of the country to which they are posted. Moreover, they are not subject to search or seizure of their possessions, nor are they obliged to pay taxes in the host state nor to fulfil military obligations. Persons with diplomatic immunity in a host state also enjoy that status in intermediate states through which they travel. diplomatic immunity is extended to diplomatic couriers and those who carry a diplomatic bag. diplomats thereby have diplomatic immunity. Generally, members of diplomats' immediate families have diplomatic immunity, even though they themselves are not diplomats.")
(comment hasDiplomaticStatusIn "(#$hasDiplomaticStatusIn AGT COUNTRY) holds just in case AGT is a diplomat in COUNTRY -- AGT is a person who has certain immunities and privileges in the foreign state, COUNTRY, because of his or her position as a diplomat. See also #$hasDiplomaticImmunityIn.")
(comment DissidentFn "The status that one agent has with a second agent who considers the first to be opposed to its beliefs, policies, or practices. For example, (#$isa #$WeiJingsheng (#$DissidentFn #$China-PeoplesRepublic)).")
(comment DismissedMemberFn "(#$DismissedMemberFn ORG) is the collection of agents that have been dismissed from membership in ORG.  Being an instance of a collection returned by this function usually implies some disagreement, although employees who are layed off probably fall into this category.")
(comment sourceSchemaObjectID "(#$sourceSchemaObjectID SOURCE SCHEMA OBJECT ID) relates an
OBJECT in SOURCE to its unique identifier ID when SOURCE is
interpreted logically by SCHEMA. See also the functions
#$SourceSchemaObjectFn and #$SourceSchemaObjectIDFn.")
(comment SourceSchemaObjectFn "(#$SourceSchemaObjectFn SOURCE SCHEMA ID) denotes an object
in SOURCE that is uniquely identified
by ID when SOURCE is interpreted logically by SCHEMA. Note that this function is the 'inverse' of
#$SourceSchemaObjectIDFn.")
(comment SourceSchemaObjectIDFn "(#$SourceSchemaObjectIDFn SOURCE SCHEMA OBJECT) denotes the
unique identifier of OBJECT in SOURCE when SOURCE is interpreted logically by
SCHEMA. Note that this function is the 'inverse' of
#$SourceSchemaObjectFn.")
(comment hasPoliticalAsylumIn "(hasPoliticalAsylumIn AGENT HOST) means that the Person AGENT has been granted political asylum by the Country HOST. Political asylum shields the recipient from seizure by authorities of the country s/he is fleeing. The granting and recognition of political asylum is common international practice, even though there is no formal worldwide international law that governs asylum.")
(comment NumberString "A specialization of #$NumericString (q.v.).  Each instance of #$NumberString is a #$SubLString that represents a number in some standard form of decimal notation (including, e.g., engineering and scientific notation).  Examples include \"9828\", \"3.14\", and \"6.02e23\", but not \"78731-1234\" or \"9/7/79\".  (But note that the latter two strings _are_ #$NumericStrings.)")
(comment MarinaraSauce "A specialization of #$TomatoBasedSauce.  Marinara sauce is a tomato-based sauce used in Italian cooking.")
(comment AssemblingFoodIngredients "A specialization of #$PreparingFoodItem.  Each instance of #$AssemblingFoodIngredients is an event in which some item of #$Food (q.v.) is prepared by combining ingredients.  For example, a step in making an instance of #$SpaghettiMarinara is an instance of #$AssemblingFoodIngredients, when the spaghetti noodles are combined with the marinara sauce.  Also, a step in making bread is an instance of #$AssemblingFoodIngredients, when, prior to kneading, the ingredients such as salt and flour are combined.")
(comment collectionDifference "This is the predicate corresponding to
#$CollectionDifferenceFn. (#$collectionDifference DIFFERENCE COL1
COL2) means that DIFFERENCE is the collection containing all instances
of COL1 which are not instances of COL2.")
(comment PreparingFoodItemTypeByFoodPrepared "#$PreparingFoodItemTypeByFoodPrepared is the collection of collections of #$PreparingFoodItem whose instances are each events in which a particular sort of food is prepared.  Examples include #$MakingBread and (#$PreparingFoodItemFn #$SpaghettiMarinara).")
(comment IndexDataStructure "A data structure which permits the efficient lookup of data
by maintaining an 'index' of pointers to the data.")
(comment IndexDataStructureType "A #$CollectionType which facets #$IndexDataStructure by the
physical storage and retrieval algorithm. Usually,
#$IndexDataStructureTypes are optimized to store specific types of
data or to permit specific types of retrieval.")
(comment SchemaIndexFn "(#$SchemaIndexFn SCHEMA FIELD-LIST NAME) denotes an
#$IndexDataStructure that is named NAME in SCHEMA which indexes the
fields in FIELD-LIST. See also the corresponding predicate #$schemaFieldsIndex.")
(comment schemaFieldsIndex "The predicate corresponding to #$SchemaIndexFn.
(#$schemaFieldsIndex SCHEMA FIELD-LIST NAME INDEX) means that INDEX is an
#$IndexDataStructure named NAME in the physical schema SCHEMA which
indexes the physical fields in FIELD-LIST. See also #$indexType and #$indexName.")
(comment indexType "A typed spec pred of #$isa, this predicate relates an
#$IndexDataStructure to its #$IndexDataStructureType.")
(comment BTree-DataStructure "A type of #$IndexDataStructure which stores references to
data in a tree structure. Such indices are useful to store data when there is a partial or linear ordering defined on the index set.")
(comment hasFriendlyStatusWith "(#$hasFriendlyStatusWith AGT1 AG2) means that AGT1 is on friendly terms 
with AGT2. Can be used to talk about nations, companies, (people?).")
(comment rivals "(#$rivals AGT1 AGT2) means that AGT1 and AGT2 have a rivalry. Not just competition - the BostonCeltics1981 competed against every 1981 NBA team, but had a rivalry with the Philadelphia76ers1981. There is an emotional incentive to defeat a rival in competition. There is often a certain amount of respect in the relationship - rivalry doesn't necessarily imply unfriendliness.")
(comment hasUnfriendlyStatusWith "(#$hasUnfriendlyStatusWith AGT1 AG2) means that AGT1 is on unfriendly terms 
with AGT2. Can be used to talk about nations, companies, (people?).")
(comment subterritoryOf "(#$subterritoryOf GEO-AGT TERRITORY) means that the complete planetary region [see #$GeographicalRegion] occupied by and considered part of the instance GEO-AGT of #$GeographicalAgent includes the instance TERRITORY of #$GeographicalRegion. This applies to any region that is considered part of territory of GEO-AGENT, excluding colonies, trust territories, or territories occupied by GEO-AGENT's military, but which are the territory of some other country.   #$subterritoryOf will specify different regions in different microtheories for countries which have territorial disputes with their neighbors.  See #$territoryOf.")
(comment businessRelations "(businessRelations COUNTRY-ONE COUNTRY-TWO is a relationship between the governments of COUNTRY-ONE and COUNTRY-TWO such that non-trivial trade actually occurs between the two countries. BusinessRelationship entails TradeRelationship.")
(comment PowerStatusRelationPredicate "A collection of relations. Each specifies a kind of power relationship that can hold between geopolitical entities.")
(comment genericPowerAccordBetween "A reciprocal relationship between two governments of countries, such that a power accord exists between them. The power accord is Generic in nature and consists of an agreement, formal or informal, that power in a geographical region may be shared.")
(comment militaryPowerConflictBetween "A reciprocal relationship between two governments of countries, such that a power conflict exists between them. The power conflict is military in nature and consists of competing for power in a geographical region primarily through political or diplomatic means. Competing for power through geopolitical or economic means is not designated by this attribute.")
(comment militaryPowerAccordBetween "MilitaryPowerAccord is a reciprocal relationship between two governments of countries, such that a power accord exists between them. The power accord is military in nature and consists of an agreement, formal or informal, that power in a geographical region may be shared through political or diplomatic means. Sharing power through geopolitical or economic means is not designated by this attribute.")
(comment economicPowerAccordBetween "A reciprocal relationship between two governments of countries, such that a power accord exists between them. The power accord is Economic in nature and consists of an agreement, formal or informal, that power in a geographical region may be shared through political or diplomatic means. Sharing power through geopolitical or military means is not designated by this attribute.")
(comment economicPowerConflictBetween "A reciprocal relationship between two governments of countries, such that a power conflict exists between them. The power conflict is Economic in nature and consists of competing for power in a geographical region primarily through political or diplomatic means. Competing for power through geopolitical or military means is not designated by this attribute.")
(comment geopoliticalPowerAccordBetween "A reciprocal relationship between two governments of countries, such that a power accord exists between them. The power accord is geopolitical in nature and consists of an agreement, formal or informal, that power in a geogaphical region may be shared through political or diplomatic means. Sharing power through economic or military means is not designated by this attribute.")
(comment AfricanCountry "The collection of nation-states whose territory is solely in Africa.")
(comment EuropeanCountry "The collection of nation-states whose territory is solely in Europe.")
(comment SouthAmericanCountry "The collection of nation-states whose territory is solely in South America.")
(comment buyingTypeOfType "(#$buyingTypeOfType BUYING-TYPE OBJ-TYPE) means that the specialization of #$Buying BUYING-TYPE is the type of event in which instances of  #$Individual OBJ-TYPE are bought.")
(comment associatedActorSlotList "An instance of #$BinaryPredicate. (#$associatedActorSlotList EVENT-PRED SLOT-LIST) means that SLOT-LIST is a list of #$ActorSlots conceptually associated with the argument places of EVENT-PRED, in the following sense: Suppose (EVENT-PRED ARG-1 ARG-2 ... ARG-N) is true. Then, were one to represent the same fact within the Davidsonian framework, i.e., by asserting the existence of a particular event of type COLL (where COLL is the #$correspondingCycCollection for EVENT-PRED), ARG-K would play in the event the role expressed by SLOT-K (where SLOT-K is the Kth member of SLOT-LIST), for 1 <= K <= N.  See also the related predicate #$associateSlotInArg.")
(comment TerrainTypeBySurfaceLevel "Instances of #$TerrainTypeBySurfaceLevel are collections that relate to military concepts about the surface level of a terrain. Instances include #$TerrainHighGround and #$TerrainLowGround. The surface level of a terrain is important for military tactical reasoning involving observation, mobility, cover, concealment, etc..")
(comment regionTypeHasSurfaceLevelInNumberOfDirections "An instance of #$TernaryPredicate, used to describe the surface level of the ground on each of the four 'sides' of a  #$GeographicalRegion. (The number 4 is a simplifying assumption used to make knowledge aquisition and representation easier.) (#$regionTypeHasSurfaceLevelInNumberOfDirections REGION-TYPE LEVEL NUM-SIDES) means that NUM-SIDES of REGION-TYPE have are LEVEL. For example, (#$regionTypeHasSurfaceLevelInNumberOfDirections Hill TerrainLowGround 4) means that hills have low ground in (all) four directions. To specify how many sides that share this ground level are adjacent, use #$regionTypeHasSurfaceLevelInNumberOfAdjacentDirections. Note that this predicate not only oversimplifies the number of sides of a type of terrain, but also ignores the point of view and the slope. For example, a hill has low ground on all sides from the point of view of the hilltop, but not from the point of view of the bottom of the hill. This predicate expects that one is refering to the 'most interesting' part of the terrain feature (eg the hilltop of a hill, the low middle part of a valley, the seat part of a saddle, etc.). To also specify the point of view and to be more specific about slopes, see #$regionTypeSlopeOfSidesFromPoint and #$regionTypeSlopeOfAdjacentSidesFromPoint. To specify slopes at an instance level, see #$regionSlopeOfSidesFromPoint and #$regionSlopeOfAdjacentSidesFromPoint.")
(comment regionTypeHasSurfaceLevelInNumberOfAdjacentDirections "(#$regionTypeHasSurfaceLevelInNumberOfAdjacentDirections REGION-TYPE LEVEL NUM-SIDES) means that NUM-SIDES of REGION-TYPE that have a LEVEL kind of slope are adjacent to one another. For example, (#$regionTypeHasSurfaceLevelInNumberOfAdjacentDirections Saddle #$TerrainLowGround 0) means that, of the total number of low ground sides of a saddle, none of them are adjacent. Similarly, (#$regionTypeHasSurfaceLevelInNumberOfAdjacentDirections Saddle #$TerrainHighGround 0) means that, of the total number of high ground sides of a saddle, none of them are adjacent. Thus, if there are a total of two high ground and two low ground sides of a saddle, then the two similarly sloping sides are across from one another. To specify the total number of sides that are LEVEL, see #$regionTypeHasSurfaceLevelInNumberOfDirections. To specify slopes at an instance level, see #$regionSlopeOfSidesFromPoint and #$regionSlopeOfAdjacentSidesFromPoint.")
(comment regionHasSurfaceLevelInNumberOfAdjacentDirections "(#$regionHasSurfaceLevelInNumberOfAdjacentDirections REGION LEVEL NUMBER) means that REGION has NUMBER adjacent sides where the surface level of the terrain is LEVEL. For example, (#$regionHasSurfaceLevelInNumberOfAdjacentDirections Saddle001 #$TerrainLowGround 0) means that Saddle001 has low ground on no adjacent sides.  To specify the total number of sides that are LEVEL, see #$regionHasSurfaceLevelInNumberOfDirections. To describe types of geographical regions, use #$regionTypeHasSurfaceLevelInNumberOfAdjacentDirections and #$regionTypeHasSurfaceLevelInNumberOfDirections.")
(comment sitTypeIsIteratedSubSitType-ForEach "(#$sitTypeIsIteratedSubSitType-ForEach SITTYPE SUBSIT-TYPE BINPRED                                      
SUBSIT-TYPE-ROLE)  means that each instance, SIT, of SITTYPE consists of one                                     
instance of SUBSIT-TYPE for each thing, THING, such that (BINPRED SIT                                        
THING). Moreover, each such thing plays the role SUBSIT-TYPE-ROLE in exactly                                      
one such instance of SUBSIT-TYPE.")
(comment HalfInning "#$HalfInning is an instance of #$Event-Organized and #$AthleticActivity.  Each instance of #$HalfInning occurs during some instance of #$BaseballInning.  Generally speaking there are two instances of #$HalfInning that occur during each instance of #$Inning (the major exception occurs when a game is called).")
(comment MassOrganizedStretch "#$MassOrganizedStretch is a specialization of #$Event-Organized.  Each instance of #$MassOrganizedStretch is an event in which a large number of people simultaneously stretch.  Examples include large Yoga classes, and the actions of audiences betwen the two half-innings of seventh innings in major league baseball games.")
(comment EndingOfBaseballInning "#$EndingOfBaseballInning is the last scene of a #$BaseballInning script -- it is the collection of endings of baseball innings in which, after the last out of the inning's second #$HalfInning is made, the fielding team leaves the field.")
(comment EndingOfBaseballInningWithOneTeamAhead "#$EndingOfBaseballInningWithOneTeamAhead is a specializaton of #$Event.  Each instance of #$EndingOfBaseballInningWithOneTeamAhead is an ending of an inning (see #$BaseballInning) in which one of the two teams playing the inning has a higher score than the other.")
(comment EndingOfBaseballInningAfterEighthWithOneTeamAhead "#$EndingOfBaseballInningAfterEighthWithOneTeamAhead is a specializaton of #$EndingOfBaseballInningWithOneTeamAhead.  Each instance of #$EndingOfBaseballInningAfterEighthWithOneTeamAhead is an ending of an inning (see #$BaseballInning) in which one of the two teams playing the inning has a higher score than the other.")
(comment EndingOfBaseballInningWithTieScore "#$EndingOfBaseballInningWithTieScore is a specializaton of #$EndingOfBaseballInning.  Each instance of #$EndingOfBaseballInningWithTieScore is an ending of an inning (see #$BaseballInning) in which neither of the two teams playing the inning has a higher score than the other.")
(comment UmpireCallingEndToBaseballGame "A specialization of #$Event.  Each instance of #$UmpireCallingEndToBaseballGame is an event in whcih an umpire officiating a baseball game declares that the baseball game is over.")
(comment IteratedEventSceneFn "(#$IteratedEventSceneFn EVT-TYPE) denotes a specialization of #$IteratedEventScene (q.v.) that is an instance of #$ScriptedEventType and which is such that each of its instances is comprised of multiple instances of #$Event type EVT-TYPE.")
(comment iteratedEventTypeOfSubSituationType "(#$iteratedEventTypeOfSubSituationType SIT-TYPE SUBSIT-TYPE EVT-TYPE) means that in any instance of SIT-TYPE, iterations of EVT-TYPE comprise the subsituation of type SUBSIT-TYPE.")
(comment iterationTerminalEventType "(#$iterationTerminalEventType SCRIPT SCENE EVT-TYPE) means that in SCRIPT, SCENE is comprised of iterations of an event type that terminate when an instance of EVT-TYPE is brought about by the occurrence of SCENE.")
(comment ObjectiveLens "A specialization of #$Lens-Artificial. Each instance in this collection
is the inital lens in an #$OpticalDevice that first receives the light
rays from the object and forms the image.")
(comment NightVisionDevice "A specialization of #$PhysicalDevice and SensoryEnhancementDevice-Visual. Instances of this collection
use light-amplification technology to convert a small amount of
environmental light and converts the light energy into electrical
energy. This electrical energy is then amplified through chemical and
electrical processes. The amplified energy is then channeled onto a
phosphorus screen that converts the energy again into visible light.")
(comment NightVisionMall-NightVisionWebpage "An instance of #$WorldWideWebPage-AIS.  This webpage
contains information on the technology behind #$NightVisionDevices.")
(comment AidedVisualPerception "A specialization of #$VisualPerception.  Instances of this
collection are events in which an agent uses some device to aid in
visual perception.  This would include events in which an agent uses a
flashlight to shine light into an area too dark for the agent to see
otherwise, the use of night vision devices and the use of
#$EyeGlasses to correct vision.")
(comment SeeingInVeryDimLight-Aided "A specialization of #$AidedVisualPerception. Instances of
this collection are events in which a #$PerceptualAgent uses a device
to improve their ability to engage in instances of #$VisualPerception
in while attempting to see objects in areas #$LitTooDarkForSeeing.
Instances of this collection include situations in which an agent uses
an instance of #$NightVisionGoggles to see in the dark, as well as
situations in which an instance of #$Flashlight is used to illuminate
dark areas.")
(comment Eyewear-NonPrescription "The collection of all non-prescription #$Eyewear")
(comment SeeingInVeryDimLight-Unaided "A specialization of #$VisualPerception.  Each instance of this
collection is an event in which an agent sees in conditions that are
#$LitTooDarkForSeeing.  How well any given agent performs instances of
this collection will vary according to several factors.  For example,
any normal instance of #$FelisGenus will see unaided in dim
lighting than any given instance of #$HomoSapiens.  Compare to
#$SeeingInVeryDimLight-Aided.")
(comment Sensor-Device "The intersection of #$Sensor and #$PhysicalDevice. Instances of this collection are devices which detect changes in their physical environment.")
(comment ArmedForceBranchFunction "A collection of functions that return branches of various
nation's armed forces. For exmaple, (#$ArmyFn #$Albania) returns the
army of the nation of Albania.")
(comment sensorTypeMaxEffectiveRange-IdealCondition "(#$sensorTypeMaxEffectiveRange-IdealCondition SENSOR-TYPE
RANGE OBJECT-TYPE) means that the specialization of #$Sensor SENSOR-TYPE has an
effective range for detecting instances of OBJECT-TYPE of RANGE under ideal
conditions.")
(comment NightVisionGoggles "A specialization of #$Goggle, #$NightVisionDevice, and
#$OpticalDevice.  Each instance of this collection is device used in
low light to enable the wearer to see better.")
(comment withinRangeForRolesInType "(#$withinRangeForRolesInType OBJECT1 ROLE1 OBJECT2 ROLE2
SITTYPE) means that at some time, OBJECT1 is within range of OBJECT2
such that OBJECT1 may play the #$Role ROLE1 and OBJECT2 may play the
#$Role ROLE2 in an instance of SITTYPE. For example, many times during
the #$USPresidentialElection-2000 it is true that (#$withinRangeForRolesInType #$AlbertGore #$performedBy #$GeorgeWBush #$performedBy #$ShakingHands). This does not mean that in fact OBJECT1 and OBJECT2 play said roles, only that the two are within range to do so.")
(comment detectedObject "(#$detectedObject DETECTING OBJECT) means that in the
instance of #$DetectingSomething DETECTING, OBJECT was the thing
detected.")
(comment MediumToHighAmountFn "A #$GenericValueFunction (q.v.) that takes a given #$TotallyOrderedQuantityType to a #$GenericQuantity of that type. In a given context, <code>(#$MediumToHighAmountFn QUANTTYPE)</code> is the properly interval-like quantity (and instance) of <code>QUANTTYPE</code> that is considered a <i>medium-to-high amount</i> of <code>QUANTTYPE</code> with respect to that context.
<p>
For example, (#$MediumToHighAmountFn #$Happiness) is the range from medium to high happiness.  It is more (see #$followingValue) than (#$LowAmountFn #$Happiness) and less than (#$VeryHighAmountFn #$Happiness).
<p>
See also the corresponding predicate #$mediumToHighAmountOf.")
(comment LowToMediumAmountFn "A #$GenericValueFunction (q.v.) that takes a given #$TotallyOrderedQuantityType to a #$GenericQuantity of that type.  In a given context, <code>(#$LowToMediumAmountFn QUANTTYPE)</code> is the properly interval-like quantity (and instance) of <code>QUANTTYPE</code> that is considered a <i>low-to-medium amount</i> of <code>QUANTTYPE</code> with respect to that context.
<p>
For example, (#$LowToMediumAmountFn #$Happiness) is the range from low to medium happiness.  It is more (see #$followingValue) than (#$VeryLowAmountFn #$Happiness) and less than (#$HighAmountFn #$Happiness) .
<p>
See also the corresponding predicate #$lowToMediumAmountOf.")
(comment CompressedFn "An instance of #$CollectionDenotingFunction.  #$CompressedFn takes an instance COLL of #$ExistingStuffType that is a specialization of #$PartiallyTangible and returns the specialization of COLL such that all of its instances are also instances of #$CompressedSubstance.  For example, (#$CompressedFn #$Air) is the collection of all compressed air.")
(comment CompressedSubstance "The collection of all instances of #$PartiallyTangible that are in a compressed state -- i.e., they have undergone a #$Compressing process and are still in the state that that process induces.")
(comment deviceTypeAdverselyAffectedBySitType "(#$deviceTypeAdverselyAffectedBySitType DEVICE-TYPE CONDITION)
relates a specialization of #$PhysicalDevice DEVICE-TYPE to a condition
CONDITION that may cause DEVICE-TYPE to operate in a less effective
manner.")
(comment hasDBAttribute "Replacement predicate for the soon to be defunct #$hasAttributes.  This predicate is designed to take #$hasAttributes place in various meta assertions that SKSI use such as (#$meaningSentenceOfSchema EDB-person-LS
       (#$hasAttributes
           (#$TheFn #$Person)
           (#$TheFn #$Lexical-SchemaGender)))).  Accordingly, it has whatever meaning #$hasAttributes had in assertions like those.")
(comment hasWeatherQuantity "This predicate relates outdoor locations to the degree of weather they are experiencing measured as a quantity. (#$hasWeatherQuantity LOC QUANT) means that LOC has the quantity of weather QUANT which is an instance of #$WeatherQuantity.")
(comment TwosComplementIntegerDatatype "The collection of all computer data types which represent integers using a two's complement representation. Hence, able to represent both positive and negative integers.")
(comment PackageBomb "A #$PackageBomb is disguised to look like a typical parcel, 
and is delivered to its target by a legitimate #$ShippingOrganization 
without that organization's knowledge. A #$PackageBomb may be designed 
to detonate at a specific time, or upon opening. They are intended to 
kill the recipient, cause damage at the delivery location, or both.
This type of weapon is not typically employed by regular modern militaries,
and is usually used by civilians in #$CriminalActs, and most notably 
#$TerroristAttacks.")
(comment SpatialIntersectionFn "This function takes a set of #$SpatialThings and denotes
their intersection, if such exists. For example,
(#$SpatialIntersectionFn (#$The Set #$Transmed-Pipeline (#$TerritoryFn
#$Sicily))) denotes the spatial intersection of the pipeline the
territory. Similar to #$BorderBetweenFn, #$SpatialIntersectionFn is a
partial function and is undefined for sets of things that do not
intersect. For... Note that INTERSECTION is a SpatialThing, but need
not be continuous.")
(comment Lambda "A binary #$FunctionDenotingFunction and #$ScopingRelation (qq.v.) that is used to define a function on the basis of a non-logical term (specifically a #$CycLDenotationalTerm-Assertible) and a list of variables, some or all of which will typically occur free in the term.  The resulting \"lambda-function\", roughly speaking, takes any sequence of appropriate values of these variables to the thing denoted by the corresponding instantiation of the non-logical term.
<p>
More precisely, the function that is returned when #$Lambda is applied to a given pair of arguments is determined by the following Principle of Lambda-Abstraction: If the #$CycLVariables VAR1, ..., VARn include all of the variables that occur free in TERM, then (#$Lambda (VAR1 ... VARn) TERM) is the n-ary function whose value, for any admitted sequence of arguments <ARG1, ..., ARGn>, is the thing (if any) denoted by a closed term TERM(ARGi/VARi) that is the result of simultaneously replacing each free occurrence of VARi in TERM with a CycL name of the corresponding ARGi (for 1 <= i <= n).  <ARG1, ..., ARGn> is an \"admitted sequence of arguments\" to this function just in case (i) each ARGi satisfies any argument-type constraints applicable to the position(s) occupied by VARi in TERM and (ii) if any two variables VARi and VARj are the same then the corresponding sequence-members ARGi and ARGj are identical.
<p>
A few examples. (#$Lambda (?X) (#$PlusFn ?X 1)) is the unary function that adds 1 to any number.  (#$Lambda (?X) (#$PlusFn 1 1)) is the unary function that maps any thing to the number 2.  (#$Lambda (?X ?Y) (#$PlusFn ?X ?Y)) is the binary addition function.  (#$Lambda (?X ?Y ?Z) (#$PlusFn ?X ?Y)) is the ternary function that maps any ordered triple whose first two items are numbers to the sum of those two numbers.  (#$Lambda (?X ?X) (#$PlusFn ?X 1)) is a binary function that takes every ordered pair whose first and second members are the same number K to K+1; e.g. it takes <2, 2> to 3.
<p>
(From a practical standpoint, of course, the last two examples above are rather degenerate.  When the variable-list includes items not occurring free in TERM, or contains multiple appearances of the same item, the arity of the resulting lambda-function is increased pointlessly.)
<p>
An important use of #$Lambda is to yield reduced-arity version of a given function, either by fixing one (or more) of the latter's arguments or by forcing two (or more) of its arguments to be the same.  For example, (#$Lambda (?NUM) (#$LogarithmFn ?NUM 10)) is a unary function that returns the base 10 logarithm of a given number, and (#$Lambda (?NUM) (#$PlusFn ?NUM ?NUM)) is a unary function that doubles a given number.
<p>
Another use of #$Lambda, shown indirectly in some of the above examples, is to yield a fixed-arity version of a given variable-arity function.  For example, (#$Lambda (?X ?Y) (#$PlusFn ?X ?Y)) is the binary addition function.
<p>
Still another use of #$Lambda is to yield the composition of two (or more) functions by nesting one functor inside another.  For example, (#$Lambda (?NUM1 ?NUM2) (#$MinusFn (#$TimesFn ?NUM1 ?NUM2))) is a function that returns the additive inverse of the product of two given numbers, and (#$Lambda (?ANIMAL) (#$MotherFn (#$FatherFn ?ANIMAL))) is a function that returns the paternal grandmother of a given animal.  (See also #$FunctionCompositionFn.)
<p>
Note that in each of the examples used thus far the variable-list included (at least) all of the variables that occurred free in the given term; hence those variables all became bound in the resulting lambda-expression, which was therefore _closed_ and capable of denoting a function.  In contrast, if TERM does contain free variables not among (VAR1 ... VARn), the former variables will remain free in the lambda-expression (#$Lambda (VAR1 ... VARn) TERM), which is therefore _open_ and incapable of denoting a function. (But of course those free variables might become bound in the context of a sentence that contains the lambda-expression and states a generalization of some sort about a certain class of lambda functions.)
<p>
#$Lambda is a cousin of the function #$Kappa, which is used to define a #$Predicate on the basis of an open sentence and a list of variables.  See also #$FunctionToArg.")
(comment CombustionInstrument "The #$Collection #$CombustionInstrument contains those instances of #$PartiallyTangible that are capable of playing either the role #$deviceUsed or #$stuffUsed in instances of the event type #$SettingSomethingOnFire.  This collection is divided into two sub-collections: #$CombustionDevice and #$CombustibleMaterial.")
(disjointWith RealEstate CombustionInstrument)
(disjointWith CloudOfH2O CombustionInstrument)
(comment CombustionDevice "The #$Collection #$CombustionDevice contains all of those #$PhysicalDevices which can play the role of #$deviceUsed in an instance of #$SettingSomethingOnFire. Notable subcollections include #$Match-FireStarter, #$IncendiaryDevice, and #$PyrotechnicDevice.")
(comment CombustibleMaterial "The #$Collection #$CombustibleMaterial that groups together instances of #$ExistingStuffType  which are capable of playing the role #$stuffUsed in instances of #$SettingSomethingOnFire.  Notable sub-collections include #$CombustibleFuelSubstance, #$PetroleumProduct, #$Paper and #$Wood.")
(disjointWith Water CombustibleMaterial)
(comment tacticalTerrainTypeFromPosition "(#$tacticalTerrainTypeFromPosition TERRAIN-TYPE TACTIC-TYPE LOCATIONAL-PRED) means that instances of TERRAIN-TYPE can often act as a type of TACTIC-TYPE for objects holding a LOCATIONAL-PRED relation to them. For example, (#$tacticalTerrainTypeFromPosition #$Hill #$ObservationFacilitatingTerrain #$on-Physical) means that observation (in general) done by objects that are #$on-Physical instances of #$Hill will often be facilitated because they are on the hill. Similarly one might say (#$tacticalTerrainTypeFromPosition #$Hill #$ObservationLimitingTerrain #$near), meaning that observation (in general) done by objects that are #$near instances of #$Hill will often be limited because they are near the hill. Also see #$tacticalTerrainTypeFromPositionForUnitType and #$tacticalTerrainFromPositionForUnitType.")
(comment tacticalTerrainTypeFromPositionForUnitType "(#$tacticalTerrainTypeFromPositionForUnitType TERRAIN-TYPE TACTIC-TYPE LOCATIONAL-PRED UNIT-TYPE) means that TERRAIN-TYPE is a type of TACTIC-TYPE for instances of UNIT-TYPE when they are located LOCATIONAL-PRED in relation to an instance of TERRAIN-TYPE. For example, (#$tacticalTerrainFromPositionForUnitType #$Hill #$ObservationFacilitatingTerrain #$on-Physical #$InfantryUnit-MilitarySpecialty) says that instances of #$Hill facilitate observation for instances of #$InfantryUnit-MilitarySpecialty when they are on them. Also see #$tacticalTerrainFromPositionForUnitType and #$tacticalTerrainTypeFromPosition.")
(comment tacticalTerrainFromPositionForUnitType "(#$tacticalTerrainFromPositionForUnitType TERRAIN TACTIC-TYPE LOCATIONAL-PRED UNIT-TYPE) means that TERRAIN is a TACTIC-TYPE type of terrain for instances of UNIT-TYPE when they are located LOCATIONAL-PRED in relation to TERRAIN. For example, (#$tacticalTerrainFromPositionForUnitType Hill-1234 #$ObservationFacilitatingTerrain #$on-Physical #$InfantryUnit-MilitarySpecialty) says that the individual hill called Hill-1234 facilitates observation for infantry units when they are on it. Similarly, that same hill might limit observation when the unit is near it.")
(comment terrainTypeSideSlope "(#$terrainTypeSideSlope TERRAIN-TYPE NUM DIRECTION) means that side number NUM of instances of TERRAIN-TYPE have a DIRECTION slope. NUM is an integer from 1 to n, where (#$terrainTypeNumberOfSides TERRAIN-TYPE n). The 'side' chosen to be side number 1 is completely arbitrary, but side 2 will be the next side in a clockwise direction from the point of reference of the central feature of the terrain. For example, if (#$terrainTypeNumberOfSides Saddle 4), and if (#$terrainTypeSideSlope Saddle 1 Down-Generally), then from the reference point of the 'seat' of the saddle, (#$terrainTypeSideSlope Saddle 2 #$Up-Generally), (#$terrainTypeSideSlope Saddle 3 #$Down-Generally) and (#$terrainTypeSideSlope Saddle 4 #$Up-Generally).")
(comment terrainTypeNumberOfSides "(#$terrainTypeNumberOfSides TERRAIN-TYPE NUM) means that instances of TERRAIN-TYPE have NUM number of sides. For example, it is commonly asserted by military experts that instances of #$Valley have 4 sides. The concept of 'side' here is meant to be extremely vague, and the number of sides for a type of terrain is determined solely by the language of subject matter experts. This predicate is commonly used in conjunction with #$terrainTypeSideSlope.")
(comment SometimesFn "'(#$SometimesFn COLL)' denotes the super collection of COLL that is the collection
of all the instances that COLL has ever had (or will ever have).  More precisely, (#$isa ?X (#$SometimesFn COLL)) holds in a monadic mt MT just in case there exists a time interval, TI, and a time parameter, P, such that (#$isa ?X COLL)<MT TI P>.")
(comment buyingHome "This can be considered the active present tense version of #$homeBuyer.  (#$buyingHome HOME-BUYING AGT) <MT TIME PAR> holds in MT just in case during TIME, to granularity PAR, AGT is engaged in the home buying activity HOME-BUYING.")
(comment CycIntegerSequenceGenerator "A collection of objects stored in a Cyc KB that can generate integers in
a sequence.")
(comment isgStartValue "(#$isgStartValue ISG N) means that the first integer ISG should generate
is N.")
(comment isgDelta "(#$isgDelta ISG N) means that each integer ISG generates should be N
greater than the preceding one.")
(comment lockQueue "QUEUE is the queue of requesters for LOCK.")
(comment CycLock "A collection of objects contained in a Cyc KB that support requesting and
holding conventions such that when something requests a #$CycLock, it gets to hold
the lock as soon as all previous requesters have released it.")
(comment CycQueue "A collection of first-in, first-out (FIFO) queues whose contents
are contained in a Cyc KB, using #$queueMembers and #$queueHead.")
(comment lockRequested "(#$lockRequested LOCK REQUESTER) means that LOCK is requested by REQUESTER.")
(comment isgNextAvailableValue "(#$isgNextAvailableValue ISG N) means the next integer ISG generates will be N.")
(comment isgLastGeneratedValue "(#$isgLastGeneratedValue ISG N) means the last integer ISG generated was N.")
(comment CausationPredicate "#$CausationPredicate is an instance of #$PredicateTypeByTopic.  It is the collection of predicates that are used to state which type-type or instance-level causal relations hold.  For more information about these predicates, see #$NoteAboutCausationPredicates.")
(disjointWith ScalarPointValue ScalarProperInterval)
(comment ScalarProperInterval "A specialization of #$ScalarInterval.  Each instance of #$ScalarProperInterval is a proper interval or range of numbers or quantities, as opposed to a single number or quantity (cf. #$ScalarPointValue).
<p>
When a #$UnitOfMeasure is applied to a <i>pair</i> of distinct #$Number-Generals, the result is a #$Quantity that is an instance of #$ScalarProperInterval.  For example, (#$Meter 3 5) is the distance \"between 3 and 5 meters (inclusive)\" and (#$SecondsDuration  10 100) is  the duration \"between 10 and 100 seconds (inclusive)\".
<p>
Another sort of scalar proper interval is any instance of the specialization #$OrderOfMagnitudeInterval.")
(comment ClosedObject "A specialization of #$PartiallyTangible.  Instances of this
collection are things that may be said to be closed.  This includes
such things as a closed store, a closed bridged, or a blocked artery.")
(comment BranchOrganizationOfFn "(#$BranchOrganizationOfFn ORG) is the collection of all #$BranchOrganizations of ORG.")
(comment websiteContents "(#$websiteContents SITE AIT) means that the abstract
information content AIT is part of the overall content of the
#$WebSite SITE.  More precisely, it means that AIT is encoded in one
(or more) of the #$WebPage-AISs that comprise SITE. Note that
#$websiteContents holds just in case AIT is encoded in #$WebPage-AISs 
that are 'internal' to SITE.  It does not apply when AIT is available
only on an 'external' webpage that is linked from SITE.")
(comment LimitedWeather-PathArtifact "A specialization of #$PathArtifact.  Each instance of this
collection is a route that has limited passability throughout the
year.  These routes are typically do not have #$WaterproofSurfaces,
and are thus susceptible to rain, frost, heat, and other weather
conditions.  Adverse weather conditions led to this type of route
being closed to heavy use for short periods (up to a day).")
(comment VeryHeavyDuty-PathArtifact "A specialization of #$PathArtifact.  Instances of this
collection are those that may accomodate very heavy loads.")
(comment TheEmptyTimeInterval "#$TheEmptyTimeInterval is the time interval that has no duration.")
(comment axialTiltRange-Percent "(#$axialTiltRange-Percent VEHICLE PERCENT-SLOPE) means that VEHICLE can effectively travel across a slope withe a grade of PERCENT-SLOPE. Use #$axialTiltRange for slope expressed in terms of units of angular measure.")
(comment Prediction-CW "A specialization of #$PropositionalConceptualWork.  Each
instance of this collection is the information resulting from
#$MakingAPrediction. Instances are forecasts of future events or
situations proposed by some agent.")
(comment WeatherForecast-PCW "A specialization of #$Prediction-CW.  Instances of this
collection are events in which some agent makes a predication as the
the future occurances in #$WeatherEvent for a particular place and
period of time.  Positive examples include last night's forecast on
the evening news for today in Austin, Texas, or my great-great-aunt Olga's
predication of rain based on the twinges in her knees.  See also
#$WeatherNews and #$WeatherReport.")
(comment ReportOnSituation-CW "A specialization of #$NonfictionalPCW.  Instances of this
collection are verbal or written reports of a particular
situation.  Positive examples of this collection would be a written
police report or a verbal report to my primary supervisor on the
status of an assignment.")
(comment WeatherReport-CW "A specialization of #$ReportOnSituation-CW.  Instances of
this collection are written or verbal reports on #$WeatherEvents.  See
also #$WeatherNews and #$WeatherForecast.")
(comment weatherForecastForRegion "(#$weatherForecastForRegion FORECAST REGION TIME) means that the
#$WeatherForecast-PCW FORECAST contains propositional information about
the predicted weather for #$GeographicalRegion REGION for the given time
period TIME.")
(comment forecastedWeatherCondition "(#$forecastedWeatherCondition FORECAST DEGREE) means that
the #$ScalarInterval DEGREE is a forecasted degree of a condition of
weather in the instance of #$WeatherForecast-PCW FORECAST.")
(comment forecastedAmbientVisibility "(#$forecastedAmbientVisibility FORECAST DEGREE) means that
DEGREE is the amount of forecasted visibility in FORECAST.")
(comment TimePointsDuration "A #$UnitOfTime function that takes one or two whole numbers as arguments and returns, as its value, a comparable #$Time-Quantity measured in #$TimePoints. More precisely, an expression of the form (#$TimePointsDuration NUM) denotes the (\"point-value\") #$Time-Quantity of being exactly NUM #$TimePoints in duration, and an expression of the form (#$TimePointsDuration MIN MAX) denotes the (properly interval-like) #$Time-Quantity of being at least MIN #$TimePoints and at most MAX #$TimePoints in duration.")
(comment forecastedRaininessOfRegion "(#$forecastedRaininessOfRegion FORECAST DEGREE) relates an
instance of #$WeatherForecast-PCW to an instance of #$Raininess
that it predicts for a given region and time period.  See also
#$weatherForecastForRegion.")
(comment forecastedAmbientWindSpeed "(#$forecastedAmbientWindSpeed FORECAST SPEED) means that the
instance of #$WeatherForecast-PCW FORECAST has predicated an
ambient wind speed of SPEED for a given region and time duration.  See
also #$weatherForecastForRegion.")
(comment forecastedAmbientWindDirection "(#$forecastedAmbientWindDirection FORECAST DIRECTION)
relates an instance of #$WeatherForecast-PCW to an instance of
#$TerrestrialDirection predicted for a particualr region over a given
time period.  See also #$weatherForecastForRegion.")
(comment forecastedAmbientTemperature "(#$forecastedAmbientTemperature FORECAST TEMPERATURE) means
that FORECAST, an instance of #$WeatherForecast-PCW, predicated an
ambient #$Temperature of TEMPERATURE for a given region over a given
period of time.  See also #$weatherForecastForRegion.")
(comment forecastedHighTemperature "(#$forecastedHighTemperature FORECAST TEMPERATURE) means
that FORECAST, an instance of #$WeatherForecast-PCW, predicated a
high #$Temperature of TEMPERATURE for a given region during a particular
time period.")
(comment forecastedLowTemperature "(#$forecastedLowTemperature FORECAST TEMPERATURE) means that
FORECAST, an instance of #$WeatherForecast-PCW, predicated a low
#$Temperature of TEMPERATURE for a given region during a particular
time period.")
(comment forecastedRelativeHumidity "(#$forecastedRelativeHumidity FORECAST DEGREE) relates an
instance of #$WeatherForecast-PCW to the degree of
#$RelativeHumidity DEGREE that is predicated for a particular region
and time period.  See also #$weatherForecastForRegion.")
(comment forecastedCloudiness "(#$forecastedCloudiness FORECAST DEGREE) means that the
instance of #$WeatherForecast-PCW predicates the cloud coverage
DEGREE for a particular region during a particular time period.  See
also #$weatherForecastForRegion.")
(comment KyrgyzstaniPerson "The collection of people who are #$citizens of #$Kyrgyzstan, or participate in its #$NationalCulture..")
(comment typeImmediateRisk "<code>(#$typeImmediateRisk SIT-TYPE1 ROLE1 SIT-TYPE2 ROLE2)</code> means that if an object <code>OBJ</code> plays <code>ROLE1</code> in an instance of <code>SIT-TYPE1</code>, then <code>OBJ</code> is at immediate risk for playing the role <code>ROLE2</code> in an instance of <code>SIT-TYPE2</code>. For instance, '(#$typeImmediateRisk #$DrunkDriving #$doneBy #$CarAccident #$doneBy)' means that drunk driving promotes the risk of getting into a car accident. See also #$typePromotesRisk and #$immediateRisk.")
(comment CroatianPerson "This is the collection of people who are #$citizens of #$Croatia, or participate in its #$NationalCulture.")
(comment LodgingIndustryWorker "An instance of #$PersonTypeByOccupation and a specialization of #$PersonWithOccupation.  Each instance of #$LodgingIndustryWorker is a #$Person who works for a #$LodgingOrganization, e.g. a #$HotelOrganization or #$BedAndBreakfast.")
(comment LatvianPerson "The collection of people who are #$citizens of #$Latvia, or participate in its #$NationalCulture.")
(comment CubicInch "A function which returns an element of #$Volume.")
(disjointWith InternationalUnitOfMeasure-Common InternationalUnitOfMeasure-Obsolete)
(disjointWith InternationalUnitOfMeasure-Obsolete SIUnitOfMeasure)
(disjointWith USUnitOfMeasure-Common USUnitOfMeasure-Obsolete)
(comment UnitOfMeasureTypeBySystem-Coherent "A collection of collections. Each instance of #$UnitOfMeasureTypeBySystem-Coherent is an instance of #$UnitOfMeasureTypeBySystem such that all of its instances are either base units (of the relevant system), are algebraicially derived from the base units without using any numerical factors other than 1, or obtained from other units of the system by adding an acceptable unit prefix (e.g., in some systems, a #$MetricUnitPrefix).  Some examples are #$SIUnitOfMeasure, #$MKSUnitOfMeasure, and #$CGSUnitOfMeasure.  Some non-examples are #$InternationalUnitOfMeasure, #$USUnitOfMeasure, #$MetricUnitOfMeasure, #$FPSUnitOfMeasure.")
(disjointWith InternalSensoryQuantity InterAgentQuantity)
(comment MKSUnitOfMeasure-Base "A specialization of #$MKSUnitOfMeasure.  Each instance of #$MKSUnitOfMeasure-Base is one of the three base units of the MKS system.")
(comment CGSUnitOfMeasure-Base "A specialization of #$CGSUnitOfMeasure.  Each instance of #$CGSUnitOfMeasure-Base is one of the three basic units of the CGS system of measurement.")
(comment nounCompoundParses "(#$nounCompoundParses STRING CYCL) means that CYCL is a possible meaning of STRING, interpreted as a noun compound.")
(comment taskTypeUsesTacticalObjectType "(#$taskTypeUsesTacticalObjectType TASK-TYPE TERRAIN-OBJTYPE)
relates a type of #$TacticalTerrainObject TERRAIN-OBJTYPE to the type of
#$MilitaryAction TASK-TYPE that specifically uses instances of
TERRAIN-OBJTYPE in instances of TASK-TYPE.")
(comment unitTypeUsesTacticalObjectType "(#$unitTypeUsesTacticalObjectType UNIT-TYPE TERRAIN-OBJTYPE) means
that instances of  UNIT-TYPE are able to exploit the terrain
advantages offered by instances of TERRAIN-OBJTYPE.")
(comment RemovalModuleSupportedPredicate-Generic "The collection of all #$Predicates which are supported by some #$CycRemovalModule-Generic.  An assertion of the form (PRED . ARGS), where PRED is an instance of #$RemovalModuleSupportedPredicate-Generic, may affect the provability of sentences other than just sentences whose predicate is PRED.  This is what is meant by 'generic' in this sense.")
(comment InferenceSupportedPredicate "The collection of all #$Predicates that are supported in some way by the #$CycInferenceEngine.  This support may be provided by, for example, a #$CycHLModule or an #$evaluationDefn.")
(comment WFFSupportedPredicate "The collection of all #$Predicates that are supported in some way by the #$CycWellFormednessChecker, either to satisfy, impose, or relax well-formedness constraints.")
(comment InferenceSupportedTerm "The collection of all #$CycLTerms that are supported in some way by the #$CycInferenceEngine.  This support may be provided by, for example, a #$CycHLModule or an #$evaluationDefn.")
(comment InferenceSupportedFunction "The collection of all #$Function-Denotationals that are supported in some way by the #$CycInferenceEngine.  This support may be provided by, for example, an #$evaluationDefn.")
(comment WFFConstraintPredicate "The collection of all #$Predicates which can impose well-formedness constraints.  More specifically, only assertions of the form (PRED . ARGS), where PRED is an instance of #$WFFConstraintPredicate, can directly impose a well-formedness constraint, i.e. cause a previously well-formed sentence to become ill-formed, given the same WFF standards.  Any assertion could _indirectly_ impose a well-formedness constraint, for instance by triggering a forward rule or an #$afterAdding.")
(comment TransformationModuleSupportedCollection "The collection of all #$Collections which are supported by some #$CycTransformationModule.")
(comment TransformationModuleSupportedPredicate "The collection of all #$Predicates which are supported by some #$CycTransformationModule.")
(comment RemovalModuleSupportedPredicate-Specific "The collection of all #$Predicates which are supported by some #$CycRemovalModule-Specific.  Sentences of the form (PRED . ARGS), where PRED is an instance of #$RemovalModuleSupportedPredicate-Specific, have special inference support.")
(comment RemovalModuleSupportedCollection-Generic "The collection of all #$Collections which are supported by some #$CycRemovalModule-Generic.  An assertion of the form (#$isa INS COL), where COL is an instance of #$RemovalModuleSupportedCollection-Generic, may affect the provability of sentences that do not mention COL explicitly.  In particular, it may affect the provability of sentences mentioning INS.")
(comment WFFDirectivePredicate "The collection of all #$Predicates which can affect what WFF standards to impose on a given sentence.")
(comment WFFConstraintSatisfactionPredicate "The collection of all #$Predicates which can satisfy well-formedness constraints.  More specifically, only assertions of the form (PRED . ARGS), where PRED is an instance of #$WFFConstraintPredicate, can directly satisfy a well-formedness constraint, i.e. cause any previously ill-formed sentence to become well-formed, given the same WFF standards.  Any assertion could _indirectly_ satisfy a well-formedness constraint, for instance by triggering a forward rule or an #$afterAdding.  A common case of this is the #$afterAddings on spec-preds of #$isa and #$genls.")
(comment propositionalCWAccuracyLevel "(#$propositionalCWAccuracyLevel INFOSTORE LEVEL) relates an
instance of #$InformationStore to the level of accuracy LEVEL for
determined for INFOSTORE. Accuracy of an #$InformationStore will
depend on the author (if there is one), date of creation of the
#$InformationStore, and a sundry other factors. The statement of
accuracy for any given instance of #$InformationStore will be also be
subject to an accuracy level.")
(comment parserTestString "(#$parserTestString TEST STRING) means that TEST is a test of parsing STRING.")
(comment parserTestTarget "(#$parserTestTarget TEST TARGET) means that TARGET is a desired parse for TEST.")
(comment atLeastPartiallyResponsibleFor "(#$atLeastPartiallyResponsibleFor AGT SIT) holds just in case AGT performed some deliberate actions prior to SIT that in some way contributed to SIT's occurrence.  This notion is somewhat weaker than with #$responsibleFor.  The latter's holding requires that SIT would not have occurred had AGT done something other than the action which was instrumental in bringing about SIT (see the #$comment on #$responsibleFor).  On the other hand, if an agent is #$atLeastPartiallyResponsibleFor SIT, it doesn't entail that their action was necessary for the occurrence of SIT.  Rather, it means that SIT's occurence was made easier/more probable.  One class of paradigm cases of partial responsibility in the sense defined are found in one agent's generic financial support of another agent's activities.  For example, an organization that financially supports a terrorist can be said to be #$atLeastPartiallyResponsibleFor that terrorist's actions in that the support made it more probable that the terrorist's actions would be successful.")
(comment Spur-Topographical "A specialization of
#$GeographicalRegion, #$TerrainHighGround, and #$NaturalThing.
Instances of this collection are those lower elevated ridges of rock
jutting out into a valley or plain.")
(comment sksSourceDescriptionMt "This predicate relates a structured knowledge source with its source description microtheory.")
(comment sksPhysicalSchemaDescriptionMt "This predicate relates a structured knowledge source with its physical schemata description microtheory.")
(comment sksLogicalSchemaDescriptionMt "This predicate relates a structured knowledge source with its logical schemata description microtheory.")
(comment sksSchemaTranslationMt "This predicate relates a structured knowledge source with its schema translations microtheory.")
(comment isomorphicFormulas "A binary predicate that relates a list of #$CycLTerms to a list (of equal length) of #$CycLFormulas such that the formulas in the latter list are pairwise \"isomorphic\", differing only with respect to which term in the former list they contain.  (#$isomorphicFormulas (#$TheList TERM1 TERM2 ... TERMn) (#$TheList FORMULA1 FORMULA2 ... FORMULAn)) holds just in case FORMULA1 - FORMULAn differ only in that TERM1 occurs in FORMULA1 in exactly the same places that TERM2 occurs in FORMULA2, ..., and that TERMn occurs in FORMULAn.  That is, for any i,j <= n, replacing each occurrence of TERMi in FORMULAi with TERMj results in FORMULAj.
<p>
For example,
<p>
<pre>
  (#$isomorphicFormulas
    (#$TheList #$Mexico #$RomanEmpire)
    (#$TheList (#$CitizenFn #$Mexico) (#$CitizenFn #$RomanEmpire)))
</pre>
<p>
holds because replacing '#$Mexico' with '#$RomanEmpire' in '(#$CitizenFn #$Mexico)' results in '(#$CitizenFn #$RomanEmpire)', and vice versa.")
(comment TypicalityReferenceSetProperty "The collection of properties that can define the domain of a #$TypicalityReferenceSet,
or whose typicality with respect to such a domain can be defined.")
(comment TypicalityReferenceSet "A #$TypicalityReferenceSet is a set of CycL terms selected to be representative of
all the terms that are known to have a property (see #$typicalityReferenceSetDomainProperty)
in a certain #$Microtheory (see #$typicalityReferenceSetMicrotheory).")
(comment typicalityReferenceSetDomainCollection "(#$typicalityReferenceSetDomainCollection SET COLLECTION) means that SET has been selected 
to be representative of the known instances of COLLECTION in its #$typicalityReferenceSetMicrotheory.")
(comment typicalityReferenceSetDomainProperty "(#$typicalityReferenceSetDomainProperty SET PROPERTY) means that SET has been selected to be
representative of the terms that are known to have PROPERTY in its #$typicalityReferenceSetMicrotheory.")
(comment typicalityReferenceSetMicrotheory "(#$typicalityReferenceSetMicrotheory SET MT) means that SET has been selected to be
representative of the terms that are known to have its #$typicalityReferenceSetDomainProperty in MT.")
(comment hasTypicalityReferenceSetProperty "(#$hasTypicalityReferenceSetProperty THING PROPERTY) means that THING has
the property PROPERTY.")
(comment typicalityReferenceSetSize "(#$typicalityReferenceSetSize SET N) means that SET has N elements.")
(comment prevalenceOfPropertyInReferenceSet "(#$prevalenceOfPropertyInReferenceSet PROPERTY SET N) means that N elements of SET
are known to have PROPERTY.")
(comment typicalityReferenceSetMembers "(typicalityReferenceSetMembers SET THING) means that THING is a member of SET.")
(comment ModernMilitaryUnitType "A specialization of #$ExistingObjectType.  Each instance of this colleciton is a subset of #$ModernMilitaryOrganization.")
(comment CycLDenotationalTerm-Assertible "A #$CycLExpressionType and a specialization of both #$CycLDenotationalTerm and #$CycLExpression-Assertible (qq.v.).  This is the collection of all CycL denotational terms that could appear within a sentence that could be asserted to the Cyc Knowledge Base.  More precisely, each instance of #$CycLDenotationalTerm-Assertible is a denotational (i.e. non-logical) term that is both syntactically and semantically well-formed.  By definition, any CycL term is syntactically well-formed.  To be semantically well-formed, denotational term sentence must be either be atomic (see #$CycLAtomicTerm) or constructible via the syntax of CycL (see #$CycLNonAtomicTerm-Assertible) without violating any applicable arity or argument-type constraints (see #$arity and #$ArgTypePredicate).  A CycL term must be semantically well-formed in order to be interpretable as having a \"semantic value\", which for denotational terms means having a denotation.  Note that being \"assertible\" in the present sense does not require a sentence's actually being asserted in the KB.")
(comment LispReader "A specialization of #$DevelopmentProgram.  Each instance of #$LispReader is a program designed to read Lisp code to generate a token stream to pass to a compiler or interpreter (see #$ProgrammingLanguageImplementation).")
(comment FactoryWorker "An instance of #$PersonTypeByOccupation.  Each instance of #$FactoryWorker is a #$Person who works in a #$FactoryBuilding.  A noteable specialization is #$AssemblyLineWorker.")
(comment OfficeOfOrgFn "An instance of #$UnaryFunction and #$CollectionDenotingFunction.  (#$OfficeOfOrgFn ORG) denotes the collection of all #$OfficeSpaces which are occupied by the #$Organization ORG.")
(comment networkKnowledgePredicateForCycSecureComponent "(#$networkKnowledgePredicateForCycSecureComponent PRED COMPONENT) means that a running copy of #$CycSecure-TheProgram requires depends on the ability to acquire information about entities standing in the relation denoted by the predicate PRED from the network it is scanning in order for its copy of #$CycSecureProgramComponent COMPONENT to function properly.")
(comment domainKnowledgePredicateForCycSecureComponent "(#$domainKnowledgePredicateForCycSecureComponent PRED COMPONENT) means that a running copy of #$CycSecure-TheProgram requires depends on the ability to acquire domioan knowledge (usually from its copy if #$CycKB)  about entities standing in the relation denoted by the predicate PRED from its copy of #$CycSecureProgramComponent COMPONENT to function properly.")
(comment ComputerDatabase-CW "A specialization of #$ComputerFile-CW and
#$Database-AbstractContent.  Each instance of #$ComputerDatabase-CW is
an abstract database encoded in a computer-readable format -- in
particular, in a structured format which supports some form of
automated database query.  For particular instantiations of a
#$ComputerDatabase-CW, see #$Database-Physical.")
(comment HazardousChemicalType "A specialization of #$HazardousThingType.  Each instance of #$HazardousChemicalType is a collection of chemical substances whose instances are hazardous to humans.  These materials require certain precautions when being handled to lower the risk of exposure or in the case of explosive materials, lower the risk of combustion.  Note: unlike #$HazardousChemicalSubstanceType the instances of this collection are not required to be substance types.  Any collection of hazardous chemicals will be an instance of #$HazardousChemicalType regardless of whether it constitutes a \"type\".")
(comment HolySiteOfReligionFn "An instance of #$CollectionDenotingFunction.  (#$HolySiteOfReligionFn RELIGION) denotes the collection of all #$Places that are considered to be #$holySites of RELIGION by (many) believers in RELIGION.")
(comment mtOfCW "(#$mtOfCW WORK MT) means that the contents of MT were derived
from WORK, i.e., are #$CycL translations of 'content' found in WORK.")
(comment Reclaiming "A Goddess-centric tradition of #$Paganism focusing on spiritual empowerment in addition to liberal and environmentalist political action.")
(comment LinePatternType "The collection of all visual patterns of lines.  Instances include dashed line patterns (#$DashedLinePattern), double-line patterns (#$DoubleLine-PatternType), etc.")
(comment imageHasBordersOfType "An instance of #$BinaryPredicate that relates an instance of #$VisualImage to the types of borders it has (single-line, double-line, dashed-line, etc.).  If an image has a uniform border of a single type, use the functional #$imageHasBorderType.")
(comment backwardsDirectionFromObject "(#$backwardsDirectionFromObject VECTOR OBJECT) means that
VECTOR, an instance of #$UnitVector-Precise, is the current direction
that OBJECT's, an instance of #$FrontAndBackSidedObject, back is
facing.  This is, of course, a relation that requires temporal
qualification.  See also #$BackwardsFn.")
(comment glfComponentSemanticsWRTGraph "An instance of #$TernaryPredicate.  #$glfComponentSemanticsWRTGraph is used to relate an instance of #$GLFGraphComponent to the object it denotes in the context of an instance of #$Graph-CW for which that component is part of the graph's structure.  For example, (#$glfComponentSemanticsWRTGraph GLFNODE002  (#$CycQueryRunningFromFn VegetationConcealsDefenderFromLOSFlanksQuerySpec) GLFGRAPH002) says that in the graph GLFGRAPH002, GLFNODE002 represents the running of the query, VegetationConcealsDefenderFromLOSFlanksQuerySpec).")
(comment imageLineColor "An instance of #$BinaryPredicate that relates an instance of #$VisualImage to its line color.")
(comment imageFontColor "An instance of #$BinaryPredicate that relates an instance of #$VisualImage to its font color.")
(comment imageFontFamily "An instance of #$BinaryPredicate that relates an instance of #$VisualImage to its font family.")
(comment FontTypeByFamily "A specialization of #$CharacterSet.  Instances are collections of characters that together make up a defined font family.  Examples include Times and Arial.")
(comment imageFontSize "An instance of #$BinaryPredicate that relates an instance of #$VisualImage to its font size.")
(comment FontTypeByStyle "A specialization of #$CharacterSet.  Instances are collections of characters that together make up a defined font style.  Examples include italics and bold.")
(comment BoldedCharacter "An instance of #$FontTypeByStyle.  Instances are individual instances of #$Character-Abstract that appear as bolded text.")
(comment ItalicizedCharacter "An instance of #$FontTypeByStyle.  Instances are individual instances of #$Character-Abstract that appear as italicized text.")
(comment AmmoniaAndAmmoniumSalts "The collection of samples of Ammonia and salts made from the ammonium ion.  This collection is designed to serve as a mapping target for SKSI database queries.")
(comment IndustrialGases "The collection of the various gases used for industrial purposes.  This collection is primarily designed as a mapping target for SKSI queries.")
(comment Insecticide "The collection of all samples of insecticides -- i.e. chemicals designed to kill insects.")
(comment ReformulationParameter "Instances of #$ReformulationParameter are #$SoftwareParameters that control how the #$CycLReformulator carries out reformulation. A group of #$ReformulationParameters and their values can be bundled into a #$ReformulationSpecification. Reformulation parameters are set on reformulator calls via #$parameterValueForReformulation.")
(comment RLModuleFocusRFParameter "A reformulator parameter that chooses a particular #$RLModule, or focus, to use. If a focus is specified, the reformulator hub will forward the input expression to it directly.")
(comment ReformulatorWFFEnforcementProperty "The collection of all states currently defined for the #$WFFEnforcementRFParameter of the #$CyclReformulator. These states govern how the reformulator imposes WFF constraints on input expressions and reformulator rules.")
(comment NoWFFCheckInReformulation "An instance of #$ReformulatorWFFEnforcementProperty. When the #$WFFEnforcementRFParameter of the #$CycLReformulator is set to #$NoWFFCheckInReformulation, no WFF-checking is performed.")
(comment ReformulationListParameterPredicate "A collection of predicates used to pass individual values to certain #$ReformulationParameters. Some of these parameters take lists of assertions or CycL constants as values,  and using a list in the arg2 position of #$parameterValueForReformulation creates an opaque object for the WFF-checker. By using one of these predicates to designate each member of the value list we can ensure that no non-WFF rules are passed to the reformulator parameters.")
(comment skipAssertionInReformulation "A predicate for enumerating assertions to be ignored by the reformulator in a particular specification. (#$skipAssertionInReformulation SPEC RULE INT) means the reformulator should ignore assertion RULE when invoked by SPEC. The value of RULE is passed to the #$CycLReformulator parameter :skip-assertions as a list. The value of INT is the place where RULE appears in the list.")
(comment ReformulationSpecification "#$ReformulationSpecification is the collection of #$ProgramSpecifications for the #$CycLReformulator. Instance of this collection (known as 'reformulator calls') - will be linked to #$ReformulationParameters that govern how the reformulator modifies CycL formulae. Reformulator calls are specified via #$softwareParameterValueInSpecification.")
(comment SkippedAssertionsRFParameter "A reformulator parameter that specifies which KB assertions are not to be used during reformulation. To set this parameter, please use #$skipAssertionInReformulation.")
(comment parameterValueForReformulation "A specPred of #$softwareParameterValueInSpecification. (#$parameterValueForReformulation PARAM VAL CALL) means that #$ReformulationSpecification CALL has value VALUE in parameter PARAMETER. For example, (#$parameterValueForReformulation #$SubformulaRFParameter (SubLQuoteFn :TRUE) #$SomeRFCallSpec001) means that in the reformulation #$SomeRFCallSpec001, #$SubformulaRFParameter is set to 'true,' which means the #$CycLReformulator will reformulate the input CycL expression and its subformulas. See also #$ReformulationParameter.")
(comment PreconditionCheckRFParameter "A reformulator parameter that specifies the method used to check preconditions on reformulator rules. Currently, only possible value is the default value :removal-only-ask.")
(comment defaultValueForParameter "(#$defaultValueForParameter PROGRAM PARAMETER VALUE) means that in program PROGRAM, the parameter PARAMETER has a default value of VALUE. Assertions on this predicate are descriptive, not prescriptive. So, to assert (#$defaultValueForParameter #$CycLReformulator #$WFFEnforcementRFParameter #$RelationInMtWFFCheckInReformulation) does not set the default value for that parameter, but rather merely reports that the WFF-enforcement parameter of the reformulator is set by default to #$RelationInMtWFFCheckInReformulation.")
(comment WFFEnforcementRFParameter "A reformulator parameter that governs the level of well-formedness to be enforced during reformulation. These constraints are imposed on the EL input expression and the reformulator rules, not on intermediate results or the output expression. The default value for this setting is ':kb', which checks the arg0 position to ensure it is a relation in that Mt. Other values are ':none', for no wff-checking, ':arity', which checks the arg0 position and the arity, and ':all', which performs full semantic wff-checking, including arg-type constraints.")
(comment RelationInMtWFFCheckInReformulation "An instance of #$ReformulatorWFFEnforcementProperty. When the #$WFFEnforcementRFParameter of the #$CyclReformulator is set to #$RelationInMtWFFCheckInReformulation, the arg0 position is checked to make sure it is a relation in the microtheory specified. This is the default setting.")
(comment ReformulatorRuleMicrotheory "This is the collection of all microtheories that contain reformulator rules.")
(comment useRuleInReformulation "A predicate for enumerating rules to be used by the reformulator in a particular specification, and the order in which they are to be used. (#$useRuleInReformulation SPEC RULE INT) means the reformulator should use rule RULE when invoked by SPEC. The value of RULE is passed to the #$CycLReformulator parameter :reformulator-rules as a list. The value of INT is the place where RULE appears in the list.")
(comment useMetaPredicateInReformulation "A predicate for enumerating predicates which must be wrapped around a reformulator rule for it to be used. (#$useMetaPredicateInReformulation SPEC PRED INT) means the reformulator should use only those reformulator rules wrapped by #$MetaPredicate PRED. The value of PRED is passed to the #$CycLReformulator parameter :meta-predicates as a list. The value of INT is the place where RULE appears in the list.")
(comment ignoreModuleInReformulation "A predicate for enumerating instances of #$RLModule to be ignored in a given #$ReformulationSpecification. (#$ignoreModuleInReformulation SPEC MODULE INT) means the reformulator should not use module MODULE when invoked by SPEC. The value of MODULE is passed into the #$CycLReformulator parameter :ignore-rl-modules as a list. The value of INT is the place where MODULE appears in the list.")
(comment reformulateTemplateViaSpecification "A predicate that signals the reformulator to reformulate the output of a particular formula template via a particular specification. (#$reformulateTemplateViaSpecification
TEMPLATE SPEC) means the output of FormulaTemplate TEMPLATE should be reformulated according to the settings specified in #$ReformulationSpecification SPEC.")
(comment MetaPredicateRFParameter "A reformulator parameter that specifies the list of predicates, one of which must be wrapped around a reformulator rule for it to be used. Reformulator rules without one of these meta-predicates will not be used.  Only relevant to KB reformulator rules. To set this parameter, please use #$useMetaPredicateInReformulation.")
(comment ModePriorityRFParameter "A reformulator parameter that governs the prioritized list of modes to be used during reformulation. If no such list is provided, then the extent of #$defaultReformulatorModePrecedence is used to determine the default precedence of modes.")
(comment applyModuleFirstInReformulation "A predicate for enumerating instances of #$RLModule to applied recursively before other modules are tried, and the order in which they are to be applied. (#$applyModuleFirstInReformulation SPEC MODULE INT) means the reformulator should use module MODULE when invoked by SPEC. The value of MODULE is passed to the #$CycLReformulator parameter :apply-first-recursively as a list. The value of INT is the place where MODULE appears in the list.")
(comment SkippedSentencesRFParameter "A reformulator parameter that specifies which CycL sentences are not to be used during reformulation. A sentence identifies a reformulator rule in any Mt visible from the one of the current specification. To set this parameter, please use #$skipSentenceInReformulation.")
(comment RecursionRFParameter "A reformulator parameter that governs
recursion. #$RecursionRFParameter determines the maximum number of
times an expression will be recursively reformulated. If no recursion
limit is provided, then the (hard-coded) recursion limit (currently
212) is used as a default.")
(comment SubformulaRFParameter "A reformulator parameter that governs recursion. When #$SubformulaRFParameter is set to true, the input CycL expression and its subformulas are reformulated. When set to false, only the top level of the input CycL expression is reformulated.")
(comment RulesForRFParameter "A reformulator parameter that specifies which rules the reformulator should use for a particular reformulation. These rules must be passed to the parameter in the form of a list. To set this parameter, please use #$useRuleInReformulation.")
(comment UseKBRulesRFParameter "A reformulator parameter that specifies whether the reformulator rules cached out from the KB are used during reformulation. The default value is 'true.'")
(comment AllWFFCheckInReformulation "An instance of #$ReformulatorWFFEnforcementProperty. When the #$WFFEnforcementRFParameter of the #$CyclReformulator is set to #$AllWFFCheckInReformulation, full semantic wff-checking including arg-type constraints is performed.")
(comment ClearCachesRFParameter "A reformulator parameter that determines whether reformulator caches are cleared before reformulation begins. The default value is 'true,' which clears the cache. If set to 'false,' the caches are not cleared.")
(comment RLModuleApplyFirstRFParameter "A reformulator parameter that specifies a list of #$RLModules to apply recursively, before other RL modules are even tried on the input expression. No #$RLModule can occur in both the #$RLModuleIgnoreRFParameter and the #$RLModuleApplyFirstRFParameter for the same #$ReformulationSpecification.")
(comment ArityWFFCheckInReformulation "An instance of #$ReformulatorWFFEnforcementProperty. When the #$WFFEnforcementRFParameter of the #$CyclReformulator is set to #$ArityWFFCheckInReformulation, both the arg0 position and its arity are checked.")
(comment EliminateHistoryRFParameter "A reformulator parameter that determines whether intermediate reformulation steps are eliminated from the history of reformulations (and their justifications combined). The default value is 'true,' which eliminates the history. If set to 'false,' no such cleanup is done.")
(comment RLModuleIgnoreRFParameter "A reformulator parameter that specifies #$RLModules to ignore during reformulation. These modules must be passed to the parameter in the form of a list.")
(comment skipSentenceInReformulation "A predicate for enumerating sentences to be ignored by the reformulator in a particular specification. (#$skipSentenceInReformulation SPEC RULE INT) means the reformulator should ignore sentence RULE when invoked by SPEC. The value of RULE is passed to the #$CycLReformulator parameter :skip-sentences as a list. The value of INT is the place where RULE appears in the list.")
(comment SearchStrategyRFParameter "A reformulator parameter that specifies the kind of search strategy (if any) to be used during reformulation in case of ambiguity. Currently, only possible value is the default value :no-search.")
(comment glfNodeSemantics-Underspecified "A binary predicate, nodeSemantics-Underspecified attributes an underspecified interpretation to a node with respect to a graph.")
(disjointWith GLFArcType-HasBindings GLFArcType-LacksBindings)
(comment ObsoleteConstant "This is the collection of #$CycLConstants that have been, or are in the process of being deprecated and possibly replaced with new constants. See also #$replacementForObsoleteConstant.")
(comment UnitOfMeasure-Common "A specialization of #$UnitOfMeasure.  Essentially, this is just the union of #$InternationalUnitOfMeasure-Common and #$USUnitOfMeasure-Common (qq.v.).")
(comment assertionDerivedViaReformulation "(#$assertionDerivedViaReformulation ASST SENT SPEC) means that the #$CycLAssertion ASST was created by the #$CycLReformulator, using #$ELSentence-Assertible SENT as the input sentence and SPEC as the reformulation specification. Assertions on #$assertionDerivedViaReformulation will keep a record of the origins of reformulated assertions.")
(comment CycTaskSchedulerTaskFn "(#$CycTaskSchedulerTaskFn EVENT TASK-TYPE) denotes the instance of TASK-TYPE related to EVENT that will be managed by the #$CycTaskScheduler. The value of the #$taskSchedulerTaskDatePattern for the resulting task will be depend on knowledge of the #$dateOfEvent of EVENT.")
(comment assertionProducedByReformulation "A quaternary predicate, (#$assertionProducedByReformulation ASST TERM SENT SPEC) means that the #$CycLAssertion ASST about the term TERM was created by the #$CycLReformulator, using #$CycLSentence SENT as the input sentence and SPEC as the reformulation specification. Assertions on #$assertionProducedByReformulation will keep a record of the origins of reformulated assertions.")
(comment CycProgramFeature "#$CycProgramFeature is a specialization of #$SoftwareParameter.  Each instance of #$CycProgramFeature is a parameter used to specify to a #$LispReader precisely which code in the Cyc codebase to include in creating a Cyc executable.")
(comment CycKBFn "(#$CycKBFn POS-INT) denotes the instance of #$CycKB Cyc KB associated by convention with the Cycorp-internal KB number POS-INT.  For example, (#$CycKBFn 694) denotes the Cyc KB 694. Note that there can be many copies of one instance of #$CycKB (so there can be many copies of, e.g., (#$CycKBFn 694).")
(comment CycVersionWithFeatureSetSystemAndKBFn "(#$CycVersionWithFeatureSetSystemAndKBFn SET SYS-STRING KB) denotes the version of #$CycProgram created from all and only the #$CycProgramFeatures that are elements of SET in the Cyc system number STRING, with the instance of #$CycKB KB.  For example,
<p>
(#$CycVersionWithFeatureSetSystemAndKBFn
(#$TheSet #$Cyc-Time-CycProgramFeature #$Cyc-Date-CycProgramFeature)
\"1.3345\"
(#$CycKB 694))
<p>
denotes the Cyc program built with just #$Cyc-Time-CycProgramFeature and #$Cyc-Date-CycProgramFeature from Cyc system number 1.3345 and Cyc KB 694.")
(comment cycVersionWithFeatureSetSystemAndKB "(#$cycVersionWithFeatureSetSystemAndKB PROG SET SYS-STRING KB) means that PROG is the version of #$CycProgram created from all and only the #$CycProgramFeatures that are elements of SET in the Cyc system number STRING, with the instance of #$CycKB KB. Cf. #$CycVersionWithFeatureSetSystemAndKBFn.")
(comment termMentionedInProgram "(#$termMentionedInProgram TERM PROGRAM) means that the #$CycLIndexedTerm TERM is mentioned in the code of the  #$ComputerProgram-CW PROGRAM.  For example, (#$termMentionedInProgram  #$isa (#$CycVersionWithFeatureSetSystemAndKBFn (#$TheSet #$Cyc-Time-CycProgramFeature #$Cyc-Date-CycProgramFeature) \"1.3345\" (#$CycKB 694))) means that \"#$isa\" is mentioned in the Cyc program built with just #$Cyc-Time-CycProgramFeature and #$Cyc-Date-CycProgramFeature from Cyc systemn number 1.3345 and Cyc KB 694.  Note that the first argument of this predicate is \"quoted\"; thus it is the term itself in the first argument position that is mentioned in the code -- it is not the denotation of the term that is mentioned in the code.")
(comment Cyc-HTML-CycProgramFeature "#$Cyc-HTML-CycProgramFeature is the instance of #$CycProgramFeature 
associated with code that provides  HTML interface support.")
(comment Cyc-Date-CycProgramFeature "#$Cyc-Date-CycProgramFeature is the instance of #$CycProgramFeature 
associated with code that provides support for calendar date reasoning.")
(comment Cyc-Time-CycProgramFeature "#$Cyc-Time-CycProgramFeature is the instance of #$CycProgramFeature 
associated with code that provides support for temporal subsumption 
reasoning.")
(comment AttackingAnInstallationByIntentionalPlaneCrash "A specialization of #$AttackOnTangible.  This is the collection of all attacks in which an airplane is intentionally crashed in order to damage some ground installation.")
(comment StringBasedSearching "A specialization of #$ElectronicDataSearching. Instances of this collection are searches which attempt to identify relevant files (#$ComputerFile-AIS) through string-based search methods (matching, exclusion).")
(comment RequiredConceptsOfSearchStringFn "(#$RequiredConceptsOfSearchStringFn STRING) denotes a set of #$CycLReifiableDenotationalTerms which are referenced by the search string STRING, where STRING is the #$searchCriteriaSpecification for some implicit #$StringBasedSearching event (see also #$searchCriteriaSpecification). In particular, the list returned by this function will cover the required search terms of STRING.")
(comment ExcludedConceptsOfSearchStringFn "(#$ExcludedConceptsOfSearchStringFn STRING) denotes a set of #$CycLReifiableDenotationalTerms which are referenced by the search string STRING, where STRING is the #$searchCriteriaSpecification for some implicit #$StringBasedSearching event. In particular, the list returned by this function will cover the excluded search terms of STRING.")
(comment requiredConceptsOfSearchString "(#$requiredConceptsOfSearchString STRING SET) means SET denotes a SET of #$CycLReifiableDenotationalTerms which are referenced by STRING, where STRING is a potential #$searchCriteriaSpecification for some #$StringBasedSearching event. More specifically, the set returned will cover the required search terms in STRING.")
(comment excludedConceptsOfSearchString "(#$excludedConceptsOfSearchString STRING LIST) means LIST denotes a list of #$CycLReifiableDenotatinoalTerms which are referenced by STRING, where STRING is the #$searchCriteriaSpecification for some #$StringBasedSearching event.More specifically, the list returned will cover the excluded search terms in STRING.")
(comment GerundiveCountNoun "The collection of all gerunds, that is, deverbal nouns formed (in English) with the suffix '-ing', that have count-noun agreement and usually denote an instance of the type of action denoted by the verb from which they are derived.")
(disjointWith CompletedStatus ScheduledStatus)
(disjointWith CancelledStatus ScheduledStatus)
(disjointWith ExecutingStatus ScheduledStatus)
(comment objectFrontSide "(#$objectFrontSide OBJECT FRONTSIDE) means that FRONTSIDE is
the entire front surface part of OBJECT. See also
#$FrontAndBackSidedObject and #$FrontSide.")
(comment SQLBoolean "The datatype corresponding to SQL boolean.")
(comment bedToPersonRatio "(#$bedToPersonRatio REGION RATIO) means that the ratio of
#$HospitalBeds to #$Persons in REGION is RATIO.")
(comment regionTotalZoonoticHostCount "(#$regionTotalZoonoticHostCount REGION AGENT-TYPE NUM) means
that there are NUM zoonotic hosts in REGION capable of contracting and
transmitting AGENT-TYPE.")
(comment regionTotalHospitalBedCount "(#$regionTotalHospitalBedCount REGION NUM) means that there
are NUM #$HospitalBeds in REGION.")
(comment invulnerableToType "(#$invulnerableToType THREAT-OBJ-TYPE OBJECT HARM-TYPE)
means that instances of the collection THREAT-OBJ-TYPE generally do
not pose a danger of type HARM-TYPE to OBJECT. This predicate is
defined to be the #$negationPreds of #$vulnerableToType.")
(comment vulnerableToType-Truth "(#$vulnerableToType-Truth THREAT-OBJ-TYPE OBJECT HARM-TYPE
TRUTH-VALUE) is used to state which of the two vulnerability
predicates, #$vulnerableToType or #$invulnerableToType holds for
(THREAT-OBJ-TYPE OBJECT HARM-TYPE). Specifically, TRUTH-VALUE is
#$True iff (#$vulnerableToType THREAT-OBJ-TYPE OBJECT HARM-TYPE) and
conversely TRUTH-VALUE is #$False iff (#$invulnerableToType
THREAT-OBJ-TYPE OBJECT HARM-TYPE).")
(comment objectBackSide "(#$objectBackSide OBJECT BACKSIDE) means that BACKSIDE is the
entire back part of OBJECT. See also #$FrontAndBackSidedObject and
#$BackSide.")
(comment computerProcessID "(#$computerProcessID COMP PROC ID) means that #$ComputerProcessRunning PROC is running on #$Computer COMP with #$IDString ID.")
(comment ComputerProcessIDFn "(#$ComputerProcessIDFn COMP ID) denotes the instance of #$ComputerProcessRunning on COMP which has been assigned the process id number ID by the operating system on COMP.")
(comment processID "(#$processID PROC ID) means that #$ComputerProcessRunning PROC is assigned #$IDString ID by the operating system of the computer on which it is running.  Relative to a computer, such a process ID is a unique identifier for a process. Cf. #$ComputerProcessIDFn and #$computerProcessID.")
(comment quantityConstraint "A quaternary predicate that is used to put a constraint on the size of #$Quantity that a given #$QuantitySlot can relate a given thing to.  <code>(#$quantityConstraint SLOT THING COMPARE LIMIT)</code> means that for any quantity <code>QUANT</code> such that <code>(SLOT THING QUANT)</code> is true, the comparison constraint <code>(COMPARE QUANT LIMIT)</code> must hold.
<p>
For example,
<p>
    <code>(#$quantityConstraint #$heightOfObject #$EiffelTower #$greaterThan (#$Meter 200))</code>
<p>
means that the height of the Eiffel Tower is more than 200 meters.")
(comment recommendedRoleInType "An instance of #$TernaryPredicate.  #$recommendedRoleInType relates an instance of #$SomethingExisting, a specialization of #$Situation, and an instance of #$BinaryRolePredicate, so as to express the recommendation that the arg1 play that role in an event of that type.  For example, (#$recommendedRoleInType Person001 #$CharitableDonation #$giver) says that it is recommended that Person001 make a donation to some charity.  The source of the recommendation (the agent, conceptual work, moral code, etc.) is unspecified with this predicate; accordingly, assertions should be made in a #$Microtheory (such as the #$PITOfIBTFn Mt for a work that contains recommendations) that can reflect the source.")
(disjointWith DryPetFood WetPetFood)
(comment intendedForConsumptionByType "An instance of #$BinaryPredicate, a specialization of #$intendedForUseBy.  (#$intendedForConsumptionByType EDIBLE ORGANISM-TYPE) says that the instance of #$EdibleStuff and #$Artifact EDIBLE is intended for consumption by instances of ORGANISM-TYPE, a specialization of #$BiologicalLivingObject.")
(comment connectingTerms "A declarative hook into a graphical model information extraction tool developed by #$Mahler. Given two strings such as 'Kennedy' and 'Cuba', a query with this predicate will return as bindings for the third argument a set of strings such as 'missiles' 'Soviet Union' which in some sense account for the
relationship between the two arguments as it can be gleaned from the textual
corpus targeted by this predicate")
(comment GovernmentReport-CW "The collection of all instances of
#$WrittenReportOnSituation-CW issued by a government agency or body,
either for consumption by another government body, or to the public, or
both.")
(comment MusicalComposition-JazzRock "The collection of instances of #$MusicalComposition that are in the jazz-rock style or genre.")
(comment LivestockType "A specialization of #$DomesticatedAnimalType.  Instances of
this colleciton are collections of #$DomesticatedAnimal kept and/or
bred by humans as #$Livestock.")
(comment tacticalAreaBoundary "(#$tacticalAreaBoundary TACTICALAREA BOUNDARY) means that the
instance of #$TacticalArea TACTICALAREA has a boundary defined by BOUNDARY
an instance of #$GeographicalRegion.  These types of regions are
delineated by lines such that, as much as possible, objects are either
clearly inside or outside the boundary area.  Whenever possible,
visible features of the landscape, natural or otherwise, are
incorporated into the boundary.")
(comment tacticalAreaFrontBoundary "(#$tacticalAreaFrontBoundary AREA BOUNDARY) means that the
instance of #$TacticalArea AREA has a front boundary defined by
BOUNDARY, an instance of #$GeographicalRegion.")
(comment tacticalAreaRearBoundary "(#$tacticalAreaRearBoundary AREA BOUNDARY) means that the
instance of #$TacticalArea AREA has BOUNDARY, an instance of
#$GeographicalRegion, as its rear boundary.")
(comment tacticalAreaLateralBoundary "(#$tacticalAreaLateralBoundary TACTICALAREA BOUNDARY) means that
BOUNDARY, an instance of #$GeographicalRegion, is considered one of
the lateral boundaries of the instance of #$TacticalArea TACTICALAREA.")
(comment tacticalAreaRightLateralBoundary "(#$tacticalAreaRightLateralBoundary TACTICALAREA RIGHT-BOUNDARY)
means that RIGHT-BOUNDARY, an instance of #$GeographicalRegion, is the
right boundary, for the instance of #$TacticalArea TACTICALAREA. That
is, here the right side is determined from inside TACTICALAREA facing
the front.")
(comment tacticalAreaLeftLateralBoundary "(#$tacticalAreaLeftLateralBoundary AO LEFT-BOUINDARY)
relates an instance of #$TacticalArea, TACTICALAREA, to the instance of
#$GeographicalRegion that makes up its left lateral boundary.")
(comment schemaRepresentationComplete "(#$schemaRepresentationComplete SCHEMA) means that the KB representation of the physical/logical schema SCHEMA is complete, meaning that all necessary information required to register the SKSI removal modules for a knowledge source using this schema has been asserted in the KB. The extent of this predicate is used by #$afterAddings/#$afterRemovings designed to update the cost estimate information in the KB in case of modifications to the representations of existing (known to be complete) schemata.")
(comment GISProgram "A specialization of #$ApplicationProgram. Each instance of this collection is an
instance of #$ComputerProgram-CW which has something (where this is deliberately left vague) to do with geographic information systems.  An important specialization of #$GISProgram is GISServerProgram")
(comment GISServerProgram "Programs which serve geographic information to client programs.")
(comment GISData-AIS "A specialization of #$ComputerFile-AIS and #$StructuredKnowledgeSource.  Each instance of #$GISData-AIS is an abstraction of an encoding of information in a format readable by some
GIS software program (see #$GISProgram).  Not every GIS software program supports all formats, although almost every GIS has its own internal file format.  #$GISVectorFormatData-AIS and
#$GISRasterFormatData-AIS (qq.v) are the main specializations.")
(comment GISVectorFormatData-AIS "A specialization of #$GISData-AIS.  Each instance of #$GISVectorFormatData-AIS is an abstraction of an encoding of information in a vector format.")
(comment GISRasterFormatData-AIS "A specialization of #$GISData-AIS.  Each instance of #$GISVectorFormatData-AIS is an abstraction of an encoding of information in a raster format.")
(comment gisProgramForSKS "This predicate relates a structured GIS knowledge source to the #$GISProgram used for accessing it. For example, (#$gisProgramForSKS #$Cycorp-ArcMap-GIS-KS (#$SoftwareVersionFn #$ArcMap \"8.3\")) means that #$Cycorp-ArcMap-GIS-KS is accessed by ArcMap version 8.3.")
(comment PoliceTruck "A specialization of #$Truck and #$EmergencyVehicle.  Each instance of this collection is a truck designed to be used by #$LawEnforcementOfficers.  ")
(comment Marketplace-Object "A specialization of #$ShoppingCenter-Object.  Instance of
this collection are places, typically outside, where vendors sell
goods to the public.")
(comment PoliceFacility "A specialization of #$Facility-Construct.  Instances of this collection are those facilities, buildings or otherwise. utilized by #$LawEnforcementOfficers.  This may include instances of training courses that may not have much in the way of actual constructions. Notable specializations include #$PoliceBarrack and #$PoliceStation.")
(comment PacketScanningAComputationalSystem "A specialization of #$ProgramAction. #$PacketScanningAComputationalSystem is the collection of all scans on computers or computer networks.  Important specializations include #$IPDiscoveryScan, #$PortScan, and #$BannerScan.")
(comment TourBus "A specialization of #$Bus-RoadVehicle.  Each instance of
this collection is a bus designed to carry tourists between sites or
cities.  This collection is confined to tourists and not the 'tour
buses' musicians use on their tours, which can be customized.")
(comment AttackByComputerOperation-Staged "#$AttackByComputerOperation-Staged is a specialization of #$AttackByComputerOperation and an instance of #$ScriptedEventType.   Each instance of #$AttackByComputerOperation-Staged is a complex  event which procedes in four stages.  First, the attacker scans  the target range of addresses.  Second, the attacker scans active  IP addresses to find open ports on them.  Third, the attacker  launches a banner scan to on the open ports to ascertain what  specific services are running on the open ports.  Finally,  the attacker runs an exploit on the faulty services identified  by the banner scan.  Instances of #$AttackByComputerOperation-Staged  are often preceded by a domain search query to determine which  range of IP addresses correspond to a particular domain name.  For collections representing the various stages of this sort of attack,  see #$ProbingAComputerNetwork (with its sub-event types #$IPDiscoveryScan, #$PortScan, and #$BannerScan) and #$PlacementOfMaliciousProgram.")
(comment BannerScan "A specialization of #$PacketScanningAComputationalSystem.  Each instance of #$BannerScan is a scan of a computational system performed with the intent of determining which particular processes are running by examining the banners they produce when prompted.")
(comment IPDiscoveryScan "A specialization of #$PacketScanningAComputationalSystem.  Each instance of #$IPDiscoveryScan is a scan of a computational system performed with the goal of determining whether or not certain IP addresses are active.  Typically, a #$PingCommandProgram is used.")
(comment skolem "An #$InferenceRelatedBookkeepingPredicate (q.v.) that appears in system-generated assertions.  #$skolem holds of all instances of #$SkolemFunction, and exists solely for internal bookkeeping purposes.  The set of supports for a #$skolem assertion of the form (#$skolem FUNCTOR) is the set of defining assertions of FUNCTOR.")
(comment propertyPredicatesPredicateOfArg "(propertyPredicatesPredicateOfArg PROPERTY PREDICATE ARGNUM) means that if PROPERTY holds of a term TERM, then PREDICATE holds of some set of arguments of which TERM is the ARGNUMth.")
(comment predicatesPropertyTypeOfArg "(#$predicatesPropertyTypeOfArg PREDICATE ARGNUM TYPE) means that any assertion where PREDICATE is the predicate predicates a TYPE type of property of its ARGNUMth argument.")
(comment collectionRepresentsPropertyType "(#$collectionRepresentsPropertyType COLLECTION TYPE) means that any assertion of the form (#$isa TERM TYPE) predicates a TYPE type of property of TERM.")
(comment predicatesPropertyTypeOfArg1 "(#$predicatesPropertyTypeOfArg1 PREDICATE TYPE) means that any assertion where PREDICATE is the predicate predicates a TYPE type of property of its first argument.")
(comment owlDefiningOntologyURI "A predicate relating an imported #$OWL-WebOntologyLanguage concept with its defining ontology URI.")
(comment owlURI "A predicate relating an imported #$OWL-WebOntologyLanguage concept with its source #$UniformResourceIdentifier.")
(comment ist-Intermediate "This is a predicate that allows the fact entry tool to make assertions with temporal qualification, and then find them later. Currently, assertions in a #$PolyadicMicrotheory are incompatible with the FET's Find feature. Therefore, the FET will assert on #$ist-Intermediate and reformulate into #$ist.")
(comment Cash "A specialization of #$Currency (q.v.).  Each instance of #$Cash is either a coin (see #$Coin-Currency) or piece of paper money (see #$Bill-Currency).  Instances of #$Cash are typically issued and backed by national governments.")
(comment NewsMagazineSeries "The collection of all #$MagazineSeries which have signficant #$News content.  The main purpose of such magazines is to convey information about current events, primarily (though not exclusively) in a relatively objective, non-partisan style.  This distinguishes these magazines from magazines such as #$TheNation-TheMagazine and #$NationalReview-TheMagazine, which offer an openly partisan perspective on current events.  Instances of #$NewsMagazineSeries include #$Newsweek-TheMagazine, #$Time-TheMagazine, and #$USNewsAndWorldReport-TheMagazine.")
(comment superTemporalCollection "This predicate is a specialization of #$genls.  (#$superTemporalCollection COLL-SPEC COLL-SUPER) holds just in case COLL-SUPER is the collection of all the instances of COLL-SPEC there are, ever were, or will be.  This is the #$functionCorrespondingPredicate-Canonical to #$SometimesFn.")
(comment backwardsCompatibleOntology "The binary predicate (backwardsCompatibleOntology ONTOLOGY-1 ONTOLOGY-2) means that ONTOLOGY-1 is backwards compatible with ONTOLOGY-2.")
(comment TypographicalStructure "A specialization of both #$AbstractInformationStructure and #$GraphicalStructure (qq.v.).  Each instance of #$TypographicalStructure is an abstract structure comprising abstract typographic symbols (e.g. #$Character-Abstracts), as well as conventionally meaningful features of and typographical relations between them.  An important specialization of #$TypographicalStructure is #$CharacterString.  A typographical structure might also include details regarding the style or appearance of characters, when that can affect meaning (see e.g. #$ItalicizedFormat).  Also see the comment on #$AbstractInformationStructure.")
(disjointWith CalendarMilliSecond PolarDay)
(disjointWith CalendarMilliSecond PolarNight)
(disjointWith CalendarMilliSecond TimePoint)
(disjointWith CalendarMilliSecond CalendarWeekend)
(disjointWith CalendarMilliSecond FiscalYear)
(comment CalendarMilliSecond "A subcollection of #$Date (q.v.) and an instance of #$CalendarCoveringType (q.v.). #$CalendarMilliSecond is the collection of milliseconds that make up the calendar.  Each #$CalendarSecond (q.v.) is divided into one thousand contiguous #$CalendarMilliSeconds. Note that (as with any instance of an instance of calendar-covering-type) a given instance of #$CalendarMilliSecond is a temporally continuous individual that occurs only _once_.")
(comment MilliSecondFn "An instance of #$DateDenotingFunction.  When applied to an integer in the range 0 through 999 and an instance of #$CalendarSecond, #$MilliSecondFn returns an instance of #$CalendarMilliSecond.  (#$MilliSecondFn S SECOND) denotes millisecond number S of SECOND.  For example, (#$MilliSecondFn 34 (#$SecondFn 59 (#$MinuteFn 12 (#$HourFn 18 (#$DayFn 14 (#$MonthFn #$February (#$YearFn 1966)))))) denotes 6:12:59.034pm Feb. 14th, 1966.")
(comment incompatibleOntology "(incompatibleOntology ONTOLOGY-1 ONTOLOGY-2) means that ONTOLOGY-1 is not compatible with the classes and properties defined in ONTOLOGY-2 (e.g. inconsistent inference).")
(comment ontologyPriorVersion "(ontologyPriorVersion ONTOLOGY-1 ONTOLOGY-2) means that ONTOLOGY-1 has ONTOLOGY-2 as a prior version.")
(comment ontologyVersionInfo "(owlVersionInfo ONTOLOGY STRING) means that ONTOLOGY has some version information contained in STRING.")
(comment indexicalForLogicalField "(#$indexicalForLogicalField FIELD INDEXICAL) states that
INDEXICAL is the associated indexical term used to denote values for
the logical field, FIELD.")
(comment logicalFieldIndexicals "(#$logicalFieldIndexicals LS LFI) means that LFI is an
indexical concept used to denote the logical value of a (logical)
field in the (logical) schema, LS.")
(comment indexicalForField "(#$indexicalForField FIELD INDEXICAL) means that INDEXICAL
is an indexical concept used to denote the value of (the logical or
physical) FIELD in some (logical or physical) schema. Usually, this
predicate is not asserted directly, but by asserting one of its two
mutually disjoint and exhaustive typed spec preds,
#$indexicalForLogicalField and #$indexicalForPhysicalField.")
(comment schemaFieldIndexicals "(#$schemaFieldIndexicals SCHEMA INDEXICAL) means that INDEXICAL is
an indexical used to denote the value of some (logical or physical)
field in the (logical or physical) schema SCHEMA. Usually, this
predicate is not asserted directly, but by asserting one of its two mutally
disjoint and exhaustive typed spec preds, #$logicalFieldIndexicals and
#$physicalFieldIndexicals.")
(comment indexName "(#$indexName INDEX STRING) means that STRING is the name string of INDEX.")
(comment Taxpayer "A specialization of #$LegalAgent.  Each instance of #$Taxpayer is an agent who pays federal, state, or local taxes (not including sales tax).")
(comment programIndexTypeNameString "This predicate relates a #$DatabaseServerProgram and a
#$IndexDataStructureType to the string name of the index type used in
the DBMS. For instance, (#$programIndexTypeNameString #$PostgreSQL
#$HashTable-DataStructure 'hash') means that in #$PostgreSQL's
implementation of the #$SQL-Language, the #$HashTable-DataStructure is
called 'hash'.")
(comment assertedTermSetSentences "(#$assertedTermSetSentences SET-OF-TERMS SENTENCE) means that SENTENCE has been asserted to the Cyc Knowledge Base (and is thus a  #$CycLAssertion) and that each of the #$CycLTerms in SET-OF-TERMS is mentioned in SENTENCE.  More precisely, and assuming the #$assertedTermSetSentences formula contains no free variables (and 
is thus a \"ground atomic formula\" or \"GAF\"): each of the CycL terms in the set which immediately follows the constant `#$assertedTermSentences' in the formula occurs in SENTENCE.  For example, (#$assertedTermSetSentences (#$TheSet #$France #$Germany) (#$bordersOn #$France #$Germany)) holds.  See also #$assertedTermSentences, #$assertedSentence and #$assertedPredicateArg for related predicates about assertions.")
(comment foreignKeyMap-SetNull "This specialization of #$foreignKeyMap entails an additional
constraint on deleting or modifying the rows of the
referenced schema. That is (#$foreignKeyMap-SetNull REFERENCED_SCHEMA
REFERENCED_KEY REFERENCING_SCHEMA REFERENCING_FIELD_LIST) means in
addition to the constraints inherited from #$foreignKeyMap, on deleting a
row of REFERENCED_SCHEMA with a row of
REFERENCING_SCHEMA that references it, the referencing fields in REFERENCING_SCHEMA are set to null. Contrast this behavior with
#$foreignKeyMap-Cascade, #$foreignKeyMap-Restrict, and #$foreignKeyMap-SetDefault.")
(comment foreignKeyMap-SetDefault "This specialization of #$foreignKeyMap entails an additional
constraint on deleting or modifying the rows of the
referenced schema. That is (#$foreignKeyMap-SetDefault REFERENCED_SCHEMA
REFERENCED_KEY REFERENCING_SCHEMA REFERENCING_FIELD_LIST) means in
addition to the constraints inherited from #$foreignKeyMap, on deleting a
row of REFERENCED_SCHEMA with a row of
REFERENCING_SCHEMA that references it, the referencing fields in REFERENCING_SCHEMA are set to their default values. Contrast this behavior with
#$foreignKeyMap-Cascade, #$foreignKeyMap-Restrict, and #$foreignKeyMap-SetNull.")
(disjointWith JustificationStrength ObjectTypeByIntrinsicState)
(comment SummaryPredicate "A specialization of #$Predicate.  Instances of this collection are predicates used to summarize information about a particular concept or between concepts.")
(comment summaryPredicateWRTSetOrCollection "(#$summaryPredicateWRTSetOrCollection SET-OR-COLLECTION PREDICATE) relates an instance of #$SetOrCollection SET-OR-COLLECTION to a #$Predicate PREDICATE that may be useful for summarizing information on instances of SET-OR-COLLECTION.  Thus (#$summaryPredicateWRTSetOrCollection #$BaseballPlayer battingAverage) means that when asked to summarize information on an instance of #$BaseballPlayer, battingAverage is useful information to return.")
(comment summaryForThingQua "An instance of #$SummaryPredicate.  (#$summaryForThingQua THING SET-OR-COLLECTION SENTENCE) means that the #$CycLAssertion SENTENCE contains interesting or relevant information about THING with respect to THING's involvement in or with SET-OR-COLLECTION.")
(comment schemaFieldList "This predicate relates a physical schema with a list of all its physical fields. See the #$salientAssertions for the defining rule.")
(comment PropertyTypeOwnedByFn "(#$PropertyTypeOwnedByFn OBJECT-TYPE AGENT) denotes the
collection of OBJECT-TYPE owned by AGENT, an instance of
#$Agent-Generic.  This function may be used to denote the collection
of shoes owned by Emelda Marcos or the collection of buses owned by
Capital Metro.")
(comment ScheduledAction "A specialization of #$PurposefulAction.  Each instance of #$ScheduledAction is an event that is intended by some agent to occur at a certain (at least vaguely specified) time.  For example, #$OlympicGames is a specialization of #$ScheduledAction because a necessary condition for the occurrence of an instance of #$OlympicGames is that it be scheduled to occur.  For a general script that encompasses waiting for the time of a scheduled event and its performance, see #$PerformingAScheduledAction.")
(comment WaitingForTemporalThingOfTypeFn "<code>(#$WaitingForTemporalThingOfTypeFn TEMP-THING-TYPE)</code> denotes a specialization of #$Waiting whose instances are events in which an agent waits for an some instance of <code>TEMP-THING-TYPE</code> to occur (where <code>TEMP-THING-TYPE</code> is a specialization of #$TemporalThing).")
(comment waitTypeIsForInstanceOfType "<code>(#$waitTypeIsForInstanceOfType WAIT-TYPE TEMP-THING-TYPE)</code> means that every instance of <code>WAIT-TYPE</code> (a specialization of #$Waiting), is an event in which some agent waits for some instance of <code>TEMP-THING-TYPE</code> (a specialization of #$TemporalThing) to occur.  For example, (#$waitTypeIsForInstanceOfType #$WaitingForABus (#$SubcollectionOfWithRelationToTypeFn #$ArrivingAtAPlace #$transporter #$Bus-RoadVehicle)) means that in each instance of #$WaitingForABus, some agent is waiting for the arrival of a bus.")
(comment PerformingAScheduledAction "#$PerformingAScheduledAction is a specialization of #$PurposefulAction.  Each instance of #$PerformingAScheduledAction is an acton done purposefully that has two parts: a waiting until the time of the scheduled action (see #$Waiting), and a doing of the scheduled action itself (see #$ScheduledAction).")
(comment ScheduledFn "(#$ScheduledFn EVENT-TYPE) denotes the collection of #$ScheduledActions that are scheduled instances of the specialization of #$Event, EVENT-TYPE.")
(disjointWith TimeInterval TemporallyExistingThing)
(comment endsNoLaterThanEndingOf "(#$endsNoLaterThanEndingOf TEMPTHING1 TEMPTHING2) means that TEMPTHING1 stops existing or occurring either at the same time as, or before, TEMPTHING2 stops existing or occurring.  That is, (#$endsNoLaterThanEndingOf TEMPTHING1 TEMPTHING2) means that either (#$temporallyCoterminal TEMPTHING1 TEMPTHING2) or (#$endsAfterEndingOf TEMPTHING2 TEMPTHING1).")
(comment ScriptExecutionContext "A specialization of #$Microtheory.  Each instance of #$ScriptExecutionContext is a microtheory in which data is stored about the instance-level role-players in any given script execution, along with the resources they have available to them to execute the script.")
(comment URIFn "An instance of both IndividualDenotingFunction and ReifiableFunction. Given a URI string as its single argument, URLFn returns the corresponding instance of #$UniformResourceIdentifier.")
(comment OWLClassFn "An instance of both CollectionDenotingFunction and ReifiableFunction. Given a #$OWL-WebOntologyLanguage class-denoting #$UniformResourceIdentifier as its single argument, OWLClassFn returns the corresponding collection term.  See also #$OWLIndividualFn and #$OWLPropertyFn.")
(comment OWLPropertyFn "An instance of both PredicateDenotingFunction and ReifiableFunction. Given a #$OWL-WebOntologyLanguage property-denoting #$UniformResourceIdentifier as its single argument, OWLPropertyFn returns the corresponding binary predicate term.  See also #$OWLClassFn and #$OWLIndividualFn.")
(comment ConstantNamedFn "An instance of both #$UnaryFunction and #$EvaluatableFunction.  When applied to an instance NAME of #$SubLString, #$ConstantNamedFn returns the instance of #$CycLConstant whose #$constantName is NAME.  For example, (#$ConstantNamedFn 'Thing') returns the constant #$Thing.")
(comment eMailMessageHasText "(#$eMailMessageHasText MESSAGE TEXT) means that TEXT is the authored textual part of the #$EMailMessage MESSAGE.")
(comment logicalSchemaFieldTypeList "This predicate is the analogue of
#$schemaFieldNameList and is used to automatically generate
the NATs that denote the logical fields and logical field value
indexicals for a logical schema. The list of collections determines
the semantic type of the logical fields and forward rules ensure that
this data is propagated onto the denotational terms.")
(comment TheLogicalFieldValueFn "(#$TheLogicalFieldValueFn SCHEMA TYPE ID-ATOM) denotes an
indexical referent in SCHEMA to some instance of TYPE. ID_ATOM is used
to distinguish between two distinct values corresponding to logical
fields defined in the same SCHEMA and with the same TYPE. Such terms
are used in relation to their phsical field value equivalents (denoted
by #$ThePhysicalFieldValueFn).")
(comment LogicalFieldFn "(#$LogicalFieldFn SCHEMA TYPE ID-ATOM) denotes a logical
field in SCHEMA that takes on values of TYPE. ID_ATOM is used to
distinguish between two distinct logical fields defined in the same
SCHEMA and with the same TYPE. See also the physical equivalent
#$PhysicalFieldFn.")
(comment salientURI "(#$salientURI THING URI) means that the information identified by the #$UniformResourceIdentifier URI, is salient to #$Thing.  See also #$salientURL.")
(comment programDataTypeIdentifier "Relates a computer program and a data type to the identifier of that data type in that program. You should almost certainly use one of the typed spec preds, #$programDataTypeNumericIdentifier or #$programDataTypeNameString")
(comment programDataTypeNumericIdentifier "Relates a computer program and a data type to the numeric identifier of that data type in that program.")
(comment ComplexTemporalPredicate-BasePartition "A specialization of #$ComplexTemporalPredicate (q.v.) whose instances form a partition, in the sense of #$partitionedIntoSpecPreds, of #$temporallyRelated over the domain of #$TemporalThings. This means that any two instances A and B of #$TemporalThing that are #$temporallyRelated stand in exactly one of the temporal relations in #$ComplexTemporalPredicate-BasePartition.")
(comment eventTypeImplementedByProgramFunction "(#$eventTypeImplementedByProgramFunction EVT-TYPE FUNC) means that the instance of #$ProgramFunction FUNC can be called to bring about an instance of the specialization of #$Event, EVT-TYPE.")
(comment subSituationTypeIteratesEventTypeOverSetWRTSlot "(#$subSituationTypeIteratesEventTypeOverSetWRTSlot SITTYPE SUBSITTYPE SUB-EVENT-TYPE SET SLOT) means that in every instance of SITTYPE each instance INST of SUBSITTYPE consists of one instance of SUB-EVENT-TYPE for each thing THING such that (#$elementOf THING SET). Also, each element of SET is related by SLOT via an assertion of the form (SLOT SUB-EVENT THING) to exactly one instance SUB-EVENT of SUB-EVENT-TYPE that is a sub-event of INST.  Cf. #$situationTypeIsIteratedSubSituationType-OverSet.")
(comment rolesMapToProgramFunctionArgs "(#$rolesMapToProgramFunctionArgs EVENT-TYPE SLOT PROG-FUNCTION NUM) means that in order to bring about an instance of EVENT-TYPE via the #$ProgramFunction PROG-FUNCTION, the arg2 value of the appropriate assertion using SLOT must occur as the NUM argument to PROG-FUNCTION.  For example, (#$rolesMapToProgramFunctionArgs  #$SingleEMailSending #$eMailSendingTextSlot (#$ProgramFunctionFn \"mail-message\" (#$CycorpSysdclFileFn \"mail-utilities.lisp\")) 3) means that to bring about an instance INST of #$SingleEMailSending, if (#$eMailSendingTextSlot INST TEXT) holds, then TEXT must be passed to argument 3 of the function mail-message defined in the mail-utilities.lisp file of the Cycorp sysdcl.")
(comment eMailSendingTextSlot "(#$eMailSendingTextSlot SEND TEXT) means that in the #$SingleEMailSending SEND, the #$EMailMessage sent has the #$EMailMessageText TEXT. Cf. #$eMailMessageHasText.")
(comment eMailSendingDestinationAddressSlot "(#$eMailSendingDestinationAddressSlot SEND ADDR) means that in the #$EMailSending SEND, the #$EMailMessage sent has the #$EMailAddress ADDR as the destination address. Cf. #$eMailDestinationAddress.")
(comment eMailSendingSourceAddressSlot "(#$eMailSendingSourceAddressSlot SEND ADDR) means that in the #$SingleEMailSending SEND, the #$EMailMessage sent has the #$EMailAddress ADDR as the source address. Cf. #$eMailSourceAddress.")
(comment eMailSendingSubjectHeadingTextSlot "(#$eMailSendingSubjectHeadingTextSlot SEND STRING) means that in the #$SingleEMailSending SEND, the #$EMailMessage sent has the #$CharacterString STRING as the subject heading text. Cf. #$eMailSubjectHeadingText.")
(comment UIFactEditorInput "Instances of UIFactEditorInput are Factivore editors within a user interface that allow the user to specify, edit, or view assertions.")
(comment EMailPredicate "The collection of predicates used to describe email messages, communications, sendings, and receivings.")
(comment scheduledActionTypeIsOfEventType "(#$scheduledActionTypeIsOfEventType ACTION-TYPE EVENT-TYPE) means that each instance of ACTION is a scheduled instance of EVENT-TYPE, where ACTION-TYPE is a specialization of #$ScheduledAction and EVENT-TYPE is a specialization of #$Event.")
(comment ProgramFunctionPredicate "#$ProgramFunctionPredicate is an instance of #$PredicateTypeByTopic.  It is the collection of predicates that state of some named program subroutine (some #$ProgramFunction) what properties it has.")
(comment ElectronicComponentTypeByBrand "A specialization of #$ProductTypeByBrand and #$ExistingObjectType. Each instance of this (second-order) collection is a spec of #$ElectronicComponent and a type of brand-name component (for example, #$AtmelElectronicComponent).")
(comment ElectronicComponentTypeByFunction "A specialization of #$ExistingObjectType. Each instance of this (second-order) collection is a spec of #$ElectronicComponent differentiated only by its intended function (for example, #$Capacitor).")
(comment IterationTerminationSituationTypePredicate "This is the collection of predicates which express conditions for iterating a scene in a script.")
(comment Bet "A specialization of #$Agreement.  Each instance of #$Bet is an agreement in which the parties to the agreement stake something valuable (often money) on the outcome of some event.")
(comment ExistentialQuantifier-Bounded "A specialization of #$ExistentialQuantifier (q.v.).  Each instance of #$ExistentialQuantifier-Bounded is a ternary relation that can be used to make a certain kind of statement about the existence of a given bounded quantity of things meeting a given criterion.  For example, '(#$thereExistAtLeast 9 ?X (#$isa ?X #$Cat))' means that there exist at least nine cats.  What distinguishes _bounded_ existential quantifiers from existential quantifiers generally is that the former require one to specify explicitly (at least a boundary for) how many things exist that meet the specified criterion.")
(comment SingleEMailSending "A specialization of #$EMailSending. Each instance of this collection is an event in which somebody or something sends exactly one copy of an #$EMailMessage to one or more #$EMailAddresses. Cf. #$EMailCommunication.")
(disjointWith SingleEMailSending MassEMailSending)
(comment defaultSKSForDatabaseServerProgram "This predicate relates a given #$SKSISupportedDatabaseServerProgram to the default database for SKSI's installation of that program at Cycorp. The SKSI code connects to these default databases in order to create new databases.")
(comment suppressReplacementForPosition "(#$suppressReplacementForPosition TEMPLATE POS SET-OR-COLLECTION) means that for formula template TEMPLATE, the replacement options generated for arg position POS of the formula should exclude any member of SET-OR-COLLECTION. It also means that (#$positionInFormulaTemplateIsReplaceable TEMPLATE POS). See also #$candidateReplacementForPosition.")
(comment inferenceQuerySpecification "(#$inferenceQuerySpecification INF SPEC) means that SPEC is the #$CycLQuerySpecification for the inference process denoted by INF.")
(comment eventProgramFunctionArgs "(#$eventProgramFunctionArgs EVENT VALUE FUNC NUM) means that to perform
EVENT by calling FUNC, VALUE should be the NUMth argument to FUNC.")
(comment rolePlayerValuesMapToProgramFunctionArgs "(#$rolePlayerValuesMapToProgramFunctionArgs EVENT-TYPE ROLE SLOT FUNC NUM) means that the for FUNC to implement an instance EVENT of EVENT-TYPE it will take as its NUMth argument the arg2 value of SLOT asserted of the role-player RP of which it is true that (ROLE EVENT RP).")
(comment MuslimOrganization "The collection of all explicitly Muslim organizations")
(comment Imam-Shiite "In #$ShiiteIslam, '#$Imam-Shiite' is meant to denote #$MuhammadTheProphet's 
descendents, whom they believe to be the true rulers of #$Islam. The #$Imam-Shiite is 
supposed to provide guidance to the human race in both religious and secular
issues. There can only be one #$Imam-Shiite at a time, but #$ShiiteIslam has not had
an #$Imam-Shiite since around 941AD. The last #$Imam-Shiite, Muhammad al Mahdi, has
taken on a messianic role in #$ShiiteIslam.")
(comment CatholicOrganization "The collection of all explicitly Catholic religious organizations")
(comment PrisonGang "The collection of all #$Gangs that operate in #$Prisons. The
activities of a #$PrisonGang are not necessarily confined to a #$Prison,
but members on the outside can be assumed to have been incarcerated with
those still in #$Prison.")
(comment ProselytizingActivity "A specialization of #$RecruitingActivity, in which an #$IntelligentAgent attempts to persuade one or more #$IntelligentAgents to hold a particular belief. Distinguished from #$MarketingActivity in that the actor also believes in the ideology being proselytized. #$ProselytizingActivity is often intended to  persuade the recruitee to join a particular #$ReligiousOrganization, but the primary focus is on spreading a #$BeliefSystem.")
(comment Missionary "Members of a given religious group who seek to convert others to 
their religious beliefs. Frequently involved in humanitarian work in poor
countries.")
(comment NonMilitaryWeapon "The collection of all #$Weapons that are not typically
used by military organizations. This includes common weapons used in
terrorist and guerilla tactics, as well as improvised munitions.")
(comment DrugTraffickingOrganization "A specialization of #$CriminalOrganization and #$CommercialOrganization
involved in buying, selling, and transporting #$IllegalDrugs.")
(comment DrugCartel "A specialization of #$CriminalOrganization and
#$ManufacturingOrganization that produces #$IllegalDrugs. A #$DrugCartel
will usually control farmland, employ farmers, own manufacturing
facilities, and use extensive in-house security. Some #$DrugCartels
are also #$DrugTraffickingOrganizations.")
(comment host "(#$host HOSTING AGENT) means that AGENT is a host in the  instance of #$Hosting, HOSTING.  Where HOSTING is an instance of #$SocialGathering, use the more specific #$hostOfEvent.")
(comment WFFSupportedTerm "The collection of all #$CycLTerms that have some kind of special support in the #$CycWellFormednessChecker.")
(comment SKSI-KBIT-ForwardInferenceIntegrityTest "This collection of tests ensures that several forward rules which are critical for valid knowledge source mappings are deducing all of their expected results. For each such forward rule, there is a test with an associated composed of the rule antecedent, in conjunction with #$unknownSentence applied to the rule consequent formula.")
(comment ExampleScriptedEventTypeForDomain "(#$ist MT (#$isa SCRIPT #$ExampleScriptedEventTypeForDomain)) means that within the context MT (and every #$Microtheory that has access to MT), SCRIPT is considered a generally useful script to use in citing examples relating to the domain.")
(comment SituationType-TopicType "A template topic for generating new situation types (particularly as subsituation-types of other situation-types).")
(comment SubSitTypeRelatedToSitType-TemplateType "A template type for the first tab in the FET to house templates for stating how the subsituation type being introduced relates to an existing situation type -- is it essential, uniquely occurring, iterated, a candidate, etc.")
(comment SituationTypeRelation-SitTypeToSubSitTypeBasic "#$SituationTypeRelation-SitTypeToSubSitTypeBasic is the sub-collection of #$SituationTypeRelation-Predicate whose instances represent the basic sub-situation type relation relation (e.g., whether it is one of essentiality (via #$properSubSituationTypes, or of candidacy (via #$candidateProperSubSituationTypes), etc.).")
(comment moduleImplementsProgramFunction "A binary predicate relating an instance of #$ComputerProgramModule-CW 
with an instance of ProgramStep. (#$moduleImplementsProgramFunction MODULE FUNCTION) 
means that the MODULE defines FUNCTION in some way, and is agnostic to whether 
FUNCTION is part of the external interface of MODULE. Compare with #$moduleExportsProgramFunction.")
(comment BarrierSituation-PhysicalForce "A collection of individual
situations. Each #$BarrierSituation-PhysicalForce consists of an
arrangement of some #$Path-Customary PATH, some #$PartiallyTangible
thing(s) BLOCKER1, BLOCKER2, . . . and some #$PartiallyTangible
things(s) BLOCKED1, BLOCKED2, . . .. such that BLOCKED1, BLOCKED2,
. . . could potentially move along PATH, were BLOCKER1, BLOCKER2,
. . . not physically in contact with the blocked thing(s) in a way
that prevents such movement. Examples include a #$Dam blocking the
flow of water and a person #$RestrainingSomeone in a
#$WrestlingHold. To represent cases in which a path is effectively
blocked by the mere likelihood of such physical contact -- that is,
the blocking object acts as a deterrent (such as a Fence keeping Cows
in a pasture), see BarrierSituation-Deterrent. Note that
#$BarrierSituation-PhysicalForce is #$not #$disjointWith
#$BarrierSituation-Deterrent.")
(comment BarrierSituation-Deterrent "A collection of individual
situations. Each #$BarrierSituation-Deterrent consists of an
arrangement of some #$Path-Customary PATH, some #$PartiallyTangible
thing(s) BLOCKER1, BLOCKER2, . . . and some #$PartiallyTangible
things(s) BLOCKED1, BLOCKED2, . . .. such that BLOCKED1, BLOCKED2,
. . . could potentially move along PATH, were BLOCKER1, BLOCKER2,
. . . not in the way. It is important that actual movement along PATH
be prevented, at least in part, by the deterrent effect of the
blocking object(s).  That is, at least some of the blocked objects
should be blocked by the likelihood of being physically prevented from
moving, without having to come in contact with the blocking object(s)
themselves.  Examples include a #$Fence keeping #$Cows in a pasture,
and an #$Obstacle blocking a #$Roadway. Objects whose movement is
being blocked in this way may occassionally come into physical contact
with the blocking object (as a #$Cow bumping into, or pushing against,
a #$Fence), but the situation will be an instance of
#$BarrierSituation-Deterrent just in case the blocking is at least
partially accomplished by deterrence. To represent cases in which a
path is blocked by physical force (such as a #$Dam blocking the flow
of water), see #$BarrierSituation-PhysicalForce. Note that
#$BarrierSituation-Deterrent is #$not #$disjointWith
#$BarrierSituation-PhysicalForce.")
(comment SitTypeCharacter-TemplateType "A template type for housing templates that enable one to characterize the newly introduced sub-situation type by saying what it's a specialization of, and by stating role-playing and actor-type facts about it.")
(comment termHasPositionInFormula "A ternary #$MetaLanguagePredicate that is used to state the precise position of a given #$CycLTerm within a given #$CycLFormula in which it occurs.  The term might be an immediate constituent of the formula, or it might be nested (to any depth) inside some other constituent(s).
<p>
(#$termHasPositionInFormula TERM INTEGER-LIST FORMULA) means that TERM occurs in  the location within FORMULA that is described by INTEGER-LIST, according  to the following convention.  The first integer in INTEGER-LIST is the  number of an argument-place in FORMULA that is occupied by either (a) TERM itself or (b) by some sub-formula SUBFORMULA that contains TERM. In case (a), TERM's exact location has been identified, and INTEGER-LIST  will contain no further integers.  In case (b), the second integer in INTEGER-LIST is the number of the argument-place in SUBFORMULA that is  occupied by either (a) TERM itself or (b) by some sub-formula  SUBSUBFORMULA that contains TERM.  And so on.
<p>
For example, the sentence '(#$termHasPositionInFormula #$Dog (#$TheList 1)  (#$genls #$Dog #$Mammal))' holds, as does '(#$termHasPositionInFormula #$Dog  (#$TheList 2 1) (#$isa #$Muffet (#$AdultFn #$Dog))'.
<p>
Note that #$termHasPositionInFormula's first and third argument-places are both \"quoted\" (see #$quotedArgument).  See also #$argN.")
(comment TermWithPositionInFormulaFn "A binary function that takes as arguments a #$CycLFormula and an integer-list that specifies a position within it, and returns the #$CycLTerm (if any) that appears in that position in that formula. The term might be an immediate constituent of the formula, or it might be nested (to any depth) inside some other constituent(s).
<p>
(#$TermWithPositionInFormulaFn INTEGER-LIST FORMULA) is the term TERM (if there is one) that occurs in the location in FORMULA that is precisely described by INTEGER-LIST, according to the following convention. The first integer in INTEGER-LIST is the number of an argument-place in FORMULA that is occupied by either (a) TERM itself or (b) by some sub-formula SUBFORMULA that contains TERM. In case (a), TERM's exact location has been identified, and INTEGER-LIST will contain no furtherintegers.  In case (b), the second integer in INTEGER-LIST is the number of the argument-place in SUBFORMULA that is occupied by either (a) TERM itself or (b) by some sub-formula SUBSUBFORMULA that contains TERM.  And so on.
<p>
For example, (#$TermWithPositionInFormulaFn (#$TheList 2 1) (#$isa #$Muffet (#$AdultFn #$Dog))) is the CycL term '#$Dog' (as opposed to the collection of dogs).
<p>
This function corresponds to the predicate #$termHasPositionInFormula.")
(comment SituationTypeRelation-BasicActorTypesAndRolesForSubSitTypes "The sub-collection of #$SituationTypeRelation whose instances represent which types of actors which play roles in specializations of #$Situation. Its instances are just #$onlyTypePlaysRoleInSubSituationType and #$someTypePlaysRoleInSubSituationType.")
(comment eMailSendingRecipientSet "A #$BinaryRolePredicate associating a #$MassEMailSending with the set of recipient email addresses for the email.")
(comment situationTypeIsIteratedSubSituationType-OverSet "(#$situationTypeIsIteratedSubSituationType-OverSet SITTYPE SUBSITTYPE SET SUBSITTYPE-ROLE) means that each instance, SIT, of SITTYPE consists of one instance of SUBSITTYPE for each element of SET. Moreover, each such thing plays the role SUBSITTYPE-ROLE in exactly one such instance of SUBSITTYPE.")
(comment orthogonalityCandidates "A binary, irreflexive and symmetric #$KBDependentRelation that takes a pair of collections as arguments.  (#$orthogonalityCandidates COLL-A COLL-B) holds just in case COLL-A is not known to be  disjoint with, a specialization of, or a generalization of COLL-B.  That is, it holds just in case:
<p>
(#$and
(#$unknownSentence (#$disjointWith COLL-A COLL-B))
(#$unknownSentence (#$genls COLL-A COLL-B))
(#$unknownSentence (#$genls COLL-B COLL-A))).
<p>
See also #$orthogonalSetsOrCollections.")
(comment SKSI-KBIT-ContentMtSpindleTest "This collection of tests is intended to ensure that #$genlMt links are correctly distributed among SKSI content microtheories and microtheory spindles.")
(comment termForTemplatePositions "(#$termForTemplatePositions TERM TEMPLATE-TYPE LIST) means that in the context of using TEMPLATE-TYPE, TERM is passed to positions in templates in a manner described by LIST, according to the following convention.  LIST is a list of sub-lists, each of which has a template TEMPLATE as a first argument and some non-zero number of #$FormulaArgPositions as subsequent elements.  In each sub-list, the #$FormulaArgPositions indicate where to pass TERM as a value to arguments to TEMPLATE.  For example, the following formula would hold in the context in which one was adding a scene to a #$BrushingTeeth script with #$SceneInScriptedEventType-TopicType:
<p>
(#$termForTemplatePositions #$BrushingTeeth
#$SceneInScriptedEventType-TopicType
(#$TheList
(#$TheList
#$SceneActorTypesTemplate
(#$FormulaArgPositionFn 1))
(#$TheList
#$SceneRelatedToScriptTemplate
(#$FormulaArgPositionFn 1))
(#$TheList
#$ScriptQuasiTemporalOrderingToOtherSceneTemplate
(#$FormulaArgPositionFn 1))
(#$TheList
#$ScriptQuasiTemporalOrderingFromOtherSceneTemplate
(#$FormulaArgPositionFn 1)))).")
(comment EnglishLexicalDataMicrotheory "The collection of all microtheories that contain lexical assertions describing usage in some kind of English.")
(comment orthogonalInMt "An instance of #$TernaryPredicate.  (#$orthogonalInMt MT COL1 COL2) means that it is true in the #$Microtheory MT that the #$Collection COL1 is orthogonal with (i.e. logically independent of) the #$Collection COL2.  More precisely, (#$orthogonalInMt MT COL1 COL2) means that (1) (#$orthogonalityCandidates COL1 COL2) is true in MT; and (2) each of the following sentences is such that it is true in some (not necessarily reified) specMt of MT: (a) (#$thereExists ?THING (#$isa ?THING (#$CollectionIntersection2Fn COL1 COL2))); (b) (#$thereExists ?THING (#$isa ?THING (#$CollectionDifferenceFn COL1 COL2))); (c) (#$thereExists ?THING (#$isa ?THING (#$CollectionDifferenceFn COL2 COL1))).")
(comment TimeOfCyclicalIntervalGroupPredicate "#$TimeOfCyclicalIntervalGroupPredicate is a collection of predicates which are either (1) the corresponding functional predicates for the instances of #$TimeOfCyclicalIntervalGroupFunction or they are used to relate NARTs composed out of the instances of #$TimeOfCyclicalIntervalGroupFunction to the integers which would represent them on a clock.")
(comment hourOfDayIndex-12Hour "#$hourOfDayIndex-12Hour is used to relate an #$HourOfDayType to an integer and a #$TimeOfDayType. For example, the assertion (#$hourOfDayIndex-12Hour #$TimeOfDay-6AM 6 #$TimeOfDay-AM) states (1) that instances of the sub-collection of #$CalendarHour #$TimeOfDay-6AM are all represented with the integer '6' on a clock that shows time in a 12-hour format and (2) that the instances of #$TimeOfDay-AM are associated with the #$TimeOfDayType #$TimeOfDay-AM.")
(comment hourOfDayIndex-24Hour "#$hourOfDayIndex-24Hour is used to relate an #$HourOfDayType to an integer. For example, the assertion (#$hourOfDayIndex-24Hour TimeOfDay-6AM 6) states that the instances of the the sub-collection of #$CalendarHour #$TimeOfDay-6AM are all represented with the number '6' on a clock that represents time in a 24-hour format.")
(comment hourOfTimeOfDay "#$hourOfTimeOfDay is the corresponding predicate to the function #$TimeOfDayFn. An assertion of the form (#$hourOfTimeOfDay TIMEOFDAY HOUR MINUTE) asserts that the type TIMEOFDAY is composed out of the #$HourOfDayType HOUR and the #$MinuteOfHourType MINUTE. So, (#$hourOfTimeOfDay (#$TimeOfDayFn #$TimeOfDay-11PM (#$MinuteOfHourFn 12)) #$TimeOfDay-11PM (#$MinuteOfHourFn 12)) states that  (#$TimeOfDayFn #$TimeOfDay-11PM (#$MinuteOfHourFn 12)) is functionally composed out of the #$HourOfDayType #$TimeOfDay-11PM and the #$MinuteOfHourType  (#$MinuteOfHourFn 12). So, it represents the collection of all the #$CalendarMinutes that are the twelfth minute of the 11th hour of some instance of #$TimeOfDay-PM.")
(comment typeOfTimeOfHour "#$typeOfTimeOfHour is the corresponding predicate to the function #$TimeOfHourFn. An assertion of the form (#$typeOfTimeOfHour TIMEOFHOUR MINUTE SECOND) states that the #$TimeOfHourType TIMEOFHOUR is composed out of the #$MinuteOfHourType MINUTE and the #$SecondOfMinuteType SECOND. So, (#$typeOfTimeOfHour (#$TimeOfHourFn (#$MinuteOfHourFn 12) (#$SecondOfMinuteFn 12)) (#$MinuteOfHourFn 12) (#$SecondOfMinuteFn 12)) states that (#$TimeOfHourFn (#$MinuteOfHourFn 12) (#$SecondOfMinuteFn 12)) denotes the collection of every #$CalendarSecond that is the twelfth #$CalendarSecond of the twelfth #$CalendarMinute of some #$CalendarHour.")
(comment numberOfMinuteOfHour "This is the corresponding predicate to the function #$MinuteOfHourFn. An assertion of the form (#$numberOfMinuteOfHour MINUTE N) states that the #$MinuteOfHourType MINUTE is the collection composed out of the Nth minute of every instance of #$CalendarHour. So, (#$numberOfMinuteOfHour  (#$MinuteOfHourFn 7) 7) states that the #$MinuteOfHourType (#$MinuteOfHourFn 7) is the collection composed out of every #$CalendarMinute that is the 7th #$CalendarMinute in some #$CalendarHour.")
(comment numberOfSecondOfMinute "#$numberOfSecondOfMinute is the corresponding predicate to the function #$SecondOfMinuteFn. An assertion of the form (#$numberOfSecondOfMinute SECOND N) states that the #$SecondOfMinuteType SECOND is the collection composed out of the Nth second of every instance of #$CalendarMinute.So, the assertion (#$numberOfSecondOfMinute (#$SecondOfMinuteFn 1) 1) states that (#$SecondOfMinuteFn 1) is the collection of #$CalendarSeconds that are the first #$CalendarSecond in some #$CalendarMinute.")
(comment clockTimeIndex-24Hour "The predicate #$clockTimeIndex-24Hour associates a #$TimeOfDayType with a three integer representation, using a 24-hour index for the hours.  For instance, an assertion of the form (#$clockTimeIndex-24Hour (#$TimeOfDayFn #$TimeOfDay-11PM (#$TimeOfHourFn (MinuteOfHourFn 12) (#$SecondOfMinuteFn 12))) 23 12 12) states that they #$TimeOfDayType (#$TimeOfDayFn #$TimeOfDay-11PM (#$TimeOfHourFn (MinuteOfHourFn 12) (#$SecondOfMinuteFn 12))) would be represented as 23:12:12 on a clock that uses the 24-hour, 'Military', 'International' time system.")
(comment clockTimeIndex-12Hour "The predicate #$clockTimeIndex-12Hour associates a #$TimeOfDayType with a three integer representation, using a 12-hour index for the hours, and associating it with either #$TimeOfDay-AM or #$TimeOfDay-PM.   For instance, an assertionof the form (#$clockTimeIndex-12Hour (#$TimeOfDayFn #$TimeOfDay-11AM (#$TimeOfHourFn (MinuteOfHourFn 12) (#$SecondOfMinuteFn 12))) 11 12 12 #$TimeOfDay-AM) states that they #$TimeOfDayType (#$TimeOfDayFn #$TimeOfDay-11AM (#$TimeOfHourFn (MinuteOfHourFn 12) (#$SecondOfMinuteFn 12))) is represented as '11:12:12 AM' on a clock that uses the 12-hour time system.")
(comment RioBravo "A #$River in #$Belize.")
(comment Refraining "An instance of #$TemporalObjectType and a specialization of #$PurposefulAction.  Each instance of #$Refraining is an event in which one deliberately avoids some action which one would normally be expected to take.")
(comment FocalTermSceneCandidate-Intermediate "A collection of sub-collections of #$Situation.  The instances of this collection act as suggestions when using the script editor to add a sub-situation type to a type of #$Situation.")
(comment FalunGong "A set of practices and beliefs
derived from Quigong by Li Hongzhi. The basic practices are breathing
and movement exercises which are reminiscent of #$TaiChiActivity.")
(comment windinessOfRegion "(#$windinessOfRegion LOC DEGREE) means that the #$OutdoorLocation LOC is characterized by DEGREE of wind speed.  Use this predicate to ascribe general wind quantities.  To attribute a particular wind speed (e.g. 35 m.p.h.) use #$ambientWindSpeed. ")
(comment Pun "A specialization of #$ConceptualWork.  This is the collection of all puns or \"plays on words\".")
(comment Buyback "Each #$Buyback is a type of sale in which the seller previously purchased the goods sold from the buyer, but now the seller is buying the items back.")
(comment Cappuccino "A specialization of #$Coffee-Beverage.   Each instance of #$Cappuccino is a coffee beverage made from espresso and frothed milk.")
(comment Propaganda "A specialization of
#$PropositionalConceptualWork. Each instance of this collection is a
work, which includes ideas, facts, and allegations, produced by an
agent deliberately for dissemination to further a cause or damage an
opposing cause.")
(comment Peacekeeper "A specialization of #$MilitaryPerson (q.v.).  Each instance of #$Peacekeeper is a member of a military force that is assigned (often with international sanction) to preserve peace in a trouble area.")
(comment HurricaneGloria "A #$HurricaneAsObject that occured in #$LongIsland on September 27, 1985.")
(comment Bracket-Symbol "The collection of bracket symbols, e.g. the left parenthesis, the right square bracket.")
(comment Injunction "A specialization of #$Writ (q.v.)  An #$Injunction is an order of a #$Court-Judicial that bans, prevents restricts, or prohibits certain actions. For example, you might obtain an injunction to prevent your neighbor from playing loud music.")
(comment Tamale "A specialization of #$SolidFoodArtifact and #$Food-ReadyToEat.")
(comment bailAmount "The predicate used to relate a #$BailAgreement to the monetary value required to secure a prisoner's release.")
(comment BailAgreement "A specialization of #$LegalAgreement.  Each instance of #$BailAgreement is an agreement to temporarily release a prisoner in exchange for form of security (#$TenderObject) of a set value. See also #$bailAmount.")
(comment orthogonalSetsOrCollections "<code>(#$orthogonalSetsOrCollections SETORCOL1 SETORCOL2)</code> means that each of <code>SETORCOL1</code> and <code>SETORCOL2</code> has at least one element that the other lacks, and that at least one thing is an element of both collections.  It thus entails that all of the following are true: 
<p>
(1) <code>(#$some SETORCOLL1 SETORCOLL2)</code>; 
<br>
(2) <code>(#$not (#$subsetOf SETORCOLL1 SETORCOLL2))</code>; 
<br>
(3) <code>(#$not (#$subsetOf SETORCOLL2 SETORCOLL1))</code>.  
<p>
Unlike #$orthogonalityCandidates (q.v.), #$orthogonalSetsOrCollections is assertible, and can hold of sets as well as collections.")
(comment Benchmark "A specialization of #$Specification.  Each instance of #$Benchmark is a #$Specification that is used as a standard against which other things are compared.  For example, a specification of the performance of (the members of) #$StandardAndPoors500 might be used as a #$Benchmark for other stocks -- i.e., a standard against which their performance is compared.")
(comment CompletenessPredicate "A collection of #$MetaKnowledgePredicates that are applicable to collections or predicates whose extents are in some sense \"inferentially complete\".  There are a variety of degrees to which such an extent (see #$extent and #$relationExtension) can be inferentially complete; see the specialization #$InferenceCompletenessPredicate and its instances.  Also, a given extent's completeness (of whatever degree) can derive from any one of several sources; see the specialization #$CompletenessGroundsPredicate and its instances.")
(comment completeByCycConvention "An instance of #$CompletenessGroundsPredicate that is used to state, about a collection or predicate whose extent is inferentially complete (see #$InferenceCompletenessPredicate), that the completeness derives mainly from a conventional stipulation, rather than from the nature of the items in the extent themselves, and that the convention is one stipulated by the designers of the Cyc system itself. For example, (#$completeExtentAsserted #$CanonicalizerDirective) holds, and so does (#$completeByCycConvention #$CanonicalizerDirective).  Cf. #$completeByExternalConvention.")
(comment jdbcDataTypeCodeMapping "A predicate relating a JDBC constant to a CycL representation of the datatype.")
(comment Metaphor "A literary device in which a word or phrase is used to mean something other than the thing it literally denotes, thereby suggesting an analogy between them.")
(comment Moratorium "A specialization of #$Inaction (q.v.).  Each instance of #$Moratorium is a #$Situation of there being in effect a legally authorized period of delay (see #$moratoriumPeriod) in the performance of a certain legal obligation or the payment of a certain debt (see #$moratoriumOn).
<p>
Where <code>(#$moratoriumOn MORATORIUM OBLIGATION)</code> and <code>(#$moratoriumPeriod MORATORIUM PERIOD)</code>, <code>MORATORIUM</code> is <i>precisely</i> the situation such that those two statements (and anything logically or legally entailed by them) hold -- no more and no less.  It follows from this that <code>OBLIGATION</code>'s #$obligatedAgents (q.v.) are not legally required to fulfill <code>OBLIGATION</code> during <code>PERIOD</code>.  (It does <i>not</i> follow that the agents are <i>prohibited</i> from fulfilling <code>OBLIGATION</code> during <code>PERIOD</code>, although that might sometimes be the case.)  The #$temporalExtent of <code>MORATORIUM</code> is the #$TimeInterval <code>PERIOD</code> itself.")
(comment BelarusianPerson "The collection of people who are #$citizens of #$Belarus, or participate in its #$NationalCulture.")
(comment ensures-SitProp "A binary predicate that is used to state that a certain situation's obtaining ensures the truth or inevitabilty of a certain proposition.  (#$ensures-SitProp SIT SENT) means that the (presupposed) fact that SIT obtains or occurs guarantees that SENT is or will become true.  This implies that SENT expresses a contingent truth: although SENT is or will be true, it might not have been true (and perhaps but for SIT would never have been true).  Note that SIT must play a material and decisive role in SENT's being or becoming true; it is not sufficient (or necessary) that SIT be a situation in which some agent verifies or becomes convinced of the truth or inevitability of SENT.  For example, if the Tigers win a game that clinches them a spot in the playoffs, then that win ensures that the sentence 'The Tigers are in the playoffs' will (come playoff time) be true.  See also #$ensures-AgentProp.")
(comment ExternalDataTypeIdentifierFn "A function used to refer to a datatype identifier used in some external system. Note that we have these particular arguments so we can refer to the values used in, say, a protocol, rather than only in some particular program.")
(comment systemComponents "The most general predicate that relates instances of #$System to their components.  (#$systemComponents SYSTEM COMPONENT) means that COMPONENT is one of the pieces that \"make up\" the system SYSTEM.  For example, (#$systemComponents DigestiveSystem001 Stomach001) says that Stomach001 is one of the components of the #$DigestiveSystem, DigestiveSystem001. ")
(comment Limousine "A specialzation of #$LuxuryCar.  Each instance of #$Limousine is a large luxurious car typically driven by a chauffeur, often with a partion separating the front seat area from the passenger area.")
(comment temporalIntersection "<code>(#$temporalIntersection INTERSECTION INTERVAL-1 ... INTERVAL-N)</code> means that the temporal extent of <code>INTERSECTION</code> is the intersection of the temporal extents of <code>INTERVAL-1</code> ... <code>INTERVAL-N</code>.")
(comment TemporalIntersectionFn "This function takes a set of #$TemporalThings and denotes the (possibly empty) intersection of its elements.  Unlike #$SpatialIntersectionFn, #$TemporalIntersectionFn is a #$TotalFunction and denotes #$TheEmptyTimeInterval for sets of #$TemporalThings with no temporal intersection.")
(comment UnsuccessfulAttemptToFn " A specialization of #$UnsuccessfulFn.  (#$UnsuccessfulAttemptToFn ACT-TYPE) denotes the
collection of failed attempts to perform ACT-TYPE, i.e., the
collection of such attempts which do not culminate in an instance of ACT-TYPE.  For example,
(#$UnsuccessfulAttemptToFn #$StandingUp) denotes 
the collection of events in
which an animal tries and fails to stand up.  Note that the
generalization #$UnsuccessfulFn defines 'lack of success' more
broadly.")
(comment Exhibitionism-TheCondition "An instance of #$PhysiologicalConditionType and a specialization of #$Paraphilia.  Each instance of #$Exhibitionism-TheCondition is a #$PsychologicalAilment characterized by the compulsion to engage in instances of #$Exhibitionism-TheAction (q.v.).")
(comment Zoophilia "An instance of #$PhysiologicalConditionType and a specialization of #$Paraphilia.  Each instance of #$Zoophilia is a #$PsychologicalAilment characterized by the compulsion to engage in instances of #$Bestiality (q.v.).")
(comment Pedophilia-TheCondition "An instance of #$PhysiologicalConditionType and a specialization of #$Paraphilia.  Each instance of #$Pedophilia-TheCondition is a #$PsychologicalAilment characterized by the compulsion to engage in instances of #$Pedophilia-TheAction (q.v.).")
(comment Dyspnea "An instance of #$PhysiologicalConditionType.  Each instance of #$Dyspnea is a #$RespiratoryAilment characterized by instances of #$DifficultBreathing (q.v.).")
(comment Bleeding-TheCondition "An instance of #$PhysiologicalConditionType.  Each instance of #$Bleeding-TheCondition is a #$PhysiologicalCondition characterized by instances of #$Bleeding-TheAction (q.v.).")
(comment Hemorrhaging-TheCondition "An instance of #$PhysiologicalConditionType.  Each instance of  #$Hemorrhaging-TheCondition  is an #$AilmentCondition characterized by instances of #$Hemorrhaging-TheAction (q.v.).")
(comment TerminalCoexistencePredicate "A specialization of #$CotemporalPredicate (q.v.).  A cotemporal predicate PRED is a #$TerminalCoexistencePredicate if and only if it has the following property: if any given sentence of the form (PRED ARG1 ... ARGN) is true at time index T (see #$mtTimeIndex) it remains true until, and only until, at least one of the ARGi ends -- i.e. ceases to exist (if a #$SomethingExisting) or occur (if an #$Event) or obtain (if a #$StaticSituation).
<p>
For example, #$olderThan is a #$TerminalCoexistencePredicate.  Once a sentence of the form (#$olderThan OLD YOUNG) becomes true, it remains true until one of the relata dies or ceases to exist.")
(comment Zionism "A Jewish movement that arose in Europe in the
late 19th century that sought to establish a Jewish homeland in
Palestine.")
(comment Stockpile "A specialization of #$Store-Generic and #$Artifact (qq.v.).  Each instance of #$Stockpile is a reserve store of some important type of product or material (such as food, weapons, or fuel), accumulated by an agent (usually a country) for use during a shortage or emergency condition (such as war).  For example, some countries have stockpiles of chemical weapons.")
(comment VetoingSomething "A specialization of #$Rejecting-CommunicationAct.  Each instance of #$VetoingSomething is a communication act in which some proposed action is forbidden (see #$vetoProhibitsActType).")
(comment SubLFormatFn "An evaluatable CycL version of SubL's format function. Particularly useful with #$Lambda.")
(comment queryVariables "(queryVariables QUERYFORMULA VARIABLE) means that VARIABLE
is an open or existentially bound #$CycLVariable in the formula
QUERYFORMULA.")
(comment queryVariables-Open "(queryVariables-Open QUERYFORMULA VARIABLE) means that
VARIABLE is an unbound #$CycLVariable in the #$CycLSentence-Askable
QUERYFORMULA.")
(comment queryVariables-Existential "(queryVariables-Existential QUERYFORMULA VARIABLE) means
that VARIABLE is a #$CycLVariable, bound by some
#$ExistentialQuantifier, in the CycLOpenSentence QUERYFORMULA.")
(comment satisfiableExpression "(satisfiableExpression EXPRESSION) means that it is
possible, at least in principle, to simultaneously meet all conditions
represented by EXPRESSION, even if currently no bindings meeting all
such conditions can be found.")
(comment GatheringFoodPreparationItems "A specialization of #$PhysicalCollectionEvent.  Each instance of #$GatheringFoodPreparationItems is an event in which some items to be used in the preparation of a food item are gathered together.  The items gathered will include pots and pans, ingredients of the food item, and other materials such as water to be used for boiling.")
(comment jdbcURLFormatString "A predicate relating a knowledge source type such as PostgreSQL to a Lisp-style format string. Intended to be used with #$SubLFormatFn to generate URLs.")
(comment lineOfSight-ObjectToRegion "(#$lineOfSight-ObjectToRegion OBJECT REGION) means that based purely on the topographic data provided by a digital terrain elevation model and the geometric algorithm used to evaluate this predicate, OBJECT has a \"viewshed\" corresponding to REGION.")
(comment incapableOfRoleInSituationType "An assertion of the form (#$incapableOfRoleInSituationType THING ROLE SIT-TYPE) asserts that THING, an instance of #$SomethingExisting, cannot play ROLE, an instance of #$BinaryRolePredicate, in some instance of SIT-TYPE, a specialization of #$Situation.  The conditions that would explain why THING cannot play ROLE in an instance of SIT-TYPE, would be carried in an assertion using the predicate #$roleInScriptRequires-Neg.")
(comment roleInScriptRequires-Neg "An assertion of the form (#$roleInScriptRequires-Neg SIT-TYPE ROLE QUERY) states that any instance of #$SomethingExisting cannot play ROLE, an instance of #$BinaryRolePredicate, in some instance of SIT-TYPE, a specialization of #$Situation, if the conditions represented via QUERY, some sub-collection of #$CycLQuerySpecification, and the #$InferenceSentenceParameter of the #$softwareParameterValueInSpecification associated with QUERY are true.  In short, these are conditions which would prevent an individual from playing ROLE in an instance of SCRIPT.")
(comment roleInScriptRequires-Pos "An assertion of the form (#$roleInScriptRequires-Pos SITTYPE ROLE QUERY) states that in order for any instance of #$SomethingExisting to play ROLE in an instance of SITTYPE , then the conditions represented via QUERY, some sub-collection of #$CycLQuerySpecification, and the #$InferenceSentenceParameter of the #$softwareParameterValueInSpecification associated with QUERY must be true concerning the actor who would fill that role.  Stictly speaking, these are not logically sufficient conditions, but necessary conditions for being able to fill the role.  Thus, they could be labelled 'qualifications.'")
(comment exceptedInstanceOfScriptBecause "An assertion of the form (#$exceptedInstanceOfScriptBecause SIT QUERY) states that SIT, an instance of #$Situation, is an abnormal instance of the collection because the set of conditions represented via QUERY, some sub-collection of #$CycLQuerySpecification, and the #$InferenceSentenceParameter of the #$softwareParameterValueInSpecification associated with QUERY are true concerning SCRIPT-INST.  Thus, certain inferences about SCRIPT-INST's sub-events and their actors are blocked.")
(comment situationTypeViolatedWhen "An assertion of the form (#$situationTypeViolatedWhen SITTYPE QUERY) is used to represent 'exceptions' to scripts.  More precisely, they represent the types of conditions that will lead to a disruption in the flow of instances of SITTYPE, whereby inferences to the existence of sub-situations are blocked.")
(comment subSituationTypeConditionedOn "An assertion of the form  (#$subSituationTypeConditionedOn SITTYPE SIT-TYPE QUERY) is used to represent the conditions under which an instance of SITTYPE  will have an instance of SIT-TYPE, some sub-collection of #$Situation as a #$subSituations.  Specifically, the conditions for the realization of of the instance of SIT-TYPE are represented via QUERY, some sub-collection of #$CycLQuerySpecification, and the #$InferenceSentenceParameter of the #$softwareParameterValueInSpecification associated with QUERY.")
(disjointWith Marshmallow Agent-Generic)
(disjointWith Marshmallow PersonalHygieneProduct)
(disjointWith Marshmallow CleaningDevice)
(disjointWith Marshmallow Weapon)
(disjointWith Marshmallow DurableGood)
(comment HomogeneousTexture "An instance of #$ObjectTypeBySensibleFeature.  Each instance of #$HomogeneousTexture is a #$PartiallyTangible object which has the same #$Texture throughout, at least on the macroscopic level.  This entails that if any part of the object in question has a certain #$Texture, then every part of the object has that #$Texture.  A notable specialization of #$HomogeneousTexture is #$HomogeneousStructure (q.v.).")
(disjointWith HomogeneousStructure PlanetarySystem)
(disjointWith HomogeneousStructure WeaponSystem)
(disjointWith HomogeneousStructure Ecosystem)
(disjointWith HomogeneousStructure EconomicSystem)
(disjointWith HomogeneousStructure SystemOfDevices)
(disjointWith HomogeneousStructure Organism-Whole)
(disjointWith HomogeneousStructure MechanicalDevice)
(comment Perceiving-MyersBriggs "The collection of agents that are 'perceiving',
according to the Myers-Briggs method of personality classification.
This personality attribute is indicated by a final letter of \"P\"
in the four-letter Myers-Briggs personality type.
Perceiving people are comfortable with chaos, and like to have options open.")
(comment Judging-MyersBriggs "The collection of agents that are 'judging',
according to the Myers-Briggs method of personality classification.
This personality attribute is indicated by a final letter of \"J\"
in the four-letter Myers-Briggs personality type.
Judging people strive for order, and like to have plans finalized.")
(disjointWith Judging-MyersBriggs Perceiving-MyersBriggs)
(comment MyersBriggsPersonalityType-FullySpecified "The subcollection of #$MyersBriggsPersonalityTraits that specify
all four Myers-Briggs personality attributes.")
(comment Introvert-MyersBriggs "The collection of agents that are introverted,
according to the Myers-Briggs method of personality classification.
This personality attribute is indicated by a first letter of \"I\"
in the four-letter Myers-Briggs personality type.
Introverts often feel drained by social interaction with large groups.")
(comment Intuitive-MyersBriggs "The collection of agents that are 'intuitive',
according to the Myers-Briggs method of personality classification.
This personality attribute is indicated by a second letter of \"N\"
in the four-letter Myers-Briggs personality typ-FullySpecifiede.
Intuitive people tend to rely on hypotheses rather than
known facts and sensory perceptions.  They focus more on what could be than what is.")
(comment Feeling-MyersBriggs "The collection of agents that are 'feeling'-FullySpecified',
according to the Myers-Briggs method of personality classification.
This personality attribute is indicated by a third letter of \"F\"
in the four-letter Myers-Briggs personality type.
Feeling people tend to be ruled by emotions more than reason, and to
be dominated by the right halves of their brains.")
(disjointWith Introvert-MyersBriggs Extrovert-MyersBriggs)
(comment Extrovert-MyersBriggs "The collection of agents that are extroverted,
according to the Myers-Briggs method of personality classification.
This personality attribute is indicated by a first letter of \"E\"
in the four-letter Myers-Briggs personality type.
Extroverts often feel energized by social interaction with large groups.")
(comment Thinking-MyersBriggs "The collection of agents that are 'thinking',
according to the Myers-Briggs method of personality classification.
This personality attribute is indicated by a third letter of \"-FullySpecifiedT\"
in the four-letter Myers-Briggs personality type.
Thinking people tend to be ruled by reason more than emotions, and to
be dominated by the left halves of their brains.")
(disjointWith Thinking-MyersBriggs Feeling-MyersBriggs)
(comment Sensing-MyersBriggs "The collection of agents that are 'sensing',
according to the Myers-Briggs method of personality classification.
This personality attribute is indicated by a second letter of \"S\"
in the four-letter Myers-Briggs personality type.
Sensing people tend to rely on known facts and sensory perceptions
rather than hypotheses.  They focus more on what is than what could be.")
(disjointWith Sensing-MyersBriggs Intuitive-MyersBriggs)
(comment WebPageAtURLFn "A unary function that denotes the #$WebPage-AIS at the given URL.")
(comment QuerySpecificationTypeByVisualizationType "<p>")
(comment VisualizableQuery "An instance of #$FirstOrderCollection and a specialization
of #$CycLQuerySpecification. Instances of this collection are query
specifications whose answers are visualizable by the Cyc GUI. Each
such instance is also an instance of at least one
QuerySpecificationTypeByVisualizationType, such as
RTVGraphVisualizable or BarChartVisualizable.")
(comment GraphVisualizable "An instance of #$FirstOrderCollection and a specialization
of #$VisualizableQuery. Instance of this collection are query specifications
whose answers are visualizable as some form of graph. ")
(comment ExperimentalSitTypeRelation "A collection for holding new, experimental vocabulary involving complex types of #$Situation.  Most assertions involving this vocabulary should be made in #$ExperimentalSitTypeVocabularyMt.")
(comment SituationTypePredicate-Specification "#$SituationTypePredicate-Specification is the collection of predicates which are used to relate specializations of #$Situation to one another when on is a more specific form of another.  These predicates represent the details of that specificity.")
(comment orthogonalInMt-TypeType "An instance of #$TernaryPredicate. (#$orthogonalInMt-TypeType MT COLTYPE1 COLTYPE2) means that for each instance COL1 of COLTYPE1 and each instance COL2 of COLTYPE2, (#$orthogonalInMt MT COL1 COL2) holds.  For example, (#$orthogonalInMt-TypeType #$UniversalVocabularyMt #$Color #$AutomobileTypeByBrand) entails (#$orthogonalInMt #$UniversalVocabularyMt #$PaleBlue-Color #$ChevroletCar), (#$orthogonalInMt #$UniversalVocabularyMt #$DeepGreen-Color #$HondaCar), (#$orthogonalInMt #$UniversalVocabularyMt #$PurplishGray-Color #$RollsRoyceCar), etc.")
(comment internetCountryCode "(#$internetCountryCode PLACE CODE) means that CODE is the top-level domain name for PLACE as used in internet addresses.")
(comment InformationGatheringAboutFn "(#$InformationGatheringAboutFn THING) denotes the collection of #$InformationGathering events in which some #$IntelligentAgent AGT gathers information about the #$Thing THING.  In the course of such an event, AGT may incidentally gather information about other things.")
(comment topicOfInfoGatheringType "(#$topicOfInfoGatheringType COL TOPIC) means that each instance of COL is an event in which some #$IntelligentAgent gathers information about #$Thing TOPIC.")
(comment Americano "A specialization of #$Coffee-Beverage.  Each instance of #$Americano is a coffee drink made with two shots of espresso and hot water.")
(comment Latte "A specialization of #$Coffee-Beverage.  Each instance of #$Latte is a coffee drink made with espresso and steamed (but not frothed) milk.  Cf. #$Cappuccino.")
(comment Mocha-CoffeeDrink "A specialization of #$Coffee-Beverage.  Each instance of #$Mocha-CoffeeDrink is a coffee drink made with espresso, chocolate, and steamed (but not frothed) milk.")
(comment Demitasse "A specialization of #$CoffeeCup.  Each instance of #$Demitasse is a small coffee cup designed for serving espresso.")
(comment Breve "A specialization of #$Latte.  Each instance of #$Breve is a coffee drink made with #$Espresso and steamed #$HalfAndHalf.")
(comment HalfAndHalf "Half-and-half is a product consisting of a mixture of (#$MilkFn #$Cow) and #$Cream-Dairy")
(comment BarbershopQuartet-MusicGroup "An instance of #$ExistingObjectType and a specialization of #$Quartet-MusicalPerformanceGroup.  Each instance of #$BarbershopQuartet-MusicGroup is a #$MusicPerformanceOrganization consisting of four singers who specialize in the \"barbershop\" style of #$Singing.")
(comment levelOfExposureToSubstanceTypeViaRoute "(#$levelOfExposureToSubstanceTypeViaRoute OBJECT STUFF-TYPE ROUTE-TYPE LEVEL) says that OBJECT is exposed to instances of STUFF-TYPE via the exposure route ROUTE-TYPE to the degree expressed by LEVEL.  For example, (#$levelOfExposureToSubstanceTypeViaRoute #$BobTheAdult CigaretteSmoke #$Inhaling #$veryHighAmountOf) says that Bob is exposed to cigarette smoke via inhalation to a high degree.  Despite the occurrence of a spec of #$Event in the arg3, this predicate is an instance of #$NonDavidsonianPredicate, intended to be used with temporal qualification, to talk about exposure without explicitly having to reify an exposure event.")
(comment limitsIntakeOf "An instance of #$BinaryPredicate.  (#$limitsIntakeOf AGENT STUFF-TYPE) says that AGENT limits his or her ingestion of instances of STUFF-TYPE.")
(comment TemporallyQualifiableRolePredicate "The intersection of #$TemporallyQualifiableRelation and #$Role.  Each instance of #$TemporallyQualifiableRolePredicate is a predicate that relates an instance of #$Situation to some individual that plays some role in that situation.  Since some roles are played by multiple individuals during the course of some situation, these predicates let you specify the times at which certain individuals play certain roles via our temporal qualification framework.  Often the instances of this collection will be \"present tense\" versions of non-temporally qualifiable role predicates.  For instance, #$actingInDramaticPerformance is an instance of this collection and (#$actingInDramaticPerformance PERF ACTOR)<MT T P> holds just in case during the time interval T ACTOR is playing the #$castMembers role in PERF.  In general, (TQ-ROLE-PRED SITUATION ROLE-PLAYER)<MT TIME P> entails that SITUATION and TIME, at the very least, intersect. ")
(comment interactionFolderForCyclist "(#$interactionFolderForCyclist FOLDER AGENT) means that FOLDER is
the instance of #$KEInteractionFolder created for use by the #$Cyclist
AGENT.")
(comment folderApplicableInDemoEnvironment "(#$folderApplicableInDemoEnvironment ?FOLDER
?DEMO-ENVIRONMENT-MT) means that ?FOLDER, an instance of
#$KEInteractionFolder, is suitable for use in the instance of
#$UIA-DemoEnvironmentMicrotheory, ?DEMO-ENVIRONMENT-MT.")
(comment cycLQueryTypeSpecification "(#$cycLQueryTypeSpecification QUERY-TYPE QUERY-SPEC) means that
each query event that is an instance of QUERY-TYPE is specified by
the #$CycLQuerySpecification QUERY-SPEC.")
(comment graphStructureOfSystem "(#$graphStructureOfSystem AIS SYSTEM) says that the instance AIS of #$GraphicalStructure GRAPH is the graphical structure of a graph that depicts the #$System SYSTEM.  Note that multiple systems could share a common structure, so this predicate is not functional in the arg2.")
(comment cycLQueryFormula "(#$cycLQueryFormula QUERY-EVENT FORMULA) means that FORMULA is
the #$CycLFormula used in the individual query run QUERY-EVENT.")
(comment cycLQueryTypeFormula "(#$cycLQueryTypeFormula QUERY-TYPE FORMULA) means that FORMULA
is the #$CycLFormula used in #$CycQueryRunning events of type
QUERY-TYPE. For representation of test query formulas, see the related
#$testQueryFormula.")
(comment cycLQueryEventVariables "(#$cycLQueryEventVariables QUERY-EVENT VAR) means that VAR is
an open or existentially bound #$CycLVariable found in the query
specification for the event QUERY-EVENT. More precisely, QUERY-EVENT
is some #$CycQueryRunning, specified by some #$CycLQuerySpecification
including some #$CycLFormula FORMULA that specifies the query to be
run, and VAR appears as a variable in FORMULA.")
(comment cycLQueryEventVariableConstraints "(#$cycLQueryEventVariableConstraints QUERY-EVENT VAR
MEANING-SENT) means that VAR is an open or existentially bound
#$CycLVariable in the #$CycLFormula for the query run during QUERY-EVENT,
and MEANING-SENT expresses the constraints on VAR.")
(comment cycLQueryTypeVariables "(#$cycLQueryTypeVariables QUERY-TYPE VAR) means that VAR is an
open or existentially bound #$CycLVariable found in the query formula
specification for QUERY-TYPE.  More precisely, QUERY-TYPE is some
#$CycQueryTypeBySpecification, specified by some
#$CycLQuerySpecification including some #$CycLFormula FORMULA that
specifies the query to be run in every instance of QUERY-TYPE, and VAR
appears as a variable in FORMULA.")
(comment cycLQueryTypeVariableConstraints "(#$cycLQueryTypeVariableConstraints QUERY-TYPE VAR
MEANING-SENT) means that VAR is an open or existentially bound
#$CycLVariable in the #$CycLFormula for the query run during events of
type QUERY-TYPE, and MEANING-SENT expresses the constraints on VAR.")
(comment cycLQueryInferenceBindingVarValue "(#$cycLQueryInferenceBindingVarValue QUERY-EVENT VAR TERM) means that the #$CycLFormula representing the query run in QUERY-EVENT contains the variable VAR, and in at least one #$ELInferenceBinding result of QUERY-EVENT, TERM is bound to VAR.")
(comment cycLQueryOutputBindings "(#$cycLQueryOutputBindings QUERY-EVENT BINDING) means that
BINDING is a result of QUERY-EVENT.  That is, the
#$ELSetOfInferenceBindingSets that is the answer to the query in
QUERY-EVENT includes at least one #$ELInferenceBindingSet that has
BINDING as an element.")
(comment CycLQueryOutputBindingsForVarFn "(#$CycLQueryOutputBindingsForVarFn VAR) denotes a
#$BinaryPredicate relating a query event to the binding values found
for a particular variable VAR in that event.")
(comment cycLQueryInputBindings "(#$cycLQueryInputBindings QUERY-EVENT BINDING) means that the
variable-value pair specified by BINDING is used to bind one of the
variables in the query run during QUERY-EVENT.  For example, the
assertion (#$cycLQueryInputBindings TouristQueryEvent001
(#$ELInferenceBindingFn ?THING1 #$WestminsterAbbeyCathedral-London))
states that for a particular #$CycQueryRunning event called
TouristQueryEvent001, the variable ?THING1 in the query formula should
be bound to the term #$WestminsterAbbeyCathedral-London. So, for
example, if the relevant formula for this event is
(#$lineOfSight-ObjectToObject ?THING1 ?THING2), the resulting query to
be run is (#$lineOfSight-ObjectToObject
#$WestminsterAbbeyCathedral-London ?THING2) -- a query perhaps to
discover what things can be seen from Westminster Abbey.")
(comment CycLQueryInputBindingsForVarFn "(#$CycLQueryInputBindingsForVarFn VAR) denotes a
#$BinaryPredicate relating a query event to a binding value used to
restrict the replacement of a particular variable VAR in that event.")
(comment cycLQueryInputBindingList "(#$cycLQueryInputBindingList QUERY-EVENT BIND-LIST) means
that BIND-LIST is a list of ELInferenceBindings fixing the values of
some or all variables simultaneously in the cycLQueryFormula of
QUERY-EVENT.")
(comment possessiveMarkerStrings "(possessiveMarkerStrings WORD STRING) states that STRING is the preposition form for the word unit WORD.")
(comment PossessiveMarkerFrame "A syntactic frame used only for the possessive marker 's, relating a possessor and something possessed. For example, in the NP 'Daniel's dog', 'Daniel' is the possessor and 'dog' the possessed.")
(comment ShapeChangeInvolvingLosingMaterial "The collection of all events in which the shape of an object changes because the object changing loses or gains material.  This includes natural shape-change events (like tree branches falling off, or puddles evaporating in the wind), and objects changing as the result of purposeful actions (instances of #$ShapingSomething) performed by outside agents (e.g., as in carving events).")
(disjointWith ShapeChangeWithoutLosingMaterial ShapeChangeInvolvingLosingMaterial)
(comment BallTypeByGame "An instance of #$SecondOrderCollection and a specialization of #$DeviceTypeByFunction.  Each instance of #$BallTypeByGame is a collection of #$Balls designed for use in a specific type of #$Game.  Instances include #$BowlingBall and #$Baseball-Ball.")
(comment AnalyticStudy-CW "A specialization of #$WrittenReportOnSituation-CW.  Instances of this collection are written reports which describe some analytic study.")
(comment WrittenReport-GlassBoxAdHocClassification "A specialization of #$WrittenReportOnSituation-CW.  Instances of this collection are reports which describe something other than short-term, detailed, or analytic studies in the #$GlassBox-Task_Type-KS.")
(disjointWith AnalyticStudy-CW WrittenReport-GlassBoxAdHocClassification)
(comment ShortTermStudy-CW "A specialization of #$WrittenReportOnSituation-CW.  Instances of this collection are written reports which describe a short-term study of some state of affairs (#$Situation).")
(disjointWith ShortTermStudy-CW AnalyticStudy-CW)
(disjointWith ShortTermStudy-CW WrittenReport-GlassBoxAdHocClassification)
(disjointWith DetailedStudy-CW ShortTermStudy-CW)
(disjointWith DetailedStudy-CW AnalyticStudy-CW)
(disjointWith DetailedStudy-CW WrittenReport-GlassBoxAdHocClassification)
(comment HLExternalIDString "#$HLExternalIDString is the collection of all #$SubLStrings
which represent valid external ID strings for #$CycLExpressions.
Membership in this collection is determined for given strings by
evaluation of the underlying SubL code which implements the object to
ID mapping.")
(comment termExternalIDString "A predicate which relates any #$CycLExpression to an external
identification string which is guaranteed to uniquely identify the
expression in both time and space. (#$termExternalIDString EXPRESSION
ID-STRING) states that the #$HLExternalIDString ID-STRING is the string
representation of the unique external id for the #$CycLExpression
EXPRESSION. For obvious reasons, this predicate is #$notAssertible.
Also, note that this predicate is *not* a generalization of
#$constantGUID, since the latter relates a #$CycLConstant to an
entirely different string.  That is to say, the #$termExternalIDString
of a #$CycLConstant is not the same string as its #$constantGUID.")
(comment NonproliferationOfWMD "A collection of static situations in which no new agents come to be in possession of any #$WeaponOfMassDestruction.  This entsails that agents who are not currently in possession of such devices are prevented from obtaining them.")
(comment analysisScriptIteratesEventTypeWithQuerySpec "  (#$analysisScriptIteratesEventTypeWithQuerySpec SCRIPT EVENT-TYPE QUERY-SPEC) says that SCRIPT is an analysis script with an iterative scene in which EVENT-TYPE, a specialization of #$CycQueryRunning in which the query being run is given in the #$CycLQuerySpecification QUERY-SPEC, occurs iteratively.")
(comment sceneConditionedOnSentenceTruth "(#$sceneConditionedOnSentenceTruth SCRIPT SCENE SENTENCE)
means that a particular instance of SCRIPT will contain an instance of
SCENE as a #$subSituations if the conditions represented by SENTENCE
are met.")
(comment ColoredThing "An instance of #$ObjectTypeBySensibleFeature and a specialization of #$VisibleThing.  Each instance of #$ColoredThing is a #$SpatialThing-Localized which has some #$ChromaticColor (q.v.).  An instance of #$ColoredThing need not be (chromatically) colored all over; it is sufficient that some part of it is (chromatically) colored.  Thus, for example, while a completely clear window would not be an instance of #$ColoredThing, a window with a bright red pattern etched onto (part of) it would be.  #$ColoredThing is disjoint with #$ColorlessThing (q.v.).")
(disjointWith ColoredThing ColorlessThing)
(comment analysisVariableConstraints "(#$analysisVariableConstraints ANALYSIS VAR MEANING-SENT)
means that VAR is an open or existentially bound #$CycLVariable in the
#$CycLFormula representing a question asked during ANALYSIS, and
MEANING-SENT expresses the constraints on VAR. In other words, VAR is
a placeholder for something whose identity is to be discovered during
ANALYSIS, and MEANING-SENT is a #$CycLExpression representing some
conditions that must be met by that thing.")
(comment analysisTypeVariableConstraints "(#$analysisTypeVariableConstraints ANALYSIS-TYPE VAR
MEANING-SENT) means that VAR is an open or existentially bound
#$CycLVariable in the #$CycLFormula representing a question asked
during events of type ANALYSIS-TYPE, and MEANING-SENT expresses the
constraints on VAR. In other words, VAR is a placeholder for something
;whose identity is to be discovered during ANALYSIS-TYPE events, and
MEANING-SENT is a #$CycLExpression representing some conditions that
must be met by that thing.")
(comment AnalysisOutputBindingsForVarFn "(#$AnalysisOutputBindingsForVarFn VAR) denotes the
#$BinaryPredicate relating a analysis event to the binding values
found for a particular variable VAR in the CycL representation of the
focal question in that event.")
(comment AnalysisInputBindingsForVarFn "(#$AnalysisInputBindingsForVarFn VAR) denotes a
#$BinaryPredicate relating a analysis event to a binding value used to
restrict the replacement of a particular variable VAR in that event.")
(comment VariableMappingTable "The collection of all variable mapping tables.  A variable mapping table is used to assign/display variable unificaction assignments between to formulae, to form .  For example, if FORMULA-1 = (#$likesAsFriend ?PERSON-1 ?PERSON-2) and FORMULA-2 = (#$near ?OBJECT-1 ?OBJECT-2), a variable mapping table might indicate that ?PERSON-1 is to unify with ?OBJECT-1, and ?PERSON-2 is to unify with ?OBJECT-2.  Note that 'is to unify' indicates something about how the variable mapping table would be put to use by some application.  Normally, the unification would take place in a formula built truth-functionally from FORMULA-1 and FORMULA-2.  This predicate makes no assumptions about how that larger formula is constructed -- in this case, the larger formula might be (#$and (#$likesAsFriend ?X ?PERSON-2) (#$near ?X ?OBJECT-2)) or (#$implies (#$near ?X ?OBJECT-2) (#$likesAsFriend ?X ?PERSON-2)).")
(disjointWith Map VariableMappingTable)
(comment formulaVariablesUnifyInTable "(#$formulaVariablesUnifyInTable FORMULA-1 VARIABLE-1 FORMULA-2 VARIABLE-2 TABLE) says that in the #$VariableMappingTable TABLE, VARIABLE-1 and VARIABLE-2 are designated as variables to be unified, where VARIABLE-1 and VARIABLE-2 are variables that occur in FORMULA-1 and FORMULA-2, respectively.  Note that 'to be unified' indicates something about how the variable mapping table would be put to use by some application.  Normally, the unification would take place in a formula built truth-functionally from FORMULA-1 and FORMULA-2.  This predicate makes no assumptions about how that larger formula is constructed.")
(comment querySpecVariablesUnifyInTable "(#$querySpecVariablesUnifyInTable QUERY-SPEC-1 VARIABLE-1 QUERY-SPEC-2 VARIABLE-2 TABLE) says that in the #$VariableMappingTable TABLE, VARIABLE-1 and VARIABLE-2 are designated as variables to be unified, where VARIABLE-1 is such that (#$queryVariables FORMULA-1 VARIABLE-1) such that (#$softwareParameterValueInSpecification #$InferenceSentenceParameter FORMULA-1 QUERY-SPEC-1) and where VARIABLE-2 is such that (#$queryVariables FORMULA-2 VARIABLE-2) such that (#$softwareParameterValueInSpecification #$InferenceSentenceParameter FORMULA-2 QUERY-SPEC-2).  Note that 'to be unified' indicates something about how the variable mapping table would be put to use by some application.  Normally, the unification would take place in a formula built truth-functionally from FORMULA-1 and FORMULA-2.  This predicate makes no assumptions about how that larger formula is constructed.")
(comment VariableMappingTableFromAnalysisDiagramFn "(#$VariableMappingTableFromAnalysisDiagramFn DIAGRAM) denotes the instance of #$ValueTable that reflects the variable unification assignments implicit in DIAGRAM. See also #$variableMappingTableForAnalysisDiagram and #$VariableMappingTable.")
(comment variableMappingTableForAnalysisDiagram "(#$variableMappingTableForAnalysisDiagram TABLE DIAGRAM) identifies TABLE as the #$VariableMappingTable derivable from the #$AnalysisDiagram-CW DIAGRAM.  This means that DIAGRAM depicts an #$AnalysisProcedure where each step of that procedure is a query, some of the variables of which unify at various stages in the procedure, in the way indicated by TABLE.")
(comment logicalSchemaSourceMap "This predicate relates a logical schema with one or more
structured knowledge sources. See also #$physicalSchemaSourceMap.")
(comment schemaSourceMap "This predicate relates a logical or physical schema with one
or more structured knowledge sources. Usually, one of its two disjoint
spec preds, #$logicalSchemaSourceMap or #$physicalSchemaSourceMap is
asserted.")
(comment GLFBindingStatusArc "A specialization of #$GLFArc.  Instances of #$GLFBindingStatusArc are arcs that link nodes whose (underspecified) semantics is a query, and thus specify whether a query-node has bindings, lacks bindings, or whether the binding status is irrelevant.")
(comment RamadanHoliday "An instance of #$AnnualHolidayType.  Each instance of #$RamadanHoliday is an #$IslamicHoliday which is #$cotemporal with an instance of #$Ramadan-IslamicMonth, the ninth month of the #$IslamicLunarCalendar.  For Muslims (see #$MuslimPerson), each instance of #$RamadanHoliday is an extended period of #$Fasting (from dawn to sunset) and spiritual reflection.  In light of this, some may not consider #$RamadanHoliday to be a \"holiday\" in the colloquial sense.  It is, however, a #$Holiday our (semi-technical) sense.  Note that #$RamadanHoliday is disjoint with #$IslamicMonth.  For the month of Ramadan, use #$Ramadan-IslamicMonth.")
(comment KerryHinesWorkingGraph "Kerry Hines' graph")
(comment BillMathewsWorkingGraph "Bill Mathews's graph")
(comment DutchSleyWorkingGraph "Dutch Sley's graph")
(comment HolidayTypeByReligion "An instance of #$SecondOrderCollection and a specialization of #$TemporalObjectType.  Each instance of #$HolidayTypeByReligion is the collection of #$ReligiousHolidays associated with a particular #$Religion.  Instances of #$HolidayTypeByReligion include #$ChristianHoliday, #$IslamicHoliday, and #$JewishHoliday.")
(comment taskCorrespondsToBugReport "An instance of #$StrictlyFunctionalPredicate. (#$taskCorrespondsToBugReport TASK BUG-REPORT) says that TASK is the task derivable from the contents of the #$BugReport BUG-REPORT. In particular, TASK is the task of correcting whatever shortcoming or problem that BUG-REPORT describes.  For example, if BUG-REPORT describes the sudden failure of a particular KBContent test, TASK would therefore be the task of getting this test working again.  Many sub-tasks might be derivable from this (e.g., test the KBContent test code, improve the ontology in the relevant area, etc.), but these can't be functionally derived from BUG-REPORT, and so don't stand in the #$taskCorrespondsToBugReport relationship to BUG-REPORT.  See aslo #$TaskFromBugReportFn.")
(comment LaylatAlQadr-IslamicHoliday "An instance of #$AnnualHolidayType and a specialization of #$IslamicHoliday.  Each instance of #$LaylatAlQadr-IslamicHoliday is one of the last ten nights of an instance of #$Ramadan-IslamicMonth.  Though Laylat al-Qadr is believed to fall on the 23rd, 25th, or 27th night of Ramadan, no one is sure of the exact date.  Muslims [see #$MuslimPerson] believe that on this date in (#$YearFn 610), #$MuhammadTheProphet first received the revelations of the #$Koran.")
(comment IdAlFitr-IslamicHoliday "An instance of #$AnnualHolidayType and a specialization of #$IslamicHoliday.  Each instance of #$IdAlFitr-IslamicHoliday falls on the first day of an instance of #$Shawwal-IslamicMonth (though the holiday is usually celebrated during the first three days of that month).  This is a festive occasion marking the end of #$RamadanHoliday (q.v.).")
(comment IdAlAdha-IslamicHoliday "An instance of #$AnnualHolidayType and a specialization of #$IslamicHoliday.  Each instance of #$IdAlAdha-IslamicHoliday falls on the tenth day of an instance of #$DhuAlHijjah-IslamicMonth.  This holiday coincides, and is closely associated, with #$Islam's traditional #$Hajj-Pilgrimage (q.v.).")
(comment MawlidAlNabi-IslamicHoliday "An instance of #$AnnualHolidayType and a specialization of #$IslamicHoliday.  Each instance of #$MawlidAlNabi-IslamicHoliday falls on the twelfth day of an instance of #$RabiAlAwwal-IslamicMonth.  Mawlid al-Nabi commemorates the birthday of #$MuhammadTheProphet.")
(comment Ashura-IslamicHoliday "An instance of #$AnnualHolidayType and a specialization of #$IslamicHoliday-Shiite.  Each instance of #$Ashura-IslamicHoliday falls on the tenth day of an instance of #$Muharram-IslamicMonth.  Ashura commemorates an historic battle that took place in #$CityOfKarbalaIraq in (#$YearFn 680).")
(comment Muharram-IslamicHoliday "An instance of #$AnnualHolidayType and a specialization of #$IslamicHoliday.  Each instance of #$IdAlAdha-IslamicHoliday falls on the first day of an instance of #$Muharram-IslamicMonth.  This is the first day of the #$IslamicYear.")
(comment IdAlGhadir-IslamicHoliday "An instance of #$AnnualHolidayType and a specialization of #$IslamicHoliday-Shiite.  Each instance of #$IdAlGhadir-IslamicHoliday falls on the 18th day of an instance of #$DhuAlHijjah-IslamicMonth.  In #$ShiiteIslam, Id al-Ghadir commemorates the day #$MuhammadTheProphet made Ali his successor.).")
(comment IslamicHoliday-Shiite "The subset of #$ReligiousHolidays specified as part of the religion #$ShiiteIslam, but not #$Islam in general.")
(comment projectManagementMicrotheoryFor "(#$projectManagementMicrotheoryFor MT PROJECT) says that MT is the instance of #$ProjectMicrotheory that contains the assertions used in managing the project PROJECT.")
(comment BillMathewsSecondWorkingGraph "Bill's second workspace graph.")
(comment SubstituteFormulaArgPositionFn "(#$SubstituteFormulaArgPositionFn ARG-POSITION NEW-TERM FORMULA) denotes the #$CycLFormula formed by replacing the term at ARG-POSITION in FORMULA with NEW-TERM.")
(comment substituteArgPositionIn "A predicate that relates an  argument-position and a CycL term to a CycL formula in which the term appears (in that position) and a second CycL formula in which has identical arguments to the first in every argument position save the one represented by the integer; #$substituteArgPositionIn is a #$QuaternaryPredicate that relates an instance of #$FormulaArgPosition to an instance of #$CycLTerm and two instances of #$CycLFormula.  (#$substituteArgPositionIn POSITION TERM FORMULA-OLD FORMULA-NEW) means that TERM occurs as in POSITION of FORMULA-NEW and that otherwise FORMULA-OLD and FORMULA-NEW are identical.")
(comment performsWorkOfType "A #$BinaryPredicate that relates instances of #$Agent-Generic to specializations of #$Action.  <code>(#$performsWorkOfType AGT ACT-TYPE)</code> means that <code>AGT</code>  performs instances of <code>ACT-TYPE</code> as a significant part of its business-related activity.")
(comment GLFNextArc "A specialization of #$GLFArc.  Instances of #$GLFBindingStatusArc are arcs that allow linear thinkers to compose analysis diagrams without explicitly specifying multiple 'yes' arcs from a single node.")
(comment GLFYesNoArc "A specialization of #$GLFArc.  Instances of #$GLFBindingStatusArc are arcs that specify decision points based on whether a query-node has bindings or not.")
(disjointWith GLFYesNoArc GLFNextArc)
(comment forecastedAmbientPressure "(#$forecastedAmbientPressure FORECAST PRESSURE) relates an instance of #$WeatherForecast-PCW FORECAST has predicted an #$ambientPressure for a particular region and time duration.  See also weatherForecastForRegion.")
(comment interArgResultGenlPred "A quaternary #$MetaRelation predicate for stating that a certain kind of complex, partly #$genlPreds based relationship holds between a given argument to a given function and the corresponding value that is returned. (#$interArgResultGenlPred FUNC N INDEPENDENT-ARG-PRED DEPENDENT-ARG-PRED) means that, when SPEC is a specialization of INDEPENDENT-ARG-PRED such that (#$genlPreds SPEC-PRED INDEPENDENT-ARG-PRED) holds,  if SPEC-PRED  appears as the Nth argument to FUNC, then (regardless of what the other arguments to FUNC might be) the value (if any) of that function for those arguments is a predicate that is a specialization of DEPENDENT-ARG-PRED.  That is: if SPEC-PRED is a predicate that is a specialization of INDEPENDENT-ARG-PRED and (FUNC ARG(1) ... ARG(N-1) SPEC-PRED ...) = VALUE, then VALUE is a predicate that is a specialization of DEPENDENT-ARG-PRED.  Note that, unlike (e.g.) the #$InterArgTypePredicates, #$interArgResultGenlPred _cannot_ be used to put semantic well-formedness constraints on functions.")
(comment toTheSideOf "(#$toTheSideOf OBJ1 OBJ2) says that OBJ1 is located to OBJ2's left or right side.  Thus the arg2 of #$toTheSideOf is restricted to instances of #$LeftAndRightSidedObject. The arg1 can be any instance of #$SpatialThing-Localized.  Because of this asymmetry in argument restrictions, #$toTheSideOf is not sufficient for representing all cases in which one object is to the right or left of another (see #$toTheRightOf and #$toTheLeftOf).  Note that this predicate cannot be used to state that an object is to the side of another, from the perspective of a third party, except as an argument in a #$perceivesThat assertion.")
(comment preservesGenlPredsInArg "(#$preservesGenlPredsInArg FUNC N) means that when #$genlPreds holds between successive arguments in the predicate-denoting function FUNC's Nth argument-place, #$genlPreds also holds between the corresponding successive values of FUNC.  In other words, (#$preservesGenlPredsInArg FUNCTION N) means that the #$PredicateDenotingFunction FUNCTION has the following property: argument place N of FUNCTION is constrained to instances of #$Predicate, and if PRED1 and PRED2 can both serve as the Nth argument of FUNCTION, and PRED2 is a specialization of PRED1 (so that (#$genlPreds PRED2 PRED1) holds), then (#$genlPreds (FUNCTION ARG_1 ARG_2 ... ARG_N-1 PRED1   ... ARG_M) (FUNCTION ARG_1 ARG_2 .. ARG_N-1 PRED2 ... ARG_M)) also holds, where ARG_1, ARG_2, ..., ARG_M (where M is the #$arity of FUNCTION) are admitted arguments for FUNCTION (see #$admittedArgument). See also the collection #$GenlPredsPreservingFunction.")
(comment GenlPredsPreservingFunction "A specialization of #$PredicateDenotingFunction (q.v.).  Each instance FUNC of #$GenlPredsPreservingFunction is a predicate-denoting function such that whenever #$genlPreds holds between successive arguments (in some particular argument-place) to FUNC, it holds between the corresponding successive values as well.  That is, (#$preservesGenlPredsInArg FUNC N) holds for some N.
<p>
More precisely, a function FUNC is a #$GenlPredsPreservingFunction if and only if it has an argument-place (say the Nth) such that the following hold:
<p>
(i) (#$resultIsa FUNC #$Predicate)
<p>
(ii) (#$argIsa FUNC N #$Predicate)
<p>
(iii) if (#$genlPreds SPEC-PRED GENL-PRED) holds and FUNC is defined for both <... SPEC-PRED ...> and <... GENL-PRED ...> (where SPEC-PRED and GENL-PRED are the respective Nth items in these otherwise identical sequences), then (#$genlPreds (FUNC ... SPEC-PRED ...) (FUNC ... GENL-PRED ...)) holds.
<p>
For example, #$BinaryRoleTypePredFn is an instance of #$GenlPredsPreservingFunction.  Just as #$primaryObjectMoving (the relation that holds between an event and the primary object moving in it) is a specialization of #$objectMoving (the relation that holds between an event and objects moving in it), (#$BinaryRoleTypePredFn #$primaryObjectMoving) (the relation that holds between an event and the type of primary object moving in it) is a specialization of (#$BinaryRoleTypePredFn #$objectMoving) (the relation that holds between an event and the type of any object moving in it).")
(comment Council-Organization "The collection of all councils. A council may, depending on it's purpose, operate in an advisory, executive, or legislative capacity.")
(comment IndependenceDay-Israel "An instance of #$AnnualHolidayType and a specialization of #$FoundingOfCountryCelebration.  Each instance of #$IndependenceDay-Israel is a #$Holiday falling on the fifth day of an instance of #$Iyar-JewishMonth.  #$IndependenceDay-Israel commemorates the establishment of #$Israel on 14 #$May 1948--or 5 Iyar 5708 in the #$JewishCalendar.")
(comment drugTherapyUseOfType "The #$functionCorrespondingPredicate for #$DrugTherapyUseFn. (#$drugTherapyUseOfType THERAPY SUBSTANCE-TYPE) says that THERAPY is the collection of all instances of #$DrugTherapy where SUBSTANCE-TYPE is the substance used to therapeutic effect.")
(comment SellingAtDiscount "The collection of #$OfferingForSale events in which an agent offers something for sale at a discounted price.")
(comment DutchSleySecondWorkingGraph "Dutch Sley's Second Working Graph.")
(disjointWith GLFQueryNode GLFAssertionNode)
(disjointWith GLFAssertionNode GLFValueTableNode)
(disjointWith GLFQueryNode GLFValueTableNode)
(comment GLFBindingStatusArc-NonQuery "A specialization of #$GLFArc.  Instances of #$GLFBindingStatusArc are arcs linking pairs of nodes in a #$GLFAnalysisDiagramGraph, one of which is either an assertion node (cf. #$GLFAssertionNode) or a value table node (cf. #$GLFValueTableNode).")
(comment BoseEinsteinCondensate-StateOfMatter "A specialization of #$PartiallyTangible and an instance of #$MatterTypeByPhysicalState. Each instance of #$BoseEinsteinCondensate-StateOfMatter is an object in the Bose-Einstein Condensate State of Matter. This state of matter only exists very close to absolute zero.  See: http://en.wikipedia.org/wiki/Bose-einstein_condensate")
(comment FermionicCondensate-StateOfMatter "A specialization of #$PartiallyTangible and an instance of #$MatterTypeByPhysicalState. Each instance of #$FermionicCondensate-StateOfMatter is an object in the Fermionic Condensate State of Matter. Unlike #$BoseEinsteinCondensate-StateOfMatter, which contains only Bosons, #$FermionicCondensate-StateOfMatter contains fermions. This state of matter only exists very very close to absolute zero.  See: http://en.wikipedia.org/wiki/Bose-einstein_condensate")
(comment OngoingCycorpProject "The intersection of both #$OngoingStatus and
#$CycorpProject.  Each instance of this collection is a Cyc project
that is, in some temporal context, on-going.")
(disjointWith ReligiousHoliday SecularHoliday)
(comment SecularHoliday "An instance of #$TemporalObjectType.  Each instance of #$SecularHoliday is a #$Holiday which is not religious in nature.  Specializations of #$SecularHoliday include #$NewYearsDay, #$MothersDay, and #$ValentinesDay.")
(comment contentOfCreatedIBO-AIS "An assertion of the form (#$contentOfCreatedIBO-AIS EVENT AIS)  is used to relate an instance of #$AbstractInformationStructure to an  instance of #$IBOCreation.   Specifically, if IBO is a created  #$InformationBearingObject within EVENT such that (#$iboCreated EVENT IBO)  and IBO contains the information of  AIS (such that  (#$containsInfoStructure-IBT IBO AIS), then it is the case that AIS plays  this role within EVENT (#$contentOfCreatedIBO-AIS EVENT AIS).  For  example, the process of writing an email is the creation of an   #$InformationBearingObject within some hardware somewhere. However, that  object is different from the abstract entity that is the content of that  object. #$contentOfCreatedIBO-AIS is intended to represent the abstract  entity's role in the creation process.")
(comment cityMayor "(cityMayor CITY PERSON) means that PERSON serves in a leadership role in CITY such that s/he holds the title of 'cityMayor'.")
(comment HairOnHead-Human "An instance of #$AnimalBodyPartType and a specialization of #$HairOnHead and #$HumanHair-Stuff.  Each instance of #$HairOnHead-Human is a #$MobOfHair-Mammal found on an instance of #$HomoSapiens.")
(comment HumanHair-Stuff "The collection of the material of which #$Hair-Strands of instances of #$HomoSapiens are composed.")
(comment InfectionSite "An instance of #$ExistingObjectType.  Each instance of #$InfectionSite is an #$AnimalBodyPart PART such that for some #$Infection INFECTION, (#$infectionAffectsPart INFECTION PART).  Specializations include #$PrimaryInfectionSite and #$SecondaryInfectionSite.")
(comment coGenlPreds "A #$MetaPredicate and a specialization of #$genlPreds (q.v.) that is used to state that one predicate is both a generalization and a specialization of another. <code>(#$coGenlPreds PRED1 PRED2)</code> means that <code>PRED1</code> is a generalization of  <code>PRED2</code> and <code>PRED2</code> is a generalization of <code>PRED1</code>.  That is, for any argument-sequence <code>ARGS</code>, <code>(PRED1 . ARGS)</code> holds if and only if <code>(PRED2 . ARGS)</code> holds.
<p>
For example:
<p>
<pre>
  (#$coGenlPreds #$physicalPartTypes
    (#$Kappa
      (?SUPER-TYPE ?SUB-TYPE)
      (#$relationAllExists #$physicalParts ?SUPER-TYPE ?SUB-TYPE))) .
</pre>")
(comment roleMapping-Identity "An assertion of the form (#$roleMapping-Identity SIT-TYPE TYPE SET) is used to represent a role-mapping relations between actors of TYPE within instances of SIT-TYPE.  The relevant set of roles is captured by SET.  SET is a set of lists, each element of which has two elements.  The first element is a sub-collection of #$Situation that SIT-TYPE has as at least a candidate scene (see: #$candidateProperSubSituationTypes) and the second element is a #$BinaryRolePredicate.  Specifically, it asserts that if LIST contains as elements (#$TheList SUBSIT-TYPE1 ROLE1) and (#$TheList SUBSIT-TYPE2 ROLE2), given certain other conditions, this entails that whatever plays ROLE1 in the instance of SUBSIT-TYPE1 is identical to the player of ROLE2 in the instance of SUBSIT-TYPE2.")
(comment roleMapping-Equivalence "An assertion of the form (#$roleMapping-Equivalence SIT-TYPE TYPE SET) is used to represent a role-mapping relations between actors of TYPE in the sub-events of instances of SIT-TYPE.  The relevant set of roles is captured by SET.  SET is a set of lists, each element of which has two elements.  The first element is a sub-collection of #$Situation that SIT-TYPE is either identical to or which SIT-TYPE has as at least a candidate scene (see: #$candidateProperSubSituationTypes) and the second element is a #$BinaryRolePredicate.  Specifically, it asserts that if SET contains as elements (#$TheList SUBSIT-TYPE1 ROLE1) and (#$TheList SUBSIT-TYPE2 ROLE2), given certain other conditions, this entails that any instance of TYPE playing ROLE1 in the instance of SUBSIT-TYPE1 will also play ROLE2 in the instance of SUBSIT-TYPE2. It is worth noting that SUBSIT-TYPE1 and SUBSIT-TYPE2 can be identical, or one could be identical to SIT-TYPE itself.")
(comment SitTypePredicate-RoleMappingByPath "#$SitTypePredicate-RoleMappingByPath is a collection of predicates which are used to represent relations among actors of a given type within instances of a type of complex #$Situation.  Roughly, the instances of this collection point to a rule or rules which will specify the types of inferences that can be made about these associated actors.  For example, (#$roleMapping-Identity SIT-TYPE TYPE SET), where (#$TheList SUBSIT-TYPE1 ROLE1) and (#$TheList SUBSIT-TYPE2 ROLE2) are elements of SET, means that in any instance of SIT-TYPE, instances of TYPE playing ROLE1 in the #$subSituations of type SUBSIT-TYPE1 and playing ROLE2 in the #$subSituations of type SUBSIT-TYPE2 are identitical, given certain conditions.  SUBSIT-TYPE1 and SUBSIT-TYPE2 could be identical to each other or one could be identical to SIT-TYPE.  The different predicates represent different relations among the actors. When creating new instances of the collection #$SitTypePredicate-RoleMappingByPath it is important to make sure that it is either a spec pred of an existing predicate or that you create a rule that allows for the inferences to assertions involving the predicate #$roleMappingOverlap. See #$roleMappingOverlap for examples of the type of rules which are needed.")
(comment roleMappingOverlap "An assertion of the form (#$roleMappingOverlap SIT-TYPE TYPE SUBSIT-TYPE ROLE) states that in instances of the complex type of #$Situation SIT-TYPE, there can be more than one instance of TYPE playing ROLE in the #$subSituations of the situation-instance which is itself an instance of SUBSIT-TYPE.  Additionally, and more significantly,  the different instances can go on to play seprate roles in other scenes.  So, the instances are following different role-mappings through SIT-TYPE, but those role-mappings share a common point at ROLE in the #$subSituations that is an instance of SUBSIT-TYPE.  These path crossings are inferentially significant because if one only knows that an actor is playing ROLE in an instance of SUBSIT-TYPE in an instance of of SIT-TYPE, one cannot deductively infer what other roles that actor is playing.  Other information is required.  For example, in a script representing the hijacking of an #$Airplane during flight, there will be many instances of #$Person who play  the role of #$transportees during the first stage of the flight.  However, only some of those #$transportees will go on to play the role of #$hijackerPerpetrator while others will go on to play the role of #$crimeVictim.  Although it is safe to infer that the instances of #$Person playing the role of #$hijackerPerpetrator had played the role of #$transportees, the inference from #$transportees to #$hijackerPerpetrator cannot be deductively inferred because some of the #$transportees play the role #$crimeVictim.  So, we introduce the predicate #$roleMappingOverlap to block incorrect inferences while allowing for the representation of the relevant facts.")
(comment roleMapping-Branch "An assertion (#$roleMapping-Branch SIT-TYPE TYPE BRANCH-SET LINK-LIST) is used to represent a role-mapping relation among actors within instances of specs of #$Situation.  Specifically, it is used to represent situations where multiple actors fill a set of common roles, but where those actors are only a subset of the actors who fill some other roles in other scenes.  The argument BRANCH-SET is used to represent the first set of roles.  BRANCH-SET is a set of lists with the following structure: (#$TheSet (#$TheList SUBSIT-TYPE-1 ROLE-1) ... (#$TheList SUBSIT-TYPE-N ROLE-N) ...).  Assertions using this predicate behave similarly to #$roleMapping-Equivalence in terms of their arguments SIT-TYPE TYPE and BRANCH-SET.  Thus, in an instance of SIT-TYPE, if an actor of TYPE plays ROLE-1 in a #$subSituations of type SUBSIT-TYPE-1, then that actor will play ROLE-N in a #$subSituations of type SUBSIT-TYPE-N and vice-versa.  The difference comes in the relation to the argument LINK-LIST.   LINK-LIST also represents a role within a scene, and LINK-LIST could be an element of LIST for some assertion of the form (#$roleMapping-Equivalence SIT-TYPE TYPE LIST), where SIT-TYPE and TYPE are the same as above.  Thus, the LINK-LIST could be used to connect the BRANCH-SET to a single role and scene pair, or to an entire  set of roles and scenes that are another actor path for TYPE within SIT-TYPE.  As an example, consider the process of staying overnight at a hotel.  If the guests are all one family, all of the members of the family will arrive, stay over night, and depart.  However, only a subset of the family will perform the actions of checking in and checking out.  In order to capture this structure, you can place the checking in event type on one branch and checking out event type on another branch (presuming that there is no guarantee that the same actor will perform both actions) and have those branches connect up to a path that involves the other activities associated with staying at a hotel.  If there are multiple roles in scenes associated with a branch, then they should all be listed as a sublist which is an element of the argument BRANCH-SET.")
(comment roleMapping-Collaboration "An assertion of the form (#$roleMapping-Collaboration SIT-TYPE TYPE LIST) is used to represent the relationship between actors of TYPE within instances of SIT-TYPE.  The relevant set of actors is captured by SET, a set of lists,  each element of which is a list of two elements.  The first element is a sub-collection of #$Situation that SIT-TYPE has as at least a candidate scene (see: #$candidateProperSubSituationTypes) and the second element is a #$BinaryRolePredicate.  Specifically, it asserts that if SET contains as elements (#$TheList SUBSIT-TYPE1 ROLE1) and (#$TheList SUBSIT-TYPE2 ROLE2) then, in any instance of SIT-TYPE, for any two actors that are instances of TYPE, where one is playing ROLE1 in the sub-eventof type  SUBSIT-TYPE1 and the other is  playing ROLE2 in the sub-event of type SUBSIT-TYPE2, those two actors are #$collaborators for the duration of the instance of SIT-TYPE.")
(comment roleMapping-Branch-Identity "An assertion (#$roleMapping-Branch-Identity SIT-TYPE TYPE BRANCH-SET LINK-LIST) is used to represent the inheritance relations among actors within instances of some complex type of #$Situation.  Specifically, it is used to represent situations where a single actor fills a set of common roles, but and then goes on to be one of possibly several actors who fill some other roles in other scenes.  The argument BRANCH-SET is used to represent the first set of roles.  BRANCH-SET is a set of lists with the following structure: (#$TheList (#$TheList SUBSIT-TYPE-1 ROLE-1) ... (#$TheList SUBSIT-TYPE-N ROLE-N) ...).  Assertions using this predicate behave similarly to #$roleMapping-Identity in terms of their arguments SIT-TYPE TYPE and BRANCH-SET.  Thus, in an instance of SIT-TYPE, if an actor of TYPE plays ROLE-1 in a #$subSituations of type SUBSIT-TYPE-1, then that actor is numerically identical to the actor playing ROLE-N in a #$subSituations of type SUBSIT-TYPE-N.  The difference comes in the relation to the argument LINK-LIST.   LINK-LIST also represents a role within a scene, and it could be that  LINK-LIST will be an element of LIST for some assertion of the form (#$roleMapping-Equivalence SIT-TYPE TYPE LIST), where SIT-TYPE and TYPE are the same as above.  Thus, the LINK-LIST could be used to connect the BRANCH-SET to a single scene-role pair, or to several scene-role pairs that are another actor path for TYPE within SIT-TYPE.  Because the roles on BRANCH-SET only entail the roles on LINK-LIST, there is no identity constraint on the role in LINK-LIST or any othe role-mapping structure of which LINK-LIST is a part.")
(comment CellularTelephoneLine "The collection of all #$TelephoneSubscriberLines for cellular telephones.")
(comment htmlTagSymbol "(#$htmlTagSymbol TAG SYMBOL-STRING) means that SYMBOL-STRING is the tag as used in HTML.")
(comment Anchor-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to identify a hyperlink anchor or fragment.")
(comment Applet-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to identify an executable applet within a text flow.")
(comment Area-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to identify a mouse-sensitive area in a client-side image map.")
(comment B-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to identify bold text.")
(comment Base-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to designate the base #$UniformResourceLocator for relative addresses within the document.")
(comment Basefont-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to designate the font size for subsequent text.")
(comment Big-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to format the enclosed text in a bigger typeface.")
(comment Br-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to break the current text flow, resuming at the next line.")
(comment Button-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to create an input button within a #$Form-HTMLTag.")
(comment Center-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to center the enclosed text.")
(comment Code-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to render the enclosed text as program code.")
(comment Colgroup-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a column group within a #$Table-HTMLTag.")
(comment Dir-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a file directory listing of #$Li-HTMLTag tags.")
(comment Fieldset-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a set of elements in a #$Form-HTMLTag.")
(comment Font-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to designate the font size for enclosed text.")
(comment Form-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define an input form.")
(comment Frame-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a frame within a #$Frameset-HTMLTag.")
(comment Frameset-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a frame set containing #$Frameset-HTMLTags.")
(comment Head-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define the head section of the HTML document.")
(comment Hr-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to render a horizontal rule.")
(comment HTML-HTMLTag "The outermost #$CharacterString used in instances of #$HTMLSource to enclose the remainder of the document.")
(comment I-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to render the enclosed text in italic font.")
(comment Iframe-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define an inline frame.")
(comment Input-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define an input mode and elements, such file, image, radio-button, reset and submit-button.")
(comment Ins-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define inserted sections of the document.")
(comment Isindex-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define an form-like element consisting of a prompt and single input field.")
(comment Kbd-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to render the enclosed text as typed via the keyboard.")
(comment Label-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a label for #$Form-HTMLTag control.")
(comment Legend-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a legend for a #$Fieldset-HTMLTag.")
(comment Link-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a link between the enclosing document and another document in the document #$Head-HTMLTag.")
(comment Map-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define the hotspots in a client-side image map.")
(comment Menu-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a menu containing #$Li-HTMLTags.")
(comment Meta-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to provide additional information about the document.")
(comment Noframes-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define content to be used by web browsers that do not support #$Frame-HTMLTags.")
(comment Object-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define an object inserted into a document.")
(comment Optgroup-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a set of options within a #$Select-HTMLTag.")
(comment Option-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a selection option within a #$Select-HTMLTag.")
(comment Param-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a parameter for a containing #$Applet-HTMLTag.")
(comment Plaintext-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to render the remaining document as preformatted plain text.")
(comment Pre-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to render the enclosed preformatted text using the given spacing and line breaks.")
(comment S-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to render the enclosed text with a struck through horizontal rule.  This tag has the same effect as #$Strike-HTMLTag.")
(comment Samp-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to indicate that the enclosed text is a sample.")
(comment Script-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a procedural script within a document.")
(comment Select-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a multiple choice list or scrolling list of #$Option-HTMLTags within a #$Form-HTMLTag.")
(comment Small-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to render the enclosed text with a smaller font.")
(comment Span-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a span of text for style application.")
(comment Strike-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to render the enclosed text with a struck through horizontal rule.  This tag has the same effect as #$S-HTMLTag.")
(comment Style-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define one or more rendering styles at the document level.")
(comment Sub-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to render the enclosed text with a subscript style.")
(comment Sup-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to render the enclosed text with a superscript style.")
(comment Tbody-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a row group within a #$Table-HTMLTag.")
(comment Textarea-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define multiline text input area within a #$Form-HTMLTag.")
(comment Tfoot-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define a table footer cell within a #$Table-HTMLTag.")
(comment Thead-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to identify a heading for a #$Table-HTMLTag.")
(comment Title-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to define the title of the document.")
(comment Tt-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to render the enclosed text with a teletype (monospace) font.")
(comment Var-HTMLTag "The #$CharacterString used in instances of #$HTMLSource to render the enclosed text as a variable name.")
(comment nounCompoundParsesUsingRule "(#$nounCompoundParsesUsingRule STRING CYCL RULE) means that CYCL is a possible meaning of STRING, interpreted as a noun compound licensed by RULE.")
(disjointWith OrganizationMerger-CreationEvent OrganizationMerger-NonCreationEvent)
(comment typePlaysRoleWithFrequency "An instance of #$RuleMacroPredicate, a type-level version of #$playsRoleWithFrequency. (#$typePlaysRoleWithFrequency TYPE SITTYPE ROLE
FREQ) means that every instance of TYPE plays ROLE in instances of SITTYPE with
the frequency FREQ.")
(comment educationInFieldSufficientForActType "(#$educationInFieldSufficientForActType EDU-LEVEL FIELD ACT-TYPE) holds just in case someone with an education level of EDU-LEVEL who is competent in FIELD would be capable of learning to (#$capableOfLearningTo) perform acts of ACT-TYPE.  This predicate states that anyone with the EDU-LEVEL and competence FIELD, as a default, would likely have the knowledge to perform acts of ACT-TYPE or could easily obtain that knowledge.  This entails that the basic procedures for performing acts of ACT-TYPE are known to that person or could easily be grasped with a minimal to moderate amount of study.  This predicate captures a sufficient condition on the educational requirements for performing act types, it doesn't state anything about further skills or materials that may be necessary to perform act of type ACT-TYPE. So, this does not entail that anyone with that education level and competence in the field would be able in some stronger sense to perform acts of that type.")
(comment physicalFieldXPathString "This predicate relates a physical field to an XPath query which uniquely 
identifies from which node in the DOM model of an HTML page to extract the
field's value.")
(comment physicalFieldXPath "This predicate is used to describe how to extract a physical
field value from the DOM object of an HTML document.
(#$physicalFieldXPath FIELD PATHLIST) relates the physical field FIELD
with PATHLIST, an #$XPathSearchList which describes how to traverse
the DOM object of some HTML document (presumably the result of a web
query) in order to extract the value for FIELD from the document.")
(comment precisionSuggestionForGivenTypeWhenUnboundInArg "A predicate used to offer intelligent precision suggestions when parsing user NL questions. (#$precisionSuggestionForGivenTypeWhenUnboundInArg UNDERSPECIFIED-PRED FIXED-ARG-POSITION TYPE PRECISION-SUGGESTION OPEN-ARG-POSITION) says that if a user utterance QUERY is parsed into a sentence of the form, (UNDERSPECIFIED-PRED ... TERM-IN-FIXED-ARG-POSITION ... VARIABLE-IN-OPEN-ARG-POSITION) where VARIABLE-IN-OPEN-ARG-POSITION is an unbound variable appearing in the argument position OPEN-ARG-POSITION and TERM-IN-FIXED-ARG-POSITION appears in the argument position FIXED-ARG-POSITION and denotes an instance of TYPE, then the user should be offered (PRECISION-SUGGESTION ... TERM-IN-FIXED-ARG-POSITION ... VARIABLE-IN-OPEN-ARG-POSITION) as a possible precisification of his or her input.  For example, (#$precisionSuggestionForGivenTypeWhenUnboundInArg #$sizeParameterOfObject 1 #$GeopoliticalEntity #$numberOfInhabitants 2) says that if a user utterance is parsed into (#$sizeParameterOfObject #$CityOfParisFrance ?SIZE), the user should be offered (#$numberOfInhabitants #$CityOfParisFrance ?SIZE) as a possible precisification.")
(comment mustPrecisifyWhenUnboundInArg "(#$mustPrecisifyWhenUnboundInArg PREDICATE N) says that when parsing user input into a formula FORMULA of the form (PREDICATE ... ARG-N . ARGS), such that ARG-N occurs as a variable in the Nth position of FORMULA, the system must offer an alternative formula in addition to or in lieu of FORMULA to the user.  What formulae to offer is dependent on KB content; see #$typedGenlPreds, #$kePrecisionSuggestionByTypeRestriction-*, and #$precisionSuggestionForGivenTypeWhenUnboundInArg.")
(comment NLParsingDirectivePredicate "A collection of #$Predicates.  Instances of #$NLParsingDirectivePredicate are predicates that can be used to make assertions that affect the behavior of the NL parsing code.")
(comment capableOfLearningTo "This is a generalization of #$learnedCapableOf.  (#$capableOfLearningTo AGT ACT-TYPE ROLE) holds just in case AGT has the required background knowledge that would enable him/her to either immediately play ROLE in acts of type ACT-TYPE, or could learn to do so in a relatively short time.  The time required for AGT to learn to do acts of type ACT-TYPE depends on the act type.  For instance, nuclear physicists are likely to have the required background knowledge that would enable them to, after some study, design a nuclear weapon.  A person with a bachelor's degree in business would likely have the background knowledge required to write a particular kind of report, though he/she may have to examine some previous reports of that nature to understand exactly what to do.  The time required for the physicist to learn how to design a bomb and the business person to learn how to write the report probably vary greatly.  While a few months may be a short time to learn how to design a weapon, a few days is probably much longer than what is needed to learn to write a report.")
(comment pphVariableIsaConstraintTestCase "A predicate for storing test cases for PPH-VARIABLE-ISA-CONSTRAINTS in the KB.
(#$pphVariableIsaConstraintTestCase VARIABLE FORMULA COLLECTION) means that calling (PPH-VARIABLE-ISA-CONSTRAINTS VARIABLE FORMULA) in #$BaseKB should return a list starting with COLLECTION.")
(comment RelationalNCRuleFn "(#$RelationalNCRuleFn PRED NUM WORD) denotes a particular form of #$NounCompoundRule which can be derived on the basis of #$denotesArgInReln assertions for which PRED, a #$BinaryPredicate,  is the arg3, NUM is the arg4, and WORD is the arg1.  So, for example, (#$RelationalNCRuleFn #$owns 1 #$Own-TheWord) denotes a rule for interpreting compounds like \"car owner\". In general, the form of the #$ncRuleTemplate for the derived rule will be either (#$SubcollectionOfWithRelationToTypeFn COL PRED #$TheNCModifier) or (#$SubcollectionOfWithRelationFromTypeFn COL PRED TheNCModifier) depending on whether NUM has a value of 1 or 2 (respectively).  In either case, the value for COL will correspond to the NUMth argIsa constraint for PRED,   Furthermore, #$ncRuleConstraints for the derived rule will generally be inferred on the basis of the arg constraints of PRED and the #$denotesArgInReln assertion(s) which license the rule.")
(comment queryPracticeSentences "(#$queryPracticeSentences QUERY SENTENCE) means that SENTENCE is a useful true sentence (cf. #$trueSentences) for the system to use when trying to answer QUERY.  For example, (#$queryPracticeSentences IsLenatAMammal-Query (#$genls #$Person #$Mammal)) says that in answering the #$CycLQuerySpecification IsLenatAMammal-Query, the sentence (#$genls #$Person #$Mammal) should be useable by the system in answering the question correctly.  If SENTENCE is an assertion, use either #$queryPracticeRules or #$queryPracticeGAFs as appropriate.")
(comment hotelHasAsGuest "(#$hotelHasAsGuest HOTEL-BUILDING GUEST) holds just in case GUEST is a currently registered occupant of some guest room in HOTEL-BUILDING.  This also entails that GUEST has some particular agreement with the organization that runs HOTEL-BUILDING.  This does not entail that GUEST could be found at HOTEL-BUILDING during the time at which the assertion is true.  Hence, this is not a #$genlInverse of #$objectFoundInLocation.")
(comment facets-NearPartition "A #$TaxonomicSlotForCollections and a specialization of both #$facets-NearCovering and #$facets-NearStrict (qq.v.).  (#$facets-NearPartition COL COLTYPE) holds if and only if both (#$facets-NearCovering COL COLTYPE) and (#$facets-NearStrict COL COLTYPE) hold.")
(comment GeneralCycKBIntegrityTestingTask "This task runs the test set #$GeneralCycKBIntegrityTest on a recurring basis, and notifies the #$testResponsibleCyclist of the success or failure of each individual test within that set.")
(comment mergedConstantGUID "<code>(#$mergedConstantGUID CONSTANT GUID)</code> means that the #$CycLConstant <code>CONSTANT</code> has had another #$CycLConstant (the one that was associated with the #$GUIDString <code>GUID</code>) merged onto it. See also #$mergedConstantName.")
(comment sentenceHasClarificationOptions "An instance of #$NLParsingDirectivePredicate that directs the system to offer certain sentences as possible clarifications of a given NL or template input for which the semantics are assumed to be not-yet fully understood.  (#$sentenceHasClarificationOptions SOURCE CLARIFICATION) says that the sentence CLARIFICATION is a plausible clarification of SOURCE, the intitial semantics ascribed for some user input.  For example, (#$sentenceHasClarificationOptions (#$possessiveRelation #$DaveS #$Bailey) (#$hasPets #$DaveS #$Bailey)) says that (#$hasPets #$DaveS #$Bailey) is a promising clarification (in this case, a strengthening) of (#$possessiveRelation #$DaveS #$Bailey).")
(comment sentenceHasClarificationSet "An instance of #$StrictlyFunctionalSlot, #$sentenceHasClarificationSet relates a sentence to the set of all sentences that are reasonable clarifications of that sentence.  More formally, (#$sentenceHasClarificationSet SENTENCE SET) says that each element SET is a sentence S such that (#$sentenceHasClarificationOptions SENTENCE S).")
(comment DogTypeByBreed "A collection of collections. Each #$DogTypeByBreed is a
collection of #$Dogs with a common history of development. Generally, 
instances of #$DogTypeByBreed are also instances of one of its specializations: #$DogTypeByBreed-Pure, #$DogTypeByBreed-Wild, and #$DogTypeByBreed-Mix. Because of the historical development of #$Dogs with specific traits useful to #$HomoSapiens (task-suitable temperament, behavior, and physical form), classification of #$Dogs according to #$DogTypeByBreed is common even when that ancestry is not
restricted to an identifiable  pure breed or wild type.  Mixed-breed dogs,
for example, are often classified by the types of dogs they appear to
have as close ancestors.")
(comment DogTypeByBreed-Wild "A collection of collections, a specialization of
#$DogTypeByBreed. Each #$DogTypeByBreed is a collection of
#$Dogs with a similar genetic heritage and physical type, usually resulting naturally from the interbreeding of wild dogs in a particular location. Unlike instance of 
#$DogTypeByBreed-Pure, instances of #$DogTypeByBreed-Wild are
not the direct result of intentional human intervention.  Each
#$DogTypeByBreed-Wild is a specialized type of dog that occurs in
the wild, that is, in at least one freely-reproducing population
living apart from direct control by humans. A typical examples is
the #$Dingo.")
(comment DogTypeByFunctionalGroup "A collection of collections. Each #$DogTypeByFunctionalGroup
is a collection of #$Dogs according to the activities for which their
type has been specially bred.  Typical instances of
#$DogTypeByFunctionalGroup include #$Hound and #$Terrier-FunctionalGroup, each of which collects together dogs bred to perform a specialized type of activity
related to #$Hunting. Note that the proper functional grouping of #$Dogs is subject to disagreement, and that related assertions most often belong in a lower mt, one specific to some organization concerned with dog standards.")
(comment DogTypeByPhysicalVariety "A collection of collections. Each #$DogTypeByPhysicalVariety is a collection of #$Dogs according to some shared physical characteristic. Common points of variation include coat type, coat
color, and size.  Many instances of #$DogTypeByBreed-Pure are further
divided by #$DogTypeByPhysicalVariety, as for example in (#$MiniatureSizedVarietyFn #$Dachshund).  Note that the classification of a dog type as a Breed or Variety can be subject to some disagreement. Related assertions should therefore be made in a lower microtheory, such as one specific to an organization concerned with dog standards.")
(comment DogTypeByBreed-Mix "A collection of collections, a specialization of
#$DogTypeByBreed. Each #$DogTypeByBreed-Mix is a collection of #$Dogs
sharing a particular blend of ancestry.  That ancestry may be
identified as involving some specific #$DogTypeByBreed-Pure,
#$DogTypeByBreed-Wild, #$DogTypeByPhysicalVariety, #$DogTypeByFunctionalGroup, or even one or more instances of #$DogTypeByBreed-Mix. Note also that breed mixes may be specified only by approximation, referring only to the functional type whose traits a #$Dog appears to have inherited, as when we say that a particular #$Dog must have some #$Hound in him. For that reason, a #$DogTypeByBreed-Mix may also be indentified as involving some #$DogTypeByFunctionalGroup.  Examples of
such mix identifications one might commonly see include Lab x Collie 
mix, Dingo mix, and Hound mix, respectively.")
(comment DogTypeByBreedAndVariety "A collection of collections. Each #$DogTypeByBreedAndVariety
is a collection of #$Dogs according to some #$DogTypeByBreed and some shared,
distinguishing physical characteristic (see #$DogTypeByPhysicalVariety). Common points of variation include coat type, coat color, and size. Many instances of
#$DogTypeByBreed are standardly recognized as having distinct
varieties, such as the (#$MiniatureSizedVarietyFn #$Dachshund). Note, however, that the classification of a dog type as a #$DogTypeByBreed, #$DogTypeByPhysicalVariety, or #$DogTypeByBreedAndVariety can be a matter of disagreement.  Related assertions should therefore be made in a lower microtheory, such as one specific to an organization with dog standards as a primary concern.")
(comment Any-NLAttr "The attribute value carried by utterances of the form
 \"any XXX\".")
(comment TimeBomb "The collection of all time bombs.  Every instance of #$TimeBomb is an explosive device that is set to detonate by means of an clock-like device attached to the bomb.")
(comment MammalianHairType "A collection of collections. Each #$MammalianHairType is the
collection of bunches of mammal hair, as in an individual animal's
coat, or a portion thereof, with some conventionally recognized
property in common, such as color, texture, or length.")
(comment HairOfColorTypeFn "A collection-denoting function. (#$HairOfColorTypeFn COLOR)
denotes the specialization of #$MobOfHair-Mammal such that each of its
instances has the color COLOR. For instance, (#$HairOfColorTypeFn
#$BlackColor) denotes the collection of all bunches of (at least
partially) black hair.")
(comment HairOfPatternTypeFn "A collection-denoting function. (#$HairOfPatternTypeFn
PATTERN) denotes the specialization of #$MobOfHair-Mammal such that each of its instances share the visible surface pattern PATTERN.  For example,
(#$HairOfPatternTypeFn #$SpottedPattern) denotes the collection of all
bunches of hair with a spotted pattern. The coat of a particular
protypical #$Leopard, for example, would be an instance of this latter
type.")
(comment HairOfTextureTypeFn "A collection-denoting function. (#$HairOfTextureTypeFn
TEXTURE) denotes the specialization of #$MobOfHair-Mammal such that
each of its instances share the texture TEXTURE. For example,
(#$HairOfTextureTypeFn #$Rough) denotes the collection of
rough-textured hair.")
(comment HairOfLengthTypeFn "A collection-denoting function. (#$HairOfLengthTypeFn LENGTH) denotes
the specialization of #$MobOfHair-Mammal, instances of which share
some more-or-less-specific length LENGTH. For example,
(#$HairOfLengthTypeFn ((#$Centi #$Meter) 2)) donetes the collection of
bunches of 4 centimeter long hair.")
(comment HairTypeByLength "A collection of collections. Each instances of
#$HairTypeByLength is the collection of all bunches of hair, as in an
individual animal's coat or a portion thereof, with a particular
length, such as #$Long or (#$Inch 6).")
(comment HairTypeByCurliness "A collection of collections. Each instances of
#$HairTypeByCurliness is the collection of all bunches of hair, as in
an individual animal's coat or a portion thereof, consisting at least
partially of individual hairs with a particular level of curliness,
such as straight, curly, or wavy.")
(comment mammalTypeHasHairType "(#$mammalTypeHasHairType MAMMAL-TYPE HAIR-TYPE) means that
instances of MAMMAL-TYPE have hair of type HAIR-TYPE. More specific
predicates apply, depending on the FacetingCollection of
MobOfHair-Mammal to which HAIR-TYPE belongs.")
(comment ToySizedVarietyFn "A collection-denoting function. (#$ToySizedVarietyFn
ORG-TYPE) denotes the specialization of ORG-TYPE whose instances are
extremely small, with a size that is very low compared to the standard
for ORG-TYPE.")
(comment MiniatureSizedVarietyFn "A collection-denoting function. (#$MiniatureSizedVarietyFn
ORG-TYPE) denotes the specialization of ORG-TYPE whose instances are
smaller than is usual for ORG-TYPE.")
(comment StandardSizedVarietyFn "A collection-denoting function. (#$StandardSizedVarietyFn
ORG-TYPE) denotes the specialization of ORG-TYPE whose instances are
of standard, normal size for ORG-TYPE.")
(comment GiantSizedVarietyFn "A collection-denoting function. (#$GiantSizedVarietyFn
ORG-TYPE) denotes the specialization of ORG-TYPE whose instances are
significantly larger than is standard for ORG-TYPE.")
(comment SportingDog-FunctionalGroup "A collection of #$Dogs. Instances of #$SportingDog-FunctionalGroup are dogs whose breed background most signficantly includes some #$DogTypeByBreed-Pure developed to play an assisting role in hunting activities. Retriever, Setter, Pointer, and Spaniel breeds are often classified as specializations of #$SportingDog-FunctionalGroup.")
(comment FETTestTemplate-Individual "A spec of FET-QATemplate. The collection of formula templates for testing the FET, dealing with individual people.")
(comment FET-QATemplate "A spec of FormulaTemplate.")
(comment BitingAnAgent "#$BitingAnAgent is the coming-together of upper and lower teeth into the agent bitten.")
(comment irExpansionSet-Definitional-CoarseGrained "An instance of #$IRExpansionPredicate. (#$irExpansionSet-Definitional-CoarseGrained TERM SET) identifies SET as the set of terms that make up the definitional (#$isa and #$generalizations) terms for TERM.  For example, where TERM = #$hasPets, SET will have among its elements #$BinaryPredicate, #$owns, and #$Thing.")
(comment IRExpansionPredicate "The collection of all instances of #$Predicate that relate an instance INS of #$Thing to other instances or sets of instances of #$Thing that are potentially useful in generating augmentation-strings for a search string designed to get information about INS.")
(comment AmericanKennelClubMt "This #$Microtheory represents standards of #$Dog
classification according to the #$AmericanKennelClub.")
(comment DogClassificationMicrotheorySpindle "This #$MicrotheorySpindle represents the existing divergence
in standard ways of classifying #$Dogs, especially according to
#$DogTypeByBreed-Pure, #$DogTypeByFunctionalGroup, and
#$DogTypeByPhysicalVariety. The #$mtSpindleMember #$Microtheories each
represent one such classification system.")
(comment NonAbducibleThing "The collection #$NonAbducibleThing is a sub-collection of 
#$Thing.  Abductive inferences sometimes involve hypothesizing the 
existence of entities as part of the explanation of some assertion or set 
of assertions. Cyc will not hypothesize the existence of instances of 
#$NonAbducibleThing.  Roughly, abductive inferences consume conceptual / 
theoretical knowledge rather than produce it.  So, #$SecondOrderCollection 
is a sub-collection of #$NonAbducibleThing because Cyc should be employing 
existing knowledge of instances of #$SecondOrderCollection rather than 
hypothesizing new instances.")
(comment NonAbducibleCollection "The collection #$NonAbducibleCollection is a sub-collection of 
#$SetOrCollection.  Abductive inferences sometimes involve hypothesizing 
the existence of entities as part of the explanation of some assertion or 
set of assertions. Cyc will not hypothesize the existence of instances of 
the collections that are instances of #$NonAbducibleCollection.  Roughly, 
abductive inferences consume conceptual / theoretical knowledge rather 
than produce it.  So, #$SecondOrderCollection is an instance of 
#$NonAbducibleCollection because Cyc should be employing existing 
theoretical knowledge about instances of #$SecondOrderCollection rather 
than hypothesizing new instances.")
(comment NonAbduciblePredicate "The collection #$NonAbduciblePredicate is a sub-collection of #$Predicate whose instances will not be used in the generation of hypotheses during an abductive inference.  Abductive inferences involve hypothesizing states of affairs for the explanation of some assertion or set of assertions.  Instances of #$NonAbduciblePredicate are those predicates that represent states of affairs which Cyc will not hypothesize.  Roughly, abductive inferences consume conceptual / theoretical knowledge rather than produce it.  So, #$genls is an instance of #$NonAbduciblePredicate because Cyc should be employing existing theoretical knowledge rather than hypothesizing new chunks of such  knowledge.")
(comment AbducedTermFn "A term of the form (#$AbducedTermFn STORE TYPE N) is used  to represent a #$HypothesizedInstance of TYPE, some instance of  #$FirstOrderCollection, that has been posited as part of the  #$CycAbductiveProblemStore STORE.  N, a #$PositiveInteger, is an identifier referring to the order in which this term was abduced in the problem store STORE.")
(comment notAbducibleWRTTypeInArg "An assertion of the form (#$notAbducibleWRTTypeInArg PRED TYPE 
N) states that abductive inferences should not seek to posit hypothetical 
values for the other arguments of PRED when an instance of TYPE fills the 
PRED's Nth argument position.  Abductive inferences sometimes involving 
hypothesizing the existence of states of affairs.  Abductive inferences 
often seek to explain an assertion or set of assertions by hypothesizing 
the truth of other assertions.  However, we wish to restrict the kinds of 
assertions which Cyc will hypothesize such that Cyc does not hypothesize 
new theoretical or conceptual knowledge, or even contingent states of 
affairs that are quite rigidly constructed in the actual world.  Thus, the 
assertion (#$notAbducibleWRTValueInArg #$cityInState #$State-UnitedStates 
1) would prevent the Cyc inference engine from hypothesizing the existence 
of unknown cities within any of the states of the 
#$UnitedStatesOfAmerica.")
(comment notAbducibleWRTValueInArg "An assertion of the form (#$notAbducibleWRTValueInArg PRED THING 
N) states that abductive inferences should not seek to posit hypothetical 
values for the other arguments of PRED when THING fills the PRED's Nth 
argument position.  Abductive inferences sometimes involving hypothesizing 
the existence of states of affairs.  Abductive inferences often seek to 
explain an assertion or set of assertions by hypothesizing the truth of 
other assertions.  However, we wish to restrict the kinds of assertions 
which Cyc will hypothesize such that Cyc does not hypothesize new 
theoretical or conceptual knowledge, or even contingent states of affairs 
that are quite rigidly constructed in the actual world.  Thus, the 
assertion (#$notAbducibleWRTValueInArg #$cityInState #$NewYork-State 1) 
would prevent the Cyc inference engine from hypothesizing the existence of 
unknown cities within the state of New York.")
(comment CarDemoQueriesTestingTask "This task runs the test set #$CarDemoQuerySuite on a recurring basis, and notifies the #$testResponsibleCyclist of the success or failure of each individual test within that set.")
(comment irExpansionSet-Definitional-Asserted "An instance of #$IRExpansionPredicate. (#$irExpansionSet-Definitional-Asserted TERM SET) identifies SET as the set of terms that make up the asserted definitional (#$isa and the appropriate specialization of #$generalizations) terms for TERM.  For example, where TERM = #$hasPets, SET will have among its elements #$CoexistingObjectsPredicate and #$owns, but not and #$BinaryPredicate or #$possessiveRelation, as (#$isa #$hasPets #$CoexistingObjectsPredicate) and (#$genlPreds #$hasPets #$owns) are asserted, but (#$isa #$hasPets #$BinaryPredicate) and (#$genlPreds #$hasPets #$possessiveRelation) are not.")
(comment weightOnPlanet "(#$weightOnPlanet OBJECT PLANET WEIGHT) means that OBJECT weighs approximately WEIGHT on the surface of PLANET.")
(comment MultiColorPattern "A collection of #$VisualPatterns.  Each #$MultiColorPattern is a #$VisualPattern in which at least two distinct colors are apparent. This collection includes calico patterns in #$Cats and parti-color patterns in #$Dogs.")
(comment TheKennelClubUKMt "This #$Microtheory represents standards of #$Dog
classification according to the #$TheKennelClub-UK.")
(comment WireyTextured "A collection of objects with a similar feel to the touch.
#$WireyTextured objects have distinct wire- or rope- like surface
features, and feel coarse and wirey, like the coats of certain kinds
of terriers.")
(comment DatabaseSearching "A specialization of #$ElectronicDataSearching.  Each instance of #$DatabaseSearching is an event in which a computer is used to search for information in a database.")
(comment EditingAnElectronicDocument "A specialization of #$IBOCreation.  Each instance of #$EditingAnElectronicDocument is an event in which an agent uses a computer to edit an electronic document, such as a text file (e.g., via word processing -- see #$WordProcessingProgram), a PowerPoint presentation, or a spreadsheet.")
(comment CycAbductiveProblemStore "The sub-collection of #$CycProblemStore whose instances are used during an instance of #$CycAbductiveQueryRunning.")
(comment ManagementTask "An instance of #$SecondOrderCollection.  Instances are collections ofinstances of #$Management, bound together by a common goal or set of expectations.")
(comment DocumentationTask "An instance of #$SecondOrderCollection.  Instances are collections of #$PurposefulActions with the goal of producing documentation.")
(comment taskEstimatedPercentCompleted "(#$taskEstimatedPercentCompleted TASK PERCENT) means that the task TASK is estimated to be PERCENT #$Percent completed.  Thus, if it is true that (#$taskEstimatedPercentCompleted Task001 (#$Percent 60)), it means that Task001 was estimated to be 60% finished.  This predicate should be temporally qualified.")
(comment taskUpdateNotes "(#$taskUpdateNotes TASK STRING) means that the #$SubLString
STRING is an update on the task TASK.  It allows for documenting the
changes to and progress toward completion of TASK.")
(comment actualHoursWorked "(#$actualHoursWorked AGENT TASK TIME-AMOUNT) means that AGENT, an instance of #$IntelligentAgent, has worked on the task TASK for a total of TIME-AMOUNT, a #$Time-Quantity.  Thus, if it is true that (#$MtSpace (#$ProjectManagementMicrotheoryFn SomeProject) (#$MtTimeWithGranularityDimFn (#$MonthFn #$January (#$YearFn 2004)) #$Null-TimeParameter)) that (#$actualHoursWorked JohnSmith Task001 (#$HoursDuration 5)), this means that JohnSmith has worked a total of 5 hours on Task001 for SomeProject.  Note that #$actualHoursWorked is an instance of #$TemporallyQualifiableRelation; assertions using this predicate should be made in a temporally qualified microtheory.")
(comment timeSheetPeriod "(#$timeSheetPeriod PERIOD DATE NUMBER) means that PERIOD, an instance of #$TimeInterval, is denoted by the NUMBER timesheet period for DATE.  (#$timeSheetPeriod TimeSheetPeriod51 (#$MonthFn #$December (#$YearFn 2005)) 1) means that TimeSheetPeriod51 is the first time sheet period in December 2005.")
(comment TimeSheetPeriodFn "An instance of #$IndividualDenotingFunction. (#$TimeSheetPeriodFn DATE NUMBER) denotes the NUMBER timesheet period for DATE.  For example, (#$TimeSheetPeriodFn (MonthFn December (YearFn 2005)) 1) denotes the first time sheet period of #$December 2005.")
(comment relativelyPrimeIntegers "Two integers, P and Q are relatively prime iff (#$GreatestCommonDivisorFn P Q)=1.")
(comment facets-NearCovering "A #$TaxonomicSlotForCollections and a specialization of #$facets-Generic (q.v.).  (#$facets-NearCovering COL COLTYPE) means that COLTYPE corresponds to one (non-arbitrary) way of dividing  most or all of COL into (not necessarily disjoint) subcollections.  The instances of COLTYPE are all \"the same sort\" of subcollection of COL.  For example, #$PersonTypeByOccupation is a near-covering (but not covering) faceting of #$Person: not every instance of #$Person will be an instance of an instance of #$PersonTypeByOccupation, but it is expected that *most* will be.")
(comment requestedEffortTime "(#$requestedEffortTime TASK AGENT TIME) says that an authorized person (usually the project manager of some parent task of TASK) requests that AGENT spend approximately TIME amount of time on TASK.")
(comment assignedEffortTime "(#$assignedEffortTime TASK AGENT TIME) says that an authorized person (usually the project manager of some parent task of TASK) has assigned AGENT to spend approximately TIME amount of time on TASK.")
(comment FacetingCollectionTypePredicate "An instance of #$PredicateTypeByArgumentType.  Each instance of #$FacetingCollectionTypePredicate is a #$Predicate one of whose arguments is required (per some #$argIsa assertion) to be an instance of #$FacetingCollectionType.")
(comment availableWorkTimeForTask "(#$availableWorkTimeForTask TIME TASK) says that TIME is the amount of time available for the performance of TASK.  Assertions using this predicate should be temporally qualified.")
(comment EaredSeal "Those #$Seal-Animals that have external ears.  #$EaredSeals  constitute the #$BiologicalFamily Otariidae.")
(comment VettingASource "A specialization of #$Research.  Each instance of #$VettingASource is an event in which a researcher attempts to ascertain how authoritative or reliable a source of information is.  A common technique for vetting a source is getting expert opinions about its authoritativeness.")
(comment HitchhikingStop "The collection of all officially designated hitchhiking stops.  This collection does not characterize informal areas where a hitchhiker waiting for a pick-up is a common sight.  But, it does include such designated ride sharing areas such as those in San Geronimo Valley and hitchhiking stops found in Israel.")
(comment AcademicTerm "A specialization of #$Situation-Localized. An instance of this collection is the complex of planned activities constituting an academic term at a given educational institution: e.g., the 2003 spring semester at the University of Texas, Austin (cf. #$AcademicSemester). Note that this is not a pure time interval. A certain course, for instance, is a part (cf. #$subSituations) of a certain academic term. Salient specializations are #$AcademicYear and #$AcademicQuarter (qq.v).")
(disjointWith CreationOrDestructionEvent AcademicTerm)
(disjointWith IntrinsicStateChangeEvent AcademicTerm)
(comment irExpansionSentencesForTermGivenVerbSem "An instance of #$IRExpansionPredicate, used to generate expansion suggestions from a partial understanding of an NL utterance.  Given a context in which an information retrieval parsing engine has produced a parse of some natural language utterance UTTERANCE such that: 
1 the verb of UTTERANCE denotes some (possibly non-proper) specialization SPEC of some type of situation SITUATION-TYPE;
2 a sub-string SUBSTRING of UTTERANCE is co-referential with the #$CycLTerm TERM (that is, they share the same denotation, DENOTATION);
3 the semantics of UTTERANCE are understood at least well enough to know they involve DENOTATION playing a role SPECIALIZED-ROLE in some (or perhaps every) instance of SPEC, where SPECIALIZED-ROLE is a (possibly non-proper) specialization or inverse-specialization of the role ROLE;
then (#$irExpansionSentencesForTermGivenVerbSem TERM SITUATION-TYPE ROLE SENTENCE) says that the #$CycLSentence SENTENCE is an appropriate sentence from which to generate expansion strings for SUBSTRING.  For example, (#$irExpansionSentencesForTermGivenVerbSem #$Bailey #$FeedingEvent #$patient-Generic (#$massOfObject #$Bailey (#$Pound-UnitOfMass 22))) says that (#$massOfObject #$Bailey (#$Pound-UnitOfMass 22)) is an appropriate #$CycLSentence from which to generate an expansion string for any string (e.g., \"my dog\") that is coreferential with #$Bailey in the context of a partial parse of an NL sentence (e.g., \"How much should I feed my dog?\", \"How often should I feed my dog?\", \"What can I feed my dog?\") for which we know that #$FeedingEvent is a collection in the upward #$genls closure of whatever collection is denoted by the verb, and for which the term #$Bailey is understood to be playing the role #$patient-Generic in that collection.")
(comment irExpansionPredForTypeInSitTypeWithRole "An instance of #$IRExpansionPredicate, used to generate expansion suggestions from a partial understanding of an NL utterance. (#$irExpansionPredForTypeInSitTypeWithRole TYPE SIT-TYPE ROLE N PRED) says that given any partial parse of an utterance UTTERANCE that involves a description of some instance INS of TYPE playing the ROLE in some instance of SIT-TYPE, all true #$CycLSentences of the form (PRED ... INS ...), where INS occurs in the Nth argument place, are appropriate sentences from which to generate expansion strings for the sub-string of UTTERANCE that denotes INS.  More formally, (#$irExpansionPredForTypeInSitTypeWithRole TYPE SIT-TYPE ROLE N PRED) says that (#$forAll ?X (#$implies (#$isa ?X TYPE) (#$irExpansionSentencesForTermGivenVerbSem ?X SIT-TYPE ROLE SENTENCE))), where (#$trueSentence SENTENCE), (#$operatorFormulas PRED SENTENCE) and (#$argN ?X SENTENCE N) all hold.")
(comment userProfile "A binary predicate relating a Person to a Microtheory.  (userProfile PER MT) means that MT contains all of the user profile information for PER.  Note that MT may contain information about PER from multiples sessions involving PER.")
(comment scopedFormulaArg "A binary #$MetaRelation that relates a #$ScopingRelation (q.v.) to an integer indicating the argument-place of the former that takes a CycL formula.  (#$scopedFormulaArg RELN N) means that RELN's Nth argument is a CycL formula FORM such that any free occurrences in FORM of the CycL variable(s) VAR (VAR1...VARm) serving as the corresponding \"scoping\" argument to RELN is (are) bound with respect to the entire RELN-based formula.  For example, given that (#$scopingArg #$thereExists 1) holds, (#$scopedFormulaArg #$thereExists 2) entails that in the sentence
<p>
<pre>
  (#$thereExists ?KIT
    (#$and
      (#$isa ?KIT #$Cat)
      (#$isa ?KIT #$BlackColor)))
</pre>
<p>
the occurrences of the variable '?KIT' free in the conjunction are bound by the quantifier #$thereExists.")
(comment logicalPhysicalFieldMap-DecodeClosed "(#$logicalPhysicalFieldMap-DecodeClosed LF PF)
is true if and only if i) LFI is a logical field indexical associated
with the logical field LF via #$indexicalForLogicalField; ii) PFI is a
physical field indexical associated with the physical field PF via
#$indexicalForPhysicalField; and iii) there is some #$fieldDecoding
assertion of the form (#$fieldDecoding LS LFI PS FORMULA) such that
PFI appears as a term in FORMULA. (Note it is possible that PFI ==
FORMULA.) See also the related
#$logicalPhysicalFieldMap-EncodeClosed.")
(comment logicalPhysicalFieldMap-EncodeClosed "(#$logicalPhysicalFieldMap-EncodeClosed LF PF)
is true if and only if i) LFI is a logical field indexical associated
with the logical field LF via #$indexicalForLogicalField; ii) PFI is a
physical field indexical associated with the physical field PF via
#$indexicalForPhysicalField; and iii) there is some #$fieldEncoding
assertion of the form (#$fieldEncoding PS PFI LS FORMULA) such that
LFI appears as a term in FORMULA. (Note it is possible that LFI ==
FORMULA.) See also the related
#$logicalPhysicalFieldMap-DecodeClosed.")
(comment WorkReferencedByFn "(#$WorkReferencedByFn STRING) denotes the #$StructurallySpecificWork which is referenced by the #$BibliographicReference STRING.")
(comment equivalentRolePlayersOfType-SubSitTypeToSubSitType "<code>(#$equivalentRolePlayersOfType-SubSitTypeToSubSitType SITTYPE SUBSITTYPE1 ROLE1 SUBSITTYPE2 ROLE2 TYPE)</code> means that in any instance <code>SIT</code> of <code>SITTYPE</code>, where <code>SUBSIT1</code> and <code>SUBSIT2</code> are subsituations of <code>SIT</code> and are instances of <code>SUBSITTYPE1</code> and  <code>SUBSITTYPE2</code>, respectively, whatever things of type <code>TYPE</code> play <code>ROLE1</code> in <code>SUBSIT1</code> also play <code>ROLE2</code> in <code>SUBSIT2</code>, and vice versa.")
(comment differentRolePlayersOfType-SubSitTypeToSubSitType "'(#$differentRolePlayersOfType-SubSitTypeToSubSitType SITTYPE SUBSITTYPE1 ROLE1 SUBSITTYPE2 ROLE2 TYPE)' means that, in any instance SIT of SITTYPE, whatever thing of type TYPE plays the role ROLE1 in the sub-situation SUBSIT1 of  SIT  which is an instance of SUBSITTYPE1 is different from whatever plays the role ROLE2 in the sub-situation SUBSIT2 which is an instance of SUBSITTYPE2.")
(comment Topic "An instance of #$FacetingCollectionType and a specialization of #$ConventionalClassificationType.  Each instance of #$Topic is a collection of #$Things falling under a common topic.  #$Topic is neither a strict [#$facets-Strict] nor a covering [#$facets-Covering] faceting of #$Thing: many #$Things may be instances of no #$Topic, or of multiple #$Topics.  IMPORTANT: Something's falling under a particular topic is purely a matter of convention: we simply *stipulate* that certain things fall under certain topics when we find it useful to do so, e.g. for browsing or inferential purposes.  There is no use in pondering what it \"really means\" for a thing to fall under a topic; #$Topics are just shallow (but useful) ways of \"clumping\" things together.")
(comment Biology-Topic "An instance of #$Topic.  Each instance of #$Biology-Topic is a #$Thing which (in some significant sense) has to do with the topic of biology.")
(comment Clothing-Topic "An instance of #$Topic.  Each instance of #$Clothing-Topic is a #$Thing which (in some significant sense) has to do with the topic of clothing.")
(comment Agents-Topic "An instance of #$Topic.  Each instance of #$Agents-Topic is a #$Thing which (in some significant sense) has to do with the topic of agents.")
(comment Weather-Topic "An instance of #$Topic.  Each instance of #$Weather-Topic is a #$Thing which (in some significant sense) has to do with the topic of weather.")
(comment Food-Topic "An instance of #$Topic.  Each instance of #$Food-Topic is a #$Thing which (in some significant sense) has to do with the topic of food.")
(comment Transportation-Topic "An instance of #$Topic.  Each instance of #$Transportation-Topic is a #$Thing which (in some significant sense) has to do with the topic of transportation.")
(comment Chemistry-Topic "An instance of #$Topic.  Each instance of #$Chemistry-Topic is a #$Thing which (in some significant sense) has to do with the topic of chemistry.")
(comment Geography-Topic "An instance of #$Topic.  Each instance of #$Geography-Topic is a #$Thing which (in some significant sense) has to do with the topic of geography.")
(comment Movement-Topic "An instance of #$Topic.  Each instance of #$Movement-Topic is a #$Thing which (in some significant sense) has to do with the topic of movement.")
(comment Emotion-Topic "An instance of #$Topic.  Each instance of #$Emotion-Topic is a #$Thing which (in some significant sense) has to do with the topic of emotion.")
(comment Perception-Topic "An instance of #$Topic.  Each instance of #$Perception-Topic is a #$Thing which (in some significant sense) has to do with the topic of perception.")
(comment GraphicallyEditableRoleMappingPredicate "#$GraphicallyEditableRoleMappingPredicate is the specialization of #$SituationTypeRelation whose instances can fill the arg0 slots of role-mapping gafs editable by the graphical situation type editor.")
(comment superTopics "An instance of #$TransitiveBinaryPredicate and a specialization of #$genls.  #$superTopics relates a #$Topic to a #$Topic.  (#$superTopics TOPIC1 TOPIC2) means that TOPIC2 is a supertopic of TOPIC1, i.e. TOPIC1 is a subtopic of TOPIC2.  More specifically, it means that everything that is in (or \"falls under\") TOPIC1 is in (or \"falls under\") TOPIC2.")
(comment relatedTopics "An instance of #$SymmetricBinaryPredicate and #$IrreflexiveBinaryPredicate, and a specialization of #$conceptuallyCoRelated.  #$relatedTopics relates a #$Topic to a #$Topic.  (#$relatedTopics TOPIC1 TOPIC2) means that TOPIC1 and TOPIC2 have significant overlap, though neither is a subtopic of the other.  Note that #$relatedTopics is *not* transitive: (#$relatedTopics TOPIC1 TOPIC2) and (#$relatedTopics TOPIC2 TOPIC3) do not jointly entail (#$relatedTopics TOPIC1 TOPIC3).")
(comment PropositionalAttitudes-Topic "An instance of #$Topic.  Each instance of #$PropositionalAttitudes-Topic is a #$Thing which (in some significant sense) has to do with the topic of propositional attitudes (belief, desire, etc.).")
(comment CycVocabularyTopic "An instance of #$FacetingCollectionType and a specialization of #$Topic.  Each instance of #$CycVocabularyTopic is a collection of #$Things falling under a topic for which some Cyc Vocabulary exists.  #$Topic is neither a strict [#$facets-Strict] nor a covering [#$facets-Covering] faceting of #$Thing: many #$Things may be instances of no #$Topic, or of multiple #$Topics.")
(comment Communication-Topic "An instance of #$Topic.  Each instance of #$Communication-Topic is a #$Thing which (in some significant sense) has to do with the topic of communication.")
(comment TopicMt "This microtheory contains assertions about the structural relations between #$Topics, specifically which pairs of #$Topics stand in the #$superTopics and #$relatedTopics relations.  It also contains assertions about what #$Things bear the #$inTopic relation to what #$Topics.  Such assertions are placed in this special microtheory so as to leave open the possibility of restructuring and/or repopulating the topics for special purposes.")
(comment FormulaTemplateInductionTopicTypeFn "(#$FormulaTemplateInductionTopicTypeFn COLL) denotes the collection of #$InducedFormulaTemplate induced based on what is known about instances of COLL.")
(comment InducedFormulaTemplate "The collection of all #$FormulaTemplates that are induced based on what is known about the class of terms with a certain property.")
(comment CycVocabularyTopLevelTopic "An instance of #$CollectionType and a specialization of CycVocabularyTopic. Each instance of #$CycVocabularyTopLevelTopic is an entry point (e.g. a topic you would see displayed first in a user interface) into the Cyc Vocabulary hierarchy of topics. Any of these top-level topics may have more general topics above them in the topic hierarchy (c.f. #$superTopics), but those more general topics will not serve as entry points unless they are asserted to be instances of #$CycVocabularyTopLevelTopic.)")
(comment bodyPartCollectionOfType "(#$bodyPartCollectionOfType ANIMAL TYPE COL) means that #$Collection COL  is the collection of all of the instances of the collection TYPE (a specialization of #$AnimalBodyPart) that are anatomical parts (see #$anatomicalParts) of ANIMAL.")
(comment LiberationTheology "#$LiberationTheology is \"[a] school of theology, especially prevalent in the Roman Catholic Church in Latin America, that finds in the Gospel a call to free people from political, social, and material oppression.\" (Source: http://www.bartleby.com/61/94/L0149400.html.)")
(comment subcollectionOfWithRelationTo "<code>(#$subcollectionOfWithRelationTo SUPER-COL PREDICATE THING SUB-COL)</code> means that <code>SUB-COL</code> is the collection of all instances <code>INSTANCE</code> of <code>SUPER-COL</code> for which <code>(PREDICATE INSTANCE THING)</code> holds. See the function that corresponds to this predicate, #$SubcollectionOfWithRelationToFn.")
(comment subcollectionOfWithRelationToType "<code>(#$subcollectionOfWithRelationToType SUPER-COL PREDICATE TYPE SUB-COL)</code> means that <code>SUB-COL</code> is the collection of all instances <code>INSTANCE</code> of <code>SUPER-COL</code> for which <code>(PREDICATE INSTANCE THING)</code> holds for some instance <code>(THING)</code> of <code>TYPE</code>. See the function that corresponds to this predicate, #$SubcollectionOfWithRelationToTypeFn.")
(comment publisherTypeOfPublicationType "(#$publisherTypeOfPublicationType PUBLICATION-TYPE PUBLISHER-TYPE) means PUBLISHER-TYPE is the collection of agents who publish instances of PUBLICATION-TYPE.")
(comment updateABugzillaBugReport "This #$SimpleActionPredicate states that some agent (a #$Cyclist)
has updated some #$BugzillaBugReport, either by changing its status,
or by adding a comment, or both.")
(comment BugzillaBugReportUpdateType "This second order collection that facets
#$UpdatingABugzillaBugReport by the type of update performed.
Often, different types of updates entail changes to a bug's status
(see #$BugzillaBugReportTypeByStatus) however this is not required.
Some positive examples of bug update types that do not involve changes
in the bug's status include adding users to the CC list, adding a
comment to a bug, or changing its priority.")
(comment MarkingABugzillaBugReportAsADuplicate "#$MarkingABugzillaBugReportAsADuplicate is the collection of
all Bugzilla bug report updates in which the user marks the bug report
as a duplicate of some other bug.")
(comment UpdatingABugzillaBugReport "This is the collection of all actions in which an agent
updates the status of some #$BugzillaBugReport.")
(comment BugzillaBugReportType "#$BugzillaBugReportType is a second order collection which facets BugzillaBugReport. Specializations of this collection type group the specs of #$BugzillaBugReport according to various properties of their member, such as by resolution priority and severity.")
(comment ClosingABugzillaBugReport "#$ClosingABugzillaBugReport is the collection of all
Bugzilla bug report updates in which the user marks the bug report as
'closed'.")
(comment VerifyingABugzillaBugReport "#$VerifyingABugzillaBugReport is the collection of all
Bugzilla bug report updates in which the user verifies the resolution
status of a bug report.")
(comment UpdatingABugReport "This is the collection of all actions in which an agent
updates the status of some #$BugReport.")
(comment ReassigningABugzillaBugReport "#$ReassigningABugzillaBugReport is the collection of all
Bugzilla bug report updates in which the user reassigns a bug report
to another user.")
(comment ResolvingABugzillaBugReport "#$ResolvingABugzillaBugReport is the collection of all
Bugzilla bug report updates in which the user marks the bug report as
'resolved'")
(comment AcceptingABugzillaBugReport "#$AcceptingABugzillaBugReport is the colledtion of all
Bugzilla bug report updates in which the user accepts responsibility
for a bug report.")
(comment ConfirmingABugzillaBugReport "#$ConfirmingABugzillaBugReport is the collection of all
Bugzilla bug report updates in which the user confirms the status of a
bug report.")
(comment ReopeningABugzillaBugReport "#$ReopeningABugzillaBugReport is the collection of all
Bugzilla bug report updates in which the user reopens a previously
closed bug report.")
(comment bugStatus "#$bugStatus is a typed spec pred of #$isa which is used
exclusively to state the status of a bugzilla bug report.")
(comment bugResolution "#$bugResolution is a typed spec pred of #$isa which is used
exclusively to state the resolution state of a bugzilla bug report.")
(comment bugSeverity "#$bugSeverity is a typed spec pred of #$isa which is used
exclusively to state the relative severity of a bugzilla bug report.")
(comment bugPriority "#$bugPriority is a typed spec pred of #$isa which is used
exclusively to state the relative priority of a bugzilla bug report.")
(comment testQueryForBugzillaBug "(#$testQueryForBugzillaBug TEST BUG) states that the
#$KBContentTest-FullySpecified TEST is a regression test for the
#$BugzillaBugReport BUG. If TEST fails and BUG isa
#$FixedBugzillaBugReport, then #$Cyc should reopen BUG and post the
results of TEST as a comment to BUG.")
(comment OutdoorIllumAtNumPercentLevelFn "(#$OutdoorIllumAtNumPercentLevelFn NUM) denotes the
collection of outdoor locations illuminated at NUM #$Percent of full
sunlight.")
(comment OutdoorIllumByObjTypeFn "(#$OutdoorIllumByObjTypeFn OBJ-TYPE) denotes the collection
of outdoor locations illuminated by an object of type OBJ-TYPE.")
(comment cycKBNumber "(#$cycKBNumber CYCKB POS-INT) means the Cyc KB CYCKB is associated by convention with the Cycorp-internal KB number POS-INT.  For example, (#$cycKBNumber KB001 694) means that KB001 is KB 694.  See the corresponding function, #$CycKBFn.")
(comment EvaluativeCriterion "A sub-collection of #$Criterion, the instances of #$EvaluativeCriterion are standards that dictate how the value, worth, or quality of entities should be judged based on some properties of that entity.  As an example, there may be several aspects to describing the offensive capabilities of a #$FootballTeam (say total yards gained during a game and the number of sacks allowed).  However, it is another matter to use such properties to judge the quality of a #$FootballTeam (i.e., using greater total yards to raise an evaluation, while using more sacks to lower it.).  The standard which transforms the descriptions into a judgment of the value of the team is an instance of #$EvaluativeCriterion.")
(comment EvaluativeCriterion-Numerical "A sub-collection of #$EvaluativeCriterion, the instances of
#$EvaluativeCriterion-Numerical are those standards which when applied
for the evaluation of a set of entities result in the assignment of
some instance of #$PositiveInteger to the elements of the set.  For
example, charts which state the best-selling album for a particular
week rely on a relatively simple instance of
#$EvaluativeCriterion-Numerical to compose such charts from a
description of their sales.  A more complex example would be a
criterion which supports judgments of the livability of a city based
on a variety of distinct properties.")
(comment EvaluativeCriterion-1IsBest "The sub-collection of #$EvaluativeCriterion-Numerical where (1) ratings are assigned using integers (2) the lower the assigned integer the better the ranking and (3) the integer one is the highest possible ranking.")
(comment EvaluatedNumericalRating "#$EvaluatedNumericalRating, a sub-collection of #$EvaluativeQuantity, is a collection of collections. The instances of #$EvaluatedNumericalRating are instances of #$FirstOrderCollection whose instances all share a common evaluation relative to some instance of #$EvaluativeCriterion-Numerical.  What distinguishes this collection from #$EvaluativeQuantity is that the evaluations include assigning a number to the collection such that individuals can be compared based on the number assigned to the collection of which they are a member.  For example, a sub-collection of #$EvaluatedNumericalRating could be the set of weekly rankings for instances of #$Song-CW by the organization responsible for #$RollingStone-TheMagazine.  'This is Rolling Stone's number one song this week.' assigns that individual song to a collection that is an instance of #$EvaluatedNumericalRating.  The collection 'Rolling Stone's Number One Song' is such that at any given time there is exactly one instance of it.  However, this is not a necessary feature of the instances of #$EvaluatedNumericalRating.")
(comment numericalRatingWRTCriterion "An assertion of the form (#$numericalRatingWRTCriterion RANK NUM CRITERION) states that RANK, an instance of #$EvaluatedNumericalRating is associated with NUM, some #$Number-General, with regard to the instance of #$EvaluativeCriterion-Numerical.  For instance, (#$numericalRatingWRTCriterion HighestRatedHooHa 1 Foo) would assert that the collection HighestRatedHooHa receives the numerical rank of 1 relative to the Foo standard.  It is important to note that #$numericalRatingWRTCriterion is a #$TemporallyQualifiableRelation.")
(comment superiorTypeWRTCriterion "An assertion of the form (#$superiorTypeWRTCriterion TYPE1 TYPE2 CRIT) states that with respect to the instance of #$EvaluativeCriterion CRIT, it is 'better' to be an instance of TYPE1 than TYPE2.")
(comment superiorWRTCriterion "An assertion of the form (#$superiorWRTCriterion THING1 THING2 CRITERION) states that THING1, some #$Thing, is superior to THING2, another #$Thing, with regard to CRITERION, some instance of #$EvaluativeCriterion.  For instance (#$superiorWRTCriterion #$BananasInPajamas-TheTVShow #$ElGranJuegoDeLaOca-TheTVShow Foo) would assert that #$BananasInPajamas-TheTVShow is superior to #$ElGranJuegoDeLaOca-TheTVShow according to the Foo standard.  It is important to note that #$superiorWRTCriterion is a #$TemporallyQualifiableRelation.")
(comment CycTermRankModule "The term rank module generates a term connectivity graph wherein edges join terms that are inferentially related. This graph is
then passed to a randomized graph algorithm which computes an eigenvector for graph matrix. This vector represents the probability that an idealized inference engine, on a random walk of the graph will be focused on each respective term. This corresponds roughly to the importance or relevance of each term, especially with regard to a given weight vector that represents our a priori expectations of term relevance.")
(comment CycTermRankingFocus "The instances of #$CycTermRankingFocus are instances of #$EvaluativeCriterion that are part of a larger term rank program which dictate how the program should set about ranking the inter-connectivity of terms within an instance of #$CycKB.  Among its instances is #$UniformTermRank, where no particular set of terms is the focus of the term ranking.  Individual instances that focus the term ranking relative to a set of #$CycLTerms can be picked out using the function #$FocusedTermRankFn.")
(comment FocusedTermRankFn "A NART of the form (#$FocusedTermRankFn SET) picks out an instance of #$CycTermRankingFocus.  It instructs the term rank algorithm to perform a term ranking evaluation in relation to the elements of SET, a set whose elements are all instances of #$CycLTerm. The term ranking will return a ranking where the highest ranked elements are those most closely connected to the elements of SET through rules asserted within the relevant instance of #$CycKB over which the algorithm was run.")
(comment UniformTermRank "An instance of #$CycTermRankingFocus.  #$UniformTermRank instructs the term rank algorithm to perform a term ranking evaluation over the whole of the relevant instance of #$CycKB.  Thus, this is the instruction to look at total connectivity off all #$CycLTerms to all #$CycLTerms based on rule assertions within that instance of #$CycKB. Contrast with the instances picked out by #$FocusTermRankFn.")
(comment termRankFocusedWRTSet "An assertion of the form (#$termRankFocusedWRTSet FOCUS SET) asserts that the instance of #$CycTermRankingFocus focuses on the set of #$CycLTerms SET.")
(comment termRankingPreference "An assertion of the form (#$termRankingPreference FOCUS TERM1 TERM2) asserts that with regard to the instace of #$CycTermRankingFocus FOCUS, it is desirable that the #$CycLTerm TERM1 receive a higher ranking than the #$CycLTerm TERM2.  That is, it is expected that, relative to FOCUS, that there are more connections to TERM1 within the relevant instance of #$CycKB than there are connections to TERM2.")
(comment CycKBTermRank "A collection representing the sub-collection of #$EvaluatedNumericalRating whose instances represent the overall connectivity of a #$CycLTerm either to the whole of the relevant instance of #$CycKB or to a particular set of #$CycLTerm.")
(comment KBTermRankFn "A NART of the form (#$KBTermRankFn KB MOD N) denotes an instance of #$CycKBTermRank.  This is a collection whose instances are ranked Nth in the #$CycKB KB by the instance of #$CycTermRankModule MOD.  The term ranking algorithm is used to judge how well instances of #$CycLTerm are connected to each other through rule assertions within an instance of #$CycKB.  Thus, (#$KBTermRankFn (CycKBFn 720)  (#$FocusedTermRankFn #$UniformTermRank) 1) is used to denote the  collection whose instance(s) has the greatest connectivity to all  other #$CycLTerms when the term rank algorithm when it is run on the  #$CycKB (#$CycKBFn 720).  The use module (#$FocusedTermRankFn  #$UniformTermRank) indicates that the judgment is based on connectivity of all terms, and not just relative to a particular set of #$CycLTerms.")
(comment collectionWithKBTermRanking "An assertion of the form (collectionWithKBTermRanking COLL KB MODULE INT) states that COLL, an instance of #$CycKBTermRank, is the collection of all individuals who receive the ranking INT, some #$PositiveInteger, when the instance of #$CycTermRankModule MOD is run against the instance of CycKB KB.")
(comment CycTermRankUsingFocusFn "An individual denoting function, a NART of the form  (#$CycTermRankUsingFocusFn FOCUS) is used to denote a specific version of  #$CycTermRankModule where the particular individual is differentiated  from other instances of the collection by FOCUS, an instance of  #$CycTermRankingFocus that can be used to modify the algorithm to  relative the ranking to a set of CycL terms.")
(disjointWith Tower BusStation)
(disjointWith StorageShed BusStation)
(disjointWith ParkingPlace BusStation)
(disjointWith LaneOfRoadway BusStation)
(comment FunctionTypeByArity "A #$SecondOrderCollection.  Each instance of #$FunctionTypeByArity is a collection of functions having the same #$arity.  Instances include #$UnaryFunction, #$BinaryFunction, and #$VariableArityFunction.")
(comment PredicateTypeByArity "A collection of collections.  Each instance of #$PredicateTypeByArity is a collection of #$Predicates having the same #$arity.  Instances include #$UnaryPredicate, #$BinaryPredicate, and #$TernaryPredicate.")
(comment facetBasedOnBinaryPred "A #$BinaryPredicate that is used to state that a special relation holds between a #$FacetingCollectionType and a #$BinaryPredicate -- that the former is \"based on\" the latter in a specific sense.
<p>
Where <code>(#$facets-Generic COL FACET-COL)</code>, <code>(#$facetBasedOnBinaryPred FACET-COL BINPRED)</code> means that for all <code>X</code> in <code>FACET-COL</code> there is a <code>Y</code> such that, by the definition of <code>X</code>, for all <code>Z</code> in <code>COL</code>, <code>Z</code> is in <code>X</code> iff <code>(PRED Z Y)</code> holds.
<p>
For example, <code>(#$facetBasedOnBinaryPred #$WineTypeByColor #$uniformColorOfObject)</code> means that for all <code>WINE-TYPE</code> in #$WineTypeByColor there is a <code>COLOR</code> such that, by the definition of <code>WINE-TYPE</code>, for all <code>WINE</code> in #$Wine, <code>WINE</code> is in <code>WINE-TYPE</code> iff <code>(#$uniformColorOfObject WINE COLOR)</code> holds.
<p>
Note that it is also true that <code>(#$facetBasedOnBinaryPred #$WineTypeByColor #$isa)</code>. Indeed, <code>(#$facetBasedOnBinaryPred FACET-COL #$isa)</code> is trivially true for any <code>FACET-COL</code>, since the following is a logical truth:
<pre>
(#$forAll ?X 
  (#$thereExists ?Y 
    (#$forAll ?Z 
      (#$equiv
        (#$isa ?Z ?X)
        (#$isa ?Z ?Y)))))
</pre>
For cases in which the arguments of <code>BINPRED</code> are reversed, see #$facetBasedOnBinaryPredInverse.  See also #$facetBasedOnTypeBinaryPred, #$facetBasedOnTypeBinaryPredInverse, and #$SharedNoteOnFacetBasisPredicates.")
(comment BugzillaBugReportTypeByProduct "#$BugzillaBugReportTypeByProduct is a
#$DisjointCollectionType which facets #$BugzillaBugReport according to
which bugzilla 'product' the bug belongs.")
(comment BugzillaBugReportTypeByComponent "#$BugzillaBugReportTypeByComponent is a #$DisjointCollectionType which facets #$BugzillaBugReport according to which bugzilla 'component' the bug belongs.")
(comment facetBasedOnBinaryPredInverse "A #$BinaryPredicate that is used to state that a special relation holds between a #$FacetingCollectionType and a #$BinaryPredicate -- that the former is \"based on\" the latter in a specific sense.
<p>
Where <code>(#$facets-Generic COL FACET-COL)</code>, <code>(#$facetBasedOnBinaryPredInverse FACET-COL BINPRED)</code> means that for all <code>X</code> in <code>FACET-COL</code> there is a <code>Y</code> such that, by the definition of <code>X</code>, for all <code>Z</code> in <code>COL</code>, <code>Z</code> is in <code>X</code> iff <code>(PRED Y Z)</code> holds.
<p>
For example, <code>(#$facetBasedOnBinaryPredInverse #$PersonTypeByCulture #$cultureParticipants)</code> means that for all <code>PERSON-TYPE</code> in #$PersonTypeByCulture there is a <code>CULTURE</code> such that, by the definition of <code>PERSON-TYPE</code>, for all <code>PERSON</code> in #$Person, <code>PERSON</code> is in <code>PERSON-TYPE</code> iff <code>(#$cultureParticipants CULTURE PERSON)</code> holds.
<p>
For cases in which the arguments of <code>BINPRED</code> are reversed, see #$facetBasedOnBinaryPred.  See also #$facetBasedOnTypeBinaryPred, #$facetBasedOnTypeBinaryPredInverse, and #$SharedNoteOnFacetBasisPredicates.")
(comment CreatingABugReport "#$CreatingABugReport, a specialization of #$IBOCreation, #$MakingSomething and #$InformationAdding, is the collection of all creation events in which a #$BugReport is created. See, in particular, the specialization #$CreatingABugzillaBugReport.")
(comment CreatingABugzillaBugReport "#$CreatingABugzillaBugReport is the collection of all
actions in which some agent creates a new #$BugzillaBugReport.")
(comment BugzillaBugReportActionType "#$BugzillaBugReportActionType is a specialization of
#$ComputerActivityType whose instances are collections of actions
performed on #$BugzillaBugReports. Salient instances include
#$CreatingABugzillaBugReport and #$UpdatingABugzillaBugReport. See
also the specialization #$BugzillaBugReportUpdateType.")
(comment HandingOverControlOfTypeFn "A collection denoting function, a term of the form (#$HandingOverControlOfTypeFn COLL) picks out the sub-collection of HandingOverControlOfSomething where the #$objectOfControlTransfer is an instance of COLL, some sub-collection of #$SomethingExisting.")
(comment typeForHandingOverControlOfType "An assertion of the form (#$typeForHandingOverControlOfType EVENT-TYPE OBJ-TYPE) states that EVENT-TYPE is a sub-collection of #$HandingOverControlOfSomething, where the #$objectOfControlTransfer is an instance of #$OBJ-TYPE, some sub-collection of #$SomethingExisting.")
(comment facetBasedOnTypeBinaryPred "A #$BinaryPredicate that is used to state that a special relation holds between a #$FacetingCollectionType and a #$BinaryPredicate -- that the former is \"based on\" the latter in a specific way.
<p>
Where <code>(#$facets-Generic COL FACET-COL)</code>, <code>(#$facetBasedOnTypeBinaryPred FACET-COL BINPRED)</code> means that for each <code>X</code> in <code>FACET-COL</code>, there is a <code>Y</code> such that, by the definition of <code>X</code>, <code>X</code> is the one and only specialization of <code>COL</code> that bears <code>BINPRED</code> to <code>Y</code>.
<p>
For example, <code>(#$facetBasedOnTypeBinaryPred #$OrganizationTypeByActivityType #$characteristicActivityTypeOfOrganizationType)</code> means that for all <code>ORG-TYPE</code> in #$OrganizationTypeByActivityType there is an <code>ACT-TYPE</code> such that only the specializations of  <code>ORG-TYPE</code> (including <code>ORG-TYPE</code> itself) are the  specializations of #$Organization that bear the #$characteristicActivityTypeOfOrganizationType relation to <code>ACT-TYPE</code>.
<p>
E.g., #$SugarManufacturingOrganization, an instance of #$OrganizationTypeByActivityType, is by definition the one and only specialization of #$Organization that bears #$characteristicActivityTypeOfOrganizationType to #$SugarManufacturing. 
<p>
For cases in which the arguments of <code>BINPRED</code> are reversed, see #$facetBasedOnTypeBinaryPredInverse.  See also #$facetBasedOnBinaryPred and #$SharedNoteOnFacetBasisPredicates.")
(comment facetBasedOnTypeBinaryPredInverse "A #$BinaryPredicate that is used to state that a special relation holds between a #$FacetingCollectionType and a #$BinaryPredicate -- that the former is \"based on\" the latter in a specific way.
<p>
Where <code>(#$facets-Generic COL FACET-COL)</code>, <code>(#$facetBasedOnTypeBinaryPredInverse FACET-COL BINPRED)</code> means that for all <code>X</code> in <code>FACET-COL</code>, there is a <code>Y</code> such that, by the definition of <code>X</code>, <code>X</code> is the one and only specialization of <code>COL</code> to which <code>Y</code> bears <code>BINPRED</code>.
<p>
For example, <code>(#$facetBasedOnTypeBinaryPredInverse #$PersonTypeByNationality #$countryOfNationality)</code> means that for all <code>NATIONALITY</code> in #$PersonTypeByNationality, there is a <code>COUNTRY</code> such that, by the definition of <code>NATIONALITY</code>, <code>NATIONALITY</code> is the one and only specialization of #$Person to which <code>COUNTRY</code> bears the #$countryOfNationality relation.
<p>
E.g. #$ItalianPerson, an instance of #$PersonTypeByNationality, is the one and only specialization of #$Person to which #$Italy bears the #$countryOfNationality relation.
<p>
For cases in which the arguments of <code>BINPRED</code> are reversed, see #$facetBasedOnTypeBinaryPred.  See also #$facetBasedOnBinaryPredInverse and #$SharedNoteOnFacetBasisPredicates.")
(comment unitMaxObservationRangeUnderConditionType "#$unitMaxObservationRangeUnderConditionType UNIT CONDITION DISTANCE) means that given the effectiveness of UNIT's sensors under CONDITION, the maximum range at which UNIT can detect objects effectively is DISTANCE.")
(comment maxRangeForSightUnderAmbientCondition "(#$maxRangeForSightUnderAmbientCondition SIGHTTYPE CONDITION DISTANCE) means that the maximum effective range for SIGHTTYPE under the ambient conditon CONDITION is DISTANCE.")
(comment bugzillaProductForProject "(#$bugzillaProductForProject BUG-TYPE-BY-PRODUCT PROJECT)
means that BUG-TYPE-BY-PRODUCT, a collection of Bugzilla bug reports
which all are members of the same product with PROJECT, the #$Project
responsible for that product.")
(comment RightHandedHuman "A specialization of #$HomoSapiens.  Each instance of #$RightHandedHuman is a human who favors (e.g. writes with, throws with) his or her right #$Hand.  In most cases, a #$RightHandedHuman will favor his or her right #$Foot-AnimalBodyPart (e.g. when #$Kicking) as well.")
(disjointWith RightHandedHuman LeftHandedHuman)
(comment LeftHandedHuman "A specialization of #$HomoSapiens.  Each instance of #$LeftHandedHuman is a human who favors (e.g. writes with, throws with) his or her left #$Hand.  In most cases, a #$LeftHandedHuman will favor his or her left #$Foot-AnimalBodyPart (e.g. when #$Kicking) as well")
(comment AmbidextrousHuman "A specialization of #$HomoSapiens.  Each instance of #$AmbidextrousHuman is a human who is able to use both hands with approximately equal facility.")
(disjointWith RightHandedHuman AmbidextrousHuman)
(disjointWith LeftHandedHuman AmbidextrousHuman)
(comment relevanceInformingTerm "An assertion of the form (#$relevanceInformingTerm TERM) is used to inform a Cyc inference of the appropriate term ranking to use.  That is, when a Cyc query is run, all of the assertions using the predicate #$relevanceInformingTerm that are visible from the #$Microtheory in which that query is run will contribute to the calculation of the term ranking to be used by that query. More specifically, the instances of #$CycLTerm associated with #$relevanceInformingTerm will be equal valued in the weighting vector, while all other terms not associated will have a null value. The weight vector governs how new value enters into the term ranking, so terms that are inferentially related to terms that are #$relevanceInformingTerms will be more highly valued than those that are not.")
(comment HumanTypeByManualDexterity "A #$FacetingCollectionType.  Each instance of #$HumanTypeByManualDexterity is a collection of #$HomoSapiens who share a \"handedness\" attribute.  #$HumanTypeByManualDexterity has just three instances: #$RightHandedHuman, #$LeftHandedHuman, and #$AmbidextrousHuman.")
(comment OutdoorLocationTypeWithWeatherConditionFn "(#$OutdoorLocationTypeWithWeatherConditionFn WEATHER-QUANTITY) denotes the collection of all #$OutdoorLocations with weather of the type and degree denoted by WEATHER-QUANTITY. This resulting collection is an instance of #$OutdoorLocationByWeatherType.")
(comment ConferenceProceedingsSeries "A periodical dealing with the discussions at a conference or series of conferences.")
(comment TermPhrasesConstraintPredicate "A specialization of #$NLSyntacticPredicate.  Instances of #$TermPhrasesConstraintPredicate are used to relate a string to either a constant or a word unit.  In other words, they describe how a string is used in natural language (e.g. to denote some specific concept, as a #$nameString does, or to relate a string to a #$LexicalWord). The second argument of a #$TermPhrasesConstraintPredicate must be an instance of #$CharacterString.  For example, (#$singular #$Dog-TheWord \"dog\") means that the singular (noun) form of #$Dog-TheWord is \"dog\" and (#$preferredNameString #$Madonna \"Madonna\") means that the string \"Madonna\" refers to the performer #$Madonna.")
(comment httpdRequestSubLBooleanParsingProgramForSKS "(#$httpdRequestSubLParsingProgramForSKS WEB-PAGE SUBL) states that
the web service WEB-PAGE can be parsed into a boolean result by applying
the SubL program SUBL to the result of tokenizing the resulting XML 
stream provided by connecting to the service.")
(comment illuminationLevelForMission "(#$illuminationLevelForMission MISSION ILLUM) means that for
at least some portion of MISSION, the area in which MISSION takes
place (see #$taskAreaOfOperations) will be illuminated at the level
represented by ILLUM. Planning for MISSION should take into account
the operation of equipment under ILLUM conditions.")
(comment NaturalLanguageProcessing "Natural language processing, or NLP, is the collection of all programming (e.g., writing a part of speech tagger) and representation (e.g., adding lexical entries to a knowledge base) activities done in the service of enabling a computer to parse or generate natural language.")
(comment argIsaInstanceOfType "An assertion of the form (#$argIsaInstanceOfType RELN N COLL) asserts that in any assertion using the relation RELN, the Nth argument slot must be filled by some instance of #$Thing  that is an instance of one of the collections that is an instance of the #$Collection COLL; otherwise the assertion is not semantically well-formed.  For example, the assertion (#$argIsaInstanceOfType #$solute 2 #$ExistingStuffType) asserts that anything that fills the second argument place in an assertion using the predicate #$solute must be an instance of one of the collections that is an instance of #$ExistingStuffType.")
(comment NRandomIntegersFn "(#$NRandomIntegersFn N MAX) returns a #$List of N distinct random #$NonNegativeIntegers less than MAX.  Or, if N is greater than or equal to MAX, then it returns a randomized list of all non-negative integers less than MAX.")
(comment SalientDescriptorFETFn "(#$SalientDescriptorFETFn TERM) denotes the collection of #$InducedFormulaTemplate induced based on what is known about TERM.")
(comment roleCardinalityMaxForSubSitType "(roleCardinalityForSceneInScript SCRIPT SCENE ROLE MAX)
means that for any situation, SIT, that is an instance of SCENE and a
subsituation of an instance of SCRIPT, if anything plays ROLE in SIT,
then the number of things that play ROLE in SIT is less than or equal to
MAX.")
(comment HostileSeizureOfTypeFn "This is a collection-denoting function. A NART of the form (#$HostileSeizureOfTypeFn TYPE) denotes the sub-collection of 
#$HostileSeizure, where the role of #$objectOfControlTransfer is an instance of TYPE.")
(comment HostileSeizure "The sub-collection of #$TransferOfControl whose instances are also instance of #$HostileSocialAction.  As with all instance of  #$TransferOfControl, the instances of #$HostileSeizure require the roles #$losesControl, #$takesControl, and #$objectOfControlTransfer.  However, the instances of this collection are events where the transfer is against the will of the agent who fills the #$losesControl. It is important to note that these events are not all instances of #$ActsCommonlyConsideredCriminal, though several sub-collections of  #$ActsCommonlyConsideredCriminal are sub-collections of #$HostileSeizure.")
(comment typeOfHostileSeizureOfType "An assertion of the form (#$typeOfHostileSeizureOfType EVT-TYPE OBJ-TYPE) states that EVT-TYPE is the sub-collection of #$HostileSeizure in which instances of OBJ-TYPE, some sub-collection of #$PartiallyTangible, play the role of #$objectOfControlTransfer.")
(comment mtSpindleHead "(#$mtSpindleHead SPINDLE HEAD) identifies HEAD as the head instance of
#$Microtheory in SPINDLE, an instance of #$MicrotheorySpindle.  This means that HEAD is the spindle member whose contents are visible from all other spindle 
members.  See also #$mtSpindleMember and #$mtSpindleCollector.")
(comment mtSpindleCollector "(#$mtSpindleCollector SPINDLE COLLECTOR) identifies COLLECTOR as the 
collector instance of #$Microtheory in SPINDLE, an instance of #$MicrotheorySpindle SPINDLE. This means that COLLECTOR is the spindle member from which the contents of all other spindle members are visible.  See also #$mtSpindleMember and #$mtSpindleHead.")
(comment GenlsPreservingSubcollectionDenotingFunction "A specialization of both #$GenlsPreservingFunction and #$SubcollectionDenotingFunction (qq.v.).  This is the type of function that always returns a subcollection of one of its arguments, and does so in a way that is #$genls preserving with respect to that argument-place.  More precisely, a function FUNC is an instance of #$GenlsPreservingSubcollectionDenotingFunction if and only if it has an argument-place (say the Nth) such that both of the following hold:
<p>
(i) (#$resultGenlArg FUNC N)
<p>
(ii) (#$preservesGenlsInArg FUNC N) .
<p>
For example, #$PartTypeFn always returns a subcollection of its second argument, and is generalization-preserving in that argument-place.  Thus (#$PartTypeFn #$Cat #$Paw), the collection of cat paws, is a subcollection of #$Paw; and (#$PartTypeFn #$Cat FrontPaw), the collection of cat front paws, is a specialization of the former collection.
<p>
Specializations of #$SubcollectionDenotingFunction include #$UnaryIntersectionFunction and #$SubcollectionFunction.")
(comment SingletonCollectionFn "(#$SingletonCollectionFn TERM) denotes the collection whole sole instance is TERM.")
(comment queryMtForTopicAssertions "(#$queryMtForTopicAssertions TOPIC-TYPE MICROTHEORY)
means that MICROTHEORY is the #$Microtheory the fact entry
tool's find feature will query for assertions on all entities of
TOPIC-TYPE's focal term type. In other words, all assertions created
by templates that are instances of TOPIC-TYPE will be visible to
MICROTHEORY. For example, all instances of #$TerroristGroup created by
templates that are instances of the topic #$TKBTemplate-Organization
are visible from TKBSourceSpindleCollectorMt, so the fact entry tool
is instructed to look there by asserting (#$queryMtForTopicAssertions
#$TKBTemplate-Organization #$TKBSourceSpindleCollectorMt)")
(comment definitionalMtForTopicAssertions "(#$definitionalMtForTopicAssertions TOPIC-TYPE
MICROTHEORY) means that MICROTHEORY is the #$Microtheory where the
fact entry tool will define the constants it creates for
TOPIC-TYPE. In other words, when the fact entry tool creates a new
instance of TOPIC-TYPE's focal term type, the relevant #$isa assertion
will be made in MICROTHEORY. For example, the
#$definitionalMtForTopicAssertions for the topic type
#$TKBTemplate-Organization is #$TKBTopicEntitiesMt, so every
instance of #$TerroristGroup created by the tool is defined as a
#$TerroristGroup in #$TKBTopicEntitiesMt.")
(comment scaleEndPoints "(#$scaleEndPoints SCALE INSTANCE) says that INSTANCE is one of the end points along the #$PrimitiveOrderedQuantityType, SCALE.  So, though one of (#$followingValueOnScale INSTANCE FOLLOWING SCALE) must hold, (#$followingValueOnScale PREVIOUS INSTANCE SCALE), it's not the case that both hold.")
(comment Dangerousness "#$Dangerousness is the #$ScriptPerformanceAttributeType for describing actions in which the performer acts in such a way so as to endanger itself or others.")
(comment levelOfDangerousness "(#$levelOfDangerousness ACTION LEVEL) identifies LEVEL as the degree to which ACTION is/was performed in such a way so as to endanger the performer or others.  Accordingly, (#$isa LEVEL #$Dangerousness).  See also #$levelOfSafeness.")
(comment levelOfSafeness "(#$levelOfSafeness ACTION LEVEL) identifies LEVEL as the degree to which ACTION is/was performed in such a way so as to not endanger the performer or others.  Accordingly, (#$isa LEVEL #$Safeness).  See also #$levelOfDangerousness.")
(comment allSubCollectionsAreInstancesOf "A #$TaxonomicSlotForCollections (q.v.) that can be used to relate a given collection-of-at-least-some-collections to a collection, all of whose specializations are instances of the given collection-of-at-least-some-collections. (#$allSubCollectionsAreInstancesOf COL COL2) means that every specialization of COL is an instance of COL2.  Note that COL2 need not be a specialization of #$Collection, since COL2 may have instances that are not specializations of COL. For example, (#$allSubCollectionsAreInstancesOf #$Situation #$Semi-DirectedPathSystem) means that every collection of situations is a semi-directed path system, but it does not mean that every instance of #$Semi-DirectedPathSystem is a specialization of #$Situation (to make that claim, use the predicate #$typeGenls).")
(comment originalPhrase "Relates a string to the term that was created when the string was mentioned.  (#$originalPhrase Dog001 \"the dog\") means that when Dog001 was created, it was described as \"the dog\".  This predicate is intended to be used for discourse-tracking purposes, where each term created represents a discourse peg, which can then be used for further discourse processing.")
(comment MySentientArchitectureMicrotheorySpindle "An instance of #$MicrotheorySpindle that relates the various instances of #$MySentientModuleMicrotheory.")
(comment IRExpansionQuery "The collection of all instances of #$ElectronicDataSearching in which an automaton searches for so-called \"expansions\" -- terms in a formal represntation language or strings -- that can be used to augment an information retrieval search.")
(comment ChangeOfPropertyHoldings "#$ChangeOfPropertyHoldings is a sub-collection of #$GeneralizedTransfer where there is some change in the state of property.  This includes both rights over that property, as well as the current disposition of that property relative to a constant owner.  The most numerous sub-collections of this collection are the sub-collections of #$ChangeInUserRights.  However, a smaller segment involves changes in the state of property without a change in rights.  Thus, transferring money from a checking account to a savings account (both held with the same #$BankOrganization) would be an instance of #$ChangeOfPropertyHoldings without being an instance of #$ChangeInUserRights.")
(comment PlacementOfFundsForLaundering "#$PlacementOfFundsForLaundering is a sub-collection of #$ChangeOfPropertyHoldings that is associated with #$MoneyLaundering.  Specifically, this represents the first stage in the money laundering process.  This is the initial stage where the funds are coming from a source which the performer wishes to conceal and some transaction is performed which begins to hide their connection to the source.  This can take any number of different forms.  In a successful instance of #$MoneyLaundering, this stage is followed by #$#$LayingOfFundsForLaundering.")
(comment LayeringOfFundsDuringLaundering "#$LayeringOfFundsDuringLaundering is a sub-collection of #$ChangeOfPropertyHoldings that is associated with #$MoneyLaundering.  Specifically, an event of this sort represents the middle stage in the money laundering process.  This stage involves a series of transfers where there is no change in who actually possesses the funds, but how that person came to possess the funds becomes obscured. These transfers can take any number of different forms.")
(comment IntegrationOfFundsDuringLaundering "#$IntegrationOfFundsDuringLaundering is a sub-collection of #$ChangeOfPropertyHoldings that is associated with #$MoneyLaundering.  Specifically, an event of this sort represents the completion of a successful instance of #$MoneyLaundering.  After having obscured the source of some funds, the performer situates the laundered funds such that they are accessible for future use.")
(comment criterionForType "An assertion of the form (#$criterionForType CRIT TYPE) states that CRIT, an instance of #$EvaluativeCriterion, is used for evaluating the quality or worth of instances of TYPE, some #$FirstOrderCollection.")
(comment bugReportLastUpdated "(#$bugReportLastUpdated BUG DATE) means that the last modfication of BUG occured on DATE.")
(comment bugProduct "#$bugProduct is a typed spec pred of #$isa which is used
exclusively to state to which 'product' a bugzilla bug report belongs.")
(comment bugComponent "#$bugComponent is a typed spec pred of #$isa which is used
exclusively to state to which 'component' a bugzilla bug report belongs.")
(comment futureConstantName "This bookkeeping predicate relates a CycL constant to a future \"name\" of that constant.  #$futureConstantName is useful for recording in the KB proposed name changes for constants that are mentioned in code and therefore have names which cannot be readily changed.  <code>(#$futureConstantName CONSTANT STRING)</code> means that the underlying data structure currently associated with the CycL expression <code>CONSTANT</code> will in the future be associated instead with the SubL string <code>STRING</code>.")
(comment RobbingAnAgent "A subcollection of #$Stealing-Physical. In each instance of
#$RobbingAnAgent, one agent steals property from another by means of either intimidation
or force (directed
against the victim's person). Consequently, in cases of
#$RobbingAnAgent, a possessor or guardian of the stolen property (not necessarily
the legal owner) must be present.")
(comment createABugzillaBugReport "This predicate is a #$SimpleActionPredicate which states
that some agent (a #$Cyclist) has created a new #$BugzillaBugReport.")
(comment meetsSomeConstraintOfTopicType "(#$meetsSomeConstraintOfTopicType TERM TOPIC-TYPE) means that TERM meets at least one of the applicability constraints imposed by TOPIC-TYPE.")
(comment NthInteractionOfSessionFn "(#$NthInteractionOfSessionFn SESSION N) denotes the Nth instance of #$ComputerUserInteraction that is a sub-event of the #$ComputerUserInteraction SESSION.")
(disjointWith TaxBracket SituationalObjectType)
(disjointWith QuantityType SituationalObjectType)
(disjointWith TemporalStuffType SituationalObjectType)
(comment SituationalObjectType "A specialization of #$ObjectType (q.v.) whose instances are all and only those collections that are situationally object-like. A collection <code>COL</code> is situationally object-like just in case it generally holds that any proper sub-situation (see #$properSubSituations) of an instance of <code>COL</code> is not itself an instance of <code>COL</code>.  More precisely, a collection <code>COL</code> is an instance of #$SituationalObjectType just in case it satisfies the following: For any distinct <code>OBJ1</code> and <code>OBJ2</code>, if <code>(#$isa OBJ1 COL)</code> and <code>(#$subSituations OBJ1 OBJ2)</code>, then <i>not</i> <code>(#$isa OBJ2 COL)</code>.
<p>
For example, none of the proper sub-situations of a #$Suicide is itself a suicide.  Likewise for #$CrossingAGap.  So #$Suicide and #$CrossingAGap are both instances of #$SituationalObjectType. Conversely, a proper sub-situation of a given #$SportsCompetition might itself be a #$SportsCompetition (e.g. the biathalon during some Olympic games); so #$SportsCompetition is <i>not</i> a situational-object-type.
<p>
See #$SituationalStuffType for the disjoint notion of being situationally stuff-like.")
(disjointWith RelationshipType SituationalStuffType)
(disjointWith QuantityType SituationalStuffType)
(comment SituationalStuffType "A specialization of #$StuffType (q.v.) whose instances are all and only those collections that are situationally stuff-like. A collection COL is situationally stuff-like just in case every sub-situation (see #$subSituations) of an instance of <code>COL</code> is itself an instance of <code>COL</code>, unless it is a sub-situation of a \"situational granule\" of <code>COL</code> (see #$granuleOfStuff).
<p>
More precisely, for a collection <code>COL</code> to be an instance of #$SituationalStuffType it is both a necessary and sufficient condition that for any <code>OBJ1</code> and <code>OBJ2</code> (with <code>OBJ2</code> at or above <code>COL</code>'s situational granularity level), if <code>(#$isa OBJ1 COL)</code> and <code>(#$subSituations OBJ1 OBJ2)</code>, then <code>(#$isa OBJ2 COL)</code>.
<p>
Consider #$CombustionProcess.  Take an arbitrary instance <code>COMBUST</code> of this collection (say the rusting of a derelict ocean liner); and then take an arbitrary sub-situation <code>SUB-COMBUST</code> of <code>COMBUST</code> (say the rusting of the longest hand-rail on the ocean liner).  <code>SUB-COMBUST</code> is itself an instance of #$CombustionProcess.  So #$CombustionProcess is an instance of #$SituationalStuffType.
<p>
See #$SituationalObjectType for the disjoint notion of being situationally object-like.")
(comment assignedValueOfQuantityForEvaluationType "<code>(#$assignedValueOfQuantityForEvaluationType NUMBER INTERVAL EVALUATION-TYPE)</code> says that the #$Quantity  <code>QUANT</code> has been assigned the real number <code>NUMBER</code> for purposes of performing evaluations of type <code>EVALUATION-TYPE</code>.  That is, instances of <code>EVALUATION-TYPE</code> will invoke a numeric scale <code>NUM-SCALE</code> isomorphic with a non-numeric scale <code>SCALE</code> such that <code>NUMBER</code> and <code>QUANT</code> are points along <code>NUM-SCALE</code> and <code>SCALE</code>, respectively, where <code>NUMBER</code> is mapped to <code>QUANT</code>.  For example, given a request such as, 'on a scale from 1 to 10, rate your satisfaction with your new Honda,' the scale that ranges from 1 to 10 is mapped onto a scale that ranges from a certain level of #$Dissatisfaction to a certain level of #$Satisfaction; #$assignedValueOfQuantityForEvaluationType is the predicate one would use in this case to identify the mapping of numbers to levels of satisfaction.")
(comment incompatibleBeliefSystems "An instance of #$BinaryPredicate.  (#$incompatibleBeliefSystems BS1 BS2) means that one cannot have both BS1 and BS2 as #$BeliefSystems without contradicting oneself.  That is, anyone having both BS1 and BS2 is committed to (though may not explicitly believe) at least one contradictory proposition.  There is a default rule stating that agents don't have incompatible belief systems.")
(comment properSubEvents "A specialization of #$properSubSituations and #$subEvents (qq.v.). This predicate relates events to further events which are their proper sub-events.  <code>(#$properSubEvents EVENT SUBEVENT)</code> means that the #$Event <code>SUBEVENT</code> is a part of the #$Event <code>EVENT</code>, a complete description of <code>EVENT</code> would have to involve a description of <code>SUBEVENT</code>, and <code>SUBEVENT</code> is not identical to <code>EVENT</code> itself.  For example, an event in which a car is being parallel-parked might be an event in which a person turning a steering wheel is a proper sub-event.  See also #$properSubEventTypes.")
(comment properSubEventTypes "A #$FirstOrderCollectionPredicate that is a specialization of #$properSubSituationTypes and #$subEventTypes (qq.v.) and a type-level correlate of #$properSubEvents (q.v.). This predicate is used to state that events of one given type always have events of another given type as proper subevents. <code>(#$properSubEventTypes EVENTTYPE SUBEVENTTYPE)</code> means that <code>EVENTTYPE</code> (a specialization of #$Event) has the specialization of #$Event <code>SUBEVENTTYPE</code> as a proper sub-event type.  For example, (#$properSubEventTypes #$CatchingWithHands #$ArmMovement) means that each catching event has an arm movement as a proper subevent.")
(comment FamiliarReferent " Instances of this collection are #$CycLTerms which are                                                                
introduced by a defininte NPwhich presupposes the familiarity of the                                                             
entity referred to.")
(comment WhiteZinfandel "A specialization of #$BlushWine.")
(comment Unhappiness "The collection of all amounts of unhappiness that an agent can feel.  Notable specializations include #$Sadness and #$Anger.")
(comment IntervalTypeRatingFn "An instance of #$UnreifiableFunction used in calculating and referring to points along a scale.  (#$IntervalTypeRatingFn SCALE EVALUATION-TYPE REAL) denotes a particular instance INS of #$Quantity that is, for purposes of performing evaluations of type EVALUATION-TYPE, a point on SCALE. The location of INS along SCALE is determined by its position along the real number line between N and M, where N is the assigned value (cf. #$assignedValueOfQuantityForEvaluationType) of one end points (cf. #$scaleEndPoints) on SCALE, and M is the assigned value of the other end point on SCALE. Note that these requirements mean that #$IntervalTypeRatingFn is a partial function (cf. #$PartialFunction).")
(comment CoexistenceRelation "A specialization of #$TemporalExistenceRelation.  This is the collection of relations such that: If EXP is an assertion or a denotational term in which one of these relations, RELN, stands in arg0 of EXP and ARG is a non-zero argument of EXP that is an instance of #$TemporalThing, then, if EXP denotes or is true (depending on whether it is a denotational term or an assertion), then the temporal extent of ARG must subsume the time index of EXP and, if RELN is a function and returns an instance of #$TemporalThing, then applying the function to its arguments results in something whose temporal extent also subsumes the time index of EXP.
<p>
More precisely,
<p>
If RELN is an instance of this collection and a function embedded in an assertion like the following,
<p>
(PRED ARG1...ARGN...(RELN R-ARG1 ...R-ARGN))<MT TIME PAR>
<p>
then '(RELN R-ARG1 ...R-ARGN)' denotes a value, VAL, only if, for each argument R-ARG1 - R-ARGN and VAL that is an instance of #$TemporalThing, that argument's (and value's) temporal extent subsumes TIME in MT to PAR.
<p>
If RELN is a predicate in arg0 of an assertion like the following,
<p>
(RELN ARG1...ARGN)<MT TIME PAR>
<p>
then '(RELN ARG1...ARGN)' is true in MT at TIME to PAR only if the temporal extent of each argument ARG1 - ARGN that is an instance of #$TemporalThing is such that its temporal extent subsumes TIME in MT to PAR.
<p>
For example, #$TerritoryFn is a function that returns the territory of it's arg1.  Since '(#$TerritoryFn COUNTRY)' only denotes when embedded in an assertion whose time index is such that COUNTRY and that country's territory both subsume that time index, #$TerritoryFn is an instance of #$CoexistenceRelation.  So the following cannot be true:
<p>
(#$awareOf BobTheCaveMan (#$TerritoryFn #$France))<PrimitiveMt 30000BC #$TimePoint>
<p>
This follows from the fact that '(#$TerritoryFn #$France)' does not denote anything in 30000BC because France did not exist then.
<p>
A sufficient condition for membership in this collection is if the relation is a corresponding function (see #$functionCorrespondingPredicate-Generic and its specs) to a predicate that is an instance of #$CoexistencePredicate.")
(disjointWith ComputerUserInteraction-SingleUser ComputerUserInteraction-MultipleUsers)
(comment SoftwareInteractionSessionRecordMicrotheory "A specialization of #$DataMicrotheory.  Instances store information about a particular software interaction.")
(comment recordOfSession "(#$recordOfSession RECORDMT SESSION) identifies RECORDMT as the instance of #$SoftwareInteractionSessionRecordMicrotheory in which data about the #$ComputerUserInteractiveSession SESSION is stored.")
(comment TaxonomicPredicateForPredicates "A specialization of both #$TaxonomicPredicate and #$MetaPredicate. Each instance of #$TaxonomicPredicateForPredicates is a predicate used to help define the taxonomy of #$Predicates by specifying relations between various predicates; hence at least two of its argument-places are constrained to instances (see #$argIsa) of #$Predicate or some broad specialization thereof (such as #$BinaryPredicate).  Examples include #$genlPredsWRTArgs and #$genlPredsWRTTypes.  An important specialization of this collection is #$TaxonomicSlotForPredicates (q.v.).")
(comment TaxonomicPredicate "A subcollection of #$Predicate.  Each instance of #$TaxonomicPredicate is a predicate used to help specify the position of a thing within one of the major taxonomies or hierarchies in the Cyc ontology.  An important specialization of #$TaxonomicPredicate is #$TaxonomicSlot (q.v.).  Whereas instances of #$TaxonomicSlot are binary predicates that specify a specific relation between two terms in a taxonomy, other predicates that are instances of #$TaxonomicPredicate are used to indicate that a relation holds between two terms in a taxonomy in a manner mediated by other terms.  For example, #$genlPredsWRTTypes is an instance of #$TaxonomicPredicate that is not an instance of #$TaxonomicSlot, and (#$genlPredsWRTTypes BINPRED1 BINPRED2 COL1 COL2) means that if (BINPRED1 INS1 INS2) where INS1 is an instance of COL1 and INS2 is an instance of COL2, then (BINPRED2 INS1 INS2).")
(comment CurrentAssignedTasks-TemplateType "A specialization of #$CurrentCycorpEmployee-TemplateTopic. Each
instance of this colleciton is a #$FormulaTemplate used to update
monthly staff tasks.")
(comment GivingSanctuary "A specialization of #$ProtectingSomething. In each instance
of #$GivingSanctuary, one agent permits another (SHELTERED) to occupy
a place controlled by the first, in order to protect SHELTERED from a
risk of harm (physical harm, arrest, etc.) that she would otherwise
face.")
(comment TaxonomicPredicateForCollections "A specialization of both #$TaxonomicPredicate and #$MetaPredicate. Each instance of #$TaxonomicPredicateForCollections is a predicate used to help define the taxonomy of #$Collections by specifying relations between various predicates; hence at least two of its argument-places are constrained to instances (see #$argIsa) of #$Collection or some broad specialization thereof (such as #$FirstOrderCollection).  For example, #$genlsWRTSubSituations is an instance of #$TaxonomicPredicateForCollections.  An important specialization of this collection is #$TaxonomicSlotForCollections (q.v.).")
(comment TaxonomicPredicateForAnyThing "A specialization of both #$TaxonomicPredicate and #$MetaPredicate. Each instance of #$TaxonomicPredicateForAnyThing is a predicate that can in principle be used to help specify the location of anything whatsoever within some taxonomy; hence at least one of its argument-places must be constrained to instances (see #$argIsa) of #$Thing (and to nothing more specific than #$Thing).  For example, #$isaBoth is an instance of this collection. An important specialization of this collection is #$TaxonomicSlotForAnyThing (q.v.).")
(comment uniqueRolePlayerOfTypeForSubSitType "(uniqueRolePlayerOfTypeForSubSitType SIT-TYPE SUBSIT-TYPE ROLE-PLAYER-TYPE ROLE) means that for any situation, SUBSIT, that is an instance of SUBSIT-TYPE and a subsituation of an instance of SIT-TYPE, at most one thing of type ROLE-PLAYER-TYPE plays ROLE in SUBSIT.")
(comment irExpansionSet-DefinitionalSelectedWRTProperty "An instance of #$IRExpansionPredicate. (#$irExpansionSet-DefinitionalSelectedWRTProperty TERM PRED INT SET) identifies SET as the set of collections that (i) are definitional #$isas for TERM, and (ii) are no more general than the argtype constraint(s) applicable to PRED in the INT-th argument place. This predicate represents an attempt to limit expansions for IR queries to those terms that might be more relevant given what other information is known about TERM -- assuming, in particular, that the property expressed by the predicate PRED is relevant to a given IR context. Contrast with #$irExpansionSet-Definitional-CoarseGrained.")
(comment LatinAmericanCountry "The collection of nation-states whose territory is solely in Central and South America.")
(comment Telegram-CW "The collection of all #$ConceptualWorks that play the role of #$infoTransferred in an instance of #$SendingATelegram.")
(comment TelegramCopy "The collection of all #$HumanAccessibleIBTs which instantiate (see #$instantiationOfWork) some instance of #$Telegram-CW.")
(comment PlantTypeByEffectOnOrganism "A specialization of #$ConventionalClassificationType.  Each
instance of this collection is a collection of #$Plants that has
demonstrated some general effect on some kind of organisms.  Notable
specializations of this collection include #$HarmfulPlantType and
#$MedicinalPlantType.")
(comment HarmfulPlantType "A specialization of #$PlantTypeByEffectOnOrganism. Each
instance of this collection is a collection of #$Plant such that
plants of that type are harmful to some type of organism. 'Harmful' is
broadly defined in this case; what may be harmful to one organism type
may not be to another. In addition, harm is underspecified wrt how the
plants may be harmful. Some plants, like #$PoisonIvy-Plant, are
harmful to organisms when contact is made with plant instances, and
other types or plant are harmful upon ingestion.")
(comment MedicinalPlantType "A specialization of #$PlantTypeByEffectOnOrganism.  Each
instance of this collection is a collection of #$Plant such that
plants of that type are considered medicinal to some kinds of
organisms.  In this case, 'medicinal' is broadly defined.  Not only
will the medicinal properties of plant types change depending on
organism types, but how the plant is used medicinally will change.  In
different contexts, medicinal plants are ingested or smoked or put into
contact with a wound.  Note, too, that the concepts of 'medicinal' will also be
dependant on culture.")
(comment DongQuai-ThePlant "A specialization of #$PerennialPlant and #$FloweringPlant.
Each instance of this collection is a plant from the genus Angelica
and the species of sinensis.  This plant is indigenous to Asia and
grows at high altitudes.")
(comment SawPalmetto-Plant "A specialization of #$PalmOrder.  Each instance of this
collection is a plant from the genus Serenoa and of the species
repens.  It grows to about 3 to 6 feet in height and is native to the
West Indies and the southern Atlantic coast of the U.S.")
(comment StJohnsWort-Plant "A specialization of #$Plant-NonWoody, #$PerennialPlant, and
#$FloweringPlant.  Each instance of this collection is a plant from
the genus Hypericum and of the species perforatum.  It typically grows
as a small, low shrub with yellow flowers and is found thoughout
Europe and North America.")
(comment Cayenne-Plant "A specialization of #$Plant-Woody.  Each instance of this
collection is a plant from the genus Capsicum and of the species
frutescens.  It typically grows to 3 feet or more and is found in many
parts of the world, including Africa, Asia, and South America.")
(comment BroadwayShow "A specialization of #$PlayPerformance.  Each instance of
this collection is a #$PlayPerformance performed at or formerly
performed at #$BroadwayTheAvenue, specifically the section called 'The
Great White Way'.  Most of the performances on Broadway are musicals,
but not exclusively.")
(comment FiscalCycleFn "(#$FiscalCycleFn TIME-QUANTITY) denotes the
collection of fiscal cycles of type TIME-QUANTITY.  Thus, (#$FiscalCycleFn (#$QuartersDuration 1)) denotes the collection of fiscal cycles that are quarter-years in duration.")
(comment CNLPOntology "An instance of #$Ontology, authored by CNLP (see #$CNLP) for information retrieval purposes.")
(comment BiochemicalProcess "The collection intersection  of #$ChemicalInteraction and
#$BiologicalProcess.  Each instance of this collection is a chemical
interaction in which a biological thing(s) has some role.")
(comment CBLMethodFn "A binary function that returns a #$CBLMethod and which is composed of the #$CBLNode and the method name.")
(comment DeterminingANeedForHumanInterventionInAComputerUserInteraction "A specialization of #$Evaluating.  Instances are events in which an agent determines whether a given #$ComputerUserInteraction is going so poorly that a human needs to assist the user.")
(comment DialogueTrackingGMt "The most general microtheory for describing concepts and 
hueristics needed for dialogue tracking.")
(comment DeterminingWhetherSomeoneNeedsAssistance "The collection of are events in which an agent evaluates a situation to determine whether an agent (see #$Agent-Generic) needs assistance.")
(comment DiscourseTrackingPeg "A collection of \"pegs\" used to keep track of both linguistic and
non-linguistic objects which are important for representing a discourse.")
(comment LinguisticExpressionPeg "A collection of \"pegs\" used to keep track of the linguistic
objects which are important for representing a discourse.")
(comment DiscourseReferentPeg "A collection of \"pegs\" used to keep track of the entities (discourse referents) which are referred to in discourse.")
(comment naiveReferent "(#$naiveReferent LINGPEG REFPEG) means that REFPEG is the unique #$DiscourseReferentPeg introduced into discourse by the #$LinguisticExpressionPeg LINGPEG.")
(comment possiblyCoreferent "(#$possiblyCoreferent TERM1 TERM2) means that the #$LinguisticObjects TERM1 and TERM2 have been identified as potentially coreferential.")
(comment nearestPossibleAntecedent "(#$nearestPossibleAntecedent DEP ANTE) means that the #$LinguisticObject ANTE has been identified as the, or one of the, \"nearest\" potential antecedent(s) for the referentially dependent expression DEP.  In general, this entails that no other potential antecedent for DEP has been used more recently than ANTE.")
(comment LinguisticExpressionType "Instances of this collection facet #$LinguisticExpressionPegs according to various properties (e.g. linguistic gender or number) of the expression used to introduce the refent peg into the discourse. Notable specializations include #$ExpressionTypeByGender and #$ExpressionTypeByNumber.")
(comment ExpressionTypeByGender "A specialization of #$LinguisticExpressionType.  Instances of this collection facet #$LinguisticExpressionPeg according to  the linguistic gender of the expression used to introduce the referent peg into the discourse. Instances include #$MasculineExpression, #$FeminineExpression, #$NeuterExpression, and #$ExpressionOfUnknownGender.")
(comment ExpressionTypeByNumber "A specialization of #$LinguisticExpressionType.  Instances of this collection facet #$LinguisticExpressionPPeg according to  the linguistic number of the expression used to introduce the referent peg into the discourse. Instances include #$SingularExpression, #$PluralExpression, and #$ExpressionOfUnknownNumber.")
(comment MasculineExpression "Instances of this collection are #$LinguisticExpressionPegs which are marked for masculine agreement.")
(comment FeminineExpression "Instances of this collection are #$LinguisticExpressionPegs which are marked for feminine agreement.")
(comment NeuterExpression "Instances of this collection are #$LinguisticExpressionPegs which are marked for neuter agreement.")
(comment ExpressionOfUnknownGender "Instances of this collection are #$LinguisticExpressionPegs which are either unmarked or are marked ambiguously wrt. gender agreement.")
(comment SingularExpression "Instances of this collection are #$LinguisticExpressionPegs which are marked for singluar agreement.")
(comment PluralExpression "Instances of this collection are #$LinguisticExpressionPegs which are marked for plural agreement.")
(comment ExpressionOfUnknownNumber "Instances of this collection are #$LinguisticExpressionPegs which are unmarked (or marked ambiguously) wrt. number agreement.")
(comment DefiniteExpression " Instances of this collection are #$LinguisticExpressionPegs which are marked as definite. The use of such expressions generally presupposes the familiarity of the entity (peg) referred to.")
(comment IndefiniteExpression " Instances of this collection are #$LinguisticExpressionPegs which  are either indefinite or unmarked wrt. definiteness. The use of such expressions generally imply the discourse novelty of the entity (peg) referred to.")
(comment expressionTypeForTag "This predicate is used to relate certain #$NLUtteranceAttributes with corresponding #$LinguisticExpressionTypes.  E.g., (#$expressionTypeForTag NLATTR EXPRTYPE) means #$NLTaggedTerms bearing the #$NLUtteranceAttribute TAG introduces an expression  (i.e. a #$LinguisticExpressionPeg) of the #$LinguisticExpressionType EXPRTYPE. E.g., #$Masculine-NLAttr is associated with #$MasculineReferent.")
(comment CBLParameterFn "A binary function that returns a #$CBLParameter and which is composed of the #$CBLMethod and the name of the method parameter.")
(comment agreeInNumber "  This predicate provides a means of indicating that two #$LinguisticOBjectPegs are in agreement wrt. grammatically marked number.")
(comment agreeInGender "  This predicate provides a means of indicating that two #$LinguisticOBjectPegs are in agreement wrt. grammatically marked gender.")
(comment agreeInMarking "  This predicate provides a means of indicating that two #$LinguisticOBjectPegs are in agreement wrt. all of their marked grammatical features marked feature (e.g. number or gender).")
(comment agreeInType "  This predicate provides a means of indicating that two #$DiscourseReferntPegs agree (and overlap) in terms of semantic type, and hence are potentially identical (c.f. #$coReferring).  In particular, (#$agreeInType TERM1 TERM2) means that the known semantic types for TERM1 and TERM2 are compatible (i.e. they're not disjoint) and overlap in some non-trivial way.  In general, it entails that i) some #$nearestIsa for one is a spec of some #$nearestIsa for the other; and ii) no #$nearestIsa for one is #$disjointWith any #$nearestIsa of the other.")
(comment CBLGroupFn "A binary function that returns a #$CBLGroup command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment TemporalExistenceRelation "An instance of #$RelationshipType and a specialization of #$TemporallyQualifiableRelation.  Each instance of #$TemporalExistenceRelation is a relation that is \"contemporary\" in one of its arguments places or, if it is a function, in the #$resultIsa.
<p>
That is, if RELN is an instance of this collection, then either
<p>
RELN is a predicate and there is at least one i (0 < i <= N), such that if
<p>
(RELN ARG-1, ..., ARG-N)<MT TIME PAR>
<p>
holds, then the temporal extent of ARG-i must subsume TIME. Or,
<p>
RELN is a function such that RELN denotes a value only if
<p>
(i) there exists an argument place that is \"contemporary\" in the way described in the condition for predicates  -- RELN will only denote if the temporal extent of the argument in the contemporary spot subsumes the time index of the assertion in which RELN appears as a denotational term.  Or,
<p>
(ii) the temporal extent of the assigned value for a given sequence of arguments to RELN subsumes the time index of the assertion in which RELN appears as a denotation term.
<p>
For further information about these conditions see the comments on #$TemporalExistenceRelation and #$CoexistenceRelation.")
(comment CBLMethodStateVariableFn "A ternary function of the form (CBLMethodStateVariableFn METHOD NAME SEQUENCE) that returns a #$CBLMethodStateVariable and which is composed of the #$CBLMethod, the name of the state variable and the unique sequence number.")
(comment MarketingTask "An instance of #$SecondOrderCollection.  Instances are collections of #$PurposefulActions with the goal of supporting some marketing effort.  See also #$MarketingActivity.")
(comment taskSupportsTask "An assertion of the form (#$taskSupportsTask TASK1 TASK2) asserts that the TASK1, some type of #$PurposefulAction is planned because it is believe to aide in the achievement of TASK2, a type of #$PurposefulAction. With this predicate, TASK1 is not a 'part' of TASK2, that relationship is represented using #$subTasks.")
(comment TaskState "#$TaskState is a sub-collection of #$Microtheory.  Instances of this collection each hold a set of assertions that represent a state of affairs that bears one of a number of relations to a task, some type of #$PurposefulAction.  In this way, being a 'goal' or being a 'prerequisite' is a relational property to a planned action.  Moreover, an instance of #$TaskState can be a goal of one task and a prerequisite for another. Representing a #$TaskState as a goal for a planned action is done with the predicate #$taskToAchieve.  Representing a #$TaskState as a prerequisite for the performance of a planned action is done with the predicate #$taskPrerequisites.  Representing a #$TaskState as a normative constraint on a planned action is done with the predicate #$taskConstraints.")
(comment prerequisiteDescription "An assertion of the form (#$prerequisiteDescription STATE STRING) represents that STRING is a nautral language representation of the contents of STATE, some instance of #$TaskState, which describe how the world would be were STATE to be satisfied. The content of this string, will be determined by the task (some type of #$PurposefulAction, to which STATE bears the relation #$taskPrerequisites.")
(comment stateDescription "An assertion of the form (#$stateDescription STATE STRING) represents that STRING is a natural language representation of the content of STATE, some instance of #$TaskState.")
(comment confirmationMt "An assertion of the form (#$confirmationMt STATE MT) asserts that when evaluating the satisfaction of the contents of the #$TaskState STATE, the truth of its contents should be evaluated relative to the #$Microtheory MT.")
(comment goalDescription "An assertion of the form (#$goalDescription GOAL STRING) represents that STRING is a nautral language representation of the contents of GOAL, some instance of #$TaskState, which describe the state of affairs that  would satisfy GOAL.  The content of this string will be determined by the task (some type of #$PurposefulAction, to which STATE bears the relation #$taskToAchieve.")
(comment taskConstraints "An assertion of the form (#$taskConstraints TASK CONSTRAINT) asserts that the contents of CONSTRAINT, an instance of #$TaskState, represent some kind of normative constraint on the performance of TASK, a type of #$PurposefulAction.  If any of the assertions contained in CONSTRAINT are false during the performance of TASK, then TASK has violated CONSTRAINT.  The contents of CONSTRAINT could include any number of different things: deadlines, budgets, codes of conduct, etc.")
(comment taskPrerequisites "An assertion of the form (#$taskPrerequisites TASK STATE) asserts that the contents of STATE, an instance of #$TaskState, must be true before TASK, a type of #$PurposefulAction, can be performed.")
(comment taskGenls "An assertion of the form (#$taskGenls SPEC-TASK GENL-TASK) means that SPEC-TASK, a type of #$PurposefulAction,  is a more-specific form of GENL-TASK.  For example, (#$taskGenls #$TKBProjectTask-TenseInferenceCanonicalizerPrerequisites (#$SubCollectionOfWithRelationToFn #$SoftwareDevelopment #$performedBy #$Pace)) would assert that #$TKBProjectTask-TenseInferenceCanonicalizerPrerequisites is a type of #$SoftwareDevelopment #$performedBy #$Pace.")
(comment taskToAchieve "An assertion of the form (#$taskToAchieve TASK GOAL) asserts that TASK, a type of #$PurposefulAction, has been planned in order to achieve GOAL, an instance of #$TaskState and, ceteris paribus, when TASK has been performed, then the contents of GOAL will be true in the relevant context.")
(comment taskSubStates "An assertion of the form (#$taskSubStates TASK GOAL) states that GOAL, a type of #$TaskState, is a goal which is planned to be accomplished within TASK.  TASK is a type of #$PurposefulAction. This means, that an instance of TASK will, ceteris paribus, temporally subsume a state of affairs during which the contents of GOAL are true.")
(comment goalSupportsGoal "An assertion of the form (#$goalSupportsGoal GOAL1 GOAL2) asserts that the #$TaskState GOAL1 exists as a desired or intended state of affairs because such a state of affairs is believed to aid in the achievement of #$TaskState GOAL2.")
(comment hasGoals "An assertion of the form (#$hasGoals AGENT GOAL) asserts that the #$IntelligentAgent AGENT has as a goal that the contents of #$TaskState GOAL all be true. This predicate is significant because it points to a final goal.  AGENT's relation to other goals which are derived from possessing GOAL as a final goal would be represented using the predicate #$hasSupportingGoalWRTGoal.")
(comment hasTasksWRTGoal "An assertion of the form (#$hasTasksWRTGoal AGENT TASK GOAL) asserts that the #$IntelligentAgent AGENT is planning to perform an instance of TASK, some type of #$PurposefulAction, as a step towards achieving the #$TaskState GOAL to which AGENT bears either the relation #$hasGoals or #$hasDependentGoalsWRTGoal (for the later, GOAL would fill the second argument position).")
(comment hasSupportingGoalWRTGoal "An assertion of the form (#$hasSupportingGoalWRTGoal AGENT DEP-GOAL GOAL) asserts that the #$IntelligentAgent AGENT wants the contents of the #$TaskState DEP-GOAL to be true, but this desire is derived from an original desire that the other instance of #$TaskState, GOAL, be true.  The original assertion can be derived from the following two assertions (#$hasGoals AGENT GOAL) and (#$goalSupportsGoal DEP-GOAL GOAL).")
(comment RealizedTaskState "The collection #$RealizedTaskState is a sub-collection of #$TaskState.  A #$TaskState, STATE, is an instance of #$RealizedTaskState just in case every assertion P which is asserted within STATE is true within the #$Microtheory to which STATE bears the relation #$confirmationMt.")
(comment constraintDescription "An assertion of the form (#$constraintDescription STATE STRING) represents that STRING is a natural language representation of the contents of STATE, some instance of #$TaskState, which describe how the world would be were STATE to be satisfied. The content of this string, will be determined by the task (some type of #$PurposefulAction, to which STATE bears the relation #$taskConstraints.")
(comment CBLForEachFn "A binary function that returns a #$CBLForEach command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment taskHasPrereqWRTPostCond "An assertion of the form (#$taskHasPrereqWRTPostCond TASK PRE-STATE POST-STATE) is used to relate a type of #$PurposefulAction, TASK, to two instances of #$TaskState, PRE-STATE and POST-STATE. The assertion requires (#$taskPrerequisites TASK PRE-STATE) and (#$taskPostConditions TASK POST-STATE) both be true.  This predicate is intended for complex tasks that are related to multiple prerequisites and multiple post conditions.  If it is the case that a postcondition only depends only a subset of the preconditions, this predicate allows for a representation of that connection. In this way, the abandonning of a post-condition may eliminate the need to meet some of the pre-conditions for TASK.")
(comment taskPostConditions "An assertion of the form (#$taskPostConditions TASK POST) asserts that TASK, a type of #$PurposefulAction, is expected to make true all of the assertions in POST, an instance of #$TaskState.")
(comment stateHasTaskAsOption "An assertion of the form (#$stateHasTaskAsOption STATE TASK) is used to assert that STATE, an instance of #$TaskState, is such that it could be achieved by a performance of TASK, a type of #$PurposefulAction.  This predicate is introduced into the representation of plans to represent that the plan contains more than one option for pursuing.  Without an assertion of this form, all task which are connected to STATE via the predicate #$taskEndState, or its specializations, are assumed to be a requirement for STATE.")
(comment hasProjectForGoal "An assertion of the from (#$hasProjectForGoal AGENT PROJECT GOAL) is used to assert that AGENT, an instance of #$IntelligentAgent plans PROJECT as the overall task for achieving GOAL.  This predicate assumes (#$hasGoals AGENT GOAL) such that GOAL has independent motivation and is not wholly motivated by a desire to perform some further (although GOAL may be in line with or somehow help achieve other goals).")
(comment postConditionsMt "An assertion of the form (#$postConditionsMt TASK MT) asserts that the assertions which represent the actual effects of the performance of TASK, a type of #$PurposefulAction, would be asserted in MT, a #$Microtheory.")
(comment CBLSendFn "A binary function that returns a #$CBLSend command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment CBLLogFn "A binary function that returns a #$CBLLog command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment CBLStartChildNodeFn "A binary function that returns a #$CBLStartChildNode command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment keStrengtheningSuggestion "(#$keStrengtheningSuggestion WEAK-SENTENCE STRONG-SENTENCE) means that, STRONG-SENTENCE entails WEAK-SENTENCE (and hopefully more) and is therefore a suitable suggestion to strengthen it (not necessarily strictly).  As a corollary, WEAK-SENTENCE is a suitable suggestion to weaken STRONG-SENTENCE.  This predicate does not require that either sentence have any particular truth value.")
(comment keRelationStrengthensViaArg "If (#$keRelationStrengthensViaArg RELATION BINPRED ARGNUM) and (BINPRED WEAK STRONG), then (#$keStrengtheningSuggestion (RELATION ... WEAK ...) (RELATION ... STRONG ...)).  In other words, (#$keRelationStrengthensViaArg RELATION BINPRED ARGNUM) means that the binary predicate BINPRED can be used to strengthen a sentence with arg0 RELATION (or used inversely to weaken it) by replacement of the ARGNUMth argument.  It is not a requirement that all potential replacement sentences be well-formed.")
(comment keRelationStrengthensViaArg-Inverse "If (#$keRelationStrengthensViaArg-Inverse RELATION BINPRED ARGNUM) and (BINPRED STRONG WEAK), then (#$keStrengtheningSuggestion (RELATION ... WEAK ...) (RELATION ... STRONG ...)).  In other words, (#$keRelationStrengthensViaArg-Inverse RELATION BINPRED ARGNUM) means that the binary predicate BINPRED can be used to weaken a sentence with arg0 RELATION (or used inversely to strengthen it) by replacement of the ARGNUMth argument.  It is not a requirement that all potential replacement sentences be well-formed.")
(comment keRelationStrengthensViaAllArgs "If (#$keRelationStrengthensViaAllArgs RELATION BINPRED ARGNUM) and (BINPRED WEAK STRONG), then (#$keStrengtheningSuggestion (RELATION ... WEAK ...) (RELATION ... STRONG ...)).  In other words, (#$keRelationStrengthensViaAllArgs RELATION BINPRED ARGNUM) means that the binary predicate BINPRED can be used to strengthen a sentence with arg0 RELATION (or used inversely to weaken it) by replacement of any argument (except arg0).  It is not a requirement that all potential replacement sentences be well-formed.  RELATION will typically have variable arity.")
(comment keRelationStrengthensViaAllArgs-Inverse "If (#$keRelationStrengthensViaAllArgs-Inverse RELATION BINPRED ARGNUM) and (BINPRED STRONG WEAK), then (#$keStrengtheningSuggestion (RELATION ... WEAK ...) (RELATION ... STRONG ...)).  In other words, (#$keRelationStrengthensViaAllArgs-Inverse RELATION BINPRED ARGNUM) means that the binary predicate BINPRED can be used to weaken a sentence with arg0 RELATION (or used inversely to strengthen it) by replacement of any argument (except arg0).  It is not a requirement that all potential replacement sentences be well-formed.  RELATION will typically have variable arity.")
(comment userProgramLoginTime "(#$userProgramLoginTime USER PROGRAM TIME) says that the agent USER logged in to use the interactive program PROGRAM at TIME.")
(comment nthExpressionOfSession "(#$nthExpressionOfSession SESSION PEG N) means that the #$LinguisticExpressionPeg PEG is the Nth peg introduced in the #$MySentientSoftwareInteractionSession SESSION.  In general, the numbering of pegs should reflect interaction precedence (i.e. pegs of more recent interactions should ordered higher), as well as ordering within user inputs.")
(comment taskToAvoid "An assertion of the form (#$taskToAvoid TASK STATE) asserts that TASK, a type of #$PurposefulAction, has been planned in order to avoid a situation in which the assertions contained in STATE, an instance of #$TaskState, become true. Therefore, TASK is aimed at keeping those assertions false.")
(comment taskEndState "An assertion of the form (#$taskEndState TASK STATE) is used to relate a type of #$PurposefulAction to an instance of #$TaskState.  This is a very general predicate and it points to a state of affairs to which TASK has some causal relation.  The specializations of #$taskEndState pick out these different causal relations:  achieving a state, maintaining a state, avoiding a state, etc.")
(comment taskToMaintain "An assertion of the form (#$taskToMaintain TASK STATE) asserts that TASK, a type of #$PurposefulAction, has been planned in order to maintain the truth of the assertions in contained in STATE, an instance of #$TaskState.")
(comment avoidanceAttitudeTo "An assertion of the form (#$avoidanceAttitudeTo AGENT STATE) is used to relate an #$IntelligentAgent to an instance of #$TaskState.  It effectively means that AGENT does not believe that any of the content assertions of STATE are true and that AGENT intends for them to remain false.  This predicate is neutral on the position of STATE within the hierarchy of AGENT's goals.  Those properties are represented using the predicates #$hasGoals and #$hasSupportingGoalWRTGoal.")
(comment maintenanceAttitudeTo "An assertion of the form (#$maintenanceAttitudeTo AGENT STATE) is used to relate an #$IntelligentAgent to an instance of #$TaskState.  It effectively means that AGENT believes that the contents of STATE are true and that AGENT intends for them to remain true.  This predicate is neutral on the position of STATE within the hierarchy of AGENT's goals.  Those properties are represented using the predicates #$hasGoals and #$hasSupportingGoalWRTGoal.")
(comment achievementAttitudeTo "An assertion of the form (#$achievementAttitudeTo AGENT STATE) is used to relate an #$IntelligentAgent to an instance of #$TaskState.  It effectively means that AGENT does not believe that the contents of STATE are true, but that AGENT intends for them to become true.  This predicate is neutral on the position of STATE within the hierarchy of AGENT's goals.  Those properties are represented using the predicates #$hasGoals and #$hasSupportingGoalWRTGoal.")
(comment CBLTaskFn "A binary function that returns a #$CBLTask command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment CBLStopChildNodeFn "A binary function that returns a #$CBLStopChildNode command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment CBLAssignFn "A binary function that returns a #$CBLAssign command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment CBLWhileFn "A binary function that returns a #$CBLWhile command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment CBLCommentFn "A binary function that returns a #$CBLComment command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment CBLCallFn "A binary function that returns a #$CBLCall command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment earlyPartOfInterval "(#$earlyPartOfInterval TIME-INTERVAL EARLY-PART) means that
EARLY-PART is the interval denoted in English by the phrase 'early
TIME-INTERVAL,' e.g., 'the early 1990s.'  See the comment on
the corresponding function #$EarlyPartFn.")
(comment latePartOfInterval "(#$latePartOfInterval TIME-INTERVAL LATE-PART) means that
LATE-PART is the interval denoted in English by the phrase 'late
TIME-INTERVAL,' e.g., 'the late 1980s.'  See the comment on the
corresponding function #$LatePartFn.")
(comment CBLMustFn "A binary function that returns a #$CBLMust command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment CBLSleepFn "A binary function that returns a #$CBLSleep command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment MicrotheoryRelatingPredicate "A collection of #$IntangibleObjectRelatingPredicates (q.v.) used to assert relationships between microtheories.  As such, each instance of #$MicrotheoryRelatingPredicate has at least two of its argument-places constrained (see #$argIsa) to instances of #$Microtheory or some subcollection thereof.  Examples include #$genlMt, #$subAgreements, and #$mtMonad.")
(comment MiddlePartFn "(#$MiddlePartFn TIME-INTERVAL) denotes the #$TimeInterval
expressed by the English phrase 'mid TIME-INTERVAL' -- e.g., 'the mid
1980s.' (#$MiddlePartFn TIME-INTERVAL) thus denotes an interval that
begins slightly more than 1/3 of the way through TIME-INTERVAL, and
ends slightly less than 2/3 of the way through it.  Cf.,
#$middlePartOfInterval.")
(comment CBLSuspendFn "A binary function that returns a #$CBLSuspend command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment CBLResumeFn "A binary function that returns a #$CBLResume command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment CBLSucceedFn "A binary function that returns a #$CBLSucceed command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment CBLFailFn "A binary function that returns a #$CBLFail command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment defaultComponentForProduct "This predicate relates a bugzilla bug report 'product' to
its default 'component' for automated bug reporting. That is,
(#$defaultComponentForProduct COMPONENT PRODUCT) means that if #$Cyc,
or another #$Cyclist, creates a Bugzilla bug report in the product
PRODUCT, then in the absence of further information, COMPONENT should
be considered the default selection for the 'component' field of the
new bug report.")
(comment bugzillaUserWatchesUser "This predicate relates a Bugzilla user, the 'watcher', to
another Bugzilla user, the 'watched'. (#$bugzillaUserWatchesUser
WATCHER WATCHED) means that any Bugzilla updates which are sent to
WATCHED are also sent to WATCHER, unless WATCHED doesn't have
permission to see the update.")
(comment bugzillaBugDuplicatesBug "This predicate relates a Bugzilla bug report to another which is a 'duplicate' of the original. (#$bugzillaBugDuplicatesBug DUPLICATE BUG) means that DUPLICATE is a bug report which describes a bug that has been reported in BUG. Often, BUG was reported chronologically earlier than DUPLICATE, however this is not necessary.")
(comment bugzillaBugBlocksBug "This predicate relates a Bugzilla bug report to a Bugzilla
bug report which blocks it. (#$bugzillaBugBlocksBug BLOCKER BLOCKED)
means that in some sense, resolution of the BLOCKER bug is necessary
for resolution of BLOCKED.")
(comment CBLInitialFn "A binary function that returns a #$CBLInitial command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment CBLFinalFn "A binary function that returns a #$CBLFinal command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment formulaTemplateHasType "(#$formulaTemplateHasType TEMPLATE TEMPLATE-TYPE) means that TEMPLATE is one of the templates included in TEMPLATE-TYPE.")
(comment formulaTemplateTypeHasTopicType "(#$formulaTemplateTypeHasTopicType TEMPLATE-TYPE TEMPLATE-TOPIC-TYPE) means that TEMPLATE-TYPE is a subgrouping of TEMPLATE-TOPIC-TYPE.")
(comment irExpansionCandidate-Terse "An instance of #$IRExpansionPredicate.  (#$irExpansionCandidate-Terse THING EXPANSION-CANDIDATE) says that EXPANSION-CANDIDATE is an instance of #$CycLTerm that can be used to generate NL strings to be added to an IR search containing strings that denote THING.  For example, (#$irExpansionCandidate-Terse #$BillClinton #$UnitedStatesPresident) says that generation strings for #$UnitedStatesPresident (e.g., \"United States president\" can be added to an IR search string that contains a reference to Bill CLinton, such as \"President Clinton\" or (in the right context) \"he\".  Values for EXPANSION-CANDIDATE are calculated by looking for nearest #$isa/#$genls, most-notable #$isa/#$genls, and nearest #$qaClarifyingCollections for THING.  As such, #$irExpansionCandidate-Terse embodies a simple, context-free set of hueruistics to supply a relatively terse list of expansion candidate terms.  For more information, see the #$SharedNoteOnIRExpansionGeneration.")
(comment coreferentExpressions "(#$coreferentExpressions EXPR1 EXPR2) means that the #$LinguisticObjects EXPR1 and EXPR2 have been identified as coreferential.  In general, this entails that the referents (see #$referents) of these expressions are identical.")
(comment Groaning "An instance of #$HumanCapabilityType and a specialization of #$MakingAnOralSound.  Each instance of #$Groaning is an event in which an agent makes a low-pitched, inarticulate sound, usually to express #$Dislike for something.")
(comment SupersonicCombustionRamjetEngine "The collection of all #$RamjetEngines 
   that propel aircraft by igniting fuel with air
 taken in and compressed by the engine operating at speeds much greater than the speed of sound in a 
fashion that produces greater exhaust than
 intake velocity.")
(comment PackagedCerealMarketCategory "Market category for packaged cereals and other prepared breakfast foods (sort of) such as Toaster Tarts.  Cereals that require cooking, such as oatmeal, and prepared cereals sold in bulk (as granola sometimes is) are also covered by this market category.")
(comment CanisGenus "The genus which contains the species to which domestic dogs and wolves belong.")
(comment RelationalNCRuleFn-InstanceLevel "(#$RelationalNCRuleFn PRED NUM WORD) denotes a particular form of #$NounCompoundRule which can be derived on the basis of #$denotesArgInReln assertions for which PRED, a #$BinaryPredicate,  is the arg3, NUM is the arg4, and WORD is the arg1.  So, for example, (#$RelationalNCRuleFn #$owns 1 #$Own-TheWord) denotes a rule for interpreting compounds like \"car owner\". In general, the form of the #$ncRuleTemplate for the derived rule will be either (#$SubcollectionOfWithRelationToTypeFn COL PRED #$TheNCModifier) or (#$SubcollectionOfWithRelationFromTypeFn COL PRED TheNCModifier) depending on whether NUM has a value of 1 or 2 (respectively).  In either case, the value for COL will correspond to the NUMth argIsa constraint for PRED,   Furthermore, #$ncRuleConstraints for the derived rule will generally be inferred on the basis of the arg constraints of PRED and the #$denotesArgInReln assertion(s) which license the rule.")
(comment discourseReferentPegsDisagreeInType "  This predicate provides a means of indicating that two #$DiscourseReferentPegs disagree in terms of semantic type, and hence expressions that denote them cannot possibly be co-referential (c.f., #$coReferring).  In particular, (#$discourseReferentPegsDisagreeInType THING1 THING2) entails that THING1 and THING2 are instances of disjoint collections.")
(comment disagreeInMarking "(#$disagreeInMarking TERM1 TERM2) says that the two #$LinguisticExpressionPegs TERM1 and TERM2 disagree with respect to at least one of their marked grammatical features marked feature (e.g. number or gender).  See also #$agreeInMarking.")
(comment Movie-TemplateTopic "A collection of #$FormulaTemplates that have an instance of #$Movie-CW as the focal term.")
(comment ActorInMovies-TemplateTopic "A collection of #$FormulaTemplates that have an instance of #$ActorInMovies as the focal term.")
(comment PreparingToPlayRoleInTypeFn "(#$PreparingToPlayRoleInTypeFn ROLE SITUATION-TYPE) denotes the collection of instances of #$PreparingForSituation in which the performer (c.f. #$performedBy) is preparing to play the role ROLE in an instance of SITUATION-TYPE.  For example, (#$PreparingToPlayRoleInTypeFn #$birthParent #$BirthEvent) denotes the collection of events in which someone prepares to give birth.")
(comment typePreparesForRoleInType "The #$functionCorrespondingPredicate of #$PreparingToPlayRoleInSituationFn (#$typePreparesForRoleInSituation PREPARATION-TYPE ROLE SITUATION) identifies PREPARATION-TYPE as the collection of events in which an intelligent agent prepares to play the role ROLE in the situation SITUATION.  For example, (#$typePreparesForRoleInSituation <i>TrainingForTheBigRaceOnJanuary10</i> #$competingAgents <i>TheBigRaceOnJanuary10</i>) says that <i>TrainingForTheBigRaceOnJanuary10</i> is the collection of all events in which someone prepares to compete in the big race.  See also #$typePreparesForRoleInType.")
(comment typePreparesForRoleInType "The #$functionCorrespondingPredicate of #$PreparingToPlayRoleInTypeFn (#$typePreparesForRoleInType PREPARATION-TYPE ROLE TYPE) identifies PREPARATION-TYPE as the collection of events in which an intelligent agent prepares to play the role ROLE in a situation of type TYPE.  For example, (#$typePreparesForRoleInType <i>StudyingForTheSATs</i> #$performedBy <i>TakingTheSATs</i>) says that <i>StudyingForTheSATs</i> is the collection of events in which someone prepares to take the SATs.")
(comment Cyc101User "The collection of all Cyc 101 participants")
(comment typePreparesForRoleInSituation "The #$functionCorrespondingPredicate of #$PreparingToPlayRoleInTypeFn (#$typePreparesForRoleInType PREPARATION-TYPE ROLE TYPE) identifies PREPARATION-TYPE as the collection of events in which an intelligent agent prepares to play the role ROLE in a situation of type TYPE.  For example, (#$typePreparesForRoleInType <i>StudyingForTheSATs</i> #$performedBy <i>TakingTheSATs</i>) says that <i>StudyingForTheSATs</i> is the collection of events in which someone prepares to take the SATs.")
(comment PreparingToPlayRoleInSituationFn "(#$PreparingToPlayRoleInSituationFn ROLE SITUATION) denotes the collection of instances of #$PreparingForSituation in which the performer (c.f. #$performedBy) is preparing to play the role ROLE in the  situation SITUATION.  For example, (#$PreparingToPlayRoleInSituationFn #$competingAgents <i>2004SummerOlympics</i>) denotes the collection of events in which someone prepares to compete in the 2004 summer olympic games.  See also #$PreparingToPlayRoleInTypeFn.")
(comment MovieTopicReformulation "This reformulation specifies rules for handling the assertions generated by the FET on #$ActorInMovies-TemplateTopic and #$Movie-TemplateTopic.")
(comment useRFRuleForMovieTopics "(#$useRFRuleForMovieTopics RULE) tells a reformulation specification that it should use RULE to reformulate formulae during term replacement, so as to produce WFF results without bothering the user.")
(comment gamePlayed "A #$BinaryRolePredicate.  <code>(#$gamePlayed PLAYING GAME)</code> means that <code>GAME</code> is the #$Game that is being played in the instance of #$PlayingAGame <code>PLAYING</code>.")
(comment lastProperSubSituations "A #$BinaryRolePredicate that is a specialization of both #$properSubSituations and #$temporallyFinishedBy (qq.v.).  <code>(#$lastProperSubSituations SIT END)</code> means that <code>END</code> is a final part of <code>SIT</code>.  That is, <code>END</code> is a subsituation of <code>SIT</code> that starts after <code>SIT</code> starts and ends exactly when <code>SIT</code> ends.  Also,  <code>END</code> should be something that it would seem intuitively correct (in the  context in question) to describe as \"the last part\" of <code>SIT</code>.  Typically,  <code>END</code> doesn't start until at least halfway through (i.e. the temporal  mid-point of) the occurring of <code>SIT</code>.  Note that more than one situation might be considered a last part of a given situation.  See also #$firstProperSubSituations.")
(comment firstProperSubSituations "A #$BinaryRolePredicate that is a specialization of both #$properSubSituations and  #$temporallyStartedBy (qq.v.). <code>(#$firstProperSubSituations SIT START)</code> means that <code>START</code> is a beginning part of <code>SIT</code>.  That is, <code>START</code> is a proper subevent of <code>SIT</code> that starts exactly when <code>SIT</code> starts and ends before <code>SIT</code> ends.  Also, <code>START</code> should be something that it would seem intuitively correct (in the context in question) to describe as \"the first part\" of <code>SIT</code>.  Typically, <code>START</code> ends no later than halfway through (i.e. the temporal mid-point of) the occurring of <code>SIT</code>.  Note that more than one situation might be considered a first part of a given larger situatation.  See also #$lastProperSubSituations.")
(comment termPhrases-CaseInsensitive "(#$termPhrases-CaseInsensitive TERM CONSTRAINT STRING) means that STRING's sequence of characters, without regard to case, matches a word or phrase that denotes TERM and that meets CONSTRAINT (see #$termPhrases).  This predicate is #$notAssertible, since it depends on the current state of the KB.")
(comment SelectingATaskToWorkOn "A specialization of #$SelectingSomething and #$DecidingToDoSomething. Each instance of #$SelectingATaskToWorkOn is an event in which an intelligent agent decides that he or she will work on a particular task.  A positive example is any event in which a test-taker selects a particular test question to answer.")
(comment cycLExpressionOfPropositionHypothesized "A #$BinaryRolePredicate that relates events in which an intelligent
agent theorizes to CycL expressions of propositions that the agent
speculates about during those
events. (#$cycLExpressionOfPropositionHypothesized THEORIZING
SENTENCE) means that during THEORIZING (an instance of #$Theorizing)
an agent who performs THEORIZING considers the proposition expressed
by SENTENCE (an instance of #$ELSentence-Assertible) as an hypothesis
that might be true.")
(comment cycLExpressionOfPropositionVerified "A #$BinaryRolePredicate that relates events in which an intelligent agent verifies the truth of a proposition to CycL expressions of the propositions that the agent verifies. (#$cycLExpressionOfPropositionVerified VERIF SENTENCE) means that during VERIF (an instance of #$Verification) an agent who performs VERIF determines whether or not the proposition expressed by SENTENCE (an instance of #$ELSentence-Assertible) is true.")
(comment AssessingAnInformationSource "A specialization of #$Evaluating.  Each instance of #$AssessingAnInformationSource is an event in which an intelligent agent assesses the quality of a source of information.")
(comment SpaghettiWesternMovie "A specialization of #$WesternMovie.  Instances are westerns filmed in continental Europe from about 1960 to 1975, commonly referred to as \"spaghetti\" westerns because many were funded by Italian production companies.")
(comment NumericIntervalTypeFn "An instance of #$CollectionDenotingFunction.
(#$NumericIntervalTypeFn NUMBER-TYPE) denotes the collection of all
numeric intervals (cf., #$IntervalOnNumberLine) that are composed
solely of instances of NUMBER-TYPE.  For example,
(#$NumericIntervalTypeFn #$RationalNumber) denotes the collection of
intervals of rational numbers.")
(comment numberTypeIntervalType "(#$numberTypeIntervalType NUMBER-TYPE INTERVAL-TYPE) means
that INTERVAL-TYPE is the collection of all numeric intervals (cf.,
#$IntervalOnNumberLine) that are composed solely of instances of
NUMBER-TYPE.  See the corresponding function
#$NumericIntervalTypeFn.")
(comment IntervalOfTypeMinFn "An instance of #$ScalarDenotingFunction.
(#$IntervalOfTypeMinFn NUMBER-TYPE MIN) denotes the instance of
#$IntervalOnNumberLine whose elements are instances of NUMBER-TYPE 
#$greaterThanOrEqualTo MIN.  For example,
(#$IntervalOfTypeMinFn #$Integer 3) returns the sequence of all
integers #$greaterThanOrEqualTo 3.")
(comment unclearSentence "(#$unclearSentence SENTENCE) means that the generation of #$CycLPropositionalSentence SENTENCE (which is usually the subject of a #$suggestedSentence assertion) is not a clearly formed natural-language sentence. Clearly formed, in this case, means that the sentence would be readily understood by anyone with no special training, but with a fluent grasp of the language. For example, \"Cyndy Matuszek is viscidity.\" does not express an obvious concept in English, nor does the sentence \"Abduced term fn cyc problem store fn 4412 agent 279 considers Libya an enemy.\"")
(comment IntervalOfTypeMaxFn "An instance of #$ScalarDenotingFunction. (#$IntervalOfTypeMaxFn NUMBER-TYPE MAX) denotes the instance of #$IntervalOnNumberLine whose elements are instances of NUMBER-TYPE #$lessThanOrEqualTo MAX. For example, (NumberTypeIntervalMinFn Integer 3) returns the sequence of all integers #$lessThanOrEqualTo 3.")
(comment objectsRented "A #$BinaryRolePredicate.  <code>(#$objectsRented RENTING OBJ)</code> means that <code>OBJ</code> is one of the objects that is being rented in the instance of #$Renting <code>RENTING</code>.")
(comment SeriesOfTypeFn "A #$CollectionDenotingFunction from collections of temporal things to collections of series of instances of those collections.  (#$SeriesOfTypeFn COLL) is the collection of all #$Series (q.v.) such that each item in the series is an instance of COLL.  For example, (#$SeriesOfTypeFn #$GameEvent) is the collection of series of game-playing events, and the playing of the 2003 World Series is an instance of this collection.")
(comment TransferOfPoliticalControl "A specialization of #$TransferOfControl.  In each instance
of #$TransferOfPoliticalControl, political authority and/or effective control over
a #$GeographicalRegion passes from one
#$IntelligentAgent to another.  Such transfers fall into one of two
sub-classes: (i) those in which control over a region
shifts from one #$GeopoliticalEntity to another, and (ii) those in
which the control/leadership of a #$GeopoliticalEntity (which controls a region) 
changes hands.  The first sort of case includes both military conquests 
and cases in which a newly-created political unit assumes control of a region (see #$Separation-Geopolitical).  The second sort of
case includes changes to the individual leaders or governments of a #$GeopoliticalEntity, peaceful or otherwise.  Note
that the entity which #$takesControl of REGION need not gain total
sovereignty over it, e.g., territory can be transferred from one
#$State-Geopolitical to another.")
(comment GainingPoliticalIndependence "A specialization of #$TransferOfPoliticalControl.  In each instance
of #$GainingPoliticalIndependence, a group of people or
#$GeopoliticalEntity achieve a significant degree of political
autonomy.  Prominent specializations include:
(i) cases in which territory under the formal control of some
political entity is 'broken off' and put under the control of a new,
or newly-independent, #$GeopoliticalEntity (cf.
#$Separation-Geopolitical), and (ii) cases in which a state under the
effective control of another #$GeopoliticalEntity regains its
independence, e.g., an occupying or colonial power.")
(comment relationAllExistsAndOnly "An instance of #$RuleMacroPredicate. (#$relationAllExistsAndOnly PRED TYPE-1 TYPE-2) says that for every instance INSTANCE of TYPE-1 there exists a thing THING such that (PRED INSTANCE THING) where the fact that (PRED INSTANCE THING) guarantees that (#$isa THING TYPE-2).  So, for example,   (#$relationAllExistsAndOnly #$premeditatedMurderer #$PremeditatedMurder #$Person) says that only people carry out premediated murders, every instance of which must have at least one person who carries it out.")
(comment Separation-Geopolitical "A specialization of #$GainingPoliticalIndependence. Each
instance of #$Separation-Geopolitical involves a change in formal
political control over a #$GeographicalRegion.  The two kinds of such
changes which are subsumed by #$Separation-Geopolitical are: (i) a
subordinate political entity (see #$geopoliticalSubdivision) secedes
from a larger #$GeopoliticalEntity, and thereby assumes greater
control over its own territory, and (ii) a proper sub-region of
a #$GeopoliticalEntity is 'broken off' and made the
#$territoryOf a completely new political entity.")
(comment fileTypeRelativeBasePath "(fileTypeRelativeBasePath APP FILETYPE PATH) means that the default directory location for storing files of type FILETYPE managed by APP on COMPUTER can be determined by appending PATH to BASEPATH, where (#$applicationBasePath APP COMPUTER BASEPATH).")
(comment LibraryOfCongressCountryStudiesWebpageFn "An instance of #$IndividualDenotingFunction. (LibraryOfCongressCountryStudiesWebpageFn COUNTRY) takes an instance of #$Country and returns as its value the instance of #$LibraryOfCongressCountryStudiesWebpages that contain information on
that #$Country. (#$LibraryOfCongressCountryStudiesWebpageFn #$Germany)
denotes the webpages dedicated to #$Germany.")
(comment LibraryOfCongressCountryStudiesWebpage "A specialization of #$WorldWideWebPage-AIS. Each instance of
this collection are webpages maintained by the Library of Congress.
These pages contain extensive information on a selection of particular
countries, particularly the history, economy, political and social
systems. See also #$LibraryOfCongressCountryStudiesIndexPage and
#$LibraryOfCongressCountryStudiesWebpageFn.")
(comment LibraryOfCongressCountryStudiesIndexPage "An instance of #$WorldWideWebPage-AIS.  This page is the
index for the Country Studies.  See also
#$LibraryOfCongressCountryStudiesWebpage and #$LibraryOfCongressCountryStudiesWebpageFn.")
(comment InformationBearingPerformance "A specialization (in fact the most general common specialization) of both #$EntertainmentPerformance and #$InformationBearingThing. Each instance of this collection is a public or private performance with artistic or entertainment value (#$performedBy instances of #$Artist-Performer) that carries or conveys information. The information conveyed need not be in the form of <i>propositional</i> content (we are agnostic on whether non-propositional content exists). Salient examples are plays, musical performance lyrics, but specializations include the whole of #$MusicalPerformance, #$DancePerformance, conceptual art performance, mime, etc.")
(comment PotbelliedPig "A type of #$Pig originally bred in Vietnam, and a popular pet in Southeast Asia.")
(comment Pig-DomesticatedTypeByBreed "A collection of collections. Each instance is a spec of #$Pig-Domesticated whose instances are all of the same breed.")
(comment accessFilenameOfAIS "(#$accessFilenameOfAIS FILE NAME) means that the #$CharacterString NAME can be used to designate the #$ComputerFile-AIS FILE.  Note that there can be multiple names associated with the same file.  Note also that a single #$ComputerFile-AIS can have multiple corresponding instances of #$ComputerFileCopy stored in different areas of memory or on multiple computers or networks. The name referred to by this predicate is the #$accessFilename of those corresponding files.")
(comment fileSuffixOfAIS "(#$fileSuffixOfAIS FILE SUFFIX) means that the #$CharacterString SUFFIX is the suffix of FILE's filename (usually including an initial '.' character) that indicates the type of file in question.")
(comment regexStringMatch-CaseInsensitive "A spec pred of #$regexStringMatch that allows for case insensitive matching between a 'regular expression template' and a string of characters. See #$regexStringMatch.")
(comment someTypePlaysRoleInSubSituationType "<code>(#$someTypePlaysRoleInSubSituationType SIT-TYPE TYPE SUBSIT-TYPE ROLE)</code> means that for any instance of <code>SIT-TYPE</code>, there exists an instance of <code>TYPE</code> that plays the role <code>ROLE</code> in the sub-situation that instantiates <code>SUBSIT-TYPE</code>.")
(comment topicSetForTextString "(#$topicSetForTextString STRING SET) means SET denotes a set of #$CycLDenotationalTerms which are mentioned by the #$TextString STRING.")
(comment TopicsOfTextStringFn "(TopicsOfTextStringFn STRING) denotes a list of #$CycLDenotationalTerms which are referenced by the #$TextString STRING.")
(comment languageUsed "A #$BinaryPredicate.  <code>(#$languageUsed USING LANGUAGE)</code> means that <code>LANGUAGE</code> is the #$Language used in the instance of #$UsingALanguage <code>USING</code>.")
(comment UsingALanguage "An instance of #$TemporalStuffType and a specialization of #$IBTGeneration and #$AtLeastPartiallyMentalEvent.  Each instance of #$UsingALanguage is an event in which some #$Agent-Generic produces (tokens of) expressions in a #$Language.  Notable specializations include #$Writing and #$Talking.")
(comment relationExistsAndOnlyAll "An instance of #$RuleMacroPredicate. (#$relationExistsAndOnlyAll PRED TYPE-1 TYPE-2) says that for every instance INSTANCE of TYPE-2 there exists a thing THING such that (PRED THING INSTANCE) where the fact that (PRED THING INSTANCE) guarantees that (#$isa THING TYPE-1).  So, for example,  (#$relationExistsAndOnlyAll #$madeBy #$Artifact #$ManufacturingOrganization) says that every instance of #$ManufacturingOrganization makes some artifact (in the sense of \"makes\" captured in the definition of #$madeBy), and the only things made (in that sense) by such organizations are artifacts.")
(comment agentHasMotiveForAction "A #$TemporallyQualifiableRelation  used to relate actions to agents who have motives to see that the actions occurred. <code>(#$agentHasMotiveForAction AGENT ACT)</code> means that the #$IntelligentAgent <code>AGENT</code> has a motive to see that #$Action <code>ACT</code> occurrs.")
(comment RafaelTrujillo "General #$RafaelTrujillo was the #$dictator of the #$DominicanRepublic from 1930 until 1961.  He was assassinated in #$TerroristAttack-May-30-1961-Dominican-Republic.")
(comment Dictator-HeadOfGovernment "An instance of #$PersonTypeByPositionInOrg.  Each instance of #$Dictator-HeadOfGovernment is a #$HeadOfGovernment who rules over a country with absolute (or near-absolute) authority.  See the predicate #$dictator.")
(comment MormonPerson "An instance of #$PersonTypeByReligion and a specialization of #$ChristianPerson.  Each instance of #$MormonPerson is someone who adheres to #$Mormonism (q.v.).")
(comment Agronomist "#$Agronomist is the collection of scientists who specialize in #$Agronomy.")
(comment UniversityPresident "An instance of #$PersonTypeByOccupation.  Each instance of #$UniversityPresident is the president of some #$University.")
(comment SoftwareTestSpecificationType "Each instance of #$SoftwareTestSpecificationType is a collection
whose instances are individual software test definitions. Instances of
#$SoftwareTestSpecificationType represent categories of tests grouped
together because they test similar functionality, and which might sensibly
be run as a unit.")
(comment SymbolicMonarchy "An instance of #$GeopoliticalEntityBySystemOfGovernment.  Each instance of #$SymbolicMonarchy is a country in which the monarch is almost entirely or entirely a <i>de facto</i> nominal authority.")
(comment instancesOfDisjointCollections "(#$instancesOfDisjointCollections INS1 INS2) means that there exist disjoint collections COL1 and COL2 such that INS1 is an instance of COL1 and INS2 is an instance of COL2.")
(comment MovingAComputerFile-Metaphorically "A specialization of #$FileOperation and #$GeneralizedTransfer. In each instance of #$MovingAComputerFile-Metaphorically, a computer changes or indexes a file in such a way that it appears in a user interface to have moved to a different location.  For events in which a file <i>really is</i> moved (or rather deleted and copied) to a new physical location in a computer's memory, see #$MovingAComputerFile-CopyingAndDeleting.")
(comment Parliament-UK "The parliament of the UK, whose sub-organizations include the #$HouseOfCommons and the #$HouseOfLords.")
(comment HouseOfLords "A branch of the British parliament.")
(comment HouseOfCommons "A branch of the British parliament.")
(comment CortesGenerales-Spain "The parliament of #$Spain, whose sub-organizations include the #$CongressOfDeputies-Spain and the #$Senate-Spain.")
(comment Parliament-Canada "The parliament of #$Canada, whose sub-organizations include the #$HouseOfCommons-Canada and the #$Senate-Canada.")
(comment HouseOfCommons-Canada "A branch of the Canadian parliament.")
(comment Senate-Canada "A branch of the Canadian parliament.")
(disjointWith ClassicalMusicalCompositionTypeByMusicalForm EfficaciousSubstanceTypeByComposition)
(disjointWith IBTFormatType EfficaciousSubstanceTypeByComposition)
(comment EfficaciousSubstanceTypeByComposition "An instance of #$SecondOrderCollection.  Instances are specializations of #$PartiallyTangible whose instances share a unique physical composition (such as a chemical formula or a genome), and are widely recognized as having the ability to affect observable change on the physical world, particularly in organisms or on other substances.  Though this collection is not a specialization of #$ExistingStuffType, instances are nevertheless \"substances\" in the sense that, in the everyday experience of humans, instances of these collections will typically be observed as \"clumped together\" in stuff-like samples (see #$MobFn and #$ChemicalSubstanceFn for functions that take an instance of #$ExistingObjectType and return the collection of stuff-like samples of that type).  
Examples include paint thinner, anthrax, and the active ingredient-types in many types of medicines (see #$PharmaceuticalType).  Negative examples include chemicals typically considered inert, such as water, and drug \"cocktails\" the efficacy of which is merely a reflection of the efficacious substance-types they contain.")
(disjointWith VisualPatternType EfficaciousSubstanceTypeByComposition)
(disjointWith EfficaciousSubstanceTypeByComposition TerrainTypeBySurfaceLevel)
(disjointWith EfficaciousSubstanceTypeByComposition OneAtATimeProcessType)
(comment Dog-MixedBreed "An instance of #$OrganismClassificationType.  Each instance of #$Dog-MixedBreed is a #$Dog of mixed breed.  #$Dog-MixedBreed is disjoint with every instance of #$DogTypeByBreed-Pure.")
(comment DomesticCat-MixedBreed "An instance of #$OrganismClassificationType.  Each instance of #$DomesticCat-MixedBreed is a #$DomesticCat of mixed breed.  #$DomesticCat-MixedBreed is disjoint with every instance of #$CatTypeByBreed.")
(comment EvaluationOfByOnFn "(#$EvaluationOfByOnFn THING AGENT SECOND) denotes the instance of #$Evaluating in which THING is evaluated by the #$IntelligentAgent AGENT, as submitted at the time denoted by INT (where INT is a #$PositiveInteger corresponding to the number of seconds elapsed since January 1, 1970).")
(comment evaluationOfByOn "The #$functionCorrespondingPredicate for #$EvaluationOfByOnFn.  (#$evaluationOfByOn EVALUATION THING AGENT INT) identifies EVALUATION as the unique instance of #$Evaluating in which AGENT evaluates THING at the time denoted by INT (which is the number of seconds elapsed since January 1, 1970).")
(comment Vote-CollectiveDecision "An instance of #$TemporalObjectType and a specialization of #$Deciding-Collectively.  Each instance of #$Vote-CollectiveDecision is an event in which many members of some #$Organization (e.g. a #$Country) cast their votes to decide something--e.g., who should be the next president of the organization or whether a certain policy should be enacted.  Each instance of #$Vote-CollectiveDecision has many instances of #$Voting as proper subevents.  Two important specializations of #$Vote-CollectiveDecision are #$Election and #$BallotInitiative.")
(comment SlideshowPresentation "A specialization of #$Presentation each of whose instances is a performance of a #$Slideshow-CW (q.v.).  A #$SlideshowPresentation is typically done using either a slide projector or with a computer running a slideshow application such as #$MSPowerPoint), possibly accompanied by \"live\" oral commentary from the presenter.  A specialization of #$SlideshowPresentation is #$PowerPointPresentation.")
(comment PowerPointPresentation "A specialization of #$SlideshowPresentation each instance of which is a performance of a #$Slideshow-CW done on a computer running the application #$MSPowerPoint, and possibly accompanied by \"live\" oral commentary from the presenter.")
(comment requiredArg3Pred "A #$MetaPredicate for stating that every instance of a given collection is related (as the \"arg3\") to some things by a given predicate.  <code>(#$requiredArg3Pred COL PRED)</code>  means that for every instance <code>INST</code> of <code>COL</code>, there exists some sequence  <<code>X1</code>, <code>X2</code>,..., <code>Xn</code>> such that <code>(PRED X1 X2 INST</code> ... <code>Xn)</code> holds.  For  example, (#$requiredArg3Pred #$ConflictEvent #$opponentsInConflict) means that every conflict involves (at least) two opponents.  See also #$requiredArg1Pred and #$requiredArg2Pred.")
(comment glfComponentSemanticsWRTContext "An instance of #$TernaryPredicate.  #$glfComponentSemanticsWRTGraph is used to relate an instance of #$GLFGraphComponent to the object it denotes in the context of some instance THING of #$Thing with a graphical structure.  In particular, there is a graphical depiction of THING in which the relevant instance of #$GLFGraphComponent represents the relevant object.  For example, (#$glfComponentSemanticsWRTGraph GLFNODE002  (#$CycQueryRunningFromFn VegetationConcealsDefenderFromLOSFlanksQuerySpec) VegetationAnalysis) says that there is a graphical depiction of the collection of all vegetation analysis events in which GLFNODE002 represents the running of the query, VegetationConcealsDefenderFromLOSFlanksQuerySpec).")
(comment ChangeOfGovernment "A specialization of #$PoliticalEvent (qq.v.). Each instance of #$ChangeOfGovernment is an event in which an intelligent agent (or a group of intelligent agents) brings about a fundamental change in the government of the population of a region.  Important specializations include #$Revolution-Political and #$ChangeOfGovernment-ExternallyDriven (qq.v.).  A negative example is a peaceful turnover of power that arises as the consequence of an election, when the election mechanism used is part of an existing government structure.")
(comment ChangeOfGovernment-ExternallyDriven "A specialization of #$ChangeOfGovernment.  Each instance of #$ChangeOfGovernment-ExternallyDriven is a political event in which outside forces act to bring about a fundamental change in the government of the population of a region.  Contrast this collection with #$Revolution-Political, which is the collection of regime changes brought about largely by the population who had lived under the old regime.")
(disjointWith Revolution-Political ChangeOfGovernment-ExternallyDriven)
(comment ApproximateIntervalOfTypeFn "An instance of #$ScalarDenotingFunction. (#$ApproximateIntervalOfTypeFn INTERVAL-TYPE NUMBER-TYPE INT)
denotes the instance of INTERVAL-TYPE that is the range that consists of the instances of NUMBER-TYPE that are approximately INT.  For the purposes of TKB we define this to a ratio of plus or minus 10 percent of INT (rounded down).  For example, (#$ApproximateIntervalOfTypeFn #$NonNegativeIntegerRange #$Integer 100) is the range of integers from 90 to 110 to while (#$ApproximateIntervalOfTypeFn #$NonNegativeIntegerRange #$Integer 3) simply reduces to 3.")
(comment IntelligentAgentTypeByBeliefSystem "A collection of collections and a specialization of #$ConventionalClassificationType.  Each instance of #$IntelligentAgentTypeByBeliefSystem is a collection of agents, the instances of each of which share a common belief system (see #$BeliefSystem).  More formally, for each instance AGENT-TYPE of #$IntelligentAgentTypeByBeliefSystem, there is an instance BELIEFS of #$BeliefSystem such that (#$relationAllInstance #$hasBeliefSystems AGENT-TYPE BELIEFS) holds true.")
(comment refinedByTemplateTopic "(#$refinedByTemplateTopic THING TOPIC) means that the #$FormulaTemplateTopicType TOPC can be used to gather information about some #$Thing THING.  In general, this means that thing satisfies the focal term constraints (see also #$templateTypeForFocalTermType and #$templateTopicGenls) for TOPIC.")
(comment approximateIntervalOfType "(#$approximateIntervalOfType INTERVAL-TYPE NUMBER-TYPE NUMBER RANGE) holds just in case RANGE is the instance of INTERVAL-TYPE that consists of all the instances of NUMBER-TYPE that are \"approximately\" NUMBER.  For TKB, we define \"approximately\" as plus or minus 10 percent of NUMBER (rounded down).  This is the corresponding predicate to #$ApproximateIntervalOfTypeFn.")
(disjointWith UnaryRelation AtLeastPartiallyCommutativeRelation)
(disjointWith CyclicCommutativeRelation AtLeastPartiallyCommutativeRelation)
(comment AtLeastPartiallyCommutativeRelation "A collection of #$Relations and an instance of #$RelationTypeByLogicalFeature (q.v.).  Each instance of #$AtLeastPartiallyCommutativeRelation <code>RELN</code> is a predicate or function that is commutative in at least two of its argument-places (see #$commutativeInArgs).  If <i>all</i> of <code>RELN</code>'s argument-places are mutually commutative, then it's an instance of the specialization #$CommutativeRelation (q.v.); otherwise it's an instance of the specialization #$PartiallyCommutativeRelation (q.v.).")
(comment AlmostIntervalOfTypeFn "An instance of #$ScalarDenotingFunction. (#$AlmostIntervalOfTypeFn INTERVAL-TYPE NUMBER-TYPE INT)
denotes the instance of INTERVAL-TYPE that is the range that consists of the instances of NUMBER-TYPE that are almost INT.  For the purposes of TKB we define \"almost\" as being less than INT and within 10 percent of INT (rounded down).  For example, (#$AlmostIntervalOfTypeFn #$NonNegativeIntegerRange #$Integer 100) is the range of integers from 90 to 99 while (#$AlmostIntervalOfTypeFn #$NonNegativeIntegerRange #$Integer 3) simply reduces to 3.")
(comment almostIntervalOfType "(#$almostIntervalOfType INTERVAL-TYPE NUMBER-TYPE NUMBER RANGE) holds just in case RANGE is the instance of INTERVAL-TYPE that consists of all the instances of NUMBER-TYPE that are \"almost\" NUMBER.  For TKB, we define \"almost\" NUM as being less than NUM and within 10 percent of NUM (rounded down).  This is the corresponding predicate to #$AlmostIntervalOfTypeFn.")
(comment hasMotto "(#$hasMotto AGENT STRING) means that AGENT associates itself with phrase STRING that expresses a principle, goal, or ideal that AGENT admires.")
(comment threatenedAgent "An instance of #$AgentiveRole and a specialization of #$warnee.  <code>(#$threatenedAgent THREATENING AGT)</code> means that the #$IntelligentAgent <code>AGT</code> was threatened in the #$MakingAThreat <code>THREATENING</code>.")
(comment threateningAgent "An instance of #$AgentiveRole and a specialization of #$warner.  <code>(#$threateningAgent THREATENING AGT)</code> means that the #$IntelligentAgent <code>AGT</code> was the agent making the threat in the #$MakingAThreat <code>THREATENING</code>.")
(comment keUselessPrecisionValueForSlotOnTerm "An instance of <code>#$KEFacilitationPredicate</code> expressing the fact that the interval assigned as the value of a property for a given object is too indeterminate to be pragmatically relevant, in the sense of <code>#$keRelevantPrecisionValueForSlotOnType</code>.
<p>
Specifically, <code>(#$keUselessPrecisionValueForSlotOnTerm BINPRED TERM INTERVAL)</code> is true iff (i) TERM is an instance of TYPE, and (ii) <code>(#$keRelevantPrecisionValueForSlotOnType BINPRED TYPE SIZE)</code>, and (iii) <code>(#$greaterThan INTERVAL-SIZE SIZE)</code>, where <code>(#$intervalSize INTERVAL INTERVAL-SIZE)</code>.")
(comment StartingIntervalFn "An instance of #$IndividualDenotingFunction.  When applied to an instance THING of #$TemporalThing, #$StartingIntervalFn  returns the (fuzzy) interval at which THING began.  The interval returned starts at the #$startingPoint of THING and ends sometime before the end of (#$EarlyPartFn THING).")
(comment startingIntervalOfThing "(#$startingIntervalOfThing TEMP-THING TIME-INTERVAL) holds just in case TIME-INTERVAL is the interval that starts at the start of TEMP-THING (see #$startingPoint) and ends sometime before the end of the early part of TEMP-THING (see #$EarlyPartFn).  The actual interval returned by the function that corresponds to this predicate depends on the context of the assertion the term appears in.  In certain contexts, \"the start of 1997\" might include all of January 1997.  In other contexts, it might refer to the first two weeks of January 1997.")
(comment Planning "An instance of #$TemporalStuffType and a specialization of #$PurposefulAction and #$AtLeastPartiallyMentalEvent.  Each instance of #$Planning is an event in which an #$IntelligentAgent (or #$Group thereof) thinks about how it will influence a future course of events.  #$Planning is not the same as #$MakingAPlan, since one can plan without actually producing a #$Plan.  Rather, #$MakingAPlan is a specialization of #$Planning.")
(comment EndingIntervalFn "#$EndingIntervalFn is a unary function that takes an instance of #$TemporalThing as an argument and returns an instance of  #$TimeInterval.  (#$EndingIntervalFn TT) denotes the (fuzzy) interval in which TT ends.  This interval is bounded at the end by the #$endingPoint of TT.")
(comment endingIntervalOfThing "(#$endingIntervalOfThing TEMP-THING TIME-INTERVAL) holds just in case TIME-INTERVAL is the interval that ends at the end of TEMP-THING (see #$endingPoint) and starts sometime after the start of the late part of TEMP-THING (see #$LatePartFn).  The actual interval returned by the function that corresponds to this predicate depends on the context of the assertion the term appears in.  In certain contexts, \"the end of 1997\" might include all of December 1997.  In other contexts, it might refer to the last two weeks of December 1997.")
(comment ScalarNullValue "A specialization of #$ScalarPointValue.  Each instance of #$ScalarNullValue is a scalar-point-value whose \"numeric component\" is 0.  Thus 0 (i.e. #$Zero) is itself a #$ScalarNullValue; so is the result of applying any #$UnitOfMeasure function to 0.
<p>
Note that the result of applying #$NoAmountFn (q.v.) to a totally-ordered quantity-type <code>QUANTTYPE</code> is <i>not</i> itself a scalar-null-value, but is rather a #$ScalarProperInterval (q.v.) that subsumes (see #$quantitySubsumes) the scalar-null-value (if there is one) of <code>QUANTTYPE</code>.")
(comment agentCoerced "An #$ActorSlot and a specialization of #$objectControlled.  <code>(#$agentCoerced COERCING AGT)</code> means that <code>AGT</code> is one of the #$IntelligentAgents coerced in the instance of #$CoercingAnAgent <code>COERCING</code>.")
(comment InformationRetrievalPredicate "#$InformationRetrievalPredicate is an instance of #$PredicateType.  It is the collection of predicates that inter-relate things involved in information retrieval searches.")
(comment urlListReturned "An #$InformationRetrievalPredicate that is used to relate an interent search using a search engine to the list of URLs that the search engine returns.  (#$urlListReturned SEARCH LIST) means that the #$SearchEngine used (see #$searchEngineUsed) in SEARCH returns, for the query specification passed to it in SEARCH (see #$searchCriteriaSpecification) the list of URLs in LIST.  The URLs ranked more highly in LIST are the URLs that the search engine deemed more relevant than the rest.")
(comment TerroristCoordinatedMultipleBombAttackOnCivilians "A specialization of #$TerroristAttack and #$Bombing.  Each instance of #$TerroristCoordinatedMultipleBombAttackOnCivilians is an attack in which more than one explosive is detonated in a coordinated fashion, resulting in the deaths of civilians.  A positive example is #$TerroristAttack-11-mar-2004-Madrid-Spain.")
(comment Slideshow-CW "A specialization of #$VisualWork.  Each instance of #$Slideshow-CW is a visual work consisting of a number of #$Slide-CWs (q.v.) that are intended to be presented (see #$SlideshowPresentation) in a particular order.  A slideshow work might be created using a software application such as #$MSPowerPoint, created via the assemblage of a series of #$Slide-Photographs or  hand-drawn slides, or created in some other manual or semi-automatic way.")
(comment Slide-CW "A specialization of #$VisualWork.  Each instance of #$Slide-CW is a visual conceptual work, a performance of which involves the projection of a still image upon a screen or blank wall or other appropriate surface.  A slide-as-work is, essentially, part (see #$subWorks) of a #$Slideshow-CW (q.v.) (although a slideshow could consist of a single slide).
<p>
A slide-as-work can be created in various ways: with photographic equipment, with a software application such as #$MSPowerPoint, by marking a transparency with a grease pencil, and so on.
<p>
Note that a given #$Slide-Photograph (q.v.) might or might not be an instantiation (see #$instantiationOfWork) of some #$Slide-CW, depending on whether or not it is used in the performance of a slideshow work.")
(comment MSPowerPointFile "A specialization of both #$ComputerFile-AIS and #$CWInfoStructure (qq.v.).  This is the collection of computer files that have been created using #$MSPowerPoint and correspond to (see #$correspondingAIS) some #$Slideshow-CW (q.v.).")
(comment geographicallySubsumes "(#$geographicallySubsumes GEO-THING-1 GEO-THING-2) holds just in case either of the following hold:
<p>
(1) GEO-THING-1 has as a #$geographicalSubRegions either GEO-THING-2 or the
territory (c.f #$territoryOf) of GEO-THING-2.
<p>
(2) GEO-THING-1 has as a #$geopoliticalSubdivision GEO-THING-2 or the territory of GEO-THING-1 has as a #$geographicalSubRegions GEO-THING-2.
<p>
An example of this relation holding from case (1) would be (#$geographicallySubsumes #$NorthernHemisphere-Region #$Israel).  An example of this relation holding from case (2) would be (#$geographicallySubsumes #$UnitedStatesOfAmerica #$MississippiRiver).
<p>")
(comment RecordedIBO "An instance of #$ArtifactTypeByGenericCategory.  Each instance of #$RecordedIBO is an #$InformationBearingObject that was produced as the result of some #$InformationRecordingProcess (q.v.).  Specializations include #$AudioRecordedObject and #$VideoRecordedObject.")
(comment FlippingSomeoneOff "An instance of #$TemporalObjectType and a specialization of #$MakingAnObsceneGesture.  Each instance of #$FlippingSomeoneOff is an event in which a #$SocialBeing raises its #$MiddleFinger at some other #$SocialBeing to express #$Contempt for that being.")
(disjointWith WereNumberOneing FlippingSomeoneOff)
(comment Experimenting-Empirical "A specialization of #$Experimenting.  Each instance of #$Experimenting-Empirical is an event in which an agent performs one or more empirical tests to determine whether an hypothesis is true.")
(comment nearestGenlsOfType "<code>(#$nearestGenlsOfType COL TYPE-COL NEAR-COL)</code> means that <code>NEAR-COL</code> is a \"nearest\" generalization of <code>COL</code> which is of type <code>TYPE-COL</code>.  More precisely: (i) <code>(#$genls COL NEAR-COL)</code> holds, (ii) <code>COL</code> is not identical to <code>NEAR-COL</code>, (iii) <code>(#$isa NEAR-COL TYPE-COL)</code>, and (iv) there is no reified #$Collection <code>NEARER-COL</code> distinct from <code>COL</code> and <code>NEAR-COL</code> such that <code>(#$genls COL NEARER-COL)</code>, <code>(#$genls NEARER-COL NEAR-COL)</code>, and <code>(#$isa NEARER-COL TYPE-COL)</code> hold.
<p>
Note that #$nearestGenlsOfType is non-assertible (see #$notAssertible), since its extension at any given time depends upon (and so must be recomputed from) the current state of the Cyc Knowledge Base.")
(comment genlPredsWRTType-Unary "A #$TaxonomicPredicateForPredicates used to state that, with respect to arguments of a specified type, one unary predicate generalizes to another.  <code>(#$genlPredsWRTType-Unary PRED1 PRED2 COL)</code> means that, for any <code>THING</code>, if both of these hold:
<pre>
  (PRED1 THING)
</pre>
<pre>
  (#$isa THING COL)
</pre>
<p>
then so does
<pre>
  (PRED2 THING).
</pre>
For example, <code>(#$genlPredsWRTType-Unary #$trueSentence #$trueSentence-CaseInsensitive #$CycLAtomicSentence)</code> holds.
<p>
#$genlPredsWRTType-Unary allows us to specify a #$genlPreds -like relationship between two #$UnaryPredicates not related by #$genlPreds itself (and thus whose respective #$arg1Isa constraints might not be related by #$genls).
<p>
See also #$genlPredsWRTTypes (which applies to #$BinaryPredicates) and #$genlPredsWRTTypes-Ternary.")
(comment nearestIsaOfType "(#$nearestIsaOfType OBJ TYPE COL) means that COL is a \"nearest\" collection of which OBJ is an instance and which is of type TYPE.  That is, (#$isa OBJ COL) holds, (#$isa COL TYPE) holds, and there is no reified #$Collection NEARER-COL distinct from COL such that (#$isa OBJ NEARER-COL), (#$isa NEARER-COL TYPE), and (#$genls NEARER-COL COL) hold.  Note that #$nearestIsaOfType is non-assertible (see #$notAssertible), since its extension at any given time depends upon (and so must be recomputed from) the current state of the Cyc Knowledge Base.")
(comment ViolatingAnObligation "A #$FirstOrderCollection.  Each instance of #$ViolatingAnObligation is an #$Action in which some #$Obligation (moral, legal, etc.) is violated.  Two important specializations are #$ImmoralAct and #$IllegalAction.")
(comment Liberalism-Classical "An instance of #$PoliticalBeliefSystem.  Agents with this ideology emphasize individual liberty and the importance of limiting a government's power over its citizens.  Famous classical liberals include #$JohnLocke, #$AdamSmith, and #$ThomasJefferson.  #$Liberalism-Classical should not be confused with #$Liberalism-SocialDemocratic (q.v.).")
(comment queryExtentCached "(#$queryExtentCached QUERY) is a performative predicate that evaluates QUERY and caches the results in the mt in which it is asserted.")
(comment constantRenamed "A binary role predicate that related instances of #$RenamingAConstant to the GUID string associated with the constant renamed. (#$constantRenamed RENAME GUID) means that the constant associated with the #$GUIDString GUID is renamed in the course of RENAME.")
(comment reconsiderAssertionDeductions "(#$reconsiderAssertionDeductions ASSERTION) tells the system to perform TMS on ASSERTION.  Note that #$reconsiderAssertionDeductions is an instance of #$ELRelation-OneWay that expands to a #$performSubL sentence.")
(comment repropagateAssertion "(#$repropagateAssertion ASSERTION) tells the system to repropogate the #$CycLAssertion ASSERTION.  Note that #$repropagateAssertion is an instance of #$ELRelation-OneWay, and so (#$repropagateAssertion ASSERTION) expands to (#$performSubL
    (#$ExpandSubLFn (ASSERTION)
      (pwhen (forward-assertion? ASSERTION)
        (repropagate-forward-assertion ASSERTION))).")
(comment thingsObserved "An instance of #$BinaryRolePredicate.  <code>(#$thingsObserved OBSERVING THING)</code> means that <code>THING</code> is a #$TemporallyExistingThing observed in the instance of #$Observing <code>OBSERVING</code>.  For cases in which <code>THING</code> is an instance of #$PartiallyTangible, use the more specific #$objectsObserved.")
(comment ExposingSomething "A specialization of #$Action.  Each instance of #$ExposingSomething is an event in which something causes something to be exposed to something.  (The notion of X's being exposed to Y is difficult to define precisely, but very roughly it means that Y has access to, or can reach, X.)  Some examples of #$ExposingSomething: taking off one's hat, stepping out into the sun, turning a page of a book, opening a jar of peanut butter.  An instance of #$ExposingSomething need not be a #$PurposefulAction; consider, e.g. accidentally knocking one's hat off, or a gust of wind blowing one's hat off.  For the relatively static exposure event which follows an instance of #$ExposingSomething, see #$ExposureEvent.")
(comment CycTaskSchedulerPredicate "The collection of CycL predicates that are required in order to schedule tasks to be performed by the #$CycTaskScheduler, through  the #$CycKB. Even when these constants are missing in the KB used by  a given #$Cyc image, programmers can still schedule tasks in their code using certain public SubL functions provided by the #$CycTaskScheduler interface.")
(comment Singing-SingleDoerAction "An instance of #$TemporalStuffType and a specialization of #$MakingMusicalSound.  This is a generalization of #$Singing-Human which includes singing performed by other types of beings, e.g. #$Birds.")
(comment CycTaskSchedulerTaskDescriptionPredicate "The collection of CycL predicates that are used in order to specify certain properties of #$CycTaskSchedulerTasks that ultimately determine the execution times of tasks and  
what gets evaluated as part of task execution.")
(comment resultNamedByArg "(resultNamedByArg FN N NAME-STRING-PRED) means that any non-atomic term whose functor is FN is named by its Nth argument. Specifically, NAME-STRING-PRED holds of such a term and its Nth argument.")
(comment PositiveIntegerParameterValueFn "(#$PositiveIntegerParameterValueFn PARAM) denotes the real world positive integer that PARAM has as a value in the context of the current state of the contextually determined #$ComputerProcessRunning.")
(comment SubLStringParameterValueFn "(#$SubLStringParameterValueFn PARAM) denotes the real world SubL string that PARAM has as a value in the context of the current state of the contextually determined #$ComputerProcessRunning.")
(comment since-Decontextualized "(#$since-Decontextualized INTERVAL PROP PARAMETER) says that the proposition PROP has been, at at temporal granularity of PARAMATER, continuously true since INTERVAL.")
(comment sinceEarliestInterval "(#$sinceEarliestInterval INTERVAL SENTENCE PARAMETER) identifies INTERVAL as the starting interval for the period, ending with the current date (see #$currentDate), throughout which SENTENCE is true, at a granularity specified by PARAMETER.  For example, (#$sinceEarliestInterval (#$DayFn 11 (#$MonthFn #$February (#$YearFn 2003))) (#$outOfOffice #$Lehmann) #$CalendarDay) says that it has been true since February 11, 2003, that Fritz has been out of the office.  To say that Fritz has been out of the office since last Friday, use #$since-NthDate.  To say that he has been out since yesterday, use #$since-Metric.")
(comment accusedOfPerformingActionType "A #$BinaryPredicate that relates an instance of #$Accusing to a specialization of #$Action.  <code>(#$accusedOfPerformingActionType ACCUSING ACTION-TYPE)</code> means that the agent playing the role of #$accused in <code>ACCUSING</code> is accused of performing an instance of <code>ACTION-TYPE</code>.  For instance, (#$accusedOfPerformingActionType #$ChargingOfAymanAl-Zawahiri #$AssassinatingSomeone).  See also #$accusedOf and #$accusedOfRoleInType.")
(comment ProjectReport-CW "A specialization of #$ReportOnSituation-CW each instance of which is a report on a certain #$Project, produced as part of the project itself (see #$reportOnProject).  Typically, such a report will be produced by one or more of the #$projectParticipants.
<p>
Note that merely being a report <i>about</i> a certain project is not sufficient for being a project report in the present sense.  If the report is produced by an \"outsider\" with respect to the project (e.g. a journalist or a private investigator), it does not constitute a #$ProjectReport-CW.
<p>
<p>
<p>
<p>
<p>
issued by a government agency or body, either for consumption by another government body, or to the public, or both.")
(comment reportOnProject "A binary #$IntangibleObjectPredicate and a specialization of #$topicOfPCW (q.v.) that relates a #$ProjectReport-CW (q.v.) to its #$Project.  <code>(#$reportOnProject REPORT PROJECT)</code> means that <code>REPORT</code> is a project report for <code>PROJECT</code>.
<p>
Note that, typically, <code>REPORT</code> will be produced by one or more of the agents directly involved in <code>PROJECT</code> (see #$projectParticipants).  A report on a project that has been written by an outsider (e.g. a journalist) does not count as a #$ProjectReport-CW, and so is not related by #$reportOnProject to the project in question.")
(comment QuantitySizeFn "An instance of both #$UnaryFunction and #$EvaluatableFunction.  When applied to an instance QUANT of #$ScalarInterval, #$QuantitySizeFn returns the size of the interval, which is the difference between its maximum and minimum values.  For example, (#$QuantitySizeFn (#$Meter 3 7)) returns (#$Meter 4). See also #$MaxQuantValueFn and #$MinQuantValueFn.")
(disjointWith TextuallySpecificWork WorkingDraft)
(comment WorkingDraft "A specialization of #$TextualPCW.  Each instance of #$WorkingDraft is a conceptual work that is a less-than-final version of some (at least prospective) published work (see #$draftOfTextualWork and #$PublishedConceptualWork).
<p>
Working drafts typically undergo numerous changes, or revisions, before a finished work is produced and published.  Thus the boundary between a working draft and the finished product is quite fuzzy.  In some cases it is difficult or impossible to say, even in hindsight, whether a work that existed at some earlier time constitutes (or constituted) a different work than a particular finished work we know today, or was instead simply that latter work itself at a less-than-ultimate stage in its evolution.  To call something CW a #$WorkingDraft at a given time T implies that either (i) there exists at T a distinct, more recently-created published work that CW is/was clearly an earlier draft of or (ii) CW is a still-in-progress work at T that is viewed by its author(s) as a draft of some prospective future published work.")
(comment NominalExpressionPeg "The collection of all instances of #$LinguisticExpressionPeg that are used to represent NBars and NPs that occur in a discourse.")
(comment SententialExpressionPeg "A collection of \"pegs\" used to keep track of the sentences that have been uttered in a discourse.")
(comment LinguisticExpressionPeg-CompleteUtterance "The collection of all instances of #$LinguisticExpressionPeg that correspond to individual utterances (as opposed to pegs that are introduced as part of an utterance) in a dialogue.")
(comment subExpressions "A predicate used to relate an instance of #$LinguisticExpressionPeg to instances of #$LinguisticExpressionPeg that are introduced in the dialogue model as part of its linguistic decomposition.  For example, (#$subExpressions Peg001-HowMuchShouldIFeedMyDog? Peg002-MyDog) says that the linguistic peg for a particular utterance of \"how much should I feed my dog?\" contains a linguistic peg for \"my dog.\"")
(comment properSubExpressions "A specialization of #$subExpressions used in cases where the arg1 and arg2 are different.  (#$properSubExpressions Peg001-HowMuchShouldIFeedMyDog? Peg002-MyDog) says that the linguistic peg for a particular utterance of \"how much should I feed my dog?\" contains a distinct linguistic peg for \"my dog.\"")
(comment pegInterpretations "(#$pegInterpretations UTTERANCE-PEG INTERPRETATION) says that INTERPRETATION is an interpretation of the #$LinguisticExpressionPeg UTTERANCE-PEG in the context of the current dialogue.")
(comment pegIsOfUtteranceWithForce "An instance of #$BinaryPredicate used to record the illocutionary force of an utterance being tracked in a dialogue model.  (#$pegIsOfUtteranceWithForce PEG FORCE) says that the #$LinguisticExpressionPeg PEG is a peg for an utterance that originated in an #$InformationTransferEvent with the #$IllocutionaryForce, FORCE.  For example, (#$pegIsOfUtteranceWithForce PEG-HowMuchShouldIFeedMyDog #$Query) says that the particular utterance-event being modelled in which \"how much should I feed my dog?\" was generated had the illocutionary force of a query.")
(comment CountryTypeByGeneralRegion "A #$FacetingCollectionType and a specialization of #$ConventionalClassificationType.  Each instance of #$CountryTypeByGeneralRegion is a collection of countries that are conventionally considered to be part of the same general region.  Instances include #$LatinAmericanCountry, #$WesternEuropeanCountry, and #$MiddleEasternCountry.")
(comment CentralAmericanCountry "An instance of #$CountryTypeByGeneralRegion and a specialization of #$LatinAmericanCountry.  This is the collection of all countries that are located in #$CentralAmerica, i.e. located between the southern border of #$Mexico and the northwest border of #$Colombia.")
(comment NorthAmericanCountry "An instance of #$CountryTypeByGeneralRegion.  This is the collection of all countries that are located on or near the #$ContinentOfNorthAmerica.")
(comment SouthAsianCountry "An instance of #$CountryTypeByGeneralRegion.  This is the collection of all countries that are located in (#$SouthernRegionFn #$ContinentOfAsia).  #$Afghanistan is sometimes considered a south Asian country, but we do not include it.")
(comment SoutheastAsianCountry "An instance of #$CountryTypeByGeneralRegion.  This is the collection of all countries that are located in (#$SouthEasternRegionFn #$ContinentOfAsia).")
(comment EastAsianCountry "An instance of #$CountryTypeByGeneralRegion.  This is the collection of all countries that are located in (#$EasternRegionFn #$ContinentOfAsia).")
(comment EasternEuropeanCountry "The collection of nation-states in the Eastern region of Europe.")
(comment draftOfTextualWork "A specialization of #$derivedConceptualWork (q.v.) that relates a #$WorkingDraft (q.v.) to the published #$TextualPCW (q.v.) of which it is an earlier draft.  (#$draftOfTextualWork DRAFT WORK) means that DRAFT is an earlier draft of WORK.
<p>
A working draft typically undergoes numerous changes, or revisions, before a finished work is produced and published.  Thus the boundary between a working draft and the finished product is quite fuzzy.  In some cases it is difficult or impossible to say, even in hindsight, whether a work that existed at some earlier time constitutes (or constituted) a different work than a particular later work we know today, or was instead simply that latter work itself at a less-than-ultimate stage in its evolution.  In the former case, the two works will be related by #$draftOfTextualWork; in the latter case, there are <i>not</i> two works at all, but just one (that has been altered over time) and #$draftOfTextualWork, being asymmetric, does not apply.  But often the context will make it clear that a particular work is considered to be a distinct, earlier draft of some published work.")
(comment TestingForConditionFn "(#$TestingForConditionFn CONDITION-TYPE) denotes the collection of all instances of #$Evaluating in which an agent tests to see whether the test-subject has the physiological condition CONDITION-TYPE.")
(comment testingForCondition "The #$functionCorrespondingPredicate for #$TestingForConditionFn.  (#$testingForCondition TEST-TYPE CONDITION-TYPE) identifies TEST-TYPE as the collection of all instances of #$Evaluating in which an agent tests to determine whether the subject of the evaluation has the #$PhysiologicalConditionType CONDITION-TYPE.")
(comment roleTypesForEventType "A #$MetaPredicate and a typed-specialization (see #$typedGenlPreds) of #$requiredArg1Pred (q.v.). #$roleTypesForEventType relates a specialization of #$Event to a #$BinaryRoleTypePredicate.  <code>(#$roleTypesForEventType EVENT-TYPE PRED)</code> means that for any instance <code>EVENT</code> of <code>EVENT-TYPE</code>, there is some #$Collection <code>COL</code> such that <code>(PRED EVENT COL)</code>.  For example, (#$roleTypesForEventType #$UsingADevice #$deviceTypeUsed) means that in every instance of #$UsingADevice some <i>type</i> of device is used.")
(comment TakingAPhotograph "A specialization of #$VisualImageRecording.  Each instance of #$TakingAPhotograph is an event in which a single still #$VisualImage is recorded using a #$StillCamera.  Notable specializations include #$TakingAPhotograph-DigitalCamera and #$TakingAPhotograph-FilmCamera.")
(comment StillCamera-Film "#$StillCamera-Film is the intersection of #$StillCamera and #$FilmCamera, i.e. the collection of all still cameras that record images on #$PhotographicFilm.")
(comment FilmCamera "An instance of #$ArtifactTypeByGenericCategory.  Each instance of #$FilmCamera is a #$Camera that stores images (still or moving) on #$PhotographicFilm.")
(disjointWith TakingAPhotograph-FilmCamera TakingAPhotograph-DigitalCamera)
(comment TakingAPhotograph-DigitalCamera "A specialization of #$TakingAPhotograph.  Each instance of #$TakingAPhotograph-DigitalCamera is an event in which a single still #$VisualImage is recorded using a #$StillCamera-Digital.")
(comment MovableHolidayType "A #$SecondOrderCollection and a specialization of #$AnnualTemporalObjectType.  Each instance of #$MovableHolidayType is a specialization of #$Holiday whose instances may occur on different dates in different years.  Instances include #$EasterHoliday, #$ThanksgivingHoliday-US, and #$MLKHoliday.")
(comment SKSI-Topic "The collection of all CycL terms created as part of the structured knowledge source integration effort undertaken at the beginning of 2002.  Most of these terms are defined in the #$SKSIVocabularyMt.")
(comment SKSIDataTypeDescriptions-Topic "#$SKSIDataTypeDescriptions-Topic is the #$Topic containing the #$CycL terms used to describe data types for SKSI.")
(comment SKSISpecificKnowledgeSources-Topic "#$SKSISpecificKnowledgeSourceConstant is the collection of #$CycL terms that represent specific knowledge sources.")
(comment appropriateResponse-InfoTransferToInfoTransfer "(#$appropriateResponse-InfoTransferToInfoTransfer FIRST-UTTERANCE SECOND-UTTERANCE) says that the #$InformationTransferPhysicalEvent SECOND-UTTERANCE is an appropriate response to FIRST-UTTERANCE, also an instance of #$InformationTransferPhysicalEvent.")
(comment appropriateResponse "(#$appropriateResponse FIRST-EVENT RESPONSE-EVENT) says that RESPONSE-EVENT was an appropriate response to the occurrence of FIRST-EVENT, an instance of #$Event.")
(comment inappropriateResponse "(#$inappropriateResponse FIRST-EVENT RESPONSE-EVENT) says that RESPONSE-EVENT was an inappropriate response to the occurrence of FIRST-EVENT, an instance of #$Event.")
(comment inappropriateResponse-InfoTransferToInfoTransfer "(#$inappropriateResponse-InfoTransferToInfoTransfer FIRST-UTTERANCE SECOND-UTTERANCE) says that the #$InformationTransferPhysicalEvent SECOND-UTTERANCE is an inappropriate response to FIRST-UTTERANCE, also an instance of #$InformationTransferPhysicalEvent.")
(comment inappropriateResponseContent "(#$inappropriateResponseContent UTTERANCE RESPONSE-OBJECT) says that RESPONSE-OBJECT is an inappropriate object to play the role of #$infoTransferred in an inappropriate response to UTTERANCE, an instance of #$InformationTransferPhysicalEvent.")
(comment appropriateResponseContent "<code>(#$appropriateResponseContent UTTERANCE RESPONSE-OBJECT)</code> says that <code>RESPONSE-OBJECT</code> is an appropriate object to play the role of #$infoTransferred in an appropriate response to <code>UTTERANCE</code>, an instance of #$InformationTransferPhysicalEvent.")
(comment InfoTransferEventForPegFn "Where PEG is an instance of #$LinguisticExpressionPeg that has been introduced into the model of a discourse D, (#$InfoTransferEventForPegFn PEG) denotes the instance of #$InformationTransferPhysicalEvent that is a sub-event of D, and for which PEG has been introduced.")
(comment pegCorrespondsToInfoTransfer "(#$pegCorrespondsToInfoTransfer PEG EVENT) identifies EVENT as the instance of #$InformationTransferPhysicalEvent for which PEG, a #$LinguisticExpressionPeg has been introduced in the model of the discourse of which EVENT is a sub-event (see #$subEvents).")
(comment LevelOfInformationRichness "#$LevelOfInformationRichness, a specialization of #$EvaluativeQuantity, is used to describe the degree of richness of a given #$InformationStore.  For example, if a book deals with the topic of thermodynamics, but is only a cursory skeletal outline of the subject, then the book would be considered relatively superficial in regard to the topic of thermodynamics.  Yet another book on thermodynamics, that exhausts the subject in both comprehensiveness and depth, would be considered a relatively rich source of information on thermodynamics.  The degree of \"information richness\" can be applied to any kind of #$InformationStore: e.g., experts, databases, reports, articles, and etc.")
(comment agentAssassinated "An #$ActorSlot and a specialization of #$intendedAttackTargets, #$organismKilled, and #$victim.  <code>(#$agentAssassinated ASSASSINATION AGENT)</code> means that <code>AGENT</code> is the #$IntelligentAgent who is assassinated in the instance of #$AssassinatingSomeone <code>ASSASSINATION</code>.")
(comment EpistemologicalLevelRelation "A specialization of #$Relation whose instances are predicates and functions whose CycL names appear as the main operator in sentences only at the \"epistemological level\" (EL) and never at the \"heuristc level\" (HL) of the Cyc system.  Each instance <code>ELR</code> of #$EpistemologicalLevelRelation is such that, when the CycL constant that denotes <code>ELR</code> occurs as the main operator in (i.e. in the \"arg0\" position of) a sentence presented for assertion to the Cyc system, the #$CycCanonicalizer \"transforms\" the sentence into another, logically equivalent sentence in which the constant for <code>ELR</code> does not occur; and it is the latter sentence that is actually asserted to the Knowledge Base.  In some cases, <code>ELR</code> will be correlated (see #$elCorrelates) with some non-EL-only relation <code>HLR</code>, and the asserted sentence will contain the CycL constant for <code>HLR</code> (but not necessarily as it's main operator).
<p>
Specializations of #$EpistemologicalLevelRelation include #$ELRelation and #$ExceptionPredicate (qq.v.).")
(comment elCorrelates "A binary #$MetaKnowledgePredicate that relates an #$EpistemologicalLevelRelation (q.v.) predicate to a non-EL-only predicate that is (one of) its \"canonicalization-transform\"(s).  <code>(#$elCorrelates PRED EL-PRED)</code> means that whenever a sentence of the form <code>(EL-PRED . ARGS)</code> is used to make an assertion, the #$CycCanonicalizer \"transforms\" it into a logically equivalent sentence <code>(... (PRED . ARGS-PRIME) ...)</code> in which the CycL term for <code>PRED</code> occurs but that for <code>EL-PRED</code> does not; and the latter sentence is what actually gets stored in the Knowledge Base.
<p>
For example, <code>(#$elCorrelates #$genls #$specs)</code> holds because a sentence of the form <code>(#$specs GENL SPEC)</code> gets canonicalized into one of the form <code>(#$genls SPEC GENL)</code>.  And <code>(#$elCorrelates #$abnormal #$exceptWhen)</code> holds because a sentence of the form <code>(#$exceptWhen EXCEPTION RULE)</code> (where <code>X1</code>,..., <code>Xn</code> are all the variables that occur free in both <code>EXCEPTION</code> and <code>RULE)</code> gets canonicalized into a sentence of the form
<pre>
  (#$implies
    EXCEPTION
    (#$abnormal (#$TheList X1 .... Xn) RULE))</code> .
</pre>
<p>
These examples illustrate two noteworthy points.  First, the arguments to <code>EL-PRED</code> in the pre-canonicalizer sentence, while they might not be exactly the same, or be in the same order, as those of <code>PRED</code> in the post-canonicalizer sentence, will all typically appear <i>somewhere</i> in the latter sentence.  Second, while the pre- and post-canonicalizer sentences are logically eqivalent, <code>PRED</code> and <code>EL-PRED</code> themselves might be equivalent (modulo a permutation in argument-order) or might not be.
<p>
Note that #$elCorrelates is <i>not functional</i> in either argument-place.  E.g. it relates #$abnormal to both of the exception predicates #$exceptWhen and #$exceptFor, and it relates both #$pragmaticallyNormal and #$meetsPragmaticRequirement to the exception predicate #$pragmaticRequirement.
<p>
An important specialization of #$elCorrelates is #$elInverse (q.v.).")
(comment inheritRolePlayersOfType "This is a type-constrained version of the primitive role
inheritance predicate,
#$inheritRole. (#$inheritRolePlayersOfType SIT-TYPE
SUBSIT-TYPE-FROM SUBSIT-TYPE-TO ROLE-FROM ROLE-TO ACTOR-TYPE) means
that where SIT is an instance of SIT-TYPE, any actor of type
ACTOR-TYPE that plays the role ROLE-FROM in an instance of
SUBSIT-TYPE-FROM that is a #$subSituations of SIT also plays the role
ROLE-TO in any instance of SUBSIT-TYPE-TO that is a #$subSituations of
SIT.")
(comment inheritRolePlayers "This predicate represents the primitive relation of type
level role inheritance for complex situation types.
(#$inheritRolePlayers SIT-TYPE SUBSIT-TYPE-FROM SUBSIT-TYPE-TO
ROLE-FROM ROLE-TO) means where SIT is a complex situation of type
SIT-TYPE, any actor that plays the role ROLE-FROM in any instance of
SUBSIT-TYPE-FROM that is a #$subSituations of SIT will also play the
role ROLE-TO in any instance of SUBSIT-TYPE-TO that is a
#$subSituations of SIT.")
(comment thereExistsRolePlayer "This predicate is used as a convenient means of asserting
the existence of a particular role player for a certain stage of a
complex situation type.  Where the arg2Isa of ROLE is COL,
(#$thereExistsRolePlayer SIT-TYPE SUBSIT-TYPE ROLE) means that in any
instance of SUBSIT-TYPE that is a #$subSituations of an instance of
SIT-TYPE, there exists an actor of type COL that plays the role
ROLE.")
(comment equivRolePlayers "This predicate represents the primitive relation of type level role equivalence for complex situation types.
(#$equivRolePlayers SIT-TYPE SUBSIT-TYPE1 SUBSIT-TYPE2 ROLE1 ROLE2)
means where SIT is a complex situation of type SIT-TYPE, any actor
that plays the role ROLE-FROM in any instance of SUBSIT-TYPE-FROM that
is a #$subSituations of SIT is identical to any actor that plays the
role ROLE-TO in any instance of SUBSIT-TYPE-TO that is a
#$subSituations of SIT.")
(comment binPredBetweenRolePlayers "(#$binPredBetweenRolePlayers SIT-TYPE SUBSIT-TYPE1 SUBSIT-TYPE2 ROLE1 ROLE2 BINPRED) means that any actor that plays ROLE1 in an instance of SUBSIT-TYPE1 that is a #$subSituations of an instance of SIT-TYPE is related to any actor that plays ROLE2 in an instance of SUBSIT-TYPE2 that is a #$subSituations of the same instance of SIT-TYPE by BIN-PRED.")
(comment thereExistsRolePlayerOfType "This is the type-constrained version of thereExistsRolePlayer.  (#$thereExistsRolePlayerOfType SIT-TYPE SUBSIT-TYPE ROLE TYPE) means that in any instance of SUBSIT-TYPE that is a #$subSituations of SIT-TYPE, there is an instance of TYPE that plays ROLE.")
(comment equivRolePlayersOfType "This is a type-constrained version of the primitive role
equivalence predicate, #$equivRolePlayers. (#$equivRolePlayersOfType
SIT-TYPE SUBSIT-TYPE1 SUBSIT-TYPE2 ROLE1 ROLE2 ACTOR-TYPE) means that
where SIT is an instance of SIT-TYPE, any actor of type ACTOR-TYPE
that plays the role ROLE1 in an instance of SUBSIT-TYPE1 that is a
#$subSituations of SIT is equivalent to any actor that plays the role
ROLE2 in an instance of SUBSIT-TYPE2 that is a #$subSituations of
SIT.")
(comment LiterateAgent "A #$FirstOrderCollection.  Each instance of #$LiterateAgent is an #$IntelligentAgent who is capable of both #$Reading and #$Writing in some #$Language.")
(comment orderOfCollection "(#$orderOfCollection COL N) means that COL has order N.  See the predicate extent and #$CollectionOrder for a more detailed explanation.")
(comment FluidFiltrationProcess "An instance of #$TemporalStuffType and a specialization of #$FluidFlow-Translation and #$PurificationProcess.  Each instance of #$FluidFiltrationProcess is an event in which a #$FluidTangibleThing (e.g. #$Air or (#$LiquidFn #$Water)) passes through a (natural or artificial) filtering mechanism.  During this process, any particles in the fluid that are too large to pass through the filter's pores are removed by the filter; the fluid is thereby purified.  Specializations include #$FluidFiltrationProcess-Artificial and #$FluidFiltrationProcess-Natural.")
(disjointWith FluidFiltrationProcess-Artificial FluidFiltrationProcess-Natural)
(comment FluidFiltrationProcess-Natural "An instance of #$TemporalStuffType and a specialization of #$FluidFiltrationProcess.  Each instance of #$FluidFiltrationProcess-Natural is a natural process in which a #$FluidTangibleThing (e.g. #$Air or (#$LiquidFn #$Water)) passes through a natural filtering mechanism.  An example would be leaves being filtered from water as it passes through soil.")
(comment Filtering-Generic "An instance of #$TemporalStuffType.  Each instance of #$Filtering-Generic is an event in which something is, in some sense, \"filtered out\" from something else.  This includes instances of #$FluidFiltrationProcess but also things like filtering out #$Spam-UnsolicitedEMail from one's email using a #$FilterProgram.")
(comment SKSIHLModule "This is the collection of all of Cyc's HL modules which are
generated as part of the SKSI system.")
(comment SKSIHLModuleType "This #$SecondOrderCollection is a #$facets-Generic of
#$SKSIHLModule which identifies the salient specializations of
#$SKSIHLModule according to their functional use (removal, storage,
forward, etc.).")
(comment SKSIRemovalModule "This is the collection intersection of Cyc
#$CycRemovalModule and #$SKSIHLModule. Instances of
#$SKSIRemovalModule are generated for some structured knowledge
source. When generated, these modules are used to remove one or more
query literals which may be translated into a query against the
knowledge source. The modules provide bindings and HL supports for the
removal. This collection is partitioned into two specializations,
#$SKSISingleLiteralRemovalModule and #$SKSIMultiLiteralRemovalModule.")
(comment SKSISingleLiteralRemovalModule "The collection of SKSI removal modules (#$SKSIRemovalModule)
which remove only a single query literal. This collection is disjoint
with #$SKSIMultiLiteralRemovalModule, which as the name suggests can
remove several query literals at once.")
(comment SKSIMultiLiteralRemovalModule "The collection of SKSI removal modules (#$SKSIRemovalModule)
which remove several query literals at once. This collection is disjoint
with #$SKSISingleLiteralRemovalModule, which as the name suggests can
remove only one query literal at a time.")
(comment CycStorageModule "This is the collection of #$CycHLModules which perform
heuristic level storage of CycL sentences efficiently.")
(comment SKSIStorageModule "This is the collection intersection of #$SKSIHLModule and
#$CycStorageModule. #$SKSIStorageModules are used to modify the
contents of external knowledge sources.")
(comment sksModuleTypeDirection "This predicate determines the :direction property of the
#$SKSIHLModuleTypes created for some structured knowledge source.
(#$sksModuleTypeDirection SKS HLMODULETYPE DIRECTION) means that all
HL modules generated for SKS which are of type HLMODULETYPE should
have :direction DIRECTION. If not explicitly asserted otherwise, the
default direction for all #$SKSIRemovalModules is
#$Backward-AssertionDirection.  Similarly, if not explicitly asserted
otherwise, the default direction for all #$SKSIStorageModule is
#$Forward-AssertionDirection. Also note that this predicate is
transitive via #$subKS in its first argument.  So you should make the assertion
at the highest level SKS term at which you want all of the modules of HLMODULETYPE to have assertion direction DIRECTION.")
(comment performsActsOfTypeInLocation-Ratio "(#$performsActsOfTypeInLocation-Ratio AGENT ACTION-TYPE LOCATION PERCENT) holds just in case PERCENT of the instances of ACTION-TYPE that AGENT is known by Cyc to perform are performed in (#$eventOccursAt) location.  For instance, if 40% of the instances of #$TerroristAttack that Hamas is known to perform are performed in #$Israel, then (#$performsActsOfTypeInLocation-Ratio #$TerroristOrganization-Hamas #$TerroristAttack #$Israel .40) holds.")
(comment ibtAccessed "A #$BinaryRolePredicate that relates an instance of #$AccessingAnIBT to an instance of #$InformationBearingThing.  <code>(#$ibtAccessed ACCESS IBT)</code> means that <code>IBT</code> is accessed in <code>ACCESS</code>.  For example, (#$ibtAccessed ReadingMobyDick001 #$Copy7829OfMobyDick).")
(comment Cheeseburger "An instance of #$SpecifiedFoodDishType.  Each instance of #$Cheeseburger is a #$HamburgerSandwich which includes #$Cheese.")
(comment CBLThisStateVariableFn "A unary function that returns its argument #$CBLStateVariable. It is used in situations where the string name of the variable could conflict with a method variable having the same name.")
(comment permissionsGranted "An #$ActorSlot and a specialization of #$outputsCreated.  #$permissionsGranted relates an instance of #$Event to an instance of #$Permission.  <code>(#$permissionsGranted EVENT PERMISSION)</code> means that <code>PERMISSION</code> was granted/created in <code>EVENT</code>.  See also #$obligationsCreated.")
(comment conflictResolved "A #$BinaryRolePredicate that relates an instance of #$ResolvingAConflict to an instance of #$ConflictEvent.  <code>(#$conflictResolved RESOLVING CONFLICT)</code> means that <code>CONFLICT</code> is the conflict that is resolved in <code>RESOLVING</code>.")
(comment Acyclovir "A specialization of #$Antiviral.  Instances of this
collection are used to fight infections caused by #$Herpes-Virus.")
(comment matchesProfileForActivityType "A binary predicate that relates agents to types of activities that it would be reasonable to suppose that the agents engage in. <code>(#$matchesProfileForActivityType AGENT ACTIVITY-TYPE)</code> means that it is reasonable to suppose that #$IntelligentAgent <code>AGENT</code> is the performer in at least one instance of <code>ACTIVITY-TYPE</code> (a specialization of #$Event).
<p>
Rules concluding to #$matchesProfileForActivityType may appear to be overfitted to certain cases.  However, these rules are meant to express detailed sufficient conditions for matching the profile for being the performer of an instance of a certain activity type.  It is, of course, possible to match a similar profile for being the performer of an instance of the activity type without meeting all the criteria specified by the rules that have thus far been written.")
(comment organizationTypeMembersActiveInField "A binary predicate that relates organizations to fields of study in which members of those organizations are active.  <code>(#$organizationTypeMembersActiveInField ORG-TYPE FIELD)</code> means that members of instances of <code>ORG-TYPE</code> (a specialization of #$Organization) are active in the #$FieldOfStudy <code>FIELD</code>.  For example, '(#$organizationTypeMembersActiveInField #$MathematicsDepartment #$Mathematics)' means that members of academic mathematics departments are active in mathematics.")
(disjointWith EvaluativeQuantity MeasurableQuantity)
(comment MeasurableQuantity "A specialization of #$Quantity (q.v.).  This is the collection of quantities that have a numeric component and could actually be used to <i>measure</i> something, as opposed to (say) merely ranking it on a scale.  Arithmetic operations (such as addition and multiplication) can be performed on measurable quantities, as they can on purely numeric scalars (see #$NumericInterval).
<p>
Specializations of #$MeasurableQuantity include #$Distance, #$Temperature, #$Mass, and #$Time-Quantity.  Other, broader specializations are #$OneDimensionalQuantity, #$TwoDimensionalQuantity, and #$ThreeDimensionalQuantity.
<p>
Any quantity (that at least in principle could be) returned by a #$UnitOfMeasure (q.v.) function is a measurable quantity.  In CycL, particular measurable quantities are usually represented as the result of applying a unit-of-measure function to a real number or pair of reals.  For example, (#$Meter 5) is the distance 5 meters.
<p>
For predicates that relate things to measurable quantities that characterize them, see #$MeasurableQuantitySlot.")
(comment ResearchingAndDevelopingFn "A #$CollectionDenotingFunction and #$UnaryFunction, an expression of the form <code>(#$ResearchingAndDevelopingFn TYPE)</code> represents the sub-collection of #$Research that is dedicated to the learning how to create <code>TYPE</code>, a #$TemporalStuffType.  Thus, (#$ResearchingAndDevelopingFn #$SemiconductorDevice) refers to the collection of events that are dedicated to learning how to create instances of #$SemiconductorDevice.")
(comment typeIsRAndDOfType "An assertion of the form (#$typeIsRAndDOfType RESEARCH-TYPE THING-TYPE) is used to relate a subcollection of #$Research to an instance of #$TemporalStuffType.  Thus, any instance of RESEARCH-TYPE would be an event that is aimed at learning how to create instance of THING-TYPE.  This is the corresponding predicate for the function #$ResearchingAndDevelopingFn.")
(comment fieldFostersAdvancedArtifactsOfType "A binary predicate that relates fields of study to the technologies they advance.  <code>(#$fieldFostersAdvancedArtifactsOfType AREA TECH-TYPE)</code> means that research in the #$FieldOfStudy <code>AREA</code> engenders technological advances in the creation of artifacts of type <code>TECH-TYPE</code>.  For example '(#$fieldFostersAdvancedArtifactsOfType #$ComputerScience #$ComputerProgram-CW)' means computer science fosters advanced computer programs, and <code>(#$fieldFostersAdvancedArtifactsOfType #$NuclearEngineeringField #$NuclearPoweredDevice)</code> means that nuclear science fosters advanced nuclear powered devices.")
(comment BiotechnologyCompany "Instances are companies which develop and produce drugs and other pharmaceutical products, such as medical devices. ")
(comment researchTypeOfField "<code>(#$researchTypeOfField FIELD RESEARCH-TYPE)</code> means that researchers working in the #$FieldOfStudy <code>FIELD</code> regularly perform instances of <code>RESEARCH-TYPE</code> (a specialization of #$Research).")
(comment financialSupporters-Generic "An assertion of the form <code>(#$financialSupporters-Generic SUPPORTEE SUPPORTER)</code> means that the #$Agent-Generic <code>SUPPORTER</code> provides some of the financial resources which #$Agent-Generic <code>SUPPORTEE</code> uses to fund its activities.  For example, a college student could bear this relationship to his parents if they are paying his tuition, a #$PoliticalParty would bear this relation to anyone who gives it a donation.")
(comment politicalOrgHasSupporter "An assertion of the form <code>(#$politicalOrgHasSupporter ORG AGENT)</code> means that <code>AGENT</code> agrees with the principles and methods of <code>ORG</code>, though <code>AGENT</code> may not have a formal role within the organization's hierarhcy.  This is a more general predicate than #$politicalPartyMembers, but a more specific predicate than both #$affiliatedWith and #$positiveVestedInterest.  For instance, someone who attends rallies sponsored by or makes donations to a #$PoliticalOrganization would exemplify this relationship.")
(comment requiredActorSlots-Unique "A specialization of #$requiredActorSlots.  <code>(#$requiredActorSlots-Unique EVENTTYPE ACTORSLOT)</code> means that for any instance <code>EVENT</code> of <code>EVENTTYPE</code>, there is <i>exactly one</i> participant <code>ACTOR</code> that fills <code>ACTORSLOT</code> in <code>EVENT</code> (i.e. <code>(ACTORSLOT EVENT ACTOR)</code> holds).  For example, (#$requiredActorSlots-Unique #$KillingByOrganism-Unique #$organismKilled).")
(comment OneDimensionalUnitOfMeasure "A specialization of #$UnitOfMeasure (q.v.).  Each instance of #$OneDimensionalUnitOfMeasure is a unit-of-measure function that is <i>not</i> defined in terms of (i.e. as the product or ratio of; see #$UnitProductFn and #$PerFn) other units-of-measure.  For any number or pair of numbers taken as its argument(s), a one-dimensional unit-of-measure returns as value a #$OneDimensionalQuantity (q.v.), such as a #$Distance or a #$Mass or a #$Temperature.
<p>
Specializations of #$OneDimensionalUnitOfMeasure include #$UnitOfDistance, #$UnitOfTime, and #$UnitOfMass. Cf. #$MultiDimensionalUnitOfMeasure.")
(disjointWith MultiDimensionalUnitOfMeasure OneDimensionalUnitOfMeasure)
(comment MultiDimensionalUnitOfMeasure "A specialization of #$UnitOfMeasure (q.v.).  Each instance of #$MultiDimensionalUnitOfMeasure is a unit-of-measure function that is definable in terms of (i.e. as the product or ratio of; see #$UnitProductFn and #$PerFn) two or more #$OneDimensionalUnitOfMeasures (q.v.).  For any number or pair of numbers taken as its argument(s), a multi-dimensional unit-of-measure returns as value a #$MultiDimensionalQuantity (q.v.), such as a #$Speed or a #$Volume.
<p>
Specializations of #$MultiDimensionalUnitOfMeasure include #$TwoDimensionalUnitOfMeasure and #$ThreeDimensionalUnitOfMeasure.")
(comment TwoDimensionalUnitOfMeasure "A specialization of #$MultiDimensionalUnitOfMeasure (q.v.).  Each instance of #$TwoDimensionalUnitOfMeasure is a unit-of-measure function that is equal to the \"product\" or \"ratio\" of two #$OneDimensionalUnitOfMeasures.  For example, #$SquareMeter is equal to (#$UnitProductFn #$Meter #$Meter), and #$MilesPerHour is equal to (#$PerFn #$Mile #$HoursDuration).
<p>
For any number or pair of numbers taken as its argument(s), a two-dimensional unit-of-measure returns as value a #$TwoDimensionalQuantity (q.v.), such as an #$Area or a #$Speed.
<p>
Specializations of #$TwoDimensionalUnitOfMeasure include #$UnitOfArea and #$UnitOfSpeed.  See also #$ThreeDimensionalUnitOfMeasure.")
(disjointWith TwoDimensionalUnitOfMeasure ThreeDimensionalUnitOfMeasure)
(comment ThreeDimensionalUnitOfMeasure "A specialization of #$MultiDimensionalUnitOfMeasure (q.v.).  Each instance of #$ThreeDimensionalUnitOfMeasure is a unit-of-measure function that is equal to the \"product\" or relative \"ratio\" of three #$OneDimensionalUnitOfMeasures (q.v.).  For example, #$CubicMeter is equal to (#$UnitProductFn #$Meter #$Meter #$Meter), and #$MetersPerSecondPerSecond is equal to (#$PerFn (#$PerFn #$Meter #$SecondsDuration) #$SecondsDuration).
<p>
For any number or pair of numbers taken as its argument(s), a three-dimensional unit-of-measure returns as value a #$ThreeDimensionalQuantity (q.v.), such as an #$Volume or an #$Acceleration.
<p>
Specializations of #$ThreeDimensionalUnitOfMeasure include #$UnitOfVolume and #$UnitOfAcceleration.  See also #$TwoDimensionalUnitOfMeasure.")
(comment Cannibal "A subcollection of #$Animal and #$Heterotroph, instances of #$Cannibal are animals who regularly eat members of their same #$BiologicalSpecies.")
(comment Cannibalism "A #$FirstOrderCollection, #$Cannibalism is the sub-collection of #$Ingesting where the roles of #$performedBy and the #$consumedObject are both instances of the same #$BiologicalSpecies.")
(comment RecommendationPredicate "A specialization of #$Predicate.  Instances of this
collection are predicates used to give recommendations on actions or behavior.")
(comment TwoDimensionalQuantity "A specialization of #$MultiDimensionalQuantity (q.v.).  Each instance of #$TwoDimensionalQuantity is a quantity that is derivable as the product or ratio (see #$TimesFn and #$QuotientFn) of two #$OneDimensionalQuantity(ies) (q.v.).  For example, (#$MilesPerHour 65) is a two-dimensional quantity obtainable by dividing (#$Mile 65) by (#$HoursDuration 1), and (#$SquareMeter 4) is a two-dimensional quantity obtainable by multiplying (#$Meter 2) by itself.  In contrast, (#$Mile 65), (#$HoursDuration 1), and (#$Meter 2) are all instances of #$OneDimensionalQuantity; and (#$CubicMeter 8) is a #$ThreeDimensionalQuantity (q.v.).
<p>
Each two-dimensional quantity is in principle equal to the result of applying some (reified or otherwise) #$TwoDimensionalUnitOfMeasure (q.v.) to some #$NumericInterval (or pair of #$NumericIntervals).
<p>
Specializations of #$TwoDimensionalQuantity include #$Area and #$Speed.")
(disjointWith OneDimensionalQuantity MultiDimensionalQuantity)
(comment MultiDimensionalQuantity "A specialization of #$MeasurableQuantity (q.v.).  Each instance of #$MultiDimensionalQuantity is a measurable quantity that is defined as the product or ratio of other quantities.  For example, (#$MilesPerHour 65) is a multi-dimensional quantity obtainable by dividing (#$Mile 65) by (#$HoursDuration 1), and (#$CubicMeter 8) is a derived quantity obtainable by multiplying (#$Meter 2) by itself twice.  In contrast, (#$Mile 65), (#$HoursDuration 1), and (#$Meter 2) are all instances of #$OneDimensionalQuantity (cf.).
<p>
Each multi-dimensional quantity is in principle equal to the result of applying some (reified or otherwise) #$MultiDimensionalUnitOfMeasure (q.v.) to some number or other #$NumericInterval (or pair of numeric-intervals).
<p>
When a <i>one-dimensional</i> quantity is multiplied or divided by another one-dimensional quantity, the result is always a multi-dimensional quantity.  But note that this is <i>not</i> true of the results of multiplying and dividing quantities generally.  For example, (#$ProductFn (#$MilesPerHour 65) (#$HoursDuration 1)) is equal to the one-dimensional quantity (#$Mile 65).)
<p>
Specializations of #$MultiDimensionalQuantity include #$TwoDimensionalQuantity and #$ThreeDimensionalQuantity.")
(comment SimpleSquareQuantity "A specialization of #$SquareQuantity (q.v.).  Each instance of #$SimpleSquareQuantity <code>SQUARE</code> is equal to the product of some #$OneDimensionalQuantity <code>UNIQUANT</code> and itself.  In other words, the following holds:
<p>
    <code>(#$equals SQUARE (#$TimesFn UNIQUANT UNIQUANT))</code> .
<p>
For example, (#$SquareMile 4) is a simple square quantity equal to (#$TimesFn (#$Mile 2) (#$Mile 2)).
<p>
See also #$SimpleCubicQuantity.")
(comment SquareQuantity "A specialization of #$TwoDimensionalQuantity (q.v.).  Each instance of #$SquareQuantity <code>SQUARE</code> is equal to the product of two instances of #$OneDimensionalQuantity <code>(UNIT M) (UNIT N)</code> that are themselves measurable by the same #$OneDimensionalUnitOfMeasure <code>UNIT</code>.  In other words, the following holds:
<p>
    <code>(#$equals SQUARE (#$TimesFn (UNIT M) (UNIT N)))</code> .
<p>
For example, (#$SquareMile 6) is a square quantity equal to (e.g.) (#$TimesFn (#$Mile 2) (#$Mile 3)).
<p>
Specializations of #$SquareQuantity include #$Area and #$SimpleSquareQuantity.  See also #$CubicQuantity.")
(comment SimpleCubicQuantity "A specialization of #$CubicQuantity (q.v.).  Each instance of #$SimpleCubicQuantity <code>CUBIQUANT</code> is equal to the result of multiplying some #$OneDimensionalQuantity <code>UNIQUANT</code> with itself twice.  In other words, the following holds:
<p>
    <code>(#$equals CUBIQUANT (#$TimesFn UNIQUANT UNIQUANT UNIQUANT))</code> .
<p>
For example, (#$CubicMeter 8) is a simple cubic quantity equal to (#$TimesFn (#$Meter 2) (#$Meter 2) (#$Meter 2)).
<p>
See also #$SimpleSquareQuantity.")
(comment CubicQuantity "A specialization of #$ThreeDimensionalQuantity (q.v.).  Each instance of #$CubicQuantity <code>CUBIQUANT</code> is equal to the result of multiplying together three instances of #$OneDimensionalQuantity <code>(UNIT L) (UNIT M) (UNIT N)</code> that are themselves measurable by the same #$OneDimensionalUnitOfMeasure <code>UNIT</code>.  In other words, the following holds:
<p>
    <code>(#$equals CUBIQUANT (#$TimesFn (UNIT L) (UNIT M) (UNIT N))</code>.
<p>
For example, (#$CubicMeter 24) is a cubic quantity equal to (e.g.) (#$TimesFn (#$Meter 2) (#$Meter 3) (#$Meter 4)).
<p>
Specializations of #$CubicQuantity include #$Volume and  #$SimpleCubicQuantity.  See also #$SquareQuantity.")
(disjointWith TwoDimensionalQuantity ThreeDimensionalQuantity)
(comment ThreeDimensionalQuantity "A specialization of #$MultiDimensionalQuantity (q.v.).  Each instance of #$ThreeDimensionalQuantity is a quantity that is derivable as the product or ratio of three #$OneDimensionalQuantity(ies) (q.v.).
<p>
For example, (#$MetersPerSecondPerSecond 10) is a three-dimensional quantity obtainable by dividing (#$Meter 10) by (#$SecondsDuration 1), and then dividing <i>that</i> result by (#$SecondsDuration 1).  And (#$CubicFoot 8) is a three-dimensional quantity obtainable by multiplying (#$Foot-UnitOfMeasure 2) by itself twice.
<p>
Each three-dimensional quantity is in principle equal to the result of applying some (reified or otherwise) #$ThreeDimensionalUnitOfMeasure (q.v.) to some #$NumericInterval (or pair of #$NumericIntervals).  When a #$TwoDimensionalQuantity (q.v.) is multiplied or divided by (or divides) a #$OneDimensionalQuantity, the result is often (but not always) a three-dimensional quantity.  (An example of an exception to this is (#$ProductFn (#$MilesPerHour 65) (#$HoursDuration 1)), which is equal to the <i>one</i>-dimensional quantity (#$Mile 65).
<p>
Specializations of #$ThreeDimensionalQuantity include #$Volume and #$Acceleration.")
(comment ActTypeCommonlyConsideredCriminal "A #$SecondOrderCollection.  Each instance of #$ActTypeCommonlyConsideredCriminal is an action type (i.e. a specialization of #$Action) that many legal systems regard as a type of criminal act.  Notable instances of this collection include #$Murder and #$Stealing.")
(comment versionNumberOfTestOrType "A predicate relating a #$SoftwareTestOrTypeVersion with 
a version number.")
(comment SoftwareTestOrTypeVersion "Each instance of
#$SoftwareTestOrTypeVersion is either  a version of a collection whose
instances are individual software test  definitions or a version of an
individual test. The meaning of this  collection is equivalent to
(#$CollectionUnionFn (#$TheSet #$SoftwareTestVersion  
#$SoftwareTestTypeVersion)).")
(comment SoftwareTestVersion "The collection of specifications for a software test that have a 
version number.  Each instance of #$SoftwareTestVersion 
should include a specification for producing a result, and a description 
of what result is expected (so that the result and expectation can be 
compared.)  Furthermore, each test has a version number, where each 
version contains slight modifications of the test.")
(comment SoftwareTestTypeVersion "Each instance of #$SoftwareTestTypeVersion is a 
version of a collection whose instances are individual software test 
definitions. Instances of #$SoftwareTestTypeVersion represent 
categories of tests grouped together because they test similar 
functionality, and which might sensibly be run as a unit.")
(comment ambientVisibilityDistance "This predicate relates an object to the maximum visibility
distance 'around' the object.")
(comment ambientHeatIndex "This predicate relates an object to the ambient heat index
temperature in the region 'around' the object. (#$ambientHeatIndex
PLACE TEMP) means that given the current atmospheric conditions
'around' PLACE, the temperature feels like TEMP. The Heat Index (HI)
is the temperature the body feels when heat and humidity are combined.
It is directly proportional to the (#$ambientRelativeHumidity and
#$ambientTemperature)")
(comment ambientDewpoint "This predicate relates an object to the ambient dewpoint
temperature in the region 'around' the object. (#$ambientDewpoint
PLACE TEMP) means that given the current atmospheric conditions
(ambientHumidity and ambientPressure) 'around' PLACE, water vapor
condenses at temperature TEMP.")
(comment WeatherStation "This is the collection fixed structures where weather data
is collected by a variety of different #$Sensor-Devices.")
(comment KEClarifyingCollectionType "The collection of all instances of #$ClarifyingCollectionType that are used by the #$KRAKEN application to resolve natural language ambiguities.")
(comment ClarifyingCollectionType "A specialization of #$Collection. Instances are collections that are usefully invoked for purposes of resolving ambiguity and confusion that arise from the use of non-perspicuous languages.
 Suppose a human or other intelligent agent uses a language, such as a natural language, that is rife with ambiguity, and uses a word WORD of that language whose intended reference is unclear: in the context WORD might refer to THING1 or to THING2, but not both.  One strategy for resolving this ambiguity is to find properties of THING1 and THING2, say P1 and P2, that distinguish them from one another, and ask the speaker whether by \"WORD,\" s/he intended to refer to something with P1, or to something with P2.  For example, the speaker might use the word \"bank,\" and in response one might ask whether a financial institution or a piece of shoreline was meant.  Clearly, what values of P1 and P2 are chosen cannot be arbitrary; asking whether the speaker meant to refer to a multi-individual agent versus a non-agentive place is not as effective as asking the speaker to choose between the \"financial institution\" and \"shoreline\" interpretations described above.  Instances of #$ClarifyingCollectionType just are those collections -- such as the collection of financial institutions -- that might plausibly be invoked to resolve cases of ambiguity of the kind described here.  In particular, suppose TYPE1 is an instance of #$ClarifyingCollectionType and TYPE2 is not, and THING is an instance of both TYPE1 and TYPE2.  The fact that (#$isa TYPE1 #$ClarifyingCollectionType) is a reason to prefer TYPE1 over TYPE2 when calculating possible clarifying properties for THING.")
(comment situationTypeInWhich "The corresponding predicate for the function #$SituationTypeInWhichFn, #$situationTypeInWhich is used to relate a sub-collection of #$Situation (and an instance of #$SituationTypeByPropositionalContent) to a #$CycLSentence-Assertible.  Specifically, an assertion of the form (#$situationTypeInWhich SIT-TYPE PROP) means that the sub-collection of #$Situation SIT-TYPE is the collection whose instances are all of those situations of which PROP, a #$CycLSentence-Assertible, is constitutively true.")
(comment SituationTypeByPropositionalContent "A #$SecondOrderCollection, #$SituationTypeByPropositionalContent is a collection of types of #$Situation.  Each instance is a collection of situations that share the common feature of having a particular proposition be constitutively true of them.  A sufficient condition for membership in one of the instances of #$SituationTypeByPropositionalContent is that the situation itself or some of the instances of #$SomethingExisting which are actors in that situation have a set of properties that entail the relevant proposition.  So, if Running001 is an instance of #$Running in which #$BillClinton plays the role #$performedBy, then Running001 is an instance of thes collection (#$SituationTypeInWhichFn  (#$relationExistsExists #$performedBy #$Running #$MaleHuman)) and (#$SituationTypeInWhichFn (#$relationExistsExists #$actors #$Event #$SomethingExisting)).")
(comment VerbalExpressionPeg "The collection of all instances of #$LinguisticExpressionPeg that are used to represent verbs that occur in a discourse.")
(comment pegHasCandidatePQInterpretations "(#$pegHasCandidatePQInterpretations UTTERANCE-PEG QUERY-TEMPLATE) says that QUERY is a parameterized query template that is a reasonable candidate interpretation of the #$LinguisticExpressionPeg UTTERANCE-PEG in the context of the current dialogue.")
(comment relevantPQsForPeg "(#$relevantPQsForPeg QUERY-TEMPLATE UTTERANCE-PEG)  says that QUERY-TEMPLATE is a parameterized query template that is semantically relevant to the semantics of UTTERANCE-PEG.  Specifically, the formula for QUERY-TEMPLATE is sufficiently \"semantically close\" to the content of UTTERANCE-PEG that it is worth presenting to the utterer as a possible interpretation of UTTERANCE-PEG, or as a building block from which to construct the right interpretation.  If the formula for QUERY-TEMPLATE is a reasonable interpretation of UTTERANCE-PEG, use the more specific #$pegHasCandidatePQInterpretations.")
(comment AssignmentOntologyConstant "The collection of constants used for representing assignments and tasks.")
(disjointWith IteratedAssignment RegularlyRecurringAssignment)
(comment relationInstanceExistsAndOnly "An instance of #$RuleMacroPredicate. <code>(#$relationInstanceExistsAndOnly PRED THING-1 TYPE-2)</code> says that  there exists a thing <code>THING-2</code> such that <code>(PRED THING-1 THING-2)</code> where the fact that <code>(PRED THING-1 THING-2)</code> guarantees that <code>(#$isa THING-2 TYPE-2)</code> and that there is at least one <code>THING-2</code> such that <code>(PRED THING-1 THING-2)</code>.")
(comment UnitOfRatio "A specialization of #$MultiDimensionalUnitOfMeasure (q.v.).  Each instance of #$UnitOfRatio is a function that returns an instance of #$RatioQuantity (q.v.) when applied to a number or other #$NumericInterval (or pair of numeric-intervals).  Each unit-of-ratio can (at least in principle) be derived as the result of applying #$PerFn (q.v.) to two units-of-measure.
<p>
For example, #$MilesPerGallon is a unit-of-ratio that is equal to (#$PerFn #$Mile #$Gallon-US).  And (#$MilesPerGallon 40) (e.g.) is equal to the result of dividing  the #$Distance 40-miles by the #$Volume 1-gallon.  Thus:
<p>
(#$MilesPerGallon 40) = ((#$PerFn #$Mile #$Gallon-US) 40) = (#$QuotientFn (#$Mile 40) (#$Gallon-US 1)) .
<p>
Specializations of #$UnitOfRatio include #$UnitOfRate and #$UnitOfPressure.")
(comment UnitOfCount "A specialization of #$UnitOfMeasure (q.v.).  Each instance of #$UnitOfCount is a function that takes one or two numbers (see #$Number-General) as arguments and returns as value a #$CountQuantity (q.v.), such as a particular count of people, cars, or molecules (see the instance #$Mole-ChemicalCountUnit).
<p>
Units-of-count are often represented in CycL using #$UnitOfCountFn (q.v.).  For example, (#$UnitOfCountFn #$Person) is a unit-of-count for counting persons, and ((#$UnitOfCountFn #$Person) 4) is the count-quantity of four persons: the count (e.g.) of all four-person groups (such as the classic lineup of #$TheBeatles-MusicGroup).")
(comment LiveMusicVenue-Organization "A specialization of #$EntertainmentOrRecreationOrganization.  Each instance of #$LivemusicVenue-Organization is an organization that provides a venue for live musical performances for its patrons.")
(comment differentRolePlayers "This predicate represents the primitive relation of type
level role inequivalence for complex situation types.
(#$differentRolePlayers SIT-TYPE SUBSIT-TYPE1 SUBSIT-TYPE2 ROLE1 ROLE2)
means where SIT is a complex situation of type SIT-TYPE, any actor
that plays the role ROLE-FROM in any instance of SUBSIT-TYPE-FROM that
is a #$subSituations of SIT is known to be different from any actor that plays the
role ROLE-TO in any instance of SUBSIT-TYPE-TO that is a
#$subSituations of SIT.")
(comment differentRolePlayersOfType "This is a type-constrained version of the primitive role
inequivalence predicate, #$differentRolePlayers. (#$differentRolePlayersOfType
SIT-TYPE SUBSIT-TYPE1 SUBSIT-TYPE2 ROLE1 ROLE2 ACTOR-TYPE) means that
where SIT is an instance of SIT-TYPE, any actor of type ACTOR-TYPE
that plays the role ROLE1 in an instance of SUBSIT-TYPE1 that is a
#$subSituations of SIT is different from any actor of type ACTOR-TYPE that plays the role
ROLE2 in an instance of SUBSIT-TYPE2 that is a #$subSituations of
SIT.")
(comment QAClarifyingCollectionType "The collection of all instances of #$ClarifyingCollectionType that are used by the #$QueryAugmentationApplication to resolve natural language ambiguities.")
(comment TransportationTypeByMedium "A #$FacetingCollectionType.  Each instance of #$TransportationTypeByMedium is a specialization of #$TransportationEvent whose instances share a common type of medium--land, water, air, or space.  Instances include #$LandTransportationEvent, #$WaterTransportationEvent, #$AirTransportationEvent, and #$SpaceTransportationEvent.")
(comment LandTransportationEvent "An instance of #$TransportationTypeByMedium.  Each instance of #$LandTransportationEvent is a #$TransportationEvent which occurs primarily on or under a land surface.")
(comment eventPrimarilyOccursAt "An #$ActorSlot and a specialization of #$eventPartiallyOccursAt.  <code>(#$eventPrimarilyOccursAt EVENT LOCATION)</code> means that most (or all) of <code>EVENT</code> occurs at <code>LOCATION</code>.")
(comment WaterTransportationEvent "An instance of #$TransportationTypeByMedium.  Each instance of #$LandTransportationEvent is a #$TransportationEvent which occurs primarily on or under a water surface.")
(comment AirTransportationEvent "An instance of #$TransportationTypeByMedium.  Each instance of #$LandTransportationEvent is a #$TransportationEvent which occurs primarily in a #$PieceOfSky.")
(comment excludedAntecedent "(#$excludedAntecedent ANA ANTE) means that the linguistic expression ANTE is excluded from being a potential antecedent (see #$prospectiveAntecedent) for the anaphoric expression ANA.")
(comment impossibleAntecedent "(#$impossibleAntecedent ANA ANTE) means that the linguistic expression ANTE is excluded on semantic or grammatical grounds from being a potential antecedent (see #$prospectiveAntecedent) for the anaphoric expression ANA.")
(comment contextuallyExcludedAntecedent "(#$contextuallyExcludedAntecedent ANA ANTE) means that ANTE, a #$prospectiveAntecedent for the anaphoric expression ANA, can be excluded as a candidate natecedent on the basis of other coreference assumptions (see #$coreferentExpressions and #$referents)  in the relevant discourse context.")
(comment contextuallyPossibleAntecedent "(#$contextuallyPossibleAntecedent ANA ANTE) means that ANTE, a #$prospectiveAntecedent for the anaphoric expression ANA, is also a candidate antecedent for ANA when local coreference assumptions (see #$coreferentExpressions and #$referents) are taken into account.")
(comment onlyProspectiveAntecedent "A specialization of #$prospectiveAntecedent. (#$onlyProspectiveAntecedent ANA ANTE) means that the linguistic expression ANTE is the only prospective antecedent for the anaphoric expression ANA.  In certain situations, this relation may constitute grounds for revising coreference assumptions (#$coreferentExpressions).")
(comment AscendingStairs "An instance of #$TemporalStuffType and a specialization of #$Ambulation and #$AscendingEvent.  Each instance of #$AscendingStairs is an event in which an agent climbs part or all of a #$Stairway.  See also #$DescendingStairs.")
(comment DescendingStairs "An instance of #$TemporalStuffType and a specialization of #$Ambulation and #$DescendingEvent.  Each instance of #$DescendingStairs is an event in which an agent walks down part or all of a #$Stairway.  See also #$AscendingStairs.")
(comment CountQuantity "A specialization of #$MeasurableQuantity (q.v.).  Each #$CountQuantity is a quantity that can measure the number of things of a given sort that make up (or are otherwise parts of) some whole or totality.  For example, (#$Mole-ChemicalCountUnit 5) -- the quantity of five moles -- might be the count of the molecules in a given portion of a chemical substance.
<p>
In CycL, count-quantities are typically represented using #$UnitOfCount (q.v.) functions (e.g. #$Mole-ChemicalCountUnit), which are themselves often represented using #$UnitOfCountFn (q.v.).  For example, ((#$UnitOfCountFn #$Person) 4) is the count-quantity of four persons: the count (e.g.) of all four-person groups (such as the classic lineup of #$TheBeatles-MusicGroup).
<p>
An important use of count-quantities is as components of those instances of #$RatioQuantity (q.v.) that count things with respect to some other quantity.  For example, (#$VehiclesPerHour 100) is equal to the result of dividing (see #$QuotientFn) the count-quantity ((#$UnitOfCountFn #$TransportationDevice-Vehicle) 100) by the time-quantity (#$HoursDuration 1).  Or to say (in 2004 CE) that the US national debt works out to $20,000 dollars per person is to talk about the ratio-quantity
<p>
<pre>
  (#$QuotientFn
    ((#$USDollarFn 2004) 20000)
    ((#$UnitOfCountFn #$UnitedStatesPerson) 1) .
</pre>")
(comment GoingOverSomething "An instance of #$TemporalObjectType and a specialization of #$Translation-LocationChange.  Each instance of #$GoingOverSomething is an event in which something goes over something else.  Specializations include #$CrossingABridge and #$JumpingOverSomething.")
(comment JumpingOverSomething "An instance of #$TemporalObjectType and a specialization of #$Jumping and #$GoingOverSomething.  Each instance of #$JumpingOverSomething is an event in which an agent deliberately jumps over something, e.g. a #$Puddle.")
(comment objectGoneOver "An #$ActorSlot that relates an instance of #$GoingOverSomething to an instance of #$EnduringThing-Localized.  <code>(#$objectGoneOver GOINGOVER OBJ)</code> means that <code>OBJ</code> is the object that is gone over in <code>GOINGOVER</code>.")
(comment GoingUnderSomething "An instance of #$TemporalObjectType and a specialization of #$Translation-LocationChange.  Each instance of #$GoingUnderSomething is an event in which something goes under something else.")
(comment objectGoneUnder "An #$ActorSlot that relates an instance of #$GoingUnderSomething to an instance of #$EnduringThing-Localized.  <code>(#$objectGoneUnder GOINGUNDER OBJ)</code> means that <code>OBJ</code> is the object that is gone under in <code>GOINGUNDER</code>.")
(comment UnitOfMeasureDenotingFunction "A specialization of #$FunctionDenotingFunction (q.v.) and the collection of functions that always return units-of-measure.  More precisely: a function <code>FUNC</code> is an instance of #$UnitOfMeasureDenotingFunction if and only if, for any (sequence of) argument(s) <code>ARGS</code> for which <code>FUNC</code> is defined (see #$admittedArgument), the value it yields -- i.e. <code>(FUNC . ARGS)</code> -- is an instance of #$UnitOfMeasure (q.v.).
<p>
Instances of #$UnitOfMeasureDenotingFunction include #$PerFn, #$UnitOfCountFn, #$USDollarFn, and #$Kilo.  Thus (#$PerFn #$Mile #$HoursDuration) is the #$UnitOfSpeed that measures speed in miles-per-hour.  And (#$USDollarFn 2004) is the #$UnitOfMoney that measures monetary value in 2004 US dollars.
<p>
A notable specialization of #$UnitOfMeasureDenotingFunction is #$MetricUnitPrefix.")
(comment FET-UnknownTermReformulation "#$FET-UnknownTermReformulation is a reformulator specification that points all FET output formulae to the pre-reformulation rules that resolve unknown values.")
(comment preReformulationForUnknownTerms "(#$preReformulationForUnknownTerms RULE) tells the fact entry tool to use RULE to pre-reformulate an assertion's unknown terms.")
(comment UnitOfCountFn "A unary #$UnitOfMeasureDenotingFunction that takes any instance of #$ObjectType to its corresponding #$UnitOfCount (q.v.).  <code>(#$UnitOfCountFn OBJTYPE)</code> is the unit-of-count for counting instances of <code>OBJTYPE</code>.
<p>
For example, (#$UnitOfCountFn #$Person) is a unit-of-count for counting persons, and ((#$UnitOfCountFn #$Person) 4) is the #$CountQuantity (q.v.) of four persons: the count (e.g.) of all four-person groups (such as the classic lineup of #$TheBeatles-MusicGroup).")
(comment DivertingSomething "A specialization of #$ControllingSomething.  Each instance of #$DivertingSomething is an event in which the course or #$Path-Generic that something would normally take is deliberately altered.  This may be performed directly (i.e. using physical force, as in diverting the course of a #$River using a #$FlowControlDevice) or indirectly (as in diverting #$Traffic using #$RoadSigns).  Note that one cannot divert oneself: the performer of an instance of #$DivertingSomething cannot be the same as the #$objectActedOn.  Also, note that an instance of #$DivertingSomething comprises just the act of changing something's course; it does not cover the \"diversion situation\" that follows.  For example, a road construction crew setting up a bunch of \"detour\" signs to re-route traffic is an instance of #$DivertingSomething; the resulting situation in which cars take an alternate route around the construction is not.")
(comment ReflectingAVisualImage "An instance of #$TemporalStuffType.  Each instance of #$ReflectingAVisualImage is an #$Event in which a #$VisualImage reflects off of some #$PartiallyTangible object in such a way that the basic structure of the image is preserved.  (The reflected image may be somewhat distorted, but not distorted beyond recognition.)")
(comment Valuable-PersonalPossession "An instance of #$ArtifactTypeByGenericCategory.  Each instance of #$Valuable-PersonalPossession is a relatively small, relatively valuable #$PortableObject: a personal possession that one might lock away (e.g. in a #$BankVault) for safekeeping.  Notable specializations are #$TenderObject, #$Jewelry, and #$PersonalSetOfKeys.")
(comment Trawling "An instance of #$TemporalStuffType and a specialization of #$Fishing.  Each instance of #$Trawling is an event in which a large #$FishingNet is pulled through the water behind a boat (see #$Trawler) in order to catch a #$Mob of #$Fish.  Most instances of #$Trawling are instances of #$CommercialFishing.")
(comment typicalCareRequirementForType "(#$typicalCareRequirementForType CARE-EVENT TYPE) means that typically, instances of TYPE, INSTANCE, usually require instances of CARE-EVENT to maintain INSTANCE. Thus, (#$typicalCareRequirementForType #$FeedingAnAnimal #$DomesticPet) means that instances of #$DomesticPet usually require instances of #$FeedingAnAnimal.")
(comment MakingWaterAvailableToOrganism "A specialization of #$TakingCareOfSomething.  Each instance
of this collection is an event in which an agent makes water available
to an organism.  This is particularly important for #$CaptiveAnimals, but
instances of this collection also include the water Cycorp makes
available to its employees, the water I make available to stray
cats outside my apartment building, and the water made available to
birds in birdbaths.")
(comment CleaningAnimalContainer "A specialization of #$CleaningAnObject and
#$TakingCareOfSomething.  In each instance of this collection, an
instance of #$AnimalContainer is cleaned.  This collection includes
events in which a rat's cage is cleaned as well as those events in
which a zoo animal's cage is cleaned.")
(comment knownAntecedentRule "A #$MetaKnowledgePredicate that is used to state a strong pragmatic directive to the #$CycInferenceEngine.  Asserting (#$knownAntecedentRule RULE) tells the inference engine to automatically generate a removal module to implement RULE; i.e. to solve queries unifying with the consequent of RULE by attempting to prove the substituted antecedent of RULE.  When this removal module is used during inference, it attempts to prove the substituted antecedent via removal only (see #$knownSentence).  It does not preclude other uses of RULE in inference.")
(comment agentProhibitsActType "A binary #$AgentPredicate.  <code>(#$agentProhibitsActType AGENT ACTTYPE)</code> means that <code>AGENT</code> prohibits or disallows instances of <code>ACTTYPE</code> from being performed.  This implies that <code>AGENT</code> has some sort of authority or power (be it legal, moral, coercive, or whatever) to make such a prohibition.  It suggests (but does <i>not imply</i>) that <code>AGENT</code> has at least some capability of enforcing the prohibition.  It does not imply that no acts of <code>ACTTYPE</code> are performed, since prohibitions are sometimes violated.
<p>
For example,
<pre>
  (#$agentProhibitsActType #$EmilyPost
    (#$SubcollectionOfWithRelationToFn
      #$Smoking #$eventOccursAt EmilyPostsHouse))</code>
</pre>
<p>
means that Emily Post prohibits smoking in her house.
<p>
When making an #$agentProhibitsActType assertion one should take care to restrict <code>ACTTYPE</code> sufficiently, in light of <code>AGENT</code>'s actual authority and proscriptive intent.  Thus, in the above example, it would be inappropriate to replace the predicate's second argument with
<pre>
  (#$SubcollectionOfWithRelationToTypeFn
    #$Smoking
    #$eventOccursAt
    #$House-Modern),
</pre>
as Post does not have the authority to prohibit smoking in houses generally.
<p>
See also #$lawProscribesActType.")
(comment BanOnAConceptualWork "A specialization of #$Law (q.v.).  A #$BanOnAConceptualWork is a law prohibiting the use, performance, or distribution of some published (or publishable) #$ConceptualWork (q.v.).  See #$bannedWorks.")
(comment bannedWorks "A binary predicate that relates a given #$BanOnAConceptualWork (q.v.) to the #$ConceptualWork(s) it is a ban on.")
(comment TriggeringSomething "A specialization of #$Action.  Each instance of #$TriggeringSomething is an event the most notable feature of which is that it sets some other event or process into motion.  Specializations include #$PullingATrigger and #$TrapTrippingEvent.  An instance of #$TriggeringSomething need not be a #$PurposefulAction (think of a #$Mouse-Rodent triggering a #$MouseTrap).  See also #$TriggeringMechanism.")
(comment eventsTriggered "A #$BinarySituationPredicate that relates an instance of #$TriggeringSomething to an #$Event.  <code>(#$eventsTriggered TRIGGERING EVENT)</code> means that <code>EVENT</code> is an event that is triggered (i.e. set into motion) in <code>TRIGGERING</code>.")
(comment onlyPossibleAntecedent "A specialization of #$contextuallyPossibleAntecedent. (#$onlyPossibleAntecedent ANA ANTE) means that the linguistic expression ANTE is the only possible antecedent for the anaphoric expression ANA.  In many situations, this relation may constitute grounds for inferring coreference (#$coreferentExpressions).")
(comment WaveCycle "A specialization of #$WavePropagation. Each instance of #$WaveCycle is the propagation of some wave through one cycle.")
(comment DuctTape "An instance of #$ArtifactTypeByGenericCategory.  Each instance of #$DuctTape is a length of strong, fabric-based #$AdhesiveTape, usually silver in color and about two inches wide.  Its primary function (cf. #$typePrimaryFunction) is to be used for sealing #$FluidConduits, but consumers have found many other uses for it, such as #$SimpleRepairing and #$ConnectingTogether.")
(comment SealingSomething "An instance of #$TemporalObjectType and a specialization of #$ActionOnObject.  Each instance of #$SealingSomething is a #$PurposefulPhysicalAction in which an agent acts on an object so as to prevent that object from leaking or absorbing some #$FluidTangibleThing (e.g. #$Air or (#$LiquidFn #$Water).")
(comment NIMDTemplate "A spec of #$FormulaTemplate. The collection of formula templates created specifically for the NIMD Project.")
(comment IndependentCountryTemplates-Geography "A spec of #$NIMDTemplate. The collection of formula templates that deal with information about an IndependentCountry's geographical information.")
(comment IndependentCountryTemplateTopic "A spec of #$NIMDTemplate. The collection of formula templates for the NIMD Project that describe instances of #$IndependentCountry.")
(comment IndependentCountryTemplates-Name "A spec of #$NIMDTemplate. The collection of formula templates that deal with information about an IndependentCountry's name and identification information.")
(comment IndependentCountryTemplates-People "A spec of #$NIMDTemplate. The collection of formula templates that deal with information about an IndependentCountry's population.")
(comment IndependentCountryTemplates-Politics "A spec of #$NIMDTemplate. The collection of formula templates that deal with information about an IndependentCountry's government and politics.")
(comment ProjectManagementPredicate "A specialization of #$Predicate.  Each instance of this
collection is a predicate used for project management.")
(comment SickOrEmergencyLeave "A specialization of #$LeaveOfAbsence.  Each instance of
this collection is an absence in which an agent uses sick
time.  Sick time includes absences to care for sick family members, in
addition to one's self.")
(comment VacationLeave "A specialization of #$LeaveOfAbsence.  Each instance of
this collection is a scheduled absence in which an agent has been granted
leave from another activity, such as work or school, as a respite from
that activity.  This colection includes the time that is granted for
vacation purposes and excludes holiday leaves, sick and emergency leaves.")
(comment LeaveOfAbsence "A specialization of #$ScheduledAction.  Each instance of
this collection is a scheduled leave from another
activity, such as school or work.  This collection includes those
absences due to holidays, #$VacationLeave, and sick or emergency leaves.")
(comment outOfOfficeDueToEvent "An instance of #$TemporallyQualifiableRelation that relates
an instance of #$Agent-Generic to the instance of #$Event that was the
reason for an absence from their usual workplace, as defined within
the context of the assertion.  (outOfOfficeDueToEvent AGENT EVENT)
means that AGENT was out of the office due to EVENT. EVENT may be a an
instance of #$ScheduledAction, such as #$VacationLeave, or some
unscheduled event, such as IceStorm001 that prevents employees from
reaching the office. However, EVENT should only mean AGENT is
temporarily out of the office. Thus, EVENT should not be a termination
of employment. Statements using this predicate should be temporally
qualified.")
(comment workTimeInTimeInterval "(#$workTimeInTimeInterval TIME-QUANTITY TIME-INTERVAL) means that there is TIME-QUANTITY amount of work time available in
TIME-INTERVAL. For example, (#$workTimeInTimeInterval (#$HoursDuration 8) (#$DayFn 13 (#$MonthFn #$February (#$YearFn 2004)))) means that February 13, 2004 has 8 hours of work time. This predicate is dependent on the context of use and expresses the 'official' work time within a time interval. This means that although February 13, 2004 has 8 hours of work time associated with it, a given agent may work more or less hours.")
(comment agentWorkTimeAvailableForTask "(agentWorkTimeAvailableForTask AGENT TIME-QUANTITY TASK) means that
AGENT is available for TIME-QUANTITY amount of time for work to work
on TASK.  This predicate should be temporally qualified.  Thus, if it is true that (agentTaskAvailableWorkHours JohnSmith TASK001 (HoursDuration 160)), it means that John Smith is available for 160 hours of work time to work on TASK001.")
(comment temporallySubsumesNDatesOfType "(#$temporallySubsumesNDatesOfType TYPE NUMBER TIME-INTERVAL)
means that there are NUMBER instances of TYPE in the instance of
INTERVAL.  For example, (#$temporallySubsumesNDatesOfType #$Weekday 2 (#$TimeIntervalInclusiveFn (#$DayFn 12 (#$MonthFn #$February (#$YearFn 2004))) (#$DayFn 15 (#$MonthFn #$February (#$YearFn 2004))))) means that the time interval between February 12th to the the 15th in 2004 has 2 Weekdays in the interval. ")
(comment SKSISupportedComparisonPredicate "This is the collection of #$ComparisonPredicates which
#$SKSIRemovalModules can convert to server side constraints.")
(comment fieldValueComparison-Inverse "This predicate is a generalization of #$fieldValue which
adds the #$SKSISupportedComparisonPredicate as an additional argument.
That is, (#$fieldValueComparison-Inverse PFI VAL PRED) means that the
referent REF of the indexical PFI satisfies (PRED VAL REF). Like
#$fieldValue, the ground formulas of this predicate usually occur within a
#$rowInSourceClaims sentence which determines the referent value of
PFI. See also #$fieldValueComparison, which differs from this
predicate only in the order of the arguments of PRED.")
(comment fieldValueComparison "This predicate is a generalization of #$fieldValue which
adds the #$SKSISupportedComparisonPredicate as an additional argument.
That is, (#$fieldValueComparison PFI VAL PRED) means that the referent
REF of the indexical PFI satisfies (PRED REF VAL). Like #$fieldValue,
the ground formulas of this predicate usually occur within a #$rowInSourceClaims 
sentence which determines the referent value of PFI. See also
#$fieldValueComparison-Inverse, which differs from this predicate only
in the order of the arguments of PRED.")
(comment GeneratingPower "An instance of #$TemporalStuffType and a specialization of #$CreationEvent.  Each instance of #$GeneratingPower is an event in which power/energy is generated.  A notable specialization is #$GeneratingElectricity.")
(comment irExpansionCandidate "(#$irExpansionCandidate THING-EXPANDED EXPANSION-STRATEGY CANDIDATE) says that CANDIDATE is a proposed candidate for providing IR expansion information for THING-EXPANDED, using EXPANSION-STRATEGY, an instance of #$IRExpansionStrategy.")
(comment ProvidePartsBasedExpansions-IRExpansionStrategy "An instance of #$IRExpansionStrategy.  This is a strategy for providing expansions for a concept based on part-like information about that concept.  For example, if an IR system requests expansions for a company, important subdivisions of that company, or its chief executives, might be included as part of this strategy.")
(comment prohibits-Underspecified "A binary #$UnderspecifiedPredicate that represents the notion of one thing prohibiting another.  <code>(#$prohibits-Underspecified PROHIBITER THING)</code> means that <code>PROHIBITER</code> somehow prohibits, forbids, bans, or disallows <code>THING</code> or -- if <code>THING</code> is a collection or a conceptual work -- instances or instantiations of <code>THING</code>.  <code>PROHIBITER</code> might be an agent, a law, an agreement, an order, or something else.")
(comment DiplomaticEvent-Intergovernmental "Each instance of #$DiplomaticEvent-Intergovernmental is a #$DiplomaticEvent whose main #$socialParticipants are #$RegionalGovernments (or representatives thereof).")
(disjointWith DiplomaticEventWithNonGovtParticipants DiplomaticEvent-Intergovernmental)
(comment DiplomaticEventWithNonGovtParticipants "A #$FirstOrderCollection.  Each instance of #$DiplomaticEventWithNonGovtParticipants is a #$DiplomaticEvent some of whose main #$socialParticipants are not #$RegionalGovernments (or representatives thereof).  Specializations include #$ObtainingAVisa and (#$ObtainingFn #$Passport).")
(comment GeneralMotorsCorporateOfficersPage "An instance of #$WorldWideWebPage-AIS.  This page is the
index for the Country Studies.  See also
#$LibraryOfCongressCountryStudiesWebpage and #$LibraryOfCongressCountryStudiesWebpageFn.")
(comment DomainExpert "A #$DomainExpert is a #$Person who has an expert level
of knowledge about some subject, whose expertise is deployed in a
professional context. A person may offer their expertise as a
#$Consultant, or they may be employed by an organization that uses
their expertise expertise as part of their job.")
(disjointWith ZeroDimensionalUnitOfMeasure (CollectionDifferenceFn UnitOfMeasure ZeroDimensionalUnitOfMeasure))
(comment ZeroDimensionalUnitOfMeasure "A specialization of #$UnitOfMeasure (q.v.).  Each instance of #$ZeroDimensionalUnitOfMeasure is a unit-of-measure function that, unlike all other types of unit-of-measure, does <i>not</i> return instances of #$MeasurableQuantity (q.v.), but instead returns instances of #$NumericInterval (q.v.).
<p>
Zero-dimensional units-of-measure are recognized mainly in order to simplify the application of quasi-mathematical operations (e.g. #$PerFn, #$UnitProductFn) to units-of-measure generally.  For example, #$Unity (q.v.) is a zero-dimensional unit-of-measure that returns the #$IntervalOnNumberLine whose least and greatest point-values are given  by its argument(s).  #$Unity is (e.g.) the result of \"multiplying\" (via #$UnitProductFn) #$TimesPerDay by #$DaysDuration.
<p>
Cf. #$OneDimensionalUnitOfMeasure and #$MultiDimensionalUnitOfMeasure.")
(comment genlStrategies "A specialization of #$generalizations. (#$genlStrategies REFINEMENT STRATEGY) says that the REFINEMENT, an instance of #$Strategy is a refinement of the instance of #$Strategy STRATEGY.  The \"is a refinement of\" relationhip is understood as follows: for any event EXE that is an execution of REFINEMENT, EXE is thereby an execution of STRATEGY.")
(comment PresentTenseVersionHoldsSomeTimeInDuration "An instance of #$BinaryRolePredicate is an instance of this collection just in case its corresponding (not necessarily reified) present tense progressive predicate (see #$rolePredicateHasCorrespondingPresentTenseVersion) holds of its arguments sometime during the duration of the event.  For example, #$castMembers is an instance of this collection because its present tense progressive version (#$actingInDramaticPerformance) holds of any argument pairs that stand in #$castMembers for some time interval during the duration of the first argument.
<p>
More precisely,
<p>
(#$implies
(#$and
(#$ist MT (PRED ARG-1 ARG-2))
(#$ist MT (#$startingDate ARG-1 DATE-1))
(#$ist MT (#$endingDate ARG-1 DATE-2))
(#$rolePredicateHasCorrespondingPresentTenseVersion PRED PRED-PT)
(#$isa PRED #$PresentTenseVersionHoldsSomeTimeInDuration))
(#$ist (#$MtSpace MT (#$MtTimeWithGranularityDimFn (#$SomeTimeInIntervalFn (#$TimeIntervalInclusiveFn DATE-1 DATE-2) GUID-STRING)))
(PRED-PT ARG-1 ARG-2)))
<p>
.")
(comment PresentTenseVersionHoldsThroughoutDuration "This collection is a specialization of #$PresentTenseVersionHoldsSomeTimeInDuration.  It consists of just those instance of that collection whose present tense progressive versions hold throughout the duration of the event in question.  For a full explanation of this concept see #$PresentTenseVersionHoldsSomeTimeInDuration.")
(comment ProperIntervalOnNumberLine "A specialization of both #$IntervalOnNumberLine and #$ScalarProperInterval (qq.v.).  Each instance of #$ProperIntervalOnNumberLine is an proper interval -- i.e. <i>not</i> just a single point (see #$Number-General) -- on the real number line.  For example, the phrase \"numbers greater than zero and less than or equal to 10\" describes such an interval.")
(comment fieldIndexicalsEqual "This predicate is used to state that two physical field
indexicals have the same value. Ground formulas using it usually
appear within a #$rowInSourceClaims sentence which determines the
referent value of both indexicals. See also the generalization
#$fieldIndexicalsComparison.")
(comment fieldIndexicalsComparison "This predicate is used to state a comparison which holds
between the referent values of two physical field indexicals. Ground
formulas using it usually appear within a #$rowInSourceClaims sentence
which determines the referent value of both indexicals. See also the
special case #$fieldIndexicalsEqual.")
(disjointWith ContinuousIntervalOnNumberLine (CollectionIntersection2Fn IntegerExtent ProperIntervalOnNumberLine))
(comment ContinuousIntervalOnNumberLine "A specialization of #$IntervalOnNumberLine (q.v.).  Each instance of #$ContinuousIntervalOnNumberLine is either a #$RealNumber or a continuous proper interval on the real number line.  For example, the phrase \"real numbers greater than zero and less than or equal to 10\" describes such an interval, but the phrase \"<i>integers</i> greater than zero and less than or equal to 10\" does not (cf. #$IntegerExtent).")
(comment InstantiationOfWorkFn "(InstantiationOfWorkFn WORK) denotes the collection of all #$InformationBearingThings which are copies, performances, or other instantiations of WORK (see #$instantiationOfWork).")
(comment assignmentPeriod "A #$TemporalPredicate and a specialization of #$obligationPeriod that applies to #$Assignment-Specifications.  (#$assignmentPeriod TASK INTERVAL) means that TASK is to be carried out during INTERVAL.  In order to fulfill TASK (see #$actionFulfillsAssignment), the #$assignees must perform (or at least complete) an action of the type specified type during INTERVAL.  The ending point of INTERVAL (if there is one) is the #$assignmentDeadline.")
(comment assignmentRepetitionPeriod "An assertion of the form (#$assignmentRepetitionPeriod ASSIGN INTERVAL-TYPE) is used to relate an instance of #$RegularlyRecurringAssignment to an instance of #$ConventionallyClassifiedTimeIntervalSeries.  Specifically, this states that the task specified by ASSIGN must be accomplished during each instance of INTERVAL-TYPE during the period in which ASSIGN holds (#$assignmentPeriod (q.v.)).")
(comment assignmentIterationCount "An assertion of the form (#$assignmentIterationCount ASSIGN N) is used to relate an instance of of #$IteratedAssignment ASSIGN to an instance of #$PositiveInteger N.  Specifically, this states that the task specified by ASSIGN must be accomplished N times in order to satisfy ASSIGN.")
(comment actFulfillsNthIterationOfDistributedAssignmentForAgent "An assertion of the form (#$actFulfillsNthIterationOfDistributedAssignmentForAgent ACT N ASSIGN AGENT) represents the fact that the #$Situation ACT represents the Nth performance of the sort of action specified by ASSIGN (an instance of both #$DistributedAssignment and #$IteratedAssignment) which the #$IntelligentAgent AGENT is obligated to perform by virtue of filling an #$assignees role for ASSIGN.")
(comment actFulfillsNthIterationForAssignment "An assertion of the form (#$actFulfillsNthIterationForAssignment ACTION Nth ASSIGN) asserts that the instance of #$Action ACTION partially satisfies the #$IteratedAssignment ASSIGN by being the Nth instance of the sort of action specified by ASSIGN.  The total number of instances of the relevant sort of action is represented using the predicate #$assignmentIterationCount.")
(comment actFulfillsAssignmentForSubPeriod "An assertion of the form (#$actFulfillsAssignmentForSubPeriod ACTION ASSIGNMENT INTERVAL) asserts that the instance of #$Action ACTION partially satisfies the #$RegularyRecurringAssignment ASSIGN by being the sort of action specified by ASSIGN and by being performed during the #$TimeInterval INTERVAL (where INTERVAL is an instance of the type of time interval to which ASSIGN bears the relation #$assignmentRepetitionPeriod (q.v.) and INTERVAL falls within the period of ASSIGN (#$assignmentPeriod (q.v.))).")
(comment actFulfillsRecurringDistributedAssignmentForAgentForSubPeriod "An assertion of the form (#$actFulfillsRecurringDistributedAssignmentForAgentForSubPeriod ACT ASSIGN AGENT INTERVAL) represents the fact that the #$Situation ACT satisfies the portion of ASSIGN, an instance of both #$DistributedAssignment and #$RegularlyRecurringAssignment, which represents the #$IntelligentAgent AGENT's obligation with regard to ASSIGN  during the #$TimeInterval INTERVAL.")
(comment actFulfillsDistributedAssignmentForAgent "An assertion of the form (#$actFulfillsDistributedAssignmentForAgent ACT ASSIGN AGENT) represents the fact that the #$Situation ACT satisfies the portion of the #$DistributedAssignment ASSIGN which applies to the #$IntelligentAgent AGENT.  In a #$DistributedAssignment, every agent who is an assignee must complete the task specified by the assignment.  This predicate allows one to represent how individual agent's have fared in completing their obligations with regard to the assignment.")
(comment startsAfterStartingOf-Assignment "An assertion of the form (#$startsAfterStartingOf-Assignment ASSIGN1 ASSIGN2) expresses a stipulation on how the #$Assignment-Specification ASSIGN1 and ASSIGN2 are to be fulfilled.  Specifically, it asserts that the action that satisfies ASSIGN1 must begin after the start of the action which satisfies ASSIGN2.")
(comment recordedInfoNumberText "(#$recordedInfoNumberText LOC NUM) means that NUM is a
string denoting a telephone number for recorded information about
LOC. Such information often includes directions to, and times and
prices for events happening at LOC, or sponsored by the individuals or organizations for whom LOC is a #$ContactLocation.")
(comment ProfileReferentPeg "A specialization of #$DiscourseReferentPeg used to facilitate user profiling with #$TheMySentientSystem. Instances of this collection are referents which should have their content assertions lifted from their session Mt (#$MySentientAnswersSessionRecordMicrotheory) to the user profile (#$MySentientUserProfileMicrotheory). For a given chain of coreferent expressions, there should be a unique #$ProfileReferentPeg; and this referent should be linked to each expression in the chain via the #$intendedReferents relation.  In general, #$ProfileReferentPegs will be the #$naiveReferent of the.least recently mentioned expression in the coreference chain.")
(comment assertionUtility-1 "A #$CycInferenceHeuristicRelevancePredicate. (#$assertionUtility ASSERTION NUM) states that the #$CycLAssertion ASSERTION should be heuristically considered of utility NUM to inferences made in the current Microtheory. NUM should be a #$RealNumber between 1 and -1, with 1 indicating maximum utility, -1 indicating minimum utility, and 0 being agnostic with respect to utility.  (#$assertionUtility ASSERTION 1) is equivalent to (#$highlyRelevantAssertion ASSERTION). (#$assertionUtility ASSERTION -1) is equivalent to (#$irrelevantAssertion ASSERTION).  See also other instances of #$CycInferenceHeuristicRelevancePredicate.")
(comment InterestingnessRulesMtForSKSFn "(#$InterestingnessRulesMtForSKSFn SKS) denotes the microtheory that stores all rules concluding to sentences about the interestingness of concepts that, by design, target knowledge found in SKS.")
(comment sksHasInterestingnessRulesMt "The #$functionCorrespondingPredicate for #$InterestingnessRulesMtForSKSFn.  (#$sksHasInterestingnessRulesMt SKS MT) identifies MT as the instance of #$Microtheory that stores all rules concluding to sentences about the interestingness of concepts that, by design, target knowledge found in SKS.")
(comment properPhysicalParts "An #$IrreflexiveBinaryPredicate and a specialization of #$properParts and #$physicalParts (qq.v.).  <code>(#$properPhysicalParts WHOLE PART)</code> means that <code>PART</code> is a proper physical part of <code>WHOLE</code>.")
(comment keSuggestion "(#$keSuggestion OBJ SENTENCE) states a suggestion for the term OBJ that SENTENCE must be known to be true.  #$keSuggestion is a generalization of #$keRequirement, #$keStrongSuggestion, and #$keWeakSuggestion.")
(comment Real-Minus1ToPlus1 "A Real Number between -1 and 1")
(comment assertionUtility "A #$CycInferenceHeuristicRelevancePredicate. (#$assertionUtility ASSERTION NUM) states that the #$CycLAssertion ASSERTION should be heuristically considered of utility NUM to inferences made in the current Microtheory. NUM should be a #$RealNumber between 1 and -1, with 1 indicating maximum utility, -1 indicating minimum utility, and 0 being agnostic with respect to utility.  (#$assertionUtility ASSERTION 1) is equivalent to (#$highlyRelevantAssertion ASSERTION). (#$assertionUtility ASSERTION -1) is equivalent to (#$irrelevantAssertion ASSERTION).  See also other instances of #$CycInferenceHeuristicRelevancePredicate.")
(comment deviceUsedAsWeapon "An #$ActorSlot and a specialization of #$deviceUsed and #$instrument-UsedAsWeapon.  <code>(#$deviceUsedAsWeapon ATTACK DEVICE)</code> means that the #$PhysicalDevice <code>DEVICE</code> was used as a weapon in the #$AttackOnTangible <code>ATTACK</code>.")
(comment TextMessagingViaCellPhone "A specialization of (#$CommunicatingByMeansOfFn #$CellularTelephone)) instances of which involve the sending of a text message from one cell phone to another.")
(comment InstantMessaging "A specialization of #$InternetCommunication in which text messages are sent more-or-less directly and in real-time (cf. #$EMailCommunication) over the internet.  Typically, both parties in an instant-messaging conversation see each line of text right after it is typed, thus making it more like a telephone conversation than exchanging letters.")
(disjointWith SpokenCommunicating TextCommunication)
(disjointWith NonVerbalCommunicating TextCommunication)
(comment TextCommunication "A collection of information-transfer events; a specialization of #$Communicating.  Each instance of #$TextCommunication is a transmission of information that is primarily via written text.  Thus this collection is #$disjointWith both #$SpokenCommunicating and #$NonVerbalCommunicating.  Specializations of #$TextCommunication include #$EMailCommunication and #$TextMessagingViaCellPhone.  Text communication also encompasses skywriting, passing notes in class, letter-writing, and sending Morse-encoded messages by telegraph.")
(comment FirefightingEquipment "A #$DeviceTypeByFunction.  Each instance of #$FirefightingEquipment is a #$PhysicalDevice that is used primarily for fighting fires (see #$ExtinguishingAFire) or activity closely related thereto, e.g. #$FireRescueTransportation.  Specializations include #$FireHose, #$FireHelmet, and #$FireTruck.")
(comment CameraPhone "A specialization of #$CellularTelephone, instances of which have a camera built in.")
(comment PayingATollForPassage "A #$TemporalObjectType and a specialization of #$Paying.  Each instance of #$PayingATollForPassage is an event in which an agent pays a standard fee to cross a #$Bridge or travel along a #$TollRoad.")
(comment objectTypeSoldAtLocation "(#$objectTypeSoldAtLocation TYPE LOC) means that items of type TYPE are available for purchase at the business location LOC.")
(comment ProvideExpansionsBasedOnInstancesOfFacetingCollections-IRExpansionStrategy "An instance of #$IRExpansionStrategy.  This is a strategy for providing expansions for a collection COLL, by returning all specs of that collection that are also instances of a faceting collection for COLL.")
(comment EmptyingAContainerByTiltingIt "An instance of #$TemporalObjectType and a specialization of #$EmptyingAContainer.  Each instance of #$EmptyingAContainerByTiltingIt is a #$PurposefulPhysicalAction in which an agent empties a #$Container by tilting it until all of its contents fall out.")
(comment MachineCodeInstruction "A specialization of #$Instructions (q.v.).  Each instance of #$MachineCodeInstruction is an instruction that could be represented by a single sentence (i.e. line of code) of a machine language, a  very low-level type of #$ComputerLanguage.")
(comment portalPassedThrough "An #$ActorSlot and a specialization of #$eventOccursAt.  Where <code>PASSING</code> is an instance of #$PassingThroughPortal and <code>PORTAL</code> is an instance of #$Portal, <code>(#$portalPassedThrough PASSING PORTAL)</code> means that <code>PORTAL</code> is passed through by the #$primaryObjectMoving in <code>PASSING</code>.")
(comment propagationMedium "An #$ActorSlot and a specialization of #$nonDeliberateActors.  Where <code>WP</code> is an instance of #$WavePropagation and <code>PT</code> is an instance of #$PartiallyTangible, <code>(#$propagationMedium WP PT)</code> means that <code>PT</code> is the medium for <code>WP</code>.  See also #$propagationMediumType, the type-level version of this predicate.")
(comment ticketForSitType "(#$ticketForSitType TIK SITTYPE) means that the individual
#$Ticket TIK authorizes participation in one or more instances of
SITTYPE. For example, (#$ticketForSitType Ticket004
#$MovieShowingAtATheater) means that Ticket004 is a movie ticket.")
(comment TicketTypeBySitTypeFn "(#$TicketTypeBySitTypeFn SITTYPE) denotes the collection of
tickets authorizing a ticket holder to participate in some
situation(s) of type SITTYPE.  For example (#$TicketTypeBySitTypeFn
#$MovieShowingAtATheater) denotes the collection of all movie
tickets.")
(comment TicketTypeBySitTypeAuthorized "A collection of collections. Each
TicketTypeBySitTypeAuthorized is a collection of tickets authorizing
participation in the same type of #$Situation.  For example (#$isa
#$LiftTicket #$TicketTypeBySitTypeAuthorized), since #$LiftTicket is
by definition the collection of tickets for #$DownhillSkiing.")
(comment TicketTypeByHolderTypeFn "(#$TicketTypeByHolderTypeFn AGTTYPE) denotes the collection
of tickets authorizing a ticket holder of type AGTTYPE to participate
in some situation(s). For example (#$TicketTypeByHolderTypeFn
#$HumanAdult) denotes the collection of tickets for adults, while
(#$TicketTypeByHolderTypeFn #$Student) denotes the collection of
student tickets. The situation or situation type may be specified via
#$ticketFor or #$ticketForSitType.")
(comment TicketTypeByHolderType "A collection of collections. Each TicketTypeByHolderType is
a collection of tickets authorizing participation in some instance or
type of #$Situation, for ticket holders of a particular type, such as
students or senior citizens. The situation or situation type may be
specified via #$ticketFor or #$ticketForSitType.")
(comment ticketHolderType "(#$ticketHolderType TIK AGENTTYPE) means that the individual
#$Ticket TIK authorizes an agent of type AGENTTYPE to participate in
some situation. For example, (#$ticketHolderType Ticket003
#$HumanAdult) means that Ticket003 authorizes an Adult to participate
in some situation. The situation or situation type may be specified
via #$ticketFor or #$ticketForSitType.")
(comment allocationPortions "An assertion of the form (#$allocationPortions WHOLE PART) is used to express a whole-part relation between two instances of #$ResourceAllocationSpecification.  Specifically, the instance of #$ResourceAllocationSpecification WHOLE has the other instance of #$ResourceAllocationSpecification PART as a part.   So, PART represents a portion of the total amount of resources represented by WHOLE.  An alternative relationship between two instances of #$ResourceAllocationSpecification is #$derivedAllocations which represents how one #$ResourceAllocationSpecification makes uses up a portion of an #$ResourceAllocationSpecification.  Let's say that I have two savings accounts the contents of which will go to help me buy a new house.  The money in those two accounts bear the relation #$allocationPortions to the whole #$ResourceAllocationSpecification which is dedicated to that task.  However, I may set aside particular chunks of the whole #$ResourceAllocationSpecification for certain purposes (i.e., paying bank fees), that relationship would be #$derivedAllocations.")
(comment hasTotalAllotment "An assertion of the form (#$hasTotalAllotment PURPOSE ALLOTMENT) is used to relate an instance of #$NormativeSpecification PURPOSE to the instance of #$Allotment that represents the total of resources that are being dedicated to PURPOSE.  Alternatively, one can think of this as the sum of resources that are specifically and directly alotted for the purpose.  This may be divided into smaller allotments (see #$allocationPortions) for purposes that are subordinate to the main purpose.  Thus, a vacation may have a total budget, and distinct portions of that budget can be devoted to buying tickets, buying meals, etc.")
(comment TotalRequestForFn "A #$UnaryFunction and #$IndividualDenotingFunction, #$TotalRequestForFn is used to represent the total amount of resources which have been requested for some purpose.  Thus, the result is not the actual #$Allotment (#$TotalAllotmentForFn (q.v.)) but an allotment which has been proposed and is under evaluation.")
(comment allotmentReservesQuantityOfIndForInterval "An assertion of the form (#$allotmentReservesQuantityOfIndForInterval ALLOT QUANT INDIVIDUAL INTERVAL) states that the #$Allotment represents a reservation of the #$Quantity QUANT, that is a 'part' of the #$Individual INDIVIDUAL, during the #$TimeInterval INTERVAL.  This predicate assumes that for any set of values for ALLOT, INDIVIDUAL, and INTERVAL, there can be at most one value of QUANT.   Further, every individual assertion using this predicate in a given context is assumed to represent a different reservation.  Therefore, for the same ALLOT and INDIVIDUAL, even if there are two assertions where the #$TimeInterval of one bears the relation #$temporalBoundsContain to the #$TimeInterval of the second assertion, then ALLOT is assumed to have reserved the sum of those two quantities. This is a core predicate for describing what an #$Allotment reserves.  The amount that ALLOT reserves of INDIVIDUAL can also be represented using the #$allotmentReservesPercentageOfIndForInterval (q.v.).")
(comment allotableForInterval "An assertion of the form (#$allotableForInterval IND INTERVAL) states that the #$Individual IND can legitimately be reserved during the #$TimeInterval INTERVAL.")
(comment allotmentWhollyReservesIndForInterval "An assertion of the form (#$allotmentWhollyReservesIndForInterval ALLOT INDIVIDUAL INTERVAL) is used to relate an instance of #$Allotment to an #$Individual and a #$TimeInterval.  This refers to the particular interval which is being reserved and has the implication that there cannot be another #$Allotment that lays some claim to INDIVIDUAL during INTERVAL.")
(comment allotmentReservesPercentageOfIndForInterval "An assertion of the form (#$allotmentReservesPercentageOfIndForInterval ALLOT PERCENT INDIVIDUAL INTERVAL) states that the #$Allotment ALLOT represents a reservation of PERCENT percent of the #$Individual INDIVIDUAL's time during the #$TimeInterval INTERVAL. Every individual assertion using this predicate in a given context is assumed to represent a different reservation.  Therefore, for the same ALLOT and INDIVIDUAL, even if there are two assertions where the #$TimeInterval of one bears the relation #$temporalBoundsContain to the #$TimeInterval of the second assertion, then ALLOT is assumed to have reserved the sum of the two reserved portions. This is a core predicate for describing what an #$Allotment reserves, see also #$allotmentReservesPercentageOfIndForInterval. This predicate assumes that for any set of values for ALLOT, INDIVIDUAL, and INTERVAL, there can be at most one value of PERCENT.")
(comment availableQuantityForInterval "An assertion of the form (#$availableQuantityForInterval THING QUANTITY INTERVAL) states that the 'portion' of the #$Individual THING that could be reserved during the #$TimeInterval has the #$Quantity QUANTITY.")
(comment hasTotalRequest "This is corresponding predicate of the function #$TotalRequestForFn.")
(comment specificationDescription "An assertion of the form (#$specificationDescription SPEC STRING) is used to relate an instance of #$NormativeSpecification to a #$SubLString which provides a natural-language description of the content of that #$NormativeSpecification.")
(comment Project-NormativeSpecification "A #$FirstOrderCollection and sub-collection of #$NormativeSpecification, #$Project-NormativeSpecification is a collection of abstract entities which represent a pre-conceived course of action by some set of #$IntelligentAgents.  This does not refer to the actual events involved with 'carrying out the the project,' instead it is a cognitive object which guides or assists the agents in preparing for, executing, and evaluating a series of actions.")
(comment sufficientForAvoidance "An assertion of the form (#$sufficientForAvoidance MOTIVE1 MOTIVE2) states that the #$Motivation MOTIVE1 has been adopted by some #$IntelligentAgent because its specification is perceived to be sufficient to prevent the specification of #$AvoidanceMotivation MOTIVE2 from coming about.  As an example, given an #$AvoidanceMotivation to prevent a  murderer from killing again (M2), an agent's adopting the motivation to execute that killer (M1) would make the assertion (#$sufficientForAvoidance M1 M2) hold.  This predicate is neutral on whether the specification of MOTIVE1 is necessary to bring about the specification of MOTIVE2, see #$necessaryForAvoidance for a predicate with that meaning.")
(comment derivativeSpecificationOf "An assertion of the form (#$derivativeSpecificationOf SPEC1 SPEC2) states that the #$NormativeSpecification SPEC1 has been adopted by some #$IntelligentAgent because of some perceived causal connection to the specification of #$NormativeSpecification SPEC2.  This is a very general relation for representing the creation of a #$NormativeSpecification based on the existence of a previous #$NormativeSpecification.  In particular, it is neutral on whether the specification of SPEC1 is understood to increase or decrease the likelihood of the specification of SPEC2 coming about.  The more specialized predicate #$adoptedToHelpAchieve and #$adoptedToHelpAvoid and their specializations introduce such causal distinctions. Further, this predicate and its specializations should be differentiated from #$subSpecification (q.v.) which relates #$NormativeSpecifications for the purposes of dividing the content of a whole into separate pieces.  So, whereas #$subSpecification would focus on relating #$NormativeSpecifications that collectively amount to the specification of the #$NormativeSpecification of which they are parts, #$derivativeSpecificationOf focuses instead on one the specification of one #$NormativeSpecification 'setting the stage' for being able to fulfill a #$NormativeSpecification.")
(comment necessaryForAchieving "An assertion of the form (#$necessaryForAchieving MOTIVE1 MOTIVE2) states that the #$Motivation MOTIVE1 has been adopted by some #$IntelligentAgent because its specification is perceived to meet a necessary condition for bringing about the specification of #$AchievementMotivation MOTIVE2.  So, an agent could have the #$AchievementMotivation M2 of winning the lottery, because this requires possessing (in some way) a ticket in that lottery, that agent could form a second motivation to possess a lottery ticket (M1).  In such a situation, the assertion (#$necessaryForAchieving M1 M2) would hold.  This predicate is neutral on whether the specification of MOTIVE1 is sufficient to bring about the specification of MOTIVE2, see #$sufficientToAchieve for a predicate with that meaning.")
(comment normativeSpecificationParts "An assertion of the form (#$normativeSpecificationParts WHOLE PART) is used to relate an instance of #$NormativeSpecification WHOLE to an instance of #$NormativeSpecification PART where the relationship is a whole to part relationship.  This is a distinct relationship from #$derivativeSpecificationOf, in that PART refers directly to the content of WHOLE, whereas a derivative specification is indirectly related to the second specification.  For example, consider the project of killing two people, where that project is carried out for the purposes of winning an inheritance.  The specification to kill both people is derived from the specification of winning the inheritance.  However, if I have two separate plans for killing the people, each plan is part of the larger specification.  #$normativeSpecificationParts is used when completing one of the part-specifications partially realizes the state of affairs which is the content of the whole-specification. #$derivativeSpecificationOf is used when the content of the derived #$NormativeSpecification sets the stage for realizing the content of the more fundamental #$NormativeSpecification  More formally, #$normativeSpecificationParts is used to relate an logical entailment relation of the content of the part-motive by the content of the whole-specification. The contents of the source-specification and derived-specifications are related by knowledge that realizing the content of the derived-specification has causal implications for the realization of the content of the source-specification.")
(comment performanceOfWorkOccursAt "This predicate relates a #$ConceptualWork with some #$Place
where a performance of that work occurs. (#$performanceOfWorkOccursAt
WORK PLACE) is true iff there exists some PERFORMANCE such that
(#$performanceOfWork PERFORMANCE WORK) and (#$eventOccursAt PERFORMANCE
PLACE).")
(comment ManufacturerTypeByFocalProductType "A collection that facets #$ManufacturingOrganization.  Instances are collections of manufacturing organizations whose instances manufacture a common product-type.  (See #$makesProductType.)")
(comment SpecificationOfProjectEventFn "A #$UnaryFunction and #$IndividualDenotingFunction, #$SpecificationOfProjectEventFn is used to convert between two senses of the term 'project.'  An expression of the form (#$SpecificationOfProjectEventFn PROJ-EVENT) denotes an instance of #$Project-NormativeSpecification.  The denoted individual is the specification that guides the behavior of at least some of the agent's who are actors in PROJ-EVENT, which is an instance of #$Project, a sub-collection of #$Event.  So, if succeed in fulfilling (#$SpecificationOfProjectEventFn PROJ-EVENT), then PROJ-EVENT will have the properties described by (#$SpecificationOfProjectEventFn PROJ-EVENT).")
(comment correspondingSpecificationOfProject "This is the corresponding predicate of the function #$SpecificationOfProjectEventFn.")
(comment assignmentOfTask "This is the corresponding predicate of the function #$AssignmentOfTaskFn.")
(comment assignmentTotalAllotment "An assertion of the form (#$assignmentTotalAllotment ASSIGNMENT ALLOTMENT) relates an instance of #$Assignment-Specification to the instance of #$Allotment ALLOTMENT which represents the total resources which have been reserved for the purpose of completing ASSIGNMENT. This is a more specialized form of the predicate #$hasTotalAllotment.")
(comment nonAssertibleTerm "A #$MetaPredicate for stating a certain restriction regarding the use of a given term in assertions to the Cyc Knowledge Base.  (#$nonAssertibleTerm TERM) means that a certain class of ground atomic formulas (or \"GAFs\"; see #$CycLClosedAtomicSentence) containing this term should not be asserted into the KB.  This condition is hard to precisely define, but the idea is that the term can appear in GAFs that say things about TERM -- that TERM is an instance of certain collections or believed by some cyclist to be someone's favorite term.  But, there is a certain class of assertions in which it should never appear.  For instance #$sentenceTruth is a #$nonAssertibleTerm in that it can't appear in arg0 of GAFs, but, of course, it can appear in arg1 of (#$notAssertible #$sentenceTruth).  #$ELRelation should have no direct instances, so (#$notAssertibleCollection #$ELRelation) holds.  But, of course, that term can appear in other GAFs (#$genls assertions for example).  #$AnytimePSC should not appear as the time dimension in any assertion in the KB.  But, it can appear in asserted GAFs where it does not appear in some argument position of an #$MtSpace NAUT.  This is basically a documentation predicate.  See the two specializations of this predicate, #$notAssertible and #$notAssertibleCollection, which constrain predicates and collections, respectively and which can be given precise definitions.")
(disjointWith Virgin SexuallyExperienced)
(comment projectAssignments "The predicate #$projectAssignments is a specialization of #$normativeSpecificationParts and is used to relate and instance of a #$Project-NormativeSpecification to an instance of an #$Assignment-Specification.  An assertion of the form (#$projectAssignments PROJECT ASSIGNMENT) states that the fulfillment of ASSIGNMENT represents one step in the completion PROJECT.")
(comment objectExtorted "A specialization of #$objectOfPossessionTransfer (q.v.) that applies to #$Extortion (q.v.) events in which either money or some other kind of object is extorted.  <code>(#$objectExtorted EXTORTION OBJECT)</code> means that in the course of <code>EXTORTION</code>, the perpetrator coerces the victim to turn over control of <code>OBJECT</code> by threatening him or her with harm.  Typically, <code>OBJECT</code> will be a sum of money or other #$TenderObject, in which case the predicate #$objectTendered also applies.
<p>
Note that, while in every instance of #$Extortion <i>something</i> is extorted from the victim, it is possible for an extortion to involve <i>no #$objectExtorted</i>; for what is extorted might instead be an <i>action</i> performed by the victim.")
(comment potentialRolePlayerTypeInSituationType "A #$QueryDedicatedPredicate used for querying for all the roles that instances of a given actortype can play in instances of a certain situation type.")
(comment doesntDislike-SitType "(#$doesntDislike-SitType AGENT SITTYPE) means that, in general, AGENT doesn't dislike instances of SITTYPE.  Agent could have a positive attitude towards SITTYPE -- (#$favors-SitType AGENT SITTYPE) could hold. Or, AGENT could simply be neutral towards SITTYPE.  ")
(comment MilitaryWeaponType "A specialization of 
#$WeaponType.  Instances of this collection are collections of
#$Weapons used primarily by the military.  Notable instances of this
collection include #$SilkwormMissile, #$NuclearWeapon, and
#$Mine-Weapon.")
(comment comparableScalars "An instance of both #$ComparisonPredicate and #$EquivalenceRelation (qq.v.), and a generalization of #$numericallyComparable, #$colinearQuantities, and #$quantityIntersects (qq.v.).  #$comparableScalars is the most general comparison predicate for #$ScalarIntervals.  <code> (#$comparableScalars SCALAR1 SCALAR2)</code> means that <code>SCALAR1</code> and <code>SCALAR2</code> can be compared in terms of their relative magnitudes.  Thus they either (i) can be compared numerically, via (e.g.) #$greaterThanOrEqualTo, (ii) they have positions on the same scale (see #$CollectionWithAnEventLikeOrder) that can be compared via (e.g.) #$followingValue, or (iii) they intersect or overlap each other in such a way that their respective minimums and maximums (see #$minQuantValue and #$maxQuantValue) can be compared numerically.")
(comment ResourceRequest "A specialization of #$ResourceAllocationSpecification, the #$FirstOrderCollection #$ResourceRequest refers to a request for the designation of some #$Quantity (of time, money, or material) for the purpose of bringing about the realization of some #$NormativeSpecification.  This is a very general collection aimed at representing any type of request for resources.  This should be contrasted with #$Allotment where individuals who have authority over the use of some resources dictate how they will be used for the purposes of bringing about the realization of some #$NormativeSpecification.")
(comment requestReservesQuantityOfIndForInterval "An assertion of the form (#$requestReservesQuantityOfIndForInterval REQUEST QUANT INDIVIDUAL INTERVAL) states that the #ResourceRequest represents a request to reserve the #$Quantity QUANT, that is a 'part' of the #$Individual INDIVIDUAL, during the #$TimeInterval INTERVAL.  This is a core predicate for describing what an #$Allotment reserves.  The amount that ALLOT reserves of INDIVIDUAL can also be represented using the #$requestReservesPercentageOfIndForInterval (q.v.).")
(comment numericallyComparable "An #$EquivalenceRelation (q.v.) and the most general #$NumericComparisonPredicate (q.v.).   #$numericallyComparable relates any two #$ScalarIntervals that can be compared in terms of less than, equal to, or greater than.  <code>(#$numericallyComparable SCALAR1 SCALAR2)</code> means that one of <code>SCALAR1</code> and <code>SCALAR2</code> is #$greaterThanOrEqualTo the other.  <code>SCALAR1</code> and <code>SCALAR2</code> must either both be #$NumericIntervals (q.v.) or both be #$MeasurableQuantity(ies); in the latter case they must also both be measurable in the same units (see #$UnitOfMeasure and #$interconvertibleUnits).
<p>
For example,  (#$numericallyComparable 5 500) and (#$numericallyComparable (#$Meter 1) (#$Mile 7)); but 5 and (#$Meter 1) are <i>not</i> numerically comparable.")
(comment SubmachineGun-Thompson "A specialization of #$SubmachineGun.  Each instance of #$SubmachineGun-Thompson is a submachine gun of the sort designed during #$WorldWarI by General John T. Thompson.  Often called the \"Tommy gun\", Thompson submachine guns were used by gansters in the early 1930's, and were used by the U.S. Army through #$WorldWarII.")
(comment SubmachineGun-HecklerUndKochMP5 "A specialization of #$SubmachineGun.  Each instance of #$SubmachineGun-HecklerUndKochMP5 is a submachine gun of the sort developed by German weapons designer Heckler und Koch in the 1960s.  The MP5 eventually became one of the most widely used submachine guns in the world.")
(comment inputsDestroyed-TypeType "A type-level version of #$inputsDestroyed.    (#$inputsDestroyed-TypeType EVENT-TYPE TYPE) means that in every instance of EVENT-TYPE some instance of TYPE plays an #$inputsDestroyed role.")
(comment DayOfWeekTypeForDateFn "This function takes an instance of #$Date and returns the
#$DayOfWeekType, if any, on which the date falls. The input date must
be at least a #$CalendarDay, so for instance, (#$DayOfWeekTypeForDateFn
(#$MonthFn #$June (#$YearFn 2004))) obviously has no denotatum, whereas 
(#$DayOfWeekTypeForDateFn (#$DayFn 1 (#$MonthFn #$June (#$YearFn 2004)))) 
evaluates to #$Tuesday, as does (#$DayOfWeekTypeForDateFn (#$HourFn 12
(#$DayFn 1 (#$MonthFn #$June (#$YearFn 2004))))).")
(comment Plotting "A specialization of #$MakingAPlan (q.v.).  Each instance of #$Plotting is an event in which some #$IntelligentAgent (or group of such agents) secretly makes a plan to do something that is illegal or nefarious.")
(comment OnlineNewsArticle "The collection of news articles published on a website. Examples would be articles found at cnn.com or usatoday.com.")
(comment MaterialSupport "Assitance to an agent such as financial contributions; services; or goods. Current legal definitions generally include currency or other financial securities, financial services, lodging, training, safe houses, false documentation or identification, communications equipment, facilities, weapons, lethal substances, explosives, personnel, transportation, and other physical assests, with the exception of medicine or religious materials.")
(comment DefenseDepartment "#$DefenseDepartment is a specialization of #$ExecutiveGovernmentalOrganization.  Instances of #$DefenseDepartment are organizations which typically have responsibility over their nation's military.  They also develop defense stategies for actual or potential wars.")
(comment OfficerInOrganization "The collection of all officers of any organization.  An officer is someone who is entrusted with an office, or recognized position of authority within an organization.")
(comment DefiniteExpression-Pronominal " Instances of this collection are #$LinguisticExpressionPegs which are marked as definite and are pronominal.")
(comment suspectedOfType "A #$BinaryPredicate.  Where <code>AGT</code> is a #$LegalAgent and <code>ACT-TYPE</code> is a specialization of #$PurposefulAction, <code>(#$suspectedOfType AGT ACT-TYPE)</code> means that some relevant authority, e.g. a #$LawEnforcementOrganization, suspects that <code>AGT</code> has committed at least one instance of <code>ACT-TYPE</code>.  (What counts as a \"relevant authority\" is of course context-dependent.)")
(comment RolePredicateAgnosticTowardsPresentTenseTimeIndex "An instance of #$BinaryRolePredicate is an instance of this collection just in case you cannot infer the time index of its corresponding (not necessarily reified) present tense progressive predicate from the temporal extent of the situation in arg1 of the predicate or the predicate is not the sort that is likely to have a non-davidsonian version.
<p>
Note:  One should use the binary tag #$roleWithEventTypeAgnosticWRTTimeIndex
when a role predicate only has this feature relative to a particular class of situations.  Making the predicate an instance of this collection entails that
it can never be the case we are justified in inferring the time index with respect to any situation that satisfied the argument constraints of the predicate.  For instance,
<p>
(#$roleWithEventTypeAgnosticWRTTimeIndex #$assistingAgent #$EntertainmentEvent)
<p>
holds because someone can be the assisting agent before or after the entertainment event.  But, the stronger
<p>
(#$isa #$assistingAgent #$RolePredicateAgnosticTowardsPresentTenseTimeIndex)
doesn't necessarily hold because there could be some specialization of #$Event that is such that agents can only assist in the event during the event.
<p>
.")
(comment DefiniteExpression-DefiniteDescription " Instances of this collection are #$NominalExpressionPegs which are marked as definite and are descriptions.")
(comment ChemicalWeaponsTesting "The collection of all instances of #$WeaponsTesting in which the weapon   being tested is an instance of #$ChemicalWeapon.")
(comment typicalColorOfType "An instance of #$BinaryPredicate.  <code>(#$typicalColorOfType COL COLOR)</code> means that instances of <code>COL</code> typically have <code>COLOR</code> as their main color (#$mainColorOfObject).")
(comment GreenBeeMissile "A specialization of #$SurfaceToSurfaceMissile-Ballistic.
Each instance of this collection is a ballistic missile developed by
Taiwan.  ")
(comment rumorAbout "(#$rumorAbout THING RUMOR) means that the information
contained in RUMOR is about THING.  This is a broad conception of
'about.'.  Rumors are an opinion or talk that has no credible or
verifiable source, and thus the truth value for such statements should
be in serious question.")
(comment informedOf "(#$informedOf AGENT INFO) means that AGENT has been informed
of INFO.  If AGENT remembers INFO, then (#$knows AGENT INFO).  ")
(comment suppressConvertingComparisonLiteralsToSQL "This predicate is used to override the default behavior of
#$SKSIMultiLiteralRemovalModules with respect to converting comparison
literals headed by a #$SKSISupportedComparisonPredicate into SQL
constraints. That is, (#$suppressConvertingComparisonLiteralsToSQL PS
PRED) means that any SKSI conjuntive removal moduless which are applicable to
PS will not convert literals using PRED into their corresponding SQL constraint.")
(comment organizationGrantsFranchisesOfType "A binary predicate that relates commercial organizations to the businesses that are franchises associated with the organization. <code>(#$organizationGrantsFranchisesOfType ORGANIZATION BUSINESS-TYPE</code> means that <code>ORGANIZATION</code> engages in franchise contracts that allow individuals to run businesses of type <code>BUSINESS-TYPE</code>.")
(comment NBCWeaponsTestSite "A specialization of #$GeographicalRegion.  Each instance of
this collection is a site at which some agent conducts research and
tests of NBC weapons.")
(comment VozroshdeniyeIsland "An instance of #$Island that was the main site for
experiments with anthrax as a weapon in biological warfare.")
(comment Inch-Hg "#$Inches of #$Mercury. A #$UnitOfPressure used primarily in the United States
to describe atmospheric pressure.")
(comment BiologicalWeaponsTesting "A specialization of #$WeaponsTesting.  Each instance of this
collection is a testing of a #$BiologicalWeapon.")
(comment artifactFoundInLocation "A specialization of the predicate #$objectFoundInLocation.  (#$artifactFoundInLocation ARTIFACT LOCATION) holds just in case the artifact, ARTIFACT, is located at LOCATION.")
(comment County-Britain "The collection of traditional Welsh counties.")
(comment County-Britain "The collection of traditional British counties, of which there are 86.")
(comment County-Scotland "The collection of traditional Scottish counties.")
(comment parsedPegInterpretations "(#$parsedPegInterpretations UTTERANCE-PEG INTERPRETATION) says that INTERPRETATION is a parser-produced interpretation of the #$LinguisticExpressionPeg UTTERANCE-PEG in the context of the current dialogue.  See also #$pegInterpretationIsOutputOfParse.")
(comment clarifiedPegInterpretations "(#$clarifiedPegInterpretations UTTERANCE-PEG INTERPRETATION) says that INTERPRETATION is an interpretation of the #$LinguisticExpressionPeg UTTERANCE-PEG that has arisen as the result of clarification dialogue.  See also #$pegInterpretationIsOutputOfClarification.")
(comment pegInterpretationIsOutputOfParse "(#$pegInterpretationIsOutputOfParse UTTERANCE-PEG INTERPRETATION EVENT) says that INTERPRETATION is an interpretation of the #$LinguisticExpressionPeg UTTERANCE-PEG that is the output of the parsing event EVENT.  See also #$parsedPegInterpretations.")
(comment pegInterpretationIsOutputOfClarification "(#$pegInterpretationIsOutputOfClarification UTTERANCE-PEG INTERPRETATION EVENT) says that INTERPRETATION is an interpretation of the #$LinguisticExpressionPeg UTTERANCE-PEG that is the output of the clarification event EVENT (c.f., #$ClarificationDialogue).  See also #$parsedPegInterpretations.")
(comment postureOfAnimalTypeDuringRoleInSituationType "<code>(#$postureOfAnimalTypeDuringRoleInSituationType ANIMAL-TYPE SIT-TYPE ROLE POSTURE)</code> means that during instances of <code>SIT-TYPE</code> in which instances of <code>ANIMAL-TYPE</code> play <code>ROLE</code>,  those animals adopt the posture <code>POSTURE</code>.")
(comment AbductingSomeone "A collection of events and a specialization of #$TakingAPersonPrisoner.  In each instance of #$AbductingSomeone, a #$Person is taken captive, moved somewhere, and held by another (or group of others).
<p>
Abductions are usually done illegally; see the specialization #$KidnappingSomeone. But note that this need not be the case.  For example, in certain circumstances a government agent might legally abduct a person for questioning; a parent might legally abduct a minor from the grounds of a religious cult; some people claim to have been abducted by aliens.
<p>
Note also that, while an abduction is typically done against the victim's will, this might not be the case if s/he is (say) unconscious, extremely ill, mentally disturbed, or very young.")
(comment TuningAMusicalInstrument "A #$FirstOrderCollection.  Each instance of #$TuningAMusicalInstrument is an event in which an agent adjusts the pitch(es) produced by a #$MusicalInstrument, usually as a preparation for #$PlayingAMusicalInstrument.")
(comment nonAbducibleRule "#$nonAbducibleRule is a unary predicate used to indicate which rules should never be used in abductive inference.  <code>(#$nonAbducibleRule RULE-ASSERTION)</code> means that the antecedent literals of the rule <code>RULE-ASSERTION</code> should not be abduced (they should not be supposed true, and terms should not be abduced just as bindings for their variables).")
(comment epistemicRule "#$epistemicRule is a specialization of #$nonAbducibleRule (q.v.).  It is used to indicate that a rule's antecendent states merely epistemic (not physical or metaphysical) and hence non-explanatory sufficient conditions for the truth of its consequent.  For example,
<p>
<pre>
  (#$epistemicRule
    (#$implies
      (#$and
        (#$isa ?EVENT #$SchedulingASocialDinnerAtRestaurant)
        (#$performedBy ?EVENT ?USER)
        (#$socialParticipants ?EVENT ?INVITEE))
      (#$likesAsFriend ?USER ?INVITEE)))
</pre>
<p>
means that the fact that one person successfully invites another to a social dinner at a restaurant provides a good reason to believe that the inviter likes the invitee as a friend, but it does not explain the fact that the two people are friends.")
(comment ClarificationDialogue "The collection of all instances of #$MultiDirectionalCommunication in which one or more participants (c.f., #$communicationParticipants), believing himself or herself (or itself) to be in a state of incomplete information, requests additional information that will resolve this state of incompleteness, and receives back information that, from the point of view of the \"clarifiee,\" should either be sufficient for resolving that incomplete state, or otherwise drive the dialogue in a direction where this state will be resolved.   An instance of #$ClarificationDialogue will often decompose (c.f., #$subEvents) into several iterations of instances of #$ClarificationDialogue.")
(comment communicatorOfInfo "(#$communicatorOfInfo COMMUNICATION AGENT) says that AGENT communicates information during the course of the instance of #$Communicating, COMMUNICATION.  This means that there exists at least one sub-event (c.f., #$subEvents) SUB-EVENT of COMMUNICATION that is an instance of #$InformationTransferPhysicalEvent in which AGENT plays the #$senderOfInfo role.")
(comment infoCommunicatedTo "(#$infoCommunicatedTo COMMUNICATION AGENT) says that AGENT receives information communicated during COMMUNICATION, an instance of #$Communicating.  This means that there exists a sub-event (c.f., #$subEvents) SUB-EVENT of COMMUNICATION that is an instance of #$InformationTransferPhysicalEvent, in which AGENT plays the #$recipientOfInfo role.")
(comment StripMall "A specialization of #$ShoppingMallBuilding.  Each instance of #$StripMall is a shopping mall with all exterior entrances to its retail stores and service outlets, and no interior hallways.")
(comment IndoorShoppingMall "A specialization of #$ShoppingMallBuilding.  Each instance of #$IndoorShoppingMall is a mall with some exterior entrances to either its halways or to some of its retail space, but with most entrances to retail space from the hallways of the building.")
(disjointWith IndoorShoppingMall StripMall)
(comment trueQuery "(#$trueQuery QUERY) is true iff the QUERY is true.")
(comment PoliceStation "A specialization of #$PoliceFacility.  Each instance of #$PoliceStation is a building that serves as a quarters of a #$PoliceOrganization, and is where one or (usually) more #$PoliceOfficer-Municipals work out of.")
(comment PoliceCar "A specialization of #$Automobile and #$EmergencyVehicle.  Each instance of this collection is an automobile designed to be used by an instance of #$LocalPoliceOrganization.")
(comment StretchLimousine "A specialization of #$Limousine.  Each instance of #$StretchLimousine is a limousine that has been lenghened to add room for additional seating or for some additional luxury items.")
(comment objectActedOn-TypeType "A type-level version of #$objectActedOn.    (#$objectActedOn-TypeType EVENT-TYPE TYPE) means that in every instance of EVENT-TYPE some instance of TYPE plays an #$objectActedOn role.")
(comment Whey "A specialization of #$DairyProduct.  Each instance of #$Whey is some amount of the watery liquid that separates from the solid part of milk when it turns sour or when enzymes are added in cheesemaking.")
(comment Curd "A specialization of #$DairyProduct.  Each instance of #$Curd  is some amount of the the solid substance which forms when milk turns sour or when enzymes are added in cheesemaking.")
(disjointWith Whey Curd)
(comment Tofu "A specialization of #$SolidFoodArtifact.  Each instance is some amount of tofu, which is a semisolid substance with little flavour made from soybeans.")
(comment Taco "A specialization of #$SolidFoodArtifact and #$Food-ReadyToEat.  Each instance of #$Taco is a hard, folded and stuffed tortilla.")
(comment SoyMilk "A specialization of #$Drink.  Each instance of #$SoyMilk is some amount of the whitish liquid made from soy beans which is sometimes used instead of milk.")
(comment Enchilada "A kind of #$MexicanCuisine.  Each instance of #$Enchilada consists of a flour tortilla wrapped around a filling which is typically beef, chicken, or beans, perhaps with with tomatoes, cheese, or guacamole, fried and covered with a spicy sauce.")
(comment derivedAllocations "An assertion of the form (#$derivedAllocations WHOLE PART) is used to express a kind of whole-part relation between two instances of #$ResourceAllocationSpecification.  Specifically, the instance of #$ResourceAllocationSpecification  WHOLE has the other instance of Allotment PART as a part. So, PART represents a portion of the total amount of resources represented by WHOLE. However, this is not a consitutive part-whole relation. Such an assertion is used to express the fact that the #$ResourceAllocationSpecification  PART is subject to the overall constraint imposed by the #$ResourceAllocationSpecification WHOLE.  An #$ResourceAllocationSpecification represents the reservation of some resources for some purpose.  If that purpose itself involves other sub-projects, those sub-projects will require an additional reservation of resources, most likely with the constraint that they cannot extend beyond the resources reserved for the larger purpose. So, the budget for meals during a vacation is constrained by the total budget for the vacation. This predicate is used to represent that dependency of one #$ResourceAllocationSpecification by another.  An alternative relationship between two instances of #$ResourceAllocationSpecification is #$allocationPortions which represents how one #$ResourceAllocationSpecification constitute a part of an #$ResourceAllocationSpecification.  Let's say that I have two savings accounts the contents of which will go to help me buy a new house. The money in those two accounts bear the relation #$allocationPortions to the whole #$ResourceAllocationSpecification which is dedicated to that task. However, I may set aside particular chunks of the whole #$ResourceAllocationSpecification for certain purposes (i.e., paying bank fees), that relationship between those chunks and the whole #$ResourceAllocationSpecification (since those chunks are themselves #$ResourceAllocationSpecification) would be #$derivedAllocations.")
(comment interconvertibleUnits "An #$EquivalenceRelation that holds between #$UnitOfMeasures (q.v.) that are interconvertible.  <code>(#$interconvertibleUnits UNIT1 UNIT2)</code> means that any #$Quantity (q.v.) measured by <code>UNIT1</code> can also be measured in <code>UNIT2</code> (and vice versa), and there is some constant multiplication factor <code>CONV</code> for converting any <code>UNIT1</code> measurement into an equivalent <code>UNIT2</code> measurement (see #$unitMultiplicationFactor).  That is, for any number (or other #$NumericInterval, or pair of such intervals) <code>NUM</code>, the following holds:
<p>
    <code>(#$equals (#$TimesFn (UNIT1 NUM) CONV) (UNIT2 NUM))</code> .
<p>
For example, #$Meter and #$Inch are interconvertible units since they both measure #$Distances: any measurement given in meters can be converted into a measurement given in inches, and vice versa.  Conversely, neither of those units are interconvertible with #$Kilogram, which is a measure of #$Mass rather than distance.
<p>
Units-of-measure are interconvertible if and only if they are both instances of the same #$InterconvertibleUnitType (q.v.).  Also see #$numericallyComparable.")
(comment UechiRyuActivity "A specializaition of #$KarateActivity.  #$UechiRyuActivity  is the collection of activities consisting of a #$Person practicing, performing, or using Uechi Ryu karate, a style of karate developed on #$Okinawa-Island.")
(comment ProvideSubPartsExpansions-IRExpansionStrategy "An instance of #$IRExpansionStrategy.  This is a strategy for providing expansions for a concept based on information about that concept parts (or the parts of its instances, in cases where that concept is a collection).  For example, if an IR system requests expansions for a company, important subdivisions of that company, or its chief executives, might be included as part of this strategy.")
(comment ProvideSuperPartsExpansions-IRExpansionStrategy "An instance of #$IRExpansionStrategy.  This is a strategy for providing expansions for a concept based on information about what other concepts the focal concept is a part of (or, where the focal concept is a collection, what things or types of things its instances are a part of).  For example, if an IR system requests expansions for a company, the parent company of that company, of there is one, would be returned.")
(comment MajorLeagueBaseballTeam "The collection of all instances of #$BaseballTeam that make up #$MajorLeagueBaseball.")
(comment Bicycle-MultiGear "A specialization of #$Bicycle.  Each instance of #$Bicycle-MultiGear is a bicycle built with the ability to change gears.")
(comment Bicycle-10Speed "A specialization of #$Bicycle-MultiGear.  Each instance of #$Bicycle-10Speed is a bicycle built with 10 gears.")
(comment Bicycle-12Speed "A specialization of #$Bicycle-MultiGear.  Each instance of #$Bicycle-12Speed is a bicycle built with 12 gears.")
(disjointWith Bicycle-10Speed Bicycle-12Speed)
(comment MultipleDoerAction "A specialization of #$Action. Each instance of #$MultipleDoerAction is an action which must have more than one \"doer\" (see the predicate #$doneBy).  In order for a type of action (i.e., a specialization of #$Action) to be a specialization of #$MultipleDoerAction, it must be true to assert, for any instance ACT of that type of action, both (doneBy ACT X) and (doneBy ACT Y), for some X and Y that are different.  Notable specializations of #$MultipleDoerAction include #$TeamSportsCompetition and #$MeetingSomeone.")
(disjointWith SingleDoerAction MultipleDoerAction)
(comment TerroristPlot "A specialization of #$TerroristAct.  Each instance of #$TerroristPlot is the plotting of some instance of #$TerroristAttack.  Some instances of #$TerroristPlot are instantiated as instances of either (#$AttemptingFn #$TerroristAttack) or #$TerroristAttack.  Some instances never make it past the \"plotting\" stage.")
(comment eventInstantiatesPlanningEvent "(#$eventInstantiatesPlanningEvent EVENT PLAN) holds just in case PLAN was an instance of #$Planning that was the planning of EVENT.")
(comment isThe "(#$isThe THE-TERM COLLECTION) means that THE-TERM is the instance of COLLECTION that is salient in the current context.")
(comment leftOrRightSideType "(#$leftOrRightSideType ?SYMMETRIC-PART-TYPE ?UNIQUE-PART-TYPE) means that ?UNIQUE-PART-TYPE is a unique subtype of ?SYMMETRIC-PART-TYPE consisting of either all the left-side or all the right-side instances.")
(comment leftSideType "(#$leftSideType ?SYMMETRIC-PART-TYPE ?UNIQUE-PART-TYPE) means that ?UNIQUE-PART-TYPE is a unique subtype of ?SYMMETRIC-PART-TYPE consisting of all the left-side instances.")
(comment LeftOrRightObject "An instance of #$ExistingObjectType.
#$LeftOrRightObject is the collection of tangible objects that are meant for, or are found on and distinctively structured for, either the left or the right side of some larger object or ensemble of parts.")
(comment rightSideType "(#$rightSideType ?SYMMETRIC-PART-TYPE ?UNIQUE-PART-TYPE) means that ?UNIQUE-PART-TYPE is a unique subtype of ?SYMMETRIC-PART-TYPE consisting of all the right-side instances.")
(comment LoyalistOrganization "A specialization of #$Organization.  Each instance of #$LoyalistOrganization is an organization that uses either legal or extra-legal means to maintain the current regime (status quo).  For example, the Ulster Defense Association in Northern Ireland, Kach and Kahane Chai in the West Bank.")
(comment RevolutionExportingOrganization "A specialization of #$Organization.  Each instance of #$RevolutionExportingOrganization is an organization that seeks to spread revolution into other countries and disrupt the international order. ")
(comment VigilanteOrganization "A specialization of #$Organization.  Each instance of #$VigilanteOrganization is an organization that imposes extra-legal order, typically in a state of anarchy, to protect its interests.   For example, the United Self-Defense Forces in Colombia.")
(comment GroupCleansingOrganization "A specialization of #$Organization.  Each instance of #$GroupCleanisngOrganization is an organization that uses either legal or extra-legal means to eliminate or push out another group because of their religious, ethnic, or class identity.")
(comment UnificationOrganization "A specialization of #$Organization.  Each instance of #$UnificationOrganization is an organization that seeks to unite region or country with another region or country.  For example, pan-Arabists, the Austrian Nazi Party before 1938, the Islamists in Kashmir, the IRA.")
(comment sourceSentence "This #$KBDependentRelation is an extension and
generalization of #$sksiSentence and #$kbSentence. (#$sourceSentence
SKS SENTENCE) means that SENTENCE is provable directly from the
contents of SKS. Here, SKS may be #$TheCurrentCycKB or another
#$StructuredKnowledgeSource accessible via SKSI.")
(comment TheCurrentCycKB "#$TheCurrentCycKB is an #$IndexicalConcept which refers to
the current state of the unique #$CycKB which is part of the currently
running #$Cyc process.")
(comment sitServesHigherSpecificationForAgents "An assertion of the form (#$sitServesHigherSpecificationForAgents SIT SPEC AGENT) is used to represent the fact that a particular #$Situation SIT indirectly increases the likelihood that the #$Agent-Generic AGENT's #$NormativeSpecification SPEC will be satisfied.  A #$NormativeSpecification describes a type of situation.  This predicate is most useful for associating a situation that bears the relation #$sitServesSpecificationForAgents to another instance of #$NormativeSpecification for AGENT, SPEC2, such that the assertion (#$derivativeSpecificationOf SPEC2 SPEC) holds.  So, let us say that Billy plans to rob a bank in order to buy a car.   The actual event of him robbing a bank would bear the relation #$sitServesHigherSpecificationForAgents to the #$NormativeSpecification of buying a car for Billy because the robbery bears the relation #$sitSatisfiesSpecificationForAgents to the #$NormativeSpecification of robbing a bank.  This predicate implies that AGENT is aware of SIT.")
(comment sitServesSpecificationForAgents "An assertion of the form (#$sitServesSpecificationForAgents SIT SPEC AGENT) is used to relate an instance of #$Situation SIT to an instance of #$NormativeSpecification and an instance of #$Agent-Generic.  Instances of #$NormativeSpecification describe types of situations that some agents want to come about, and agents can have a variety of attitudes towards a #$NormativeSpecification. The meaning of the initial assertion is that SIT helps, in a very generic sense, AGENT with regard to bringing about SPEC. As an example, consider a person who wants to be a millionaire (where we represent that desire as an instance of #$NormativeSpecification), if that person won a hundred thousand dollars in a lottery then that winning event would bear the relation #$sitServesSpecificationForAgents to that #$NormativeSpecification and that person.  AGENT need not have any awareness of SIT.")
(comment sitSatisfiesSpecificationForAgents "An assertion of the form #$sitSatisfiesSpecificationForAgents SIT SPEC AGENT) is used to represent the fact that a particular #$Situation SIT  satisfies the #$NormativeSpecification SPEC for the #$Agent-Generic AGENT.  A #$NormativeSpecification amounts to a reason for an agent to behave in a particular way.  This notion of 'satisfaction' is  generic in the sense that the requirements of #$NormativeSpecification have been met by the #$Situation SIT such that AGENT need no longer consider how to bring about events which would satisfy SPEC  For example, let us say that SPEC has the specification that AGENT goes on vacation to Mexico in May 2004, if SIT is Mexican vacation in May 2004 performed by AGENT, then SIT would bear the relation #$sitSatisfiesSpecificationForAgents to SPEC and AGENT.  This predicate implies that AGENT is aware of SIT. ")
(comment sitPartiallySatisfiesSpecificationForAgents "An assertion of the form #$sitPartiallySatisfiesSpecificationForAgents SIT SPEC AGENT) is used to represent the fact that a particular #$Situation SIT partially satisfies the #$NormativeSpecification SPEC for the #$Agent-Generic AGENT.  A #$NormativeSpecification describes a type of #$Situation that an agent has some interest in either bringing about, maintaining, or preventing,.  For example, let us say that SPEC has the specification that AGENT's business competitors COMP1 and COMP2 die, then if SIT is the death of COMP1, then SIT would bear the relation #$sitPartiallySatisfiesSpecificationForAgents to SPEC and AGENT.  More generally, this predicate serves as a way of relating an situation to a #$NormativeSpecification when the situation bears the relation #$sitSatisfiesSpecificationForAgents to some other #$NormativeSpecification to which the first #$NormativeSpecification bears the relation #$subSpecification  This predicate implies that AGENT is aware of SIT.")
(comment sitConflictsWithSpecificationForAgents "An assertion of the form (#$sitConflictsWithSpecificationForAgents SIT SPEC AGENT) is used to relate an instance of #$Situation SIT to an instance of #$NormativeSpecification and an instance of #$Agent-Generic.  Instances of #$NormativeSpecification describe some type of situation that some agent either wants to bring about or wants to avoid.  The effect of such an assertion is to state that SIT undermines or otherwise hinders, in a very generic sense, AGENT with regard to satisfying or achieving SPEC.  As an example, consider a person who wants to sell her house (where we represent that as an instance of #$NormativeSpecification). If the house burns down, then that event would bear the relation #$sitConflictsWithSpecificationForAgents to that #$NormativeSpecification and that person.  AGENT need not have any awareness of SIT.")
(comment BilateralFormOfSentence-Left "(#$BilateralFormOfSentence-Left SENTENCE) is equivalent to SENTENCE with each instance SYMMETRICAL-PART-TYPE of #$SymmetricAnatomicalPartType replaced with (#$LeftObjectOfPairFn SYMMETRICAL-PART-TYPE).")
(comment symmetryNeutralizedMt "(#$symmetryNeutralizedMt SYMMETRIC-MT NEUTRALIZED-MT) means that NEUTRALIZED-MT shares all of the assumptions of SYMMETRIC-MT -- and is thus a spec-mt of it -- except that any assertions about an instance SYMMETRICAL-PART-TYPE of #$SymmetricAnatomicalPartType in NEUTRALIZED-MT hold of the left- and right-hand versions of SYMMETRICAL-PART-TYPE in SYMMETRIC-MT.")
(comment SymmetryNeutralizedMtFn "(#$SymmetryNeutralizedMtFn SYMMETRIC-MT) denotes the microtheory NEUTRALIZED-MT such that (#$symmetryNeutralizedMt SYMMETRIC-MT NEUTRALIZED-MT).")
(comment BilateralFormOfSentence-Right "(#$BilateralFormOfSentence-Right SENTENCE) is equivalent to SENTENCE with each instance SYMMETRICAL-PART-TYPE of #$SymmetricAnatomicalPartType replaced with (#$RightObjectOfPairFn SYMMETRICAL-PART-TYPE).")
(comment tribalName "A specialization of #$nameString.  (#$tribalName AGT STRING) holds just in case STRING is a name of AGT that AGT was given as a result of certain tribal affiliations.")
(comment clarificationOutputs "(#$clarificationOutputs CLARIFICATION SENTENCE) says that SENTENCE is one of the sentences, the truth of which is established as a result of the instance of #$ClarificationDialogue CLARIFICATION.")
(comment intendsByInUtterancePegContext "(#$intendsByInUtterancePeg SPEAKER PEG INTERPRETATION UTTERANCE-PEG) says that SPEAKER, an instance of #$IntelligentAgent, in the context of the (possibly larger) instance of #$LinguisticExpressionPeg-CompleteUtterance UTTERANCE-PEG, intended to refer to INTERPRETATION when introducing the instance of #$LinguisticExpressionPeg PEG (a sub-expression of UTTERANCE-PEG -- see #$subExpressions).  So, for example, if PEG is a linguistic expression peg for \"my dog\" and UTTERANCE-PEG is a peg for \"I fed my dog some tuna,\" then (#$intendsByInUtterancePeg SPEAKER PEG Dog001 UTTERANCE-PEG) says that by introducing \"my dog\" in the context of the utterance that introduced \"I fed my dog some tuna,\" \"my dog\" was intended to refer to Dog001.  The purpose of representing UTTERANCE-PEG is to provide a larger context that might help one deduce the intended referent of PEG; contrast the Dog001 interpretation with the empty-set interpretation were UTTERANCE-PEG the peg for, \"She asked me how my dog is, not knowing that I've never owned one.\"")
(comment intendsByUtterancePeg "(#$intendsByUtterancePeg SPEAKER PEG INTERPRETATION) says that SPEAKER, an instance of #$IntelligentAgent, intended to refer to INTERPRETATION when introducing the instance of #$LinguisticExpressionPeg PEG in discourse.  For example, (#$intendsByUtterancePeg #$DaveS #$MyDog-Peg #$Bailey) says that Dave S intended to refer to his dog Bailey when he uttered \"my dog.\"  For a version of #$intendsByUtterancePeg that makes explicit some of the larger context in which the interpreted peg is introduced, see #$intendsByInUtterancePegContext.")
(comment Credibility "The collection of the different degrees of credibility that a piece of information can have.  This is usually cashed out as the degree to which the truth of the information can be confirmed by reliable sources.")
(comment CBLAskFn "A binary function that returns a #$CBLAsk command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment reliabilityOfAssertion-UnknownSource "This predicate relates a #$CycLAssertion to some instance of #$Reliability.  (#$reliabilityOfAssertion-UnknownSource ASSERTION RELIABILITY) holds just in case there exists some source of ASSERTION and that source is known to be reliable to degree RELIABILITY.  This predicate is useful for SKSI mappings of databases that assign the links in their database various degrees of \"reliability\", but don't actually specify the source.")
(comment SKSICostEstimateUpdateTask "This is the collection of #$CycTaskSchedulerTasks which are
intended to regularly update the cost estimates
(#$resultSetCardinality and #$rowCount-SKS assertions) for certain
#$StructuredKnowledgeSources.")
(comment UpdateCycorpBugzillaCostEstimates "This #$SKSICostEstimateUpdateTask regularly updates the cost
estimates for the #$CycorpBugzilla-KS database.")
(comment UpdateContentTestRepositoryCostEstimates "This #$SKSICostEstimateUpdateTask regularly updates the cost
estimates for the #$CTR-KS database.")
(comment CBLBindingSpecificationFn "A binary function that returns a #$CBLBindingSpecification and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment BinaryArgInRelnPredicate "A collection of predicates.  Each instance of #$BinaryArgInRelnPredicate is a binary predicate PRED that relates a predicate P to a positive integerINT, where the well-formedness of assertions using PRED requires that INT fall within the range of integers given by the arity (see #$arity) of P.  Knowledge that a predicate is an instance of #$BinaryArgInRelnPredicate enables Cyc to conclude the relevant well-formedness constraints.")
(comment interestingForArgInReln "An instance of #$SummaryPredicate.  (#$interestingForArgInReln N PRED) means that for any assertion ASSERTION of the form (RELN . ARGS) such that (#$genlPreds RELN PRED) and (#$assertionSentence ASSERTION SENTENCE), (#$interestingSentence THING SENTENCE) will be true for the Nth argument of SENTENCE.  For example, if (#$interestingForArgInReln 1 #$affiliatedWith) is true, then (#$interestingSentence #$BillClinton (#$headOfStateOf #$BillClinton #$UnitedStatesOfAmerica)) holds, since #$BillClinton is the arg 1 of the (#$headOfStateOf #$BillClinton #$UnitedStatesOfAmerica), that sentence is asserted in the KB, and (#$genlPreds #$headOfStateOf #$affiliatedWith).")
(comment sentenceIsTrue "(#$sentenceIsTrue SENTENCE) means that a reviewer who looked at the #$CycLPropositionalSentence SENTENCE felt that the information content of the sentence is #$True.")
(comment sentenceIsFalse "(#$sentenceIsFalse SENTENCE) means that a reviewer who looked at the #$CycLPropositionalSentence SENTENCE felt that the information content of the sentence is (subjectively) #$False.")
(comment ScalarExponentFn "A #$MathematicalFunctionOnScalars that is effectively the arithmetical operation of taking a number to a specified power (see #$ExponentFn), extended to all (measurable) #$ScalarIntervals.  <code>(#$ScalarExponentFn SCALAR EXP)</code> is <code>SCALAR^EXP</code>, i.e. <code>SCALAR</code> to the power <code>EXP</code>.  If <code>SCALAR</code> is a #$RealNumber, <code>SCALAR^EXP</code> is equal to <code>(#$ExponentFn SCALAR EXP)</code>.  If <code>SCALAR</code> is a #$MeasurableQuantity (q.v.), then <code>SCALAR^EXP</code> is also a measurable-quantity, and of a different \"dimensionality\" than <code>SCALAR</code> (see e.g. #$MultiDimensionalQuantity).  More specifically, if <code>SCALAR = (UNIT NUM)</code>, for some #$UnitOfMeasure <code>UNIT</code> and #$NumericInterval <code>NUM</code>, and <code>EXP</code> is a #$PositiveInteger, then <code>SCALAR^EXP = ((UNIT^EXP) (#$ExponentFn NUM EXP))</code>, where <code>(UNIT^EXP)</code> is the result of \"multiplying\" (via #$UnitProductFn) <code>UNIT</code> by itself <code>EXP</code>-1 times.
<p>
For example, (#$ScalarExponentFn (#$Meter 5) 2) is equal to
<p>
<pre>
  ((#$UnitProductFn #$Meter #$Meter) (#$ExponentFn 5 2)) ,
</pre>
<p>
which is equal to (#$SquareMeter 25).  And (#$ScalarExponentFn (#$Inch 5) 3) is equal to (#$CubicInch 125).")
(comment CBLCallSubLFn "A binary function that returns a #$CBLCallSubL command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment edibleStuffTypesCommonlyServedTogether "A #$SymmetricBinaryPredicate.  Where <code>ESTYPE1</code> and <code>ESTYPE2</code> are both specializations of #$EdibleStuff, <code>(#$edibleStuffTypesCommonlyServedTogether ESTYPE1 ESTYPE2)</code> means that instances of <code>ESTYPE1</code> are commonly served with instances of <code>ESTYPE2</code>.  This relation does not hold between edible stuff types when one is an ingredient in the other; for example, it is not the case that (#$edibleStuffTypesCommonlyServedTogether #$SpaghettiMarinara #$SpaghettiNoodle).")
(comment PoliceAction "A specialization of #$MilitaryConflictEvent and #$ViolentAction. Each instance of #$PoliceAction is a relatively localized military action that is undertaken without formal declaration of war by the regular armed forces of a country against violators of international peace or order.")
(disjointWith War PoliceAction)
(disjointWith WagingAColdWar PoliceAction)
(comment typeExecutesStrategy "The #$functionCorrespondingPredicate-Canonical of #$ExecutingStrategyFn. (#$typeExecutesStrategy EXECUTION-TYPE STRATEGY) identifies STRATEGY as the instance of #$Strategy that is executed in every instance of EXECUTION-TYPE.")
(comment ExecutingAStrategy "A specialization of #$PurposefulAction.  Instances are actions that instantiate some instance of #$Strategy.  That is, every instance of #$ExecutingAStrategy is an action that, in accordance with the intentions of the performer (c.f., #$performedBy), involves the execution of each step in some strategy, or plan, in the temporal order dictated in that plan.")
(comment AdheringToANormativeSpecification "A specialization of #$PurposefulAction.  Instances are actions that are intentionally performed in accordance with the guidelines set forth in some instance of #$NormativeSpecification.")
(comment ExecutingStrategyFn "(#$ExecutingStrategyFn STRATEGY) denotes the collection of all instance of #$ExecutingAStrategy in which the #$specificationAdheredTo is STRATEGY, an instance of #$Strategy.")
(comment individualPlaysRoleInSubSituationType "An assertion of the form (individualPlaysRoleInSubSituationType SUPER-TYPE IND SUB-TYPE ROLE) means that if SUPER is an instance of SUPER-TYPE, a type of #$Situation, and SUB is both an instance of SUB-TYPE, a type of #$Situation, and a #$subSituations of SUPER, then IND, an instance of #$SomethingExisting, will be playing ROLE, a #$BinarySituationPredicate, in SUB.")
(comment specificationAdheredTo "(#$specificationAdheredTo EVENT SPECIFICATION) says that the event EVENT, an instance of #$AdheringToANormativeSpecification, was intentionally performed in accordance with the guidelines set forth in the #$NormativeSpecification SPECIFICATION.")
(comment ConformingToASpecification "The collection of all instances of #$Situation that are such that they conform to the guidelines set forth in some instance of #$Specification.  This conforming need not be intentional.")
(comment situationConformsToSpecification "(#$situationConformsToSpecification SIT SPECIFICATION) says that the situation SIT, an instance of #$ConformingToASpecification conforms to the guidelines set forth in the instance of #$Specification SPECIFICATION.  This might mean that SIT is an action that was performed -- perhaps unknowingly by the performer (c.f., #$performedBy) -- in accordance with those guidelines, or that the relevant consituents of SIT (c.f., #$situationConstituents) are \"arranged\" in such a way that the specification is met, e.g., SIT might be the situation where people at a wedding party are actually seated in the spots prescribed by SPECIFICATION, which is the wedding planner's seating chart.")
(comment typePrimaryFunction-DeviceUsed "A #$BinaryPredicate.  <code>(#$typePrimaryFunction-DeviceUsed DEVICE-TYPE EVENT-TYPE)</code> means that the primary function of instances of <code>DEVICE-TYPE</code> is to play the role of #$deviceUsed in instances of <code>EVENT-TYPE</code>.")
(comment typePrimaryFunction-EventOccursAt "A #$BinaryPredicate.  <code>(#$typePrimaryFunction-EventOccursAt LOC-TYPE EVENT-TYPE)</code> means that the primary function of instances of <code>LOC-TYPE</code> is to play the role of #$eventOccursAt in instances of <code>EVENT-TYPE</code>.")
(comment typeIntendedBehaviorCapable-EventOccursAt "A #$BinaryPredicate.  <code>(#$typeIntendedBehaviorCapable-EventOccursAt LOC-TYPE EVENT-TYPE)</code> means that instances of <code>LOC-TYPE</code> are, as a general rule, intended to be capable of playing the role of #$eventOccursAt in instances of <code>EVENT-TYPE</code>.")
(comment typeIntendedBehaviorCapable-DeviceUsed "A #$BinaryPredicate.  <code>(#$typeIntendedBehaviorCapable-DeviceUsed DEVICE-TYPE EVENT-TYPE)</code> means that instances of <code>DEVICE-TYPE</code> are, as a general rule, intended to be capable of playing the role of #$deviceUsed in instances of <code>EVENT-TYPE</code>.")
(comment specificationFulfilled "(#$specificationFulfilled SIT SPEC) means that the #$Situation SIT satisfies the #$NormativeSpecification SPEC.  Instances of #$NormativeSpecification describe types of #$Situation, usually quite specifically.  An assertion of this amounts to saying that an individual event satsifies the description represented by SPEC.  As an example, Joe can imagine having his apartment be clean.  If it turns out that his roommate cleans it, then that particular #$NormativeSpecification is satisfied by the fact that the apartment is cleaned.")
(comment versionNumberOfTest "A predicate relating a #$SoftwareTestVersion with a version number.")
(comment versionNumberOfTestType "A predicate relating a #$SoftwareTestVersion with a version number.")
(comment MeasurableQuantitySlot "A specialization of #$QuantitySlot (q.v.).  Each instance of #$QuantitySlot is a binary predicate that is used to attribute a property to a thing, by relating it to a #$MeasurableQuantity (q.v.) of some sort, such as a #$Distance, a #$Speed, or a #$Time-Quantity.
<p>
Instances of #$MeasurableQuantitySlot include #$lengthOfObject and #$duration.
<p>
See also #$NonNumericQuantitySlot.")
(comment AnytimePSCTest "A specialization of #$CycorpTemporalInferenceTestSpecification.  Instances are used in the testing and development of inferences that ignore time dimensions.  See #$AnytimePSC for more information about such inferences.")
(comment credibilityOfAssertion "This predicate relates a #$CycLAssertion to some instance of #$Credibility (q.v.).  (#$credibilityOfAssertion ASSERTION CREDIBILITY) holds just in case the degree to which ASSERTION can be independently confirmed is CREDIBILITY.  A (#$VeryLowAmountFn #$Credibility) means that the truth of the assertion cannot be confirmed by other reliable sources.  A (#$VeryHighAmountFn #$Credibility) means that the truth of the assertion is confirmed by other sources each with high reliability.  A (#$MediumAmountFn #$Credibility) means that the assertion has some confirmation, but the source is not reliable enough to warrant a higher credibility rating.")
(comment accomplices "(#$accomplices AGT-1 AGT-2) holds just in case there is some event in which AGT-1 and AGT-2 are cooperating (to some degree) in.  This predicate is temporally quantifiable and it holds during the time period when AGT-1 and AGT-2 were actively cooperating.  Most often this predicate is used to characterize the cooperating performers of illegal acts.  But, two agents could also be accomplices in the performance of legal acts such as a planning a surprise birthday party.")
(comment receivedTrainingAt "(#$receivedTrainingAt AGENT LOCATION) holds just in case there exists an instance of #$Training, TRAIN, and (#$eventOccursAt TRAIN LOCATION) and (#$recipientOfService TRAIN AGENT).")
(comment incarceratedBy "An instance of #$ActionPredicate.  (#$incarceratedBy LEGAL-AGT AGT) holds just in case LEGAL-AGT is the performer of an imprisoning in which AGT is the captive.  This is the relation that holds definitionally between the objects which fill #$performedBy and #$captive slots in an instance of #$Imprisoning.")
(comment SKSI-KBIT-MappingUtilitiesTest "This collection of tests makes sure that several utility functions, such as #$DateDecodeStringFn and #$StringToIntegerFn, that are routinely used in SKSI schema translations work as expected.")
(comment lookupSpecs "(lookupSpecs TASK COL) means that the lookup constraint for TASK is specializations of COL.")
(comment findSpecs "(findSpecs TASK COL) means that the find constraint for TASK is specializations of COL.")
(comment lookupInstances "(lookupInstances TASK COL) means that the lookup constraint for TASK is instances of COL.")
(comment findInstances "(findInstances TASK COL) means that the find constraint for TASK is instances of COL.")
(comment typeBehaviorCapable-DeviceUsed "A #$BinaryPredicate.  <code>(#$typeBehaviorCapable-DeviceUsed DEVICE-TYPE EVENT-TYPE)</code> means that instances of <code>DEVICE-TYPE</code> are, as a general rule, capable of playing the role of #$deviceUsed in instances of <code>EVENT-TYPE</code>.")
(comment TestPilot "A specialization of #$AirplanePilot.  Instances of #$TestPilot are pilots hired to fly experimental airplanes through maneuvers designed to test them.")
(comment InterestOnlyMortgage "The collection of instances of #$MortgageAgreements that are also instances of #$InterestOnlyLoan.")
(comment RocketPlane "A specialization of #$RocketPropelledTransportationDevice and #$FixedWingAircraft (qq.v).  Each instance of #$RocketPlane is an air transportation vehicle that has a fixed wing enabling it to fly through an atmosphere (e.g. Earth's), yet is rocket-powered and thus also able to leave the atmosphere.
<p>
A specialization of #$RocketPlane is #$SpaceShuttle.")
(comment Weightlessness "A specialization of #$PhysicalSituation (q.v.). In each instance of #$Weightlessness there is a zero-gravity condition in which physical objects have mass but not weight.  Unsupported objects in a weightless situation will not \"fall\", but are instead able to \"float\".  Weighlessness occurs (e.g.) in outer space as well as in some special artificially-created environments.")
(disjointWith FederalCourt USStateSupremeCourt)
(comment unitDefinition "A binary predicate that is used to express the relationship between a derived #$UnitOfMeasure (q.v.) and the primitive units from which it is derived.  <code>(#$unitDefinition UNIT DEFN)</code> means that one unit of the #$MultiDimensionalUnitOfMeasure <code>UNIT</code> (i.e. <code>(UNIT 1))</code> is equal to <code>DEFN</code>, where <code>DEFN</code> is represented as a product, quotient, or power built ultimately from #$OneDimensionalUnitOfMeasures applied to the integer 1.  For example,
<pre>
  (#$unitDefinition
    #$MilesPerHour
    (#$QuotientFn (#$Mile 1) (#$HoursDuration 1)))
</pre>
<p>
means that one mile-per-hour is equal to the distance 1-mile divided by the time-quantity 1-hour.")
(comment testHasAnytimePSCVersion "(#$testHasAnytimePSCVersion TEST NEW-TEST) identifies NEW-TEST as the instance of #$AnytimePSCTest that is identical to the instance of #$KBContentTest-FullySpecified TEST in all respects, except for one: The #$InferenceMicrotheoryParameter of the query for NEW-TEST (see #$testQuerySpecification) uses #$AnytimePSC as a temporal dimension.")
(comment projectedKETimePerPeriod "(#$projectedKETimePerPeriod CYCLIST PROJECT KE-TIME PERIOD) means that PERSON is expected to spend KE-TIME amount of time per PERIOD doing knowledge entry for PROJECT. For example, (#$projectedKETimePerWeek #$BillMathews #$TKBProject (#$HoursDuration 30 40) (#$WeeksDuration 1)) means that Bill Mathews is expected to spend 30 to 40 hours each week doing knowledge entry for the TKB project.")
(comment NormativeSpecification-DirectAchievement "A subcollection of #$NormativeSpecification-Achievement, instances of #$NormativeSpecification-DirectAchievement describe a specific type of #$Situation that some agent wants to occur.  The subcollections of #$NormativeSpecification are differentiated based on their satisfaction conditions.  The instances of #$NormativeSpecification-DirectAchievement specify the details of the kind of situation.  This collection should be contrasted with the collections #$NormativeSpecification-Avoidance and #$NormativeSpecification-IndirectAchievement.  Instances of #$NormativeSpecification-Avoidance specify the kind of situation that some agent does not want to occur.  Instances of #$NormativeSpecification-IndirectAchievement point to the kind of situation that the #$motivatedAgents want to occur as an effect of the occurrence of some other, unspecified, type of situation.")
(comment NormativeSpecification-IndirectAchievement "A subcollection of #$NormativeSpecification-Achievement, instances of #$NormativeSpecification-IndirectAchievement describe some agents being actors in some situation (where the type of this situation is unspecified) which #$causes-SitSit an instance of a particular type of #$Situation to occur.   The subcollections of #$NormativeSpecification are differentiated based on their satisfaction conditions.  #$NormativeSpecification-IndirectAchievement should be contrasted with the collections #$NormativeSpecification-Avoidance and #$NormativeSpecification-DirectAchievement.  Instances of #$NormativeSpecification-Avoidance specify the kind of situation that some agent does not want to occur.  Alternatively, instances of #$NormativeSpecification-DirectAchievement point to the specific kind of situation that the some agents want to occur.")
(disjointWith SingleEventAssignment RegularlyRecurringAssignment)
(disjointWith SingleEventAssignment IteratedAssignment)
(comment AssignmentTypeByResponsibility "A #$SecondOrderCollection, instances of #$AssignmentTypeByResponsibility are sub-collection of #$Assignment-Specification whose instances are characterized by the different responsibilities that the #$assignees have relative to the satisfaction of that assignment.")
(comment AssignmentTypeByPerformanceCount "A #$SecondOrderCollection, instances of #$AssignmentTypeByPerformanceCount are sub-collections of #$Assignment-Specification whose instances are characterized by the number of events which are required to satisfy them, either a single event (#$SingleEventAssignment),  multiple events (#$IteratedAssignment), or a single event per a particular interval type (#$RegularlyRecurringAssignment).")
(comment typicalTextureOfType "An instance of #$BinaryPredicate.  <code>(#$typicalTextureOfType COL TEXTURE)</code> means that instances of <code>COL</code> typically have the #$Texture <code>TEXTURE</code> (see #$textureOfObject).")
(comment RamenNoodle "The collection of all ramen noodles; an ingredient in #$RamenSoup.")
(comment NormativeSpecificationTypeBySatisfactionMethod "A #$SecondOrderCollection, #$NormativeSpecificationTypeBySatisfactionMethod is used to facet the collection #$NormativeSpecification into collections who instances resemble each other based on the means by which the #$Motivation can be satisfied.  For example, the collection #$NormativeSpecification-DirectAchievement has as instances, instances of  #$NormativeSpecification that require the bringing about of some type of #$Situation. Alternatively, #$NormativeSpecification-Avoidance has instances of #$NormativeSpecification that will be satisfied only if it is not the case that an specified type of event occurs.")
(comment Anthropologist "The collection of #$Scientists who work in the field of #$Anthropology.")
(comment Badness-Generic "A linear-ordered specialization of #$EvaluativeQuantity, and the #$contraryIntervalTypes of #$Goodness-Generic. Instances reflect \"negative\" assessments of the relative worth of a particular thing.  Such assessments are usually made in relation to some (often implicit) standard held by the assessor; this standard might purport to measure a thing's usefulness, or its value, or its moral worth, or its beauty, or something else.  #$Badness-Generic is thus \"generic\" with respect to these various categories of worth.  Particular instances of this collection can be obtained via the various #$GenericValueFunctions.  Note: If a particular dimension of badness is sought you should use one of the specializations of this collection; e.g. #$Badness-Moral, #$Badness-Functional. ")
(comment AIGoneWrongMovie "#$AIGoneWrongMovie is the collection of movies which depict a disaster or tragedy caused by some AI. The classic example would be #$2001-ASpaceOdyssey-TheMovie. A negative example would be Spielberg's 'A.I.', which is an AI movie gone wrong. Stories about pernicious #$IntelligentAgents that are somehow translated into software, such as #$TheLawnmowerMan-TheMovie, are not technically #$AIGoneWrongMovies")
(comment Badness-Moral "A specialization of #$MoralQuality and #$Badness-Generic.  Instances reflect negative assessments of the relative moral worth of a particular thing.  Such assessments are usually made in relation to some (often implicit) moral standard held by the assessor (c.f. #$CodeOfConduct).  Particular instances of this collection can be obtained via the various #$GenericValueFunctions.")
(comment moralityOfAct "An instance of #$QuantitySlot. (#$moralityOfAct ACT MORAL-QUALITY) identifies MORAL-QUALITY as ACT's moral quality (its moral goodness or badness). Rules concluding to #$moralityOfAct should typically be asserted in a microtheory that contains a particular moral theory.")
(comment Omnibenevolent "An instance of #$AgentTypeByMoralStanding.  Instances are instances of #$IntelligentAgent who are morally perfect.")
(comment MorallyFallible "The collection of instances of #$IntelligentAgent that are morally fallible -- i.e., they are capable of moral lapse and can thus perform acts (c.f., #$performedBy) or allow acts that are themselves less than thorougly morally good.")
(disjointWith MorallyFallible Omnibenevolent)
(comment AgentTypeByMoralStanding "A collection of collections that facets #$IntelligentAgent.  Instances are collections of intelligent agents who share a common #$moralCharacter.")
(comment ComputerNetworkContactInfoString "The collection of ID strings that are used as as all or part of the address of some resource (e.g., file, directory, program, account, etc.) on a computer network. This includes filenames, pathnames, e-mail addresses, URLs, ICQ addresses, and so on.")
(comment DirectoryPathname "#$DirectoryPathname is the collection of computer filesystem directory pathnames.  Pathnames are intended to identify directories on a given filesystem.  For example, '/cyc/ke/' is a directory pathname which denotes a directory on the #$Cycorp unix filesystem. Similarly, '/cyc/foobar/' is a syntactically legal pathname.  However, if '/cyc/foobar/' is not a directory on any unix filesystem, it is not a semantically valid pathname.")
(comment FilePathname "#$FilePathname is the collection of computer filesystem  file pathnames.  File pathnames are intended to identify files on a given filesystem.  For example, '/cyc/ke/mod.text' is a file pathname which denotes a file on the #$Cycorp unix filesystem. Similarly, '/cyc/ke/foobar.text' is a syntactically legal pathname.  However, if '/cyc/ke/foobar.text' is not a file on any unix filesystem, it is not a semantically valid pathname.")
(comment AbsolutePathname "#$AbsolutePathname is the collection of computer filesystem pathnames (c.f. #$Pathname) that start at the root directory (e.g. on Unix, these always begin with a slash '/' character).")
(comment RelativePathname "#$RelativePathname is the collection of computer filesystem pathnames (c.f. #$Pathname) that depend upon some basepath (such as the current directory) to describe a complete path. On Unix systems, relative pathnames never begin with a slash '/' character.")
(comment BestSupportSentenceFn "A unary #$IndividualDenotingFunction that takes for its
value an instance of #$CycLSentence-Askable, ASK, and returns an
individual #$CycLSentence SENTENCE that is consider a best support
sentence for ASK. This function clues the system to search further for
a supporting sentence on ASK and allows the system to return a
supporting sentence that is more informative than ASK alone.")
(comment bestSupportSentence "(#$bestSupportSentence SENTENCE ASK) means that SENTENCE is
considered one of the best support sentences for ASK. Essentially, ASK
requires further support, and this predicate relates ASK to an
instance of #$CycLSentence that supports ASK an. See also #$BestSupportSentenceFn ")
(comment documentURLBasePath "(documentURLBasePath APP COMPUTER BASEPATH) means that an instantiation of APP is installed on COMPUTER, and that BASEPATH is the default base URL of all document files managed by APP on COMPUTER. The absolute URL of a file can be determined by appending its full relative pathname to its base URL. The full relative pathname for a file 'FILE' can be determined by combining the relative directory pathname for 'FILE' (c.f. #$documentRelativeBasePath) with the relative file pathname (c.f. #$accessFilenameOfAIS) of 'FILE'.")
(comment remainderDirectoryPathnameOfAIS "(#$remainderDirectoryPathnameOfAIS FILE NAME) means that the #$CharacterString NAME can be used as a #$DirectoryPathname (that is a #$RelativePathname) to designate the directory containing #$ComputerFile-AIS FILE. The full (absolute) directory pathname can be determined by prepending a document base path (c.f. #$documentBasePath, #$documentURLBasePath, #$applicationBasePath). Note that, through the use of symbolic links, there can be multiple directories associated with the same file.  Note also that a single #$ComputerFile-AIS can have multiple corresponding instances of #$ComputerFileCopy stored in different areas of memory or on multiple computers or networks.")
(comment cycLForSubL "(cycLForSubL CYCL SUBL) states that the #$CycLExpression CYCL denotes the #$SubLSExpression SUBL, and vice versa. The #$CycLExpression in the first argument position is typically expressed using #$SubLQuoteFn.")
(comment unitTypeDimensionalAnalysis "A binary predicate that is used to show how a complex interconvertible-unit-type can be analyzed in terms of more basic unit-types.  #$unitTypeDimensionalAnalysis relates a non-primitive #$InterconvertibleUnitType (q.v.) to a set of #$Lists that represents an equivalent \"product\" of #$FundamentalUnitTypes.
<p>
<code>(#$unitTypeDimensionalAnalysis UNITTYPE PRODUCT-SET)</code> means that any #$MeasurableQuantity (q.v.) returned by an instance of <code>UNITTYPE</code> can be converted to (i.e. represented as) a product of quantities measured in units of the (fundamental) types in <code>PRODUCT-SET</code>.  More precisely, each element of <code>PRODUCT-SET</code> is of the form <code>(#$TheList FUND-UNITTYPE EXPONENT)</code>, and so <code>PRODUCT-SET</code> itself is of the form
<pre>
  (#$TheSet
    (#$TheList FUND-UNITTYPE-1 EXPONENT-1)
    (#$TheList FUND-UNITTYPE-2 EXPONENT-2)
    . . .
    (#$TheList FUND-UNITTYPE-n EXPONENT-n)).
</pre>
<p>
Hence, <code>(#$unitTypeDimensionalAnalysis UNITTYPE PRODUCT-SET)</code> means that <code>UNITTYPE</code> is equivalent to (put schematically)
<pre>
  (FUND-UNITTYPE-1 ^ EXPONENT-1) *
  (FUND-UNITTYPE-2 ^ EXPONENT-2) *
  . . . *
  (FUND-UNITTYPE-n ^ EXPONENT-n).
</pre>
<p>
In other words: for any #$UnitOfMeasure (q.v.) function <code>UNIT</code> that is an instance of <code>UNITTYPE</code>, <code>(UNIT 1)</code> (i.e. the quantity one-<code>UNIT)</code> is equal to a quantity of the form
<pre>
  (#$TimesFn
    (#$ScalarExponentFn (FUND-UNIT-1 1) EXPONENT-1)
    (#$ScalarExponentFn (FUND-UNIT-2 1) EXPONENT-2)
    . . .
    (#$ScalarExponentFn (FUND-UNIT-n 1) EXPONENT-n))</code> ,
</pre>
<p>
where each <code>FUND-UNIT-i</code> is some instance of <code>FUND-UNITTYPE-i</code> (for 1 <= <code>i</code> <= <code>n)</code>.
<p>
For example,
<pre>
  (#$unitTypeDimensionalAnalysis
    #$UnitOfSpeed
    (#$TheSet
      (#$TheList #$UnitOfDistance 1)
      (#$TheList #$UnitOfTime -1)))
</pre>
<p>
means that each #$UnitOfSpeed is obtainable by \"dividing\" a #$UnitOfDistance by a #$UnitOfTime (e.g. #$MilesPerHour = (#$PerFn #$Mile #$HoursDuration)).  Put more simply: speed is distance over time.")
(comment clarifiedParseTermForPeg "(#$clarifiedParseTermForPeg UTTERANCE-PEG PARSE) says that PARSE is a parse of the #$LinguisticExpressionPeg UTTERANCE-PEG that has been verified through a #$ClarificationDialogue.")
(comment XSLFile "The collection of all XML files written in XSL, which is a language for expressing style sheets. An XSL style sheet is a file that describes how to display an XML document of a given type. XSL is actually made up of three languages that can be used together: XSLT, XPath and XSL-FO.")
(comment ProgramFileTypeFn "ProgramFileTypeFn takes an instance of #$ComputerProgram-CW (PROG) and returns the collection of files (instances of #$ComputerFile-Abstract) that are stored in PROG's primary file format.")
(comment ProgramTypeFileTypeFn "#$ProgramTypeFileTypeFn takes an specialization of #$ComputerProgram-CW (PROGTYPE) and returns the collection of files (instances of #$ComputerFile-Abstract) that are stored in a format compatible with at least one of the instances of PROGTYPE. See also #$ProgramFileTypeFn.")
(comment PortableNetworkGraphicsFile "The collection of computer image files encoded in the '.png' file format. Designed to replace GIF files, PNG files have three main advantages: alpha channels (variable transparency), gamma correction (cross-platform control of image brightness) and two-dimensional interlacing.")
(comment NumericModifierType "The collection of terms that reference certain types of numeric intervals.  The instances of this collection serve as argument places in query macro predicates.  This includes #$Percent, #$Ratio, etc.")
(comment mostRecentReferenceToWRTPeg "(#$mostRecentReferenceToWRTPeg REF EXPR-REF EXPR-NEW) means that the #$LinguisticExpressionPeg EXPR-REF is the most recent expression to reference the #$DiscourseReferentPeg REF relative to the new (more recent) expression EXPR-NEW.  This predicate ")
(comment possibleParseTermForPeg "(#$possibleParseTermForPeg PEG TERM) means that utterance associated with the #$LinguisticExpressionPeg PEG was initially parsed to TERM. Because it only reflects the initial parser output, TERM may not reflect the intended content of PEG (e.g., it may be an #$NLTaggedTerm or other i-cycl expression).")
(comment rankedParseTermForPeg "(#$rankedParseTermForPeg PEG TERM RANK) means that TERM, the initial parser output for the utterance associated with the #$LinguisticExpressionPeg PEG, has been assigned a rank RANK as a measure of how likely it to be the correct (initial) parse for PEG. See also #$possibleParseTermForPeg, #$chosenParseTermForPeg, and  #$clarifiedParseTermForPeg.")
(comment sentTextMessageTo "(#$sentTextMessageTo AGT-1 AGT-2) holds just in case AGT-1 sent a text message to AGT-2.")
(comment placedAPhoneCallTo "(#$placedAPhoneCallTo AGT-1 AGT-2) holds just in case AGT-1 made a phone call to AGT-2.  This holds regardless of whether AGT-2 was the intended recipient of the call.")
(comment withdrewFundsFrom "(#$withdrewFundsFrom AGT-1 AGT-2) holds just in case AGT-1 withdrew funds from AGT-2.  This relation most often holds between an individual in arg1 and some sort of financial institution in arg2.")
(comment gaveFundsTo "(#$gaveFundsTo AGT-1 AGT-2) holds just in case AGT-1 gave funds to AGT-2.")
(comment CADEConference "Conference held yearly, organized by the Association for Automated Reasoning.")
(comment IJCARConference "Conference held periodically, organized by the Association for Automated Reasoning.")
(comment AutomatedReasoningConference "Conference whose main topic is Automated Reasoning.")
(comment Forgery "An instance of #$ActTypeCommonlyConsideredCriminal and a specialization of #$Fraud.  Each instance of #$Forgery is an event in which an agent makes, alters, or imitates something with the intent of defrauding or swindling another agent.  Some examples: producing counterfeit currency, forging another person's signature on a check or credit card form, producing fake ID, signing another artist's name to one's painting to increase its perceived value.")
(comment ForgingAnOfficialDocument "An instance of #$ActTypeCommonlyConsideredCriminal and a specialization of #$Forgery.  Each instance of #$ForgingAnOfficialDocument is an event in which an agent alters or creates an imitation of an #$OfficialDocument with the intent of defrauding or swindling another agent.")
(comment typicalMainConstituent-TypeType "A #$BinaryPredicate that relates a specialization of #$PartiallyTangible to a specialization of #$PartiallyTangible.  <code>(#$typicalMainConstituent-TypeType TYPE1 TYPE2)</code> means that an instance of <code>TYPE1</code> will typically have an instance of <code>TYPE2</code> as its #$mainConstituent.  For example, (#$typicalMainConstituent-TypeType #$DrinkingCan #$Aluminum); (#$typicalMainConstituent-TypeType #$T-Shirt #$CottonStuff).")
(comment mainConstituent-TypeType "A #$BinaryPredicate that relates a specialization of #$PartiallyTangible to another specialization of #$PartiallyTangible.  <code>(#$mainConstituent-TypeType TYPE1 TYPE2)</code> means that every instance of <code>TYPE1</code> has an instance of <code>TYPE2</code> as its #$mainConstituent.")
(comment primaryConstituent "A #$BinaryPredicate that relates objects to further objects which are their primary constituents. <code>(#$primaryConstituent WHOLE PART)</code> means that <code>PART</code> constitutes more of <code>WHOLE</code> than any other (non-arbitrary) part of <code>WHOLE</code>.  For example, (#$primaryConstituent BobsBody WaterInBobsBody).  It is important to note that #$primaryConstituent is neither a specialization nor a generalization of #$mainConstituent (q.v.).")
(comment MeasurableQuantityType "A collection of collections and a specialization of both #$TotallyOrderedQuantityType and #$MeasurableScalarIntervalType (qq.v.).  Each instance of #$MeasurableQuantityType is a totally-ordered collection of #$MeasurableQuantity[ies] (q.v.) that is #$closedUnder addition (see #$PlusFn) and subtraction (see #$DifferenceFn).
<p>
Instances of #$MeasurableQuantityType include #$Distance, #$RateOfRotation, and #$Time-Quantity.  Specializations include #$PrimitiveMeasurableQuantityType and #$DerivedMeasurableQuantityType.")
(comment MixingByInfusion "A sub-collection of #$Mixing, instances of #$MixingByInfusion involve the creation of a #$Mixture by putting some entity into a liguid and allowing some constituent of that entity to form a mixture with the liquid. Notable sub-collections include #$MakingTea-TheBeverage and #$MakingCoffee-TheBeverage.")
(comment ProblemSolvingStrategyTypeByModule "A second-order instance of #$FacetingCollectionType.  Instances of #$ProblemSolvingStrategyTypeByModule are specializations of #$ProblemSolvingStrategy that are implemented in a particular #$ComputerProgram-CW.")
(comment programImplementsStrategy "(#$programImplementsStrategy PROGRAM STRATEGY) means that the computer program (c.f., #$ComputerProgram-CW) PROGRAM is written in such a way that it effectively implements the instance of #$Strategy STRATEGY.")
(comment ClarificationStrategy "The collection of instances of #$ProblemSolvingStrategy in which steps for obtaining clarification of some issue are specified.")
(comment ClarificationStrategy "The collection of instances of #$ProblemSolvingStrategy where the goal is to generate meaningful clarification questions in response to utterances whose content or intent is not entirely clear.")
(comment assertionAssertDate "(#$assertionAssertTime ASSERTION DATE) means that ASSERTION was made at DATE where DATE specifies a particular day as a #$CalendarDay. For more precision in assertion time, see #$assertionAssertSecond.  See also #$myCreationTime.")
(comment nthSubSituationOfType "(#$nthSubSituationOfType NTH-SUBSITUATION SUPER-SITUATION N TYPE) says that the instance of #$Situation NTH-SUBSITUATION is the Nth proper subsituation (see #$properSubSituations) of SUPER-SITUATION that is an instance of the collection TYPE.  For example, (#$nthSubSituationOfType SecondInningOfBaseballGame001 BaseballGame001 2 #$BaseballInning) says that the second inning of the baseball game denoted by BaseballGame001 is the second instance of #$BaseballInning of that game.")
(comment numOfTypeTargetedInAttack "(#$numOfTypeTargetedInAttack ATTACK TYPE NUM) says that during ATTACK, NUM instances of TYPE are being targeted.  For example, (#$numOfTypeTargetedInAttack TodaysAttackOnTelAviv #$IsraeliPerson 8), says that eight Israelis were targeted during today's attack on Tel Aviv.  Note that arg3 allows a range of values.")
(comment numOfTypeDamagedInAttack "(#$numOfTypeDamagedInAttack ATTACK TYPE NUM) says that during ATTACK, NUM instances of TYPE were damaged.")
(comment numOfTypeDestroyedInAttack "(#$numOfTypeDestroyedInAttack ATTACK TYPE NUM) says that during ATTACK, NUM instances of TYPE were destroyed.")
(comment numOfDeviceTypeUsedInAttack "(#$numOfDeviceTypeUsedInAttack ATTACK TYPE NUM) says that during ATTACK, NUM instances of TYPE were employed.")
(comment SupportSituation "A specialization of #$StaticSituation.  This is the situation that arises from an ongoing support relationship between two agents.")
(comment supporterInSupportSituation "(#$supporterInSupportSituation SIT AGT) holds just in case AGT was the giver of support during the #$SupportSituation SIT.")
(comment supporteeInSupportSituation "(#$supporteeInSupportSituation SIT AGT) holds just in case AGT was the receiver of support during the #$SupportSituation SIT.")
(comment typeOfSupportGiven "(#$typeOfSupportGiven SIT SUPPORT-TYPE) holds just in case, during the extent of SIT, SUPPORT-TYPE was the type of support given.")
(comment candidateClarificationQuestion "(#$candidateClarificationQuestion UTTERANCE STRATEGY QUESTION) says that according to the #$ClarificationStrategy STRATEGY, QUESTION is an appropriate clarification question to ask in response to the #$LinguisticExpressionPeg UTTERANCE.")
(comment SalientDescriptorsOnSubPegs-ClarificationStrategy "An instance of #$ProblemSolvingStrategy.  This strategy involves identifying semantic constituents of a dialogue participant's utterance, and running the salient descriptor (See #$CycSalientDescriptor) on those constituents.")
(comment StrongSalientDescriptorsOnSubPegs-ClarificationStrategy "An instance of #$ProblemSolvingStrategy.  This strategy involves identifying semantic constituents of a dialogue participant's utterance, and querying for strong salient descriptor questions (see #$keStrongSuggestion) for those constituents.")
(comment RequiredSalientDescriptorsOnSubPegs-ClarificationStrategy "An instance of #$ProblemSolvingStrategy.  This strategy involves identifying semantic constituents of a dialogue participant's utterance, and querying for required salient descriptor questions (see #$keRequirement) for those constituents.")
(comment LDFY04-IETChallengeProblemConstant "A collection tag used for all vocabulary introduced by IET
in support of the 2004 LD Challenge Problems")
(comment uninterestingForArgInReln "(#$uninterestingForArgInReln THING NUMBER RELATION) says that for any formula FORMULA of the form (RELATION ... THING ...) where THING appears in the NUMBERth argument place of FORMULA, FORMULA is uninteresting.")
(comment RuleEvaluationOutput "A collection of collections. Each instance of
#$RuleEvaluationOutput is a class of rules that have been induced by
Cyc and given some value via the use of a rule review tool. Examples
of #$RuleEvaluationOutput include #$NonsensicalRule,
#$IntelligibleRule and #$GoodRule.")
(comment BinarySituationTypeConstant "#$BinarySituationTypeConstant is a collection of terms which together can be used to create type-level representations of a variety of the features that are exhibited by the instances of a type of #$Situation.   Of focal interest are temporal properties among subsituations and the relations among actors within those subsituations.  This collection of constants is grouped together because the collections and predicates work together to perform this representation without using predicates with an arity greater than two.")
(comment SituationSpecification "#$SituationSpecification is a collection of abstract individuals that are used in giving a type-level representation for the structure of the instances of some type of #$Situation.  The sub-collections of #$SituationSpecification each perform different representational tasks.  For instance, the sub-collection #$TemporalStageSpecification is used for representing temporal relations among individual situations that are themselves subsituations of the target type of #$Situation (e.g., whether one type of sub-event always comes before another).  Alternatively, the sub-collection #$RoleMappingSpecification is used to represent relationships between the groups of actors which play roles in the situations (e.g., whether the set of actors which play one #$Role is a subset of, equivalent to, or disjoint with the set of actors which play another #$Role).  For any particular type of #$Situation, it will likely be associated with many instances of #$SituationSpecification and relationships will exist among those instances so as to establish arbitrarily complex relationships.  The key predicates for associating types of #$Situation with instances of #$SituationSpecification are the specializations of #$sitTypeHasSpecification (q.v.).")
(comment InterStageSpecification "A #$FirstOrderCollection and sub-collection of #$SubsituationSpecification, instances of #$InterStageSpecification are used to provide a type-level description of temporal relations (specifically, the duration of intervals) among the subsituations of the instances of a given type of #$Situation.  This particular specification is done at an abstract level by describing relations between instances of #$TemporalStageSpecification and instances of #$InterStageSpecification will describe intervals that subsume or separate the situations which fall under their associated #$TemporalStageSpecifications.  Such a description using an #$InterStageSpecification includes the predicates #$sitTypeHasInterStageSpec, #$earlierStage, #$laterStage,  and then predicates like #$intervalBetweenStages-EndToStart-Min (which describes the empty interval between the end of the situations covered by one #$TemporalStageSpecification and the beginning of the situations covered by another).")
(comment SubsituationSpecification "A #$FirstOrderCollection and sub-collection of #$SituationSpecification, each instance of #$SubsituationSpecification is an abstract individual which is used to provide a type-level representation of the temporal features of the instances of a particular type of #$Situation and of the individual situations that are the subsituations of the members of that type of #$Situation.  Its notable sub-collections include  #$TemporalStageSpecification and #$InterStageSpecification.")
(comment startsDuring-TempStage "An assertion of the form (#$startsDuring-TempStage TEMP-STAGE1 TEMP-STAGE2) is used to relate two instances of #$TemporalStageSpecification.  Both will be part of the representation of some type of #$Situation SIT-TYPE, and so will bear the relation #$siblingSpecifications to one another.  This assertion combines with other assertions (most importantly with the predicates #$sitTypeHasTemporalStage and #$situationFallsUnderStage) to provide a type-level description of the temporal ordering of the subsituations of the instances of SIT-TYPE.  Specifically, any individual situation that falls under TEMP-STAGE1 will bear the temporal relation #$startsDuring to any individual situation that falls under TEMP-STAGE2.")
(comment sitTypeHasTemporalStage "An assertion of the form (#$sitTypeHasTemporalStage SIT-TYPE TEMP-STAGE) relates a sub-collection of #$Situation SIT-TYPE to an instance of #$TemporalStageSpecification.  Instances of #$TemporalStageSpecification are abstract individuals that are used to represent temporal relations among and features of the subsituations of instances of of a particular sub-collection of #$Situation (for TERMP-STAGE it would be the instances of SIT-TYPE).  This, predicate is used to express that TEMP-STAGE can be used for making inferences on some of the temporal features of the subsituations of instances of SIT-TYPE, specifically the temporal ordering of the subsituations and their durations.")
(comment situationFallsUnderStage "An assertion of the form (#$situationFallsUnderStage SIT TEMP-STAGE) is used to relate an instance of #$Situation SIT to an instance of #$TemporalStageSpecification TEMP-STAGE.  TEMP-STAGE is an element in the representation of some type of #$Situation (let's call it SUPER-TYPE).  This predicate will hold if (1) SIT is a subsituation of an instance of SUPER-TYPE and (2) SIT's type (let's call it SIT-TYPE) is covered only by TEMP-STAGE (#$stageCoversSubSitTypeUniquely (q.v.)).  The above assertion will be used for reasoning about the temporal relations that hold between SIT and other individual subsituations of the same instance of SUPER-TYPE. NOTE:  If SIT-TYPE is associated with more than one #$TemporalStageSpecification for SUPER-TYPE (such that only #$stageCoversSubSitType holds between TEMP-STAGE and SIT-TYPE), additional reasoning would be required to associate SIT with the correct #$TemporalStageSpecification through an assertion using #$situationFallsUnderStage.")
(comment TemporalStageSpecification "A #$FirstOrderCollection and sub-collection of #$SubsituationSpecification, each instance of #$TemporalStageSpecification is an abstract individual that serves to specify temporal relations that hold among the individual situations that are subsituations of a particular sub-collection of #$Situation.   These individuals serve two main functions.  First, they are used to group situations together in order to represent temporal orderings among the individual situations that are subsituations of the individuals of a particular type of #$Situation.  Second, they are used to represent durations of those situations.  The core predicates for using instances of #$TemporalStageSpecification to representing the temporal orderings of subsituations are #$sitTypeHasTemporalStage and #$stageCoversSubSitType. #$sitTypeHasTemporalStage associates the relevant type of #$Situation with an instance of #$TemporalStageSpecification, and then #$stageCoversSubSitType is used to relate an instance of #$TemporalStageSpecification to types of subsituations.  Mutliple types of subsituations can be associated with a single instance of #$TemporalStageSpecification, one would do so when those subsituations are (1) temporally proximate and (2) there is no expected order on their occurrences. If there is an expected ordering on the instances of two types of subsituation, then they should be associated with different instances of #$TemporalStageSpecification.")
(comment startsAfterStartingOf-TempStage "An assertion of the form (#$startsAfterStartingOf-TempStage TEMP-STAGE1 TEMP-STAGE2) is used to relate two instances of #$TemporalStageSpecification.  Both will be part of the representation of some type of #$Situation SIT-TYPE, and so will bear the relation #$siblingSpecifications to one another.  This assertion combines with other assertions (most importantly with the predicates #$sitTypeHasTemporalStage and #$situationFallsUnderStage) to provide a type-level description of the temporal ordering of the subsituations of the instances of SIT-TYPE.  Specifically, any individual situation that falls under TEMP-STAGE1 will bear the temporal relation #$startsAfterStartingOf to any individual situation that falls under TEMP-STAGE2.")
(comment sitTypeHasSpecification "An assertion of form (#$sitTypeHasSpecification SIT-TYPE SPEC) relates a sub-collection of #$Situation to an instance of #$SituationSpecification.  Instances of #$SituationSpecification are used to give a type-level description of all the instances of SIT-TYPE. So, this assertion states that SPEC gives some type of information about the structure of instances of SIT-TYPE.  This is the most general predicate for relating a type of #$Situation to a #$SituationSpecification.  See more specialized predicate, such as #$sitTypeHasTemporalStage, for more information about how instances of #$SituationSpecification are used to represent situations.")
(comment stageDuration-Min "An assertion of the form (#$stageDuration-Min TEMP-STAGE QUANT) is used to relate an instance of #$TemporalStageSpecification TEMP-STAGE to an instance of #$Time-Quantity.  TEMP-STAGE will be part of a type-level representation of some type of #$Situation (let's call it SIT-TYPE), such that (#$sitTypeHasTemporalStage SIT-TYPE TEMP-STAGE) holds.  This asserts that in any instance of SIT-TYPE, the duration of all the individual situations that are subsituations of that instance and which bear the relation #$situationFallsUnderStage to TEMP-STAGE cannot have a total duration less than QUANT.")
(comment specificationSubSitType "The predicate #$specificationSubSitType is used to relate an instance of #$SituationSpecification to a sub-collection of #$Situation.  Instances of #$SituationSpecification are used to represent complex structural features that are common to the instances of a type of #$Situation.  This is the most generic predicate for picking out subsituations based on their type.  It plays a significant role in relation to instances of #$RoleSpecification where it is used to specify the type of subsituation which an instance of #$RoleSpecification represents.")
(comment siblingSpecifications "An assertion of the form (#$siblingSpecifications SIT-SPEC1 and SIT-SPEC2) states that the two instances of #$SituationSpecification SIT-SPEC1 and SIT-SPEC2 are both representations of the same sub-collection of #$Situation.  That is, there exists a collection SIT-TYPE for which the assertions (#$sitTypeHasSpecification SIT-TYPE SIT-SPEC1) and (#$sitTypeHasSpecification SIT-TYPE SIT-SPEC2) are both true.")
(comment stageCoversSubSitTypeUniquely "An assertion of the form (#$stageCoversSubSitTypeUniquely TEMP-STAGE SIT-TYPE) is used to relate an instance of #$TemporalStageSpecification TEMP-STAGE to a sub-collection of #$Situation SIT-TYPE.  Instances of #$TemporalStageSpecification are used to give a type-level representation of the temporal features of all the individuals of a particular type of SITUATION, in particular by describing relations that will hold among individual subsituations based on their types.  This predicate differs from the more general #$stageCoversSubSitType because it has the additional meaning that no other #$TemporalStageSpecification that bears the #$siblingSpecifications to TEMP-STAGE can also bear the relation #$stageCoversSubSitType to SIT-TYPE.")
(comment stageCoversSubSitType "An assertion of the form (#$stageCoversSubSitType TEMP-STAGE SIT-TYPE) is used to relate an instance of #$TemporalStageSpecification TEMP-STAGE to a sub-collection of #$Situation SIT-TYPE.  Instances of #$TemporalStageSpecification are used to give a type-level representation of the temporal features of all the individuals of a particular type of #$Situation.  In particular, they describe temporal relations that will hold among individual subsituations based on their types and the duration of those subsituations.  This predicate asserts that SIT-TYPE is one of the types of subsituations that TEMP-STAGE describes.")
(comment stageCoversAtMostOneInstanceOfSubSitType "An assertion of the form (#$stageCoversAtMostOneInstanceOfSubSitType TEMP-STAGE SUBSIT-TYPE) is used to relate an instance of #$TemporalStageSpecification TEMP-STAGE to a sub-collection of #$Situation, SUBSIT-TYPE.   Instances of #$TemporalStageSpecification are used to give a type-level representaton of the temporal features of all the individuals of a particular sub-collection of #$Situation. (That sub-collection would be picked out using an assertion of the form (#$sitTypeHasTemporalStage SIT-TYPE TEMP-STAGE).   This predicate asserts that in any instance of SIT-TYPE, call it SIT-INST, there is at most one instance of SUBSIT-TYPE, call it SUB-INST,  which is a subsituation of SIT-INST such that the assertion (#$situationFallsUnderStage SUB-INST TEMP-STAGE).")
(comment stageCoversCandidateSubSitType "An assertion of the form (#$stageCoversCandidateSubSitType TEMP-STAGE SUBSIT-TYPE) is used to relate an instance of #$TemporalStageSpecification TEMP-STAGE to a sub-collection of #$Situation SUBSIT-TYPE.  Instances of #$TemporalStageSpecification are used to give a type-level representation of the temporal features of all the individuals of a particular type of #$Situation, let's call this SIT-TYPE.  In particular, they describe temporal relations that will hold among individual subsituations based on their types and the duration of those subsituations.  This predicate asserts that SUBSIT-TYPE is one of the types of subsituations of instances of SIT-TYPE that TEMP-STAGE is used for representing.  NOTE: such an assertion is agnostic on whether any given instance of SIT-TYPE which actually have an instance of SUBSIT-TYPE as a subsituation.  The more specific predicate #$stageCoversSubSitType asserts such an existential relation.")
(comment sitTypeHasInterStageSpec "An assertion of the form (#$sitTypeHasInterStageSpec SIT-TYPE INTER-SPEC) is used to relate a type of #$Situation to an instance of #$InterStageSpecification.  This assertion is part of providing a type-level description of the duration of time intervals that subsume or separate the subsituations of instances of SIT-TYPE.")
(comment earlierStage "An assertion of the form (#$earlierStage INTER-SPEC TEMP-STAGE) is used to relate an instance of #$InterStageSpecification to an instance of #$TemporalStageSpecification.  Instances of #$InterStageSpecification are used to provide a type-level representation of a type of #$Situation (let's introduce one and call it SIT-TYPE). In particular, they description the duration of time intervals that subsume or separate the subsituations of instances of SIT-TYPE. Instances of #$InterStageSpecification connect to the situations via this relation to a #$TemporalStageSpecifications.  this predicate picks out the #$TemporalStageSpecification that covers the subsituations that are comparatively earlier in instances of SIT-TYPE. The later #$TemporalStageSpecification is picked out with the predicate #$laterStage.")
(comment laterStage "An assertion of the form (#$laterStage INTER-SPEC TEMP-STAGE) is used to relate an instance of #$InterStageSpecification to an instance of #$TemporalStageSpecification.  Instances of #$InterStageSpecification are used to provide a type-level representation of a type of #$Situation (let's introduce one and call it SIT-TYPE). In particular, they description the duration of time intervals that subsume or separate the subsituations of instances of SIT-TYPE. Instances of #$InterStageSpecification connect to the situations via this relation to a #$TemporalStageSpecifications.  this predicate picks out the #$TemporalStageSpecification that covers the subsituations that are comparatively later in instances of SIT-TYPE. The later #$TemporalStageSpecification is picked out with the predicate #$earlierStage.")
(comment stageDuration-Max "An assertion of the form (#$stageDuration-Max TEMP-STAGE QUANT) is used to relate an instance of #$TemporalStageSpecification TEMP-STAGE to an instance of #$Time-Quantity QUANT.  TEMP-STAGE will be part of a type-level representation of some type of #$Situation (let's call it SIT-TYPE), such that (#$sitTypeHasTemporalStage SIT-TYPE TEMP-STAGE) holds.  This asserts that in any instance of SIT-TYPE, the duration of all the individual situations that are subsituations of that instance and which bear the relation #$situationFallsUnderStage to TEMP-STAGE cannot have a total duration greater than QUANT.")
(comment endsAfterEndingOf-TempStage "An assertion of the form (#$endsAfterEndingOfTempStage TEMP-STAGE1 TEMP-STAGE2) is used to relate two instances of #$TemporalStageSpecification.  Both will be part of the representation of some type of #$Situation SIT-TYPE, and so will bear the relation #$siblingSpecifications to one another.  This assertion combines with other assertions (most importantly with the predicates #$sitTypeHasTemporalStage and #$situationFallsUnderStage) to provide a type-level description of the temporal ordering of the subsituations of the instances of SIT-TYPE.  Specifically, any individual situation that falls under TEMP-STAGE1 will bear the temporal relation #$endsAfterEndingOf to any individual situation that falls under TEMP-STAGE2.")
(comment startsAfterEndingOf-TempStage "An assertion of the form (#$startsAfterEndingOf-TempStage TEMP-STAGE1 TEMP-STAGE2) is used to relate two instances of #$TemporalStageSpecification.  Both will be part of the representation of some type of #$Situation SIT-TYPE, and so will bear the relation #$siblingSpecifications to one another.  This assertion combines with other assertions (most importantly with the predicates #$sitTypeHasTemporalStage and #$situationFallsUnderStage) to provide a type-level description of the temporal ordering of the subsituations of the instances of SIT-TYPE.  Specifically, any individual situation that falls under TEMP-STAGE1 will bear the temporal relation #$startsAfterEndingOf to any individual situation that falls under TEMP-STAGE2.")
(comment contiguousAfter-TempStage "An assertion of the form (#$contiguousAfter-TempStage TEMP-STAGE1 TEMP-STAGE2) is used to relate two instances of #$TemporalStageSpecification.  Both will be part of the representation of some type of #$Situation SIT-TYPE, and so will bear the relation #$siblingSpecifications to one another.  This assertion combines with other assertions (most importantly with the predicates #$sitTypeHasTemporalStage and #$situationFallsUnderStage) to provide a type-level description of the temporal ordering of the subsituations of the instances of SIT-TYPE.  Specifically, any individual situation that falls under TEMP-STAGE1 will bear the temporal relation #$contiguousAfter to any individual situation that falls under TEMP-STAGE2.")
(comment subSpecification "The predicate #$subSpecification is used to relate one instance of #$SituationSpecification to another instance of #$SituationSpecification. This is the most general predicate for representing this relationship, most of the relevant representations depend on its specializations.  Instances of #$SituationSpecification are used to represent complex structural features that are common to an entire sub-class of #$Situation.")
(comment roleSpecificationForSitTypeAndRole "This is the corresponding predicate for the function #$SitRoleSpecFn.")
(comment SitRoleSpecFn "A #$BinaryFunction, #$SitRoleSpecFn is used to denote an instance of #$RoleSpecification-SitType, an abstract individual which is used to pick out a particular role in the instances of a type of #$Situation. Specifically, an expression of the form (#$SitRoleSpecFn SIT-TYPE ROLE) designates the #$RoleSpecification-SitType that is the representation of the #$BinaryRolePredicate ROLE when played in any instance of the #$Situation type SIT-TYPE.")
(comment RoleSpecification-SitType "A #$FirstOrderCollection and a sub-collection of #$RoleSpecification, #$RoleSpecification-SitType is a collection of abstract individuals that are used for representing roles within complex situations of a given type.  This sub-collection is aimed at the representation of roles in instances of the relevant situation type and not for roles in the subsituations of those instances.  That representational function is covered by the collection #$RoleSpecification-SubSitType.")
(comment specificationRole "The predicate #$specificationRole is used to relate an instance of #$SituationSpecification to an instance of #$BinaryRolePredicate. Instances of #$SituationSpecification are used to represent complex structural features that are common to the instances of an entire sub-class of #$Situation.  This is the most generic predicate for picking out an actor by its role.  It plays a significant role in relation to instances of #$RoleSpecification where it is used to specify the type of #$BinaryRolePredicate which an instance of #$RoleSpecification represents.")
(comment roleCardinality-Max "An assertion of the form (#$roleCardinality-Max ROLE-SPEC INT) is used to represent the minimum number of actors which will fill the role represented by the #$RoleSpecification ROLE-SPEC.  If ROLE-SPEC is a  #$RoleSpecification-SubSitType, given the assertions (#$sitTypeHasSpecification SIT-TYPE ROLE-SPEC) , (#$specificationSubSitType ROLE-SPEC SUB-TYPE), (#$specificationRole ROLE-SPEC ROLE), and (#$specificationStage ROLE-SPEC STAGE), then in any instance of SIT-TYPE in any subsituation of type SUB-TYPE that bears the relation  #$situationFallsUnderStage to the #$TemporalStageSpecification STAGE, then there will exist at most INT things playing ROLE in that subsituation.")
(comment existentialActorType "An assertion of the form (#$existentialActorType ROLE-SPEC TYPE) is used to represent the existence of actors of the type TYPE within the role represented by the #$RoleSpecification ROLE-SPEC.   If ROLE-SPEC is a #$RoleSpecification-SubSitType, given the assertions (#$sitTypeHasSpecification SIT-TYPE ROLE-SPEC) , (#$specificationSubSitType ROLE-SPEC SUB-TYPE), (#$specificationRole ROLE-SPEC ROLE), and (#$specificationStage ROLE-SPEC STAGE), then in any instance of SIT-TYPE in any subsituation of type SUB-TYPE that bears the relation  #$situationFallsUnderStage to the #$TemporalStageSpecification STAGE, then there exists an instance of TYPE that plays ROLE in that subsituation")
(comment RoleSpecification "A #$FirstOrderCollection and a sub-collection of #$SituationSpecification, #$RoleSpecification is a collection of abstract individuals that are used for representing roles within situations.  There specific purpose is to allow an easy means for representing roles within the subsituations of the instances of a given sub-collection of #$Situation. In conjunction with instances of #$RoleMappingSpecification, logical relationships among these roles can be represented (e.g., identity, entailment, difference).")
(comment specificationPredicate "The predicate #$specificationPredicate is used to relate an instance of #$SituationSpecification to an instance of #$BinaryPredicate.  The purpose of this predicate is to help represent the structural features of a complex type of #$Situation.  Specifically, it is used to introduce a #$BinaryPredicate into the representation, for the purposes of depicting a relation between constituents of the instances of that type of #$Situation.  Most commonly, it will be used with an instance of #$InterActorRelationSpecification to represent a relationship between two actors.")
(comment InterActorRelationSpecification "A #$FirstOrderCollection and a sub-collection of #$SituationSpecification, each instance of #$InterActorRelationSpecification is an abstract individual which is used to represent the holding of a relationship between actors within the instances of a given type of #$Situation.")
(comment interActorRelnSpecForSitType "This is the corresponding predicate for the function #$InterActorRelnSpecFn.")
(comment InterActorRelnSpecFn "A #$BinaryFunction and #$IndividualDenotingFunction, the function #$InterActorRelnSpecFn is used to represent instances of #$InterActorRelationSpecification.  So, an expression of the form (#$InterActorRelnSpecFn SIT-TYPE N) is used to pick out an instance of #$InterActorRelationSpecification, which will bear the relation #$sitTypeHasSpecification to SIT-TYPE, some sub-collection of #$Situation.  For this function, the second argument, an instance of #$PositiveInteger, is not significant.  It serves only to differentiate instances.")
(comment sitTypeHasRoleSpecification "The predicate #$sitTypeHasRoleSpecification is used to relate a sub-collection of #$Situation to an instance of #$RoleSpecification.  This predicate is a specialization of the predicate #$sitTypeHasSpecification and is used for inferences involving roles in individual situations based on type-level knowledge of that situation.  Specifically, this predicate relates the type of situation to abstract individuals that are used to represent the properties of and  relations among roles in the instances of that type of situation.")
(comment specificationStage "The predicate #$specificationStage is used to relate an instance of #$SituationSpecification to an instance of #$TemporalStageSpecification.  Instances of #$SituationSpecification are used to represent complex structural features that are common to the instances of an entire sub-class of #$Situation.  It can play a significant role in relation to instances of #$RoleSpecification where it is used to specify the relevant #$TemporalStageSpecification which a particular type of subsituation falls under.")
(comment RoleSpecification-SubSitType "A #$FirstOrderCollection and a sub-collection of #$RoleSpecification, #$RoleSpecification-SubSitType is a collection of abstract individuals that are used for representing roles within complex situations of a given type.  This sub-collection is aimed at the representation of roles in the subsituations of instances of the relevant situation type and not for roles in the 'top-level' situations.  The  function of representing top-level is covered by the collection #$RoleSpecification-SitType.")
(comment temporalStageIsNthForSitType "This is the corresponding predicate of the function #$TemporalStageFn.")
(comment TemporalStageFn "An expression of the form (#$TemporalStageFn SIT-TYPE N) is used to denote a #$TemporalStageSpecification for the sub-collection of #$Situation SIT-TYPE.  The argument N is introduced to create unique results and does not have a specific meaning.")
(comment sitTypeHasNthRoleMapping "This is the corresponding predicate for the function #$SitTypeRoleMappingFn.")
(comment SitTypeRoleMappingFn "An #$IndividualDenotingFunction and #$BinaryFunction, an expression of the form (#$SitTypeRoleMappingFn SIT-TYPE N) represents an instance of #$RoleMappingSpecification which will bear the relation #$sitTypeHasRoleSpecification from SIT-TYPE.  This will be used to represent relationships among the actors that play roles in instances of SIT-TYPE.  The argument N is introduced to create unique results and does not have a specific meaning.")
(comment RoleMappingSpecification "A #$FirstOrderCollection and a sub-collection of #$SituationSpecification, #$RoleMappingSpecification is a collection of abstract individuals that are used for representing the relationships among roles in the instances of a given type of #$Situation and in the subsituations of those instances.  Instances of #$RoleMappingSpecification typically relate several instances of #$RoleSpecification to establish logical connections among roles, where these connections include entailment, identity, and difference.")
(comment roleCardinality-Min "An assertion of the form (#$roleCardinality-Min ROLE-SPEC INT) is used to represent the minimum number of actors which will fill the role represented by the #$RoleSpecification ROLE-SPEC.  Given the assertions (#$sitTypeHasSpecification SIT-TYPE ROLE-SPEC) , (#$specificationSubSitType ROLE-SPEC SUB-TYPE), (#$specificationRole ROLE-SPEC ROLE), and (#$specificationStage ROLE-SPEC STAGE), then in any instance of SIT-TYPE in any subsituation of type SUB-TYPE that bears the relation  #$situationFallsUnderStage to the #$TemporalStageSpecification STAGE, then there will exist at least INT things playing ROLE in that subsituation.")
(comment subSpecification-Subject "The predicate #$subSpecification-Subject is used to relate one instance of #$SituationSpecification to another instance of #$SituationSpecification.  Its specific purpose is for establishing relationships among the parts of an instance of some sub-collection of #$Situation.  Typically, it will be part of the representation of a relationship between two things that are constituents of a situation.  This predicate can be used to establish that one thing would fill the first argument in that relation.  Also, it is used for representing entailments.  For instance, it is used in conjunction with instances of #$RoleMappingSpecification to pick out a role within a situation to represent that the playing of that role will entail the playing of another role.  The predicate #$subSpecification-Object complements this predicate.")
(comment subSpecification-Object "The predicate #$subSpecification-Object is used to relate one instance of #$SituationSpecification to another instance of #$SituationSpecification.  Its specific purpose is for establishing relationships among the parts of an instance of some sub-collection of #$Situation.  Typically, it will be part of the representation of a relationship between two things that are constituents of a situation.  This predicate can be used to establish that one thing would fill the second argument in that relation.  Also, it is used for representing entailments.  For instance, it is used in conjunction with instances of #$RoleMappingSpecification to pick out a role within a situation that is entailed by an individual playing some other role in that same situation.  The predicate #$subSpecification-Subject complements this predicate.")
(comment roleSpecificationForStageSubSitAndRole "The corresponding predicate of the function #$StageSubSitRoleSpecFn.")
(comment StageSubSitRoleSpecFn "A #$TernaryFunction, #$StageSubSitRoleSpecFn is used to denote an instance of #$RoleSpecification-SubSitType, an abstract individual which is used to pick out a particular role in the subsituations of a type of #$Situation.    An expression of the form (#$StageSubSitRoleSpecFn TEMP-STAGE SUBSIT-TYPE ROLE) designates the #$RoleSpecification-SubSitType that is the representation of the #$BinaryRolePredicate ROLE when played in an instance of the #$Situation type SUBSIT-TYPE when it is a subsituation of some instance of the #$Situation type, SIT-TYPE. This function is distinct from #$SubSitRoleSpecFn because it triangulates on the role by referring to an instance of #$TemporalStageSpecification. ")
(comment roleMapSpecification-Disjoint "The predicate #$roleMapSpecification-Disjoint is used to represent that, in the instances of a given type of #$Situation and in those instances subsituations, that the actors in particular roles must be numerically different individuals.  An assertion of the form (#$roleMapSpecification-Disjoint SIT-YPE RM-SPEC) connects the #$RoleMappingSpecification to the type of #$Situation to which it applies, SIT-TYPE.  RM-SPEC will be associated with several instances of #$RoleSpecification, each of these will pick out a role either in the instances of SIT-TYPE themselves or in their subsituations.   Specifically, given the assertions (#$subSpecification-Subject RM-SPEC ROLE-SPEC1) and (#$subSpecification-Object RM-SPEC ROLE-SPEC2), then any individual who plays the role picked out by ROLE-SPEC1 in an instance of SIT-TYPE cannot also play the role picked out by ROLE-SPEC2 in the same instance of SIT-TYPE.  It is possible for RM-SPEC to be connected to many instances of #$RoleSpecification.  Although the label 'disjoint' on this predicate indicates a symmetric relationship, this predicate is associated with the predicates #$subSpecification-Subject and #$subSpecification-Object in order to efficiently represent multiple disjoint roles through a single instance of #$RoleMappingSpecification.  Thus, if it is known that one set of roles is disjoint with another set of roles and each set shares actors among its roles, then one set can be picked out with the 'subject' predicate and the other can be picked out with the 'object' predicate without entailing any unwanted disjointness claims.")
(comment subSpecification-Symmetric "The predicate #$subSpecification-Symmetric is used to relate one instance of #$SituationSpecification to another instance of #$SituationSpecification.  Its specific purpose is for establishing a symmetric relationships among the parts of an instance of some sub-collection of #$Situation.  It is the common specialization of the predicates #$subSpecification-Object and #$subSpecification-Subject.")
(comment roleMapSpecification-Identity "The predicate #$roleMapSpecification-Identity is used to represent that, in the instances of a given type of #$Situation and in those instances subsituations, exactly one individuals plays some set of roles.  An assertion of the form (#$roleMapSpecification-Identity SIT-YPE RM-SPEC) connects the #$RoleMappingSpecification to the type of #$Situation to which it applies, SIT-TYPE.  RM-SPEC will be associated with several instances of #$RoleSpecification, each of these will pick out a role either in the instances of SIT-TYPE themselves or in their subsituations.   Specifically, given the assertions (#$subSpecification-Symmetric RM-SPEC ROLE-SPEC1) and (#$subSpecification-Symmetric RM-SPEC ROLE-SPEC2), then any individual who plays the role picked out by ROLE-SPEC1 in an instance of SIT-TYPE will also play the role picked out by ROLE-SPEC2 in the same instance of SIT-TYPE and, vice versa.  It is possible for RM-SPEC to be connected to many instances of #$RoleSpecification, any two which are connected by the relation #$subSpecification will have identical actors.  If a situation type has multiple role mappings of this sort, but they cover different roles, one should introduce a #$RoleMappingSpecification for each pattern.")
(comment roleMapSpecification-Subset "The predicate #$roleMapSpecification-Subset is used to represent an implication relation among the roles in the instances of a given type of #$Situation and in those instances subsituations.  An assertion of the form (#$roleMapSpecification-Subset SIT-YPE RM-SPEC) connects the #$RoleMappingSpecification to the type of #$Situation to which it applies, SIT-TYPE.  RM-SPEC will be associated with several instances of #$RoleSpecification, each of these will pick out a role either in the instances of SIT-TYPE themselves or in their subsituations.  The direction of the implication will be based on how RM-SPEC is connected to the instances of #$RoleSpecification.  Specifically, given the assertions (#$subSpecification-Subject RM-SPEC ROLE-SPEC1) and (#$subSpecification-Object RM-SPEC ROLE-SPEC2), then any individual who plays the role picked out by ROLE-SPEC1 in an instance of SIT-TYPE will also play the role picked out by ROLE-SPEC2 in the same instance of SIT-TYPE.  It is possible for RM-SPEC to be connected to many instances of #$RoleSpecification by the predicates #$subSpecification-Object, #$subSpecification-Subject, or their common specialization #$subSpecification-Symmetric.  Regardless of the number, if one #$RoleSpecification is related to RM-SPEC by #$subSpecification-Subject and another #$RoleSpecification is related to RM-SPEC by #$subSpecification-Object, anything playing the first depicted role will also play the second depicted role. In roles have divergent entailments, on should introduce a #$RoleMappingSpecification to represent each entailment pattern.")
(comment roleTypeRestriction "An assertion of the form (#$roleTypeRestriction ROLE-SPEC TYPE) is used to represent a restriction on the type of actor which will fill the role represented by the #$RoleSpecification ROLE-SPEC.   If ROLE-SPEC is a #$RoleSpecification-SubSitType, given the assertions (#$sitTypeHasSpecification SIT-TYPE ROLE-SPEC) , (#$specificationSubSitType ROLE-SPEC SUB-TYPE), (#$specificationRole ROLE-SPEC ROLE), and (#$specificationStage ROLE-SPEC STAGE), then in any instance of SIT-TYPE in any subsituation of type SUB-TYPE that bears the relation  #$situationFallsUnderStage to the #$TemporalStageSpecification STAGE, then only instances of TYPE can play ROLE in that subsituation.")
(comment roleSpecificationforSubSitTypeAndRole "This is the corresponding predicate of the function #$SubSitRoleSpecFn.")
(comment SubSitRoleSpecFn "A #$TernaryFunction, #$SubSitRoleSpecFn is used to denote an instance of #$RoleSpecification-SubSitType, an abstract individual which is used to pick out a particular role in the subsituations of a type of #$Situation.  Specifically, an expression of the form (#$SubSitRoleSpecFn SIT-TYPE SUBSIT-TYPE ROLE) designates the #$RoleSpecification-SubSitType that is the representation of the #$BinaryRolePredicate ROLE when played in an instance of the #$Situation type SUBSIT-TYPE when it is a subsituation of some instance of the #$Situation type, SIT-TYPE.")
(comment programUsesQuerySpecification "(#$programUsesQuerySpecification PROGRAM QUERY-SPEC) says that the instance of #$CycLQuerySpecification QUERY-SPEC is one of the query specifications mentioned in and used by the code of the #$CycRelatedProgram PROGRAM.")
(comment JavaClassFn "(#$JavaClassFn STRING) denotes the instance of #$JavaClass whose fully qualified java class name is STRING.  See also #$javaClassName-LongForm, which is the #$functionCorrespondingPredicate for #$JavaClassFn.")
(comment javaClassName-LongForm "(#$javaClassName-LongForm CLASS STRING) identifies STRING as the long-form name of the java class CLASS.  Because long-form java class names are fully qualified, For example, (#$javaClassName-LongForm OpenType-JavaClass \"javax.management.openmbean.OpenType\") identifies \"javax.management.openmbean.OpenType\" as the class name of the public abstract class <code>OpenType</code>.")
(comment populationOfRegion "A #$MeasurableQuantitySlot for stating the size of a specified population living in a given #$GeographicalRegion or in the territory of a given #$GeopoliticalEntity.  <code>(#$populationOfRegion GEO COUNT)</code> means that <code>COUNT</code> is a #$CountQuantity (q.v.) that represents the number of beings of the type <code>TYPE</code> (typically, <i>humans</i>) counted by <code>COUNT</code> that are living in (or in the territory of) <code>GEO</code>.  In practice <code>COUNT</code> will normally be given in the form <code>((#$UnitOfCountFn TYPE) NUMBER)</code>.  For example,
<pre>
  (#$populationOfRegion #$IvoryCoast ((#$UnitOfCountFn #$Person) 15000000)</code>
</pre>
<p>
means that 15 million people live in the Ivory Coast.
<p>
Note that, when <code>TYPE</code> is #$Person (or #$HomoSapiens), <code>NUMBER</code> is not necessarily the same as the number of <i>citizens</i> of <code>GEO</code>, since citizens may be living abroad, and aliens may be residing in <code>GEO</code>.  Note also that a sentence using #$populationOfRegion should generally be asserted in a #$TemporalMicrotheory (q.v.), as the number of people living in a region often changes over time.
<p>
See #$numberOfInhabitants for a similar predicate that relates a region directly to a number.")
(comment InterpreterOfJavaClassFn "(#$InterpreterOfJavaClassFn CLASS) denotes the instance of #$JavaVirtualMachine that interprets the instance CLASS of #$JavaClass.  See also #$interpreterOfJavaClass.")
(comment interpreterOfJavaClass "(#$interpreterOfJavaClass INTERPRETER CLASS) identifies CLASS as the instance of #$JavaClass for which INTERPRETER is the instance of #$JavaVirtualMachine that interprets CLASS. See also #$InterpreterOfJavaClassFn, for which this is the #$functionCorrespondingPredicate.")
(comment javaSideImplementationOfProgram "(#$javaSideImplementationOfProgram JAVA-PROGRAM PROGRAM) identifies JAVA-PROGRAM as the instance of #$JavaVirtualMachine that executes the java side of the program MODULE.")
(comment NextIntegerInSequenceFn "Terms of the form (#$NextIntegerInSequenceFn FORT) will be evaluated at the EL (e.g. at assert time).  They will evaluate to 0 if the term has not been evaluated before, otherwise they will evaluate to 1 more than the last evaluation.  Note that #$NextIntegerInSequenceFn is not technically a function, because it will evaluate to different values given the same argument.")
(comment AdministrativeHearing "A specialization of #$Hearing-LegalProceeding.  Each instance of #$AdministrativeHearing is a hearing before either a governmental agency or an administrative judge.")
(comment Hearing-LegalProceeding "A specialization of #$LegalProceeding.  Each instance of #$Hearing-LegalProceeding is a legal proceeding held before a judge or other magistrate, but without a jury.  In each instance of #$Hearing-LegalProceeding, evidence is presented, and arguments are heard, to determine some issue of fact or law.  Important specializations of #$Hearing-LegalProceeding include #$PreliminaryHearing and #$AdministrativeHearing.")
(disjointWith Trial PreliminaryHearing)
(comment PreliminaryHearing "A specialization of #$Hearing-LegalProceeding.  Each instance of #$PreliminaryHearing is a hearing to determine if a person charged with a felony should be tried for the crime charged.")
(disjointWith PreliminaryHearing AdministrativeHearing)
(comment trialCharges "An instance of #$BinaryRolePredicate.  (#$trialCharges TRIAL CHARGE) means that CHARGE is one of the charges to be decided at the #$Trial-Criminal TRIAL.")
(comment RecruitingActivity-Terrorist "The collection of activities in which a recruiting officer or other representative of a #$TerroristGroup attempts to persuade someone to commit to joining that organization, or to participating in a terrorist attack sponsored by the organization.")
(disjointWith RecruitingActivity-Military RecruitingActivity-Terrorist)
(disjointWith RecruitingActivity-Sports RecruitingActivity-Terrorist)
(comment SecularSchool "The collection of all secular schools.  Some are single site organizations, while others have branches.  This collection is disjoint with #$ReligiousSchool.")
(disjointWith SecularSchool ReligiousSchool)
(comment ReligiousSchool "The collection of all religious schools.  Some are single site organizations, while others have branches.  This collection is disjoint with #$SecularSchool.")
(comment IslamicSchool "The collection of all religious schools that teach the Islamic faith.  Some are single site organizations, while others have branches.")
(comment ChristianSchool "The collection of all religious schools that teach the Christian faith or are run or administered by some Christian organization.  Some are single site organizations, while others have branches.")
(comment MySentientKEIrrelevanceForQuestionAnsweringMt "An instance of #$ApplicationContext that contains assertions tagging constants as keIrrelevant for purposes of answering user's questions.")
(comment NaturalLanguageString "A specialization of #$CharacterString.  Each instance of this 
collection is a valid word or a phrase in a natural language.  Thus, each 
instance is a string of characters of a particular natural language.  The 
string may also include numerals and special characters like '-' (hyphen), ',' 
(comma), single and double quotes, parentheses, spaces, etc.")
(comment PersonTypeByLegalRecord "A collection of collections.  Each instance of #$PersonTypeByLegalRecord is a collection of persons that share a similar legal record.  For example, #$PersonWithCriminalRecord is the collection of individuals with criminal records.")
(comment termStringsViaWordNet "<code>(#$termStringsViaWordNet THING STRING)</code> means that <code>THING</code>  is a denotation of <code>STRING</code> via #$WordNet-1997Version.  In other words,  THING is directly linked to STRING in #$WordNet-1997Version.  STRING is present in one of the synsets of WordNet-1997Version and the synset corresponds (see  #$synonymousExternalConcept) to THING in the Cyc World.")
(comment teacherOf "(#$teacherOf STUDENT TEACHER)<MT TIME PAR> holds just in case, in MT at TIME to PAR, STUDENT is a student of TEACHER.  This applies to both formal education and informal education.")
(comment religiousTeacherOf "(#$religiousTeacherOf STUDENT TEACHER)<MT TIME PAR> holds just in case, in MT at TIME to PAR, STUDENT is a student of TEACHER and TEACHER is giving STUDENT some sort of religious instruction.  This applies to both formal religious education and informal religious education.")
(comment SuggestUserRedirects-ClarificationStrategy "An instance of #$ClarificationStrategy in which one suggests resources on the web that might be of interest to the speaker in the course of a dialogue.")
(comment PublicOffice "A collection of collections and a specialization of #$PersonTypeByPositionInOrg.  This is the collection of all public offices, whether filled by election (see #$ElectedOfficial),  filled by appointment (see #$AppointedOffice), or hereditary (see #$HereditaryOffice).
<p>
Instances of #$PublicOffice include #$Mayor, #$UnitedStatesPresident, and #$Ambassador.")
(comment recommendedURLWithRedirectString "(#$recommendedURLWithRedirectString AGENT URL AIS) says that it is recommended that the instance of #$IntelligentAgent AGENT visit the url URL as presented with the abstract information structure AIS (e.g., AIS might be a GIF or a piece of text).")
(comment ChiefOfStaff "A specialization of #$PublicOfficial (q.v.).  Typically, a #$ChiefOfStaff heads the office or personal staff of an important public official.  For example, the White House Chief of Staff is the highest-ranking member of the Executive Office of the President of the United States; a Congressional Chief of Staff heads the office of a member of the United States Congress.
<p>
Note that a #$ChiefOfStaff in the present sense is not to be confused with a military chief of staff.  Cf. #$chiefOfStaff-Military, and see the specializations of #$CoordinatingStaffMember-USArmy.")
(comment SuggestSpecPred-ClarificationStrategy "An instance of #$ClarificationStrategy.  When presented a query that does not answer, a system that executes this strategy will ask the speaker whether a more specific fact holds, from which the query can be answered via #$genlPreds reasoning.")
(comment receivedIdentificationDocumentFrom "(#$receivedIdentificationDocumentFrom AGT-1 AGT-2) holds just in case AGT-1 received some sort of identification document from AGT-2.")
(comment travelledTo "(#$travelledTo AGENT LOCATION)<MT TIME PAR> holds just in case, in MT (to PAR), there exists a time, TIME* earlier than TIME such that AGENT arrived at LOCATION from somewhere else at TIME*.")
(comment travelledFrom "(#$travelledFrom AGENT LOCATION)<MT TIME PAR> holds just in case, in MT (to PAR), there exists a time, TIME* earlier than TIME such that AGENT left LOCATION to travel somewhere else at TIME*.")
(comment visitedWebsite "(#$visitedWebsite AGT WEBSITE) holds just in case sometime in the past AGT visited WEBSITE.")
(comment userSkippedSentence "(#$userSkippedSentence SENTENCE) means that some user of an automated review tool skipped SENTENCE, either by pushing a 'skip' button or by simply not answering the question.")
(comment ProjectManagement-TemplateTopic "An instance of #$FormulaTemplateTopicType.  Instances are collections of instances of #$FormulaTemplate used to create new instances of #$Assignment-Specification and #$ResourceAllocationSpecification for project management.")
(comment ProjectManagement-TemplateTopic "An instance of #$FormulaTemplateTopicType.  Instances are collections of instances of #$FormulaTemplate used to create new instances of #$Assignment-Specification, #$ResourceRequest, and #$Allotment for project management.")
(comment wasEnrolledAt "(#$wasEnrolledAt AGT1 EDU)<MT TIME #$TimePoint> holds in MT at TIME (to #$TimePoint parameter) just in case there was some earlier time TIME* such that AGT1 was enrolled at EDU at TIME*.")
(comment depositedFundsTo "(#$depositedFundsTo AGT-1 AGT-2) holds just in case AGT-1 deposited funds to AGT-2.  This relation most often holds between an individual in arg1 and some sort of financial institution in arg2.")
(comment assignedStrategyConfidence "An instance of #$StrictlyFunctionalSlot that relates an instance of #$ProblemSolvingStrategy to a real number between 0 and 1 that represents a confidence in the success of any application of the strategy to an applicable problem.  #$assignedStrategyConfidence is intended to enable end-users or customers to override #$defaultStrategyConfidence, which also assigns a confidence.")
(comment defaultStrategyConfidence "An instance of #$StrictlyFunctionalSlot that relates an instance of #$ProblemSolvingStrategy to a real number between 0 and 1 that represents a default confidence in the success of any application of the strategy to an applicable problem.")
(comment strategyImplementationRules "A specialized version of #$salientAssertions.  (#$strategyImplementationRules STRATEGY RULE) identifies RULE as one of the rules that is used during inference in the implementation of the instance of #$Strategy STRATEGY.")
(comment unreservedWorkTimeAvailableFromForDuring "An assertion of the form (#$unreservedWorkTimeAvailableFromForDuring QUANT IND AGENT INTERVAL) is used to express the amount of work time (the #$Time-Quantity QUANT) of the #$IntelligentAgent IND that the  #$Agent-Generic AGENT can, by default, make further reservations on during the #$TimeInterval INTERVAL.  QUANT is determined by subtracting from the #$Time-Quantity represented relative to an instance of #$RootAllotment for IND.")
(comment allotmentAuthority "An assertion of the form (#$allotmentAuthority ALLOT AGENT) states that the instance of #$Allotment ALLOT is under the purview of the #$Agent-Generic AGENT.  For example, if ALLOT reserves a number of workers for a particular assignment and AGENT is the manager of those workers who decided on the properties of ALLOT (i.e., who will be working on what assignment and for how long), then AGENT would bear the relation #$allotmentAuthority from ALLOT.")
(comment holidayTypeForOrganization "This is the corresponding predicate of the #$CollectionDenotingFunction #$HolidayOfOrganizationFn.  It relates a sub-collection of #$Weekday to the #$Organization that recognizes those instances of #$Weekday as holidays, thereby suspending normal operations.")
(comment HolidayOfOrganizationFn "A collection denoted by a NART of the form (#$HolidayOfOrganizationFn ORG) is the collection of all the instances of #$Weekday where normal operations of the #$Organizaion ORG are suspended for the sake of recognizing significant social or cultural events or simply giving the members of ORG some time off from their normal duties.")
(comment studentOf "(#$studentOf TEACHER STUDENT)<MT TIME PAR> holds just in case, in MT at TIME to PAR, STUDENT is a student of TEACHER.  This applies to both formal education and informal education.")
(comment religiousStudentOf "(#$religiousStudentOf TEACHER STUDENT)<MT TIME PAR> holds just in case, in MT at TIME to PAR, STUDENT is a student of TEACHER.  This applies to both formal education and informal education.")
(comment cellSubordinate "(#$cellSubordinate CELL PERSON) means that PERSON is a subordinate member of the terrorist cell CELL.")
(comment cellLeader "(#$cellLeader CELL LEADER) means that LEADER is a leader of the terrorist cell CELL.")
(comment AnimalBodyPart-External "An #$AnimalBodyPartType.  #$AnimalBodyPart-External is the #$collectionIntersection of #$AnimalBodyPart and #$ExternalAnatomicalPart.")
(comment Riskiness "A specialization of #$Quantity-ScriptUse.  This is the collection of all the instances of #$Quantity-ScriptUse that represent various levels of riskiness with respect to events.")
(comment operationsHead "(#$operationsHead ORG MEMBER) holds just in case MEMBER is one of the heads/directors of operations for ORG.")
(comment JavaPackage "The collection of all instances of #$SourceCodePackage written in Java.  See also #$programSourceCodeWrittenIn and #$JavaProgrammingLanguage.")
(comment SourceCodePackageTypeByLanguage "A collection that facets #$SourceCodePackage into collections of instances of source code packages that share a common instance of #$AbstractProgrammingLanguage.")
(comment SemTransTemplateFn "(#$SemTransTemplateFn FRAME HEAD-TYPE PRED-LIST) returns the #$NLTemplateExpression for the semantics of an NL expression that uses FRAME, whose head denotes an instance of HEAD-TYPE, and whose semantic arguments are related to its head-denotatum by the predicates in PRED-LIST.")
(comment subcatFrameHeadKeyword "(#$subcatFrameHeadKeyword FRAME KEYWORD) indicates that KEYWORD is the SubLKeyword that represents the denotation of the head word in a phrase that uses the SubcategorizationFrame FRAME.")
(comment technicalSpecialistForOrg "(#$technicalSpecialistForOrg ORG MEMBER) holds just in case MEMBER is one of the technical specialists for ORG.")
(comment explosivesExpertForOrg "(#$explosivesExpertForOrg ORG MEMBER) holds just in case MEMBER is one of the explosives experts in ORG.")
(comment InterpreterOfJavaPackageFn "(#$InterpreterOfJavaPackageFn PACKAGE) denotes the instance of #$JavaVirtualMachine that interprets the instance PACKAGE of #$JavaPackage.  See also #$interpreterOfJavaPackage.")
(comment interpreterOfJavaPackage "(#$interpreterOfJavaPackage INTERPRETER PACKAGE) identifies PACKAGE as the instance of #$JavaPackage for which INTERPRETER is the instance of #$JavaVirtualMachine that interprets PACKAGE. See also #$InterpreterOfJavaPackageFn, for which this is the #$functionCorrespondingPredicate.")
(comment leastRequestedInstanceOfCollForOrgDuring "An assertion of the form (#$leastRequestedInstanceOfCollForOrgDuring INDIVIDUAL COLLECTION ORGANIZATION INTERVAL) is used to express the least 'in demand' element of a collection of resources for a particular organization during a particular time interval.  So, INDIVDIUAL would be the instance of the #$FirstOrderCollection COLLECTION that the #$Organization has some rights over (i.e., #$employees) during the #$ContinuousTimeInterval INTERVAL. So, the assertion (#$leastRequestedInstanceOfCollForOrgDuring Joe #$CurrentCycorpEmployee #$Cycorp (#$MonthFn #$March (#$YearFn 2004))) would mean that Joe is the least requested instance of #$CurrentCycorpEmployee by #$Cycorp for March, 2004.")
(comment mostRequestedInstanceOfCollForOrgDuring "An assertion of the form (#$mostRequestedInstanceOfCollForOrgDuring INDIVIDUAL COLLECTION ORGANIZATION INTERVAL) is used to express the most 'in demand' element of a collection of resources for a particular organization during a particular time interval.  So, INDIVDIUAL would be the instance of the #$FirstOrderCollection COLLECTION that the #$Organization has some rights over (i.e., #$employees) during the #$ContinuousTimeInterval INTERVAL. So, the assertion (#$mostRequestedInstanceOfCollForOrgDuring #$Goolsbey #$CurrentCycorpEmployee #$Cycorp (#$MonthFn #$March (#$YearFn 2004))) would mean that #$Goolsbey is the most requested instance of #$CurrentCycorpEmployee by #$Cycorp for March, 2004.")
(comment financierForOrg "(#$financierForOrg ORG MEMBER) holds just in case MEMBER is one of the heads/directors of finances for ORG.")
(comment javaPackageName-LongForm "(#$javaPackageName-LongForm PACKAGE STRING) identifies STRING as the long-form name of the java package PACKAGE.  Because long-form java package names are fully qualified, For example, (#$javaPackageName-LongForm GnuXmlUtil-GNUJavaPackage \"gnu.xml.util\") identifies \"gnu.xml.util\" as the name of the gnu java package for XML utilities.")
(comment verbSemTransTemplate-Canonical "(#$verbSemTransTemplate-Canonical COL FRAME PRED-LIST) means that the translation of any verb denotation of a word denoting a specialization of COL, appearing with subcategorization frame FRAME, is the canonical template for that denotation with FRAME and PRED-LIST.")
(disjointWith TransportationDeviceType PersonTypeByReligiousBackground)
(disjointWith ServiceTypeFrequentlyForSale PersonTypeByReligiousBackground)
(comment NonReligiousBackground "The collection of instances of #$Person whose families are such that religion doesn't play a significant role in their lives.  This doesn't entail that the instances of this collection are non-religious.")
(comment ReligiousBackground "The collection of instances of #$Person whose families are such that religion plays a significant role in their lives.  This doesn't entail that the instances of this collection are religious.")
(comment Muslim-ReligiousBackground "The collection of instances of #$Person whose families are such that Islam plays a significant role in their lives.  This doesn't entail that the instances of this collection are believers of the Islamic creed.")
(comment NonMuslimReligiousBackground "The collection of instances of #$Person whose families are such that Islam doesn't play a significant role in their lives.  This doesn't entail that the instances of this collection are non-religious or that their families are not of some other religious background.")
(comment NonChristianReligiousBackground "The collection of instances of #$Person whose families are such that Christianity doesn't play a significant role in their lives.  This doesn't entail that the instances of this collection are non-religious or that their families are not of some other religious background.")
(comment processTypeForAccomplishmentType "A #$StrictlyFunctionalSlot and a specialization of #$genls.  #$processTypeForAccomplishmentType relates an #$AccomplishmentType to its corresponding #$CumulativeEventType.  <code>(#$processTypeForAccomplishmentType ACC-TYPE PROC-TYPE)</code> means that the #$CumulativeEventType corresponding to <code>ACC-TYPE</code> is <code>PROC-TYPE</code>.  This is the predicate corresponding to #$ProcessFn (q.v.).")
(comment ProcessFn "A #$UnaryFunction that takes an #$AccomplishmentType and returns the corresponding #$ProcessType.  <code>(#$ProcessFn ACC-TYPE)</code> denotes the \"process\" version of <code>ACC-TYPE</code>.  For example, whereas each instance of #$ConstructingABuilding is an event in which a complete building is fully constructed, each instance of (#$ProcessFn #$ConstructingABuilding) is an event in which some progress is made toward the construction of a building.  Thus
<p>
(#$relationAllExists #$outputsCreated #$ConstructingABuilding #$Building)
<p>
holds, but
<p>
(#$relationAllExists #$outputsCreated (#$ProcessFn #$ConstructingABuilding) #$Building)
<p>
does not.
<p>
For any #$AccomplishmentType <code>ACC-TYPE</code>, <code>ACC-TYPE</code> is a specialization of (#$ProcessFn <code>ACC-TYPE)</code>.  Suppose a construction crew spends a day building just the foundation of a house.  This event is an instance of (#$ProcessFn #$ConstructingABuilding), but not an instance of #$ConstructingABuilding.  Now consider the event which comprises the entire construction of the house, from start to finish.  This is an instance of both #$ConstructingABuilding and (#$ProcessFn #$ConstructingABuilding).")
(comment SagemanPersonalAssociationPredicate "The collection of personal association predicates used in representing Marc Sageman's spreadsheet of Al Qaida individuals")
(disjointWith LendingLibrary-Organization ReferenceLibrary-Organization)
(comment ReferenceLibrary-Organization "A specialization of #$Library-Organization.  This is the         collection of all library organizations that allow access to the  items in their #$LibraryHoldings only within the premises of the         library.  Cf. #$LendingLibrary-Organization.")
(comment Sharpshooter "A collection of persons who have significant skill with a projectile weapon.  People in this collection typically engage in instances of #$MarksmanshipSportsEvent.")
(comment answerSourceIBT-RejectedByUser "A predicate used to represent and facilitate dialogue.  (#$answerSourceIBT-RejectedByUser IBT USER) says that the instance of #$InformationBearingThing IBT has, in the current dialogue model, been deemed a bad source document of information, by virtue of its content having been presented to, and rejected by, the end user USER.")
(comment AirplaneCrash "A specialization of #$TransporterCrashEvent. Each instance of #$AirplaneCrash is an event in which an airplane crashes, either as caused by an agent who intended the crash, or as an accident (see #$AirplaneCrash-Accidental).")
(comment MilitaryCommittee-Organization "The collection of instances of military committees within an organization.  Each instance of this collection is a sub-organization of some organization and is responsible for overseeing and planning the organization's military operations.")
(comment FinanceAndLogisticsCommittee-Organization "The collection of instances of finance/logistics committees within an organization.  Each instance of this collection is a sub-organization of some organization and is responsible for overseeing the economic/logistical aspects of the organization's operations.")
(comment MediaRelationsCommittee-Organization "The collection of instances of public/media relations committees within an organization.  Each instance of this collection is a sub-organization of some organization and is responsible for promoting the image of the organization to the general public or media.")
(comment localChiefInOrganization "(#$localChiefInOrganization ORG PERSON) holds just in case PERSON is a member of
ORG and has local jurisdiction.  In other words, PERSON has some leadership role in ORG, but is limited to leading members that are from the same geographical region (at at fairly local level) as PERSON.")
(comment subordinateMemberOfOrganization "(#$subordinateMemberOfOrganization ORG PERSON) holds just in case PERSON is a subordinate member of ORG.  This is the #$negationPreds to #$hasLeadershipPosition.")
(comment MidairCollision "A specialization of #$TransporterCrashEvent.  Each instance of #$MidairCollision is an event in which one airborne transporter (see #$AirTransportationDevice) collides with another, either as caused by an agent who intended the crash, or as an accident.")
(comment hasResourceRequest "An assertion of the form (#$hasResourceRequest SPEC REQUEST) is used to relate an instance of #$NormativeSpecification to the individual instances of #$ResourceRequest.  This relation states that REQUEST amounts to resources that some agent wants to use for the satisfaction of SPEC.")
(comment resourceRequestForOfDuring "The corresponding predicate for the function #$ResourceRequestForOfDuringFn.")
(comment hasAllotment "An assertion of the form (#$hasAllotment SPEC ALLOT) is used to relate an instance of #$NormativeSpecification to the individual instances of #$Allotment.  This relation states that REQUEST amounts to resources that some agent wants to use for the satisfaction of SPEC.")
(comment AllotmentForOfDuringFn "A function for denoting an instance of #$Allotment.  This function assumes that given a specific instance of #$SomethingExisting, an instance of #$NormativeSpecification, and a specific instance of #$ContinuousTimeInterval, then there is only one #$Quantity that can be alloted. Note: For smaller and larger instances of #$ContinuousTimeInterval there can be different instances of #$Allotment for that same #$SomethingExisting and same #$NormativeSpecification.")
(comment allotmentForOfDuring "The corresponding predicate for the function #$AllotmentForOfDuringFn.")
(comment organizationHasFacilityWithAddress "An instance of #$StrictlyFunctionalPredicate.  <code>(#$organizationHasFacilityWithAddress ORGANIZATION FACILITY ADDRESS-TEXT)</code> identifies <code>FACILITY</code> as the instance of #$ContactLocation that is a facility (see #$orgFacilities) of the instance of #$Organization <code>ORGANIZATION</code> with the address denoted by <code>ADDRESS-TEXT</code>.")
(comment OrganizationFacilityFn "An instance of #$Function-Denotational that takes an instance of #$Organization and a string denoting a full address, and denotes the facility controlled by that organization at that address.")
(comment crashTypeOfTransporterType "<code>(#$crashTypeOfTransporterType TRANS-TYPE CRASH-TYPE)</code> means that <code>CRASH-TYPE</code> is the specialization of #$TransporterCrashEvent in which transporters of type <code>TRANS-TYPE</code> (a specialization of #$TransportationDevice) crash.  For example,(#$crashTypeOfTransporterType #$Airplane #$AirplaneCrash) is true, and it means that #$AirplaneCrash is the collection of transporter crash events in which airplanes crash.  #$crashTypeOfTransporterType is the predicate corresponding to #$CrashOfTransporterTypeFn (q.v.).")
(comment CrashOfTransporterTypeFn "A #$UnaryFunction that takes a specialization of #$TransportationDevice and returns the corresponding collection of #$TransporterCrashEvents.  <code>(#$CrashOfTransporterTypeFn TRANS-TYPE)</code> is the collection of events in which transporters of type <code>TRANS-TYPE</code> crash.   For example (#$CrashOfTransporterTypeFn #$Helicopter) is the collection of helicopter crashes.")
(comment Holiday-TimeAllocation "A sub-collection of #$LeaveOfAbsence-TimeAllocation.  Instances of #$Holiday-TimeAllocation describe intervals of time when some instances of #$Agent-Generic are not available to work for an #$Organization due to that #$Organization's participation in the instance of some #$Holiday.")
(comment strategyLicensesOutput "An instance of #$TernaryPredicate and #$StrategyImplementationPredicate.  (#$strategyLicensesOutput INPUT STRATEGY OUTPUT) says that OUTPUT is one of the outputs licensed by applying STRATEGY to the input INPUT.")
(comment StrategyImplementationPredicate "The collection of all instances of #$Predicate that are used to enable a #$CycRelatedProgram to implement an instance of #$Strategy, either by relating a strategy to input-output pairs (c.f., #$strategyLicensesOutput) or by relating a strategy to a particular #$CycLQuerySpecification that the progam might ask (or by some other means).")
(comment SelectViableModuleOutputWithHighestConfidence-ProblemSolvingStrategy "An instance of #$ProblemSolvingStrategy that, when executed, involves asking for and returning all and only the module outputs with the highest confidence, filtering those that have been rejected by the end-user.")
(comment SelectViableModuleOutputStringsWithHighestConfidence-ProblemSolvingStrategy "An instance of #$ProblemSolvingStrategy that, when executed, involves asking for and returning all and only the module outputs with the highest confidence, filtering those that have been rejected by the end-user.")
(comment FindViableModuleOutputs-ProblemSolvingStrategy "An instance of #$ProblemSolvingStrategy that, when executed, involves asking for and returning all and only the module outputs with the highest confidence, filtering those that have been rejected by the end-user.")
(comment allotmentReservesQuantityOfCollectionForInterval "An assertion of the form (#$allotmentReservesQuantityOfCollectionForInterval ALLOT QUANT COLLECTION INTERVAL) is used to describe a reservation on some resource.  In this case, the #$Allotment ALLOT reserves the #$Quantity QUANT from every instance of the #$SetOrCollection COLLECTION during the #$ContinuousTimeInterval INTERVAL.")
(comment RootAllotment "A sub-collection of #$Allotment.  The collection #$RootAllotment is used to represent the total amount of resources that an #$agent-Generic has available to it.  This represents the 'pot' that constrains the quantities and time intervals that all other #$Allotments that bear the relation #$derivedAllocation to that instance of #$RootAllotment can reserve.")
(comment allotmentForOfTypeDuring "The corresponding predicate for the function #$AllotmentForOfTypeDuringFn.")
(comment AllotmentForOfTypeDuringFn "A function for denoting an instance of #$Allotment.  This function assumes that given a sub-collection of #$SomethingExisting, an instance of #$NormativeSpecification, and a specific instance of #$ContinuousTimeInterval, then there is only one #$Quantity that can be alloted. Note: For smaller and larger instances of #$ContinousTimeInterval there can be different instances of #$Allotment for that same #$SomethingExisting and same #$NormativeSpecification.")
(comment AllotmentOfCollByAgentDuringFn "A function for denoting an instance of #$Allotment.  This function assumes that given a sub-collection of #$SomethingExisting, an instance of #$Agent-Generic, and a specific instance of #$ContinuousTimeInterval, then there is only one #$Quantity that can be alloted. Note: For smaller and larger instances of #$ContinuousTimeInterval there can be different instances of #$Allotment for that same #$SomethingExisting and same #$Agent-Generic.")
(comment allotmentOfCollByAgentDuring "The corresponding predicate for the function #$AllotmentForOfTypeDuringFn.")
(comment CatalogCopy "A collection of #$InformationBearingObjects. A #$CatalogCopy is a  physical object consisting of folded, cut, bound, and usually printed sheets.  Instances of #$CatalogCopy often contain only #$TextualMaterial, but sometimes  contain images also. Instances of #$CatalogCopy are instantiations of instances of #$Catalog-CW (the #$ConceptualWorks).")
(comment Catalog-CW "A specialization of #$PropositionalConceptualWork.  Each instance of  #$Catalog-CW is an abstract work intended to be instantiated as a catalog  (documents that list and describe types of items systematically) of some sort. Instances of #$Catalog-CW may be intended to be instantiated in any  catalog format: hardcopy (see #$CatalogCopy), electronic, etc. Instances of  #$Catalog-CW are usually also instances of #$TextualPCW , but some may be  comprised of mainly non-propositional information, such as images.")
(comment needsHandLexification "(#$needsHandLexification TERM-STRINGS-ASSERTION) implies that the Cyc-term specified in TERM-STRINGS-ASSERTION needs to be lexified manually.  It should not be lexified with the help of the SubL Function 'lex-loop'")
(comment ResourceRequestForOfDuringFn "A function for denoting an instance of ResourceRequest. This function assumes that given a specific instance of SomethingExisting, an instance of NormativeSpecification, and a specific instance of ContinuousTimeInterval, then there is only one Quantity that can be requested. Note: For smaller and larger instances of #$ContinuousTimeInterval there can be different instances of ResourceRequest for that same SomethingExisting and same #$NormativeSpecification.")
(comment answerSourceIBT-InappropriateForUser "A predicate used to represent and facilitate dialogue.  (#$answerSourceIBT-InappropriateForUser IBT USER) says that the instance of #$InformationBearingThing IBT has, in the current dialogue model, been deemed a bad source document of information with respect to the interests of USER.")
(comment answerSourceIBT-ContentsPresentedToUser "A predicate used to represent and facilitate dialogue.  (#$answerSourceIBT-ContentsPresentedToUser IBT USER) says that the instance of #$InformationBearingThing IBT has been displayed to USER for his or her consideration.")
(comment SelectViableModuleIBTWithHighestConfidence-ProblemSolvingStrategy "An instance of #$ProblemSolvingStrategy that, when executed, involves asking for and returning all and only the module outputs with the highest confidence, filtering those that have been rejected by the end-user.")
(comment SelectViableModuleIBTContentStringWithHighestConfidence-ProblemSolvingStrategy "An instance of #$ProblemSolvingStrategy that, when executed, involves asking for and returning all and only the module outputs with the highest confidence, filtering those that have been rejected by the end-user.")
(comment SelectViableModuleIBTs-ProblemSolvingStrategy "An instance of #$ProblemSolvingStrategy that, when executed, involves asking for and returning all and only the module outputs with the highest confidence, filtering those that have been rejected by the end-user.")
(comment HandlingABugReport "A sub-collection of #$ImprovementEvent, instances of #$HandlingABugReport involve improving an instance of #$SomethingExisting in light of problems described by an instance of #$BugReport.  Thus, the relevant instance of #$BugReport plays at least the role #$informationUsed in such an event.")
(comment DocumentingAProduct "A sub-collection of #$WritingAComposition, instances of #$DocumentingAProduct involve creating an instance of #$InstructionalWork.")
(comment WritingAProposal "A sub-collection of #$WritingAComposition, instances of #$WritingAProposal involve the creating the content of some instance of #$Proposal.")
(comment QualityAssuranceEvent "A sub-collection of #$TakingCareOfSomething, instances of #$QualityAssuranceEvent involve the monintoring, testing, and improvement of a #$SomethingExisting.  In many contexts, these objects would be instances of #$Product.")
(comment baseInterestRate-BankOfEngland "An instance of #$MeasurableQuantitySlot, and a specialization of #$interestRate.  (#$baseInterestRate-BankOfEngland LOAN RATE) means that LOAN has the interest rate RATE, where RATE is an interest rate set by the #$BankOfEngland (q.v.) for a particular period of time. This rate is applied to all loans made by that bank to other financial institutions during that period.")
(comment EstablishingAnInterestRate "An instance of #$TemporalObjectType, and a specialization of #$EconomicAction.  In each instance of #$EstablishingAnInterestRate, a financial institution sets the interest rate that will be applied by it to all loans of a certain class (e.g., home loans, auto loans, loans to other financial institutions) during a particular period of time.")
(comment establishedRate "An instance of #$BinaryPredicate.  (#$establishedRate ESTABLISH RATE) means that the interest rate RATE is the rate set by the #$EstablishingAnInterestRate ESTABLISH.")
(comment BuildingSociety "A specialization of #$BankOrganization.  Each instance of #$BuildingSociety is a banking organization owned by the very people who save with and borrow from it.")
(comment BuyToLetMortgage "A specialization of #$MortgageAgreement.  Each instance of #$BuyToLetMortgage is a mortgage on a property that the borrower intends to lease to others.")
(comment CappedRateMortgage "A specialization of #$AdjustableRateMortgage.  Each instance of #$CappedRateMortgage is a mortgage whose interest rate cannot go above a certain level, even if mortgage rates rise, but can go down as rates drop.")
(comment CashRebateOnTransaction "An instance of #$TemporalObjectType, and a specialization of #$MoneyTransaction.  Each instance of #$CashRebateOnTransaction is a payment made (as part of a borrowing event) by a lender to a borrower, or (as part of a buying event) by a seller to a buyer.  The payment is made with the object of getting the borrower or buyer to participate in the larger transaction.")
(comment CompulsoryInsuranceMortgage "A specialization of #$MortgageAgreement.  Each instance of #$CompulsoryInsuranceMortgage is a mortgage agreement that requires the borrower to take out house and contents insurance with the lender as part of the mortgage deal.")
(comment acceptsPaymentOfForm "(#$acceptsPaymentOfForm PLACE FORM) means that a #$PlaceOfBusiness PLACE accepts payments for its goods and/or services in form of FORM. For example, Little Deli accepts only #$Currency, #$McDonaldsRestaurants accept #$Currency and #$CreditCards, and #$Walmart-CommercialOrganization accepts #$Currency, #$CreditCards and #$Check-TenderObjects.")
(comment cuisineServedAtLocation "(#$cuisineServedAtLocation PLACE CUISINE) means that at the #$RestaurantSpace PLACE, the type of food served is CUISINE. This predicate links specific restaurant facilities to the kinds of food they serve, whereas #$servesCuisine relates organizations to the cuisine served.")
(comment facilityOperatingTimes "(#$facilityOperatingTimes FACILTY DAY OPEN CLOSE) means that the #$Facility-Construct FACILITY is 'open' from #$TimeOfDay OPEN to #$TimeOfDay CLOSE on DAY.")
(comment answerSourceIBTsPresented "(#$answerSourceIBTsPresented PRESENTING IBT) says that IBT is one of the instances of #$ComputerDataArtifact from which content is generated in PRESENTING, an instance of #$PresentingTheResultsOfAProgramAction.")
(comment RepaymentMortgage "A specialization of #$MortgageAgreement and
#$InstallmentLoan.  Each instance of this collection is a mortagage
loan such that the borrower repays on both the interest and the
capital with each monthly payment.")
(comment RepossessingSomething "A specialization of #$TransferringPossession.  In each
instance of this collection, an agent resumes possession of something
due to a default in payment installations owed.")
(comment RespondingToAQuestion "The collection of all events in which an agent responds to a question that has been posed (typically to that agent).  Unlike its specialization, #$ReplyingToAQuestion, instances of this collection need not answer (or attempt to answer) the question posed.  For example, one might respond to a question with a question (e.g., \"why do you ask that?\") or respond by initiating an instance of #$ClarificationDialogue (e.g., \"I'm not sure what you mean by ...\").")
(disjointWith ProgramAction-HumanInitiated PresentingTheResultsOfAProgramAction)
(comment PresentingTheResultsOfAProgramAction "The collection of all events in which a computer displays the results of the execution of some instance of #$ProgramAction.")
(comment threateningToDo "<code>(#$threateningToDo THREAT-TYPE ACT-TYPE)</code> means that instances of <code>ACT-TYPE</code> are threats to perform instances of <code>ACT-TYPE</code>.  #$threateningToDo is the predicate that corresponds to #$ThreateningToDoFn.")
(comment RequestingClarification "The collection of all instance of #$Acknowledging-CommunicationAct and #$RequestingInformation that are intended by their performers to enable those performers to achieve a state of clarity on some point where that clarity was lacking.")
(comment RespondingToARequestForClarification "The collection of all instances of #$RespondingToAQuestion that are responses to a request for clarification (c.f. #$RequestingClarification.")
(comment PsychologicalOperation "A specialization of (#$AttemptingFn #$CoercingAnAgent) and #$MilitaryOperation (qq.v.).  Each instance of #$PsychologicalOperation is a military operation conducted with the intent to convey selected information to audiences in oreder to influence their emotions, motives, plans, and ultimately their behavior.")
(comment subInformationOrigins "An instance of #$BinaryRolePredicate that is used to indicate a source of of information being transfered in a particular instance of #$InformationTransferEvent (q.v.).  (#$subInformationOrigins TRANSFER ORIGIN) means that some of the information being transferred in TRANSFER comes from ORIGIN.  Contrast this with the specialized predicate #$informationOrigin, which is used to say that all of the information transferred in TRANSFER comes from ORIGIN. ORIGIN is either an instance of #$InformationBearingThing or an agent.   Note that if ORIGIN still exists after the ending of TRANSFER, it  presumably also still contains the information that was transferred.")
(comment GAFGatheringMetricsTest "A collection of #$KBContentTest-FullySpecified instances that gather information about suggested sentences, the evaluations of those sentences, and the rules derived from them.")
(comment CycBehaviorEngineNodeRunning "A collection of actions performed by #$CycBehaviorEngine programs.")
(comment glossaryMt "(#$glossaryMt GLOSSARY MICROTHEORY) identifies MICROTHEORY as the instance of #$Microtheory where the content of the instance of #$Glossary GLOSSARY is represented.")
(disjointWith BachelorOfScienceLevel HighSchoolGraduateLevel)
(disjointWith BachelorOfArtsLevel HighSchoolGraduateLevel)
(comment CycBehaviorEngineActionHistory "A specialization of #$ScriptExecutionContext.  Each instance of #$CycBehaviorEngineActionHistory is a microtheory in which data is stored about the instance-level role-players and remembered facts for particular #$CycBehaviorEngineNodeRunning.")
(comment IslamicBoardingSchool "The collection of all religious primary and secondar schools that teach the Islamic faith in which the students stay on campus for much of the school year.  Some are single site organizations, while others have branches.")
(comment bridgingAntecedent "(#bridgingAntecedent ANA ANTE) means that ANTE is nearest possible bridging antecedent for ANA.")
(comment possibleBridgingAntecedent "(#$possibleBridgingAntecedent ANA ANTE) means that ANTE is a possible bridging antecedent for ANA.")
(comment nearestBridgingAntecedent "(#$nearestBridgingAntecedent ANA ANTE) means that ANTE is nearest possible bridging antecedent for ANA.")
(comment possibleBridgingEntailment "(#$possibleBridgingEntailment ANA ANTE SENT) means that ANTE is a possible bridging antecedent for ANA and this bridging relation, if realized, carries the contextual entailment SENT.  In general, SENT will express a relation (e.g. #$physicalParts) which links (the referents of) ANA and ANTE.")
(disjointWith RestaurantOrg-WithWaitstaff RestaurantOrg-WithoutWaitstaff)
(comment SlaveTrafficking "A specialization of #$CommercialActivity. Instances are actions undertaken as part of an illicit business seeking to profit from the buying, selling, transport, etc., of human persons.")
(comment RawMaterials "The collection of all instances of #$PartiallyTangible that are used as raw materials for the purpose of manufacturing.")
(comment Piracy-AtSea "A specialization of #$HostileSeizure.  Each instance of this collection is a particular act of piracy.  All such acts occur on water and most involve theft of goods and many involve the hijacking of a boat or ship.")
(comment originalStringFromINFn "A #$DocumentationPredicate that is used to relate a #$CycLConstant to a
#$SubLString containing a generic name string. (#$originalStringFromINFn
CONSTANT STRING) means that CONSTANT is the reified version of an
entity originally entered into Cyc as (#$InstanceNamedFn STRING
COLLECTION). For example, if Cyc originally learned about a person as
(#$InstanceNamedFn 'Colonel Richard Smythe (retired)' #$Person) and that
NAT was later edited to be #$RichardSmythe, the assertion
(#$originalStringFromINFn #$RichardSmythe 'Colonel Richard Smythe
(retired)') preserves the string entered by the user. We wish to
preserve this information because there are many cases where users of
RKF tools enter potentially useful data into name field that we either
lack the vocabulary to represent or are unable to cleanly translate
into CycL for other reasons. This predicate should only be used to
describe constants created from #$InstanceNamedFn NATs and is not a
specPred of #$properNameStrings")
(comment locationTypeTypicallyContainsType "A #$BinaryPredicate that relates a specialization of #$SpatialThing-Localized to a specialization of #$PartiallyTangible.  <code>(#$locationTypeTypicallyContainsType LOC-TYPE THING-TYPE)</code> means that any given instance of <code>LOC-TYPE</code> is likely to contain at least one instance of <code>THING-TYPE</code>.  For example, (#$locationTypeTypicallyContainsType #$OfficeSpace #$Computer) means that any given office is likely to contain at least one computer.")
(comment WorkByForDuringFn "An #$IndividualDenotingFunction, an expression of the form (#$WorkByForDuringFn AGENT SPEC INTERVAL) is used to represent an instance of #$WorkingEvent that is made up of all the smaller events where the #$IntelligentAgent AGENT has been working in accordance with the #$NormativeSpecification SPEC during the #$ContinuousTimeInterval INTERVAL. For instance, if SPEC is an instance of #$Assignment-Specification, then the functionally denoted individual would be the event that is composed of all the individual events that INTERVAL temporally subsumes, where AGENT was doing the type of work specified by SPEC. The functionally denoted event need not represent the fulfillment of SPEC.")
(comment eventIsWorkByForDuring "This is the corresponding predicate of the function #$WorkByForDuringFn.")
(comment definitionalDisplaySentence "(#$definitionalDisplaySentence CONCEPT DEFINITIONAL-SENTENCE) says that the instance of #$CycLSentence-Assertible DEFINITIONAL-SENTENCE is a sentence that contributes meaningfully to the definition of the concept CONCEPT.")
(comment NextIntegerInSequenceStartingAtFn "Terms of the form (#$NextIntegerInSequenceStartingAtFn FORT POSNUM) will be evaluated at the EL (e.g. at assert time).  They will evaluate to POSNUM if the term has not been evaluated before, otherwise they will evaluate to 1 more than the last evaluation.  For an integer sequence that is zero-based, see #$NextIntegerInSequenceFn. Note that #$NextIntegerInSequenceStartingAtFn is not technically a function, because it will evaluate to different values given the same argument. ")
(comment UKGeopoliticalSubdivisionType "A collection of collections. Each instance of this
collection is a collection of #$GeopoliticalEntity members whose
jurisdictions in the #$UnitedKingdomOfGreatBritainAndNorthernIreland
does not overlap with other instances of this collection. Notable
instances of this collection include #$UKUnitaryAuthority and
#$EnglishAdministrativeCounty.")
(comment EnglishNonUnitaryAuthority "A specialization of #$UKGeopoliticalSubdivision. Each
instance of this collection is an #$EnglishAdministrativeCounty (q.v.)
that has a two-tier structure composed of a county council and
district councils. The two levels allow for a distribution of local
responsibilities. See also #$UnitaryAuthorityType.")
(comment UKUnitaryAuthority "A specialization of #$UKGeopoliticalSubdivision. Each
instance of #$UKUnitaryAuthority is a single-tiered authority that
combine the responsibilities of the county councils and district
councils of #$NonUnitaryAuthorityType (q.v.). Notable specializations
of #$UKUnitaryAuthority include #$MetropolitanDistrict and
#$LondonBorough.")
(comment EnglishCeremonialCounty "A specialization of #$UKGeopoliticalSubdivision.  Each
instance of this collection is an area in England that has an
appointed Lord Lieutenant. ")
(comment EnglishMetropolitanCounty "A specialization of #$EnglishCeremonialCounty. Each instance
of this collection is an administrative area of that contains a number
of metropolitan districts. The county councils, the administrating
bodies, were disbanded in 1986; however, these administrative areas
still have legal power and are used to gather statistics.")
(comment MetropolitanDistrict "A specialization of #$UKUnitaryAuthority.  Each instance of
this collection is a district within a #$EnglishMetropolitanCounty,
which has had its county council abolished.")
(comment LondonBorough "A specialization of #$UKUnitaryAuthority.  Each instance of
this collection is a borough of #$GreaterLondon-CountyEngland.")
(comment integralWRTUnit "A binary predicate that relates a given #$UnitOfMeasure (q.v.) to the #$ScalarPointValues (q.v.) that are \"integral\" with respect to it.  <code>(#$integralWRTUnit SCALAR UNIT)</code> means that there is some #$Integer <code>INT</code> such that <code>(UNIT INT)</code> is equal to <code>SCALAR</code>.  Typically, <code>SCALAR</code> will be a #$MeasurableQuantity (q.v.).  When <code>UNIT</code> is #$Unity, however, <code>SCALAR</code> will be an #$Integer, namely <code>INT</code> itself.
<p>
The result of applying a #$UnitOfMeasure to an integer is of course always integral with respect to that unit, and the result of applying a unit-of-measure to an non-integer is always <i>not</i> integral with respect to that unit.
<p>
For example, (#$Meter 5) is integral with respect to both #$Meter and (#$Milli #$Meter) (since 5 meters is equal to ((#$Milli #$Meter) 5000)).  Conversely, (#$Meter 5) is <i>not</i> integral with respect to either #$Mile or #$Kilometer (since 5 meters is equal to (#$Kilometer 0.005)).
<p>
See also #$coIntegralScalars.")
(comment FinancialActivity "A specialization of #$HumanActivity.  Each instance of this
collection occurs when an agent performs some kind of activity
financial in nature.  This collection would include activities such as
#$FinancialPlanning, #$PreparingFinancialRecords, #$FinancialAdvising,
and so forth.")
(comment RetentionMortgage "A specialization of #$MortgageAgreement.  Each instance of
this collection is a mortgage in which the lender holds some part of
the mortgage back until specific conditions are met.")
(comment PaymentHoliday-Mortgage "A specialization of #$FailingToMakeAPayment.  Each instance of this collection is a situation in which a mortgager has been granted a reprieve from their typical mortgage payment.")
(comment FailingToMakeAPayment "A specialization of #$HumanActivity. Each instance of this
collection is a situation in which an agent does not make a payment
owed. This collection is agnostic as to whether the agent is
intentionally withholding the payment. Notable specializations of this
collection include #$DefaultingOnLoan and #$PaymentHoliday-Mortgage.")
(comment repaymentPlanForLoan "(#$repaymentPlanForLoan REPAY-PLAN LOAN) means that
REPAY-PLAN is the instance of #$RepaymentPlan that leads to the
instance of #$LoanAgreement LOAN becoming #$PaidInFull.  There may not
exist a definate replayment plan, but rather the schedule might be
flexible or perhaps a pay as one can schedule.")
(comment scheduledPaymentFor "(#$scheduledPaymentFor AMOUNT LOAN FREQUNCY) means that
AMOUNT, an instance of #$MonetaryValue, is the amount due toward the
instance of #$LoanAgreement LOAN at the instance of #$Frequency.
Thus, (#$scheduledPaymentFor (Dollar-UnitedStates 100) StudentLoan001
#$Monthly) means that $100 is due every month to pay toward the loan
StudentLoan001 until it is #$PaidInFull.")
(comment RepayingTypeOfLoanFn "An instance of #$CollectionDenotingFunction that takes for its value an instance of #$LoanAgreement, LOAN, and returns the
collection of #$LoanRepaying that will result in the loan becoming an
instance of #$PaidInFull.  Note this function may denote a
collection with only one member.  In other words, the members of any
collection (#$RepayingTypeOfLoanFn LOAN) will be equal to the number
of payments made on LOAN.  If LOAN is repaid with one payment, the
collection denoted by (#$RepayingTypeOfLoanFn LOAN) will only have one
member.")
(comment repayingTypeOfLoan "(#$repayingTypeOfLoan REPAY-TYPE LOAN) means that the
specialization of #$LoanRepaying, REPAY-TYPE, is the collection of
repayments for the instance of #$LoanAgreement LOAN.")
(comment MortgageRedemption "A specialization of #$PayingOffDebt-LastPayment. Instances of this
collection occur when an agent has finished payment of a mortgage.")
(comment PayingOffDebt-LastPayment "A specialization of #$ChangeOfStatusEvent and
#$HumanActivity. In each instance of this collection an agent performs
the final paying event on some monetary debt owed, at which time the
debt is #$PaidInFull. This collection
refers to the act of paying the last installment and the subsequent
release from debt, not the entire series of paying events that occur
once someone has incurred debt.")
(disjointWith Plectrum-Handheld Plectrum-Mechanism)
(comment StampDuty "An instance of #$Tax-COC.  It is a tax owed for the purchase for certain things, like
stock or property.")
(comment USDepartmentOfEnergyNationalLaboratory "A specialization of #$USNationalLaboratory.  Each instance of #$USDepartmentOfEnergyNationalLaboratory is a research organization under the U.S. Department of Energy.  Prominent examples include #$OakRidgeNationalLaboratory and #$SandiaNationalLaboratories.  Most instances of this collection are government owned, but contractor operated (GOCO).")
(comment geographicalSubRegionsOfState "A specialization of #$geographicalSubRegions (q.v.) that relates a given #$State-Geopolitical (q.v.) to its subregions.  <code>(#$geographicalSubRegionsOfState STATE SUBSTATE)</code> means that the region <code>SUBSTATE</code> lies wholly within the geopolitical state <code>STATE</code>. 
For example, this holds: 
<code>(#$geographicalSubRegionsOfState #$Alberta-CanadianProvince (#$CentralRegionFn #$Alberta-CanadianProvince))</code> 
Note that, if either argument to #$geographicalSubRegionsOfState is an instance of #$GeopoliticalEntity, the assertion must be made in #$WorldGeographyDualistMt or a specialization thereof.")
(comment geographicalSubRegionsOfUSState "A specialization of #$geographicalSubRegionsOfState (q.v.) that relates a given #$State-UnitedStates (q.v.) to its subregions.  <code>(#$geographicalSubRegionsOfUSState US-STATE SUBSTATE)</code> means that the region <code>SUBSTATE</code> lies wholly within the U.S. state <code>US-STATE</code>. 
For example, this holds: 
<code>(#$geographicalSubRegionsOfUSState #$California-State #$SonomaCountyCalifornia)</code>.
Note that, if either argument to #$geographicalSubRegionsOfUSState is an instance of #$GeopoliticalEntity, the assertion must be made in #$WorldGeographyDualistMt or a specialization thereof.")
(comment geographicalSubRegionsOfCountry "A specialization of #$geographicalSubRegions (q.v.) that relates a given #$Country (q.v.) to its subregions.  <code>(#$geographicalSubRegionsOfCountry COUNTRY SUB-COUNTRY)</code> means that the region <code>SUB-COUNTRY</code> lies wholly within the country <code>COUNTRY</code>.
For example, this holds: 
<code>(#$geographicalSubRegionsOfCountry #$Russia #$CityOfMoscowRussia)</code>.
Note that, if either argument to #$geographicalSubRegionsOfCountry is an instance of #$GeopoliticalEntity, the assertion must be made in #$WorldGeographyDualistMt or a specialization thereof.")
(comment geographicalSubRegionsOfContinent "A specialization of #$geographicalSubRegions (q.v.) that relates a given #$Continent (q.v.) to its subregions.  <code>(#$geographicalSubRegionsOfContinent CONTINENT SUB-CONTINENT)</code> means that the region <code>SUB-CONTINENT</code> lies wholly within the continent <code>CONTINENT</code>. 
For example, this holds: 
<code>(#$geographicalSubRegionsOfContinent #$ContinentOfEurasia (#$TerritoryFn #$Russia))</code>.
Note that, if either argument to #$geographicalSubRegionsOfContinent is an instance of #$GeopoliticalEntity, the assertion must be made in #$WorldGeographyDualistMt or a specialization thereof.")
(comment USNationalLaboratory "A specialization of #$ResearchOrganization.  Each instance of #$USNationalLaboratory is an organization that conducts research at a prominent laboratory facility owned by the U.S.")
(comment geographicalSubRegionsOfBodyOfWater "A specialization of #$geographicalSubRegions (q.v.) that relates a given #$BodyOfWater (q.v.) to its subregions.  <code>(#$geographicalSubRegionsOfBodyOfWater WATER-BODY SUB-WATER-BODY)</code> means that the region <code>SUB-WATER-BODY</code> lies wholly within the body of water 
<code>WATER-BODY</code>. 
For example, this holds: 
<code>(#$geographicalSubRegionsOfBodyOfWater #$MediterraneanSea #$SaronicGulf)</code>.
Note that, if either argument to #$geographicalSubRegionsOfBodyOfWater is an instance of #$GeopoliticalEntity, the assertion must be made in #$WorldGeographyDualistMt or a specialization thereof.")
(comment equivalentQuantities "An instance of #$ReflexiveBinaryPredicate and #$TransitiveBinaryPredicate that relates equivalent instances of #$MeasurableQuantity.  (#$equivalentQuantities INT-1 INT-2) says that any thing for which INT-1 is its measured value is such that INT-2 is also its measured value.  For example, (#$equivalentQuantities (#$MinutesDuration 1) (#$SecondsDuration 60)) says that any time interval a minute in duration is thereby one of sixty seconds in duration, and vice versa.")
(comment unitPrefixMultiplier "An instance of #$StrictlyFunctionalSlot. #$unitPrefixMultiplier takes an instance of #$MetricUnitPrefix PREFIX and relates it to a real number REAL.  Where UNIT is an argument to PREFIX, REAL is the the real number by which (PREFIX UNIT) is a multiple of UNIT.  For example, where UNIT is defined as a possible argument for #$Kilo, (#$unitPrefixMultiplier #$Kilo 1000) means that when converting from N kilo-units to arrive at M units (converting an expression of the form ((#$Kilo UNIT) N) to one of the form (UNIT M)), M is arrived at by multiplying N by 1000.")
(comment Disambiguation-ClarificationStrategy "An instance of #$ClarificationStrategy in which questions
are posed to a use to disambiguate the user's utterance or its
constituents.")
(comment UtteranceDisambiguation-ClarificationStrategy "An instance of #$ClarificationStrategy in which questions
are posed to a user in order to disambiguate the
user's utterance.")
(comment SubPegDisambiguation-ClarificationStrategy "An instance of #$ClarificationStrategy in which questions
are posed to a user in order to disambiguate constituents of the
user's utterance.")
(comment exclusiveCandidateSubSituationTypes "<code>(#$exclusiveCandidateSubSituationTypes SIT-TYPE SUB-SIT-TYPE1 SUB-SIT-TYPE2)</code> means that no instance of <code>SIT-TYPE</code> has instances of both <code>SUB-SIT-TYPE1</code> and <code>SUB-SIT-TYPE2</code> as sub-situations.")
(comment ResourceAllocationForAgentForEventTypeDuringIntervalFn "An expression of the form (#$ResourceAllocationForAgentForEventTypeDuringIntervalFn AGENT TYPE INTERVAL) is used to denote an instance of #$ResourceAllocationSpecification that is applicable to the #$IntelligentAgent AGENT being an actor in instances of the sub-collection of #$Event TYPE during the #$ContinuousTimeInterval INTERVAL.")
(comment rootAllotmentOfCollectionByAgentDuring "The corresponding predicate of the function #$RootAllotmentOfCollectionByAgentDuringFn.")
(comment RootAllotmentOfCollectionByAgentDuringFn "An #$IndividualDenotingFunction, an expression of the form (#$RootAllotmentOfCollectionByAgentDuringFn COLLECTION AGENT INTERVAL) is used to pick out the instance of #$RootAllotment that the #$Agent-Generic AGENT has for the #$FirstOrderCollection COLLECTION during the #$ContinuousTimeInterval INTERVAL.  For instance, (#$RootAllotmentOfCollectionByAgentDuringFn #$CurrentCycorpEmployee #$Cycorp (MonthFn February (YearFn 2005))) would pick out the instance of #$RootAllotment that #$Cycorp has for instances of #$CurrentCycorpEmployee during February 2005.")
(comment allottedQuantityOfWorkTime "An assertion of the form (#$allottedQuantityOfWorkTime ALLOTMENT QUANT) relates an instance of #$Allotment to an instance of #$Time-Quantity.  Instances of #$Allotment represent reservations or constraints on a resource (e.g., an agent's work time).  This predicate represents the actual quantity of work time that is being reserved.  To find out the interval when this reservation holds, see #$allotementForInterval.")
(comment allotmentForInterval "An assertion of the form (#$allotmentForInterval ALLOTMENT INTERVAL) relates an instance of #$Allotment to an instance of #$ContinuousTimeInterval.  Instances of #$Allotment represent a reservation on some resource (e.g, an agent's work time).  This predicate represents the period in which that reservation holds; however, in cases where time is reserved, this does not mean that the entire interval is reserved.  The predicate #$allottedQuantityOfWorkTime would express how much time is reserved during INTERVAL. ")
(comment allocatedQuantity "An assertion of the form (#$allocatedQuantity ALLOCATION QUANT) relates an instance of #$ResourceAllocationSpecification to an instance of #$Time-Quantity.  Instances of #$ResourceAllocationSpecification represent a reservation, so such an assertion means that INTERVAL ")
(comment requestForInterval "An assertion of the form (#$requestForInterval ALLOTMENT INTERVAL) relates an instance of #$ResourceRequest to an instance of #$ContinuousTimeInterval.  Instances of #$ResourceRequest represent the content of an attempt to reserve some resource (e.g, an agent's work time).  This predicate represents the period in which that reservation would hold; however, in cases where time is reserved, this does not mean that the entire interval would be reserved.  The predicate #$allocatedTimeQuantity and its specialization #$requestedQuantityOfWorkTime would express how much time is reserved during INTERVAL. ")
(comment allocationInterval "An assertion of the form (#$allocationInterval ALLOCATION INTERVAL) relates an instance of #$ResourceAllocationSpecification to an instance of #$ContinuousTimeInterval.  Instances of #$ResourceAllocationSpecification represent a reservation, so such an assertion means that INTERVAL is period when allocation is in effect.")
(comment isResourceAlocationForAgentForEventTypeDuringInterval "The corresponding predicate of the function #$ResourceAllocationForAgentForEventTypeDuringIntervalFn.")
(comment 21cSagemanDataGroup2 "The second collection of groups from 21c.")
(comment RightToBuy "A specialization of #$GrantingPermission.  Margaret
Thatcher's idea to allow a council house tenant to buy the
council house with significant discounts based on how long the person
has been living in the council house.")
(comment CouncilHouse "A specialization of #$RentalProperty.  Each instance of this
collection is a public housing property used to give low-income
families access to affordable housing.  In the UK, Margret Thatcher
started an intititive to enable tenants of the council houses to buy
the properties.")
(comment SelectViableSingleAnswerModuleIBTWithHighestConfidence-ProblemSolvingStrategy "An instance of #$ProblemSolvingStrategy that, when executed, involves asking for and returning all and only the single-answer module outputs with the highest confidence, filtering those that have been rejected by the end-user.")
(comment SkillTypicalForTypeFn "'(#$SkillTypicalForTypeFn PERSON-TYPE)' denotes the instance of 
#$SkilledActivityType that corresponds to PERSON-TYPE.  The more specific the facet of person used, the more specific the skill returned.  For instance, '(#$SkillTypicalForTypeFn #$BaseballPlayer)' denotes the generic skill of \"playing baseball\", and '(#$SkillTypicalForTypeFn #$BaseballPitcher)' returns the skill required for pitchers (i.e. #$BaseballDelivery).")
(comment skillTypicalForPersonTypeByActivity "(#$skillTypicalForPersonTypeByActivity PERSON-TYPE SKILLED-ACTIVITY-TYPE) holds just in case SKILLED-ACTIVITY-TYPE is the instance of #$SkilledActivityType that corresponds to the activity that PERSON-TYPE is faceted by.  For instance, #$BaseballPlayer is an instance of #$PersonTypeByActivity and each instance of that collection is an instance because he or she participates to some degree in baseball playing activities.  The generic skill of \"being able to play baseball\" is the skill that corresponds to the activity of playing baseball.  So, (#$skillTypicalForPersonTypeByActivity #$BaseballPlayer BaseballPlayingSkilledActivity) holds.  This is the corresponding predicate (see #$functionCorrespondingPredicate-Canonical) to #$SkillTypicalForTypeFn and often the second argument to this predicate will be functionally denoted.")
(comment DemolitionsExpert "An instance of #$PersonTypeByActivity and a specialization of #$Person.  Each instance of this collection is an individual who is at least somewhat proficient in blowing things up and does so or trains to do so on a fairly regular basis.")
(comment Freehold-UseRights "An instance of #$SituationTypeByUserRights.  Each instance of #$Freehold-UseRights is a situation in which an agent owns the freehold of some property, which amounts to the agent owning the property forever.")
(comment BorrowingToInvest "A specialization of #$FinancingByBorrowing.  In each instance of #$BorrowingToInvest, an agent borrows money to make an investment, usually in property, but sometimes to purchase shares or invest in managed funds.")
(comment UnitTrust "A specialization of #$Trust-LegalEntity.  Each instance of #$UnitTrust is a trust that buys and sells securities and other investments, using money invested in the trust by individual investors.  Many instances of #$MutualFund (q.v.) are also instances of #$UnitTrust.")
(disjointWith MutualFund IndexTrackingUnitTrust)
(comment IndexTrackingUnitTrust "A specialization of #$UnitTrust.  Each instance of #$IndexTrackingUnitTrust is a unit trust designed to track the performance of some stock market index: when the index rises, the investments made by the unit trust do well; when the index falls, they do not.")
(comment IndividualSavingsAccount-UK "A specialization of #$FinancialAccount.  Each instance of #$IndividualSavingsAccount-UK is an account through which a citizen of the UK can invest in cash, stocks, or life insurance.")
(comment Leasehold-UseRights "An instance of #$SituationTypeByUserRights.  Each instance of #$Leasehold-UseRights is a situation in which an agent has a leasehold over some property, which means that the agent owns the property only for a limited time, and the agent does not own the land on which the property is built. At the end of the lease period, the property reverts to the freeholder (see the collection #$Freehold-UseRights.")
(comment ChangeInUseRightsFn "An instance of #$CollectionDenotingFunction.  When applied to an instance RIGHT of #$SituationTypeByUserRights, #$ChangeInUseRightsFn returns the collection of all events in which an agent gains RIGHT over some obejct.  For example, (#$ChangeInUseRightsFn #$FullUseRights) is the collection of all events in which an agent gains #$FullUseRights over some object.")
(comment groundRent "An instance of #$MeasurableQuantitySlot.  (#$groundRent BUILDING RENT) means that RENT is the annual rent paid by the leaseholder of BUILDING (see #$Leasehold-UseRights) to the freeholder of BUILDING (see #$Freehold-UseRights).")
(comment legalCharge "An instance of #$CoexistingObjectsPredicate.  (#$legalCharge HOME AGENT) means that AGENT has legal charge over HOME. This means that AGENT is the creditor (see the predicate #$creditor) on a mortgage for HOME, and has a claim over HOME until that mortgage is paid off.")
(comment localAuthoritySearchFee "An instance of #$MeasurableQuantitySlot.  (#$localAuthoritySearchFee BUYING FEE) means that FEE is the fee paid in the service SERVICE, an instance of #$LocalAuthoritySearch.  FEE is paid to a local council by a new homeowner's solicitor to check on any proposed developments in the area around the new home.")
(comment MortgageIndemnityGuarantee "A specialization of #$MortgageInsurance.  Each instance of #$MortgageIndemnityGuarantee is an insurance plan that insures the lender of a mortgage against the borrower's being unable to pay. Although the lender is being insured, the borrower is typically the one who pays the premium.")
(comment Treasurer-Position "A specialization of #$AdministrativeStaffPerson.  Each instance of #$Treasurer-Position is an employee of an organization who is responsible for managing its monetary affairs.  Instances of #$Treasurer-Position may or may not also be required to manage people.  If so, then they are also #$Managers (q.v.).")
(comment DistrictTreasurer-Position "A specialization of #$Treasurer-Position.  Each instance of #$DistrictTreasurer-Position is an employee of a multi-site organization who is responsible for managing the monetary affairs of several suborganizations of his/her employer.  Instances of #$DistrictTreasurer-Position may or may not also be required to manage people.  If so, then they are also #$Managers (q.v.).")
(comment PoliticalPartyOrganizer "The collection of individuals who organize political party functions.")
(comment AmbushAndSnipingExpert "An instance of #$PersonTypeByActivity and a specialization of #$Person.  Each instance of this collection is an individual who is at least somewhat proficient in sniping and other ambush tactics and does so or trains to do so on a fairly regular basis.")
(comment InfantryLeader "The collection of all infanty leaders such as squad and platoon leaders that serve in the infantry of some nation's military.")
(comment InfantryTrainer "The collection of all infantry trainers such as drill sergeants that serve in the infantry of some nation's military.")
(comment OperationsPlanner "A subcollection of #$Administrator.  Each instance of #$OperationsPlanner is a person who is officially responsible for the planning of an organization's operations.")
(comment xmlExpansionTypeAttributeValue "(#$xmlExpansionTypeAttributeValue PROGRAM THING STRING) identifies THING as the object denoted by the attribute value STRING in the computer program PROGRAM.")
(comment Allotment-Collective "A sub-collection of #$Allotment, instances of #$Allotment-Collective are those instances where an allotment applies to an entire set of objects, as opposed to a single object.  Further, instances of this collection are such that they reserve the same quantity of time for the same interval for every element of the collection to which the instance bears the relation #$allottedCollection.")
(comment allottedCollection "A #$BinaryPredicate, #$allottedCollection is used to relate an instance of #$Allotment-Collective to a #$SetOrCollection.  An assertion of the form (#$allottedCollection ALLOT COLL) means that the #$Allotment-Collective ALLOT makes a reservation on all of the instances of the #$SetOrCollection COLL.")
(comment TheRelevantStrategy "An instance of #$IndexicalConcept that evaluates to the relevant #$Strategy to be implemented in the current context.")
(comment TheInputToTheRelevantStrategy "An instance of #$IndexicalConcept that evaluates to the relevant instance of #$Thing that is used as an input to whatever is denoted by #$TheRelevantStrategy in the current context.")
(comment Fundraiser "The collection of persons who perform fundraising activities for some organization.")
(comment UAVDriver "The collection of people who operate unmanned aerial vehicles by remote control.")
(comment controlsRemotely "(#$controlsRemotely AGT DEVICE) holds in MT at TIME just in case DEVICE is a device equipped for remote control operation and AGT is currently controlling the behavior of DEVICE in MT at TIME.")
(comment ASCIIString-Standard "#$ASCIIString-Standard is the collection of SublStrings that
are ASCII strings (those with no character with a code greater than
127)")
(comment UnicodeStringFn "(#$UnicodeStringFn STRING) denotes the Unicode string
represented by the valid ASCII characters and valid Unicode escapes in
the string.  See comment on #$UnicodeDenotingASCIIString for format of Unicode escapes.")
(comment StateNamedFn "The Cyc function #$StateNamedFn is an #$IndividualDenotingFunction. (#$StateNamedFn STRING GEOPOL) applied to a (quoted) #$ProperNameString STRING that is the name of a state in region GEOPOL returns the #$State-Geopolitical in that region with that name. Example: (#$StateNamedFn \"Texas\" #$UnitedStatesOfAmerica).")
(comment defaultQAContactForBugzillaComponent "(#$defaultQAContactForBugzillaComponent AGENT COMPONENT)
means that AGENT is the initial QA contact for Bugzilla bug reports
which are instances of COMPONENT at creation time, unless specifically
stated otherwise by the reporter.")
(comment defaultOwnerForBugzillaComponent "(#$defaultOwnerForBugzillaComponent AGENT COMPONENT) means
that Bugzilla bug reports which are instances of COMPONENT at creation
time are initially assigned to AGENT, unless specifically stated
otherwise by the reporter.")
(comment IslamicJihadOrganization "The collection of instances of #$TerroristGroup-Islamist that are organizations dedicated to establishing an Islamic regime in their homeland.  Many terrorist organizations such as #$JihadGroup and #$LebaneseHizballah use the term\"Islamic Jihad\" as a label for their organization.")
(comment bugzillaComponentBelongsToProduct "(#$bugzillaComponentBelongsToProduct COMPONENT PRODUCT) means
that the Bugzilla bug component COMPONENT is part of the Bugzilla
product PRODUCT. Note that since bug components are collections of bug
reports (see #$BugzillaBugReportTypeByComponent) and bug products are
also collections of bug reports (see
#$BugzillaBugReportTypeByProduct), this predicate is a typed spec pred
of #$genls.")
(comment keSuggestionPreds-InsSpec "A #$KEFacilitationPredicate and #$RuleMacroPredicate.  <code>(#$keSuggestionPreds-InsSpec COL1 BINPRED COL2)</code> means that for every known instance <code>INS1</code> of <code>COL1</code>, it is suggested that there be some specialization <code>SPEC2</code> of <code>COL2</code> such that <code>(BINPRED INS1 SPEC2)</code> is known in the knowledge base.
<p>
For example,
<p>
(#$keSuggestionPreds-InsSpec #$PersonTypeByOccupation #$agentTypePerformsWorkOfType #$PurposefulAction)
<p>
means that for every known instance <code>P-TYPE</code> of #$PersonTypeByOccupation, it is suggested that there be some specialization <code>ACT-TYPE</code> of #$PurposefulAction such that <code>(#$agentTypePerformsWorkOfType P-TYPE ACT-TYPE)</code> is known in the knowledge base.
<p>
See also #$keSuggestionPredsInverse-InsSpec.")
(comment keSuggestionPredsInverse-InsSpec "A #$KEFacilitationPredicate and #$RuleMacroPredicate.  <code>(#$keSuggestionPredsInverse-InsSpec COL1 BINPRED COL2)</code> means that for every known instance <code>INS1</code> of <code>COL1</code>, it is suggested that there be some specialization <code>SPEC2</code> of <code>COL2</code> such that <code>(BINPRED SPEC2 INS1)</code> is known in the knowledge base.
<p>
For example,
<p>
(#$keSuggestionPredsInverse-InsSpec #$SkilledActivityType #$agentTypePerformsActsOfType #$IntelligentAgent)
<p>
means that for every known instance <code>ACT-TYPE</code> of #$SkilledActivityType, it is suggested that there be a specialization <code>AGT-TYPE</code> of #$IntelligentAgent such that <code>(#$agentTypePerformsActsOfType AGT-TYPE ACT-TYPE)</code> is known in the knowledge base.
<p>
See also #$keSuggestionPreds-InsSpec.")
(comment keSuggestionPreds-SpecSpec "A #$KEFacilitationPredicate and #$RuleMacroPredicate.  <code>(#$keSuggestionPreds-SpecSpec COL1 BINPRED COL2)</code> means that for every known specialization <code>SPEC1</code> of <code>COL1</code>, it is suggested that there be some specialization <code>SPEC2</code> of <code>COL2</code> such that <code>(BINPRED SPEC1 SPEC2)</code> is known in the knowledge base.
<p>
For example,
<p>
(#$keSuggestionPreds-SpecSpec #$PreparingFoodOrDrink #$outputsCreated-TypeType #$FoodOrDrink)
<p>
means that for every known specialization <code>PREP-TYPE</code> of #$PreparingFoodOrDrink it is suggested that there be some specialization <code>FD-TYPE</code> of #$FoodOrDrink such that <code>(#$outputsCreated-TypeType PREP-TYPE FD-TYPE)</code> is known in the knowledge base.
<p>
See also #$keSuggestionPredsInverse-SpecSpec.")
(comment keSuggestionPredsInverse-SpecSpec "A #$KEFacilitationPredicate and #$RuleMacroPredicate.  <code>(#$keSuggestionPreds-SpecSpec COL1 BINPRED COL2)</code> means that for every known specialization <code>SPEC1</code> of <code>COL1</code>, it is suggested that there be some specialization <code>SPEC2</code> of <code>COL2</code> such that <code>(BINPRED SPEC2 SPEC1)</code> is known in the knowledge base.
<p>
For example,
<p>
(#$keSuggestionPredsInverse-SpecSpec #$SpaceInAFixedHOC #$eventTypeOccursAtLocationType #$HumanActivity)
<p>
means that for every known specialization <code>SPACE-TYPE</code> of #$SpaceInAFixedHOC, it is suggested that there be a specialization <code>ACT-TYPE</code> of #$HumanActivity such that <code>(#$eventTypeOccursAtLocationType ACT-TYPE SPACE-TYPE)</code> is known in the knowledge base.
<p>
See also #$keSuggestionPreds-SpecSpec.")
(comment keSuggestionPredsInverse-InsIns "A #$KEFacilitationPredicate and #$RuleMacroPredicate.  <code>(#$keSuggestionPredsInverse-InsIns COL1 BINPRED COL2)</code> means that for every known instance <code>INS1</code> of <code>COL1</code>, it is suggested that there be some instance <code>INS2</code> of <code>COL2</code> such that <code>(BINPRED INS2 INS1)</code> is known in the knowledge base.
<p>
For example,
<p>
(#$keSuggestionPredsInverse-InsIns #$Cuisine #$commonFoodTypeOfCuisine #$DefaultDisjointEdibleStuffType)
<p>
means that for every known instance <code>CUIS</code> of #$Cuisine it is suggested that there be an instance <code>ES-TYPE</code> of #$DefaultDisjointEdibleStuffType) such that <code>(#$commonFoodTypeOfCuisine ES-TYPE CUIS)</code> is known in the knowledge base.
<p>
See also #$keSuggestionPreds-InsIns.")
(comment keSuggestionPredsInverse-SpecIns "A #$KEFacilitationPredicate and #$RuleMacroPredicate.  <code>(#$keSuggestionPredsInverse-SpecIns COL1 BINPRED COL2)</code> means that for every known specialization <code>SPEC1</code> of <code>COL1</code>, it is suggested that there be some instance <code>INS2</code> of <code>COL2</code> such that <code>(BINPRED INS2 SPEC1)</code> is known in the knowledge base.
<p>
For example,
<p>
(#$keSuggestionPredsInverse-SpecIns #$SportsEquipment #$gameEquipmentType #$SportsGame)
<p>
means that for every known specialization <code>EQ-TYPE</code> of #$SportsEquipment, it is suggested that there be some instance <code>GAME</code> of #$SportsGame such that <code>(#$gameEquipmentType GAME EQ-TYPE)</code> is known in the knowledge base.
<p>
See also #$keSuggestionPreds-SpecIns.")
(comment definiteNPForArgOfPred "(#$definiteNPForArgOfPred PRED ARGNUM RECIPE) means that RECIPE specifies a definite NP applicable to something that stands in the ARGNUMth arg-position of PRED to some set of other arguments.")
(comment nbarForArgOfPred "(#$nbarForArgOfPred PRED ARGNUM RECIPE) means that RECIPE specifies an nbar applicable to something that stands in the ARGNUMth arg-position of PRED to some set of other arguments.")
(comment carbonCopiedOnBugReport "(#$carbonCopiedOnBugReport AGENT BUG) means that AGENT's email address
explicitly appears in the 'cc' field of BUG. This ensures that AGENT
receives email from the Bugzilla program whenever new comments are posted,
or significant changes are made to BUG.")
(comment TermSuggestorTermType "#$TermSuggestorTermType is a collection of collections of CycL terms.  Each instance of #$TermSuggestorTermType is a collection of terms that has been represented in the Cyc KB to optimize the functioning of the #$TermSuggestor.")
(comment TermSuggestorNonIndexedTerm "#$TermSuggestorNonIndexedTerm is the collection of #$CycLTerms that are ignored when the index used by the #$TermSuggestor is built.")
(comment countyOfCity "(countyOfCity COUNTY CITY) means that CITY is located in COUNTY. This sentence implies both geographical subsumption and an administrative hierarchy. Note that COUNTY may be an instance of #$County, or one of its specs, such as #$USCounty or #$District-India.")
(comment State-India "The collection of all the states of the nation of #$India.")
(comment District-India "The collection of all the districts of the nation of #$India. Districts are the administrative subdivision between cities and states.")
(comment nationOfCounty "(#$nationOfCounty NATION COUNTY) means that COUNTY is located in STATE. This sentence implies both geographical subsumption and an administrative hierarchy. #$nationOfCounty provides transitive closure for #$stateOfCounty and #$nationOfState. Whenever possible, use the more specific #$stateOfCounty to describe instances of #$County.")
(comment stateOfCounty "(stateOfCounty STATE COUNTY) means that COUNTY is located in STATE. This sentence implies both geographical subsumption and an administrative hierarchy. Note that STATE may be an instance of #$State-Geopolitical, or one of its specs, such as #$Prefecture, #$Province, or #$State-India.")
(comment nationOfState "(nationOfState NATION STATE) means that STATE is located in NATION. This sentence implies both geographical subsumption and an administrative hierarchy.")
(disjointWith Married Unmarried)
(comment Unmarried "A specialization of #$Person.  Each instance of this collection is a person that is not married.  This may be because the person is considered too young for marriage in a particular context, like #$HumanPreschooler in #$UnitedStatesSocialLifeMt; or because the person is ineligible for marriage, like #$CatholicPriest; or the person may be #$Single.")
(comment BBCCountryProfile "A specialization of #$PublishedConceptualWork and
#$WebPage-CW.  Each instance of this collection is a country profile
published on the web by the BBC.  See also #$BBCCountryProfileFn.")
(comment BBCCountryProfileFn "An instance of #$IndividualDenotingFunction that takes as
its value an instance of #$Country and returns the instance of
#$BBCCountryProfile on that country.")
(comment RestaurantSpecializingInCuisineFn "A #$UnaryFunction that takes a #$Cuisine and returns the collection of #$Restaurant-Organizations which specialize in that cuisine.  For example, (#$RestaurantSpecializingInCuisineFn #$ItalianCuisine) denotes the collection of Italian restaurants, i.e. restaurants that specialize in Italian cuisine.")
(comment catalogOfHoldings "<code>(#$catalogOfHoldings CATALOG HOLDINGS)</code> means that <code>CATALOG</code> is the #$Catalog-CW of the items in <code>HOLDINGS</code>.  In other words, <code>CATALOG</code> lists and describes the items of <code>HOLDINGS</code>, systematically.")
(comment LibraryCatalog "A specialization of #$Catalog-CW.  Every instance of #$LibraryCatalog lists systematically the items present in the #$LibraryHoldings of a certain #$Library-Organization.  An instantiation of #$LibraryCatalog could be in hardcopy or electronic format.")
(comment typeBehaviorCapable-EventOccursAt "A #$BinaryPredicate.  <code>(#$typeBehaviorCapable-EventOccursAt LOC-TYPE EVENT-TYPE)</code> means that instances of <code>LOC-TYPE</code> are, as a general rule, capable of playing the role of #$eventOccursAt in instances of <code>EVENT-TYPE</code>.")
(comment StrategyConfidenceSlot "A collection of strictly functional predicates.  Each instance is a binary predicate that takes an instance S of #$Strategy in the arg1 and an instance R of #$Real0-1 in the arg2, and relates S to R such that R is the confidence of that strategy, with respect to some implicit criterion.")
(comment calculatedStrategyConfidence "An instance of #$StrictlyFunctionalSlot that relates an instance of #$ProblemSolvingStrategy to a real number between 0 and 1 that represents a confidence in the success of any application of the strategy to an applicable problem.  Unlike other instances of #$StrategyConfidenceSlot, such as #$defaultStrategyConfidence and #$assignedStrategyConfidence, the #$calculatedStrategyConfidence is arrived at through inference, and not by stipulation.  Note that #$calculatedStrategyConfidence can be queried as a strategy is being executed, and the confidence of that strategy might be different from execution to execution, given differences in input and background conditions.")
(comment strategyConfidenceSlotOverrides "(#$strategyConfidenceSlotOverrides SLOT-1 SLOT-2) says that when calculating the confidence of an instance of #$Strategy STRATEGY, the instance SLOT-1 of #$StrategyConfidenceSlot overrides the instance SLOT-2 of #$StrategyConfidenceSlot.  So, for example (#$strategyConfidenceSlotOverrides #$assignedStrategyConfidence #$defaultStrategyConfidence) means that when calculating the confidence of STRATEGY, if (#$defaultStrategyConfidence STRATEGY M) and (#$assignedStrategyConfidence STRATEGY N) and N trumps M when they differ.")
(comment programOutputGeneratedUsingStrategy "(#$programOutputGeneratedUsingStrategy IBT STRATEGY) identifies STRATEGY as the instance of #$Strategy that was used by the program to generate the instance of #$ComputerDataArtifact IBT.")
(comment answerSourceIBT-AcceptedByUser "A predicate used to represent and facilitate dialogue.  (#$answerSourceIBT-AcceptedByUser IBT USER) says that the instance of #$InformationBearingThing IBT has been displayed to, and subsequently accepted by USER.")
(comment Hypocrisy "An instance of #$PersonalQuantity (q.v.).  See also the corresponding collection #$Hypocrite.")
(comment agentTypeLikesType "A #$BinaryPredicate that relates a specialization of #$Agent-Generic to a #$Collection.  <code>(#$agentTypeLikesType AGT-TYPE COL)</code> means that, typically, instances of <code>AGT-TYPE</code> like (in some sense) instances of <code>COL</code>.  See also #$likesType.")
(comment Advisor "A specialization of #$AdministrativeStaffPerson.  Each instance of #$Advisor is a person whose primary job is to advise some other person or persons (usually high-ranking officals) in the same organization.")
(comment agentTypeDislikesType "A #$BinaryPredicate that relates a specialization of #$Agent-Generic to a #$Collection.  <code>(#$agentTypeDislikesType AGT-TYPE COL)</code> means that, typically, instances of <code>AGT-TYPE</code> dislike (in some sense) instances of <code>COL</code>.  For example, See also #$dislikesType.")
(comment choicesForInPredSpecTask "(#$choicesForInPredSpecTask X Y LIST) means that the elements of LIST should be offered to the user as possible predicates relating X to Y.")
(comment CBLAssertFn "A binary function that returns a #$CBLAssert command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment CBLParseFn "A binary function that returns a #$CBLParse command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment CBLParaphraseFn "A binary function that returns a #$CBLParaphrase command and which is composed of the #$CBLMethod and the lexical command sequence number.")
(comment BarbecuingFood "A specialization of #$CookingFood.  Each instance of #$BarbecuingFood is an event in which someone cooks food (often #$Meat) using a #$BBQGrill.  In many cases, #$BarbecueSauce is basted on the food while it is cooking.  Instances of #$BarbecuingFood almost always occur outdoors.")
(comment InsuranceTypeBySituationTypeProtectedAgainst "The collection of all subcollections of #$InsurancePlan whose instances are agreements to provide for the insured (see #$policyHolder) compensation for certain objects that are damaged as a result of a qualifying instance of a certain type of situation.  For example, each instance of #$FloodInsurance is designed to protect the insured against property-damage that results from an instance of #$Flooding.  See also #$policyTypeProtectsAgainst.")
(comment policyTypeProtectsAgainst "A predicate that relates an instance of
 #$InsuranceTypeBySituationTypeProtectedAgainst to the type of situation against which instances of that policy-type are intended to protect.  (#$policyTypeProtectsAgainst POLICY-TYPE SITUATION-TYPE) says that POLICY-TYPE is a type of insurance plan (see #$InsurancePlan) that compensates the policy holder (see #$policyHolder) for damages to objects covered (see #$policyCoversObjects) where those damages are the result of some qualified instance of SITUATION-TYPE.")
(comment frequentEventTypeAtLocationType "A #$BinaryPredicate that relates a specialization of #$SpatialThing-Localized to a specialization of #$Event-Localized.  <code>(#$frequentEventTypeAtLocationType LOC-TYPE EVENT-TYPE)</code> means that for any given instance <code>LOC</code> of <code>LOC-TYPE</code>, it is reasonable to assume, in the absence of information to the contrary, that instances of <code>EVENT-TYPE</code> occur with medium to very high frequency at <code>LOC</code>.  For example, (#$frequentEventTypeAtLocationType #$RestaurantSpace #$CookingFood) means that for any given instance <code>REST</code> of #$RestaurantSpace, it is reasonable to assume, in the absence of information to the contrary (e.g. the information that the #$Restaurant-Organization occupying <code>REST</code> specializes in serving #$RawFood), that instances of #$CookingFood occur with medium to very high frequency at <code>REST</code>.  See also #$typicalLocationTypeOfEventType.")
(comment policyProtectsAgainst "A predicate that relates an instance of
 #$InsurancePlan to the type of situation against which that plan is intended to protect.  (#$policyProtectsAgainst POLICY SITUATION-TYPE) says that POLICY compensates the policy holder (see #$policyHolder) for damages to objects covered (see #$policyCoversObjects) where those damages are the result of some qualified instance of SITUATION-TYPE.")
(comment DisputeOverOwnershipRights "The collection of instances of #$DisputeEvent in which parties are in dispute over who has ownership rights over something.")
(comment TitleDispute "A specialization of both #$ContractualDispute and #$DisputeOverOwnershipRights.  In an instance of #$TitleDispute, the parties who are the #$opponentsInConflict interpret a #$TitleAgreement differently, where the difference in interpretation entails an impact on the ownership rights of both parties in a way that benefits at most one side of the dispute.")
(comment ReMaxRealEstateGlossary "An instance of #$Glossary, in which the terms from the RE/MAX real estate glossary are defined.")
(comment moratoriumOn "A binary predicate that relates a #$Moratorium (q.v.) to the #$Obligation whose performance it delays.  <code>(#$moratoriumOn MORATORIUM OBLIGATION)</code> means that <code>MORATORIUM</code> is a #$Situation in which the fulfillment of <code>OBLIGATION</code> is legally delayed for a certain period of time.  If the #$moratoriumPeriod (q.v.) of <code>OBLIGATION</code> is the time-interval <code>INTERVAL</code>, it follows that the former's #$obligatedAgents are <i>not</i> legally obligated to fulfill <code>OBLIGATION</code> during <code>MORATORIUM</code>.  (Note that it does <i>not</i> follow that the such agents are <i>prohibited</i> from fulfilling <code>OBLIGATION</code> during <code>PERIOD</code>, although that might sometimes be the case.)")
(comment moratoriumPeriod "A binary predicate that relates a #$Moratorium (q.v.) to the #$TimeInterval during which it is in effect.  <code>(#$moratoriumPeriod MORATORIUM INTERVAL)</code> means that <code>MORATORIUM</code> is in effect during, and only during, <code>INTERVAL</code>.  Where <code>MORATORIUM</code> is a #$moratoriumOn <code>OBLIGATION</code>, it follows that the latter's #$obligatedAgents are <i>not</i> legally obligated to fulfill <code>OBLIGATION</code> during <code>MORATORIUM</code>.  (It does <i>not</i> follow that the agents are <i>prohibited</i> from fulfilling <code>OBLIGATION</code> during <code>INTERVAL</code>, although that might sometimes be the case.)
<p>
Note that if, in the above case, <code>(#$obligationPeriod OBLIGATION O-INTERVAL)</code> holds, then <code>O-INTERVAL</code> is #$temporallyDisjoint with <code>INTERVAL</code>.  In other words, an #$Obligation is not in force while there is a #$Moratorium on it.")
(comment DisputeOverAgreementCW "The collection of all instances of #$DisputeEvent in which there is an instance of #$Agreement, the substance of which is in dispute.  See #$disputedAgreement.")
(comment GivingAGratuity "A specialization of #$GivingSomething.  Each instance of #$GivingAGratuity is an event in which an agent gives a (usually small) sum of money -- a gratuity or \"tip\" -- to an agent who has provided him with a service.  In the United States, it is socially expected (though not legally required) that diners at a restaurant give a gratuity to their #$Waitperson (provided the service provided was satisfactory).  Other service workers who are commonly given gratuities (at least in the United States) are #$TaxiDrivers, #$Maids, #$HairStylists, and #$BaggagePorters.  Customs and social expectations regarding gratuities vary greatly from culture to culture.")
(comment Endowment-LifeInsurance "A specialization of #$LifeInsurance.  Each instance of #$Endowment-LifeInsurance is a life insurance agreement that pays out its face value either at the time of death of the policyholder, or the time of maturity of the policy.")
(comment ExaminationOfTitle "A specialization of #$Evaluating.  Each instance of #$ExaminationOfTitle is an event in which a solicitor checks public records to confirm that the prospective seller of a property legally owns the property she is selling.")
(comment ConceptNetNAT-Vetted "Each instance of #$ConceptNetNAT-Vetted is a ConceptNet NAT that has been checked to ensure that its first argument expresses a reasonably clear concept its second argument is correct and sufficiently specific.")
(comment LoanInsurance "The collection of all instances of #$InsurancePlan that provides for the payments on the loan to be made if the party/parties responsible for making such payments are, for reasons identified in the insurance plan, unable to do so.")
(comment Boasting "A specialization of #$StatingSomething.  Each instance of #$Boasting is a communication act in which the speaker or writer intends to give his audience a high opinion of him.  An act of boasting typically takes the form of the boaster pointing out some noteworthy accomplishment, ability, attribute, or possession of his.  (But note that #$Boasting is <i>not</i> disjoint with #$Lying.)")
(comment DefaultingOnMortgage "A specialization of #$DefaultingOnLoan in which the loan defaulted on is an instance of #$MortgageAgreement.")
(comment UrbanGuerillaGroup "A specialization of #$ParamilitaryOrganization and #$RevoltOrganization.  Each instance of #$UrbanGuerillaGroup is a paramilitary group that operates in a large urban area, fighting against the government in power or a foreign occupying force (as the case may be), in hopes of ousting it.  Urban guerillas are so-called because they adapt many of the tactics of traditional #$GuerillaForces (q.v.) to an urban setting.")
(comment ConceptNetKnowledgeBase "The collection of all versions of ConceptNet, which is a knowledgebase described at http://web.media.mit.edu/~hugo/conceptnet/ .")
(disjointWith LowerBody-Human UpperBody-Human)
(comment ThirtyYearMortgageAgreement "The collection of all instances of #$MortgageAgreement that have a #$loanTermDuration of 30 years.")
(comment FifteenYearMortgageAgreement "The collection of all instances of #$MortgageAgreement that have a #$loanTermDuration of 15 years.")
(comment LoanAgreementTypeByTermDuration "A specialization of #$LoanAgreementTypeByTermOption.  Instances are types of loans, defined as having a common term duration (e.g., 30 years, 15 years, etc.) in common.  See also #$loanTermDuration.")
(comment Ridiculing "A specialization of #$Disapproving-CommunicationAct.  In each instance of #$Ridiculing, some #$IntelligentAgent makes fun of, derides, or mocks some agent or object.")
(comment ConfiscatingSomething "A specialization of #$AppropriatingSomething and #$GainingControl (qq.v.) whose instances involve an agent seizing something  by or as if by public authority.  Often the confiscated object will be taken from another agent (who, according to the confiscator, has forfeit it); in such cases the action will also be an instance of #$TransferOfControl.")
(comment ConveyancingOfTitle "A specialization of #$Buying.  Each instance of #$ConveyancingOfTitle is an event in which ownership of a house is transferred from a seller to a buyer.")
(comment CurrentAccountMortgage "A specialization of #$MortgageAgreement.  Each instance of #$CurrentAccountMortgage is a mortgage in which the borrower's debt is effectively held in his current account.  Interest due on such a mortgage is calculated daily rather than yearly.")
(comment DiscountRateMortgage "A specialization of #$MortgageAgreement.  Each instance of #$DiscountRateMortgage is a mortgage with a guaranteed reduction in the variable mortgage rate, for an limited period of time")
(disjointWith FullUseRights Easement-UseRights)
(comment Easement-UseRights "An instance of #$SituationTypeByUserRights.  Each instance of #$Easement-UseRights is a situation in which an agent has a right to a specific limited use or enjoyment of a piece of land that the agent himself does not own.")
(comment catalogEntry "<code>(#$catalogEntry CATALOG ENTRY)</code> means that <code>ENTRY</code> is a #$TextualPCW present in <code>CATALOG</code> as a part of some sequential order.  The ENTRY represents a particular item of the complete #$Holdings or range of #$ProductTypeByBrandVersion, of which CATALOG is a #$Catalog-CW.  An ENTRY generally contains information that helps distinguish an item from the other items that are cataloged in CATALOG.")
(comment PressOfficer "A #$PersonTypeByOccupation (q..v.) whose instances are all and only press officers.   A #$PressOfficer acts as the official media contact for a specific public or private organization, handling all media interest.")
(comment toxicityOf "<code>(#$toxicityOf OBJECT TOXICITY)</code> means that, under normal circumstances, <code>OBJECT</code> has a #$Toxicity level of <code>TOXICITY</code>.
<p>
In order to indicate the level of #$Toxicity of OBJECT for some instance of #$BiologicalLivingObject under different circumstances, more specific predicates, such as #$penetrativeToxicityFor, #$inhalingToxicityFor, #$ingestingToxicityFor and #$contactToxicityFor, must be used.")
(comment GLFNodeSemanticsWRTGraphFn "(#$GLFNodeSemanticsWRTGraphFn SEMANTICS GRAPH) denotes the instance INS of #$GLFNode that is a part of the graphical structure of the instance of #$Graph-CW GRAPH, such that in the context of GrAPH, INS represents SEMANTICS.")
(comment GLFArcSemanticsWRTGraphFn "(#$GLFArcSemanticsWRTGraphFn SEMANTICS GRAPH) denotes the instance INS of #$GLFArc that is a part of the graphical structure of the instance of #$Graph-CW GRAPH, such that in the context of GrAPH, INS represents SEMANTICS.")
(comment SOEGLFGraphDefiningMicrotheory "The collection of all instances of #$Microtheory that define a graph that can be displayed and extended using the Simple Ontology Editor (see #$TheSimpleOntologyEditorTool).")
(comment soeMtForGraphStructure "(#$soeMtForGraphStructure MT GRAPH) means that MT is the instance of #$SOEGLFGraphDefiningMicrotheory that defines the graphical structure GRAPH.")
(comment CreatingACWOfTypeFn "A unary #$CollectionDenotingFunction that takes a specialization <code>CW-TYPE</code> of #$ConceptualWork and returns the collection of all #$CreationEvents in which an instance of <code>CW-TYPE</code> is created.  For example, (#$CreatingACWOfTypeFn #$Novel-CW) is the collection of all events in which a novel is created.")
(comment TopicDirectedDiscourse "A specialization of #$MultiDirectionalCommunication. Instances of this collection are comprised of a topically cohesive series of dialogue contributions (#$CommunicationAct-Single). ")
(comment InteractionTypeByHandlingStatus "Instances of this collection are types of #$ComputerUserInteractions sorted by their handling status")
(comment ComputerUserInteraction-Complete "Instances of this collection are  #$ComputerUserInteractions which are complete.")
(comment ComputerUserInteraction-Incomplete "Instances of this collection are  #$ComputerUserInteractions which are incomplete.")
(disjointWith ComputerUserInteraction-Complete ComputerUserInteraction-Incomplete)
(comment interactionStatus "(#$interactionStatus INTERACTION STATUS) means that the #$ComputerUserInteraction INTERACTION is an instance of the #$ComputerInteractionTypeByHandlingStatus STATUS.")
(comment creationTypeForCWType "A #$StrictlyFunctionalSlot that relates a specialization of #$ConceptualWork to a specialization of #$CreationEvent.  <code>(#$creationTypeForCWType CW-TYPE CREATION-TYPE)</code> means that <code>CREATION-TYPE</code> is the collection of all #$CreationEvents in which an instance of <code>CW-TYPE</code> is created.  This is the predicate corresponding to #$CreatingACWOfTypeFn (q.v.).")
(comment vetoProhibitsActType "A #$BinaryRoleTypePredicate that holds between an instance of #$VetoingSomething and a specialization of #$Action that the veto prohibits.  <code>(#$vetoProhibitsActType VETO ACTTYPE)</code> means that <code>VETO</code> prohibits or disallows any instance of <code>ACTTYPE</code> from being performed.  Such a <code>VETO</code> will normally occur in response to some agent's proposing to do an action of <code>ACTTYPE</code>.   Note that this does not imply that no acts of <code>ACTTYPE</code> are performed subsequent to <code>VETO</code>, since vetoes are sometimes disobeyed.
<p>
See also #$lawProscribesActType.")
(comment MortgageAgreementTypeByLienPosition "The collection of all subcollections of #$MortgageAgreement that share a common lien position.")
(comment Plan "A specialization of #$NormativeSpecification.  Each instance of #$Plan is a propositional conceptual work that specifies how certain actiona are to be carried out.  The contents of plans are assertible in the instances of #$PlanSpecificationMicrotheory that correspond to specific instances of #$Plan.")
(comment mortgageLienPosition "(#$mortgageLienPosition MORTGAGE TYPE) identifies TYPE as the instance of #$MortgageAgreementTypeByLienPosition that MORTGAGE is an instance of.  For example, (#$mortgageLienPosition The2ndMortgageOnMyHouse #$SecondMortgage) means that the 2nd mortgage on my house is a second mortgage, and thus has a secondary lien position with respect to the first mortgage.")
(comment RealEstateLoan "The collection of all instances of #$LoanAgreement that essentially involve real estate, whether as collateral (e.g., as in a home equity loan or a mortgage) or as an object towards which the money loaned is used (e.g., as in aconstruction loan or a home improvement loan.")
(comment nonDisplayableLinkBetweenInSystem "(#$nonDisplayableLinkBetweenInSystem LINK THING-1 THING-2 SYSTEM) tells the Graphic Format Library code not to display the link that holds between THING-1 and THING-2 in the path system SYSTEM.")
(comment RoadHazard-VehicleJoiningTraffic "A sub-collection of #$DangerousSituation and #$TransportWithMotorizedLandVehicle.  This situation is characterized by those cases where a vehicle is travelling along a road and a #$Bus-RoadVehicle merges on to that same road.")
(comment RoadHazard-ApproachingUTurningCar "A sub-collection of #$DangerousSituation and #$TransportWithMotorizedLandVehicle.  This situation is characterized by those cases where a vehicle is travelling along a road and it approaches a hill where another vehicle is performing a #$U-turn.")
(comment GettingOnToARoad "The process of a #$PartiallyTangible moving on to a road from some other location.")
(comment SalientDescriptorFETForTypeFn "(#$SalientDescriptorFETForTypeFn COLLECTION) denotes the collection of #$FormulaTemplate for instances of COLLECTION based on Salient Descriptor prompts for example instances of that collection.")
(comment AddressingAUserQuery "A specialization of #$ComputerUserInteraction. Instances of this collection are comprised of a series of events in which a question answering system attempts to address a user's query (see #$PosingAQuestionToAQuestionAnsweringSystem).  This may include the generation, prioritzation, and presentation of candidate answers as well evaluation of the user's satisfaction with such  resposnes.")
(comment permissionTypeGrantsLicenseType "(#$permissionTypeGrantsLicenseType GRANTING-TYPE LICENSE)
means that GRANTING, a specialization of #$GrantingPermission, grants
an agent an instance, INS, of a specialization of
#$License-LegalAgreement, LICENSE.  For example, (#$permissionTypeGrantsLicenseType (#$IssuingLicenseTypeFn #$MarriageLicense) #$MarriageLicense)
means that (#$IssuingLicenseTypeFn #$MarriageLicense) results in the
issuance of an instance of #$MarriageLicense.")
(comment GenlsForIndirectFacetFn "An instance of #$CollectionDenotingFunction. (#$GenlsForIndirectFacetFn COLLECTION FACETING-COLLECTION) denotes the #$nearestGenls GENL of COLLECTION such that (#$isa GENL FACETING-COLLECTION).")
(comment speedOfObject-Underspecified "<code>(#$speedOfObject-Underspecified OBJECT SPEED)</code> specifies a very general relation between <code>OBJECT</code> and its #$Speed level <code>SPEED</code>.  This predicate cannot be used to specify the speed of certain things (e.g. computer) or events (e.g. flow of a liquid) where the speed is in fact a rate (see #$EventRate).")
(comment StickballPitchSequence "The collection of #$GameEvents in which people play stickball.")
(comment situationMightBeSubSituationType "<code>(#$situationMightBeSubSituationType SIT SIT-TYPE SUB-SIT-TYPE)</code> means that there is evidence to the effect that <code>SIT</code> is an instance of <code>SUB-SIT-TYPE</code>, which is a sub-situation type (see #$subSituationTypes) of <code>SIT-TYPE</code>.")
(comment LoanAgreementTypeByFundingSector "A collection of collections.  Each instance of #$LoanAgreementTypeByFundingSector is a collection of #$LoanAgreements whose funding comes from the same basic sector of society, meaning either the <i>public sector</i> (see #$GovernmentFundedLoan) or the <i>private sector</i> (see #$ConventionalLoan).  These two types of loans reflect the distinction made by lending institutions between loans that are insured, funded, or guaranteed by a government institution and those that are not.  See also #$GovernmentLoanTypeByFundingSource.")
(comment TheCycOntology "The Cyc ontology.")
(comment RubberBall "A specialization of #$Ball.  Each instance of #$RubberBall is a ball made of rubber, with or without a hollow core or any additional material coating the exterior.")
(comment ConventionalRealEstateLoan "The collection of instances of #$RealEstateLoan that do not include any government funds or guarantees.")
(comment LacrosseBall "The ball manipulated in a #$Lacrosse game.")
(comment ReturningSomething "A specialization of #$GivingSomething. In each instance of #$ReturningSomething, a tangible thing or object (see #$objectOfPossessionTransfer) is returned by an #$Agent-PartiallyTangible to another #$Agent-PartiallyTangible who is the original possessor/owner of the object.  An instance of #$ReturningSomething is generally an event following an instance of #$Renting or #$BorrowingSomething where the same object is involved.  It could also take place after events which are instances of #$Buying, #$Bartering, etc.")
(comment Financier "The collection of instances of #$PersonWithOccupation who  is skilled in large scale financial transactions and often engaged in the lending and management of money.")
(comment WineTypeByGrapeType "A #$FacetingCollectionType.  Each instance of #$WineTypeByGrapeType is a specialization of #$Wine whose instances are all made (at least partially) with the same kind of grape.  Instances include #$CabernetSauvignon-Wine, #$PinotNoir-Wine, and #$Chardonnay-Wine.")
(comment WineOfVintageFn "A unary #$CollectionDenotingFunction that takes a #$CalendarYear and returns a #$WineTypeByVintage.  <code>(#$WineOfVintageFn YEAR)</code> denotes the collection of instances of #$Wine whose vintage (i.e. year of harvest) is <code>YEAR</code>.")
(comment WineOfRegionFn "A unary #$CollectionDenotingFunction that takes a #$GeographicalRegion and returns a #$WineTypeByRegion.  <code>(#$WineOfRegionFn REGION)</code> denotes the collection of instances of #$Wine that were made in <code>REGION</code>.")
(comment WineTypeBySweetness "A #$FacetingCollectionType.  Each instance of #$WineTypeBySweetness is a specialization of #$Wine whose instances share the same level of sweetness.  Instances include #$Wine-Dry, #$Wine-OffDry, and #$Wine-Sweet.")
(disjointWith Wine-Dry WhiteZinfandel)
(comment Wine-Dry "A #$WineTypeBySweetness.  Each instance of #$Wine-Dry is some #$Wine that completely lacks sweetness.")
(comment Wine-OffDry "A #$WineTypeBySweetness.  Each instance of #$Wine-OffDry is some #$Wine with very little sweetness.")
(comment Wine-Sweet "A #$WineTypeBySweetness.  Each instance of #$Wine-Sweet is some #$Wine that significant sweetness.")
(comment WineOfWineryFn "A unary #$CollectionDenotingFunction that takes a #$Winery and returns a #$WineTypeByWinery.  <code>(#$WineOfWineryFn WINERY)</code> denotes the collection of instances of #$Wine that were made by <code>WINERY</code>.")
(comment WineTypeByBody "A #$FacetingCollectionType.  Each instance of #$WineTypeByBody is a specialization of #$Wine whose instances share the same \"body,\" i.e. impression of weight or fullness on the palate.  Instances include #$Wine-FullBodied, #$Wine-MediumBodied, and #$Wine-LightBodied.")
(comment Wine-FullBodied "A #$WineTypeByBody.  Each instance of #$Wine-FullBodied is some #$Wine that is full-bodied.")
(comment Wine-MediumBodied "A #$WineTypeByBody.  Each instance of #$Wine-MediumBodied is some #$Wine that is medium-bodied.")
(comment Wine-LightBodied "A #$WineTypeByBody.  Each instance of #$Wine-LightBodied is some #$Wine that is light-bodied.")
(comment WineTypeByTanninLevel "A #$FacetingCollectionType.  Each instance of #$WineTypeByTanninLevel is a specialization of #$Wine whose instances share the same level of tannin, or tannic acid.  Instances include #$Wine-HighTannin, #$Wine-MediumTannin, and #$Wine-LowTannin.")
(disjointWith Play-CW ReferenceWorkEntry)
(disjointWith PoeticWork ReferenceWorkEntry)
(disjointWith Screenplay ReferenceWorkEntry)
(comment ReferenceWorkEntry "The collection of all instances of #$TextualPCW that are entries in an instance of #$ReferenceWork.  See #$referenceWorkHasEntry.")
(comment referenceWorkEntrySemantics "(#$referenceWorkEntrySemantics ENTRY THING) identifies THING as the topic of the instance of #$ReferenceWorkEntry ENTRY.  Note that this predicate is not an instance of #$StrictlyFunctionalSlot; though one should expect that a glossary entry should be about a single concept, this is frequently not the case.")
(comment RenewingLibraryItem "A collection of events.  In an instance of #$RenewingLibraryItem, the borrower renews the term of the library loan for the #$Library-Organization item that is borrowed (see #$BorrowingLibraryItem).  Thus, an instance of #$RenewingLibraryItem results in the extension of the stipulated lending period during which the borrower has #$PrimaryUserRights on the borrowed items and a fine for late return (see #$ReturningLibraryItem) would not be charged.")
(comment properPartTypes "A #$RuleMacroPredicate.  Where <code>TYPE1</code> and <code>TYPE2</code> are both specializations of #$Individual, <code>(#$properPartTypes TYPE1 TYPE2)</code> means that every instance of <code>TYPE1</code> has an instance of <code>TYPE2</code> as a proper part.")
(comment BeResponsive-DQAStrategy "An instance of
#$MySentientDeductiveQuestionAnsweringProblemSolvingStrategy that
attempts to be responsive to the user's questions in cases where the question us not fully understood by the system.")
(comment strategyImplementationQueries "(#$strategyImplementationQueries STRATEGY QUERY) means that a successful execution of STRATEGY will involve running the instance of #$CycLQuerySpecification QUERY.")
(comment AssignmentTemplateTopicReformulation "AssignmentTemplateTopicReformulation is a reformulator specification that points all FET output formulae to the pre-reformulation rules that resolve unknown values.")
(comment agentsWorkIsBlockedWRTSpec "An assertion of the form (#$agentsWorkIsBlockedWRTSpec AGENT SPEC) relates an instance of #$IntelligentAgent to an instance of #$NormativeSpecification and states that AGENT is not actively engaged in realizing SPEC because there is some problem that prevents him or her from doing so.  This relation is temporally qualifiable.")
(comment agentsWorkIsInactiveWRTSpec "An assertion of the form (#$agentsWorkIsInactiveWRTSpec AGENT SPEC) relates an instance of #$IntelligentAgent to an instance of #$NormativeSpecification and states that AGENT is not actively engaged in realizing SPEC.  This relation is temporally qualifiable.")
(comment WorkStatusBinaryPredicate "A collection of predicates for representing the relationship between an #$IntelligentAgent and a #$NormativeSpecification.")
(comment WorkEventOnSpecificationFn "An expression of the form (#$WorkEventOnSpecificatonFn SPEC) is used to denote the largest instance of #$WorkingEvent where the #$NormativeSpecificaton SPEC guides the behavior of the individuals who play the role of #$performedBy in that #$WorkingEvent. More specifically, SPEC describes a situation and the performers are acting to try to bring about that situation.")
(comment WorkOnSpecificationByAgentFn "An #$IndividualDenotingFunction, an expression of the form (#$WorkOnSpecificationByAgentFn NORM-SPEC AGENT) is used to represent the overall instance of #$WorkingEvent whereby the #$IntelligentAgent AGENT is working to bring about the #$NormativeSpecification NORM-SPEC.  For instance, this function could represent the total work done by an agent to complete the requirements of an instance of #$Assignment-Specification.")
(comment workDoneOnSpecificationByAgent "The corresponding predicate of the function #$WorkOnSpecificationByAgentFn.  It relates an instance of #$WorkingEvent to an instance of #$NormativeSpecification and an instance of #$IntelligentAgent and asserts that the #$WorkingEvent is the total work done by the #$IntelligentAgent towards bringing about the #$NormativeSpecification NORM-SPEC.")
(comment agentsWorkIsPendingWRTSpec "An assertion of the form (#$agentsWorkIsPendingWRTSpec AGENT SPEC) relates an instance of #$IntelligentAgent to an instance of #$NormativeSpecification and states that AGENT is not actively engaged in realizing SPEC, but plans to do so in the future, although no start date has been specified.  This relation is temporally qualifiable.")
(comment workEventOnSpecification "The corresponding predicate of the function #$WorkEventOnSpecificationFn.  An assertion of the form (#$workEventOnSpecification EVENT SPEC) means that the instance of #$WorkingEvent EVENT is the largest instance of #$WorkingEvent where the #$NormativeSpecification SPEC guides the behavior of the indivduals who play the role of #$performedBy in EVENT.")
(comment agentsWorkIsActiveWRTSpec "An assertion of the form (#$agentsWorkIsActiveWRTSpec AGENT SPEC) relates an instance of #$IntelligentAgent to an instance of #$NormativeSpecification and states that AGENT is actively engaged in realizing SPEC.  This relation is temporally qualifiable.")
(comment MaximalSubSituationDuringIntervalFn "An #$IndividualDenotingFunction, an expression of the form (#$MaximalSubSituationDuringIntervalFn SIT INTERVAL) is used to represent the the largest instance of #$Situation that is a  #$subSituations of the #$Situation SIT and that #$TimeInterval INTERVAL #$temporallySubsumes.")
(comment agentsWorkIsScheduledWRTSpec "An assertion of the form (#$agentsWorkIsScheduledWRTSpec AGENT SPEC) relates an instance of #$IntelligentAgent to an instance of #$NormativeSpecification and states that AGENT is not actively engaged in realizing SPEC, but plans to do so in the future, with a specific start date.  This relation is temporally qualifiable.")
(comment situationDescription "An assertion of the form (#$situationDescription SIT STRING) means that the #$SubLString STRING is an NL description of the the #$Situation SIT.")
(comment requestHasAlternateAgent "An assertion of the form (#$requestHasAlternateAgent REQ AGENT) states that the #$ResourceRequest involves the #$Agent-Generic as an alternate to the #$Agent-Generic who fills the role of #$requestedAgent, should the request for the primary agent be declined.")
(comment agentsWorkIsSuspendedWRTSpec "An assertion of the form (#$agentsWorkIsSuspendedWRTSpec AGENT SPEC) relates an instance of #$IntelligentAgent to an instance of #$NormativeSpecification and states that AGENT is not actively engaged in realizing SPEC because of an intentional choice not to do so on the part of some agent who is involved in the realization of SPEC.  This relation is temporally qualifiable.")
(comment isMaximalSubSituationDuringInterval "The corresponding predicate of the function #$MaximalSubSituationDuringIntervalFn.  It relates an instance of #$Situation to an instance of #$Situation and an instance of #$TimeInterval.  An assertion of the form (#$isMaximalSubSituationDuringInterval SIT1 SIT2 INTERVAL) states that SIT1 bears the relation #$subSituations from SIT2 and is the largest sub-situation of SIT2 that INTERVAL #$temporallySubsumes.")
(comment agentsWorkIsCompletedWRTSpec "An assertion of the form (#$agentsWorkIsCompletedWRTSpec AGENT SPEC) relates an instance of #$IntelligentAgent to an instance of #$NormativeSpecification and states that SPEC, or some portion of SPEC, has been realized by AGENT.  This relation is temporally qualifiable.")
(comment agentsWorkIsCancelledWRTSpec "An assertion of the form (#$agentsWorkIsCancelledWRTSpec AGENT SPEC) relates an instance of #$IntelligentAgent to an instance of #$NormativeSpecification and states that AGENT has abandonned his or her attempt to realize SPEC.  This relation is temporally qualifiable.")
(comment agentEstimatedRemainingWorkForSpec "A #$TemporallyQualifiableRelation.  An assertion of the form (#$agentEstimatedRemainingWorkForSpec AGENT QUANT SPEC) states that according to the #$IntelligentAgent AGENT, AGENT will need to work for the #$Time-Quantity QUANT, in order to complete his or her work relative to the realization of the #$NormativeSpecification SPEC.")
(comment TheInternationalSurvivalGuide-ExplosiveWeapon-Webpage " An instance of #$WorldWideWebPage-AIS containing
information in the kinds of explosives used in terrorist attacks.")
(comment BombTypeOfExplosiveMaterialFn "An instance of #$CollectionDenotingFunction that takes for
its value a specialization of #$ExplosiveMaterial MATERIAL and returns the
collection of #$Bombs WEAPON whose #$weaponTypeBasisObjectType is MATERIAL.")
(comment Semtex "A specialization of #$PlasticBondedExplosive.  Each instance
of this collection is an amount of the stable compound of #$RDXExplosive
and #$PETN frequently used in terrorist attacks.")
(comment SynthesiaChemicalCompany "An instance of #$Individual that is the chemical company
located in the #$CzechRepublic responsible for creating and
manufacturing #$Semtex.")
(comment HBXExplosive "A specialization of #$ExplosiveMaterial.  Each instance of
this collection is a chemical substance that is a mixture of RDX, TNT,
powdered aluminum, and D-2 wax with calcium chloride.  Instances are
most commonly used in warheads and underwater ordnance.")
(comment H-6Explosive "A specialization of #$ExplosiveMaterial.  Each instance of
this collection is a chemical substance that is a mixture of RDX, TNT,
powdered aluminum, and D-2 wax with calcium chloride and is used for
general purpose bombs.")
(comment Cyclotol "A specialization of #$ExplosiveMaterial.  Each instance of
this collection is a chemical substance that is a mixture of #$RDXExplosive and
TNT.  The chemical substance is used for shaped-charge bombs, special
fragmentation projectiles and grenades.")
(comment bombTypeOfExplosiveMaterial "(#$bombTypeOfExplosiveMaterial EXPLOSIVE-TYPE BOMB-TYPE)
means that the specialization of #$ExplosiveMaterial EXPLOSIVE-TYPE is
the #$stuffedUsed in the specialization of #$Bomb BOMB-TYPE.  For
example, (#$bombTypeOfExplosiveMaterial #$ANFOBomb #$ANFO) means that
every instance of #$ANFOBomb uses #$ANFO.  See also
#$BombTypeOfExplosiveMaterialFn.")
(comment Rancher "A specialization of #$Farmer.  Each instance of this
collection is a #$PersonWithOccupation that owns and/or works primarily
on an instance of #$LivestockFarm.")
(comment ProductDescriptionTemplate "A spec of #$FormulaTemplate. The collection of formula templates for the ProductDescriptionProject.")
(comment properPhysicalDecompositions "An #$IrreflexiveBinaryPredicate and a specialization of #$properParts and #$physicalDecompositions (qq.v.).  <code>(#$properPhysicalDecompositions WHOLE PART)</code> means that <code>PART</code> is a proper physical part of <code>WHOLE</code> in a very broad sense of 'part' whereby <code>PART</code> might or might not be spatially continuous or discrete. Thus <code>PART</code> might be discontinuous, or even diffused throughout <code>WHOLE</code>.")
(comment RegulatingASectorOrIndustry "A specialization of both #$LegalProceeding and #$EconomicAction.  Each instance of #$RegulatingASectorOrIndustry is an event in which a government adds regulations to an economic sector or industry.  The government's purpose in adding such regulations is usually to avoid negative externalities (as, for example, through adding anti-pollution regulations) or to aid consumers (as, for example, through anti-monopoly regulations).")
(comment StuffTypeWRTPredFn "<code>(#$StuffTypeWRTPredFn PRED)</code> denotes the collection of collections that are stuff-like with respect to <code>PRED</code>.
<p>
For every collection <code>STUFFTYPE</code> that is an instance of <code>(#$StuffTypeWRTPredFn PRED)</code>, if <code>STUFF</code> is an instance of <code>STUFFTYPE</code>, <code>(PRED STUFF STUFFPART)</code>, and <code>STUFFPART</code> is above the granularity level for <code>STUFFTYPE</code>, then <code>STUFFPART</code> is also an instance of <code>STUFFTYPE</code>.")
(comment agentTypeTypicallyLikesRoleInEventType "A #$TernaryPredicate that relates a specialization of #$Agent-Generic to a #$BinaryRolePredicate to a specialization of #$Event.  <code>(#$agentTypeTypicallyLikesRoleInEventType A-TYPE ROLE E-TYPE)</code> means that instances of <code>A-TYPE</code> typically like playing <code>ROLE</code> in instances of <code>E-TYPE</code>.
<p>
For example, (#$agentTypeTypicallyLikesRoleInEventType #$Dog #$objectTakenCareOf #$WalkingAPet) means that instances of #$Dog typically like playing the role of #$objectTakenCareOf in instances of #$WalkingAPet -- that is, dogs like to be taken for walks.")
(comment objectlikeWRTPred "This predicate relates collections to the parthood relationships by which the collection is deemed \"object-like\".
<p>
<code>(#$objectlikeWRTPred OBJECTTYPE PARTHOODPRED)</code> means that if <code>OBJ</code> is an instance of <code>OBJECTTYPE</code> and <code>(PARTHOODPRED OBJ OBJPART)</code>, then <code>OBJPART</code> is not also an instance of <code>OBJECTTYPE</code>.")
(comment OnlineMortgageTermsAndDefinitions-Glossary "An instance of #$Glossary that contains definitions of terms pertinent to mortgaging.")
(comment ProperPartPredicate "A collection of predicates. Instances of #$ProperPartPredicate are used to describe the relationship between a thing and its proper parts.")
(comment LaserBeam "A collection of events.  Each instance of #$LaserBeam is an event in which a monochromatic rays of light travel in a coherent directional beam.")
(comment InvestorWordsDotCom-Glossary "An instance of #$Glossary that contains definitions of terms pertinent to investing.")
(comment HomeRaid "A specialization of #$RaidingAnObjective.  Each instance of
this collection in which a home invaded by a small force.  Instances
may or may not include attacks on the person(s) inside the residence,
or even that any person be located inside the residence.  Positive
examples of this collection include instances of police raiding a home
for evidence, a terrorist group invading a home for intimidation
purposes, and so forth.")
(comment AmbushingATangible "A specialization of #$SurpriseAttack. Each instance of this
collection is an event in which a surprise attack is launched against
an instance of #$PartiallyTangible. Typically, an ambush has been set
up on a route and the target moves into the ambush.")
(comment AmbushingAVehicle "A specialization of #$AmbushingATangible.  Each instance of
this collection is an attack perpetrated against an instance(s) of
#$TransportationDevice-Vehicle.")
(comment ArmedAttack "A specialization of #$AttackOnObject.  Each ")
(comment AdministeringAnInjection "A specialization of #$ControllingAPhysicalDevice and
#$PuttingSomethingIntoSomething.  Each instance of this collection is
an event in which an agent injects a substance, either into another
agent or himself/herself.  Notable specializations of this collection
include #$Injecting-Medical.  Positive examples of this collection
would include also instances of an agent inject illegal drugs into a
body for a high as well as instances of an agent injecting a toxin
into an organism.")
(comment InjectingAToxin-Poisoning "A specialization of #$AdministeringAnInjection and
#$Poisoning-Script.  Each instance of this collection is an event in
which an agent is injected with a toxic substance, either by another
agent or by his or her own hand.")
(comment derivedAllocations-Root "A more specialized form of #$derivedAllocations.  An assertion of the form (#$derivedAllocations-Root ROOT ALLOT) states that the #$Allotment ALLOT is drawn directly from the total body of resources ROOT (an instance of #$RootAllotment).  This predicate is intended to help inference pick out instances of #$Allotment that are drawn directly from a #$RootAllotment.")
(comment negativeEquityInProperty "An instance of #$QuantitySlot. (#$negativeEquityInProperty PROPERTY VALUE) means that PROPERTY has as equity (c.f., #$equityInProperty) the negative value NEG-VALUE, where NEG-VALUE = (#$MinusFn VALUE).")
(comment mutualAcquaintances "A specialization of #$acquaintedWith (q.v.) and an instance of #$SymmetricBinaryPredicate. <code>(#$mutualAcquaintances AG1 AG2)</code> means that #$IndividualAgents <code>AG1</code> and <code>AG</code> are acquainted with one another in some fashion.  Either they can visually recognize one another, they have been involved in a conversation with one another, they have personally met one another, or they are in some other manner mutually acquainted.  This predicate differs from #$acquaintedWith only insofar as #$acquaintedWith is not symmetric, whereas #$mutualAcquaintances is symmetric.  An important specialization of #$mutualAcquaintances is #$simpleContactAcquaintances (q.v.).")
(comment projectMarkerConstant "(#$projectMarkerConstant PROJECT COLL-OF-CONSTANTS) holds just in case COLL-OF-CONSTANTS is the #$CycKBSubsetCollection that corresponds to PROJECT.  In essence, this relation holds whenever terms created by PROJECT need to be instances of COLL-OF-CONSTANTS.  Note that this relation essentially involves #$CycLConstants but is not quoted in any argument place.  This is because the first argument is the project and not the term for the project and the second argument is a collection of terms, not the term that refers to that collection.")
(comment coIntegralScalars "A binary #$RuleMacroPredicate that relates #$ScalarIntegralValues (q.v.) that are integral with respect to the same unit of measure (see #$integralWRTUnit).  <code>(#$coIntegralScalars SCALAR1 SCALAR2)</code> means that there is some #$UnitOfMeasure (q.v.) <code>UNIT</code> such that both of these hold:
<pre>
  (#$integralWRTUnit SCALAR1 UNIT)
  (#$integralWRTUnit SCALAR2 UNIT).
</pre>
For example, (#$Meter 5) and (#$Meter 10) are co-integral.
<p>
Note that #$coIntegralScalars holds between <i>any</i> two #$Integers, as each integer is integral with respect to #$Unity (q.v.).")
(comment builderQueryForTemplate "(#$builderQueryForTemplate QUERY TEMPLATE) means that QUERY is a builder query for TEMPLATE.")
(comment COLINGConference "International Conference held every second year, organized by the International Committee on Computational Linguistics.")
(comment situationMightBeSituationType "<code>(#$situationMightBeSituationType SIT SIT-TYPE)</code> means that there is evidence to the effect that <code>SIT</code> (an instance of #$Situation), is an instance of <code>SIT-TYPE</code> (a specialization of #$Situation).")
(comment SituationProfilingPredicate "The collection of predicates used to do reasoning about whether and to what extent situations match patterns specifed at the type level (in terms of \"scripting\" vocabulary, such as #$properSubSituationTypes, #$someAndOnlyTypePlaysRoleInSubSituationType, etc.).")
(comment miniatureSizedVarietyOf "A specialization of #$genls.  (#$miniatureSizedVarietyOf SUB-TYPE TYPE) identifies SUB-TYPE as the collection of miniature-sized instances of TYPE, an instance of #$OrganismClassificationType.  For example, (#$miniatureSizedVarietyOf #$Poodle-MiniatureSizedVariety #$Poodle) identified #$Poodle-MiniatureSizedVariety as the collection of miniature poodles. For this relation to hold between SUB-TYPE and TYPE, SUB-TYPE must be a recognized classification of \"miniatures\" (c.f., #$ConventionalClassificationType), though different authorities might disagree on membership.")
(comment standardSizedVarietyOf "A specialization of #$genls.  (#$standardSizedVarietyOf SUB-TYPE TYPE) identifies SUB-TYPE as the collection of standard-sized instances of TYPE, an instance of #$OrganismClassificationType.  For example, (#$standardSizedVarietyOf #$Dachshund-StandardSizedVariety #$Dachshund) identified #$Dachshund-StandardSizedVariety as the collection of standard-sized dachshunds. For this relation to hold between SUB-TYPE and TYPE, SUB-TYPE must be a recognized classification by some authoritative group (c.f., #$ConventionalClassificationType), though different authorities might disagree on membership.")
(comment toySizedVarietyOf "A specialization of #$genls.  (#$toySizedVarietyOf SUB-TYPE TYPE) identifies SUB-TYPE as the collection of \"toy\"-sized instances of TYPE, an instance of #$OrganismClassificationType.  For example, (#$toySizedVarietyOf #$ManchesterTerrier-ToySizedVariety #$Terrier-Manchester) identifies #$ManchesterTerrier-ToySizedVariety as the collection of toy-sized Manchester Terriers. For this relation to hold between SUB-TYPE and TYPE, SUB-TYPE must be a recognized classification by some authoritative group (c.f., #$ConventionalClassificationType), though different authorities might disagree on membership.")
(comment situationMightBeSubSituationType-ViaRolePlayerType "An instance of #$SituationProfilingPredicate. <code>(#$situationMightBeSubSituationType-ViaRolePlayerType SIT SITTYPE SUBSITTYPE ROLE TYPE)</code> means that there is evidence to the effect that <code>SIT</code> is an instance of <code>SUBSITTYPE</code>, which is a sub-situation type (see #$subSituationTypes) of <code>SITTYPE</code>.  The evidence is based on knowledge that some instance of <code>TYPE</code> plays <code>ROLE</code> in <code>SIT</code>, and instances of <code>TYPE</code> are known typically to play the role <code>ROLE</code> in instances of <code>SUBSITTYPE</code> that are sub-situations of instances of <code>SITTYPE</code>.")
(comment BuyingToLet "A specialization of (#$BuyingFn #$HumanResidence). Each instance of #$BuyingToLet is an event in which an agent buys an instance of #$HumanResidence for the purpose of leasing that residence to other agents.")
(comment ReturningLibraryItem "A collection of events; a subset of #$ReturningSomething.  In each instance of #$ReturningLibraryItem, the borrower (see #$BorrowingLibraryItem) returns the borrowed library-item.  After an instance of #$ReturningLibraryItem, the #$Agent-PartiallyTangible who returns the borrowed item loses the #$PrimaryUserRights on the item.")
(comment adjectiveOfCountry "<code>(#$adjectiveOfCountry COUNTRY WORD)</code> means that the adjective form of <code>WORD</code> describes things, people, etc. that in a general or relevant sense belong to <code>COUNTRY</code>.")
(comment remainsOf "<code>(#$remainsOf IND CORPSE)</code> means that <code>CORPSE</code> constitutes the remains of the #$Individual <code>IND</code>.  #$remainsOf is the predicate that corresponds to the function #$RemainsFn (q.v.).")
(comment criminalAuthorities "<code>(#$criminalAuthorities CRIME AUTH)</code> means that in the event <code>CRIME</code> (an instance of #$CriminalAct), the #$GovernmentalOrganization <code>AUTH</code> is among the authorities who have responsibility for investigating <code>CRIME</code>.")
(comment TransferOfControlOfTypeFn "This is a collection-denoting function. <code>(#$TransferOfControlOfTypeFn SE-TYPE)</code> denotes the sub-collection of  #$TransferOfControl, where the role of #$objectOfControlTransfer is an instance of <code>SE-TYPE</code>, a specialization of #$SomethingExisting.")
(comment typeOfControlTransferOfType "<code>(#$typeOfHostileSeizureOfType EVT-TYPE OBJ-TYPE)</code> means <code>EVT-TYPE</code> is the specialization of #$TransferOfControl in which instances of <code>OBJ-TYPE</code>, some sub-collection of #$SomethingExisting, plays the role of #$objectOfControlTransfer.")
(comment requestingAgent "An assertion of the form (#$requestingAgent AGENT REQUEST ) states that that REQUEST, an instance of #$ResourceRequest (and, by extension, an instance of #$ConceptualWork) represents an allocation of resources that the #$IntelligentAgent AGENT wishes to be dedicated to the realization of some #$NormativeSpecification. An instance of #$ResourceRequest represents the content in the event of making a request.  Thus, this is the person who wants that content to be realized, rather than the person who actually expresses that content in a requesting event.")
(comment instrumentalCW "An assertion of the form (#$instrumentalCW ACTION CW) states that in the instance of #$PurposefulAction ACTION, the #$ConceptualWork CW was used by some agent in the #$doneBy or #$performedBy role in ACTION as an aid in performing the action. This is a very general role.  For instance, an instance of #$Map might be used to come up with a plan on how to drive to a particular location.  Alternatively, an instance of #$BugReport might be used to fix a particular software bug.")
(comment StatementOfWork "A sub-collection of #$NormativeSpecification.  An instance of #$StatementOfWork describes the deliverables that are required for the satisfaction of a #$Contract and a description of the work that is expected to be performed inthe production of those deliverables.")
(comment SecurityForce "A specialization of #$Force and #$PrivateSectorOrganization.
Each instance of this collection is a privately employed group that is
hired to protect the security of a business or group.")
(comment wholesaleCost "The default price paid to a manufacturer by a retailer. This is usually the max amount.")
(comment dateOfProductRelease "(dateOfProductRelease PRODUCT DATE) means that some subcollection of #$PartiallyTangibleProduct product was made available to consumers on DATE. This does not indicate when the first instance of PRODUCT was created, nor when it was shipped by the manufacturer. It indicates the earliest date on which a consumer could purchase the product at a retail outlet.")
(comment CalculatingTheAPROnALoan "A specialization of #$DeterminingTheValueOfASlot.  In an instance of #$CalculatingTheAPROnALoan, the #$annualPercentageRate of some loan is determined.")
(comment EpistemicallyDeterminingTheValueOfASlot "A specialization of #$Evaluating.  Instances are events in which an agent determines the value of ?X for some open formula FORMULA, where the argument-place in which ?X occurs is functional (see #$functionalInArgs) for the arg0 of FORMULA (see #$operatorFormulas), and the values of all the other arguments in FORMULA are given.  Notable specializations include #$MeasuringSomething and #$DoingAnArithmeticOperation.  Examples include an event in which one measure the height of an object OBJ, and so determines the value of ?X in (#$heightOfObject OBJ ?X).")
(comment determinationOfValueOfArgInReln "(#$determinationOfValueOfArgInReln EVENT N PRED) means that in EVENT, an instance of #$DeterminingTheValueOfASlot, the value of the Nth argument of a formula FORMULA of the form (PRED . ARGS) where all of the argument-places in FORMULA were bound but for the Nth.  For example, (#$determinationOfValueOfArgInReln CalculatingTheAPROnLoan001 2 #$annualPercentageRate) says that in this particular event of calculating the APR on Loan001, the value of ?X in (#$annualPercentageRate Loan001 ?X) is determined.")
(comment InterArgPredicate "The collection of #$ArgConstraintPredicates used to put (conditional or unconditional) constraints on polyadic relations in regard to two of their argument-places (or, in a few cases, to put a conditional constraint on relations in regard to two different features of one argument-place).  Each instance of #$InterArgPredicate specifies, with respect to a given #$Relation, either that one of its argument-places (the \"dependent\" one) has a certain feature, contingent upon one (usually a different one) of its argument-place's (the \"independent\" one's) having a certain (possibly different) feature (see #$InterArgConstraintPredicate), or that a particular relation must hold between two arguments of the relation (see #$InterArgRelnPredicate).")
(comment ProductVersionOfProgramFn "(#$ProductVersionOfProgramFn PROGRAM) denotes the collection of #$Products by which instantiations of particular #$ComputerProgram-CW are sold to consumers. The result of this function is distinct from the instances of #$ComputerProgramCopy which are #$programCopies of a particular program by virtue of being 'productized.' This often entails being packaged. A shrinkwrapped copy of #$MSWord is an instance of (#$ProductVersionOfProgramFn #$MSWord). A copy downloaded from a file sharing network is not.")
(comment requiresDiscSpace "(#$requiresMemory PROGRAM ROM) means that PROGRAM is an instance of #$ComputerProgram-CW and that PROGRAM requires ROM amount of disc space for installation and operation.")
(comment programUsesFileType "(#$programUsesFileType PROGRAM TYPE) means that PROGRAM can open and/or create files of TYPE.")
(comment validatedLexicalMtsForLanguage "This predicate relates a #$NaturalLanguage to the #$LexicalDataMicrotheory that describes part of Cyc's validated lexical knowledge about it.")
(comment validatedLexicalPSCForLanguage "This predicate relates a #$NaturalLanguage to the #$LexicalProblemSolvingContext that describes the full extent of Cyc's validated lexical knowledge about it.")
(comment comprehensiveLexicalPSCForLanguage "This predicate relates a #$NaturalLanguage to the #$LexicalProblemSolvingContext that describes the full extent of Cyc's lexical knowledge about it.")
(comment productVersionOfProgram "(#$productVersionOfProgram PROGRAM PRODUCT) means that PRODUCT is the collection of #$Products by which instantiations of particular #$ComputerProgram-CW PROGRAM are sold to consumers. PRODUCT is distinct from the instances of #$ComputerProgramCopy which are #$programCopies of PROGRAM by virtue of being 'productized.' This often entails being packaged. A shrinkwrapped copy of #$MSWord would be an instance of PRODUCT, given (#$productVersionOfProgram #$MSWord PRODUCT). A copy downloaded from a file sharing network is not.")
(comment PoppingOff "An #$AccomplishmentType and a specialization of #$Separation-Complete (q.v.).  This is the collection of events in which one or more of the #$physicalParts of a tangible object is very quickly detached from it.      Typically, the detached part is projected away from the object.  The detachment might result from forces that are internal or external to the object.

Examples include a button popping off a shirt, a lid popping off a pressurized container, and a hubcap being popped off a wheel with a crowbar.

For other types of \"popping\" events, see #$PoppingOpenAContainer and #$EjectingAnObject.")
(comment EjectingAnObject "A specialization of #$EmittingAnObject (q.v.).  This is the collection of all events in which a tangible object is ejected from some object in which it was contained (see #$in-ContGeneric).  The ejected object might or might not be thrown completely clear of the container.

Examples of #$EjectingAnObject include ejecting a cassette tape from a tape deck, a pilot ejecting from an aircraft, and a piece of toast popping up out of a toaster.

An important specialization of this collection is #$ProjectileLaunching.")
(comment Rhea "A specialization of #$FlightlessBird.  There are two species of #$Rhea, both native to South America.")
(comment AmericanRhea "A specialization of #$Rhea.  Each instance of #$AmericanRhea is a large flightless bird native to South America.  The American Rhea is the larger of the two species of Rhea.")
(disjointWith AmericanRhea DarwinsRhea)
(comment DarwinsRhea "A specialization of #$Rhea.  Each instance of #$DarwinsRhea is a large flightless bird native to South America.  Darwin's Rhea is the smaller of the two species of Rhea.")
(comment Kiwi-Bird "A specialization of #$FlightlessBird.  There are several species of #$Kiwi-Bird, all native to New Zealand.")
(comment ButterKnife "A kind of knife used mainly for cutting pieces of #$Butter from a stick, and for spreading the butter onto bread or other edibles. ")
(comment likelihood-PlayedRoleInEvent "(#$likelihood-PlayedRoleInEvent AGT EVT ROLE PROB) holds just in case the probability that AGT played ROLE in EVT is PROB.")
(comment closingCostItems "(#$closingCostItems LOAN VALUE) identifies VALUE as one of the closing costs incurred for the instance of #$LoanAgreement, LOAN.  Note that this predicate is #$notAssertible.  Individual closing costs should be itemized using one of the specialization-predicates of #$closingCostItems, such as #$loanOriginationFee.  To represent the closing cost (the sum total of the closing cost items), use #$closingCost.")
(comment MaintenanceFitting "A specialization of #$MaintainingSomething. Each instance of
this collection is an event in which an agent ensures the continuous
running of machinery and equipment, or organizes routine maintenance
procedures and any necessary repairs. The machinery and technology
worked on could be mechanical, electrical, electronic, pneumatic or
computerized.")
(comment VocationalStudies "An instance of #$FieldOfStudy.  #$VocationalStudies covers a
broad range of areas of study for vocational degees: #$Welding, (#$VocationalDegreeForFn #$AircraftMechanic), and so forth.")
(comment MotorVehicleMechanics "A specialization of #$TakingCareOfSomething. Instances of
this collection are events in which someone, who is specially
trained, performs maintenance, repair, or rebuilding of an instance of
#$RoadVehicle that the average motor vehicle user would not perform
themselves.  Thus, rebuilding an instance of #$Carburetor would be an
instance of this collection, whereas an instance of
#$FillingUpAtAServiceStation would not.  Borderline examples might be
changing the oil in one's car.")
(comment MetalMachining "A specialization of #$Manufacturing.  Instances of this collection
involve working with machine shop tools in order to produce machined
metal parts to specifications.")
(comment SheetAndMetalFabrication "A specialization of #$Manufacturing.  Each instance of this collection is
an event in which metal is fashioned into sheets or fabricated in some
other manner.")
(comment SkillLevelDesignatingPredicate "A specialization of #$BinaryPredicate.  Each instance of
this collection relates an instance of #$Agent-Generic to an instance
of #$SkilledActivityType through the level of skill the agent
possesses wrt that skill.  Notable instances of this collection
include #$expertAtSkill and #$noviceAtSkill.")
(comment PresentingIDDocument "A specialization of #$DisplayingSomething. In each instance
of #$PresentingIDDocument, a person displays an #$IDDocument
(purportedly belonging to her) to a second person or automated reader
in order to satisfy a security requirement.  Common examples include a
traveller presenting a #$Passport to a #$BorderSecurityAgent, and a
shopper showing a #$DriversLicense-Document to a #$RetailSalesClerk.")
(comment reverseTransferOfPossession "<b>(#$reverseTransferOfPossession TRANSFER2 TRANSFER1)</b> means that the same object (see #$objectOfPossessionTransfer) that was transferred during <b>TRANSFER1</b> is transferred back during <b>TRANSFER2</b>.  The roles of #$fromPossessor and #$toPossessor are reversed in TRANSFER2 when compared with TRANSFER1.  Thus, TRANSFER2 has to be the corresponding returning event for TRANSFER1.  In some cases where TRANSFER1 is governed by an #$Agreement (that generates an #$Obligation) there is a requirement that (sometimes within a stipulated period of time) TRANSFER2 should take place.  Thus, for example, (#$reverseTransferOfPossession RETURN RENT) specifies that the transfer of possession of the object during RENT is reversed by RETURN.  Other examples include returning something borrowed, returning something purchased, returning something given as a gift, etc.<br>
The following is a negative example: (#$reverseTransferOfPossession BORROW1 RETURN2) where BORROW1 and BORROW2 are the events of borrowing ITEM1 such that BORROW2 occurs after BORROW1, and RETURN1 and RETURN2 are their respective returning events.")
(comment situationMightBeSubSituationType-ViaCoSubSituationType "An instance of #$SituationProfilingPredicate. <code>(#$situationMightBeSubSituationType-ViaCoSubSituationType SIT SITTYPE SUBSITTYPE COSUBSIT COSUBSITTYPE)</code> means that there is evidence to the effect that <code>SIT</code> is an instance of <code>SUBSITTYPE</code>, which is a sub-situation type (see #$candidateProperSubSituationTypes) of <code>SITTYPE</code>.  The evidence is based on knowledge that some instance <code>COSUBSIT</code> of <code>COSUBSITTYPE</code> (which is a different sub-situation type of <code>SUBSITTYPE</code>) occurs in appropriate spatiotemporal proximity to <code>SUBSITTYPE</code>.")
(comment maxLibraryLoanItems "(#$maxLibraryLoanItems LIBRARY MAX) means that at a time, a member of the LIBRARY cannot have more than MAX number of items borrowed/checked out (see #$BorrowingLibraryItem) from the LIBRARY.  For example, 
(#$maxLibraryLoanItems LIBRARY ((#$UnitOfCountFn #$InformationBearingObject) 
10)) means that a member of LIBRARY can have at the most 10 items borrowed/checked out from LIBRARY.")
(comment wnSenseDefinition "(#$wnSenseDefinition WORD POS NUM DEFINITION) is a
#$senseAnnotation that gives the natural language definition for the
specified word sense from WordNet.")
(comment foreignWRTCountry "")
(comment renewLibraryLoanItem "<b>(#$renewLibraryLoanItem BORROW RENEW)</b> means that <b>RENEW</b> is the corresponding renewal event for <b>BORROW</b>.")
(comment Mrs "An instance of #$CourtesyTitle attached to the name of a
married woman.")
(comment maximumTimeSpanBetweenSubSituationTypes "<code>(#$maximumTimeSpanBetweenSubSituationTypes SIT-TYPE SUB-SIT-TYPE1 SUB-SIT-TYPE2 MAX)</code> means that if situations <code>SUB-SIT1</code> and <code>SUB-SIT2</code> are instances of <code>SUB-SIT-TYPE1</code> and <code>SUB-SIT-TYPE2</code>, respectively, and both <code>SUB-SIT1</code> and <code>SUB-SIT2</code> are proper subsituations of <code>SIT</code>, an instance of <code>SIT-TYPE</code>, then the time interval between <code>SUB-SIT1</code> and <code>SUB-SIT2</code>will not last more than than <code>MAX</code>.")
(comment FacetBasisPredicate "The collection of #$FacetingCollectionTypePredicates that express the idea that a #$FacetingCollectionType is \"based on\" a certain #$Predicate.")
(disjointWith (SubcollectionOfWithRelationToFn MeasurableQuantity scalarDimensionalRank 1) (SubcollectionOfWithRelationToFn MeasurableQuantity scalarDimensionalRank 2))
(disjointWith (SubcollectionOfWithRelationToFn MeasurableQuantity scalarDimensionalRank 2) (SubcollectionOfWithRelationToFn MeasurableQuantity scalarDimensionalRank 3))
(disjointWith (SubcollectionOfWithRelationToFn MeasurableQuantity scalarDimensionalRank 1) (SubcollectionOfWithRelationToFn MeasurableQuantity scalarDimensionalRank 3))
(comment RadiologicalAttack-Terrorist "A specialization of both #$WeaponOfMassDestructionAttack and #$PurposefulAction-ResourceDrivenWithTransfer.  Each instance involves a #$GainingControl of a #$RadiologicalWeapon a #$DirectedTranslation and a deployment of the weapon.")
(comment PoppingOpenAContainer "A specialization of #$OpeningAContainerArtifact.  Each instance of #$PoppingOpenAContainer is an event in which an agent opens a #$ContainerArtifact very quickly, almost instantaneously.  Example include opening the \"pop-top\" on a can of soda, snapping the cap off a bottle of beer, and ripping the lid off a cannister of crisp potato product..  The act of popping open a container is often accompanied by a \"popping\" sound, but that is not essential.
<p>
For other constants related to \"popping\", see #$PoppingOff and #$EjectingAnObject.")
(comment CitizenshipDesignatingPredicate "A specialization of #$CoexistingObjectsPredicate.  Each
instance of this collection is a predicate that relates an instance of
#$Person to an instance of #$GeopoliticalEntity, which recognizes the
person as a citizen.  Notable instances of this collection include
#$citizens-Naturalized and #$citizens-Birth.")
(comment InstanceFn "(#$InstanceFn STRING) denotes some member of #$Thing.")
(comment DistributionOfARadiologicalAgent "The collection of all purposeful #$DistributionEvents in which an #$IntelligentAgent deploys #$RadioactiveStuff via dispersal into air.  Under ordinary circumstances we can reasonably infer that this will be done as part of a #$WeaponOfMassDestructionAttack on some group of opponents, either civilian or military.")
(disjointWith DeployingAChemicalOrBiologicalAgent DistributionOfARadiologicalAgent)
(comment SecretIntelligenceService-British "The British intelligence agency Officially known as the \"Secret Intelligence Service\" (\"SIS\", a.k.a. \"MI6\"), whose role isto obtain intelligence on the activities of Britain's enemies and potential enemies overseas.  See also #$SecurityService-British.")
(comment SecurityService-British "MI5 is the British intelligence agency whose role is to obtain intelligence within the UK's borders.  See also #$SecretIntelligenceService-British.")
(comment SpecialBranch-British "A division of the police force in the UK that coordinates closely with #$SecurityService-British (a.k.a. \"MI5\").")
(comment overdueFine-Rate "<b>(#$overdueFine-Rate LIBRARY RATE)</b> means that a member of the LIBRARY pays an overdue fine of an amount of money per unit time as specified by RATE.  This fine is for a single overdue library item that is borrowed (see #$BorrowingLibraryItem) by that member.<br> e.g. (#$overdueFine-Rate AustinPublicLibrary (DollarsPerDay 1)) means that a member of the  Austin Public Library pays a USD 1 per day for each overdue library-item.")
(disjointWith BabyPlayYard LargePortableCargoContainer)
(disjointWith ClosetOrganizer LargePortableCargoContainer)
(disjointWith Coffin LargePortableCargoContainer)
(comment LargePortableCargoContainer "A specialization of #$StorageConstruct.  Each instance of #$LargePortableCargoContainer is a large (usually about 40' x 8' x 8') metal container used for shipping large quantities of goods across land (e.g., on a large truck) or overseas (e.g., on a cargo ship).")
(disjointWith Basket LargePortableCargoContainer)
(comment addressOfLocation "The predicate #$addressOfLocation relates an instance of #$PartiallyTangible to an instance of #$Address-LocationDesignator. (#$addressText LOC ADDRESS) means that the #$PartiallyTangible LOC has the address ADDRESS.")
(disjointWith PrivateMortgageInsurance GovernmentGuaranteedMortgageInsurance)
(comment ChiefOperatingOfficer "The collection of instances of #$Person who bear the relation of #$companyHasCOO to some instance of #$CommercialOrganization.  A COO of a company is responsible for managing the day-to-day operations of that company.")
(comment companyHasCOO "(#$companyHasCOO COMPANY COO) identifies COO as the Chief Operating Officer of COMPANY, a #$CommercialOrganization.  See also #$ChiefOperatingOfficer and #$positionOfPersonInOrganization.")
(comment companyHasCFO "(#$companyHasCFO COMPANY CFO) identifies CFO as the Chief Financial Officer of COMPANY, a #$CommercialOrganization.  See also #$ChiefFinancialOfficer and #$positionOfPersonInOrganization.")
(comment strategyOnOutputYieldsCandidateAnswerChoice "(#$strategyOnOutputYieldsCandidateAnswerChoice STRATEGY
QUESTION ANSWER) means that the instance of #$ProblemSolvingStrategy
STRATEGY has determined that ANSWER is a likely answer to QUESTION.")
(comment candidateKSRangeForAntecedent "(#$candidateKSRangeForAntecedent TEMPLATE MT-RANGE) means that the set of microtheories MT-RANGE is the set of all reasoning contexts where one might reasonably ask the antecedent of the rule that is given as the #$InferenceSentenceParameter of the #$CycLRuleSpecification that is the #$querySpecificationForFormulaTemplate of TEMPLATE, via #$softwareParameterValueInSpecification.")
(comment FormulaRuleTemplate "The collection of every #$FormulaTemplate whose #$querySpecificationForFormulaTemplate is an instance of #$CycLRuleSpecification.")
(comment RuleConsequentParameter "A #$RuleParameterType used to specify the range of contexts to be used in propagating instantiations of the consequent of the associated rule of a #$CycLRuleSpecification.  See #$ksRangeInSpecification.")
(comment RuleAntecedentParameter "A #$RuleParameterType used to specify the range of contexts to be used in asking the antecedent of the associated rule of a #$CycLRuleSpecification.  See #$ksRangeInSpecification.")
(comment RuleParameterType "A spec of #$InferenceParameter whose two instances, #$RuleAntecedentParameter and #$RuleConsequentParameter, are used in setting the #$ksRangeInSpecification of a #$CycLRuleSpecification.")
(comment candidateKSRangeForConsequent "(#$candidateKSRangeForAntecedent TEMPLATE MT-RANGE) means that the set of microtheories MT-RANGE is the set of all reasoning contexts where one might reasonably assert the instantiated consequent of the rule that is given as the #$InferenceSentenceParameter of the #$CycLRuleSpecification that is the #$querySpecificationForFormulaTemplate of TEMPLATE, via #$softwareParameterValueInSpecification.")
(comment ksRangeInSpecification "Predicate used for specifying the contexts in which to ask the antecedent and propagate the instantiated consequent of a rule stored as the #$InferenceSentenceParameter of a #$CycLRuleSpecification.  (#$ksRangeInSpecification #$RuleAntecedentParameter MT-SET SPEC) means that the antecedent of the rule given (via #$softwareParameterValueInSpecification) as the #$InferenceSentenceParameter of SPEC should be asked in the microtheoretic union of the elements of MT-SET and its upward closure under #$genlMt.  (#$ksRangeInSpecification #$RuleConsequentParameter MT-SET SPEC) means that the set of assertions resulting from instantitating the consequent of the rule given (via #$softwareParameterValueInSpecification) as the #$InferenceSentenceParameter of SPEC should all be asserted in each of the microtheories that is an element of MT-SET.")
(comment InstanceOfTypeWithIDFromOrganizationFn "An #$IndividualDenotingFunction, an expression of the form (#$InstanceOfTypeWithIDFromOrganizationFn TYPE ID-STRING ORG) refers to the instance of TYPE, some sub-collection of #$SomethingExisting that is identified by the #$SubLString ID-STRING based on its origination from the #$Organization ORG.  For instance, this could refer to an instance of #$BankAccount, #$Passport, or any other thing where we can pin down individuals based on some identification in relation to a particular organization.")
(comment isIndividualOfTypeIdentifiedWithIDStringByOrganization "The corresponding predicate of the function #$InstanceOfTypeWithIDFromOrganizationFn.")
(comment StreetNumberFn "An expression of the form (#$StreetNumberFn NUMBER STREET) takes an #$Integer NUMBER and an instance of #$Street-Generic and returns the #$PhysicalContactLocation which is found at the address represented by NUMBER on STREET. For instance, (#$StreetNumberFn 100 (#$StreetNamedFn 'Boylston St.' CityOfBostonMA)) would represent 100 Boylston St. Boston, MA.   This is an instance of #$PartialFunction since it is possible to form expressions using this function that do not represent actual instances of #$PhysicalContactLocation.")
(comment locationAtNumberOnStreet "This is the corresponding predicate of the function #$StreetNumberFn.  An assertion of the form (#$locationAtNumberOnStreet LOCATION NUMBER STREET) means that the #$PhysicalContactLocation LOCATION is the one designated by the #$Integer NUMBER on the #$Street-Generic STREET.")
(comment streetWithNameInRegion "This is the corresponding predicate of the function #$StreetNamedFn.  An assertion of the form (#$streetWithNameInRegion STREET NAME CITY) means that the #$Street-Generic STREET is the one picked out by the #$SubLString NAME within the #$City CITY.")
(comment StreetNamedFn "An expression of the form (#$StreetNamedFn NAME PLACE) is used to pick out the instance of #$Street-Generic found within the #$Geographical PLACE that is designated by the #$SubLString NAME.  For instance, (#$StreetNamedFn 'Boylston St.' CityOfBostonMA) would pick out Boylston Street in Boston, MA.  This is a #$PartialFunction since it is possible to form expressions using it which do not pick out an existing street.")
(comment amountOfMoneyTransferred "An assertion of the form (#$amountOfMoneyTransferred TRANS AMOUNT) states that in the #$MoneyTransaction TRANS  AMOUNT is the #$MonetaryValue which was transferred.")
(comment obligationParticipants "An assertion of the form (#$obligationParticipants OBLIGATION AGENT) means that the #$Agent-Generic AGENT is somehow involved in the #$Obligation OBLIGATION.  This is a more general relation than the predicate #$obligatedAgents.  It is intended to allow the introduction of parties to an #$Obligation where they are likely to be effected by the #$Obligation.  For instance, a mother may make a #$TravelReservation for her children.  Those children would bear the relation #$obligationParticipants from the #$TravelReservation.")
(comment reservedTravelEvent "An assertion of the form (#$reservedTravelEvent RES TRANS) means that the #$TravelReservation RES reserves a place for at least on individual on the device that will be the #$transporter for the #$TransportationEvent TRANS.")
(comment ExpiredAgreement "A sub-collection of #$InvalidatedAgreement.  Instances of #$ExpiredAgreement are those instances of #$InvalidatedAgreement where there is an #$endingDate for an #$Agreement and, in the relevant context, #$Now refers to a time period that comes after that ending date.")
(comment InvalidatedAgreement "A sub-collection of #$Agreement.  Instances of #$InvalidateAgreement represent those instances of #$Agreement where some of the conditions on that instance have been violated such that the permissions extended to or reponsibilities imposed on some or all of the parties involved in the #$Agreement have been nullified.")
(comment unitWithLabelAtAddress "This is the corresponding predicate of the function #$UnitAtAddressFn.  An assertion of the form (#$unitWithLabelAtAddress SUB-LOCATION NAME LOCATION) means that the #$PhysicalContactLocation SUB-LOCATION is the part of the #$PhysicalContactLocation LOCATION that is picked out with the #$SubLString NAME.")
(comment UnitAtAddressFn "An expression of the form (#$UnitAtAddressFn  UNIT-STRING LOCATION) takes an instance of #$SubLString UNIT-STRING and an instance of #$PhysicalContactLocation LOCATION and returns another instance of #$PhysicalContactLocation; however, this instance represents a smaller unit of the original instance.  For example, (#$UnitAtAddressFn  '10C' (#$StreetNumberFn 100 (#$StreetNamedFn 'Boylston St.' CityOfBostonMA)) would represent the unit \"10C\" at 100 Boylston St. Boston, MA.  This is an instance of #$PartialFunction since it is possible to form expressions using this function that do not represent actual instances of #$PhysicalContactLocation.")
(comment Visa-Permit-Student "The sub-collection of #$Visa-Permit related to granting to individuals who are not residents of some country permission to study within that country.")
(comment MissingPerson "A #$FirstOrderCollection.  An instance of #$MissingPerson is a #$Person whom some other #$Person regards as  missing and who have reported this fact to some legal authority that will most likely use its resources to try to find the instance of #$MissingPerson  be looking for.")
(comment CheckingBackGround-FindingSuspiciousActivity "The sub-collection of #$CheckingSomeonesBackGround where the performer becomes suspicious of the #$subjectOfInvestigation because of evidence uncovered during the process.")
(comment CheckingSomeonesBackGround "A #$FirstOrderCollection and a sub-collection of #$Investigation.  Instances of #$CheckingSomeonesBackGround involve investigating a person's history as part of the approval process for granting some kind of security clearance.")
(comment LoanPayment "The collection of individual loan payments.  Each instance of #$LoanPayment is an instance of #$Paying in which monies are transferred to the creditor and put towards the loan balance.")
(comment RepayingAMortgage "The process of repaying a mortgage, by making individual mortgage payments (c.f., #$MortgagePayment).")
(comment RepayingAMortgage "The process of repaying the debt owed on a credit card, by making individual payments (c.f., #$CreditCardPayment).")
(comment decreasesSlotFor "(#$decreasesSlotFor EVT OBJ SLOT) says that as a result of OBJ's participation in EVT, the SLOT for OBJ is decreased.  For example, (#$decreasesSlotFor ILoseWeight Me #$massOfObject) says that in the particular weight-loss event in question, my mass is decreased.  Note that where EVT is an instance of #$IntrinsicStateChangeEvent, (#$decreasesSlotFor EVT OBJ SLOT) is equivalent to (#$decreasesSlot EVT SLOT).")
(comment fromAccount "'(#$fromAccount TRANS ACCT)' means that the money transferred in TRANS was withdrawn from instance of #$Account ACCT.")
(comment IntegerSequenceGenerator "A collection of data structures that can generate #$Integers
in a sequence. Most implementations provide functions which permit one
to set the current value, get the next (or N next) value(s), and query
for the current value in the sequence.")
(comment PaymentSchedule "The collection of instances of #$Schedule that dictate when an individual is to make payments (instances of #$Paying).  This is a broadly defined collection: Examples include schedules that are part of a financial agreement between two parties, such as amortization schedules (c.f.,  #$AmortizationSchedule) that dictate when payments towards some outstanding debt are to take place; as well as more informal schedules that a person might create to determine when bills are to be paid.")
(comment eventTypeOccurrencesScheduled "(#$eventTypeOccurrencesScheduled SCHEDULE TYPE) means that the instance of #$Schedule SCHEDULE dictates when events of a certain type are to occur.  For example, (#$eventTypeOccurrencesScheduled AmortizationSchedule001 #$LoanPayment) says that the amortization schedule in question is a schedule that dictates when loan payments are to be made.")
(comment scheduleTypeForProcess "An instance of #$RuleMacroPredicate.  (#$scheduleTypeForProcess SCHEDULE-TYPE PROCESS) is shorthand for
  (#$relationAllInstance #$scheduleForProcess SCHEDULE-TYPE PROCESS), which means that every instance of #$Schedule SCHEDULE of type SCHEDULE-TYPE is one that is intended to guide the execution of the process PROCESS.")
(comment scheduleForProcess "(#$scheduleForProcess SCHEDULE PROCESS) says that the instance of #$Schedule SCHEDULE is a plan for executing the process PROCESS, in the sense that there is a distinguising subevent-type for PROCESS, say TYPE, such that SCHEDULE dictates when instances of that TYPE are to take place.  See also #$eventTypeOccurrencesScheduled.")
(comment typeSchedulesOccurrencesOfEventsOfType "An instance of #$RuleMacroPredicate. (#$typeSchedulesOccurrencesOfEventsOfType SCHEDULE-TYPE TYPE) means that every schedule SCHEDULE of type SCHEDULE-TYPE is such that it dictates when events of type TYPE performed as part of the following of SCHEDULE are to occur.  More formally, (#$typeSchedulesOccurrencesOfEventsOfType SCHEDULE-TYPE TYPE) means (#$relationAllInstance #$eventTypeOccurrencesScheduled SCHEDULE-TYPE TYPE).")
(comment TheNextSequenceValueFn "#$TheNextSequenceValueFn is an unary, unreifiable function
which returns an #$IndexicalConcept. This term is used to denote the
'next' value for an #$IntegerSequenceGenerator. It is intended to be
translatable into a DBMS specific function call that increments the
sequence and returns the resulting value. Cyc obtains the referent
value of the indexical at the time the function is evaluated on the
DBMS. For instance, using the #$PostgreSQL syntax,
(#$TheNextSequenceValueFn (#$IntegerSequenceGeneratorFn
\"my-sequence\")) denotes the result of evaluating the SQL query
'SELECT nextval(\"my-sequence\")'. Compare this function with
#$TheCurrentSequenceValueFn, which does not increment the sequence
before returning its current value.)")
(comment integerSequenceGeneratorName "(#$integerSequenceGeneratorName ISG NAME) means that NAME is
the name string for the #$IntegerSequenceGenerator ISG. Typically,
NAME is the string used in a running DBMS process to refer to a
specific integer sequence generator implemented by the DBMS.")
(comment integerSequenceGeneratorIncrementsField "(#$integerSequenceGeneratorIncrementsField ISG FIELD) means
that when updating, or adding new records to the database table
containing the #$PhysicalField FIELD, Cyc should use the
#$IntegerSequenceGenerator ISG to obtain the value for FIELD.")
(comment IntegerSequenceGeneratorFn "#$IntegerSequenceGeneratorFn is an unary, reifiable function
that is used to denote an #$IntegerSequenceGenerator by its name in
the DBMS which implements the generator.")
(comment TheCurrentSequenceValueFn "#$TheCurrentSequenceValueFn is an unary, unreifiable
function which returns an #$IndexicalConcept. This term is used to
denote the 'current' value for an #$IntegerSequenceGenerator. It is
intended to be translatable into a DBMS specific function call that
returns the current value of the seqence. Cyc obtains the referent
value of the indexical at the time the function is evaluated on the
DBMS. For instance, using the #$PostgreSQL syntax,
(#$TheNextSequenceValueFn (#$IntegerSequenceGeneratorFn
\"my-sequence\")) denotes the result of evaluating the SQL query
'SELECT currval(\"my-sequence\")'. Compare this function with
#$TheNextSequenceValueFn, which first increments the sequence before
returning its current value.)")
(comment assertionDirectionForProjectBuilds "(#$assertionDirectionForProjectBuilds ASSERTION ASSERTION-DIRECTION PROJECT) means that the project PROJECT requires its builds (see #$SoftwareBuild) to be such that the assertion (c.f., #$CycLAssertion) have an assertion-direction (c.f., #$CycLAssertionDirection) of ASSERTION-DIRECTION.")
(comment adjustmentDates "(#$adjustmentDates LOAN DATE) means that DATE is one of the dates on which the interest rate (c.f., #$interestRate) for the instance LOAN of #$AdjustableRateLoan is re-calculated.")
(comment paymentScheduleForAgreement "(#$paymentScheduleForAgreement SCHEDULE AGREEMENT) says that SCHEDULE is a schedule for making payments for monies owed as part of the agreement AGREEMENT.")
(comment AdheringToASchedule "A specialization of #$AdheringToANormativeSpecification.  Instances are actions that follow a schedule (see #$Schedule).")
(comment initialInterestRatePeriod "(#$initialInterestRatePeriod LOAN PERIOD) identifies PERIOD as the period (c.f., #$TimeInterval) during which the initial interest rate holds.  See also #$initialInterestRate and #$interestRate.")
(comment initialAPR "The predicate used to state the annual percentage rate (c.f., #$annualPercentageRate) on a loan during the beginning of its term. See also #$initialInterestRate and #$initialInterestRatePeriod.")
(comment eventTypeUsesStuffType "This predicate is used to relate two collections. (#$eventTypeUsesStuffType EVENT-TYPE STUFF-TYPE) means that, by default, stuff of type STUFF-TYPE is a #$stuffUsed in any #$Event of type EVENT-TYPE.")
(comment queryStringForUserInSession "(#$queryStringForUserInSession STRING USER SESSION) says that in the course of the interactive computer session SESSION, USER, the user in session, posed a question to the system, the string for which has been recorded as STRING.")
(disjointWith TakingANightsSleep TakingANap)
(comment AbductionConstraintConstant "The collection of all #$CycLTerms that are used to specify constraints on which literals are abducible.  Important instances include #$NonAbduciblePredicate.")
(comment nonAbducibleSentence "An instance of #$AbductionConstraintConstant (q.v.). <code>(#$nonAbducibleSentence SENT)</code> means that <code>SENT</code> is provable by the Cyc inference engine without using abduction. 
<p>
#$nonAbducibleSentence is primarily used as a means of indicating that certain literals in a rule should never be abduced.  Generally, it is used in the pragmatic requirements of rules as a wrapper around literals that already occur in the antecedents of these rules.  
<p>
For example, consider the following rule:
<pre>
  (#$implies
    (#$and
      (#$isa ?METEOR #$Meteor)
      (#$primaryObjectMoving ?METEOR ?METEOROID))
    (#$inputsDestroyed ?METEOR ?METEOROID))
</pre>
In this rule, if one wanted the  '(#$primaryObjectMoving ?METEOR ?METEOROID)' literal to always be proved only through non-abductive means, one could add this pragmatic requirement as a meta-assertion:
<pre>
  (#$pragmaticRequirement
    (#$nonAbducibleSentence (#$primaryObjectMoving ?METEOR ?METEOROID))
  (#$implies
    (#$and
      (#$isa ?METEOR #$Meteor)
      (#$primaryObjectMoving ?METEOR ?METEOROID))
    (#$inputsDestroyed ?METEOR ?METEOROID)))
</pre>
In this case, if the inference engine were trying to use this rule to prove (#$inputsDestroyed Event001 Object001) the inference engine would be free to abduce (#$isa Event001 #$Meteor) (assuming #$Meteor is not an instance of #$NonAbducibleCollection in the context of the proof), but the inference engine could not abduce (#$primaryObjectMoving Event001 Object001) -- that literal would have to be proven by other means, if at all.")
(comment conveyorTypeOfConveyanceType "The corresponding predicate of #$ConveyViaFn.  <code>(#$conveyorTypeOfConveyanceType  EVENT-TYPE CONV-TYPE)</code> means that in events that are instances of <code>EVENT-TYPE</code>, instances of <code>TRANS-TYPE</code> are the types of conveyors used.")
(disjointWith SecuredLoan UnsecuredLoan)
(disjointWith LatePayment ScheduledLoanPayment)
(comment ScheduledLoanPayment "The collection of instances of #$Paying that take place in accordance with the relevant instance of #$RepaymentPlan.")
(comment TransportationTypeByTransporterType "Instances of #$TransportationTypeByTransporterType are collections of transporation events (#$TransportationEvent), each of which group together event instances in which which share an certain vehicle type is the transporter used.")
(disjointWith InterestOnlyLoan AmortizedLoan)
(comment GraduatedPaymentPlan "A specialization of #$RepaymentPlan.  Instances are payment schedules that call for a gradual increase in the size of payments.")
(comment FollowingScheduleTypeFn "(#$FollowingScheduleTypeFn SCHEDULE-TYPE) denotes the collection of all instances of #$AdheringToASchedule in which an instance of #$Schedule of type SCHEDULE-TYPE is followed.")
(comment BiWeekly "Once every two weeks.")
(comment repayingLoanOfType "(#$repayingLoanOfType REPAYING LOAN-TYPE) identifies REPAYING as the collection of instance of #$LoanRepaying where the loan (c.f., #$LoanAgreement) repaid is an instance of LOAN-TYPE.  #$repayingLoanOfType is the #$functionCorrespondingPredicate for #$RepayingLoanOfTypeFn.")
(comment RepayingLoanOfTypeFn "(#$RepayingLoanOfTypeFn LOAN-TYPE) dentotes the collection of instances of #$LoanRepaying that are repayings of a loan (c.f., #$LoanAgreement) of type LOAN-TYPE.  See also #$repayingLoanOfType.")
(comment RepaymentPlanTypeByPaymentFrequency "An instance of #$FacetingCollectionType that facets the collection #$RepaymentPlan.  Every instance #$RepaymentPlanTypeByPaymentFrequency is a collection of plans that share a common payment frequency (see #$agreementDictatesPaymentFrequency).  For example, #$MonthlyRepaymentPlan is the collection of repayment plans that call for a payment every month.")
(comment BiweeklyRepaymentPlan "An instance of #$RepaymentPlanTypeByPaymentFrequency.  Each instance of this collection is a repayment plan (c.f., #$RepaymentPlan) that calls for payments to be made on a biweekly basis (c.f., #$Biweekly).  See also #$agreementDictatesPaymentFrequency.")
(comment MonthlyRepaymentPlan "An instance of #$RepaymentPlanTypeByPaymentFrequency.  Each instance of this collection is a repayment plan (c.f., #$RepaymentPlan) that calls for payments to be made on a monthly basis (c.f., #$Monthly).  See also #$agreementDictatesPaymentFrequency.")
(comment agreementDictatesPaymentFrequency "(#$agreementDictatesPaymentFrequency AGREEMENT FREQUENCY) means that the instance AGREEMENT of
#$EconomicAgreement contains a stipulation that payments due as part of AGREEMENT are to made with the frequency FREQUENCY.  Typically, AGREEMENT will be an instance of #$RepaymentPlan that is a sub-obligation of some instance of #$LoanAgreement.")
(comment controlOfType "<code>(#$controlOfType CONTROL-TYPE OBJ-TYPE)</code> means that the specialization of #$ControllingSomething <code>CONTROL-TYPE</code> is the type of event in which there is control over instances of the specialization of #$PartiallyTangible <code>OBJ-TYPE</code>.")
(comment situationTopic "#$situationTopic is a very general binary relation between an instance of #$MentalSituation and an instance of #$Thing.  An assertion of the form (#$situationTopic SIT THING) means that there is some #$IntelligentAgent that is a #$situationConstituents of the #$MentalSituation SIT, that agent participates in SIT, and SIT 'refers to' or 'is about' #$Thing.  This predicate operates at a very coarse granularity for describing #$MentalSituations and so, is inferentially weak.  Its main function is to allow for the introduction of things into a #$MentalSituation even if they are quite peripheral.  Moreover, it does not entail that every #$IntelligentAgent that is a #$situationConstituents in SIT needs have a mental state involving THING.  For instance, in a #$Talking event, someone might miss the part of the conversation where #$Spiderman was introduced.  #$situationTopic could still be used to relate that event to #$Spiderman, even though there is someone involved who has no mental states about that #$Spiderman during that #$Talking event.")
(comment topicRole "#$topicRole represents a very general relation between an instance of #$MentalSituation and an instance of #$SomethingExisting.  An assertion of the form (#$topicRole SIT OBJECT) means that OBJECT is an actor in SIT to the extent that a #$MentalState of some #$IntelligentAgent participating in SIT is about OBJECT and that mental state causally influences that agent's behavior during SIT.    The generality of this relation makes it inferentially weak.  Therefore, its more specialized forms are better suited for actual representations.")
(comment evidenceOfPastCrime "#$evidenceOfPastCrime is a more specialized form of the predicate #$evidence.  It relates an instance of #$CriminalInvesigation to an instance of #$SomethingExisting.  During the course of that particular instance of #$CriminalInvestigation, some agent in the role of #$performedBy is motivated to believe that the #$SomethingExisting is related to some #$ActCommonlyConsideredCriminal that has already occurred.  For instance, a bloody knife discovered during a #$CriminalInvestigation would play the role of #$evidenceOfPastCrime if the relevant performers of the investigation believe the knife to have been used as a weapon.  This predicate provides a coarse representation and buries complex causal and psychological relations. Contrast with #$evidenceOfCriminalIntent.")
(comment evidenceOfCriminalIntent "#$evidenceOfCriminalIntent is a more specialized form of the predicate #$evidence.   It relates an instance of #$CriminalInvesigation to an instance of #$SomethingExisting.  During the course of that particular instance of #$CrimeDetectionActivity, some agent in the role of #$performedBy is motivated to believe that the #$SomethingExisting could be used to perform some #$ActCommonlyConsideredCriminal in the future.  For instance, a patrolling police officer notices a man with a #$Mask and #$TireIron approaching a liquor store.  The specific #$Mask and #$TireIron would bear the relation #$evidenceOfCriminalIntent to the event in which the officer recognizes that a crime might be about to occur.  This predicate operates at a high granularity and buries complex causal and psychological relations. Contrast with #$evidenceOfPastCrime.")
(comment implicatedAgent "#$implicatedAgent is a more specialized form of the predicate #$nonFocalSubjectOfInvestigation which is limited to instances of #$IntelligentAgent. This predicate allows us to introduce an #$IntelligentAgent into the representation of an instance of #$LawEnforcementActivity, without entailing that the agent is central to that event.  Contrast with #$subjectOfInvestigation.")
(comment Bullet-50Caliber "The sub-collection of all #$BulletAssembly whose instances all have a caliber of (#$Caliber .50).")
(comment fromAgent "An assertion of the form (#$fromAgent TRANS AGENT) means that the #$transferredThing in the #$GeneralizedTransfer TRANS orginates with the #$Agent-Generic AGENT.  This is a very general relation and does not assume that AGENT has any rights over the #$transferredThing.  See the more specialized predicate #$fromPossessor for cases where the #$SocialBeing has user rights over the #$transferredThing.")
(comment toAgent "An assertion of the form (#$toAgent TRANS AGENT) means that the #$transferredThing in the #$GeneralizedTransfer TRANS ends up with the #$Agent-Generic AGENT. This is a very general relation and does not assume that AGENT has any rights over the #$transferredThing. See the more specialized predicate #$toPossessor for cases where the #$SocialBeing ends up with user rights over the #$transferredThing.")
(comment RepaymentPlanWithBalloon "A specialization of #$RepaymentPlan.  Instances are repayment plans that call for a \"balloon\" payment, typically due at the end of the term of the relevant ecomonic agreement to which the plan applies.")
(comment genlsConstraintForNCR "(#$genlsConstraintForNCR RULE INDEXICAL COL) means that RULE constrains its #$NounCompoundRuleIndexicalTerm-Direct term INDEXICAL to denote a subcollection of COL. In general, the means that there is a #$ncRuleConstraint linking RULE to (NCGenlsConstraintFn INDEXICAL TYPE) where TYPE is some spec of COL.")
(comment InterestOnlyRepaymentPlan "A specialization of #$RepaymentPlan.  Instances are repayment plans that require regular payments sufficient to cover interest.  The principal is typically scheduled to be paid at the end of the plan, when the corresponding loan reaches maturity.")
(comment LoanAgreementTypeByCollateral "An instance of #$FacetingCollectionType that facets the collection of secured loans (c.f., #$SecuredLoan).  Instances are collections of loans that share a common method of securitization -- i.e., share a common type of #$collateral.")
(comment surrenderCashValue "(#$surrenderCashValue INSURANCE-POLICY VALUE) identifies VALUE as the instance of #$MonetaryValue that is the cash value of the instance INSURANCE-POLICY of #$InsurancePlan at any point prior to its maturity (c.f., #$agreementMaturity) or its being payable against some claim.  The #$policyHolder is entitled whatever the value of VALUE is at the time INSURANCE-POLICY is cancelled.")
(comment PaymentPlanWithSinglePayment "The collection of all instances of #$RepaymentPlan that schedule exactly one payment that pays of the relevant loan.")
(disjointWith (FollowingScheduleTypeFn PaymentPlanWithSinglePayment) (FollowingScheduleTypeFn PaymentPlanWithMultiplePayments))
(comment PaymentPlanWithMultiplePayments "The collection of instances of #$RepaymentPlan that contain multiple #$PaymentObligations as #$subObligations.")
(disjointWith PaymentPlanWithMultiplePayments PaymentPlanWithSinglePayment)
(disjointWith MoneyTransaction (FollowingScheduleTypeFn PaymentPlanWithMultiplePayments))
(disjointWith PaymentPlanWithEqualValueInstallments InterestOnlyRepaymentPlan)
(disjointWith RepaymentPlanWithBalloon PaymentPlanWithEqualValueInstallments)
(comment PaymentPlanWithEqualValueInstallments "A specialization of #$RepaymentPlan.  Instances are payment schedules that call for a series of payments, each of which are of approximately equal value.")
(comment LoanRepayingTypeByRepaymentPlanType "A specialization of #$AccomplishmentType.  Instances of this collection are subcollections of #$LoanRepaying that share a common type of repayment plan (c.f., #$RepaymentPlan).")
(comment minimumValueForTypeWRTSlot "A ternary #$RuleMacroPredicate that relates a #$Collection to a #$ScalarIntervalSlot to a #$ScalarInterval.  <code>(#$minimumValueForTypeWRTSlot COL SLOT MIN)</code> means that every instance of <code>COL</code> stands in <code>SLOT</code> to a scalar interval greater than or equal to <code>MIN</code>.  That is, it is shorthand for the following rule:
<pre>
(#$implies
  (#$and
    (#$isa ?THING COL)
    (SLOT ?THING ?QUANT))
  (#$greaterThanOrEqualTo ?QUANT MIN)).
</pre>
See also #$maximumValueForTypeWRTSlot.")
(comment maximumValueForTypeWRTSlot "A ternary #$RuleMacroPredicate that relates a #$Collection to a #$ScalarIntervalSlot to a #$ScalarInterval.  <code>(#$maximumValueForTypeWRTSlot COL SLOT MAX)</code> means that every instance of <code>COL</code> stands in <code>SLOT</code> to a scalar interval less than or equal to <code>MAX</code>.  That is, it is shorthand for the following rule:
<pre>
(#$implies
  (#$and
    (#$isa ?THING COL)
    (SLOT ?THING ?QUANT))
  (#$greaterThanOrEqualTo MAX ?QUANT))
</pre>
See also #$minimumValueForTypeWRTSlot.")
(comment loanRepaymentPlanType "(#$loanRepaymentPlanType LOAN TYPE) says that the payment terms (c.f., #$repaymentPlanForLoan) for the instance of #$LoanAgreement LOAN are given in an instance of #$RepaymentPlan of type TYPE.")
(comment ArtificialOrganOfTypeFn "<code>(#$ArtificialOrganOfTypeFn ORGAN-TYPE)</code> is the collection of artificial versions of the specialization of #$Organ, <code>ORGAN-TYPE</code>.  For example, (#$ArtificialOrganOfTypeFn #$Heart) is the collection of artificial hearts.")
(comment artificialOrganOfType "<code>(#$artificialOrganOfType ARTIFICIAL-TYPE ORGAN-TYPE)</code> means that <code>ARTIFICIAL-TYPE</code> is the collection of artificial organs that are artificial versions of instances of the specialization of #$Organ, <code>ORGAN-TYPE</code>.")
(comment 6MonthAdjustableRateLoan "An instance of #$AdjustableRateLoanTypeByAdjustmentPeriod.  Instances of this collection are loans whose adjustment period (c.f., #$adjustmentPeriod) is 6 months -- i.e., every 6 months, the interest rate (c.f., #$interestRate) of the loan is subject to change.")
(comment 1YearAdjustableRateLoan "An instance of #$AdjustableRateLoanTypeByAdjustmentPeriod.  Instances of this collection are loans whose adjustment period (c.f., #$adjustmentPeriod) is 1 year -- i.e., every year, the interest rate (c.f., #$interestRate) of the loan is subject to change.")
(comment SixMonthARM "The collection of instances of #$AdjustableRateMortgage with a 6 month adjustment period (c.f., #$adjustmentPeriod).")
(comment initialAdjustmentPeriod "Many adjustable rate loans (c.f., #$AdjustableRateLoan) have an initial adjustment period (say 6 months or 3 years), after which the interest rate (c.f., #$interestRate) adjusts at regular intervals of a different length than the initial period (typically annually).  (#$initialAdjustmentPeriod LOAN PERIOD) identifies PERIOD as the initial adjustment period for loan.  When the initial adjustment period and the subsequent adjustment period are the same, use #$adjustmentPeriod.")
(comment timeElapsed "(#$timeElapsed DATE-1 DATE-2 TIME-QUANTITY) means that TIME-QUANTITY is the amount of time that elapses between the starting points of two instances of #$Date, DATE-1 and DATE-2.  Note that #$timeElapsed is functional in all three argument places.")
(comment excludeMtContentsFromProjectBuilds "An instance of #$BinaryPredicate. (#$excludeMtContentsFromProjectBuilds MT PROJECT) means that builds for PROJECT will exclude the #$Microtheory MT, as well as any assertions in that MT.")
(comment adjustmentPeriod-NonInitial "Many adjustable rate loans (c.f., #$AdjustableRateLoan) have an initial adjustment period (say 6 months or 3 years), after which the interest rate (c.f., #$interestRate) adjusts at regular intervals of a different length than the initial period (typically annually).  (#$initialAdjustmentPeriod LOAN PERIOD) identifies PERIOD as the initial adjustment period for loan.  When the initial adjustment period and the subsequent adjustment period are the same, use #$adjustmentPeriod.")
(comment IntermediateAdjustableRateLoan "The collection of instances of #$AdjustableRateLoan whose interest rate (c.f., #$interestRate) adjusts annually after a relatively longer initial adjustment period (c.f., #$initialAdjustmentPeriod), typically 3 or 5 years.")
(comment 3-1AdjustableRateLoan "The collection of instances of #$AdjustableRateLoan that have a three year initialAdjustmentPeriod and readjust annually thereafter.")
(comment 5-1AdjustableRateLoan "The collection of instances of #$AdjustableRateLoan that have a five year initialAdjustmentPeriod and readjust annually thereafter.")
(disjointWith IntermediateAdjustableRateLoan AdjustableRateLoan-ConsistentAdjustmentPeriod)
(comment AdjustableRateLoan-ConsistentAdjustmentPeriod "The collection of instances of #$AdjustableRateLoan that have a consistent adjustment period (c.f., #$adjustmentPeriod), e.g., the interest rate adjusts every 6 months.")
(comment EconomicIndexRateSlot "The collection of economic indexes whose value is a percentage rate.  Each instance of this collection is a binary prediate that relates a percentage rate to a period for which that rate holds.  Notable examples include the US prime rate, and the Conventional Fixed Rate Actual Yield.")
(comment conventionalFixedRateActualYield "(#$conventionalFixedRateActualYield PERIOD RATE) means that the Conventional Fixed Rate Actual Yield for the period PERIOD is set at RATE.")
(comment ArgQuotedIsaPredicate "The collection of #$ArgTypePredicates (q.v.) that specify argument-types directly (by referencing certain collections) and impose constraints that require a thing's being an instance of a #$SubLExpressionType collection thus specified. More precisely, each instance of #$ArgQuotedIsaPredicate PRED takes a #$Relation RELN as its first argument (or \"arg1\"), and has at least one other argument-place (say the Mth) for specifying an argument-type for one of RELN's argument-places (say the Nth). (The value of N might be fixed or might be given by yet another of PRED's arguments.) Suppose M=2 and N=1. PRED then takes a #$SubLExpressionType #$Collection as its second argument, and a closed atomic sentence (or \"GAF\") of the form (PRED RELN COL ..) puts an \"quoted isa\" constraint on RELN's first argument-place that is based on COL. If PRED is a \"single-argument\" constraint predicate, the GAF entails that a closed formula of the form (RELN ARG1 ..) is semantically well-formed only if ARG1 is an instance of (i.e. #$quotedIsa) #$SubLExpressionType COL.")
(comment ArgQuotedIsaBinaryPredicate "A specialization of #$ArgQuotedIsaPredicate . Each instance of #$ArgQuotedIsaBinaryPredicate takes a #$Relation RELN as its first argument, and a #$SubLExpressionType #$Collection COL as its second argument, and places a constraint based on COL on at least one of the argument-places of RELN. To be more precise, suppose that PRED is an #$ArgIsaBinaryPredicate that specifies an argument-type for the Nth argument-place of RELN. Then a sentence of the form (PRED RELN COL) entails that a closed formula of the form (RELN ... ARGN ...) is semantically well-formed only if ARGN is an instance (i.e. #$quotedIsa) of COL.")
(comment argQuotedIsa "A ternary #$Predicate (#$argQuotedIsa RELN N COL) means that semantic well-formedness requires that the term given as the Nth argument to RELN must be an instance of the #$SubLExpressionType COL. That is, (RELN ... ARGN ...) is semantically well-formed only if (#$quotedIsa ARGN COL) holds. For example, (#$argQuotedIsa #$examplePredSentences 1 #$CycLSentence) holds. ")
(comment arg1QuotedIsa "A binary #$Predicate (#$arg1QuotedIsa RELN COL) means that semantic well-formedness requires that the term given as the first argument to RELN must be an instance of the #$SubLExpressionType COL. That is, (RELN ARG1 ...) is semantically well-formed only if (#$quotedIsa ARG1 COL) holds.")
(comment arg2QuotedIsa "A binary #$Predicate (#$arg2QuotedIsa RELN COL) means that semantic well-formedness requires that the term given as the second argument to RELN must be an instance of the #$SubLExpressionType COL. That is, (RELN ARG1 ARG2 ...) is semantically well-formed only if (#$quotedIsa ARG2 COL) holds.")
(comment arg3QuotedIsa "A binary #$Predicate (#$arg3QuotedIsa RELN COL) means that semantic well-formedness requires that the term given as the third argument to RELN must be an instance of the #$SubLExpressionType COL. That is, (RELN ARG1 ARG2 ARG3 ...) is semantically well-formed only if (#$quotedIsa ARG3 COL) holds.")
(comment arg4QuotedIsa "A binary #$Predicate (#$arg4QuotedIsa RELN COL) means that semantic well-formedness requires that the term given as the fourth argument to RELN must be an instance of the #$SubLExpressionType COL. That is, (RELN ARG1 ARG2 ARG3 ARG4 ...) is semantically well-formed only if (#$quotedIsa ARG4 COL) holds.")
(comment arg5QuotedIsa "A binary #$Predicate (#$arg5QuotedIsa RELN COL) means that semantic well-formedness requires that the term given as the fifth argument to RELN must be an instance of the #$SubLExpressionType COL. That is, (RELN ARG1 ARG2 ARG3 ARG4 ARG5 ...) is semantically well-formed only if (#$quotedIsa ARG5 COL) holds.")
(comment arg6QuotedIsa "A binary #$Predicate (#$arg6QuotedIsa RELN COL) means that semantic well-formedness requires that the term given as the sixth argument to RELN must be an instance of the #$SubLExpressionType COL. That is, (RELN ARG1 ARG2 ARG3 ARG4 ARG5 ARG6 ...) is semantically well-formed only if (#$quotedIsa ARG6 COL) holds.")
(comment IncorrectRule "A sub-collection of #$CycLPropositionalSentence and #$SentenceEvaluationOutput, each of which is a sentence with #$implies in the arg 0 position and which has been reviewed by some user.  All instances of this collection have been deemed to have some semantic flaw such that the implication that they represent is neither monotonically nor default true in the relevant context.  This collection has three notable sub-collections: #$SalvageableRule, #$IntelligibleRule, and #$NonsensicalRule, whose instances differ in how flawed their represented implications are.")
(comment AnnualSportsEventType "A specialization of #$AnnualTemporalObjectType.  An instance EVENT of #$AnnualSportsEventType is itself a specialization of #$SportsCompetition (q.v.) such that one and only one member of EVENT happens per calendar year.")
(comment Variance "#$Variance is a #$NumericQuantifier that computes the
variance of a function's value over a set. That is, if FUNCTION is a
#$UnaryFunction which returns a #$ScalarInterval, and SET is a set of
elements in the domain of FUNCTION, then (#$Variance SET FUNCTION) computes
the result of applying FUNCTION to each element of SET, then taking the
variance of the resulting values.")
(comment StandardDeviation "#$StandardDeviation is a #$NumericQuantifier that computes the
standard deviation of a function's value over a set. That is, if FUNCTION is a
#$UnaryFunction which returns a #$ScalarInterval, and SET is a set of
elements, each of which is in the domain of FUNCTION, then (#$StandardDeviation
SET FUNCTION) computes the result of applying FUNCTION to each element
of SET, then taking the standard deviation of the resulting values.")
(comment Post-Location "A location, typically including some sort of structure or improvement, to which some #SAgent has been assigned. Some specializations include #$MilitaryPost and it's specs.")
(comment OnlineNewsSeries "A specialization of #$PeriodicalSeries and #$WebSite.  Each instance of
this collection is an online source of news.  This collection includes
those news sources that are found only online as well as those sources
provided also by newpaper and such.")
(comment NewYorkJewishTimes "An instance of #$NewspaperSeries.")
(comment BBCNewsOnline "An instance of #$OnlineNewsSeries based in
#$UnitedKingdomOfGreatBritainAndNorthernIreland.")
(comment BBCOnline "An instance of #$WebSite.")
(comment Scoop-InternetNews "An instance of #$OnlineNewsSeries based in #$NewZealand.")
(comment TimesOfIndia-TheNewspaper "An instance of #$NewspaperSeries based in #$India.")
(comment WorldNetDaily-OnlineNews "An instance of #$OnlineNewsSeries based in Oregon.")
(comment TheSunNews-MyrtleBeachSC "An instance of #$NewspaperSeries.")
(comment NewsLetterBelfast "An instance of #$NewspaperSeries.")
(comment TheStraitsTimes "An instance of #$OnlineNewsSeries.")
(comment SydneyMorningHerald "An instance of #$NewspaperSeries.")
(comment PressTrustOfIndia-NewsSource "An instance of #$OnlineNewsSeries.")
(comment MiddleEastOnline-NewsSource "An instance of #$OnlineNewsSeries based in the Middle East.")
(comment TheNewYorker-Magazine "An instance of #$MagazineSeries.")
(comment TheFinancialExpress-NewsSource "An instance of #$NewspaperSeries.")
(comment TheAge-NewsSource "An instance of #$NewspaperSeries.")
(comment BankersOnline "An instance of #$OnlineNewsSeries focused on issues
important to bankers.")
(comment TheEurasianPolitician "An instance of #$OnlineNewsSeries focused on issues in Eurasia.")
(comment BerkeleyDailyPlanet "An instance of #$NewspaperSeries.")
(comment DailyTimes-Pakistan "An instance of #$NewspaperSeries.")
(comment Terra-NewsSeries "An instance of #$OnlineNewsSeries.")
(comment CNews-NewsSource "An instance of #$OnlineNewsSeries.")
(comment NewKerala-NewsSource "An instance of #$NewspaperSeries.")
(comment InsightOnTheNews "An instance of #$OnlineNewsSeries.")
(comment TheScotsman-Newspaper "An instance of #$NewspaperSeries based in #$Scotland.")
(comment HighburyAndIslingtonExpress-NewsSource "An instance of #$NewspaperSeries.")
(comment FreeRepublic-OnlineNews "An instance of #$OnlineNewsSeries.")
(comment SenseExtensionPredicate "A collection of predicates used represent possible sense extension for NL expressions.")
(comment senseExtensionForNameString "(#$senseExtensionForNameString DENOTE STRING) means that STRING should be recognized as potentially refering to DENOTE in an extended sense.")
(comment senseExtensionForWord "(#$senseExtensionForWord WORD POS DENOTE) means that DENOTE should be recognized as an extended sense of WORD when it is used as POS.")
(disjointWith Kicking Stomping)
