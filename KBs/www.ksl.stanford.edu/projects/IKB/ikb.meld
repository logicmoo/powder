(#$comment (#$implies (#$and (#$isa ?PATHTYPE #$PathType) (#$isa ?PATH ?PATHTYPE) (#$pathTerminus ?PATH ?END)) (#$subPaths ?PATH (#$SKF-19769806 ?PATH ?END ?PATHTYPE))) "The intended formulas is (implies
    (and
     (pathTerminus ?path ?end)
     (isa ?path ?pathType)
     (isa ?pathType PathType))
    (thereExists ?sub
     (and
      (subPaths ?path ?sub)
      (endsOfPathSegment ?sub ?end)
      (forAll ?x
       (implies
        (and
         (endsOfPathSegment ?x ?end)
         (isa ?x ?pathType))
	(or
	  (subPaths ?x ?sub)
	  (subPaths ?sub ?x))))))).") 
