              (genlMt ?COMMON-FAR ?COMMON-FARTHER) 
              (genlMt ?MT-1 ?COMMON-FAR) 
              (genlMt ?MT-2 ?COMMON-FAR) 
              (different ?COMMON-FAR ?COMMON-FARTHER) 
              (different ?COMMON-FAR ?MT-1) 
              (different ?COMMON-FAR ?MT-2)))))))
)

