    (holdsIn ?ACT 
      (exists 
        (?OBJ) 
        (and 
          (different ?OBJ ?TOOL) 
          (not 
            (physicalParts ?TOOL ?OBJ)) 
          (near ?OBJ ?TOOL) 
          (or 
            (objectActedOn ?ACT ?OBJ) 
            (inputsDestroyed ?ACT ?OBJ) 
            (outputsCreated ?ACT ?OBJ))))))
)

