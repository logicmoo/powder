(:DIRECTION :BACKWARD :MONOTONICITY :DEFAULT :CREATOR Cyc :CREATION-DATE NIL
 :MICROTHEORY BaseKB
 :KIF
  (=> 
    (and 
      (evaluate ?POSITIONSINLISTFN 
        (PositionsInListFn ?SUB ?LIST)) 
      (evaluate ?NTHINLISTFN 
        (NthInListFn ?POSITIONSINLISTFN ?N))) 
    (or 
      (= ?NTHINLISTFN 
        (LastInListFn ?POSITIONSINLISTFN)) 
      (sublists 
        (SublistFromToFn ?LIST 
          (PlusFn ?NTHINLISTFN 1) 
          (LengthOfListFn ?LIST)) ?SUB)))
)

