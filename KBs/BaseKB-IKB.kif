          (?BETWEEN) 
          (and 
            (trueFormula 
              (?PRED ?BETWEEN ?NEAR-TERM)) 
            (trueFormula 
              (?PRED ?TERM ?BETWEEN)) 
            (different ?BETWEEN ?NEAR-TERM ?TERM)))) 
      (different ?NEAR-TERM ?TERM) 
      (trueFormula 
        (?PRED ?TERM ?NEAR-TERM))) 
    (nearestTransitiveNeighbor ?PRED ?TERM ?NEAR-TERM))
)

