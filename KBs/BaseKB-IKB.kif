  (=> 
    (and 
      (nodeInSystem ?A ?SYS) 
      (fourWayJunctionInSystem ?JUNCT ?SYS) 
      (different ?X ?Y ?Z ?W) 
      (pathFromToInSystem ?PATH ?A ?JUNCT ?SYS) 
      (pointOnPath ?X1 ?LINK1) 
      (pointOnPath ?Y1 ?LINK2) 
      (linkFromToInSystem ?LINK2 ?Y ?JUNCT ?SYS) 
      (linkFromToInSystem ?LINK1 ?X ?JUNCT ?SYS) 
      (linkBetweenInSystem ?LINK3 ?Z ?JUNCT ?SYS) 
      (linkBetweenInSystem ?LINK4 ?W ?JUNCT ?SYS)) 
    (or 
      (pointOnPath ?X1 ?PATH) 
      (pointOnPath ?Y1 ?PATH) 
      (linkFromToInSystem ?LINK3 ?Z ?JUNCT ?SYS) 
      (linkFromToInSystem ?LINK4 ?W ?JUNCT ?SYS)))
)

