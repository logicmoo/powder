      (genlPreds ?COMMON-NEAR ?PRED-2)) 
    (or 
      (nearestCommonSpecPreds ?PRED-1 ?PRED-2 ?COMMON-NEAR) 
      (elementOf ?COMMON-NEAR 
        (TheSetOf ?COMMON-FARTHER 
          (exists 
            (?COMMON-FAR) 
            (and 
              (genlPreds ?COMMON-FAR ?PRED-1) 
              (genlPreds ?COMMON-FAR ?PRED-2) 
              (genlPreds ?COMMON-FARTHER ?COMMON-FAR) 
              (different ?PRED-1 ?COMMON-FAR) 
              (different ?PRED-2 ?COMMON-FAR) 
              (different ?COMMON-FAR ?COMMON-FARTHER)))))))
)

