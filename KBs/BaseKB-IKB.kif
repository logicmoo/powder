      (different ?X ?Y ?Z) 
      (pathFromToInSystem ?PATH ?A ?JUNCT ?SYS) 
      (threeWayJunctionInSystem ?JUNCT ?SYS) 
      (pointOnPath ?Z1 ?LINK3) 
      (pointOnPath ?X1 ?LINK1) 
      (pointOnPath ?Y1 ?LINK2) 
      (linkFromToInSystem ?LINK2 ?Y ?JUNCT ?SYS) 
      (linkFromToInSystem ?LINK3 ?Z ?JUNCT ?SYS) 
      (linkFromToInSystem ?LINK1 ?X ?JUNCT ?SYS)) 
    (or 
      (pointOnPath ?A ?LINK1) 
      (pointOnPath ?A ?LINK2) 
      (pointOnPath ?A ?LINK3) 
      (pointOnPath ?Z1 ?PATH) 
      (pointOnPath ?X1 ?PATH) 
      (pointOnPath ?Y1 ?PATH)))
)

