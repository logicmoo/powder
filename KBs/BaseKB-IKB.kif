      (different ?LINK ?NTHINLISTFN) 
      (linkBetweenInSystem ?LINK ?LASTINLISTFN ?Z ?SYS) 
      (betweenOnPath ?A ?LASTINLISTFN ?Z ?LINK) 
      (pathBetweenInSystem 
        (JoinPathsFn ?CHAIN) ?X ?LASTINLISTFN ?SYS) 
      (evaluate ?NTHINLISTFN 
        (NthInListFn ?CHAIN 
          (DifferenceFn 
            (LengthOfListFn ?CHAIN) 1))) 
      (evaluate ?LASTINLISTFN 
        (LastInListFn ?CHAIN))) 
