      (different ?PRED-1 ?COMMON-NEAR) 
      (genlPreds ?PRED-1 ?COMMON-NEAR) 
      (different ?PRED-2 ?COMMON-NEAR) 
      (genlPreds ?PRED-2 ?COMMON-NEAR)) 
    (or 
      (nearestCommonGenlPreds ?PRED-1 ?PRED-2 ?COMMON-NEAR) 
      (elementOf ?COMMON-NEAR 
        (TheSetOf ?COMMON-FARTHER 
          (exists 
            (?COMMON-FAR) 
            (and 
              (genlPreds ?PRED-1 ?COMMON-FAR) 
              (genlPreds ?PRED-2 ?COMMON-FAR) 
              (genlPreds ?COMMON-FAR ?COMMON-FARTHER) 
              (different ?PRED-1 ?COMMON-FAR) 
              (different ?PRED-2 ?COMMON-FAR) 
              (different ?COMMON-FAR ?COMMON-FARTHER)))))))
)

