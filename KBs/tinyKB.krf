  :converted-row-variable-names ()
  :original-cnf (() ((comment backchainRequired "(backchainRequired PREDICATE) means that rules that conclude PREDICATE must be used in order to prove literals involving PREDICATE.  In other words, when performing inferences, all literals involving PREDICATE must be eliminated using rules since there won't be any other way to prove them.  See also backchainEncouraged, backchainDiscouraged, and backchainForbidden.")))
  :original-formula (comment backchainRequired "(backchainRequired PREDICATE) means that rules that conclude PREDICATE must be used in order to prove literals involving PREDICATE.  In other words, when performing inferences, all literals involving PREDICATE must be eliminated using rules since there won't be any other way to prove them.  See also backchainEncouraged, backchainDiscouraged, and backchainForbidden.")
  :original-prolog "'TINYKB-ASSERTION'(':TRUE-MON',[[],[['comment','backchainRequired',\"(backchainRequired PREDICATE) means that rules that conclude PREDICATE must be used in order to prove literals involving PREDICATE.  In other words, when performing inferences, all literals involving PREDICATE must be eliminated using rules since there won't be any other way to prove them.  See also backchainEncouraged, backchainDiscouraged, and backchainForbidden.\"]]],'UniversalVocabularyMt',[],/*HL*/['comment','backchainRequired',\"(backchainRequired PREDICATE) means that rules that conclude PREDICATE must be used in order to prove literals involving PREDICATE.  In other words, when performing inferences, all literals involving PREDICATE must be eliminated using rules since there won't be any other way to prove them.  See also backchainEncouraged, backchainDiscouraged, and backchainForbidden.\"]).")

(:kif (comment collectionBackchainEncouraged "<p>\n(collectionBackchainEncouraged COLLECTION)\n<p>\nmeans that rules that conclude\n<p>\n(isa <anything> COLLECTION)\n<p>\nare most likely going to have to be used in order to prove literals of the form\n<p>\n(isa <anything> COLLECTION),\n<p>\nand rules that conclude\n<p>\n(genls <anything> COLLECTION)\n<p>\nare most likely going to have to be used in order to prove literals of the form\n<p>\n(genls <anything> COLLECTION).\n<p>\nThis directs the inference engine to use such rules even if HL predicate transformation is disabled. Note that it will not necessarily use rules of the form\n<p>\n([isa|genls] <anything> <variable>)\n<p>\nwhere <variable> might bind to COLLECTION, and it will not necessarily use rules of the form\n<p>\n([isa|genls] <anything> SPEC), where (genls SPEC COLLECTION).\n<p>\nSee also backchainEncouraged for the analogue of this predicate applicable to predicates rather than collections.")
  :monotonicity :MONOTONIC
  :original-tv :TRUE-MON
  :original-source-file "tiny_kb.pldata"
  :original-source-line 7519
