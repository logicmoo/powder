; Isolated managed-test knowledge, never an application bootstrap or source repair.
(in-microtheory SymbolicTestAgentMt)
(isa SymbolicTestAgent SymbolicTextAgent)
(symbolicAgentContext SymbolicTestAgent Lexicon SymbolicTestLexiconMt)
(symbolicAgentContext SymbolicTestAgent Grammar SymbolicTestGrammarMt)
(symbolicAgentContext SymbolicTestAgent Dialogue SymbolicTestDialogueMt)
(symbolicAgentContext SymbolicTestAgent Templates SymbolicTestTemplatesMt)
(symbolicAgentContext SymbolicTestAgent Plans SymbolicTestPlansMt)
(symbolicAgentContext SymbolicTestAgent Goals SymbolicTestGoalsMt)
(symbolicAgentContext SymbolicTestAgent Policy SymbolicTestPolicyMt)
(symbolicAgentContext SymbolicTestAgent State SymbolicTestStateMt)
(symbolicAgentContext SymbolicTestAgent Knowledge SymbolicTestWorldMt)
(symbolicStartCategory SymbolicTestAgent sentence)
(symbolicInitialState SymbolicTestAgent AwaitCommand)

(in-microtheory SymbolicTestPolicyMt)
(symbolicCaseMode SymbolicTestAgent Sensitive)
(symbolicAllowedCapability SymbolicTestAgent "kee_query")

(in-microtheory SymbolicTestGoalsMt)
(symbolicInitialGoal SymbolicTestAgent (UnderstandClassificationRequests))

(in-microtheory SymbolicTestLexiconMt)
(symbolicLexeme name (TheList "Ada") Ada)
(symbolicLexeme name (TheList "Boreal") Boreal)
(symbolicLexeme class (TheList "dog") Dog)
(symbolicLexeme class (TheList "cat") Cat)
(symbolicLexeme class (TheList "animal") Animal)
(symbolicLexeme command (TheList "classify") Classify)
(symbolicLexeme command (TheList "mark") Classify)

(in-microtheory SymbolicTestGrammarMt)
(symbolicProduction sentence
  (TheList (symbolicNonterminal command Classify)
           (symbolicNonterminal name ?Who)
           (symbolicLiteral "as")
           (symbolicNonterminal class ?Class))
  (ClassifyTask ?Who ?Class))
(symbolicProduction sentence
  (TheList (symbolicLiteral "every")
           (symbolicNonterminal class ?From)
           (symbolicLiteral "is")
           (symbolicNonterminal class ?To))
  (forAll ?X (implies (isa ?X ?From) (isa ?X ?To))))

(in-microtheory SymbolicTestTemplatesMt)
(symbolicTemplate (ClassificationConfirmed ?Who ?Class)
  (TheList (symbolicRealize name ?Who) (symbolicText "is")
           (symbolicRealize class ?Class) (symbolicText ".")))
(symbolicTemplate (ClassificationDenied ?Who ?Class)
  (TheList (symbolicRealize name ?Who) (symbolicText "is not")
           (symbolicRealize class ?Class) (symbolicText ".")))
(symbolicTemplate ClarifyMeaning (TheList (symbolicText "Which meaning did you intend?")))

(in-microtheory SymbolicTestDialogueMt)
(symbolicDialogueRule AwaitCommand (symbolicUtterance (ClassifyTask ?Who ?Class))
  (symbolicKnown SymbolicTestWorldMt (isa ?Who ?Class))
  (symbolicSequence
    (TheList (symbolicSay (ClassificationConfirmed ?Who ?Class))
             (symbolicSetState AwaitCommand))))

(in-microtheory SymbolicTestWorldMt)
(isa Ada Dog)
(isa Boreal Cat)
(not (isa Ada Cat))
(implies (isa ?X Dog) (isa ?X Animal))
